 ;;; __adsr_fixed_sample -- compute ADSR envelope value at time t.
-(defn __adsr_fixed_sample [attack decay sustain release gate-dur t] :int
+(defn __adsr_fixed_sample [attack :float decay :float sustain :float release :float gate-dur :float t :float] :float
   ```c
-  double a  = ((union { int64_t i; double d; }){.i = attack}).d;
-  double dc = ((union { int64_t i; double d; }){.i = decay}).d;
-  double s  = ((union { int64_t i; double d; }){.i = sustain}).d;
-  double r  = ((union { int64_t i; double d; }){.i = release}).d;
-  double gd = ((union { int64_t i; double d; }){.i = gate_dur}).d;
-  double tv = ((union { int64_t i; double d; }){.i = t}).d;
-  union { double d; int64_t i; } u;
-  if (tv <= a) {
-    u.d = (a > 0.0) ? (tv / a) : 1.0;
-  } else if (tv <= a + dc) {
+  double a = attack, dc = decay, s = sustain, r = release, gd = gate_dur, tv = t;
+  if (tv <= a)
+    return (a > 0.0) ? (tv / a) : 1.0;
+  if (tv <= a + dc) {
     double decay_t = tv - a;
-    u.d = 1.0 + (s - 1.0) * ((dc > 0.0) ? (decay_t / dc) : 1.0);
-  } else if (tv <= gd) {
-    u.d = s;
