;;; cli_args_demo -- Demonstrates how to access environment variables.
;;;
;;; Example:
;;;   ARG1=hello ARG2=world tur run examples/cli_args_demo.tur
;;;   ; => hello world

(defn main [] : void
  (print "Environment variables: ")
  (print (getenv "ARG1"))
  (print " ")
  (print (getenv "ARG2"))
  (println ""))
