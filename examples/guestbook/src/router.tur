;;; router -- dispatch the current request to a page.
;;;
;;; Routes:
;;;   GET  /                -> start-flow (page 1)
;;;   GET  /entries         -> list-entries
;;;   POST /submit?k=TOKEN  -> rebuild the token's continuation and resume it
;;;                            with the POST body
;;;   anything else         -> 404
;;;
;;; Since: Guestbook example
(defmodule router
  (import strutil :refer [form-field cstr-eq? cstr-as-int])
  (import templates :refer [render-error])
  (import conts :refer [load-continuation])
  (import handlers :refer [start-flow advance list-entries])
  (import httpd :refer [httpd/method httpd/path httpd/query httpd/body httpd/send!])
  (export dispatch)

  ;;; send-error -- an error page with the given status.
  (defn send-error [status : int msg : cstr] : int
    (httpd/send! status "text/html" (render-error msg)))

  ;;; resume-handler -- POST /submit?k=TOKEN.
  ;;;
  ;;; The token is verified, aged and rebuilt by load-continuation; the
  ;;; continuation is then resumed with the POST body (its address rides in
  ;;; the int hole).  The page the flow was waiting on runs, and the step code
  ;;; it returns tells `advance` which page to show next.
  (defn resume-handler [] : int
    (match (form-field (httpd/query) "k")
      (None) (send-error 400 "Missing continuation token.")
      (Some t)
        (match (load-continuation t)
          (Err m) (send-error 404 m)
          (Ok k)  (advance (serial-resume k (cstr-as-int (httpd/body)))))))

  ;;; dispatch -- route the request httpd/wait! just read.
  ;;;
  ;;; Since: Guestbook example
  (defn dispatch [] : int
    (let [get?  (cstr-eq? (httpd/method) "GET")
          post? (cstr-eq? (httpd/method) "POST")
          path  (httpd/path)]
      (cond
        (and get? (cstr-eq? path "/"))         (start-flow)
        (and get? (cstr-eq? path "/entries"))  (list-entries)
        (and post? (cstr-eq? path "/submit"))  (resume-handler)
        :else (send-error 404 "Page not found.")))))
