;;; templates.tur -- HTML rendering helpers for each page of the guestbook.
;;;
;;; All functions return raw HTML strings. User-supplied content must be
;;; HTML-escaped (via html-escape from security.tur) before being passed in.
;;;
;;; Since: Guestbook example

;;; page-shell -- wrap content in a minimal HTML document shell.
;;;
;;; Parameters:
;;;   title   -- page title shown in the browser tab
;;;   content -- inner HTML body content
;;;
;;; Returns:
;;;   Complete HTML document string.
;;;
;;; Since: Guestbook example
(defn page-shell [title : cstr, content : cstr] : cstr
  (str "<!DOCTYPE html><html lang='en'><head>"
       "<meta charset='utf-8'/>"
       "<meta name='viewport' content='width=device-width,initial-scale=1'/>"
       "<title>" title " -- Turmeric Guestbook</title>"
       "<style>"
       "body{font-family:sans-serif;max-width:600px;margin:2em auto;padding:0 1em}"
       "h2{border-bottom:1px solid #ccc;padding-bottom:.3em}"
       "input,textarea{width:100%;box-sizing:border-box;margin:.4em 0;padding:.4em}"
       "button{margin-top:.6em;padding:.4em 1em}"
       "ul{list-style:none;padding:0}"
       "li{border:1px solid #eee;border-radius:4px;padding:.6em;margin:.4em 0}"
       "li strong{display:block}"
       "</style>"
       "</head><body>" content "</body></html>"))

;;; render-name-form -- render the name-entry page.
;;;
;;; Parameters:
;;;   action -- form action URL (e.g. "/submit?k=TOKEN")
;;;
;;; Returns:
;;;   HTML string for the name-entry page.
;;;
;;; Example:
;;;   (render-name-form "/submit?k=abc123")
;;;
;;; Since: Guestbook example
(defn render-name-form [action : cstr] : cstr
  (page-shell "Sign the Guestbook"
    (str "<h2>Sign the Guestbook</h2>"
         "<form method='POST' action='" action "'>"
         "<label>Your name:"
         "<input name='name' autofocus maxlength='120'/>"
         "</label>"
         "<br/>"
         "<button type='submit'>Next &rarr;</button>"
         "</form>")))

;;; render-message-form -- render the message-entry page.
;;;
;;; Parameters:
;;;   action -- form action URL
;;;   name   -- HTML-escaped author name (shown as a greeting)
;;;
;;; Returns:
;;;   HTML string for the message-entry page.
;;;
;;; Example:
;;;   (render-message-form "/submit?k=def456" "Alice")
;;;
;;; Since: Guestbook example
(defn render-message-form [action : cstr, name : cstr] : cstr
  (page-shell "Your Message"
    (str "<h2>Hello, " name "! Leave a message.</h2>"
         "<form method='POST' action='" action "'>"
         "<label>Message:"
         "<textarea name='message' rows='4' maxlength='500' autofocus></textarea>"
         "</label>"
         "<br/>"
         "<button type='submit'>Preview &rarr;</button>"
         "</form>")))

;;; render-preview -- render the preview page with confirm and back links.
;;;
;;; Parameters:
;;;   name      -- HTML-escaped author name
;;;   message   -- HTML-escaped message text
;;;   t-back    -- continuation token for the "Edit" action
;;;   t-confirm -- continuation token for the "Confirm" action
;;;
;;; Returns:
;;;   HTML string for the preview page.
;;;
;;; Example:
;;;   (render-preview "Alice" "Hello!" "t2b" "t3")
;;;
;;; Since: Guestbook example
(defn render-preview [name      : cstr,
                      message   : cstr,
                      t-back    : cstr,
                      t-confirm : cstr] : cstr
  (page-shell "Preview Your Entry"
    (str "<h2>Preview Your Entry</h2>"
         "<div style='background:#f9f9f9;border:1px solid #ddd;border-radius:4px;padding:.8em;margin:1em 0'>"
         "<p><strong>Name:</strong> " name "</p>"
         "<p><strong>Message:</strong> " message "</p>"
         "</div>"
         "<form method='POST' action='/submit?k=" t-confirm "' style='display:inline'>"
         "<button type='submit'>Confirm and Post</button>"
         "</form>"
         "&nbsp;"
         "<form method='POST' action='/submit?k=" t-back "' style='display:inline'>"
         "<button type='submit'>&#8592; Edit Message</button>"
         "</form>")))

;;; render-thankyou -- render the thank-you page with the full guestbook.
;;;
;;; Parameters:
;;;   entries -- all guestbook entries to display
;;;
;;; Returns:
;;;   HTML string for the thank-you page.
;;;
;;; Since: Guestbook example
(defn render-thankyou [entries : (Vec GuestEntry)] : cstr
  (def rows
    (Vec.map entries (fn [e]
      (str "<li><strong>" e.name "</strong>" e.message "</li>"))))
  (page-shell "Thank You!"
    (str "<h2>Thank you! Your entry has been posted.</h2>"
         "<p><a href='/'>Add another entry</a>"
         " &nbsp;|&nbsp; "
         "<a href='/entries'>View all entries</a></p>"
         "<h3>Guestbook</h3>"
         "<ul>" (cstr-join rows "") "</ul>")))

;;; render-entries -- render the full guestbook listing page.
;;;
;;; Parameters:
;;;   entries -- all guestbook entries to display
;;;
;;; Returns:
;;;   HTML string for the entries listing page.
;;;
;;; Since: Guestbook example
(defn render-entries [entries : (Vec GuestEntry)] : cstr
  (def rows
    (Vec.map entries (fn [e]
      (str "<li><strong>" e.name "</strong>" e.message "</li>"))))
  (page-shell "Guestbook Entries"
    (str "<h2>Guestbook</h2>"
         "<p><a href='/'>Sign the guestbook</a></p>"
         (if (= (Vec.len entries) 0)
           "<p><em>No entries yet. Be the first!</em></p>"
           (str "<ul>" (cstr-join rows "") "</ul>")))))

;;; render-error -- render a simple error page.
;;;
;;; Parameters:
;;;   msg -- HTML-escaped error message
;;;
;;; Returns:
;;;   HTML string for the error page.
;;;
;;; Since: Guestbook example
(defn render-error [msg : cstr] : cstr
  (page-shell "Error"
    (str "<h2>Something went wrong</h2>"
         "<p>" msg "</p>"
         "<p><a href='/'>Start over</a></p>")))
