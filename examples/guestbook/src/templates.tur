;;; templates -- HTML rendering for every guestbook page.
;;;
;;; Every renderer returns a complete document.  User text is escaped by the
;;; caller (security/html-escape) before it reaches these functions; the
;;; renderers only assemble markup.
;;;
;;; Since: Guestbook example
(defmodule templates
  (import strutil :refer [str+ cstr-index-of cstr-slice cstr-len])
  (export page-shell render-name-form render-message-form render-preview
          render-thankyou render-entries render-error)

  ;;; page-shell -- wrap content in the shared document skeleton.
  (defn page-shell [title : cstr content : cstr] : cstr
    (str+ "<!doctype html><html><head><meta charset=\"utf-8\"><title>" title
          "</title><style>body{font-family:sans-serif;max-width:40em;margin:2em auto}"
          "label{display:block;margin:.5em 0}textarea,input{width:100%}"
          "li{margin:.5em 0}.muted{color:#666}</style></head><body><h1>" title
          "</h1>" content "<p class=\"muted\"><a href=\"/\">Sign the guestbook</a> &middot; "
          "<a href=\"/entries\">Read the entries</a></p></body></html>"))

  ;;; render-name-form -- page 1: ask for the visitor's name.
  ;;;
  ;;; Parameters:
  ;;;   action -- the form action URL carrying this page's continuation token
  (defn render-name-form [action : cstr] : cstr
    (page-shell "Guestbook"
      (str+ "<form method=\"post\" action=\"" action "\">"
            "<label>Your name <input name=\"name\" autofocus></label>"
            "<button>Next</button></form>")))

  ;;; render-message-form -- page 2: ask for the message.
  ;;;
  ;;; Parameters:
  ;;;   action  -- the form action URL
  ;;;   name    -- the (escaped) name from page 1, shown as a greeting
  ;;;   message -- prefill (escaped) when the visitor came back from the preview
  (defn render-message-form [action : cstr name : cstr message : cstr] : cstr
    (page-shell (str+ "Hello, " name)
      (str+ "<form method=\"post\" action=\"" action "\">"
            "<label>Your message <textarea name=\"message\" rows=\"5\">" message
            "</textarea></label><button>Preview</button></form>")))

  ;;; render-preview -- page 3: show the entry with Confirm and Back buttons.
  ;;;
  ;;; Both buttons post to the same continuation; the `decision` field tells
  ;;; the resumed page which one was pressed.
  (defn render-preview [action : cstr name : cstr message : cstr] : cstr
    (page-shell "Preview"
      (str+ "<blockquote><p>" message "</p><footer>&mdash; " name "</footer></blockquote>"
            "<form method=\"post\" action=\"" action "\">"
            "<button name=\"decision\" value=\"confirm\">Confirm</button> "
            "<button name=\"decision\" value=\"back\">Back</button></form>")))

  ;;; entry-rows -- one <li> per "posted-at\tname\tmessage" line (internal).
  (defn entry-rows [lines : cstr] : cstr
    (let [^mut html ""
          ^mut pos  0
          n         (cstr-len lines)]
      (do
        (while (< pos n)
          (let [nl   (cstr-index-of lines "\n" pos)
                end  (if (< nl 0) n nl)
                line (cstr-slice lines pos end)
                t1   (cstr-index-of line "\t" 0)
                t2   (if (< t1 0) -1 (cstr-index-of line "\t" (+ t1 1)))]
            (do
              (when (>= t2 0)
                (set! html (str+ html "<li><p>" (cstr-slice line (+ t2 1) (cstr-len line))
                                 "</p><footer class=\"muted\">&mdash; "
                                 (cstr-slice line (+ t1 1) t2) "</footer></li>")))
              (set! pos (+ end 1)))))
        html)))

  ;;; render-thankyou -- page 4: confirmation plus the current entries.
  (defn render-thankyou [lines : cstr] : cstr
    (page-shell "Thank you!"
      (str+ "<p>Your entry has been added.</p><ul>" (entry-rows lines) "</ul>")))

  ;;; render-entries -- GET /entries: every entry, oldest first.
  (defn render-entries [lines : cstr] : cstr
    (page-shell "Entries"
      (if (= (cstr-len lines) 0)
        "<p>No entries yet.</p>"
        (str+ "<ul>" (entry-rows lines) "</ul>"))))

  ;;; render-error -- an error page with the (already escaped) message.
  (defn render-error [msg : cstr] : cstr
    (page-shell "Sorry" (str+ "<p>" msg "</p>"))))
