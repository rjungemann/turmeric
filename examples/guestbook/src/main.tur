;;; main -- entry point: start the listener and serve requests forever.
;;;
;;; Usage:
;;;   GUESTBOOK_SECRET="a long random string" tur run src/main.tur
;;;
;;; Listens on http://127.0.0.1:8080/ (PORT overrides).  Every request is
;;; read by httpd/wait! and routed by dispatch; expired continuation files are
;;; swept after each one.  GUESTBOOK_MAX_REQUESTS=N serves N requests and
;;; exits, which is how the smoke test drives a whole flow with curl.
;;;
;;; Since: Guestbook example
(defmodule main
  (import strutil :refer [str+ env-or cstr->int-or int->cstr])
  (import httpd :refer [httpd/start httpd/wait!])
  (import store :refer [store-init!])
  (import conts :refer [evict-expired-conts!])
  (import router :refer [dispatch])

  ;;; serve-loop -- read, dispatch, sweep; max = 0 means forever.
  (defn serve-loop [max : int] : int
    (let [^mut served 0]
      (do
        (while (or (= max 0) (< served max))
          (do
            (httpd/wait!)
            (dispatch)
            (evict-expired-conts!)
            (set! served (+ served 1))))
        served)))

  ;;; main -- bind the port and serve.
  (defn main [] : int
    (let [port (cstr->int-or (env-or "PORT" "8080") 8080)
          max  (cstr->int-or (env-or "GUESTBOOK_MAX_REQUESTS" "0") 0)]
      (do
        (store-init!)
        (if (< (httpd/start port) 0)
          (do (println (str+ "guestbook: failed to start HTTP listener on port " (int->cstr port)))
              1)
          (do
            (println (str+ "guestbook: listening on http://127.0.0.1:" (int->cstr port) "/"))
            (serve-loop max)
            0))))))
