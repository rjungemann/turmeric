;;; conts -- the continuation store: one file per token under data/conts/.
;;;
;;; store-continuation marshals a captured continuation to bytes, writes them
;;; under a fresh random token and returns the token signed with the server
;;; secret.  load-continuation checks the signature, the file's age and the
;;; bytes themselves (bytes->serial-cont validates every frame against this
;;; program's frame registry) before handing back something resumable.
;;;
;;; Since: Guestbook example
(load "stdlib/serial.tur")
(defmodule conts
  (import strutil :refer [str+])
  (import security :refer [sign-token verify-token server-secret random-hex-64])
  (export store-continuation load-continuation evict-expired-conts! cont-ttl-seconds)

  ;;; cont-ttl-seconds -- how long a token stays resumable (30 minutes).
  (defn cont-ttl-seconds [] : int 1800)

  ;;; bytes-release -- free a bytes buffer serial-cont->bytes handed us.
  (defn bytes-release [b : ptr<void>] : int
    ```c
    if (b) free(b);
    return 0;
    ```)

  ;;; cont-path -- data/conts/<token>.bin
  (defn cont-path [token : cstr] : cstr
    (str+ "data/conts/" token ".bin"))

  ;;; file-age-seconds -- seconds since path was last written, or -1 if absent.
  (defn file-age-seconds [path : cstr] : int
    ```c
    #include <sys/stat.h>
    #include <time.h>
    struct stat st;
    if (stat(path, &st) != 0) return -1;
    return (int64_t)(time(NULL) - st.st_mtime);
    ```)

  ;;; store-continuation -- persist k and return its signed token.
  ;;;
  ;;; Parameters:
  ;;;   k -- the continuation the serial-shift handler was handed
  ;;;
  ;;; Returns:
  ;;;   "<token>.<signature>", the value to put in the form's action URL.
  ;;;
  ;;; Since: Guestbook example
  (defn store-continuation [k : serial-cont] : cstr
    (let [token (random-hex-64)
          bytes (serial-cont->bytes k)]
      (do
        (cont-to-file bytes (cont-path token))
        (bytes-release bytes)
        (sign-token token (server-secret)))))

  ;;; load-continuation -- rebuild the continuation a signed token names.
  ;;;
  ;;; Returns:
  ;;;   (Ok k) for a token the server issued, still within the TTL, whose
  ;;;   bytes rebuild; otherwise (Err reason) with a user-facing reason.
  ;;;
  ;;; Since: Guestbook example
  (defn load-continuation [signed : cstr] : (Result serial-cont cstr)
    (match (verify-token signed (server-secret))
      (None) (err "That link was not issued by this server.")
      (Some token)
        (let [path (cont-path token)
              age  (file-age-seconds path)]
          (if (< age 0)
            (err "Unknown or already used link. Please start over.")
            (if (> age (cont-ttl-seconds))
              (err "That link has expired. Please start over.")
              (bytes->serial-cont (cont-from-file path)))))))

  ;;; evict-expired-conts! -- delete continuation files older than the TTL.
  ;;;
  ;;; Returns the number of files removed.  Called once per request from the
  ;;; main loop; cheap because the directory is small.
  ;;;
  ;;; Since: Guestbook example
  (defn evict-expired-conts! [] : int
    ```c
    #include <sys/stat.h>
    #include <time.h>
    #ifndef _WIN32
    #include <dirent.h>
    DIR *d = opendir("data/conts");
    if (!d) return 0;
    int64_t removed = 0;
    struct dirent *e;
    time_t now = time(NULL);
    while ((e = readdir(d)) != NULL) {
      if (e->d_name[0] == '.') continue;
      char path[512];
      snprintf(path, sizeof path, "data/conts/%s", e->d_name);
      struct stat st;
      if (stat(path, &st) == 0 && now - st.st_mtime > 1800) {
        if (remove(path) == 0) removed++;
      }
    }
    closedir(d);
    return removed;
    #else
    return 0;
    #endif
    ```))
