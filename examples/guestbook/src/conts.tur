;;; conts.tur -- continuation store: token generation, file-based load/save,
;;; and optional expiry.
;;;
;;; Continuations are stored as one file per token under data/conts/.
;;; The file contains a serialized StoredCont struct (bytes + creation time).
;;;
;;; Since: Guestbook example

(def CONTS-DIR        "data/conts/")
(def CONT-TTL-SECONDS 1800) ; 30 minutes

; ---------------------------------------------------------------------------
; StoredCont -- a continuation blob with a creation timestamp
; ---------------------------------------------------------------------------

;;; StoredCont -- wraps serialized continuation bytes with a timestamp.
;;; Since: Guestbook example
(defstruct StoredCont
  [cont-bytes : bytes   ; output of serial-cont->bytes
   created-at : int64]) ; unix-now at time of storage

;;; Serializable instance for StoredCont.
(definstance Serializable StoredCont
  (serialize [sc]
    (serialize (Pair sc.cont-bytes (int64->cstr sc.created-at))))
  (deserialize [b]
    (match (deserialize b : (Result (Pair bytes cstr) cstr))
      (Err msg) -> (Err msg)
      (Ok pair) ->
        (Ok (StoredCont
              :cont-bytes (Pair.first pair)
              :created-at (cstr->int64 (Pair.second pair)))))))

; ---------------------------------------------------------------------------
; Internal helpers
; ---------------------------------------------------------------------------

;;; cont-path -- return the file path for a given token.
(defn cont-path [token : cstr] : cstr
  (str CONTS-DIR token ".bin"))

;;; continuation-expired? -- true if the stored continuation is too old.
(defn continuation-expired? [sc : StoredCont] : bool
  (> (- (unix-now) sc.created-at) CONT-TTL-SECONDS))

; ---------------------------------------------------------------------------
; Public API
; ---------------------------------------------------------------------------

;;; store-continuation -- serialize k and save to data/conts/<token>.bin.
;;;
;;; Parameters:
;;;   k -- a serial-continuation whose resume value is cstr (the POST body)
;;;
;;; Returns:
;;;   A signed hex token string identifying this continuation.
;;;
;;; Example:
;;;   (def token (store-continuation k))
;;;   ; token = "abc123.<hmac>"
;;;
;;; Since: Guestbook example
(defn store-continuation [k : (serial-continuation cstr)] : cstr
  (def raw-token (random-hex-64))
  (def sc (StoredCont
             :cont-bytes (serial-cont->bytes k)
             :created-at (unix-now)))
  (file-write (cont-path raw-token) (serialize sc))
  (sign-token raw-token SERVER-SECRET))

;;; load-continuation -- deserialize a continuation from disk.
;;;
;;; Parameters:
;;;   signed -- signed token string returned by store-continuation
;;;
;;; Returns:
;;;   (Option (serial-continuation cstr)) --
;;;     Some(k) if the token is valid and not expired,
;;;     None if missing, tampered, expired, or schema mismatch.
;;;
;;; Example:
;;;   (match (load-continuation token)
;;;     (None)  -> (send-error "Unknown or expired token")
;;;     (Some k) -> (serial-resume k body))
;;;
;;; Since: Guestbook example
(defn load-continuation [signed : cstr]
    : (Option (serial-continuation cstr))
  (match (verify-token signed SERVER-SECRET)
    (None) -> (None)
    (Some raw-token) ->
      (match (file-read (cont-path raw-token))
        (Err _) -> (None)
        (Ok file-bytes) ->
          (match (deserialize file-bytes : (Result StoredCont cstr))
            (Err _) -> (None)
            (Ok sc) ->
              (if (continuation-expired? sc)
                (None)
                (match (bytes->serial-cont sc.cont-bytes
                          : (Result (serial-continuation cstr) cstr))
                  (Err _)  -> (None)
                  (Ok k)   -> (Some k)))))))

;;; evict-expired-conts -- delete continuation files older than the TTL.
;;;
;;; Call this periodically (e.g., once per minute) to reclaim disk space.
;;;
;;; Returns:
;;;   unit
;;;
;;; Since: Guestbook example
(defn evict-expired-conts [] : unit
  (def files (dir-list CONTS-DIR))
  (Vec.for-each files (fn [path]
    (match (file-read path)
      (Err _) -> (unit) ; skip unreadable files
      (Ok file-bytes) ->
        (match (deserialize file-bytes : (Result StoredCont cstr))
          (Err _) -> (file-delete path)  ; corrupt file -- remove it
          (Ok sc) ->
            (when (continuation-expired? sc)
              (file-delete path)))))))
