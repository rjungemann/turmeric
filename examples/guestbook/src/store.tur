;;; store -- the guestbook entries, one line per entry on disk.
;;;
;;; data/entries.txt holds "posted-at<TAB>name<TAB>message\n" per entry, oldest
;;; first.  Name and message are HTML-escaped before they get here (which also
;;; removes tabs and newlines), so the file needs no quoting.  Appends go
;;; through a temp file + rename, so a crash mid-write leaves the previous
;;; file intact.
;;;
;;; Since: Guestbook example
(defmodule store
  (export store-init! store-append! store-lines)

  ;;; store-init! -- create the data directories (mkdir -p) so writes succeed.
  (defn store-init! [] : int
    ```c
    #include <sys/stat.h>
    #ifdef _WIN32
    #include <direct.h>
    #define TUR_GB_MKDIR(p) _mkdir(p)
    #else
    #define TUR_GB_MKDIR(p) mkdir(p, 0755)
    #endif
    TUR_GB_MKDIR("data");
    TUR_GB_MKDIR("data/conts");
    return 0;
    ```)

  ;;; store-lines -- the whole entries file, or "" when there is none yet.
  (defn store-lines [] : cstr
    ```c
    FILE *f = fopen("data/entries.txt", "rb");
    if (!f) return "";
    fseek(f, 0, SEEK_END);
    long n = ftell(f);
    if (n < 0) { fclose(f); return ""; }
    rewind(f);
    char *buf = (char *)malloc((size_t)n + 1);
    if (!buf) { fclose(f); return ""; }
    size_t got = fread(buf, 1, (size_t)n, f);
    fclose(f);
    buf[got] = 0;
    return buf;
    ```)

  ;;; store-append! -- add an entry and rewrite the file atomically.
  ;;;
  ;;; Parameters:
  ;;;   name    -- escaped author name
  ;;;   message -- escaped message
  ;;;
  ;;; Returns:
  ;;;   1 on success, 0 when the file could not be written.
  (defn store-append! [name : cstr message : cstr] : int
    ```c
    #include <time.h>
    FILE *old = fopen("data/entries.txt", "rb");
    FILE *tmp = fopen("data/entries.tmp", "wb");
    if (!tmp) { if (old) fclose(old); return 0; }
    if (old) {
      char buf[4096]; size_t n;
      while ((n = fread(buf, 1, sizeof buf, old)) > 0) fwrite(buf, 1, n, tmp);
      fclose(old);
    }
    fprintf(tmp, "%lld\t%s\t%s\n", (long long)time(NULL), name, message);
    fclose(tmp);
    return rename("data/entries.tmp", "data/entries.txt") == 0 ? 1 : 0;
    ```))
