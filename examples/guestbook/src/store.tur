;;; store.tur -- guestbook entry store: load, append, and list.
;;;
;;; Entries are persisted to data/entries.bin as a serialized (Vec GuestEntry).
;;; Writes are atomic: the file is written to a temp path then renamed over
;;; the live file, so a crash during a write leaves the previous data intact.
;;;
;;; Since: Guestbook example

(def ENTRIES-PATH "data/entries.bin")
(def ENTRIES-TMP  "data/entries.tmp")

; ---------------------------------------------------------------------------
; GuestEntry struct and Serializable instance
; ---------------------------------------------------------------------------

;;; GuestEntry -- a single guestbook post.
;;;
;;; Since: Guestbook example
(defstruct GuestEntry
  [name      : cstr    ; HTML-escaped author name
   message   : cstr    ; HTML-escaped message text
   posted-at : int64]) ; Unix timestamp (seconds since epoch)

;;; Serializable instance for GuestEntry.
;;; Serialized as a Vec of three cstr values: name, message, posted-at string.
(definstance Serializable GuestEntry
  (serialize [e]
    (serialize (Vec.of [e.name e.message (int64->cstr e.posted-at)])))
  (deserialize [b]
    (match (deserialize b : (Result (Vec cstr) cstr))
      (Err msg) -> (Err msg)
      (Ok parts) ->
        (if (< (Vec.len parts) 3)
          (Err "GuestEntry: expected 3 fields in serialized Vec")
          (Ok (GuestEntry
                :name      (Vec.get parts 0)
                :message   (Vec.get parts 1)
                :posted-at (cstr->int64 (Vec.get parts 2))))))))

; ---------------------------------------------------------------------------
; In-memory snapshot (simple global ref -- single-threaded server)
; ---------------------------------------------------------------------------

(def entries-cache : (ref (Vec GuestEntry)) (ref (Vec.new)))

; ---------------------------------------------------------------------------
; Public API
; ---------------------------------------------------------------------------

;;; store-load -- load all guestbook entries from disk.
;;;
;;; Populates the in-memory cache and returns the entries.
;;; Returns an empty Vec if the entries file does not exist yet.
;;;
;;; Returns:
;;;   (Vec GuestEntry) -- all entries, oldest first.
;;;
;;; Since: Guestbook example
(defn store-load [] : (Vec GuestEntry)
  (match (file-read ENTRIES-PATH)
    (Err _) ->
      (set! entries-cache (ref (Vec.new)))
      (Vec.new)
    (Ok bytes) ->
      (match (deserialize bytes : (Result (Vec GuestEntry) cstr))
        (Err _) ->
          (set! entries-cache (ref (Vec.new)))
          (Vec.new)
        (Ok entries) ->
          (set! entries-cache (ref entries))
          entries)))

;;; store-append -- append a new entry and flush to disk.
;;;
;;; Parameters:
;;;   entry -- the GuestEntry to append
;;;
;;; Returns:
;;;   unit
;;;
;;; Since: Guestbook example
(defn store-append [entry : GuestEntry] : unit
  (def current (deref entries-cache))
  (def updated (Vec.append current entry))
  (set! entries-cache (ref updated))
  (def bytes (serialize updated))
  (file-write ENTRIES-TMP bytes)
  (file-rename ENTRIES-TMP ENTRIES-PATH))

;;; store-all -- return a snapshot of all current entries.
;;;
;;; Returns:
;;;   (Vec GuestEntry) -- most-recent entry last.
;;;
;;; Since: Guestbook example
(defn store-all [] : (Vec GuestEntry)
  (deref entries-cache))
