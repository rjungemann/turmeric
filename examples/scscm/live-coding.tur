;; examples/scscm/live-coding.tur — Live-Coding Example
;;
;; This example demonstrates live-coding with SCSCM:
;; - Creating a live session
;; - Playing notes with automatic cleanup
;; - Using patterns
;; - Hot-reloading synths

(import scscm/scscm :scscm)

;; Create a live-coding session
(def session (scscm/live-session-new))

(println "Live session created. World ID:" (get-in session [:base :world-id]))

;; Play a simple note
(def note-1 (scscm/play-note session "sin" 60 100 1.0))  ;; Middle C, velocity 100, 1 second duration
(println "Playing note:" note-1)

;; Play a chord (multiple notes)
(def note-2 (scscm/play-note session "sin" 64 90 1.5))  ;; E4
(def note-3 (scscm/play-note session "sin" 67 80 1.5))  ;; G4
(def note-4 (scscm/play-note session "sin" 72 70 1.5))  ;; C5

;; Wait for notes to finish (simulate time passing)
;; In a real application, this would be handled by the audio callback
(thread/sleep 2000)

;; Create a pattern player
;; This plays a simple bass line
(def bass-pattern
  (scscm/cycle 60 62 64 65))  ;; C, D, E, F

def bass-player
  (scscm/play-pattern session "sin" 
    (fn [beats]
      (let [note-opt (bass-pattern beats)
            note (if (some? note-opt) (unwrap note-opt) 60)]
        {0 (scscm/midi->hz note)  ;; Frequency from MIDI note
         1 0.4                  ;; Amplitude
         2 0.0}))             ;; Pan center
    120 0.5))  ;; 120 BPM, check every 0.5 beats (8th notes)

(println "Bass pattern started, player ID:" bass-player)

;; Wait for pattern to play
(thread/sleep 1000)

;; Stop the pattern
(scscm/pattern-player-stop bass-player)
(println "Bass pattern stopped")

;; Create a more complex pattern with Euclidean rhythm
def kick-pattern (scscm/euclidean 3 8))  ;; 3 kicks in 8 steps

def kick-player
  (scscm/play-pattern session "kick"
    (fn [beats]
      (let [val-opt (kick-pattern beats)
            val (if (some? val-opt) (unwrap val-opt) 0)]
        (when (== 1 val)
          {0 40.0   ;; Bass frequency
           1 0.8   ;; Amplitude
           2 0.5})) ;; Decay
    120 0.25))  ;; 120 BPM, check every 16th note

(println "Kick pattern started, player ID:" kick-player)

;; Wait
(thread/sleep 1000)

;; Stop kick pattern
(scscm/pattern-player-stop kick-player)

;; Demonstrate synth replacement (hot-reloading)
;; First create a synth
(def old-synth (scscm/session-synth-new (:base session) "sin"))
(scscm/session-synth-set (:base session) old-synth {0 440.0 1 0.5})
(println "Created synth:" old-synth)

;; Replace it with a new definition
;; In a real application, you would have loaded a new SynthDef
;; For now, we just replace with the same definition
(def new-synth (scscm/synth-replace session old-synth "sin"))
(println "Replaced synth" old-synth "with" new-synth)

;; Clean up
(scscm/live-session-destroy session)
(println "Live session destroyed")
