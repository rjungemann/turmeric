;;
;; Tidal Examples: Drum Patterns
;; Demonstrates drum pattern creation and manipulation
;;

(import tidal/pattern tidal/temporal tidal/structural tidal/synth tidal/mini)

;; ============================================================
;; 1. Basic Drum Patterns using Kick, Snare, Hat helpers
;; ============================================================

;; Simple kick on every beat
(def simple-kick (kick [0.0]))

;; Kick on beats 0 and 2
(def kick-every-other (kick [0.0 2.0]))

;; Snare on beats 1 and 3
(def snare-backbeat (snare [1.0 3.0]))

;; Closed hat on every 8th note
(def hat-8th (hat [0.0 0.5 1.0 1.5 2.0 2.5 3.0 3.5]))

;; Open hat on off beats
(def open-hat (hat [0.5 1.5 2.5 3.5]))

;; ============================================================
;; 2. Combined Drum Patterns
;; ============================================================

;; Basic beat: kick on 0 and 2, snare on 1 and 3, hat on 8ths
(def basic-beat (stack 
  (kick [0.0 2.0])
  (snare [1.0 3.0])
  (hat [0.0 0.5 1.0 1.5 2.0 2.5 3.0 3.5])))

;; Rock beat with louder kick
(def rock-beat (stack 
  (kick [0.0 2.0] :vel 120)
  (snare [1.0 3.0] :vel 100)
  (hat [0.0 0.5 1.0 1.5 2.0 2.5 3.0 3.5] :vel 60)))

;; ============================================================
;; 3. Using drum-pattern helper
;; ============================================================

;; Define drum hits as (note velocity) pairs
(def basic-drum-hits [(36 127) (none 0) (38 100) (none 0)])

def basic-drum-pattern (apply drum-pattern basic-drum-hits))

;; More complex drum pattern
(def funky-drum-hits [
  (36 127)   ;; Kick
  (none 0)   ;; Rest
  (36 120)   ;; Kick (softer)
  (none 0)   ;; Rest
  (38 110)   ;; Snare
  (none 0)   ;; Rest
  (36 127)   ;; Kick
  (42 80)    ;; Closed hat
])

def funky-drum-pattern (apply drum-pattern funky-drum-hits))

;; ============================================================
;; 4. Euclidean Drum Patterns
;; ============================================================

;; Create a pattern using Bjorklund's algorithm
(def euclid-kick (euclid 8 3))  ;; 3 hits in 8 steps

def euclid-snare (euclid 8 2))  ;; 2 hits in 8 steps

def euclid-hat (euclid 8 5))    ;; 5 hits in 8 steps

;; Combine euclidean patterns into a full beat
(def euclid-beat (stack 
  (kick (filter #(== % 1) (euclid-kick)))
  (snare (filter #(== % 1) (euclid-snare)))
  (hat (filter #(== % 1) (euclid-hat)))))

;; Helper to convert euclidean float pattern to beat times
def euclid-to-beats [euclid-pat]
  (map (fn [i] (if (== (euclid-pat i) 1.0) i)) (range 0 (int (ceil (* 2 (len euclid-pat)))))))

;; ============================================================
;; 5. Temporal Transformations on Drums
;; ============================================================

;; Double-time hats (play twice as fast)
(def double-hats (fast 2 (hat [0.0 0.5 1.0 1.5])))

;; Half-time kick (play half as fast)
(def half-kick (slow 2 (kick [0.0 1.0])))

;; Shifted snare (delayed by 16th note)
(def shifted-snare (shift 0.25 (snare [1.0 3.0])))

;; ============================================================
;; 6. Layered Drum Patterns
;; ============================================================

;; Layer multiple drum patterns with different characteristics
(def layered-beat (stack 
  ;; Main kick
  (kick [0.0 2.0] :vel 127)
  
  ;; Ghost snare (quieter, on 8th notes)
  (snare [0.5 1.5 2.5 3.5] :vel 70)
  
  ;; Main snare
  (snare [1.0 3.0] :vel 110)
  
  ;; Closed hats
  (hat [0.0 0.25 0.5 0.75 1.0 1.25 1.5 1.75 2.0 2.25 2.5 2.75 3.0 3.25 3.5 3.75] :vel 80)
  
  ;; Open hat on off beats
  (hat [0.5 1.5 2.5 3.5] :vel 90 :note 46)  ;; Open hat is note 46
  ))

;; ============================================================
;; 7. Polyrhythmic Drum Patterns
;; ============================================================

;; Kick in 4/4, snare in 3/4
(def poly-drums (stack 
  (polymeter 1.0 (kick [0.0 1.0 2.0 3.0]))
  (polymeter 1.5 (snare [0.0 1.0 2.0]))
  (polymeter 0.5 (hat [0.0 0.5 1.0 1.5 2.0 2.5 3.0 3.5]))))

;; ============================================================
;; 8. Mini-Notation Drum Patterns
;; ============================================================

;; Using mini-notation for concise drum patterns
(def mini-drum-1 (parse-drums "bd sd"))

def mini-drum-2 (parse-drums "bd*2 sd"))

def mini-drum-3 (parse-drums "bd sd hh cp"))

;; More complex mini-notation
(def mini-drum-4 (s "bd(5,8) sd(3,8) hh*4"))

;; ============================================================
;; 9. Conditional Drum Patterns
;; ============================================================

;; Every other measure, add a crash cymbal
(def varying-beat (stack 
  (kick [0.0 2.0])
  (snare [1.0 3.0])
  (hat [0.0 0.5 1.0 1.5 2.0 2.5 3.0 3.5])
  (every 8 (cymbal [4.0]) 0)))

;; Fill on the 4th measure
(def fill-beat (stack 
  (kick [0.0 2.0])
  (snare [1.0 3.0])
  (hat [0.0 0.5 1.0 1.5 2.0 2.5 3.0 3.5])
  (every 4 (stack 
    (snare [0.25 0.75 1.25 1.75 2.25 2.75 3.25 3.75] :vel 90)
    (kick [0.5 1.5 2.5 3.5] :vel 100)) 0)))

;; ============================================================
;; 10. Helper Functions
;; ============================================================

(defn print-drum-pattern [name p beats]
  (println (str "\n" name ":"))
  (doseq [t beats]
    (let [result (p t)]
      (if (map? result)
        (println (str "  beat " t ": " (:note result) " vel=" (:vel result)))
        (println (str "  beat " t ": " result))))))

;; ============================================================
;; Main Demo Function
;; ============================================================

(defn run-demos []
  (println "\n" (repeat 50 "="))
  (println "TIDAL DRUM PATTERNS DEMO")
  (println (repeat 50 "="))
  
  (println "\n--- Basic Drum Patterns ---")
  (print-drum-pattern "Simple kick" simple-kick [0.0 0.5 1.0])
  (print-drum-pattern "Kick every other" kick-every-other [0.0 1.0 2.0 3.0])
  
  (println "\n--- Combined Beat ---")
  (print-drum-pattern "Basic beat" basic-beat [0.0 0.5 1.0 1.5 2.0 2.5 3.0 3.5])
  
  (println "\n--- Euclidean Patterns ---")
  (print-drum-pattern "Euclid kick (3 in 8)" (kick (euclid-to-beats (euclid 8 3))) [0.0 1.0 2.0 3.0])
  
  (println "\n--- Temporal Transformations ---")
  (print-drum-pattern "Double hats" double-hats [0.0 0.25 0.5 0.75 1.0])
  
  (println "\n--- Layered Beat ---")
  (print-drum-pattern "Layered beat" layered-beat [0.0 0.5 1.0 1.5 2.0 2.5 3.0 3.5])
  
  (println "\n--- Mini-Notation ---")
  (print-drum-pattern "Mini drum 1" mini-drum-1 [0.0 1.0 2.0 3.0])
  
  (println "\n" (repeat 50 "="))
  (println "Drum patterns demo complete!")
  (println (repeat 50 "="))
  
  nil)

;; Run demos if executed directly
(when (== (get *argv* 0) "run")
  (run-demos))
