# Generated C/H output from `tur build` / `tur emit-c`.
# Negative patterns keep genuine hand-written sources tracked.
*.c
*.h
!src/**/*.c
!src/**/*.h
!tests/**/*.c
!tests/**/*.h
!examples/**/*.c
!examples/**/*.h
!docs/**/*.c
!docs/**/*.h
!tools/**/*.c
!tools/**/*.h

# Python bytecode
__pycache__/
*.pyc

tests/out/
tests/fixtures/**/actual.*
# Generated test/benchmark artifacts written in-place by the harnesses
# (run-cli.sh writes actual.* next to its fixtures; run-bench.sh compiles
# benchmarks into tests/benchmarks/output/).
tests/cli/**/actual.*
tests/benchmarks/output/
# Build caches/artifacts left when a dedicated runner builds a fixture
# in-place (e.g. run-build-shared.sh). `tur` also auto-writes a .gitignore
# with .tur-abi-cache/ inside built dirs; ignore both so test runs stay clean.
.tur-abi-cache/
tests/fixtures/**/.gitignore
tests/.stamp-cache/
tests/.stamp-cache-doctest/
tests/.stamp-cache-turi/
tests/.stamp-cache-jit/
tests/doctest-generated/
/tmp/tur-build/
tur
hello
debug_iter
hamt-bench-insert
input
hash_map
primes
sort

# Test/build output files
actual_test.stderr
build_stderr.txt

# Generated docs HTML (source markdown stays in docs/guides/ and stdlib/)
docs/html/
docs/api/

# Web
web/node_modules/
web/dist/
web/test-results/
web/.vite/
web/.wrangler/

# WASM build outputs. `tur_wasm` copies these out of build-wasm/ into
# web/public/ (src/CMakeLists.txt), where vite picks them up as static assets.
# They are build products, not source: tracking them forced a second
# "regenerate web artifacts" commit after every deploy and left each release
# tag carrying the *previous* release's binary. Run `just wasm` (or
# `tur run wasm`) to produce them; `just web` / `just deploy-web` do it for you.
web/public/turmeric.js
web/public/turmeric.wasm

# Doc-name index behind the web REPL's doc panel, emitted by `just docs`
# (tools/gendocs.py --emit-json). Same story as the wasm pair above: tracking
# it meant every release tag either carried a stale index -- v0.32.3 nearly
# shipped without a single `rat/*` or `complex/*` entry -- or dirtied the tree
# mid-deploy. It also merges spice entries from the *optional* sibling
# ../turmeric-spices/ checkout, so a contributor who has that clone and one
# who does not could never agree on its contents. Note this is unlike
# stdlib/docstrings.tur, gendocs' other emitted output, which stays tracked
# because it is a real source module the compiler imports.
web/public/doc-names.json

# Playwright MCP browser session artifacts
.playwright-mcp/

# clangd LSP index (machine-specific, regenerated automatically)
.cache/

# Claude Code session memory (developer-local)
memory/
core

# Performance comparison build artifacts and generated output
performance-comparison/benchmarks/*/c/
performance-comparison/benchmarks/*/turi/*
!performance-comparison/benchmarks/*/turi/*.tur
performance-comparison/benchmarks/*/turmeric/*
!performance-comparison/benchmarks/*/turmeric/*.tur
performance-comparison/analysis/
performance-comparison/results/processed/
performance-comparison/results/raw/
performance-comparison/results/validation_report.json
performance-comparison/benchmarks/rust-workspace/
performance-comparison/inputs/large/

# Test fixture runtime artifacts (interpreter stdout/stderr captured per run).
# The harness diffs against expected.stdout, not these files.
tests/fixtures/*/turi.stdout
tests/fixtures/*/turi.stderr
tests/fixtures/*/jit.stdout
tests/fixtures/*/jit.stderr
# Nested fixtures (errors/<name>, typed/<name>, typed-slots/<name>, ...).
tests/fixtures/*/*/turi.stdout
tests/fixtures/*/*/turi.stderr
tests/fixtures/*/*/jit.stdout
tests/fixtures/*/*/jit.stderr

# REPL-compiled spice shared libraries and their symbol manifests.
*.so
*.so.manifest

# Claude Code agent worktrees (transient, harness-managed)
.claude/worktrees/


