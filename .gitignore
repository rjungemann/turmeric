!src/**/*.h
!tests/**/*.c
!tests/**/*.h
!examples/**/*.c
!examples/**/*.h

tests/out/
tests/fixtures/**/actual.*
tests/.stamp-cache/
tests/.stamp-cache-doctest/
tests/doctest-generated/
/tmp/tur-build/
tur
hello
debug_iter
hamt-bench-insert
input
hash_map
primes
sort

