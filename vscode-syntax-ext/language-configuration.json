{
  "comments": {
    "lineComment": ";",
    "blockComment": [
      "#|",
      "|#"
    ]
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "colorizedBracketPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_?!*+\\-/<>=]*",
  "indentationRules": {
    "increaseIndentPattern": "(^\\s*([\\(\\[\\{]|.*(def|defn|if|match|let|lambda|do|effect|handle)).*$)",
    "decreaseIndentPattern": "(^\\s*[\\)\\]\\}])"
  }
}
