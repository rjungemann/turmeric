; Turmeric Syntax Test File
; This file tests all major syntax highlighting features

#| Block comment
   This is a multi-line block comment
   using #| ... |# syntax
|#

; ============================================================================
; Section 1: Basic Control Flow
; ============================================================================

(if (> x 10)
  (println "x is greater than 10")
  (println "x is not greater than 10"))

(cond
  [(eq? x 0) "zero"]
  [(< x 0) "negative"]
  [else "positive"])

(match expr
  [(pattern1 x) (do-something x)]
  [(pattern2 y z) (combine y z)]
  [_ "default"])

(loop [i 0]
  (when (< i 10)
    (println i)
    (recur (+ i 1))))

; ============================================================================
; Section 2: Definitions and Functions
; ============================================================================

(defn add [x y]
  (+ x y))

(def PI 3.14159)

(defn* factorial [n]
  (if (= n 0)
    1
    (* n (factorial (- n 1)))))

(defmacro when [test & body]
  `(if ~test
     (do ~@body)))

(defmodule math
  (export [add subtract multiply divide])
  (defn add [a b] (+ a b))
  (defn subtract [a b] (- a b)))

; ============================================================================
; Section 3: Types and Typeclasses
; ============================================================================

(type Point
  [x: Int
   y: Int])

(type Result [a b]
  [Ok a]
  [Err b])

(typeclass Monoid [a]
  [mempty: a]
  [mappend: (-> a a a)])

(impl Monoid [String]
  [mempty: ""]
  [mappend: concat])

; ============================================================================
; Section 4: Effects and Exception Handling
; ============================================================================

(effect Reader [r]
  [ask: (-> r)])

(defn handle-reader [action reader]
  (handle action
    [ask! resume => (resume reader)]))

(try
  (read-file "data.txt")
  (catch FileNotFound [e]
    (println "File not found:" (.-name e)))
  (catch IOError [e]
    (println "IO error:" (.-message e)))
  (finally
    (println "Cleanup complete")))

; ============================================================================
; Section 5: Let Bindings and Lambda
; ============================================================================

(let [x 10
      y 20
      z (+ x y)]
  (+ x y z))

(let* [x 5
       y (* x 2)
       z (* y 3)]
  (+ x y z))

(lambda [x] (* x x))
(fn [a b] (+ a b))

