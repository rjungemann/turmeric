; Integers
42
-17
0

; Floats
3.14
-2.71828
1.0e10
1.5e-3

; Hex and Binary
0xFF
0b11010110
0xDEADBEEF
0b10101010

; Arithmetic
(+ 1 2 3)
(- 10 5)
(* 3 4)
(/ 15 3)
(% 17 5)
(** 2 8)

; Comparisons
(= x y)
(!= a b)
(< a b)
(> x y)
(<= i 10)
(>= count 5)

; ============================================================================
; Section 7: Strings and Characters
; ============================================================================

"Hello, World!"
"String with \"escaped\" quotes"
"Multiline strings are
not supported yet"
"Escape sequences: \n \t \r \\ \""

#\a
#\newline
#\space
#\tab

; String operations
(str "Hello" " " "World")
(concat "foo" "bar" "baz")
(split "a,b,c" ",")

; ============================================================================
; Section 8: Collections and Sequences
; ============================================================================

(list 1 2 3 4 5)
(vec 10 20 30 40)
[1 2 3 4]
(first [1 2 3])
(rest [1 2 3])
(cons 1 [2 3 4])
(append [1 2] [3 4])
(reverse [1 2 3])

(len [1 2 3 4 5])
(nth [a b c d] 2)
(set-nth! vec 0 "new-value")

; ============================================================================
; Section 9: Mapping and Functional Operations
; ============================================================================

(map (fn [x] (* x 2)) [1 2 3 4])
(filter (fn [x] (> x 5)) [1 10 3 8 2 9])
(reduce + 0 [1 2 3 4 5])
(fold * 1 [2 3 4])

; ============================================================================
; Section 10: Quotes and Meta-programming
; ============================================================================

'(+ 1 2)
`(+ 1 ,(+ 2 3))
`,@values
,expr

(quote (+ 1 2))
(quasiquote (list 1 2 ~expr))
(unquote expr)
(unquote-splicing lst)

; ============================================================================
; Section 11: Threading and Piping
; ============================================================================

(-> value
  (+ 1)
  (* 2)
  (- 5))

(->> collection
  (filter odd?)
  (map square)
  (reduce +))

(|> data
  (transform 10)
  (validate)
  (print))

; ============================================================================
; Section 12: Boolean Operations
; ============================================================================

#t
#f
true
false

(and #t #t)
(or #f #f)
(not #t)

(and (> x 0) (< x 100))
(or (null? x) (empty? x))

; ============================================================================
; Section 13: Type Checks
; ============================================================================

(type-of 42)
(type-of "string")
(is-a? value String)

(string? x)
(number? y)
(vector? z)
(list? w)
(boolean? v)
(null? u)
(atom? a)
(pair? p)
(symbol? s)
(empty? e)

; ============================================================================
; Section 14: Sweet-exp Syntax (Indentation-based)
; ============================================================================

defn fibonacci [n]
  if {n < 2}
    n
    {fibonacci{n - 1} + fibonacci{n - 2}}

let
  x: 10
  y: 20
  z: {x + y}
  println z

; ============================================================================
; Section 15: Data Structures and Pattern Matching
; ============================================================================

(defstruct Person
  [name: String
   age: Int
   email: String])

(deftuple Pair [a b])

(def person
  (Person
    :name "Alice"
    :age 30
    :email "alice@example.com"))

(match person
  [(Person :name n :age a) (println n a)]
  [other (println "Unknown:" other)])

; ============================================================================
; Section 16: Edge Cases and Special Forms
; ============================================================================

; Empty list
()
[]

; Self-evaluating atoms
nil
null
none
unit

; Special operators
(apply add [1 2 3])
(eval '(+ 1 2))
(define x 10)

; ============================================================================
; Section 17: Turmeric-specific Features
; ============================================================================

(use stdlib.vec)
(use stdlib.option)

(import [List map filter])
(export [add subtract multiply])

; Optional values
(Some value)
(None)

; Results
(Ok result)
(Err error)

; End of test file
