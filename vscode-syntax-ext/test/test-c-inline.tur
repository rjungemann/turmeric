;; test-c-inline.tur -- manual verification fixture for c-inline syntax highlighting
;;
;; Open this file in VSCode with the updated extension installed and verify:
;;   1. C keywords (return, int64_t, if) are highlighted in C theme colours.
;;   2. Fence delimiters (```c, ```) receive punctuation scope colour.
;;   3. No highlighting bleeds outside the block into surrounding Turmeric code.

;; ------------------------------------------------------------------
;; Case 0: One-line C block (common in stdlib)
;; ------------------------------------------------------------------

(defn mzero [] :int ```c return 0; ```)

(defn arrow-left [f]
  (let [fv f]
    (fn [eac]
      ```c return 0; ```)))

;; ------------------------------------------------------------------
;; Case 1: C block at module level (unusual but legal)
;; ------------------------------------------------------------------

```c
#include <stdint.h>
int64_t module_level_helper(int64_t x) {
    return x * 2;
}
```

;; ------------------------------------------------------------------
;; Case 2: C block inside a defn (standard use case)
;; ------------------------------------------------------------------

(defn file-size [f] :int
  ```c
  FILE* file = (FILE*)f;
  fseek(file, 0, SEEK_END);
  return (int)ftell(file);
  ```)

;; ------------------------------------------------------------------
;; Case 3: union and pointer casts (real-world complexity)
;; ------------------------------------------------------------------

(defn arrow-target [ptr] :ptr
  ```c
  typedef union Arrow Arrow;
  union Arrow {
      void*    target;
      int64_t  tag;
  };
  Arrow* a = (Arrow*)ptr;
  if (a->tag == 0) {
      return a->target;
  }
  return (void*)0;
  ```)

;; ------------------------------------------------------------------
;; Case 4: extern-c adjacent to a C block -- verify no scope bleed
;; ------------------------------------------------------------------

(extern-c fopen  [^cstr ^cstr] :ptr)
(extern-c fclose [^ptr]        :int)

(defn open-and-size [path] :int
  ```c
  FILE* f = fopen((const char*)path, "rb");
  if (!f) return -1;
  fseek(f, 0, SEEK_END);
  int64_t sz = (int64_t)ftell(f);
  fclose(f);
  return sz;
  ```)

;; Turmeric code after the block -- must NOT be highlighted as C
(defn double-size [path] :int
  (let [sz (open-and-size path)]
    (* sz 2)))
