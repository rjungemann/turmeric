{
  "name": "turmeric-syntax",
  "displayName": "Turmeric Syntax Highlighting",
  "description": "Syntax highlighting for Turmeric (.tur) files with sweet-exp support",
  "version": "0.2.0",
  "publisher": "fith-lang",
  "license": "MIT",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.50.0"
  },
  "activationEvents": [
    "onLanguage:turmeric"
  ],
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "turmeric",
    "tur",
    "lisp",
    "scheme",
    "sweet-exp"
  ],
  "contributes": {
    "commands": [
      {
        "command": "turmeric.formatDocument",
        "title": "Format Turmeric Document"
      }
    ],
    "languages": [
      {
        "id": "turmeric",
        "aliases": [
          "Turmeric",
          "turmeric"
        ],
        "extensions": [
          ".tur"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "turmeric",
        "scopeName": "source.turmeric",
        "path": "./syntaxes/turmeric.tmLanguage.json"
      },
      {
        "scopeName": "markdown.embedding.turmeric",
        "path": "./syntaxes/turmeric.markdown-injection.json",
        "injectTo": ["text.html.markdown"],
        "embeddedLanguages": {
          "meta.embedded.block.turmeric": "turmeric"
        }
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fith-lang/fith"
  },
  "bugs": {
    "url": "https://github.com/fith-lang/fith/issues"
  },
  "homepage": "https://github.com/fith-lang/fith#readme"
}
