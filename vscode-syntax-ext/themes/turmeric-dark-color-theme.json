{
  "$schema": "vscode://schemas/color-theme",
  "name": "Turmeric Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background":                    "#0C0A08",
    "editor.foreground":                    "#EAE0D2",
    "editorGutter.background":              "#0C0A08",
    "editorLineNumber.foreground":          "#453F39",
    "editorLineNumber.activeForeground":    "#88796C",

    "editorCursor.foreground":              "#D48B1C",
    "editor.selectionBackground":           "#D48B1C2E",
    "editor.inactiveSelectionBackground":   "#D48B1C14",
    "editor.selectionHighlightBackground":  "#D48B1C14",
    "editor.wordHighlightBackground":       "#D48B1C1A",
    "editor.wordHighlightStrongBackground": "#D48B1C33",

    "editor.lineHighlightBackground":       "#111009",
    "editor.lineHighlightBorder":           "#00000000",

    "editorIndentGuide.background1":        "#252119",
    "editorIndentGuide.activeBackground1":  "#3E3830",

    "editorBracketMatch.background":        "#D48B1C1F",
    "editorBracketMatch.border":            "#D48B1C80",

    "editorFindMatch.background":           "#D48B1C47",
    "editorFindMatch.border":               "#D48B1CA6",
    "editorFindMatchHighlight.background":  "#D48B1C1F",

    "editorWidget.background":              "#181512",
    "editorWidget.border":                  "#302B24",
    "editorWidget.foreground":              "#EAE0D2",
    "editorSuggestWidget.background":       "#181512",
    "editorSuggestWidget.border":           "#302B24",
    "editorSuggestWidget.foreground":       "#EAE0D2",
    "editorSuggestWidget.selectedBackground": "#D48B1C26",
    "editorSuggestWidget.selectedForeground": "#EAE0D2",
    "editorSuggestWidget.highlightForeground": "#EFA030",
    "editorHoverWidget.background":         "#181512",
    "editorHoverWidget.border":             "#302B24",
    "editorHoverWidget.foreground":         "#EAE0D2",

    "scrollbar.shadow":                     "#00000000",
    "scrollbarSlider.background":           "#3E38308C",
    "scrollbarSlider.hoverBackground":      "#584F44BF",
    "scrollbarSlider.activeBackground":     "#D48B1C66",

    "focusBorder":                          "#D48B1C66",

    "activityBar.background":               "#0C0A08",
    "activityBar.foreground":               "#EAE0D2",
    "activityBar.inactiveForeground":       "#48433D",
    "activityBarBadge.background":          "#EFA030",
    "activityBarBadge.foreground":          "#0C0A08",
    "sideBar.background":                   "#0C0A08",
    "sideBar.foreground":                   "#EAE0D2",
    "sideBarTitle.foreground":              "#88796C",
    "sideBarSectionHeader.background":      "#111009",
    "sideBarSectionHeader.foreground":      "#EAE0D2",
    "statusBar.background":                 "#111009",
    "statusBar.foreground":                 "#EAE0D2",
    "statusBar.noFolderBackground":         "#111009",
    "statusBar.debuggingBackground":        "#D48B1C",
    "statusBar.debuggingForeground":        "#0C0A08",
    "titleBar.activeBackground":            "#0C0A08",
    "titleBar.activeForeground":            "#EAE0D2",
    "titleBar.inactiveBackground":          "#0C0A08",
    "titleBar.inactiveForeground":          "#88796C",
    "tab.activeBackground":                 "#0C0A08",
    "tab.activeForeground":                 "#EFA030",
    "tab.inactiveBackground":               "#111009",
    "tab.inactiveForeground":               "#88796C",
    "tab.border":                           "#0C0A08",
    "tab.activeBorderTop":                  "#EFA030",
    "panel.background":                     "#0C0A08",
    "panel.border":                         "#302B24",
    "panelTitle.activeForeground":          "#EFA030",
    "panelTitle.inactiveForeground":        "#88796C",
    "terminal.background":                  "#0C0A08",
    "terminal.foreground":                  "#EAE0D2",
    "terminalCursor.foreground":            "#D48B1C",
    "terminal.ansiBlack":                   "#0C0A08",
    "terminal.ansiRed":                     "#D9735A",
    "terminal.ansiGreen":                   "#A8C98A",
    "terminal.ansiYellow":                  "#EFA030",
    "terminal.ansiBlue":                    "#7AC4B8",
    "terminal.ansiMagenta":                 "#C4A0E8",
    "terminal.ansiCyan":                    "#7AC4B8",
    "terminal.ansiWhite":                   "#EAE0D2",
    "terminal.ansiBrightBlack":             "#48433D",
    "terminal.ansiBrightRed":               "#D9735A",
    "terminal.ansiBrightGreen":             "#A8C98A",
    "terminal.ansiBrightYellow":            "#EFA030",
    "terminal.ansiBrightBlue":              "#7AC4B8",
    "terminal.ansiBrightMagenta":           "#C4A0E8",
    "terminal.ansiBrightCyan":              "#7AC4B8",
    "terminal.ansiBrightWhite":             "#EAE0D2"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#48433D", "fontStyle": "italic" }
    },
    {
      "name": "Doc comments",
      "scope": ["comment.documentation", "comment.line.documentation"],
      "settings": { "foreground": "#88796C", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#D9735A" }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape", "constant.character.escape.turmeric"],
      "settings": { "foreground": "#EFA030" }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer.turmeric",
        "constant.numeric.float.turmeric",
        "constant.numeric.binary.turmeric",
        "constant.numeric.hex.turmeric"
      ],
      "settings": { "foreground": "#A8C98A" }
    },
    {
      "name": "Booleans / nil / keyword literals",
      "scope": [
        "constant.language",
        "constant.language.boolean.true.turmeric",
        "constant.language.boolean.false.turmeric",
        "constant.language.null.turmeric",
        "constant.other.keyword.turmeric",
        "constant.character.turmeric",
        "keyword.constant.null.turmeric"
      ],
      "settings": { "foreground": "#A8C98A" }
    },
    {
      "name": "Keywords -- control flow / definition (amber, bold)",
      "scope": [
        "keyword.control",
        "keyword.control.turmeric",
        "keyword.definition.turmeric",
        "keyword.exception.turmeric",
        "keyword.other.turmeric",
        "storage.type.function",
        "storage.modifier"
      ],
      "settings": { "foreground": "#EFA030", "fontStyle": "bold" }
    },
    {
      "name": "Builtins / effect keywords (violet)",
      "scope": [
        "keyword.effect.turmeric",
        "support.function.builtin.turmeric",
        "support.function",
        "entity.name.function.macro"
      ],
      "settings": { "foreground": "#C4A0E8" }
    },
    {
      "name": "Types (teal)",
      "scope": [
        "keyword.type.turmeric",
        "support.type",
        "entity.name.type",
        "entity.name.class",
        "storage.type"
      ],
      "settings": { "foreground": "#7AC4B8" }
    },
    {
      "name": "Operators (muted)",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic.turmeric",
        "keyword.operator.comparison.turmeric",
        "keyword.operator.assignment.turmeric",
        "keyword.operator.special.turmeric"
      ],
      "settings": { "foreground": "#6A5F58" }
    },
    {
      "name": "Delimiters (parens, brackets, curlies)",
      "scope": [
        "punctuation.section.sexp.begin.turmeric",
        "punctuation.section.sexp.end.turmeric",
        "punctuation.section.bracket.begin.turmeric",
        "punctuation.section.bracket.end.turmeric",
        "punctuation.section.curly-infix.begin.turmeric",
        "punctuation.section.curly-infix.end.turmeric",
        "punctuation"
      ],
      "settings": { "foreground": "#5A5448" }
    },
    {
      "name": "Function names (definition + neoteric call)",
      "scope": [
        "entity.name.function",
        "entity.name.function.turmeric",
        "entity.name.function.neoteric.turmeric"
      ],
      "settings": { "foreground": "#C4A0E8" }
    },
    {
      "name": "Variables / identifiers",
      "scope": ["variable", "variable.other.turmeric"],
      "settings": { "foreground": "#EAE0D2" }
    },
    {
      "name": "Quote forms",
      "scope": ["meta.quote.turmeric", "punctuation.definition.quote.turmeric"],
      "settings": { "foreground": "#C4A0E8" }
    },
    {
      "name": "Reader conditional / #lang directive",
      "scope": [
        "meta.reader-conditional.turmeric",
        "meta.lang-directive.turmeric",
        "keyword.preprocessor.lang.turmeric",
        "entity.name.namespace.turmeric"
      ],
      "settings": { "foreground": "#C4A0E8" }
    },
    {
      "name": "Inline-C blocks",
      "scope": ["meta.embedded.block.c", "source.c.embedded"],
      "settings": { "foreground": "#EAE0D2" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#D9735A", "fontStyle": "bold" }
    }
  ]
}
