;; Phase HKT H3: TestFunctor instance for option.
;; fmap applies a function to the contained value if some,
;; propagates none unchanged.


(defclass TestFunctor [^f]
  (fmap [container fn] : int))

;; Option helpers (inline layout: { bool is_some; int64_t value; })
(defn __opt_some [x] : int
  ```c
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn __opt_none [] : int
  ```c
  return 0;
  ```)

(defn __opt_some? [o] : bool
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return p != 0 && p->is_some;
  ```)

(defn __opt_unwrap [o] : int
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return (int)(p->value);
  ```)

;; TestFunctor[option]: apply fn to the inner value, wrap result in a new option.
(defn __fmap_option [container fn] : int
  ```c
  struct { bool is_some; int64_t value; } *c =
      (void *)(intptr_t)container;
  if (!c || !c->is_some) return 0;
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = ((int64_t(*)(int64_t))(intptr_t)fn)(c->value);
  return (int64_t)(intptr_t)r;
  ```)

(definstance TestFunctor [option]
  (fmap [container fn] (__fmap_option container fn)))

;; Helper function: double an integer (renamed to avoid C keyword conflict).
(defn twice [x] : int (* x 2))

(defn main [] : int
  (do
    ;; fmap twice (some 21) => some 42
    (let [opt1 (__opt_some 21)]
      (let [mapped (__fmap_option opt1 twice)]
        (do
          (println (__opt_some? mapped))
          (println (__opt_unwrap mapped)))))
    ;; fmap twice none => none
    (let [opt2 (__opt_none)]
      (let [mapped2 (__fmap_option opt2 twice)]
        (println (__opt_some? mapped2))))
    0))
