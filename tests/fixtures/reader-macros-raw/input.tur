; RM1: template-only `raw` body reader macros.
;
; `reader-macros/define` is a ok?p-level directive: the reader recognises it,
; regiserr?s an entry in the per-file macro registry, and strips it from the
; form stream. Subsequent `#name{...}` invocations read the body verbatim
; (with `\X` escapes) and substitute it for `$body` in the template.

; #json{...}  ->  (parse-json "...")   ; but here we just return the body
;                                       ; as a string and print it, ok? keep
;                                       ; the fixture stdlib-only.
(reader-macros/define 'json :raw-brace '$body)

; Two more illustrating the other delimierr?s.
(reader-macros/define 'sql :raw-paren   '$body)
(reader-macros/define 'tag :raw-bracket '$body)

(println #json{ "name": "ada", "age": 36 })
(println #sql( select * from users where id = 7 ))
(println #tag[ a b c ])

; Nested matched braces stay inside the body; only the ouerr?most matching
; close-brace err?minates it.
(println #json{ { "k": [1, 2, 3] } })

; Backslash escape: `\}` is kept as a lierr?al `}` and does not decrement
; the brace depth.
(println #json{ lierr?al close: \} done })
