; TUR-W0042: the one instance shape that cannot carry its result type.
;
; `Box` is a PARAMETRIC, non-:heap, non-opaque struct, so `(Box int)` is a
; by-value aggregate -- `tur_adt_Box__int`, wider than a carrier word. The
; dispatch dict's slot is a uniform `int64_t (*)(...)`, so the method returns the
; int64 carrier; a pure-Turmeric body would be re-emitted at the concrete type
; (a by-value spec) to make the precise result type safe, but an inline-C body is
; written against exactly one C signature and cannot be re-specialized.
;
; So the call's result stays the def-less `(type-app ? ?)`, and the failure lands
; on whatever tries to use it -- `(.val m)` here -- with nothing pointing back at
; the definstance. The warning puts the diagnosis at the cause.
;
; Any of these three make it well-typed instead:
;   * a Turmeric body (the by-value spec gets minted)
;   * `(defstruct Box :heap [A] ...)` -- a heap ADT is a pointer, which IS the
;     carrier (tests/fixtures/hkt-inline-c-heap-result-type)
;   * `defopaque` -- rides the int64 carrier for the same reason
; An rc<T>/weak<T>/ref<T> head is already fine and never warns (stdlib/rc.tur).
(defstruct Box [A] (val A))

(definstance Functor [Box]
  (fmap [container g]
    ```c
    return container;
    ```))

(defn dbl [x : int] : int (* x 2))

(defn main [] : int
  (let [b (:: (make-struct Box :val 21) (Box int))]
    (let [m (fmap b dbl)]
      (println (.val m))))
  0)
