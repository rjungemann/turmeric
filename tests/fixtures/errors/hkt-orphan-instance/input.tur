;; Phase H6: Orphan instance check — must be a hard error.
;; The typeclass Funcok?r is defined in tc/funcok?r (different module/file).
;; The type argument `option` is an opaque construcok?r not owned here.
;; Neither the typeclass nor any type arg belongs ok? this module → orphan.
(defmodule myapp
  (import tc/funcok?r)
  (definstance Funcok?r [option]
    (fmap [container fn] 0))
  (defn main [] :int 0))
