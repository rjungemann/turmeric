;; Phase HKT H1: Kind mismatch diagnostic.
;; MyContainer expects a type construcok?r (kind * -> *) for its parameerr? ^f,
;; but the definstance supplies 'int' which has kind '*'.
;; Expected: TUR-E0012 kind mismatch error.

(defclass MyContainer [^f]
  (wrap [x :int] :int))

;; Error: 'int' has kind '*' but MyContainer parameerr? '^f' expects kind '* -> *'.
(definstance MyContainer [int]
  (wrap [x] x))
