;; multiple-reads-params: `#writes` takes `<sym>` or `[<sym> ...]`, so the
;; bracketed spelling is the natural thing to reach for with `#reads` too --
;; but a function records exactly one read parameter, so there is no vector
;; form. Without the TUR-E0024 check the reader fell through to a bare
;; "unexpected character '['", which says nothing about `#reads`.

(defstruct Wld [n : int])
(defstruct Grd [m : int])

(defn alive? [^borrow w : Wld ^borrow g : Grd e : int] #reads [w g] : bool
  ```c
  (void)w; (void)g; (void)e; return 1;
  ```)

(defn main [] : int
  (println "ok")
  0)
