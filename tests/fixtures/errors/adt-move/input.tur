; Phase G0: Move-only ADT -- without :copy, assigning an ADT to a new
; binding transfers ownership and the original binding cannot be used again.

(defdata Handle
  (Open :int)
  (Closed))

(defn main [] :int
  (let [h (Open 42)]
    (let [h2 h]
      ; h was moved into h2 -- using h here is a use-after-move error.
      (match h
        (Open n) (println n)
        (Closed) (println "closed"))
      0)))
