;; process-wrong-handle -- an exit code (a plain :int) cannot stand in for a
;; ChildHandle. Acceptance test for the ChildHandle newtype from the
;; stdlib-linearity-affinity plan: process/spawn returns a linear ChildHandle
;; and process/wait accepts (and consumes) only a ChildHandle -- so passing a
;; bare integer (here an exit code) to process/wait, which type-checked when
;; children were bare pids, is now a compile-time error. A self/parent Pid from
;; process/pid is likewise rejected: it is not a spawned child to reap.
(load "stdlib/process.tur")

(defn main [] : int
  (let [code 0]
    (process/wait code))
  0)
