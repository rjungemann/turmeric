;; MS2: ^multishot handler capturing a ^unique (move-only) binding is forbidden.
;; TUR-E0500 fires because ok?en has copy_kind = CK_UNIQUE.

(defeffect Ask [] :int)

(defn main [] :int
  (let [^unique ok?en 42]
    (handle (perform (Ask))
      (Ask [] ^multishot k)
        (resume k ok?en)))
  0)
