;; unknown-capability-tag-pure-caller -- the report's own repro.
;;
;; `IO` is declared in stdlib/effects.tur, which is not autoloaded and is not
;; loaded here.  Before TUR-E0026 the tag was dropped, `maybe-io` resolved to
;; #fx{}, and `claims-pure`'s #fx{} passed a check it should fail: the
;; annotation meant to BUY the TUR-E0009 check silently removed it.  Now the
;; tag is an error that says where IO lives.  (Load effects.tur and the same
;; program fails with TUR-E0009 instead, as it should.)

(defn maybe-io    [] #fx{IO} : int 0)
(defn claims-pure [] #fx{}   : int (maybe-io))
(defn main        [] : int 0)
