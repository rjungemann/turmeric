;; positional-pap-opaque-mismatch -- binding a :B into a :A slot during partial
;; application is a compile error. The captured arg must satisfy the nominal
;; identity of the parameter it fills, not merely its TypeKind.
(defopaque A :int)
(defopaque B :int)
(defn two [x : A y : A] : int ```c return (int64_t)(x + y); ```)
(defn mk-a [] : A ```c return 1; ```)
(defn mk-b [] : B ```c return 1; ```)
(defn main [] : int
  (let [f (two (mk-b))]
    (f (mk-a))))
