;; poly-result-hof-capturing-closure-sigbus (the effect row): a capturing
;; closure into a thin effect-row'd fn param used to compile clean and crash
;; at run time (the thin convention has nowhere to carry the environment).
;; Now a call-site TUR-E0007 -- pinned here.  The row-variable variant is the
;; same defect (all row kinds ride thin), asserted in the same file.
(defn run [body : (fn [] #fx{Write} int)] #fx{Write} : int (body))
(defn apply1 [f : (fn [int] #fx{|e} int) x : int] #fx{|e} : int (f x))
(defn main [] #fx{Write} : int
  (let [k 7]
    (println (run (fn [] #fx{Write} : int (+ k 1))))
    (println (apply1 (fn [x : int] : int (+ x k)) 10)))
  0)
