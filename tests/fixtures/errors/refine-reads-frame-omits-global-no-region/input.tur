;; The paired negative for refine-reads-frame-omits-global.
;;
;; Byte-for-byte that fixture minus the `(& w)` frozen borrow.  Without a
;; frozen region there is nothing to grant congruence to the impure `alive?`,
;; so the crossing is undecided -- and TUR-W0372 says the quiet part out loud:
;; an impure `#reads` measure has NO runtime fallback, so the outcome at a
;; crossing is a proof or a diagnostic, never a runtime check.  That is what
;; makes the trusted claim in the sibling fixture load-bearing.
;;
;; Keeping both pinned is the point: the positive alone would pass if the
;; override were deleted, and this one alone would pass if it were widened.
(load "stdlib/refine.tur")

(def ^mut fudge 1)

(defstruct World [n : int])

(defn alive? [^borrow w : World e : int] #reads w : bool
  (> fudge 0))

(defn get! [^borrow w : World e : #refine{ x : int | (alive? w x) }] : int
  (.n w))

(defn run [] : int
  (let [^mut w (World 7)]
    (do                              ; NO frozen borrow -- nothing is frozen
      (if (alive? w 0)
        (do
          (set! fudge -1)
          (get! w 0))
        -1))))

(defn main [] : int
  (println (run))
  0)
