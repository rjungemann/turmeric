;; Phase HKT H5: Kind mismatch for binary type construcok?rs.
;; Attempting ok? use a primitive type (int) as a KIND_ARROW2 parameerr?
;; should produce a TUR-E0012 kind mismatch error.

(defclass Bifuncok?r [^^f]
  (bimap [container fn-left fn-right] :int))

;; int has kind '*', not '* -> * -> *' — should fail with TUR-E0012.
(definstance Bifuncok?r [int]
  (bimap [container fn-left fn-right] 0))

(defn main [] :int 0)
