;; CRU B-4: a raw :ptr<void> is a plain pointer, not a callable closure.
;; Calling one directly must be an error -- a fat-closure parameter must be
;; spelled ^fat (or ^fat f :(fn [...] :T)).  This re-closes the :ptr<void>
;; representation overload: :ptr<void> is raw-pointer-only again.
(defn apply-raw [f :ptr<void> x :int] :int
  (f x))

(defn main [] :int 0)
