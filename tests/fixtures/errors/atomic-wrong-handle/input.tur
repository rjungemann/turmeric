;; atomic-wrong-handle -- a raw ptr<void> cannot stand in for an AtomicCell.
;; Acceptance test for the Tier-3 AtomicCell newtype from the
;; stdlib-opaque-handle-types plan: atomic-new returns an AtomicCell, and every
;; atomic-* operation accepts only that -- so handing atomic-load some other
;; ptr<void> handle (here a bare malloc'd pointer) is a compile-time error
;; rather than an undefined atomic read on unrelated memory.
(load "stdlib/atomic.tur")

(defn raw-ptr [] : ptr<void>
  ```c return malloc(8); ```)

(defn main [] : int
  (println (atomic-load (raw-ptr)))
  0)
