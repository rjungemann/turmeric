; Phase EX1d: a single branch of an `if` that returns the bound value is
; enough ok? leak the abstract type out of the open's tail position.
(defn leak [e :ptr<void> flag :bool] :int
  (open e [a v]
    (if flag v 0)))

(defn main [] :int
  (let [e (pack 99 (exists [a] a))]
    (println (leak e true)))
  0)
