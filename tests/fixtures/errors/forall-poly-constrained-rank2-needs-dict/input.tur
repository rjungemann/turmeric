;; MB1 (constrained-hkt-forall-mode-b-plan) soundness gate: a genuinely
;; polymorphic constrained function whose body dispatches a class method on its
;; own type variable cannot be passed as a rank-2 value yet -- the erased carrier
;; would run a single monomorph (the int representative) for every caller-chosen
;; type, silently miscompiling (e.g. `(f true)` would show-int the bool).  Needs
;; runtime dictionary passing (mode B); rejected with TUR-E0308 until then.
(defclass Show [a] (show [x] : cstr))
(definstance Show [int]  (show [x] : cstr ```c char*b=malloc(24); snprintf(b,24,"i%lld",(long long)x); return b; ```))
(definstance Show [bool] (show [x] : cstr ```c return x ? "T" : "F"; ```))

(defn poly-show [a] [^Show a x : a] : cstr (show x))

(defn use-both [f (forall [a] [(Show a)] (-> a cstr))] : cstr
  (println (f 7))
  (f true))

(defn main [] : int
  (println (use-both poly-show))
  0)
