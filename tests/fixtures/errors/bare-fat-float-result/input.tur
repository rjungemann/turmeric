;; bare-fat-param-non-int-result-miscompiles.md: a bare `^fat g` parameter (no
;; fn-type annotation) erases the closure's result type, so a direct call (g x)
;; yields int64.  Returning that from a :float function read the wrong register
;; (rax vs xmm0) and silently miscompiled.  This is now a hard error directing
;; the user to the annotated form `^fat g :(fn [...] :float)`, which threads the
;; correct result type.
(defn run-with [^fat g x :float] :float (g x))
(defn make-scale [k :float] :ptr<void> (fn [x :float] :float (* x k)))
(defn main [] :int
  (println (run-with (make-scale 2.0) 3.5))
  0)
