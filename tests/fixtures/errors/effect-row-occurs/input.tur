;; GATE: occurs-check failure -- binding e to #{Write e} is infinite.

(defeffect Write [s :cstr] :nil)

(defn run-e [f :(fn [] #fx{e} nil)] #fx{e} : nil
  (f))

(defn write-and-e [] #fx{Write e} : nil
  (perform (Write "x")))

(defn main [] : int
  (handle
    (do (run-e write-and-e) 0)
    (Write [s] k) (resume k nil)))
