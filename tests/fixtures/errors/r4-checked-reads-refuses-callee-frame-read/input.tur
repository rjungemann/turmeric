;; R4 slice 3, CALL-SHAPE evidence: `cross?` declares `#reads w`, and its body
;; reaches g's state through `gen-at`'s own verified `#reads` frame -- a read
;; the defn-site structural scans cannot see, found by the verification pass
;; instead. It refuses the congruence override like any other evidence kind,
;; so the crossing is undischarged: a hard TUR-W0372 under `--strict-refine`,
;; with the fix-the-frame refusal wording.
;;
;; Also pins that the evidence sweep runs BEFORE crossing resolution and
;; stamps every binding the encoder might resolve to.
;;
;; Both halves are asserted here. Before checked-reads graduated (2026-08-20)
;; the W0383 wording lived on a passing twin,
;; refine-reads-callee-frame-omits-param, which pinned the gate-off default of
;; proving anyway; graduation made that twin this same program with the
;; opposite expectation, so its assertions were folded in here.
(defstruct Wld [gens : ptr<void>])
(defn wld-new [] : Wld
  (unsafe (let [p (raw-malloc 32)]
            (array-set-unchecked p 0 0)
            (Wld p))))
(defn gen-at [^borrow w : Wld i : int] #reads w : int
  (unsafe (array-get-unchecked (.gens w) i)))
(defn cross? [^borrow w : Wld ^borrow g : Wld i : int] #reads w : bool
  (= (gen-at g i) 0))
(defn get-it [^borrow w : Wld ^borrow g : Wld
              e : #refine{ x : int | (cross? w g x) }] : int
  (+ e 100))
(defn run [] : int
  (let [^mut w (wld-new)
        ^mut g (wld-new)]
    (let [__f1 (& w)
          __f2 (& g)]
      (if (cross? w g 0)
        (get-it w g 0)
        -1))))
(defn main [] : int
  (println (run))
  0)
