;; reflected-measures RF6: a BOOL measure at a ground argument that is false
;; is refuted, not left unknown.  all-pos?(Cons 1 (Cons -2 Nil)) unfolds to
;; (1 > 0 and all-pos?(Cons -2 Nil)), then (-2 > 0 and ...), and the model
;; search evaluates the chain -- reading each application off its iff -- to
;; false, so the crossing is TUR-E0371 for the value given, with no runtime
;; check needed to find out.  Not under --strict-refine: E0371 is an error
;; on its own, which is the point.
(defdata Lst [] (Cons [hd : int tl : Lst]) (Nil))

(defn ^reflect all-pos? [xs : Lst] : bool
  (match xs
    (Nil) true
    (Cons h t) (and (> h 0) (all-pos? t))))

(defn positives [xs : #refine{ v : Lst | (all-pos? v) }] : int 1)

(defn main [] : int
  (println (positives (Cons 1 (Cons -2 (Nil)))))
  0)
