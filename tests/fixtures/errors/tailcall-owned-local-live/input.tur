;; proper-tail-calls T1 (T-D1) / T4 (T-D3): an owned local's drop glue can move
;; ahead of a backedge only when the local is DEAD at the call -- every use of
;; it copies a plain number out.  Here the `rc<int>` is passed, bare, to `cnt`
;; in the recursive call's own argument, so the drop cannot run before the
;; call without the argument reading a freed block.  Passing, capturing in a
;; closure, and borrowing all keep the local live, and the annotation says so.
;;
;; Until T4 this fixture held a DEAD `ref<T>` (the plan's section 2.2 probe),
;; which T4 now lowers to a backedge; that program moved to the positive
;; `tailcall-drop-glue-annot`.

(defn cnt [r : rc<int>] : int
  (rc/strong-count r))

(defn walk [n : int acc : int] : int
  (let [x (rc/of n)]
    (if (= n 0)
      acc
      ^tailcall (walk (- n 1) (+ acc (cnt x))))))

(defn main [] : int
  (println (walk 3 0))
  0)
