;; Regression for gap H item 2: declaring a typeclass method with a
;; typed parameter `[w : W]` used to SEGV in elab_method_call when
;; the instance body referenced a struct field via `.field-name`.
;; The receiver's type was produced as TY_STRUCT with a NULL `def`
;; pointer, and the field-access fast path dereferenced
;; `def->n_fields` without a null check.
;;
;; The fix in src/compiler/elab_typeclasses.c bails out of the
;; field-access path when `def` is NULL and lets the typeclass
;; dispatch lookup emit a clean diagnostic. The user-visible result
;; for THIS shape is a "no typeclass method found" error instead of
;; a crash -- the underlying typed-method-param feature still doesn't
;; work, but compilation no longer aborts the compiler process.
;;
;; This fixture is a negative test: it should produce an error
;; matching expected.diag (substring match), not a SEGV.
;;
;; Filed under
;; docs/reported/typeclass-constrained-defn-rejected.md (gap H).

(defclass HasPos [W] (pos-of [w : W] : int))

(defstruct GameWorld [pos-store : int])

(definstance HasPos [GameWorld]
  (pos-of [w] (.pos-store w)))

(defn main [] : int 0)
