;; poly-defn-shares-inner-closure-body-across-monomorphizations
;; A generic defn that returns an (fn ...) whose result type is the type
;; parameter A emits ONE shared inner closure body (integer thunk ABI). A
;; floating-point specialization would dispatch that body through a
;; double-returning function pointer -- a silent register-class miscompile.
;; The compiler must reject the float specialization (TUR-E0705) rather than
;; emit garbage. The :int specialization below is fine and is intentionally
;; left in to show only the float call is rejected.

(defn constant [A] [val :A] : ptr<void>
  (fn [t : float] : A val))

(defn call-float [^fat f :(fn [:float] #{} :float) t : float] : float (f t))
(defn call-int   [^fat f :(fn [:float] #{} :int)   t : float] : int   (f t))

(defn main [] : int
  (let [k440  (constant 440.0)
        kflag (constant 1)]
    (println (call-float k440  0.0))
    (println (call-int   kflag 0.0)))
  0)
