;; TUR-E0706: the receiver performs Ask and does not handle it.  It runs once,
;; at capture, from the shift body -- through its direct entry, outside the
;; handler around `run` -- so the effect has nowhere to go.  A receiver that
;; handles its own effects is accepted (serial-shift-colored-receiver).
(load "stdlib/serial.tur")
(defeffect Ask [] :int)
(defn page [env : cstr hole : int] : int (+ hole 1))
(defn asks [] : int (+ (perform (Ask)) 1))
(defn recv-e [k : serial-cont] : int (k (asks)))
(defn run [] : int
  (serial-reset (page "" (serial-shift recv-e 0))))
(defn main [] : int
  (println (handle (run) (Ask [] r) (resume r 41)))
  0)
