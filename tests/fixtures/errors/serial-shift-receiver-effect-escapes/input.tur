;; TUR-E0706: a serial-shift receiver whose effect escapes it, under an `if`.
;;
;; An escaping effect is lowered by calling the receiver as a colored callee
;; on the reset's own continuation (serial-shift-receiver-effect-reaches-
;; handler).  That needs the context to be a straight frame list: with an `if`
;; branch point the reset's continuation would have to be threaded through both
;; arms, which the native serial lowering does not do, so this shape is still
;; refused -- the receiver would run from the shift body's fresh root, outside
;; the handler around `run`.  `tur --interpret` runs it (43).  Hoisting the
;; `if` out of the serial-reset, or handling the effect inside the receiver,
;; avoids it.

(load "stdlib/serial.tur")
(defeffect Ask [] :int)
(defn page [env : cstr hole : int] : int (+ hole 1))
(defn asks [] : int (+ (perform (Ask)) 1))
(defn recv-e [k : serial-cont] : int (k (asks)))
(defn run [c : bool] : int
  (serial-reset (if c (page "" (serial-shift recv-e 0)) 5)))
(defn main [] : int
  (println (handle (run true) (Ask [] r) (resume r 41)))
  0)
