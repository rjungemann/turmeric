#lang r7rs
;; docs/reported/r7rs-turmeric-syntax-leaks.md item 7: a Turmeric special form
;; is not Scheme.  In a Scheme source its name is an ordinary identifier, and
;; one the program does not bind heads a form written as Turmeric: refused,
;; with where Turmeric code goes.  (At the REPL the message says to switch the
;; prompt with `#lang turmeric` instead.)  A program's own `match`, below, is
;; an ordinary procedure and is not refused.
(import (scheme base) (scheme write))
(define (match x) (* x 3))
(write (match 4))
(defn twice [x : int] : int (* x 2))
