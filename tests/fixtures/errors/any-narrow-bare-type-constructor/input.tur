;; any-narrowing-broken-for-parametric-receivers: a BARE type constructor as an
;; `is?` / `cast` target names no single runtime type -- an `any` holds one
;; instantiation, and `Option` does not say which.  It used to resolve to the
;; head ADT and test against an id nothing ever boxes, so this was silently
;; false (and the `cast` twin panicked "any holds Option, not Option").
;; Now it is a diagnostic that names the arity and shows the applied form.
(defn boxed [] : any (Some 7.1))

(defn main [] : int
  (println (if (is? (boxed) Option) 1 0))
  0)
