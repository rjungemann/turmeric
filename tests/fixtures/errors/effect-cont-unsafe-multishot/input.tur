;; MS4: ^unsafe-multishot has been removed. The annotation is no longer parsed,
;; so a handler clause using it is now a hard error -- use ^multishot instead.

(defeffect Choose [] :int)

(defn main [] :int
  (let [sum
    (handle (+ (perform (Choose)) (perform (Choose)))
      (Choose [] ^unsafe-multishot k)
        (+ (resume k 10) (resume k 20)))]
    (println sum))
  0)
