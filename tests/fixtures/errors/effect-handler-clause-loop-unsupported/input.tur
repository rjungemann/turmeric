;; A `while` inside a `handle` clause is still outside the CPS backend's
;; admissible subset: the loop lowers to CT_LOOP, and handle_case_ok has no arm
;; for one inside a lifted handler case.  The enclosing function evicts and its
;; `perform` reaches the direct emitter, which cannot lower an effect operation.
;;
;; What this fixture pins is that the compiler SAYS so, at a source location,
;; with a workaround -- it used to abort() with "internal error: effect form
;; (EX kind 57) reached the direct/fiber emitter", which gave the user nothing.
;;
;; requires.compiled because this is a COMPILED-PATH limitation only: under
;; `tur --interpret` the same program runs and prints 3.  turi evaluates the
;; handler directly and never goes near the CPS admission gate, so asserting a
;; diagnostic there would be asserting something untrue.
;;
;; If someone admits CT_LOOP in a handler case, this fixture SHOULD start
;; failing: delete it and make the program a passing one instead.  See
;; docs/reported/handler-clause-statement-if-ices-emitter.md.
(defeffect Ask [] : int)

(defn main [] : int
  (println (handle (perform (Ask))
                   (Ask [] k) (let [^mut i 0] (while (< i 3) (set! i (+ i 1))) i)))
  0)
