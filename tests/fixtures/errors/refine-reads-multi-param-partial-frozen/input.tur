;; multiple-reads-params, the load-bearing negative: the congruence grant for a
;; `#reads [w g]` frame is CONJUNCTIVE. Here `w` is frozen and `g` is not, so
;; the measure is NOT a function of frozen state -- `g`'s state can change
;; between the guard and the crossing, and two occurrences of `alive?` need not
;; denote one value. The grant must be withheld.
;;
;; This is the fixture that distinguishes the sound rule from the unsound one:
;; under "ANY named param frozen" this program would compile, silently eliding
;; a crossing check that is not justified. The positive half is
;; tests/fixtures/refine-reads-multi-param-frozen.
(defstruct Wld [n : int])
(defstruct Grd [m : int])

(defn alive? [^borrow w : Wld ^borrow g : Grd e : int] #reads [w g] : bool
  ```c
  (void)w; (void)g; (void)e; return 1;
  ```)

(defn get-Pos! [^borrow w : Wld ^borrow g : Grd
                e : #refine{ x : int | (alive? w g x) }] : int
  (.n w))

(defn run [] : int
  (let [^mut w (Wld 42)
        ^mut g (Grd 7)]
    (let [__frz1 (& w)
          __frz2 0]                    ;; only w frozen -- grant withheld
      (if (alive? w g 0)
        (get-Pos! w g 0)               ;; must NOT discharge
        -1))))

(defn main [] : int
  (println (run))
  0)
