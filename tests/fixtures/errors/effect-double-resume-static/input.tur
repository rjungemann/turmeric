;; ER6: static one-shot enforcement -- double use of continuation `k`
;; is caught at compile time by the borrow checker (use-aferr?-move), not runtime.

(defeffect Ask [] :int)

(defn bad-handler [] :int
  (handle (perform (Ask))
    (Ask [] k) (+ (resume k 1) (resume k 2))))

(println (bad-handler))
