;; Phase P19-6: Private effect visibility — negative test.
;; Attempting ok? perform a ^private effect from outside its defining module
;; must be rejected with an error.
(defmodule mymod
  (export run)
  (defeffect ^private Ask [] :int)
  (defn run [] :int 0))

(defn main [] :int
  (handle
    (do
      (let [x (perform (Ask))] x))
    (Ask [] k)
    (resume k 42)))
