;; proper-tail-calls T1 (T-D1) / 2.3: `match` is the idiomatic way to write a
;; loop over an ADT, and it is NOT in tco_mark's tail grammar -- the recursive
;; call gets an ordinary C frame.  Before `^tailcall` that was silent; the
;; annotation is what turns it into a compile-time conversation.
;;
;; When T3 lands (EX_MATCH in the tail grammar) this fixture moves to the
;; positive side.

(defdata Step (More [v : int]) (Done))

(defn classify [n : int] : Step
  (if (= n 0) (Done) (More (- n 1))))

(defn loop-match [n : int] : int
  (match (classify n)
    (Done)   0
    (More v) ^tailcall (loop-match v)))

(defn main [] : int
  (println (loop-match 10))
  0)
