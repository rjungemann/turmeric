;; `define` in an expression position -- an `if` condition -- binds a name no
;; later form can see.  Kept inside a function body because that is where this
;; exact wording applies; the file-scope spelling of the same mistake gets its
;; own message and is pinned by errors/toplevel-def-in-expr-position (see
;; docs/archive/turi-toplevel-expr-subforms-elaborate-in-global-scope.md).
(defn main [] : int
  (if (define x 1) x 0))
