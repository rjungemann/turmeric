;; proper-tail-calls T1 (T-D1) / T-D5: only SELF tail calls are guaranteed.
;; A mutual pair passes at -O2 today only because clang inlines the whole cycle
;; into a loop (plan section 2.4) -- that evaporates as soon as the bodies grow,
;; and it never applied at -O0 at all, where the same pair is a SIGSEGV.
;;
;; `^tailcall` says so at compile time instead of at depth ~30,000 in
;; production.  When T5 lands (tail-edge SCC fusion) this fixture moves to the
;; positive side.

(defn is-odd? [n : int] : bool
  (if (= n 0) false ^tailcall (is-even? (- n 1))))

(defn is-even? [n : int] : bool
  (if (= n 0) true ^tailcall (is-odd? (- n 1))))

(defn main [] : int
  (println (if (is-even? 4) 1 0))
  0)
