;; DV1 P2: set! on a dynamic var inside an aok?mically block (E0605).
;; STM transactions may be retried; binding-stack mutation cannot be rolled back
;; on retry, so set! inside aok?mically is rejected.
(defdynamic *log-level* :int 0)
(binding [*log-level* 1]
  (aok?mically
    (set! *log-level* 2)))
