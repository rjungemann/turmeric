;; forall-dict-pass-nested-lambda-dispatch-plan (residual guard): a nested van
;; Laarhoven mapper that dispatches a SINGLE constraint method is lowered (see
;; the positive fixture van-laarhoven-lens-show-mapper), but a mapper that
;; dispatches MORE THAN ONE class from inside the lambda is not yet lowerable --
;; the captureless-mapper-to-closure conversion carries exactly one env dict.
;; It is rejected with TUR-E0311 rather than miscompiled.  Dispatching directly
;; in the body (bind each method in a `let`) is always supported.
(defopaque Identity [a] :int)
(defn mk-id [A] [x : A] : (Identity A) ```c return (int64_t)x; ```)
(defn run-id [A] [i : (Identity A)] : A ```c return (int64_t)i; ```)
(definstance Functor [Identity]
  (fmap [i g] (mk-id (g (run-id i)))))

(defclass Show [a] (show [x] : cstr))
(definstance Show [int] (show [x] : cstr ```c return "i"; ```))
(defclass Ord [a] (rank [x] : int))
(definstance Ord [int] (rank [x] : int ```c return (int)x; ```))

(defn tag2 [s : cstr r : int] : cstr ```c return s; ```)

;; The mapper dispatches BOTH Show and Ord -- two classes in one nested lambda.
(defn two-lens [^f a] [^Functor f ^Show a ^Ord a g : (-> a (f a)) s : a] : (f cstr)
  (fmap (g s) (fn [x : a] : cstr (tag2 (show x) (rank x)))))

(defn use-two
    [l (forall [(f :: * -> *) a] [(Functor f) (Show a) (Ord a)] (-> (-> a (f a)) a (f cstr)))
     s : int] : cstr
  (run-id (l (fn [x : int] : (Identity int) (mk-id x)) s)))

(defn main [] : int
  (println (use-two two-lens 7))
  0)
