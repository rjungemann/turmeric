; Phase SZ4: sized syntax is rejected when neither -Xsized-types nor -Xgadt is
; enabled. With no `flags` file, this fixture builds with the default flags
; (no GADT support), so the Size GADT declaration must be rejected.

(defgadt Size []
  (Static (int) : (Size))
  (Add (Size) (Size) : (Size))
  (Mul (Size) (Size) : (Size)))

(defn main [] :int
  0)
