;; CF3 (control-flow-completeness-plan): compose-handlers is gated.
;;
;; These two handler values are well-typed and handle DIFFERENT effects (no
;; TUR-E0251 overlap), so the only remaining error is the CF3 gate: first-class
;; handler composition has no runtime representation yet (handler values cannot
;; be created or applied), so it is rejected with TUR-E0704 instead of silently
;; elaborating to nil.  Use nested (handle ...) forms to compose effects today.
(defeffect Log [s :cstr] :nil)
(defeffect Counter [] :int)

(defn compose2 [h1 :(handler Log cstr nil) h2 :(handler Counter int int)] :nil
  (compose-handlers h1 h2))

(defn main [] :int 0)
