;; Phase D0: Ambiguous dispatch -- two Functor instances, erased receiver.
;; When mk returns :int (erased type), calling .fmap on the result must
;; emit TUR_E0020_AMBIGUOUS_DISPATCH rather than silently picking the
;; first registered instance.

(defclass Functor [^f]
  (fmap [container fn] : int))

;; Option helpers
(defn __opt_some [x] : int
  ```c
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn __fmap_option [container fn] : int
  ```c
  struct { bool is_some; int64_t value; } *c =
      (void *)(intptr_t)container;
  if (!c || !c->is_some) return container;
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = ((int64_t(*)(int64_t))fn)(c->value);
  return (int64_t)(intptr_t)r;
  ```)

;; Vec helpers
(defn __vec_new [] : int
  ```c
  int64_t **v = malloc(sizeof(int64_t *) + sizeof(int64_t));
  int64_t *len = (int64_t *)(v + 1);
  *len = 0;
  *v = len;
  return (int64_t)(intptr_t)v;
  ```)

(defn __fmap_vec [container fn] : int
  ```c
  return container;
  ```)

(definstance Functor [option]
  (fmap [c f] (__fmap_option c f)))

(definstance Functor [vec]
  (fmap [c f] (__fmap_vec c f)))

;; mk returns :int (type erased) even though it produces an option value.
(defn mk [] : int (__opt_some 42))

(defn main [] : int
  (let [obj (mk)]
    (.fmap obj (fn [x] (* x 2)))
    0))
