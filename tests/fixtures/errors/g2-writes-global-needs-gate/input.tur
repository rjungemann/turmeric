;; Without --enable=global-state the frame grammar is unchanged: a
;; non-parameter name is the same hard error it was before G2.  The experiment
;; gates the GRAMMAR here, not just the checking, because accepting the name
;; and ignoring it would be a silently-dropped frame member -- the thing
;; TUR-E0381 exists to prevent.
(def ^mut hits 0)

(defn bump! [] #writes [hits] : void
  (set! hits (+ hits 1)))

(defn main [] : int 0)
