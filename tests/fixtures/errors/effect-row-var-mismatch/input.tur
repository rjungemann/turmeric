;; ER2: a caller declares #{} but calls run-twice with a closure that performs Write.
;; The inferred row of pure-caller becomes #{Write} which violates its #{} declaration.

(defeffect Write [msg :cstr] :nil)

(defn run-twice [f :(fn [] #{e} int)] #{e} : int
  (+ (f) (f)))

(defn pure-caller [] #{} : int
  (run-twice (fn [] (do (perform (Write "hi")) 1))))

(defn main [] : int
  (handle
    (println (pure-caller))
    (Write [msg] k) (do (println msg) (resume k 0)))
  0)
