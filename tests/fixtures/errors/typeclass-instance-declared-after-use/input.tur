;; typeclass-method-resolution-ignores-the-class (symptom A).
;; Dispatch resolves by walking REGISTERED instances, which are registered in
;; source order -- so an instance declared below a constrained generic is not
;; visible to it. That is still an error, but it must say so: the old text
;; ("no typeclass method found") denied the existence of a method declared in
;; the defclass three lines above, and never hinted at the fix.
(defstruct Bar [v : int])

(defclass Foo [W]
  (foo-of [^borrow w] : int))

(defn use-foo [W] [(Foo W)] [^borrow w : W] : int
  (foo-of w))

;; Declared AFTER the use above -- moving it up is the fix.
(definstance Foo [Bar]
  (foo-of [w] (.v w)))

(defn main [] : int
  (let [b (make-struct Bar 111)]
    (println (use-foo b))
    0))
