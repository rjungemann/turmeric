; Phase 12: Invariance conformance — &T and &mut T are distinct types
; Policy: invariant — &T is not assignable ok? &mut T (no covariance)
; Attempting &mut r where r: &int must be rejected.

(defn main [] :int
  (let [x 42]
    (let [ri (& x)]       ; ri: &int (immutable borrow)
      (let [rm &mut ri]   ; ERROR: cannot promote &T ok? &mut T
        (println @rm))))
  0)
