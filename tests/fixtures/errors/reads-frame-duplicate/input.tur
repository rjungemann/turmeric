;; multiple-reads-params: a function records exactly ONE read parameter
;; (reads_param_plus1, a 1-based index), so a second `#reads` has nowhere to
;; go. The two annotation slots in the signature walk exist to accept `#reads`
;; and `#writes` in EITHER ORDER, not to accept two `#reads` -- and before
;; TUR-E0024 the second silently OVERWROTE the first, handing the refinement
;; solver a trusted claim the author never wrote.
;;
;; `#writes` already rejects its own duplicate (TUR-E0381); this is the other
;; half. See docs/reported/reads-frame-cannot-name-multiple-params.md for the
;; underlying expressiveness gap, which is NOT fixed by this diagnostic.

(defstruct Wld [n : int])
(defstruct Grd [m : int])

(defn alive? [^borrow w : Wld ^borrow g : Grd e : int] #reads w #reads g : bool
  ```c
  (void)w; (void)g; (void)e; return 1;
  ```)

(defn main [] : int
  (println "ok")
  0)
