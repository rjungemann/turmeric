;; loop-invariants-plan LI3 sabotage fixture: the havoc is load-bearing.
;; After the loop, `i = 0` (from the `let`) describes a value the loop has
;; replaced.  Stepping over the loop renames every pre-loop fact about `i` to a
;; fresh name, so only `p AND (not c)` -- `i >= 0 AND i >= n` -- speaks of the
;; returned `i`, and `r = 0` does not follow.  Strip the rename
;; (li_prove_paths_ext) and `stale` proves, its return check is elided, and
;; `(stale 3)` returns 3 against a `(= r 0)` refinement: this fixture then
;; FAILS for want of its diagnostic.  `down-up` is the two-loop variant: the
;; second loop's post-fact, not the first's, must judge the final value.
(defn stale [n : int] : #refine{ r : int | (= r 0) }
  (let [^mut i 0]
    (while (< i n) :invariant (>= i 0) (set! i (+ i 1)))
    i))

(defn down-up [n : #refine{ v : int | (>= v 1) }] : #refine{ r : int | (>= r 1) }
  (let [^mut i 0]
    (while (< i n) :invariant (>= i 0) (set! i (+ i 1)))
    (while (> i 0) :invariant (>= i 0) (set! i (- i 1)))
    i))

(defn main [] : int 0)
