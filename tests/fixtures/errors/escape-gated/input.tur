;; CF4 (control-flow-completeness-plan): escape is gated.
;;
;; Without -Xcallcc, (escape f) is a hard error: the v1 desugar hands `f` the
;; integer 0 as a fake escape procedure (no real early-exit, unsound).
(defn test-escape [] :int
  (escape (fn [exit] 5)))

(defn main [] :int
  (println (test-escape))
  0)
