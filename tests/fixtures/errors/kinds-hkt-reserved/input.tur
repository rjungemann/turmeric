;; Phase HKT H3: once Functor (or any other HKT typeclass) has been defined,
;; attempting to redefine it should produce a clear "already defined" diagnostic.
;; Defining Functor the first time succeeds; redefining it immediately fails.
(defclass Functor [^f]
  (fmap [container fn] : int))
;; This second definition must fail.
(defclass Functor [a]
  (map [x fn] : int))
