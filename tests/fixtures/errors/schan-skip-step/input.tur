;; Negative: skipping a protocol step is a compile-time phantom mismatch.
;;
;; The channel runs SSend int (SRecv int SClose).  After the send it is at
;; protocol SRecv int SClose -- a recv is required before the close.  Calling
;; schan-close directly skips the recv step, so the phantom on the channel
;; (SRecv int SClose) does not match schan-close's expected SClose.  The type
;; checker rejects it with TUR-E0001.

(defmodule app
  (import schan :refer [SChan SSend SRecv SClose
                        schan-new schan-send schan-recv schan-close])
  (defn main [] : int
    (let [c0 (:: (schan-new 2) (SChan (SSend int (SRecv int SClose))))
          c1 (schan-send c0 7)]
      ;; ERROR: c1 : SChan<SRecv int SClose>, but schan-close wants SChan<SClose>.
      (schan-close c1)
      0)))
