;; Intra-file rule: defmodule must still be the first form of
;; the file containing it. A defn above defmodule in the SAME
;; file is still an error even under the per-file scoping fix.

(defn before-tag [] :nil
  ```c printf("before\n"); ```)

(defmodule mod
  (export inside-tag)
  (defn inside-tag [] :nil
    ```c printf("inside\n"); ```))

(defn main [] :int
  (before-tag)
  (inside-tag)
  0)
