;; Phase P19-A/F: Private effect blocked across module boundary.
;; Module effects/ask declares Ask as ^private.
;; Module myapp attempts ok? handle Ask from outside — must be rejected.
(defmodule myapp
  (export run)
  (import effects/ask :as ea)
  (defn run [] :int
    (handle
      (ea/ask-effect)
      (Ask [] k)
      (resume k 99)))
  (defn main [] :int
    (println (run))
    0))
