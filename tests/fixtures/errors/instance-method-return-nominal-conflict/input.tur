;; instance-method-return-nominal-conflict -- an instance method body whose
;; actual type is a DIFFERENT concrete nominal type than the method's declared
;; return is rejected, the same as the ordinary defn case.
;; See docs/archive/history/instance-method-return-not-unified.md.
(defstruct Pt    [x : int y : int])
(defstruct Other [a : int])
(defclass Mk [W] (mk [^borrow w] : Other))
(defopaque H :int)
(definstance Mk [H] (mk [w] (make-struct Pt 1 2)))
(defn main [] : int 0)
