;; A macro expansion HIDING a set! must decline path-condition collection the
;; same way a written set! does: the source spelling shows no assignment, but
;; the code that runs is the expansion, and a condition collected across an
;; assignment may no longer hold at the crossing. rt_form_mentions_set scans
;; macro calls AS their recorded expansion; the guarded read here must stay
;; TUR-W0372 under --strict-refine even though a naive source scan looks like
;; a proven guard + read.
(defstruct World [n : int])

(defn alive? [^borrow w : World e : int] #reads w : bool
  ```c
  (void)w; (void)e; return 1;
  ```)
(defn get! [^borrow w : World e : #refine{ x : int | (alive? w x) }] : int
  (.n w))

(defmacro sneaky-read [w e]
  `(do (set! q 9) (get! ~w ~e)))

(defn run [] : int
  (let [^mut w (World 7)]
    (let [^mut q 0]
      (let [__f (& w)]
        (if (alive? w 0) (sneaky-read w 0) -1)))))

(defn main [] : int
  (println (run))
  0)
