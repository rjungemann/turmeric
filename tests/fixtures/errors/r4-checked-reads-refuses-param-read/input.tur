;; R4 slice 1: the refine-reads-frame-omits-param program under
;; `--enable=checked-reads --strict-refine`. The same omitted-parameter
;; evidence that draws TUR-W0383 by default now REFUSES the congruence
;; override, so the crossing that proves gate-off becomes an undischarged
;; TUR-W0372 -- with the refusal wording that points at the frame, not the
;; region. The sibling r2-checked-reads-refuses-broken-frame pins the same
;; escalation for the mutable-global evidence kind.
(defstruct Wld [gens : ptr<void>])
(defstruct Grd [gens : ptr<void>])

(defn wld-new [] : Wld
  (unsafe (let [p (raw-malloc 32)]
            (array-set-unchecked p 0 0)   ;; init slot 0 -- turi runs this too
            (Wld p))))
(defn grd-new [] : Grd
  (unsafe (let [p (raw-malloc 32)]
            (array-set-unchecked p 0 0)
            (Grd p))))

(defn linked? [^borrow w : Wld ^borrow g : Grd e : int] #reads w : bool
  (= (unsafe (+ (array-get-unchecked (.gens w) e)
                (array-get-unchecked (.gens g) e)))
     0))

(defn get-it [^borrow w : Wld ^borrow g : Grd
              e : #refine{ x : int | (linked? w g x) }] : int
  (+ e 100))

(defn run [] : int
  (let [^mut w (wld-new)
        ^mut g (grd-new)]
    (let [__f1 (& w)
          __f2 (& g)]
      (if (linked? w g 0)
        (get-it w g 0)
        -1))))

(defn main [] : int
  (println (run))
  0)
