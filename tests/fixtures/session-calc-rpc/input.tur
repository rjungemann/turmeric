;; SS4: session-calc-rpc -- calculator RPC integration test.
;;
;; A server receives an integer and sends back double the value.
;; The client sends 21 and expects to receive 42.
;;
;; Protocol (server view): Recv int (Send int Close)
;; Protocol (client view): Send int (Recv int Close)
;;
;; Expected output: 42

;; double-server: receive an int, send back its double, close.

(load "stdlib/session.tur")

(defn double-server [^linear ch :(Session (Recv int (Send int Close)))] : nil
  (let [[n ch] (recv ch)]
    (let [ch (send ch (* n 2))]
      (close ch))))

;; calc-rpc: send req, recv response, close channel, return response.
;; (Named apart from stdlib/session.tur's rpc-call, which the load above brings in.)
(defn calc-rpc [^linear ch :(Session (Send int (Recv int Close))) req : int] : int
  (let [ch (send ch req)]
    (let [[resp ch] (recv ch)]
      (close ch)
      resp)))

(defn main [] : int
  (let [[s r] (make-session (Send int (Recv int Close)))]
    (let [t (session-spawn (fn [] (double-server r)))]
      (let [result (calc-rpc s 21)]
        (println result)
        (session-join t))))
  0)
