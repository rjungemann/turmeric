;; SC7 enabler: a phantom struct type parameter (one that appears in no field)
;; is inferred from the ascribed type via the return-type-directed expected-type
;; channel, so (:: (make-struct PhantomSchema 7) (PhantomSchema cstr)) type-checks.
(defstruct PhantomSchema [A] (raw :int))
(defn main [] : int
  (let [s (:: (make-struct PhantomSchema 7) (PhantomSchema cstr))]
    (println (.raw s)))
  0)
