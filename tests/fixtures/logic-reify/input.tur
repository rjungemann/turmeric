;; Phase B4: Logic programming -- nested fresh and reify.
;; Two fresh vars x(id=0), y(id=1): conjoin (x=10),(y=20); walk both to confirm.
;; Uses the pure-Turmeric stdlib/logic.tur engine (no inline-C).

(load "stdlib/logic.tur")

;; inner-goal: conjoin (x=10) and (y=20)
(defn inner-goal [x : Term y : Term] : (Goal int)
  (conjoined (lequal x (term-int 10)) (lequal y (term-int 20))))

(defn main [] : int
  (let [goal    (fresh (fn [x] (fresh (fn [y] (inner-goal x y)))))
        results (run-logic 1 goal)
        subs    (first-state results)]
    (println (bt-length results))
    (println (term-int-val (logic-walk (term-var 0) subs)))
    (println (term-int-val (logic-walk (term-var 1) subs)))
    0))
