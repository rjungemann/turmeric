#lang r7rs
;; r7rs-lang-plan T0: one R7RS number parser (src/compiler/r7rs_numsyntax.inc)
;; behind the source reader, `read` and `string->number`, on both back ends.
;; A ratio or complex number is ONE token.  When its value is one the tower
;; holds, it reads as that value; when not, it is refused with the reason (a
;; source literal at compile time, `read` and `string->number` with an error
;; a program can `guard`) -- never split into a number and a stray symbol,
;; and never read as a different number.
(import (scheme base) (scheme write) (scheme read))
(define (show x) (write x) (newline))
(define (try thunk) (guard (e (#t (list 'error (error-object-message e)))) (thunk)))

;; Source literals the tower holds: an integral ratio, an inexact ratio, an
;; exact zero imaginary part, a zero polar angle, and the prefixes.
(show (list 10/2 -0/10 #x10/2 #i3/2 #i#x1/10 3+0i -2.5+0i 1@0 #e1.0 7.25 -7.25 +5 .5))

;; string->number agrees, and #f is still "not a number".
(show (map string->number '("10/2" "#i3/2" "1e2" "1S2" "+inf.0" "#x1F" "7.25" "abc" "1 2" "-" "1/2/3")))

;; What the tower cannot hold yet is an error naming the task, from both
;; string->number and read.
(show (try (lambda () (string->number "1/2"))))
(show (try (lambda () (string->number "3+4i"))))
(show (try (lambda () (string->number "99999999999999999999"))))
(show (try (lambda () (read (open-input-string "(a -1/2)")))))
(show (try (lambda () (read (open-input-string "+i")))))

;; read takes the same tokens whole; a symbol that reads as a number is
;; written with bars.
(show (read (open-input-string "(10/2 #i1/4 |1/2| a/b -> ... + -)")))
(show (list '|1/2| '|+i| '|3+4i| 'a/b))
