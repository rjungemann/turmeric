;; constrained-instance-element-dispatch -- a constrained parametric instance
;; body must dispatch a class method on its ELEMENT type, not on the int64
;; carrier representative.
;;
;; Root cause (docs/archive/constrained-instance-element-dispatch.md): in the
;; body of `(definstance Enc [Option] [(Enc A)] ...)` the inner call
;; `(enc (unwrap x))` has its receiver `(unwrap x)` erased to the int64 carrier
;; at elaboration (its declared type is the struct type-param `A`, summarized as
;; the carrier `int`).  The emit-side method re-resolver
;; (emit_core.c:emit_reresolve_method_call) only re-dispatched when the receiver
;; expr was a bare TY_TYVAR, so an element extracted via `(.field x)` always
;; baked in `__inst_Enc_enc_int` -- correct for `(Option int)` but a silent
;; miscompile for cstr / float / struct elements (a raw pointer was emitted
;; instead of the encoded value).
;;
;; Fix: when the receiver is a field extraction from a parametric container,
;; recover the concrete element type from the current spec's arg types and
;; re-dispatch on it.  The companion value-struct field deref in emit_expr.c
;; now consults the spec arg type the same way, so struct elements lower with
;; the right ABI too.

(defclass Enc [a] (enc [x] : cstr))

(definstance Enc [int]
  (enc [x] : cstr
    ```c
    char *buf = (char *)malloc(32);
    snprintf(buf, 32, "%lld", (long long)x);
    return buf;
    ```))

(definstance Enc [float]
  (enc [x] : cstr
    ```c
    char *buf = (char *)malloc(32);
    snprintf(buf, 32, "%g", x);
    return buf;
    ```))

(definstance Enc [cstr]
  (enc [x] : cstr
    ```c
    size_t n = strlen((const char *)x) + 3;
    char *buf = (char *)malloc(n);
    snprintf(buf, n, "\"%s\"", (const char *)x);
    return buf;
    ```))

(defstruct Box [n : int])

(definstance Enc [Box]
  (enc [b : Box] : cstr (enc (.n b))))

(definstance Enc [Option]
  [(Enc A)]
  (enc [x] : cstr
    (if (some? x)
      (enc (unwrap x))
      "null")))

(defn main [] : int
  (println (enc (some 42)))
  (println (enc (some 3.25)))
  (println (enc (some "hi")))
  (println (enc (some (make-struct Box :n 99))))
  0)
