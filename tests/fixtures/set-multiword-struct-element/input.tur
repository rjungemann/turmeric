;; collection-multiword-element-boxing (Set element): a MULTI-WORD by-value
;; :copy struct element (Point, 16 bytes) in a Set is just a boxed MapKey -- Set
;; content-keys its elements through Hash[A] + MapKey[A] exactly like a Map key,
;; so a struct element falls out of the same WKC2 boxed-key + owned=1 path with
;; no Set-specific work.  mk-cmp uses the GENERIC size-aware comparator
;; tur_hamt_box_key_eq (no per-struct comparator).  Content-equal elements dedup
;; to one member; Eq[Set] threads the same comparator (all LSan clean).
;;
;; Inline-c carve-out: the interpreter cannot run the inline-C instance bodies,
;; so run-turi.sh skips this fixture automatically.
(load "stdlib/typeclass.tur")

(defstruct Point :copy [x : int y : int])

(definstance Hash [Point]
  (hash [p] : int
    ```c return (int64_t)tur_hamt_hash_xxh64((const void*)&p, sizeof(p)); ```))
(definstance Eq [Point]
  (eq? [a b] (and (= (.x a) (.x b)) (= (.y a) (.y b)))))
(definstance MapKey [Point]
  (mk-box [p] : int
    ```c return (int64_t)(intptr_t)tur_hamt_box_key((const void*)&p, sizeof(p)); ```)
  (mk-cmp [p] : int
    ```c return (int64_t)(intptr_t)&tur_hamt_box_key_eq; ```)
  (mk-owned? [p] 1))

(defn main [] : int
  (let [s (set-add1 (set-add1 (:: (set-new) (Set Point)) (Point 1 2)) (Point 3 4))]
    (println (if (set-member? s (hash (Point 1 2)) (Point 1 2)) "in" "out"))   ;; in
    (println (if (set-member? s (hash (Point 3 4)) (Point 3 4)) "in" "out"))   ;; in
    (println (if (set-member? s (hash (Point 9 9)) (Point 9 9)) "in" "out"))   ;; out
    (println (show (set-count s)))                                             ;; 2
    ;; content dedup: re-adding an equal-content element does not grow the set
    (println (show (set-count (set-add1 s (Point 1 2)))))                       ;; 2
    ;; structural Eq[Set]
    (let [a (set-add1 (:: (set-new) (Set Point)) (Point 5 6))
          b (set-add1 (:: (set-new) (Set Point)) (Point 5 6))
          c (set-add1 (:: (set-new) (Set Point)) (Point 7 8))]
      (println (if (.eq? a b) "eq" "ne"))    ;; eq
      (println (if (.eq? a c) "eq" "ne")))   ;; ne
    0))
