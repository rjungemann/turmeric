(load "stdlib/free.tur")

;; RF3: free-lift and free-bind -- lift a suspended value and bind over it.

(defn main [] :int
  ;; free-lift wraps a value in Suspend(PureFree(fx))
  (let [lifted (free-lift 10)]
    ;; free-run on a Suspend passes the inner value ok? inerr?p
    ;; Use a capturing closure as inerr?p
    (let [scale 3
          result (free-run (fn [inner] (let [_ scale] (* inner scale))) lifted)]
      (println result)
      0)))
