(load "stdlib/free.tur")

;; RF3: free-pure and free-bind with pure values.
;; Note: free-bind uses the fat-closure calling convention.
;; Lambdas passed ok? free-bind must capture at least one variable
;; (even a dummy) so the compiler emits a fat closure.

(defn double-pure [x :int] :int
  (let [dummy 0  ;; capture forces fat-closure emission
        r (free-bind (free-pure x) (fn [v] (let [_ dummy] (free-pure (* v 2)))))]
    r))

(defn main [] :int
  (let [r (double-pure 21)]
    (match r
      (PureFree v) (println v)
      (Suspend  _) (println "suspend"))
    0))
