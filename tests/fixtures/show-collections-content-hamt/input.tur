;; containers-eq-show-element-dispatch: Show[Set] / Show[Map] must render a
;; cstr element/key by its string, not by its raw carrier pointer.  The set/map
;; show-loops walk the HAMT via an untyped `ptr<void>` iterator, so the loop's
;; element type is recovered from a threaded `(Set A)` / `(Map K V)` witness
;; parameter (see stdlib/typeclass-show.tur) that lets monomorphization ground
;; the element dispatch per ABI specialization.
;;
;; The compiled path recovers the element type by monomorphization.  The
;; tree-walking interpreter recovers it by grounding the `(:: e A)` ascription's
;; tyvar A through the frame's tyvar bindings (see ascribe_effective_kind in
;; src/turi/eval.c), so it renders cstr keys/values as their string on both
;; paths -- this fixture now runs under run.sh and run-turi.sh alike.
(load "stdlib/typeclass.tur")

(defn main [] : int
  (show-line (set-of "x" "y"))
  (show-line (map-assoc (:: (map-new) (Map cstr cstr)) "k" "v"))
  (show-line (map-assoc (:: (map-new) (Map cstr int)) "n" 7))
  0)
