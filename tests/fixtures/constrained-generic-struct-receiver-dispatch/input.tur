;; constrained-generic-struct-receiver-dispatch: a generic helper constrained
;; over a typeclass whose instances are STRUCTS (`(defn draw [^Backend B b : B]
;; (render-to b))`) now dispatches per-monomorphization to each concrete
;; struct-receiver instance.
;;
;; Regression for docs/archive/history/constrained-generic-struct-receiver-by-ptr.md:
;; a struct receiver above the pass-by-pointer threshold is emitted as
;; `__inst_<Class>_<method>_<T>(const T *self, ...)`, but the ABI-specialized
;; clone held the receiver by value, so it passed a `T` to a `const T *` formal
;; -- a hard cc type error. Single-field structs only "worked" by sharing the
;; int64 carrier's by-value ABI. The plot spice's `Backend` typeclass (CanvasBackend
;; / SurfaceBackend / PngBackend) is the real-world shape this models.
(defclass Backend [b]
  (render-to [self : b  x : int] : int))

;; Deliberately different layouts: 5 ints, 1 int, and cstr+int.
(defstruct CanvasBackend [canvas : int  px : int  py : int  pw : int  ph : int])
(defstruct SurfaceBackend [width : int])
(defstruct PngBackend [path : cstr  tag : int])

(definstance Backend [CanvasBackend]
  (render-to [self x] (+ (+ (.canvas self) (.pw self)) x)))
(definstance Backend [SurfaceBackend]
  (render-to [self x] (+ (.width self) x)))
;; PngBackend dispatches THROUGH SurfaceBackend, mirroring the plot spice's
;; render-through-a-fresh-surface instance.
(definstance Backend [PngBackend]
  (render-to [self x] (+ (render-to (make-struct SurfaceBackend 1000) 0)
                         (+ (.tag self) x))))

;; The polymorphic helper the limitation note claimed was out of reach.
(defn draw [^Backend B b : B x : int] : int
  (render-to b x))

(defn main [] : int
  (println (draw (make-struct CanvasBackend 100 0 0 7 0) 1))   ;; 100+7+1 = 108
  (println (draw (make-struct SurfaceBackend 200) 2))          ;; 202
  (println (draw (make-struct PngBackend "x" 50) 3))           ;; 1000+50+3 = 1053
  0)
