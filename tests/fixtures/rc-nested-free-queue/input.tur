(defn main [] : int
  ;; Test 1: Simple nested RC free to validate queue is working
  (let [inner (rc/of 1)]
    (let [outer (rc/clone inner)]
      (println "Before inner drop")
      (rc/drop inner)
      (println "After inner drop")
      (rc/drop outer)
      (println "After outer drop")))
  
  ;; Test 2: Multiple nested levels
  (let [a (rc/of 10)]
    (let [b (rc/clone a)]
      (let [c (rc/clone b)]
        (let [d (rc/clone c)]
          (println "Nested level 4")
          (rc/drop d)
          (rc/drop c)
          (rc/drop b)
          (rc/drop a)))))
  
  (println "All tests passed")
  0)
