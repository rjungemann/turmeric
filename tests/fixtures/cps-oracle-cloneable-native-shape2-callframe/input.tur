;; U3 oracle: native Shape 2 cloneable with a 1-arg CALL-frame context.
;; (cloneable-reset (+ 1 (dbl (cloneable-shift k-id 0)))) -- an arithmetic frame
;; (+ 1 []) wrapping a call frame (dbl []); the call frame applies the top-level
;; int->int fn `dbl` to the resumed value (no captured env), reified as a DK
;; frame alongside the arithmetic one.  Emitted natively.
;; Multi-shot: resume v -> 1 + dbl(v) = 1 + 2v.  clone+resume 5 -> 11, resume 3 -> 7.
;;
(defn k-id [k : int] : int k)
(defn dbl [x : int] : int (* x 2))
(defn make [] : int
  (cloneable-reset (+ 1 (dbl (cloneable-shift k-id 0)))))
(defn main [] : int
  (let [c (make)]
    (println (tur_cloneable_cont_resume (tur_cloneable_cont_clone c) 5))
    (println (tur_cloneable_cont_resume c 3)))
  0)
