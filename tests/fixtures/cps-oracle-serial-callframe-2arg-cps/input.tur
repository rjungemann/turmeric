(load "stdlib/workflow.tur")
;; U7 (cps-backend-unification): native SERIAL 2-arg call frames.
;; A serial-reset context frame `(f other [])` / `(f [] other)` calling a 2-arg
;; (int,int)->int top-level fn: one arg is the hole (the resumed value), the other
;; a captured INT env.  The 1-arg call frame carried no env (passed 0); a 2-arg one
;; carries the captured operand, which the marshaler now serializes INLINE
;; (SK_ENV_INT) keyed by the "<fn>$2L"/"<fn>$2R" side, so save-cont!/resume-cont!
;; round-trips it through bytes.  The per-site wrapper applies f in SOURCE order
;; (hole side matters for non-commutative ops).  direct == cps.
(defn add [a : int b : int] : int (+ a b))
(defn sub [a : int b : int] : int (- a b))
;; rt5: serialize the captured continuation to bytes, then deserialize + resume w/ 5.
(defn rt5 [k : ptr<void>] : int (resume-cont! (save-cont! k) 5))
(defn add-hole-right [n : int] : int
  (serial-reset (add 10 (serial-shift rt5 0))))   ; add(10, 5)  = 15
(defn sub-hole-right [n : int] : int
  (serial-reset (sub 10 (serial-shift rt5 0))))   ; sub(10, 5)  = 5
(defn sub-hole-left [n : int] : int
  (serial-reset (sub (serial-shift rt5 0) 3)))    ; sub(5, 3)   = 2
(defn nested-2arg [n : int] : int
  (serial-reset (add 100 (sub (serial-shift rt5 0) 3)))) ; add(100, sub(5,3)) = 102
(defn main [] : int
  (println (add-hole-right 0))
  (println (sub-hole-right 0))
  (println (sub-hole-left 0))
  (println (nested-2arg 0))
  0)
