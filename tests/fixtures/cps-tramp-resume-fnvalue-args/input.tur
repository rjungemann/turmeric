;; E2 (cps-tramp-resume): a MULTI-ARG effectful fn-value threads the DK -- scalar
;; args are cast to the int64 carrier the callee's __cps params use. Covers a named
;; fn and a lambda, both invoked indirectly with 2/3 args under a handler.
(defeffect Ask [] :int)

(defn perf2 [a : int b : int] : int (+ (+ a b) (perform (Ask))))
(defn call2 [f : (fn [int int] #fx{Ask} int)] : int (f 10 20))

(defn apply3 [f : (fn [int int int] #fx{Ask} int) a : int] : int (f a 100 1000))

(defn main [] : int
  (println (handle (call2 perf2) (Ask [] k) (resume k 5)))   ;; 10+20+5 = 35
  (println (handle
             (apply3 (fn [x : int y : int z : int]
                       (+ (+ (+ x y) z) (perform (Ask)))) 7)
             (Ask [] k) (resume k 5)))                        ;; 7+100+1000+5 = 1112
  0)
