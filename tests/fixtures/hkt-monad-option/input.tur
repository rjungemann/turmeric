;; Phase HKT H3: TestMonad instance for option.
;; bind (some x) f = f x
;; bind none     _ = none


(defclass TestFunctor [^f]
  (fmap [container fn] : int))

(defclass TestMonad [^m]
  (bind [ma fn] : int))

;; Option helpers
(defn __opt_some [x] : int
  ```c
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn __opt_none [] : int
  ```c
  return 0;
  ```)

(defn __opt_some? [o] : bool
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return p != 0 && p->is_some;
  ```)

(defn __opt_unwrap [o] : int
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return (int)(p->value);
  ```)

;; TestFunctor[option] — needed to satisfy TestMonad superclass structure.
(defn __fmap_option [container fn] : int
  ```c
  struct { bool is_some; int64_t value; } *c =
      (void *)(intptr_t)container;
  if (!c || !c->is_some) return 0;
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = ((int64_t(*)(int64_t))(intptr_t)fn)(c->value);
  return (int64_t)(intptr_t)r;
  ```)

(definstance TestFunctor [option]
  (fmap [container fn] (__fmap_option container fn)))

;; TestMonad[option]: bind (some x) f = f x; bind none _ = none.
(defn __bind_option [ma fn] : int
  ```c
  struct { bool is_some; int64_t value; } *opt =
      (void *)(intptr_t)ma;
  if (!opt || !opt->is_some) return 0;
  return ((int64_t(*)(int64_t))(intptr_t)fn)(opt->value);
  ```)

(definstance TestMonad [option]
  (bind [ma fn] (__bind_option ma fn)))

;; A monadic function: safe-reciprocal
;; Returns some(100/x) when x != 0, none otherwise.
(defn safe-reciprocal [x] : int
  (if (= x 0)
    (__opt_none)
    (__opt_some (/ 100 x))))

(defn main [] : int
  (do
    ;; bind (some 4) safe-reciprocal => some 25
    (let [result (__bind_option (__opt_some 4) safe-reciprocal)]
      (do
        (println (__opt_some? result))
        (println (__opt_unwrap result))))
    ;; bind none safe-reciprocal => none
    (let [result2 (__bind_option (__opt_none) safe-reciprocal)]
      (println (__opt_some? result2)))
    0))
