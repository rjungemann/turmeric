;; SS3b: session-delegation -- protocol ownership transfer (delegation).
;;
;; Demonstrates that a session channel can be passed to another function,
;; transferring protocol ownership.  The receiving function completes the
;; protocol; the delegating side loses the binding (linear discipline).
;;
;; Protocol: Session[Send int Close]
;;
;; delegate-send takes ownership of the Send-end and completes the protocol.
;; main creates the session, spawns a receiver thread, then delegates the
;; send-end to delegate-send rather than using it directly.
;;
;; Expected output: 42
;; delegate-send: accepts ownership of a send-end and completes the protocol.

(load "stdlib/session.tur")

(defn delegate-send [^linear ch :(Session (Send int Close)) val : int] : nil
  (let [ch (send ch val)]
    (close ch)))

(defn main [] : int
  (let [[s r] (make-session (Send int Close))]
    (let [t (session-spawn (fn []
                     (let [[v r] (recv r)]
                       (println v)
                       (close r))))]
      (delegate-send s 42)
      (session-join t)))
  0)
