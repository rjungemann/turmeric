;; GHE3 (generic-hash-eq-dispatch-plan): the -g content-keyed map builders
;; route ANY scalar key type through (Hash K) + (Eq K) by one code path.
;;
;; Proves:
;;   1. :cstr keys are content-keyed -- a distinct-pointer copy of "beta"
;;      updates the existing entry (count stays 2) and looks up by content;
;;   2. :int keys use the identity/carrier path (hash is identity, eq is =);
;;   3. :bool keys round-trip through the same generic builders;
;;   4. map-has? and map-dissoc share the same per-K Hash/Eq dispatch.
;;
;; Key types include the one-word carriers (int, bool, cstr) and -- since the
;; WKC wide-key carrier (float32-map-key-carrier-plan) -- the inline float keys
;; (:float32 / :float).  Float keys are bit-reinterpreted into the int64_t
;; carrier by MapKey[K] and compared by a carrier-ABI comparator, so 1.5 no
;; longer truncates to 1.  See tests/fixtures/wkc-wide-map-key for the focused
;; float round-trip; here we assert a :float32 key alongside the others.

;; dup-str -- a freshly-allocated, DISTINCT pointer with the same text.
(defn dup-str [s :cstr] :cstr
  ```c const char *src = (const char *)(intptr_t)s;
  size_t n = 0; while (src[n]) n++;
  char *d = (char *)malloc(n + 1);
  for (size_t i = 0; i <= n; i++) d[i] = src[i];
  return (const char *)d;
  ```)

(defn main [] :int
  ;; --- :cstr keys: content-keyed via distinct pointers ---
  (let [m  (map-assoc (map-assoc (:: (map-new) (Map cstr int)) "alpha" 1) "beta" 2)
        m2 (map-assoc m (dup-str "beta") 99)]
    (println (:: (map-get m2 (dup-str "alpha")) :int))   ; 1
    (println (:: (map-get m2 (dup-str "beta")) :int))    ; 99
    (println (map-count m2))                               ; 2 (update, not insert)
    (println (if (map-has? m2 "alpha") 1 0))             ; 1
    (println (if (map-has? (map-dissoc m2 "alpha") "alpha") 1 0))) ; 0
  ;; --- :int keys: identity/carrier path ---
  (let [mi (map-assoc (map-assoc (:: (map-new) (Map int int)) 5 100) 7 200)]
    (println (:: (map-get mi 5) :int))                   ; 100
    (println (:: (map-get mi 7) :int))                   ; 200
    (println (if (map-has? mi 5) 1 0)))                  ; 1
  ;; --- :bool keys ---
  (let [mb (map-assoc (map-assoc (:: (map-new) (Map bool int)) true 10) false 20)]
    (println (:: (map-get mb true) :int))                ; 10
    (println (:: (map-get mb false) :int)))              ; 20
  ;; --- :float32 keys (WKC): reinstated; 1.5 no longer truncates to 1 ---
  (let [mf (map-assoc (map-assoc (:: (map-new) (Map float32 int)) 1.5f32 7) 2.5f32 8)]
    (println (:: (map-get mf 1.5f32) :int))              ; 7
    (println (:: (map-get mf 2.5f32) :int))              ; 8
    (println (map-count mf)))                              ; 2 (distinct keys)
  0)
