(load "stdlib/free.tur")

;; KB-IDIOM-1 regression: a capturing closure constructed *inside* an
;; (unsafe ...) block must thread its captured free variables into the
;; handler-body frame. Before the fix, the closure env-init referenced the
;; captured names against the enclosing function's locals (out of scope inside
;; __handle_body_N), so cc failed with "'<name>_NNN' undeclared".
;;
;; Here `interp` is built inside the unsafe block and captures TWO outer
;; bindings (scale, bias), exercising multi-capture env threading.

(defn main [] : int
  (let [scale  3
        bias   7
        lifted (free-lift 10)
        result (unsafe (free-run (fn [inner] (+ (* inner scale) bias)) lifted))]
    (println result)   ; (10 * 3) + 7 = 37
    0))
