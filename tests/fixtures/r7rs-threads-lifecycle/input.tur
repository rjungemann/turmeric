#lang r7rs
;; r7rs-gc threads, stage C (docs/archive/r7rs-gc-threads-plan.md): the
;; parts of a thread's life the heap has to follow.
;;   kept      a list reachable only through pthread_setspecific (where the
;;             emitted runtime keeps dynamic bindings and the ^thread-local
;;             block), on the main thread and on a worker, survives churn.
;;   fork      a child forked while another thread allocates flat out can
;;             allocate: it never inherits a heap lock that thread held.
;;   detached  threads detached by attribute and by pthread_detach leave
;;             nothing in the collector's registry once they are gone.
(import (scheme base) (scheme write) (lifework) (turmeric lifec) (turmeric life))
(keep! (build!))
(define keeper (life-keeper-start))
(churn!)
(life-keeper-join keeper)
(write (list 'kept (walk (kept)) (get!))) (newline)
(write (list 'fork-failures (life-fork-run 60))) (newline)
;; Twenty rounds of forty: each round ends polling the registry while its
;; threads retire their own records, the window where the poll's lock of the
;; collector's `world` used to park, unpark into `world` again and wait on
;; itself for good (r7rs-gc-threads-lifecycle-rare-hang).  One round hit it
;; about once in 600 runs under load; twenty hang every run without the fix.
(define (detach-rounds n left)
  (if (= n 0) left (detach-rounds (- n 1) (+ left (life-detach-run 40)))))
(write (list 'detached-records-left (detach-rounds 20 0))) (newline)
