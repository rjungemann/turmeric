;; Phase F3-5/F3-6 (cross-plan-followups): recursive `.eq?` on
;; `Set[Vec[int]]` via the new `set-eq-cmp?` stdlib helper.
;;
;; The hash-only `set-eq?` is wrong for non-primitive elements
;; (two structurally-equal Vec[int] pointers hash differently).
;; F3-5 added `set-eq-cmp?` -- an O(n*m) variant that takes an
;; element comparator -- and routes Set's recursive dispatch
;; through it so `Set[Vec[int]]` etc. compare structurally.

(defn main [] : int
  (let [v1 []:int
        v2 []:int
        v3 []:int]
    (vec-push! v1 42)
    (vec-push! v2 42)
    (vec-push! v3 99)
    ;; Vec[int] has no MapKey/Hash instance, so the content-keyed public
    ;; set-add (which dispatches MapKey[A]) does not apply.  A pointer-keyed set
    ;; of a non-hashable element uses the raw layer directly:
    ;; (set-add-eq-o s hash x keyeq owned) with the element pointer as both the
    ;; hash and the boxed key, a NULL comparator, and owned=0.  Structural
    ;; comparison is still handled by the compiler-synthesized Eq[Set[Vec int]]
    ;; dispatch (set-eq-cmp?), element-by-element, independent of construction.
    (let [s1 (:: (set-add-eq-o (set-new) v1 v1 0 0) (Set (Vec int)))
          s2 (:: (set-add-eq-o (set-new) v2 v2 0 0) (Set (Vec int)))
          s3 (:: (set-add-eq-o (set-new) v3 v3 0 0) (Set (Vec int)))]
      (println (.eq? s1 s2))   ; true:  {[42]} == {[42]}
      (println (.eq? s1 s3)))) ; false: {[42]} vs {[99]}
  0)
