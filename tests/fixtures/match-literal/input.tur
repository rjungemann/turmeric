;;; Phase S4-lit: literal pattern matching -- integer, bool, and string literals.

(defn int-name [n : int] : cstr
  (match n
    0 "zero"
    1 "one"
    2 "two"
    _ "other"))

(defn bool-desc [b : bool] : cstr
  (match b
    true  "yes"
    false "no"))

(defn main [] : int
  (do
    (println (int-name 0))
    (println (int-name 1))
    (println (int-name 2))
    (println (int-name 42))
    (println (bool-desc true))
    (println (bool-desc false))
    0))
