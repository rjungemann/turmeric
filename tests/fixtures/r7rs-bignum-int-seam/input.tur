#lang r7rs
;; r7rs-lang-plan T1: a bignum exists only as a Scheme value.  Crossing into a
;; Turmeric `int` parameter -- here stdlib/vec's index, through the
;; `(turmeric ...)` import -- is the seam's checked cast, which refuses an
;; R7rsBig by name on both back ends.  It is never truncated to an int64, and
;; a value that fits int64 is an int, so it always crosses.  The exit is
;; nonzero and the lines before it print.
(import (scheme base) (scheme write)
        (only (turmeric stdlib/vec) vec-new vec-push! vec-get))
(define v (vec-new))
(vec-push! v 7)
(display (vec-get v (- (expt 2 64) (expt 2 64)))) (newline)
(display (vec-get v (expt 2 64))) (newline)
(display "not reached") (newline)
