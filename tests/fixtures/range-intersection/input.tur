; LZ4 fixture: range-intersection -- largest range enclosed by both.

(load "stdlib/range.tur")

(defn main [] : void
  ; [1,5] ∩ [3,8] = [3,5]
  (let [ix (range-intersection (closed-range 1 5) (closed-range 3 8))]
    (println (range-bound-inclusive? (range-lower ix)))  ; true
    (println (range-bound-value      (range-lower ix)))  ; 3
    (println (range-bound-inclusive? (range-upper ix)))  ; true
    (println (range-bound-value      (range-upper ix)))) ; 5
  ; [1,5] ∩ (3,8] = (3,5]  (exclusive lower wins)
  (let [ix (range-intersection (closed-range 1 5) (open-closed-range 3 8))]
    (println (range-bound-inclusive? (range-lower ix)))  ; false
    (println (range-bound-value      (range-lower ix)))  ; 3
    (println (range-bound-inclusive? (range-upper ix)))  ; true
    (println (range-bound-value      (range-upper ix)))) ; 5
  ; [1,+inf) ∩ [3,8] = [3,8]
  (let [ix (range-intersection (at-least-range 1) (closed-range 3 8))]
    (println (range-bound-value (range-lower ix)))  ; 3
    (println (range-bound-value (range-upper ix)))) ; 8
  ; [1,3] and [3,5]: touching -- intersection = [3,3] (singleton)
  (let [ix (range-intersection (closed-range 1 3) (closed-range 3 5))]
    (println (singleton-range? ix))))                   ; true
