;; repl-show-collections: Show instances for the typed collections.
;; (show ...) on a Vec/Set/Map renders the contents rather than an opaque
;; pointer.  Show + the collection instances live in stdlib/typeclass-show.tur,
;; pulled in on demand via typeclass.tur (not auto-loaded).
(load "stdlib/typeclass.tur")

(defn main [] : int
  (println (show (vec-of 1 2 3)))
  (println (show (vec-new)))
  (println (show (set-of 7 8 9)))
  (println (show (hamt-of 1 10 2 20)))
  (println (show (hamt-of)))
  0)
