;; fn-value-matrix-ok-rows -- the OK rows of the boundary matrix in
;; docs/archive/history/fn-typed-value-return-ascribe-miscompiles.md, pinned BEFORE
;; the fat-normalization fix lands (meta-plan landing checklist item 3: the
;; working boundary must not regress while the broken rows flip).  The
;; broken rows join this fixture when fn-value-fat-normalization-plan
;; stage 2 makes them compile.
(defn mk [x : int] : (fn [] int) (fn [] x))
(defn mkc [s : cstr] : (fn [] cstr) (fn [] s))
(defn gid [A] [x : A] : A x)
(defn use-thin [v : (fn [] int)] : int (v))
(defn use-fat [^fat v : (fn [] int)] : int (v))

(defn main [] : int
  (stage2)
  ;; direct invoke of a returned closure
  (println ((mk 5)))
  ;; let-bound, then invoked
  (println ((let [v (mk 6)] v)))
  ;; ascribed (directly), then invoked
  (println ((:: (mk 7) (fn [] int))))
  ;; through generic identity
  (println ((gid (mk 8))))
  ;; consumed through a thin fn-typed param (callee calls, does not return it)
  (println (use-thin (mk 9)))
  ;; consumed through a ^fat param
  (println (use-fat (mk 10)))
  ;; non-int payload: direct invoke round-trips a cstr
  (println ((mkc "ok-11")))
  0)

;; --- stage 2 (2026-07-30): the previously-broken rows, now normal ---
(defn thru-thin [v : (fn [] int)] : (fn [] int) v)
(defn thru-fat [^fat v : (fn [] int)] : (fn [] int) v)
(defn hof-nested [^fat f : (fn [] (fn [] int))] : (fn [] int) (f))

(defn stage2 [] : int
  ;; thin pass-through return of a closure value (was: invalid C)
  (println ((thru-thin (mk 12))))
  ;; ^fat pass-through return (was: SIGSEGV)
  (println ((thru-fat (mk 13))))
  ;; ascription around a let-wrapped closure value (was: SIGSEGV)
  (println ((:: (let [v (mk 14)] v) (fn [] int))))
  ;; nested fat HOF over a closure value (was: SIGSEGV)
  (let [c (mk 15)]
    (println ((hof-nested (fn [] c)))))
  0)
