(load "stdlib/free.tur")

;; RF3: free-lift and free-run -- lift a suspended value and interpret it.

(defn main [] : int
  ;; free-lift wraps a value in Suspend(fx)
  (let [lifted (free-lift 10)]
    ;; free-run on a Suspend passes the inner value to interp.
    ;; The interp closure captures `scale` and is built inside the unsafe block
    ;; (KB-IDIOM-1, now fixed: its capture is threaded into the handler-body
    ;; frame). A capturing closure passes through ^fat unchanged.
    (let [scale  3
          result (unsafe (free-run (fn [inner] (* inner scale)) lifted))]
      (println result)
      0)))
