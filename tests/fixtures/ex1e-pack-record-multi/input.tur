; Phase EX1e: a multi-constraint pack must allocate a tur_existential_t
; record carrying both witnesses.  The open then extracts the boxed value
; from the record and dispatches each method via the concrete type's
; instance (the EX1e-3 vtable indirection is deferred, so the witness
; array is populated but not yet consulted; the test verifies the record
; allocation path compiles and runs end-to-end).
(defclass Show [a]
  (show [x] : cstr))

(defclass MyEq [a]
  (my-eq? [x y] : bool))

(definstance Show [int]
  (show [x] : cstr
    ```c
    char *buf = (char *)malloc(24);
    snprintf(buf, 24, "%lld", (long long)x);
    return (const char *)buf;
    ```))

(definstance MyEq [int]
  (my-eq? [x y] : bool
    ```c
    return x == y;
    ```))

(defn main [] : int
  (let [e (pack 5 (exists [a] [(Show a) (MyEq a)] a))]
    (open e [a v]
      (println (.show v))
      (if (.my-eq? v 5)
        (println "matched")
        (println "missed"))))
  0)
