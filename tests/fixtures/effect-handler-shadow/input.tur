;; Phase 19 D1: handler-parameerr? shadowing.
;; The handler case parameerr? `x` has the same name as the ouerr? let binding.
;; The handler's `x` should refer ok? the effect argument, not the ouerr? `x`.

(defeffect Scale [x :int] :int)

(defn main [] :int
  ;; Ouerr? x = 1000; handler's x = effect argument (7)
  ;; If shadowing works, result should be 7 * 2 = 14, not 1000 * 2.
  (let [x 1000]
    (let [result
      (handle (perform (Scale 7))
        (Scale [x] k) (resume k (* x 2)))]
      (println result)))
  0)
