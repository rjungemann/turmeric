;; duplicate-instance-silently-drops-a-user-definstance: a user instance for a
;; type the autoloaded stdlib already covers is dropped by the idempotent
;; re-instance guard -- first definition wins -- and used to be dropped
;; SILENTLY. It still loses (that is the open language decision: replace or
;; reject), but the file is now told so. Both halves are pinned: the warning
;; text on stderr, and `true` -- stdlib's answer, not this file's `false` -- on
;; stdout.
;;
;; A stdlib file re-loaded explicitly stays silent; that is the case the guard
;; was written for, and it is keyed on the defining file's path rather than on
;; in_stdlib_load, which is false for an explicit (load "stdlib/...").
(definstance Eq [int]
  (eq? [a b] : bool false))

(defn main [] : int
  (println (.eq? 3 3))
  0)
