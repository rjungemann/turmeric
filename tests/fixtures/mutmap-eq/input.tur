;; Phase F5: MutableMap structural equality via mutmap-eq?.
;; Same key/value sets compare equal regardless of insertion order;
;; differing sets compare unequal.

(defn main [] : int
  (let [a (mutmap-new)
        b (mutmap-new)
        c (mutmap-new)]
    (mutmap-set! a 1 1 100)
    (mutmap-set! a 2 2 200)
    (mutmap-set! a 3 3 300)
    ;; b: same key/value set, different insertion order
    (mutmap-set! b 3 3 300)
    (mutmap-set! b 2 2 200)
    (mutmap-set! b 1 1 100)
    ;; c: differs in one value
    (mutmap-set! c 1 1 100)
    (mutmap-set! c 2 2 999)
    (mutmap-set! c 3 3 300)
    (println (mutmap-eq? a b (fn [x y] (= x y))))   ; true
    (println (mutmap-eq? a c (fn [x y] (= x y))))   ; false
    ;; Same content via the typeclass dispatch (uses (= x y)).
    ;; a/b carry their (MutableMap int int) type from mutmap-new, so .eq?
    ;; dispatches with no ascription -- mirroring the Eq[Vec] surface.
    (println (.eq? a b))     ; true
    (mutmap-free a)
    (mutmap-free b)
    (mutmap-free c))
  0)
