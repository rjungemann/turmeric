;; Phase 19: with-fail-throw stdlib handler — bridges Fail effect to exceptions.
(defeffect Fail [msg :cstr] :nil)

(defmacro with-fail-throw [body]
  (handle body
    (Fail [msg] k) (throw! msg)))

(try
  (with-fail-throw
    (do
      (println "before fail")
      (perform (Fail "something went wrong"))
      (println "after fail")))
  (catch [err :cstr]
    (println err)))
