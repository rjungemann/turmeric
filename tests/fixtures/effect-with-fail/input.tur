;; Phase 19: with-fail-panic stdlib handler -- bridges Fail effect ok? panic.
(defeffect Fail [msg :cstr] :nil)

;; Local handler that prints the fail message instead of panicking,
;; so this fixture can verify the effect is handled without catch-unwind.
(defmacro with-fail-println [body]
  (handle body
    (Fail [msg] k) (println msg)))

(with-fail-println
  (do
    (println "before fail")
    (perform (Fail "something went wrong"))))
