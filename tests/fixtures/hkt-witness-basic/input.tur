;; Phase D1: Type witness @TypeName -- basic case.
;; Two TestFunctor instances (option, vec). The receiver has erased type (TY_INT).
;; @option witness pins dispatch to TestFunctor[option] at zero runtime cost.

(defclass TestFunctor [^f]
  (fmap [container fn] : int))

;; Option helpers
(defn __opt_some [x] : int
  ```c
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn __opt_some? [o] : bool
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return p != 0 && p->is_some;
  ```)

(defn __opt_unwrap [o] : int
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return (int64_t)(p->value);
  ```)

(defn __fmap_option [container fn] : int
  ```c
  struct { bool is_some; int64_t value; } *c =
      (void *)(intptr_t)container;
  if (!c || !c->is_some) return container;
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = ((int64_t(*)(int64_t))(intptr_t)fn)(c->value);
  return (int64_t)(intptr_t)r;
  ```)

;; Vec helpers (minimal single-element vec for this test)
(defn __vec_of [x] : int
  ```c
  struct { int64_t len; int64_t item; } *r = malloc(sizeof(*r));
  r->len = 1;
  r->item = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn __vec_get0 [v] : int
  ```c
  struct { int64_t len; int64_t item; } *p =
      (void *)(intptr_t)v;
  return p->item;
  ```)

(defn __fmap_vec [container fn] : int
  ```c
  struct { int64_t len; int64_t item; } *c =
      (void *)(intptr_t)container;
  struct { int64_t len; int64_t item; } *r = malloc(sizeof(*r));
  r->len = c->len;
  r->item = ((int64_t(*)(int64_t))(intptr_t)fn)(c->item);
  return (int64_t)(intptr_t)r;
  ```)

(definstance TestFunctor [option]
  (fmap [c f] (__fmap_option c f)))

(definstance TestFunctor [vec]
  (fmap [c f] (__fmap_vec c f)))

(defn twice [x] : int (* x 2))

;; mk returns :int (erased type) but always produces an option value.
(defn mk [] : int (__opt_some 21))

(defn main [] : int
  (let [obj (mk)]
    ;; Without @option this would trigger TUR_E0020_AMBIGUOUS_DISPATCH.
    ;; @option pins dispatch to TestFunctor[option] at compile time.
    (let [result (.fmap @option obj twice)]
      (do
        (println (__opt_some? result))
        (println (__opt_unwrap result))
        0))))
