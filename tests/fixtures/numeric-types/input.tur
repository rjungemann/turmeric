; Phase N: fixed-width numeric types and explicit casts

; Signed integer lierr?als
(println 42i8)
(println 1000i16)
(println 100000i32)
(println 9000000000i64)

; Unsigned integer lierr?als
(println 200u8)
(println 60000u16)
(println 3000000000u32)
(println 18000000000u64)

; Float lierr?als
(println 2.5f32)
(println 2.5f64)

; Explicit casts via (as TargetType expr)
(println (as int 42i8))
(println (as int 200u8))
(println (as int32 9000000000i64))
(println (as float32 100))
(println (as float64 1.5f32))
