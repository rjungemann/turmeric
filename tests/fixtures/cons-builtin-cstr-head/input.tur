;; cons-builtin-cstr-head: the user-callable `cons` builtin accepts any
;; 64-bit-sized head, not just :int.  Regression for the spices-side paydown
;; (c-dsl/glsl use (cons cstr 0) for include/fragment lists).  See
;; docs/archive/history/cons-builtin-rejects-cstr-head.md.
(defmodule cons-builtin-cstr-head
  (defn first-byte [lst : int] : int
    ```c struct __cell { int64_t head; int64_t tail; } *c =
           (struct __cell *)(intptr_t)lst;
       const char *s = (const char *)(intptr_t)c->head;
       return (int64_t)(unsigned char)s[0];
    ```)
  (defn main [] : int
    (let [lst (cons "hello" (cons "world" 0))]
      ;; round-trip: first cell's head should still be the cstr "hello"
      ;; -> first byte 'h' (104) -> exit 0 if matches, else 1
      (if (= (first-byte lst) 104) 0 1))))
