;; Phase S4: try/catch in compiled mode.
;; Demonstrates tur_catch_unwind thunk wrapping for panic interception.

(defn safe-div [a b] :int
  (try (do
         (if (= b 0)
           (throw 42)
           (/ a b)))
    (catch [e] -1)))

(defn with-capture [x] :int
  (let [base x]
    (try (do
           (if (= base 0)
             (throw 99)
             (+ base 10)))
      (catch [e] (+ base -1)))))

(defn no-panic [] :int
  (try (+ 3 4)
    (catch [e] -1)))

(defn main []
  (println (safe-div 10 2))
  (println (safe-div 10 0))
  (println (with-capture 5))
  (println (with-capture 0))
  (println (no-panic)))
