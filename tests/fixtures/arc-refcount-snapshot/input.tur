;; Phase T19-F codegen snapshot: arc-refcount-snapshot
;;
;; arc-new + arc-clone + arc-drop.  The golden expected.c documents the
;; __atomic_fetch_add / __atomic_fetch_sub refcount pattern.
;; No expected.stdout; only expected.c is checked.

(defn arc-new [val : int] : ptr<void>
  ```c
  typedef struct { uint64_t strong; uint64_t weak; int64_t value; } ArcCell;
  ArcCell *b = (ArcCell *)malloc(sizeof(ArcCell));
  if (!b) { fprintf(stderr, "arc-new: oom\n"); abort(); }
  __atomic_store_n(&b->strong, (uint64_t)1, __ATOMIC_RELAXED);
  __atomic_store_n(&b->weak,   (uint64_t)1, __ATOMIC_RELAXED);
  b->value = (int64_t)val;
  return (void *)b;
  ```)

(defn arc-clone [p : ptr<void>] : ptr<void>
  ```c
  typedef struct { uint64_t strong; uint64_t weak; int64_t value; } ArcCell;
  ArcCell *b = (ArcCell *)p;
  __atomic_fetch_add(&b->strong, (uint64_t)1, __ATOMIC_RELAXED);
  return (void *)b;
  ```)

(defn arc-get [p : ptr<void>] : int
  ```c
  typedef struct { uint64_t strong; uint64_t weak; int64_t value; } ArcCell;
  return (int64_t)((ArcCell *)p)->value;
  ```)

(defn arc-drop [p : ptr<void>] : nil
  ```c
  typedef struct { uint64_t strong; uint64_t weak; int64_t value; } ArcCell;
  ArcCell *b = (ArcCell *)p;
  uint64_t prev = __atomic_fetch_sub(&b->strong, (uint64_t)1, __ATOMIC_ACQ_REL);
  if (prev == 1) {
      if (__atomic_fetch_sub(&b->weak, (uint64_t)1, __ATOMIC_ACQ_REL) == 1)
          free(b);
  }
  ```)

(defn main [] : int
  (let [a (arc-new 42)]
    (let [b (arc-clone a)]
      (arc-drop b))
    (arc-drop a))
  0)
