;; Phase S2: eval-import fixture
;;
;; Demonstrates (import turi/eval) from a Turmeric program.
;; The eval API allows embedding the Turmeric interpreter inside a compiled program.

(defmodule eval-import/main
  (import turi/eval :refer [Env/new Env/free eval eval-ok? eval-err? eval-err-msg
                            eval-as-int eval-as-bool eval-as-cstr eval-free])

  (defn main [] : int
    (let [env (Env/new)]

      ;; Basic arithmetic
      (let [r1 (eval env "(+ 40 2)")]
        (if (eval-ok? r1)
          (println (eval-as-int r1))
          (println "error"))
        (eval-free r1))

      ;; Boolean result
      (let [r2 (eval env "(< 1 10)")]
        (if (eval-ok? r2)
          (println (eval-as-bool r2))
          (println "error"))
        (eval-free r2))

      ;; Persistent defn across eval calls
      (let [r3 (eval env "(defn square [x :int] :int (* x x))")]
        (eval-free r3))
      (let [r4 (eval env "(square 7)")]
        (if (eval-ok? r4)
          (println (eval-as-int r4))
          (println "error"))
        (eval-free r4))

      ;; Error handling
      (let [r5 (eval env "(/ 1 0)")]
        (if (eval-err? r5)
          (println "caught error")
          (println "no error"))
        (eval-free r5))

      (Env/free env)
      0)))
