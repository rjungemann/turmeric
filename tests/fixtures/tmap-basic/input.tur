;;
;; Phase TM0: tmap basic operations test

(defn test-empty [] :int
  (let [m (tmap-new)]
    (let [c (tmap-count m)]
      (tmap-free m)
      c)))

(defn test-assoc-get [] :int
  (let [m (tmap-new)]
    (let [m2 (tmap-assoc m 42 100)]
      (let [v (tmap-get m2 42 42)]
        (tmap-free m)
        (tmap-free m2)
        v))))

(defn test-has [] :int
  (let [m (tmap-new)]
    (let [m2 (tmap-assoc m 7 999)]
      (let [found (tmap-has? m2 7 7)]
        (tmap-free m)
        (tmap-free m2)
        (if found 1 0)))))

(defn test-count [] :int
  (let [m (tmap-new)]
    (let [m2 (tmap-assoc m 1 10)]
      (let [m3 (tmap-assoc m2 2 20)]
        (let [c (tmap-count m3)]
          (tmap-free m)
          (tmap-free m2)
          (tmap-free m3)
          c)))))

(defn test-dissoc [] :int
  (let [m (tmap-new)]
    (let [m2 (tmap-assoc m 5 50)]
      (let [m3 (tmap-dissoc m2 5 5)]
        (let [c (tmap-count m3)]
          (tmap-free m)
          (tmap-free m2)
          (tmap-free m3)
          c)))))

(defn test-merge [] :int
  (let [a (tmap-new)]
    (let [b (tmap-new)]
      (let [a2 (tmap-assoc a 1 10)]
        (let [b2 (tmap-assoc b 2 20)]
          (let [m (tmap-merge a2 b2)]
            (let [c (tmap-count m)]
              (tmap-free a)
              (tmap-free b)
              (tmap-free a2)
              (tmap-free b2)
              (tmap-free m)
              c)))))))

(println (test-empty))
(println (test-assoc-get))
(println (test-has))
(println (test-count))
(println (test-dissoc))
(println (test-merge))
