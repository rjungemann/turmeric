#lang r7rs
;; letrec-mutual-recursion-between-capturing-closures, the Scheme shape: two
;; internal defines that call each other AND use a variable of the enclosing
;; procedure.  The body's internal defines splice into a letrec, so this was
;; the same undeclared-local cc error as the Turmeric repro.
(import (scheme base) (scheme write))

(define (parity k n)
  (define (ev? i) (if (= i 0) k (od? (- i 1))))
  (define (od? i) (if (= i 0) (- 0 k) (ev? (- i 1))))
  (ev? n))

(display (parity 1 10)) (newline)
(display (parity 1 7)) (newline)
(display (parity 2.5 3)) (newline)
