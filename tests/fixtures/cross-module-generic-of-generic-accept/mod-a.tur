;; Module A: defines a parametric opaque `Box` (erases to int64) and two
;; generic accessors over it.  `box-get` is the inner generic that, pre-fix,
;; was never emitted when its only caller was another generic in module B.
;; See docs/archive/history/cross-module-generic-of-generic-instantiation-missing.md.
(defmodule mod-a
  (export Box box-make box-get)
  (defopaque Box [A] :int)
  (defn box-make [A] [k : int] : (Box A)
    (:: k :Box))
  (defn box-get [A] [b : (Box A)] : int
    (:: b :int)))
