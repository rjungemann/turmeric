;; CPS-IR-to-C backend, N6: a colored function with an *effectful* TY_FN
;; parameter that INVOKES it now CPS-emits (it used to fall back).  Built with
;; --enable=cps-backend.
;;
;; `use-writer` handles E internally on DK (`(handle (g) (E [] k) ...)`) and takes
;; a callback `f` typed `(fn [cstr] #fx{Write} nil)`, which it invokes -- `(f
;; "hi")` performs Write, escaping to main's handler.
;;
;; The invocation is a delegated indirect call, emitted as a plain fiber call
;; `f("hi")`.  That is SOUND: the fiber effect machine dispatches Write
;; DYNAMICALLY through its global handler chain, so no DK continuation is threaded
;; -- the effect never touches the DK machine.  The whole-program taint keeps it
;; safe: Write is performed by the (fiber) callback body, so its handler (in main)
;; stays co-fiber, and no DK function performs Write on the DK machine.  use-writer
;; itself is DK for the *E* effect it handles internally; its Write callback rides
;; the fiber machine transparently, and use-writer's own continuation survives the
;; fiber suspend (it lives on the fiber's C stack).
;;
;; direct-vs-CPS equal: the callback performs Write("hi") (printed by main's
;; handler), then use-writer returns the resume value 5.

(defeffect Write [s :cstr] :nil)
(defeffect E [] :int)

(defn g [] : int
  (perform (E)))

(defn use-writer [f : (fn [cstr] #fx{Write} nil)] #fx{Write} : int
  (let [n (handle (g) (E [] k) (resume k 5))]
    (do (f "hi") n)))

(defn main [] : int
  (handle
    (do (println (use-writer (fn [s] (perform (Write s))))) 0)
    (Write [s] k) (do (println s) (resume k nil))))
