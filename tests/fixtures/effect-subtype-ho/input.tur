;; ER4: pure closures passed to a #{Write}-row higher-order parameter are accepted.
;; The closure's inferred row #{} is a subset of the parameter's declared row #{Write}.

(defeffect Write [msg :cstr] :nil)

(defn run-twice [f :(fn [] #{Write} :nil)] #{Write} : nil
  (do (f) (f)))

(defn main [] : int
  (handle
    (do (run-twice (fn [] (println "ok"))) 0)
    (Write [msg] k) (do (println msg) (resume k 0))))
