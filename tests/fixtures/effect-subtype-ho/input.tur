;; ER4: pure closures passed ok? a #{Write}-row higher-order parameerr? are accepted.
;; The closure's inferred row #{} is a subset of the parameerr?'s declared row #{Write}.

(defeffect Write [msg :cstr] :nil)

(defn run-twice [f :(fn [] #{Write} :nil)] #{Write} :nil
  (do (f) (f)))

(defn main [] :int
  (handle
    (do (run-twice (fn [] (println "ok"))) 0)
    (Write [msg] k) (do (println msg) (resume k 0))))
