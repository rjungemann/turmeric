;; R4 slice 1 (trusted-refinement-claims-plan): the SECOND way to break the
;; `#reads` promise. `refine-reads-frame-omits-global` pins the first (the
;; body reads a mutable global); here the body reads mutable state rooted in
;; a PARAMETER the frame omits -- `linked?` declares `#reads w` and then
;; loads from g's block too. The evidence walk chases the raw load's pointer
;; root through the field hop to `g`, finds bit g clear in the frame mask,
;; and TUR-W0383 fires with the omitted-parameter wording.
;;
;; Same trust-boundary posture as the global sibling: the warning is
;; gateless and changes nothing proved -- the trusted grant still discharges
;; the crossing (prints 100). The gated refusal half is
;; errors/r4-checked-reads-refuses-param-read; the fixed-frame half
;; (`#reads [w g]`, silent even under the gate) is
;; refine-reads-multi-param-visible-quiet.
;;
;; The evidence walk descends `(unsafe ...)` (EX_HANDLE) deliberately: the
;; raw-load builtins REQUIRE the block, so a walk that stopped at it would
;; be blind to exactly the reads the trusted tier exists for.
(defstruct Wld [gens : ptr<void>])
(defstruct Grd [gens : ptr<void>])

(defn wld-new [] : Wld
  (unsafe (let [p (raw-malloc 32)]
            (array-set-unchecked p 0 0)   ;; init slot 0 -- turi runs this too
            (Wld p))))
(defn grd-new [] : Grd
  (unsafe (let [p (raw-malloc 32)]
            (array-set-unchecked p 0 0)
            (Grd p))))

(defn linked? [^borrow w : Wld ^borrow g : Grd e : int] #reads w : bool
  (= (unsafe (+ (array-get-unchecked (.gens w) e)
                (array-get-unchecked (.gens g) e)))
     0))

(defn get-it [^borrow w : Wld ^borrow g : Grd
              e : #refine{ x : int | (linked? w g x) }] : int
  (+ e 100))

(defn run [] : int
  (let [^mut w (wld-new)
        ^mut g (grd-new)]
    (let [__f1 (& w)
          __f2 (& g)]
      (if (linked? w g 0)
        (get-it w g 0)
        -1))))

(defn main [] : int
  (println (run))
  0)
