;; MS1: ^multishot k allows multiple resumes in a handler clause.
;; True multishot: each (resume k v) runs an independent copy of the captured
;; continuation, so (resume k 10) -> 10 and (resume k 20) -> 20, summing to 30.

(defeffect Ask [] :int)

(defn main [] : int
  (let [r
    (handle (perform (Ask))
      (Ask [] ^multishot k)
        (+ (resume k 10) (resume k 20)))]
    (println r))
  0)
