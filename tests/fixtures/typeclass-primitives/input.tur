;; Phase 15: Built-in typeclasses for primitive types
;; NOTE: renamed Eq/Ord/Show -> MyEqPrim/MyOrdPrim/MyShowPrim to avoid
;; orphan-instance errors against the auto-loaded stdlib typeclasses.

(defclass MyEqPrim [a]
  (eq? [x y] : bool))

(definstance MyEqPrim [int]
  (eq? [x y] (= x y)))

(definstance MyEqPrim [bool]
  (eq? [x y] (= x y)))

(defclass MyOrdPrim [a]
  (lt? [x y] : bool)
  (lte? [x y] : bool)
  (gt? [x y] : bool)
  (gte? [x y] : bool))

(definstance MyOrdPrim [int]
  (lt? [x y] (< x y))
  (lte? [x y] (<= x y))
  (gt? [x y] (> x y))
  (gte? [x y] (>= x y)))

(defclass MyShowPrim [a]
  (show [x] : cstr))

(definstance MyShowPrim [int]
  (show [x] : cstr "<int>"))

(definstance MyShowPrim [bool]
  (show [x] : cstr "<bool>"))

(definstance MyShowPrim [cstr]
  (show [x] x))

(defn main [] : int
  0)
