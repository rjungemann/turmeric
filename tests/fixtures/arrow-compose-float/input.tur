;; End-to-end fixture for stdlib/arrow.tur's generic >>>.
;;
;; >>> is the register-class-correct polymorphic compositor: it binds
;; A=float, B=float, C=float from the declared types of its arguments and
;; emits a double-returning inner body dispatched through
;; tur_thunk_double_double_t (unlike the old type-erased >>> which would
;; dispatch double bodies through int64 thunk pointers -- see
;; docs/archive/history/arrow-compose-float-closure-int64-thunk-mismatch.md).
;;
;; Verifies fractional results survive composition (no int truncation) and
;; that two independently constructed compositions with distinct behaviours
;; both work correctly.

(load "stdlib/arrow.tur")

(defn scale-2 [x : float] : float (* x 2.0))
(defn add-05  [x : float] : float (+ x 0.5))
(defn add-15  [x : float] : float (+ x 1.5))
(defn call-f [^fat f :(fn [float] #fx{} float) x : float] : float (f x))

(defn main [] : int
  (let [h  (>>> add-05 scale-2)
        h3 (>>> add-15 scale-2)]
    (println (call-f h 3.0))     ;; (3.0 + 0.5) * 2.0 = 7
    (println (call-f h 0.25))    ;; (0.25 + 0.5) * 2.0 = 1.5
    (println (call-f h3 3.0)))   ;; (3.0 + 1.5) * 2.0 = 9
  0)
