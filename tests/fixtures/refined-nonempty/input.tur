; R1: NonEmpty refinement -- total head/tail and the ne-from? smart constructor.

(load "stdlib/refined.tur")

(defn main [] : int
  ; ne-of / ne-singleton are non-empty by construction; ne-head is total.
  (println (ne-head (ne-singleton 42)))                          ; 42
  (let [ne (ne-of 10 (tcons 20 (tcons 30 (tnil))))]
    (println (ne-head ne))                                        ; 10
    (println (ne-len ne))                                         ; 3
    (println (list-head (ne-tail ne)))                            ; 20
    (println (list-head (ne->list ne))))                          ; 10
  ; ne-from? discharges the proof obligation: some for non-empty, none for empty.
  (let [o (ne-from? (tcons 7 (tnil)))]
    (if (some? o) (println (ne-head (ne-unwrap o))) (println -1))) ; 7
  (let [e (ne-from? (tnil))]
    (println (if (some? e) 1 0)))                                  ; 0
  0)
