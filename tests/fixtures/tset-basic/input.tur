;;
;; Phase TC2: tset basic operations test

(defn test-empty [] :int
  (let [s (tset-new)]
    (let [c (tset-count s)]
      (tset-free s)
      c)))

(defn test-add-member [] :bool
  (let [s (tset-new)]
    (let [s2 (tset-add s 42 42)]
      (let [found (tset-member? s2 42 42)]
        (tset-free s)
        (tset-free s2)
        found))))

(defn test-remove [] :bool
  (let [s (tset-new)]
    (let [s2 (tset-add s 42 42)]
      (let [s3 (tset-remove s2 42 42)]
        (let [found (tset-member? s3 42 42)]
          (tset-free s)
          (tset-free s2)
          (tset-free s3)
          found)))))

(defn test-count [] :int
  (let [s (tset-new)]
    (let [s2 (tset-add s 1 1)]
      (let [s3 (tset-add s2 2 2)]
        (let [s4 (tset-add s3 3 3)]
          (let [c (tset-count s4)]
            (tset-free s)
            (tset-free s2)
            (tset-free s3)
            (tset-free s4)
            c))))))

(defn test-union [] :int
  (let [a (tset-new)]
    (let [b (tset-new)]
      (let [a2 (tset-add a 1 1)]
        (let [b2 (tset-add b 2 2)]
          (let [u (tset-union a2 b2)]
            (let [c (tset-count u)]
              (tset-free a)
              (tset-free b)
              (tset-free a2)
              (tset-free b2)
              (tset-free u)
              c)))))))

(defn test-intersect [] :int
  (let [a (tset-new)]
    (let [b (tset-new)]
      (let [a2 (tset-add a 1 1)]
        (let [a3 (tset-add a2 2 2)]
          (let [b2 (tset-add b 2 2)]
            (let [b3 (tset-add b2 3 3)]
              (let [i (tset-intersect a3 b3)]
                (let [c (tset-count i)]
                  (tset-free a)
                  (tset-free b)
                  (tset-free a2)
                  (tset-free a3)
                  (tset-free b2)
                  (tset-free b3)
                  (tset-free i)
                  c)))))))))

(defn test-eq [] :bool
  (let [a (tset-new)]
    (let [b (tset-new)]
      (let [a2 (tset-add a 1 1)]
        (let [b2 (tset-add b 1 1)]
          (let [result (tset-eq? a2 b2)]
            (tset-free a)
            (tset-free b)
            (tset-free a2)
            (tset-free b2)
            result))))))

(println (test-empty))
(println (test-add-member))
(println (test-remove))
(println (test-count))
(println (test-union))
(println (test-intersect))
(println (test-eq))
