;; Phase 9 Prerequisite 1: Move-state tracking in ref auto-drop.
;; When a ref binding is moved (consumed by rc/from-ref), the outer let
;; must NOT inject an auto-drop defer for that ref binding.
;;
;; If auto-drop were injected for `r` despite it being moved to `rc`,
;; the emit phase would crash or produce invalid code (use-after-move).
;;
;; Expected: r is moved into rc/from-ref, so no (drop! r) defer is emitted.
;; The rc binding owns the data from this point on.

(defn main [] :int
  (let [r (ref 100)]
    (let [rc (rc/from-ref r)]
      (println (rc/strong-count rc))))
  0)
