;; Phase F5 (cross-plan-followups): MutableMap basic operations.
;; insert, lookup (has? + get), len, free.

(defn main [] :int
  (let [mm (tmutmap-new)]
    (println (tmutmap-len mm))         ; 0
    (tmutmap-set! mm 1 1 100)
    (tmutmap-set! mm 2 2 200)
    (tmutmap-set! mm 3 3 300)
    (println (tmutmap-len mm))         ; 3
    (println (tmutmap-get mm 2 2))      ; 200
    (println (tmutmap-has? mm 2 2))     ; true
    (println (tmutmap-has? mm 99 99))   ; false
    ;; Update existing key keeps len at 3
    (tmutmap-set! mm 2 2 222)
    (println (tmutmap-len mm))         ; 3
    (println (tmutmap-get mm 2 2))      ; 222
    (tmutmap-free mm))
  0)
