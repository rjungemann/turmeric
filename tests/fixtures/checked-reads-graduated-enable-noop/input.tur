;; R2 graduation compatibility promise (2026-08-20): `checked-reads` graduated,
;; so its EXPERIMENTS[] row is gone -- but a downstream `build.tur`,
;; `~/.config/turmeric/experiments.tur`, or CLI invocation that still names it
;; must keep compiling.  `GRADUATED[]` in src/runtime/experiments.c is what
;; makes `--enable=checked-reads` a TUR-W0063 no-op instead of the hard
;; TUR-E0310 an unknown experiment name gets.
;;
;; Without this fixture graduation is a breaking change for exactly the people
;; who adopted the feature deliberately, which is the wrong population to
;; break.
;;
;; This is the graduated name with the WEAKEST reason for anyone to have named
;; it and the strongest reason to keep accepting it anyway.  The flag bought a
;; STRICTER compiler and nothing else -- no new syntax, no new capability -- so
;; the population that opted in is the population that wanted the refusal, i.e.
;; the people whose configs are worth not breaking.
;;
;; The flag is in `flags`; the program below is the refusal shape, so one run
;; asserts both halves: the lingering enable is tolerated (TUR-W0063), and the
;; refusal happens with no enable needed at all (TUR-W0383 + TUR-W0372).
;;
;; It still PRINTS 7, which is the same point refine-reads-frame-omits-global
;; makes at length: a `#reads` crossing is proof-only, so refusing the grant
;; buys a diagnostic and not a check.  Asserted here so a future reader cannot
;; mistake this fixture for one where the refusal stops anything happening.
;;
;; Behaviour beyond the shim is pinned elsewhere and is not restated here:
;; refine-reads-frame-omits-global (warn and keep running),
;; errors/r2-checked-reads-refuses-broken-frame (the same program under
;; --strict-refine), and r2-checked-reads-inline-c-still-trusted (an unwalkable
;; body yields no evidence and KEEPS the grant, which is what bounds the
;; refusal's reach).
(load "stdlib/refine.tur")

(def ^mut fudge 1)

(defstruct World [n : int])

;; Declares `#reads w`.  Actually reads the global `fudge` -- the frame omits
;; state the body demonstrably reads, which is the evidence that refuses.
(defn alive? [^borrow w : World e : int] #reads w : bool
  (> fudge 0))

(defn get! [^borrow w : World e : #refine{ x : int | (alive? w x) }] : int
  (.n w))

(defn run [] : int
  (let [^mut w (World 7)]
    (let [__b (& w)]                 ; freezes w -- would grant congruence
      (if (alive? w 0)
        (do
          (set! fudge -1)            ; the state alive? really reads changes
          (get! w 0))                ; crossing: (alive? w 0) is now FALSE
        -1))))

(defn main [] : int
  (println (run))
  0)
