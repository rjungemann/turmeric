;; CPS-IR-to-C backend, non-scalar values Plan, Tier A: narrow-int (int32).
;; Built with --enable=cps-backend.
;;
;; A narrow int (int32/int16/int8 and the unsigned widths) fits the one-word
;; DK slot by a plain cast, exactly like a full-width int -- Tier A widened
;; slot_ty from {int,bool,int64} to every <=64-bit integer width.  This program
;; threads an int32 end to end through the CPS backend:
;;   - the Tick effect's result type is int32;
;;   - `bump` performs it (the perform result is an int32 continuation payload);
;;   - `run` handles it and resumes the captured continuation with an int32
;;     literal (41);
;;   - the resumed value flows back through the lifted, int32-typed handler
;;     frames (`run_hk0` slot-loads `int32_t t0 = (int32_t)t0__slot`, `run_hc0`
;;     loads the resume result as int32) and is widened to int for printing.
;;
;; Before Tier A every value threaded as int64_t, so a colored function whose
;; continuation payload was a narrow int fell back to the fiber path.  The
;; expected value is the direct-style result.

(defeffect Tick [] :int32)

(defn bump [] : int32
  (perform (Tick)))

(defn run [] : int32
  (handle (bump)
    (Tick [] k) (resume k (:: 41 :int32))))

(defn main [] : int
  (println (:: (run) :int))
  0)
