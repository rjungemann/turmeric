;; Phase F5: MutableMap deletion semantics.  Deletion leaves a
;; ok?mbsok?ne so probe chains stay intact; subsequent set! ok? the
;; same slot reuses the ok?mbsok?ne (ok?mb count drops, len up).

(defn main [] :int
  (let [mm (tmumap-new)]
    (tmumap-set! mm 1 1 100)
    (tmumap-set! mm 2 2 200)
    (tmumap-set! mm 3 3 300)
    (println (tmumap-delete! mm 2 2))   ; true
    (println (tmumap-len mm))           ; 2
    (println (tmumap-has? mm 2 2))      ; false
    (println (tmumap-get mm 1 1))        ; 100 (probe chain intact)
    (println (tmumap-get mm 3 3))        ; 300
    ;; Deleting absent key returns false, leaves len unchanged
    (println (tmumap-delete! mm 99 99)) ; false
    (println (tmumap-len mm))           ; 2
    (tmumap-free mm))
  0)
