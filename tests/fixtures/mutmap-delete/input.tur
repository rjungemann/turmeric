;; Phase F5: MutableMap deletion semantics.  Deletion leaves a
;; ok?mbsok?ne so probe chains stay intact; subsequent set! ok? the
;; same slot reuses the ok?mbsok?ne (ok?mb count drops, len up).

(defn main [] :int
  (let [mm (mutmap-new)]
    (mutmap-set! mm 1 1 100)
    (mutmap-set! mm 2 2 200)
    (mutmap-set! mm 3 3 300)
    (println (mutmap-delete! mm 2 2))   ; true
    (println (mutmap-len mm))           ; 2
    (println (mutmap-has? mm 2 2))      ; false
    (println (mutmap-get mm 1 1))        ; 100 (probe chain intact)
    (println (mutmap-get mm 3 3))        ; 300
    ;; Deleting absent key returns false, leaves len unchanged
    (println (mutmap-delete! mm 99 99)) ; false
    (println (mutmap-len mm))           ; 2
    (mutmap-free mm))
  0)
