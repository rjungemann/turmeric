;; Phase B4: Logic programming -- without occurs check, x = pair(x, nil) succeeds.
;; Standard miniKanren omits the occurs check for performance; this confirms that.
;; Result: 1 substitution where var 0 binds to a pair referencing itself.
;; Uses the pure-Turmeric stdlib/logic.tur engine (no inline-C).

(load "stdlib/logic.tur")

(defn main [] : int
  (let [x       (term-var 0)
        results (run-logic 1 (lequal x (term-pair x (term-nil))))]
    (println (bt-length results))
    0))
