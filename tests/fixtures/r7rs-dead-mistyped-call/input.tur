#lang r7rs
;; r7rs-dead-mistyped-call-refused-at-compile-time: a call whose argument's
;; STATIC type is wrong for the procedure -- a literal, or a `let`-bound
;; literal -- is an error only if it runs (R7RS 1.3.2).  Guarded so it never
;; runs, it compiles and the program goes on; run, it raises an error object
;; `guard` catches, on both back ends.  It used to be TUR-E0001 "function
;; 'r7rs-car' arg 1: expected R7rsPair, got bool" at compile time.  The same
;; holds for the wrong argument COUNT: `(f 1 2)` of a one-argument `f` used to
;; be "returns any, which is not callable".
(import (scheme base) (scheme write) (srfi 2))

(define (try thunk)
  (guard (e ((error-object? e)
             (list 'caught (error-object-message e) (error-object-irritants e)))
            (#t (list 'raised-other e)))
    (thunk)))

(define (one a) a)

;; Never called: each body is mistyped, and none of it may stop the build.
(define (never-car) (car 5))
(define (never-vector) (vector-ref "s" 0))
(define (never-many) (one 1 2))
(define (never-fill) (vector-fill! 5 0))

;; Guarded, so the mistyped call never runs.
(write (let ((x #f)) (if x (car x) 0))) (newline)
(write (and-let* ((x #f) (y (car x))) y)) (newline)
(write (let ((n 'k)) (if (number? n) (+ (vector-length n) 1) 'not-a-number))) (newline)

;; Run: each raises, with the value as its irritant.
(write (try (lambda () (car 5)))) (newline)
(write (try (lambda () (let ((x #f)) (cdr x))))) (newline)
(write (try (lambda () (vector-ref (list 1 2) 0)))) (newline)
(write (try (lambda () (string-ref 5 0)))) (newline)
(write (try (lambda () (symbol->string "s")))) (newline)
(write (try (lambda () (char->integer 5)))) (newline)
(write (try (lambda () (list-tail '(1 2) 1.5)))) (newline)

;; A variadic procedure's fixed parameter too (these compiled, then crashed
;; or answered garbage).
(write (try (lambda () (vector->list 'a)))) (newline)
(write (try (lambda () (vector-fill! 5 0)))) (newline)
(write (try (lambda () (make-vector "a")))) (newline)
(write (try (lambda () (make-vector 2.5)))) (newline)
(write (try (lambda () (vector-copy "s")))) (newline)

;; Too many arguments to a known procedure.
(write (try (lambda () (one 1 2)))) (newline)
(write (try (lambda () (car '(1) '(2))))) (newline)

;; The well-typed calls beside them are unchanged.
(write (list (car '(1 2)) (make-vector 2 'z) (vector->list (vector 1 2) 1) (one 7))) (newline)
