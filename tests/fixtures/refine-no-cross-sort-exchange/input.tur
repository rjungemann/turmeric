;; refine-s3-cross-sort-exchange: Nelson-Oppen must not hand EUF an equality
;; between an Int term and a Real term.  LA reads `i = 0` and `acc = 0.0` as
;; `i = acc`; EUF then merged the class holding the Int constant 0 with the one
;; holding the Real constant 0.0 -- distinct constants, a conflict -- and S3
;; answered "valid" for `(> acc 0.0)`.  The return check was elided and `f`
;; returned 0.0 against its own refinement.  Found by the loop-invariant fuzz
;; population (an int counter beside a float accumulator); no loop is needed.
(defn f [i : int acc : float] : #refine{ r : float | (> r 0.0) }
  :pre (and (= i 0) (= acc 0.0))
  acc)

(defn main [] : int
  (println (f 0 0.0))
  0)
