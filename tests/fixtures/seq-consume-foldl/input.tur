; LZ3 fixture: seq/foldl -- left fold with initial accumulator.
; Sum [1,6) starting from 0 = 15.

(load "stdlib/seq/consume.tur")

(defn main [] : void
  ;; non-capturing fn auto-shimmed via seq/foldl's ^fat parameter
  (let [sum (fn [a b] (+ a b))]
    (println (seq/foldl 0 sum (seq/range 1 6)))))
