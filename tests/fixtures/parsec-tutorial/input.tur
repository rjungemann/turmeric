;; Pure-Turmeric parser-combinator tutorial companion fixture.
;;
;; Zero inline-C.  The tutorial's design uses closures for combinators; the
;; production parsec.tur uses fat-closures backed by inline-C.  For this
;; pure-Turmeric fixture we sidestep both:
;;
;;   * Input is a linked list of ints (character codes) rather than a cstr.
;;     This removes the only "must poke bytes" primitive so we don't need
;;     inline-C to read a character.
;;   * Parsers are ordinary (defn ...) functions that return (PRes A), where
;;     PRes is a defdata sum type carrying the leftover input.
;;   * Expr AST is a (defgadt Expr [a]) with ENum/EAdd/ESub/EMul/EDiv.
;;   * The arithmetic grammar `1+2*(3+4)` is hardcoded as its ASCII codes.

;; ---- Result: option-of-(value, remaining-list) ------------------------------
;;
;; A parse either succeeds (POK v rest) or fails (PFail).
;; rest is the leftover input list (:int carrier: 0 for end-of-input).

(defdata PRes [a]
  (PFail)
  (POK a :int))

;; ---- Char list helpers ------------------------------------------------------
;;
;; The input `1+2*(3+4)` is passed as a list of ASCII codes:
;;   49 43 50 42 40 51 43 52 41

(defn at-end?  [xs : int] : bool (= xs 0))

;; ---- Predicate: is-digit ----------------------------------------------------

(defn is-digit? [c : int] : bool
  (if (< c 48) false (if (> c 57) false true)))

;; ---- Expr AST (GADT) --------------------------------------------------------

(defgadt Expr [a]
  (ENum int                     : (Expr int))
  (EAdd (Expr int) (Expr int)   : (Expr int))
  (ESub (Expr int) (Expr int)   : (Expr int))
  (EMul (Expr int) (Expr int)   : (Expr int))
  (EDiv (Expr int) (Expr int)   : (Expr int)))

(defn apply-op [op : int lhs : Expr rhs : Expr] : Expr
  (if (= op 43) (EAdd lhs rhs)
    (if (= op 45) (ESub lhs rhs)
      (if (= op 42) (EMul lhs rhs)
        (if (= op 47) (EDiv lhs rhs)
          (ENum 0))))))

;; ---- Grammar ----------------------------------------------------------------
;;
;; expr   := term (('+' | '-') term)*
;; term   := factor (('*' | '/') factor)*
;; factor := number | '(' expr ')'
;; number := digit+

;; digits->int-loop: consume digits, accumulating into an int.  Always succeeds
;; (returns POK acc xs when the next char isn't a digit or we're at end).
(defn digits->int-loop [xs : int acc : int] : (PRes int)
  (if (at-end? xs)
    (POK acc xs)
    (let [c (list-head xs)]
      (if (is-digit? c)
        (digits->int-loop (list-tail xs) (+ (* acc 10) (- c 48)))
        (POK acc xs)))))

;; number: many1 digit -- require at least one digit.
(defn number [xs : int] : (PRes int)
  (if (at-end? xs)
    (:: (PFail) (PRes int))
    (let [c (list-head xs)]
      (if (is-digit? c)
        (digits->int-loop (list-tail xs) (- c 48))
        (:: (PFail) (PRes int))))))

;; factor := number -> ENum | '(' expr ')'.
(defn factor [xs : int] : (PRes Expr)
  (if (at-end? xs)
    (:: (PFail) (PRes Expr))
    (let [c (list-head xs)]
      (if (= c 40)
        (match (expr-parse (list-tail xs))
          (PFail)
          (:: (PFail) (PRes Expr))
          (POK inner rest)
          (if (at-end? rest)
            (:: (PFail) (PRes Expr))
            (if (= (list-head rest) 41)
              (:: (POK inner (list-tail rest)) (PRes Expr))
              (:: (PFail) (PRes Expr)))))
        (match (number xs)
          (PFail)
          (:: (PFail) (PRes Expr))
          (POK n rest)
          (POK (ENum n) rest))))))

;; term-tail: greedy left-associative fold of `('*'|'/') factor` tails.
(defn term-tail [xs : int lhs : Expr] : (PRes Expr)
  (if (at-end? xs)
    (POK lhs xs)
    (let [c (list-head xs)]
      (if (if (= c 42) true (= c 47))
        (match (factor (list-tail xs))
          (PFail)
          (:: (PFail) (PRes Expr))
          (POK rhs rest)
          (term-tail rest (apply-op c lhs rhs)))
        (POK lhs xs)))))

(defn term [xs : int] : (PRes Expr)
  (match (factor xs)
    (PFail)
    (:: (PFail) (PRes Expr))
    (POK lhs rest)
    (term-tail rest lhs)))

;; expr-tail: greedy left-associative fold of `('+'|'-') term` tails.
(defn expr-tail [xs : int lhs : Expr] : (PRes Expr)
  (if (at-end? xs)
    (POK lhs xs)
    (let [c (list-head xs)]
      (if (if (= c 43) true (= c 45))
        (match (term (list-tail xs))
          (PFail)
          (:: (PFail) (PRes Expr))
          (POK rhs rest)
          (expr-tail rest (apply-op c lhs rhs)))
        (POK lhs xs)))))

(defn expr-parse [xs : int] : (PRes Expr)
  (match (term xs)
    (PFail)
    (:: (PFail) (PRes Expr))
    (POK lhs rest)
    (expr-tail rest lhs)))

;; ---- Evaluator --------------------------------------------------------------

(defn eval-expr [e : Expr] : int
  (match e
    (ENum n)   n
    (EAdd l r) (+ (eval-expr l) (eval-expr r))
    (ESub l r) (- (eval-expr l) (eval-expr r))
    (EMul l r) (* (eval-expr l) (eval-expr r))
    (EDiv l r) (/ (eval-expr l) (eval-expr r))))

;; ---- Runner + main ----------------------------------------------------------

(defn main [] : int
  ;; "1+2*(3+4)" as ASCII codes
  (let [input (list 49 43 50 42 40 51 43 52 41)]
    (match (expr-parse input)
      (PFail)
      (do (println 0) 1)
      (POK ast rest)
      (do (println (eval-expr ast)) 0))))
