;; Pure-Turmeric parser-combinator tutorial companion fixture.
;;
;; Zero inline-C.  The grammar is expressed via higher-order combinators
;; (or-*, map-*, psat) that build closure-valued parsers.
;;
;;   * Input is a linked list of ints (character codes) rather than a cstr.
;;     This removes the only "must poke bytes" primitive so we don't need
;;     inline-C to read a character.
;;   * A parser is `(fn [xs : int] : (PRes A))` -- takes a list carrier,
;;     returns success + leftover or failure.
;;   * Expr AST is a `(defgadt Expr [a])` with ENum/EAdd/ESub/EMul/EDiv.
;;   * The arithmetic grammar `1+2*(3+4)` is hardcoded as its ASCII codes.
;;
;; The combinators are spelled monomorphically -- one instance per element
;; type (`or-int` / `or-expr`, `map-int-to-expr`).  Turmeric can already
;; write them polymorphically at elaboration time, but the codegen for a
;; polymorphic defn whose body returns an inner lambda hits an open bug
;; (see docs/archive/history/poly-defn-inner-lambda-codegen.md); the monomorphic
;; spellings compile end-to-end today and demonstrate the same shape.

;; ---- Result: success (value + leftover) or failure ---------------------------

(defdata PRes [a]
  (PFail)
  (POK a int))

;; ---- Expr AST (GADT) --------------------------------------------------------

(defgadt Expr [a]
  (ENum int                     : (Expr int))
  (EAdd (Expr int) (Expr int)   : (Expr int))
  (ESub (Expr int) (Expr int)   : (Expr int))
  (EMul (Expr int) (Expr int)   : (Expr int))
  (EDiv (Expr int) (Expr int)   : (Expr int)))

(defn apply-op [op : int lhs : Expr rhs : Expr] : Expr
  (if (= op #\+) (EAdd lhs rhs)
    (if (= op #\-) (ESub lhs rhs)
      (if (= op #\*) (EMul lhs rhs)
        (if (= op #\/) (EDiv lhs rhs)
          (ENum 0))))))

;; ---- Char-list helpers ------------------------------------------------------

(defn at-end?  [xs : int] : bool (= xs 0))

(defn is-digit? [c : int] : bool
  (if (< c #\0) false (if (> c #\9) false true)))

;; ---- Primitive: consume one char matching a predicate -----------------------

(defn psat [pred : (fn [int] bool)] : (fn [int] (PRes int))
  (fn [xs : int] : (PRes int)
    (if (at-end? xs)
      (PFail)
      (let [c (list-head xs)]
        (if (pred c) (POK c (list-tail xs)) (PFail))))))

(defn eq-char [target : int] : (fn [int] bool)
  (fn [c : int] : bool (= c target)))

(defn pchar [target : int] : (fn [int] (PRes int))
  (psat (eq-char target)))

;; ---- Combinators (monomorphic) ----------------------------------------------
;;
;; `or-*`  : Try p; if PFail, run q.
;; `map-*` : Run p; on success, transform the payload with f.

(defn or-int [p : (fn [int] (PRes int)) q : (fn [int] (PRes int))]
    : (fn [int] (PRes int))
  (fn [xs : int] : (PRes int)
    (match (p xs)
      (POK v rest) (POK v rest)
      (PFail)      (q xs))))

(defn or-expr [p : (fn [int] (PRes Expr)) q : (fn [int] (PRes Expr))]
    : (fn [int] (PRes Expr))
  (fn [xs : int] : (PRes Expr)
    (match (p xs)
      (POK v rest) (POK v rest)
      (PFail)      (q xs))))

(defn map-int-to-expr [f : (fn [int] Expr) p : (fn [int] (PRes int))]
    : (fn [int] (PRes Expr))
  (fn [xs : int] : (PRes Expr)
    (match (p xs)
      (PFail)      (PFail)
      (POK v rest) (POK (f v) rest))))

;; ---- Primitive parsers ------------------------------------------------------

(defn digit [xs : int] : (PRes int)
  ((psat is-digit?) xs))

;; Accumulate remaining digits into an int (many).  Always succeeds.
(defn digits-int-loop [xs : int acc : int] : (PRes int)
  (if (at-end? xs)
    (POK acc xs)
    (let [c (list-head xs)]
      (if (is-digit? c)
        (digits-int-loop (list-tail xs) (+ (* acc 10) (- c #\0)))
        (POK acc xs)))))

;; number: require at least one digit, then fold the rest.
(defn number [xs : int] : (PRes int)
  (match (digit xs)
    (PFail)      (PFail)
    (POK d rest) (digits-int-loop rest (- d #\0))))

;; ---- Grammar ----------------------------------------------------------------
;;
;; expr   := term (('+' | '-') term)*
;; term   := factor (('*' | '/') factor)*
;; factor := number | '(' expr ')'
;; number := digit+

;; Wrap the constructor as a first-class function value.
(defn to-enum [n : int] : Expr (ENum n))

(defn number-as-expr [xs : int] : (PRes Expr)
  ((map-int-to-expr to-enum number) xs))

;; Parenthesised expr: '(' expr ')'.  Named for use inside `factor` via
;; the `or-expr` combinator.
;;
;; The `(:: (POK inner (list-tail rest)) (PRes Expr))` ascription is
;; load-bearing because `expr-parse` is defined later in the file
;; (mutual recursion), so its parametric return type isn't visible when
;; `paren-expr` is elaborated; the match arm binder falls back to a
;; placeholder element type and the bare `(POK ...)` call needs a hint.
;; See docs/archive/history/defdata-parametric-forward-decl-inference.md.
(defn paren-expr [xs : int] : (PRes Expr)
  (if (at-end? xs)
    (PFail)
    (let [c (list-head xs)]
      (if (= c #\()
        (match (expr-parse (list-tail xs))
          (PFail)          (PFail)
          (POK inner rest)
          (if (at-end? rest)
            (PFail)
            (if (= (list-head rest) #\))
              (:: (POK inner (list-tail rest)) (PRes Expr))
              (PFail))))
        (PFail)))))

;; factor := paren-expr | number-as-expr
(defn factor [xs : int] : (PRes Expr)
  ((or-expr paren-expr number-as-expr) xs))

;; term-tail: greedy left-associative fold of `('*'|'/') factor` tails.
(defn term-tail [xs : int lhs : Expr] : (PRes Expr)
  (if (at-end? xs)
    (POK lhs xs)
    (let [c (list-head xs)]
      (if (if (= c #\*) true (= c #\/))
        (match (factor (list-tail xs))
          (PFail)          (PFail)
          (POK rhs rest)   (term-tail rest (apply-op c lhs rhs)))
        (POK lhs xs)))))

(defn term [xs : int] : (PRes Expr)
  (match (factor xs)
    (PFail)          (PFail)
    (POK lhs rest)   (term-tail rest lhs)))

;; expr-tail: greedy left-associative fold of `('+'|'-') term` tails.
(defn expr-tail [xs : int lhs : Expr] : (PRes Expr)
  (if (at-end? xs)
    (POK lhs xs)
    (let [c (list-head xs)]
      (if (if (= c #\+) true (= c #\-))
        (match (term (list-tail xs))
          (PFail)          (PFail)
          (POK rhs rest)   (expr-tail rest (apply-op c lhs rhs)))
        (POK lhs xs)))))

(defn expr-parse [xs : int] : (PRes Expr)
  (match (term xs)
    (PFail)          (PFail)
    (POK lhs rest)   (expr-tail rest lhs)))

;; ---- Evaluator --------------------------------------------------------------

(defn eval-expr [e : Expr] : int
  (match e
    (ENum n)   n
    (EAdd l r) (+ (eval-expr l) (eval-expr r))
    (ESub l r) (- (eval-expr l) (eval-expr r))
    (EMul l r) (* (eval-expr l) (eval-expr r))
    (EDiv l r) (/ (eval-expr l) (eval-expr r))))

;; ---- Runner + main ----------------------------------------------------------

(defn main [] : int
  ;; "1+2*(3+4)" as character literals
  (let [input (list #\1 #\+ #\2 #\* #\( #\3 #\+ #\4 #\))]
    (match (expr-parse input)
      (PFail)          (do (println 0) 1)
      (POK ast rest)   (do (println (eval-expr ast)) 0))))
