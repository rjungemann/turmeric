;; letrec-self-recursive-carrier-float-return -- W1 follow-on (float carrier).
;; The :float analogue of the struct/(Vec T) W1 case. A `:float` is an inline
;; carrier scalar, so the W1 override (which only fired for struct/app/ADT)
;; never reached it: a float-accumulator letrec self-call collapsed to the
;; int64 carrier, so `(go ...)` typed `int` and the `if` reported a spurious
;; `then=float else=int` branch mismatch. Forcing it past the type checker with
;; a `(:: ... :float)` ascription then produced an int->double union truncation
;; at the carrier-decode site, so it returned 0.0 at runtime. Both are fixed by
;; resolving `float` in the elab_letrec Pass A scalar peek (no ascription, no
;; corruption). This is the underlying defect behind linalg's la-vec-dot /
;; la-vec-norm returning 0 (turmeric-spices Track C).
(defn show [x : float] : void
  ```c
  printf("%.2f\n", x);
  ```)

(defn sum-floats [n : int] : float
  (letrec [go (fn [i : int  acc : float] : float
                (if (>= i n)
                  acc
                  (go (+ i 1) (+ acc 1.5))))]
    (go 0 0.0)))

(defn main [] : int
  (show (sum-floats 4))   ;; 4 * 1.5 = 6.00
  (show (sum-floats 0))   ;; 0.00
  0)
