;;
;; Phase P2: Lisp bindings from-vec/to-vec test

(import stdlib/hamt.tur)

(extern-c malloc [^int size] :ptr<void>)
(extern-c free [^ptr<void> p] :void)

(defn alloc-key [x]
  (let [p (malloc 8)]
    (ptr-set! (cast p :ptr<int>) 0 x)
    p))

;; Test: hamt/from-vec and hamt/to-vec round-trip
(defn test-from-to-vec [] :int
  (let [k1 (alloc-key 1)]
    (let [k2 (alloc-key 2)]
      (let [k3 (alloc-key 3)]
        (let [v1 (alloc-key 10)]
          (let [v2 (alloc-key 20)]
            (let [v3 (alloc-key 30)]
              (let [pairs (vec-new)]
                (vec-push! pairs (pair-new k1 v1))
                (vec-push! pairs (pair-new k2 v2))
                (vec-push! pairs (pair-new k3 v3))
                (let [m (hamt/from-vec pairs)]
                  (let [result-pairs (hamt/to-vec m)]
                    (let [count (vec-len result-pairs)]
                      (hamt/free m)
                      (free k1)
                      (free k2)
                      (free k3)
                      (free v1)
                      (free v2)
                      (free v3)
                      (free pairs)
                      (free result-pairs)
                      (if (= count 3) 1 0)))))))))))))
