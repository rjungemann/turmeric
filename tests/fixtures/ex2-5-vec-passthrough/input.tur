; Phase EX2-5: a function that accepts a Vec without knowing the size index
; must still be able to call sized-vec-len inside an open-vec block.
;
; describe-vec takes the size-erased Vec at the boundary, opens it to recover
; the underlying SizedVec under a fresh abstract n, and reports the length as
; an :int (which carries no phantom residue and so passes the escape check).
;
; This is the EX2-4 round-trip exercised across a function boundary -- the
; caller never sees the index, but the callee can still measure the vector.
(load "stdlib/sized.tur")
(load "stdlib/vec-existential.tur")

; The Vec arrives as :ptr<void> at the C-level ABI -- the size index is
; gone -- but we re-ascribe it to the existential type so open-vec can
; recover the underlying SizedVec under a fresh abstract n.
(defn describe-vec [v : ptr<void>] : int
  (let [vec (:: v (exists [n] (SizedVec n int)))]
    (open-vec vec n s
      (sized-vec-len s))))

(defn main [] : int
  ; The caller has no static knowledge of the length: each Vec is treated as
  ; the same opaque type at this call site.
  (let [a (vec-of-sized (SVCons 1 (SVNil)))]
    (let [b (vec-of-sized (SVCons 1 (SVCons 2 (SVNil))))]
      (let [c (vec-of-sized (SVCons 1 (SVCons 2 (SVCons 3 (SVCons 4 (SVNil))))))]
        (println (describe-vec a))
        (println (describe-vec b))
        (println (describe-vec c)))))
  0)
