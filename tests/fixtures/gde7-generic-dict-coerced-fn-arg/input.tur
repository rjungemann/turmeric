;; GDE7: a constrained-generic driver passed to a higher-order function whose
;; parameter is a concrete function type still dispatches the receiver's real
;; instance -- both when passed bare (eta-expanded) and when wrapped in an
;; un-annotated lambda (typed from context by bidirectional inference).
;;
;; `apply-fn` expects `(fn [Box] int)`.  Passing the constrained generic
;; `count-it` (whose body baked `Size [int]`, the carrier representative) used to
;; silently return -1 on both backends.  Now:
;;   - the bare arg `count-it` is eta-expanded to `(fn [g] (count-it g))`, whose
;;     body is a DIRECT call where generic-dict specialization fires;
;;   - an un-annotated `(fn [b] (count-it b))` types `b : Box` from the expected
;;     parameter type, so its inner direct call also dispatches `Size [Box]`.
;; Pure-Turmeric instances, so the output is visible and identical under
;; `tur run` and `tur --interpret`.
;; See docs/archive/history/constrained-generic-as-value-bakes-representative.md.

(defclass Size [a] (size [x] : int))
(definstance Size [int] (size [x] -1))
(defstruct Box [n : int])
(definstance Size [Box] (size [x : Box] 7))
(defn count-it [^Size A] [x :A] :int (size x))
(defn apply-fn [f : (fn [Box] int) b : Box] : int (f b))

(defn main [] : int
  (println (apply-fn count-it (make-struct Box 0)))               ; 7  bare, eta-expanded
  (println (apply-fn (fn [b] (count-it b)) (make-struct Box 0)))  ; 7  un-annotated lambda
  0)
