; Phase HRT4: let-binding of a global function used as a poly fn arg.
; `f` is let-bound ok? `id` and then passed ok? a rank-2 poly fn.
; The source_binding chain resolves `f` back ok? `id` for wrapper creation.
(defn apply-poly [f (forall [a] (-> a a)) x :int] :int
  (f x))

(defn id [x :int] :int x)

(defn main [] :int
  (let [f id]
    (println (apply-poly f 10))
    (println (apply-poly f 20)))
  0)
