;; fn-type-colon-deprecation -- a leading colon on a type inside a (fn ...)
;; type expression is deprecated (fn-type-bare-identifier-plan Phase 3).
;;
;; Position alone marks the param/result slots of a (fn ...) type as types,
;; so the colon is redundant.  The legacy spelling still compiles (lenient
;; transition path) but emits a TUR-D0001 deprecation warning -- promoted to
;; an error under --Werror=deprecated.
;;
;; This fixture pins that:
;;   - the legacy ':int' spelling warns (one TUR-D0001 per colon-typed slot),
;;   - the program still elaborates and runs.
;; The companion negative fixture errors/fn-type-colon-werror/ pins that
;; --Werror=deprecated turns the same warning into a hard error.

;; legacy: both the param type and the result type carry a redundant colon
(defn apply-legacy [f : (fn [:int] :int) x : int] : int
  (f x))

;; modern spelling -- no colons, no warning
(defn apply-modern [f : (fn [int] int) x : int] : int
  (f x))

(defn inc [x : int] : int
  (+ x 1))

(defn main [] : int
  (println (apply-legacy inc 20))
  (println (apply-modern inc 41))
  0)
