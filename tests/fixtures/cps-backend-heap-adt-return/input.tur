;; CPS-IR-to-C backend, N6: a colored function returning a heap-allocated ADT
;; handle must NOT be treated as a by-value boxed aggregate.  Built with
;; --enable=cps-backend.
;;
;; `(Vec int)` lowers to a heap handle (`tur_adt_Vec__int *`) -- already a pointer
;; (the int64 carrier), passed by pointer.  Its ADT def still has product *shape*
;; (`{ len; cap; data }`), so `type_is_byvalue_adt_product` reported true and
;; `slot_box_ty` wrongly classified it as a Tier C by-value product: `fn_sig_ok`
;; admitted the function, and the return crossing boxed/unboxed it --
;; `*(T**)__r; free(...)` -- double-indirecting the handle and freeing a non-box,
;; so the CPS path returned garbage (a `vec-len` of 0 instead of 1).
;;
;; Two things fixed this: (1) `slot_box_ty` excludes `type_is_heap_adt` /
;; `type_is_heap_struct` (a heap ADT is never a by-value product to box), and
;; (2) a heap ADT is instead admitted as a plain-cast int64 *carrier* handle
;; (`carrier_handle_ok`), crossing the slot by a `(T *)__r` cast -- so `mkvec`
;; now CPS-emits and returns the correct handle by move-out.  A heap handle is
;; still kept OUT of the capture gate (`cap_ty_ok`): a handle live across a
;; control op would be duplicated into a leaked, possibly multi-shot env, so such
;; a function still falls back.  Here `v` is produced inside the handle
;; continuation and returned (never captured), so it rides the subset cleanly.
;;
;; This fixture asserts the *value* is correct (1): if a heap ADT is ever boxed
;; (double-indirected) or mis-crossed, the output flips to 0.

(load "stdlib/vec.tur")

(defeffect E [] :int)

(defn g [] : int
  (perform (E)))

(defn mkvec [] : (Vec int)
  (let [n (handle (g) (E [] k) (resume k 3))]
    (let [v (vec-new)]
      (vec-push! v n)
      v)))

(defn main [] : int
  (println (vec-len (mkvec)))
  0)
