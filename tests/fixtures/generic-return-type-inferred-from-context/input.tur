;; Regression: a `(defn [A] [...] :A ...)` whose only `:A` slot is the *return
;; type* now picks up `A` from three caller contexts -- (:: e :T) ascription,
;; typed-`let [p : T (call)]` binding, and the enclosing defn's declared return
;; type -- so the call specializes at A = T instead of falling back to the
;; carrier int64 form and reinterpreting random bits.

(defstruct Pos [x : int y : int])

(defn make-default [A] [] : A
  ```c
  __TUR_TY_A__ v = {0};
  return v;
  ```)

(defn via-ascription [] : Pos
  (:: (make-default) :Pos))

(defn via-typed-binding [] : Pos
  (let [p : Pos (make-default)]
    p))

(defn via-return-type [] : Pos
  (make-default))

(defn main [] : int
  (let [a (via-ascription)
        b (via-typed-binding)
        c (via-return-type)]
    (println (.x a))
    (println (.x b))
    (println (.x c)))
  0)
