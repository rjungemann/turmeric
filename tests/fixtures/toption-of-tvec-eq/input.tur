;; Phase F3-5/F3-6: recursive `.eq?` on `Option[Vec[int]]` via
;; `toption-eq?` per-call-site synthesis.

(defn main [] :int
  (let [v1 (:: (tvec-new) (Vec int))
        v2 (:: (tvec-new) (Vec int))
        v3 (:: (tvec-new) (Vec int))]
    (tvec-push! v1 42)
    (tvec-push! v2 42)
    (tvec-push! v3 99)
    (let [o1 (:: (tsome v1) (Option (Vec int)))
          o2 (:: (tsome v2) (Option (Vec int)))
          o3 (:: (tsome v3) (Option (Vec int)))
          on (:: (tnone)    (Option (Vec int)))]
      (println (.eq? o1 o2))   ; true:  Some [42] vs Some [42]
      (println (.eq? o1 o3))   ; false: Some [42] vs Some [99]
      (println (.eq? o1 on)))) ; false: Some vs None
  0)
