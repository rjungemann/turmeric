;; U3 oracle: native cloneable with a CAPTURE-FREE LAMBDA receiver.
;; Backend: --enable=cps-backend (native, lambda receiver lifted to top-level fn)
;; The receiver `(fn [k : int] : int k)` captures nothing, so it is lifted to a
;; top-level fn; the cloneable-shift then calls it through the same indirect
;; fn-pointer form as a named receiver.  Emitted natively (no per-site closure).
;; (cloneable-reset (+ 10 (cloneable-shift (fn [k] k) 0)))
;; Multi-shot: clone+resume 5 -> 10+5 = 15, then resume 3 -> 13.
;;
(defn make [] : int
  (cloneable-reset (+ 10 (cloneable-shift (fn [k : int] : int k) 0))))
(defn main [] : int
  (let [c (make)]
    (println (tur_cloneable_cont_resume (tur_cloneable_cont_clone c) 5))
    (println (tur_cloneable_cont_resume c 3)))
  0)
