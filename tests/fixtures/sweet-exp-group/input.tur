#lang sweet-exp

;; SRFI-110 GROUP marker: leading `\\` (two backslashes) on a line
;; suppresses the implicit list-wrap, flattening that line's tokens and
;; its children into the parent's element list.  Three patterns:
;;
;;   1. `\\` alone with siblings at the same indent
;;   2. `\\` alone with children at a deeper indent
;;   3. `\\` followed by inline tokens

defn pattern-1 [] : int
  \\
  println("p1-a")
  println("p1-b")
  println("p1-c")
  0

defn pattern-2 [] : int
  \\
    println("p2-x")
    println("p2-y")
  0

defn pattern-3 [] : int
  \\ println("p3-q") println("p3-r")
  0

defn main [] : int
  pattern-1()
  pattern-2()
  pattern-3()
  0
