; Phase EX2-4: Vec[A] as (exists [n] (SizedVec n int)).
;
; Exercises the stdlib/vec-existential.tur macros that close Option B
; from typed-collections-plan.md:
;   - vec-of-sized: wraps any SizedVec into a size-hiding Vec
;   - open-vec:     binds [n sv] in the body, recovering the SizedVec
;                   under a fresh abstract size index
(load "stdlib/sized.tur")
(load "stdlib/vec-existential.tur")

(defn main [] : int
  ; Three-element vec: open and report the length.
  (let [v1 (vec-of-sized (SVCons 1 (SVCons 2 (SVCons 3 (SVNil)))))]
    (open-vec v1 n sv
      (println (sized-vec-len sv))))
  ; Two-element vec: open and report the sum.
  (let [v2 (vec-of-sized (SVCons 10 (SVCons 20 (SVNil))))]
    (open-vec v2 n sv
      (println (sized-vec-sum sv))))
  0)
