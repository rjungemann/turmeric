;; M8: httpd-mw-compose -- compose-middleware right-folds middlewares.
;;
;; Three mw-tag constructors produce three middleware closures. The plan
;; says compose-middleware applies them right-to-left so that the leftmost
;; in the argument list is the OUTERMOST wrapper:
;;
;;   (compose-middleware base outer middle inner)
;;   ==  (outer (middle (inner base)))
;;
;; That should print the same "onion" order as the H7 fixture:
;;   outer-pre
;;   middle-pre
;;   inner-pre
;;   base
;;   inner-post
;;   middle-post
;;   outer-post
;;   done

(load "stdlib/httpd.tur")
(load "stdlib/chan.tur")

(defn print-tag [tag : cstr] : nil
  ```c printf("%s\n", tag); ```)

(defn print-pre [tag : cstr] : nil
  ```c printf("%s-pre\n", tag); ```)

(defn print-post [tag : cstr] : nil
  ```c printf("%s-post\n", tag); ```)

(defn client-worker [arg : ptr<void>] : ptr<void>
  ```c
  #include <time.h>
  struct timespec ts = { 0, 30000000L };
  nanosleep(&ts, NULL);
  int64_t port = *(int64_t *)arg;
  free(arg);
  int fd = socket(AF_INET, SOCK_STREAM, 0);
  if (fd < 0) return NULL;
  struct sockaddr_in addr;
  memset(&addr, 0, sizeof(addr));
  addr.sin_family      = AF_INET;
  addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
  addr.sin_port        = htons((uint16_t)port);
  if (connect(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) { close(fd); return NULL; }
  const char *req = "GET / HTTP/1.0\r\n\r\n";
  send(fd, req, strlen(req), 0);
  char drain[256];
  recv(fd, drain, sizeof(drain), 0);
  close(fd);
  return NULL;
  ```)

(defn run-server [h : ptr<void>] : ptr<void>
  ```c httpd_hyrun(h); return NULL; ```)

(defn spawn-server [h : ptr<void>] : ptr<void>
  ```c
  pthread_t *t = (pthread_t *)malloc(sizeof(pthread_t));
  pthread_create(t, NULL, (void *(*)(void *))run_hyserver, (void *)h);
  return (void *)t;
  ```)

(defn spawn-client [port : int] : ptr<void>
  ```c
  int64_t *p = (int64_t *)malloc(sizeof(int64_t));
  *p = (int64_t)port;
  pthread_t *t = (pthread_t *)malloc(sizeof(pthread_t));
  pthread_create(t, NULL, (void *(*)(void *))client_hyworker, (void *)p);
  return (void *)t;
  ```)

(defn join-thread [t : ptr<void>] : nil
  ```c pthread_join(*(pthread_t *)t, NULL); free(t); ```)

;; Middleware constructor: captures a tag and a next handler.
(defn mw-tag [tag : cstr ^fat next : int] : ptr<void>
  (let [_t tag]
    (fn [conn : ptr<void>] : nil
      (print-pre _t)
      (httpd-call next conn)
      (print-post _t))))

;; Each named middleware is a one-arg defn that returns a wrapped handler.
;; compose-middleware expands `(compose-middleware base mw-outer mw-mid mw-inner)`
;; to `(mw-outer (mw-mid (mw-inner base)))`, so the defns are called directly.
(defn mw-outer [n : int] : ptr<void> (mw-tag "outer"  n))
(defn mw-mid   [n : int] : ptr<void> (mw-tag "middle" n))
(defn mw-inner [n : int] : ptr<void> (mw-tag "inner"  n))

(defn main [] : int
  (let [donech   (chan-new 1)
        base     (fn [conn : ptr<void>] : nil
                   (print-tag "base")
                   (httpd-resp-status! conn 200)
                   (httpd-resp-body! conn "ok")
                   (chan-send donech 1))
        composed (compose-middleware base mw-outer mw-mid mw-inner)
        h        (httpd-new-pool 0 1 composed)
        port     (httpd-port h)
        server   (spawn-server h)
        client   (spawn-client port)]
    (chan-recv donech)
    (httpd-stop h)
    (join-thread server)
    (join-thread client)
    (println "done")
    (httpd-free h)
    (chan-free donech)
    0))
