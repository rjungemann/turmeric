;; any-narrowing-broken-for-parametric-receivers: the round trip through `any`
;; for a PARAMETRIC payload.  Widening an (Option float) interns its box id by
;; the per-instantiation key, so an `is?` / `cast` target written as a bare
;; `Option` resolved to the head -- a different key, an id no widen ever mints.
;; `(is? x Option)` was silently false and `(cast x Option)` panicked with
;; "cast: any holds Option, not Option".
;;
;; Both now take the APPLIED target, which resolves to the same TY_APP the
;; widen interned.  This is the type-case idiom on an HKT receiver: test, then
;; narrow, then use the typeclass method -- previously unreachable from `any`.
;;
;; 7.1, not 7.0: a float payload rides the box as its IEEE-754 bit pattern, so
;; an integral literal could not show a botched reinterpret on the way back.
(defn boxed [] : any (Some 7.1))

(defn dyn-double [x : any] : float
  (if (is? x (Option float))
    (unwrap-or (fmap (cast x (Option float))
                     (fn [v : float] : float (* v 2.0)))
               0.0)
    0.0))

(defn main [] : int
  (println (if (is? (boxed) (Option float)) 1 0))
  (println (unwrap-or (cast (boxed) (Option float)) 0.0))
  (println (dyn-double (boxed)))
  0)
