;; TY5: Multi-capture closures in HKT contexts -- no manual cast required.
;;
;; Before TY5, passing a capturing closure (fat struct, TY_PTR_VOID) to an
;; HKT method required a manual helper (__fmap_option_clos) that explicitly
;; used the fat-closure calling convention.  This fixture verifies that a
;; multi-capture closure is correctly passed to and invoked through an HKT
;; typeclass method using the :fn parameter type and tur_poly_fn_t protocol.

(defclass TestFunctor [^f]
  (fmap [container [fn :fn]] : int))

;; Option helpers
(defn __opt_some [x] : int
  ```c
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn __opt_none [] : int ```c return 0; ```)

(defn __opt_some? [o] : bool
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return p != 0 && p->is_some;
  ```)

(defn __opt_unwrap [o] : int
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return (int)(p->value);
  ```)

(definstance TestFunctor [option]
  (fmap [container fn]
    ```c
    struct { bool is_some; int64_t value; } *c =
        (void *)(intptr_t)container;
    if (!c || !c->is_some) return 0;
    struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
    r->is_some = true;
    r->value = fn.fn(fn.env, c->value);
    return (int64_t)(intptr_t)r;
    ```))

(defn main [] : int
  (do
    ;; T1: two-variable capture: (fn [x] (+ (* x a) b)) where a=3, b=7.
    ;; Applied to (some 4) => some 19.
    (let [a 3]
      (let [b 7]
        (let [result (.fmap (__opt_some 4) (fn [x] (+ (* x a) b)))]
          (do
            (println (__opt_some? result))    ;; true
            (println (__opt_unwrap result)))))) ;; 19

    ;; T2: three-variable capture: (fn [x] (+ x (+ p (+ q r)))).
    ;; Applied to (some 10) where p=1, q=2, r=3 => some 16.
    (let [p 1]
      (let [q 2]
        (let [r 3]
          (let [result (.fmap (__opt_some 10) (fn [x] (+ x (+ p (+ q r)))))]
            (do
              (println (__opt_some? result))    ;; true
              (println (__opt_unwrap result))))))) ;; 16

    ;; T3: none propagates -- closure never called.
    (let [a 3]
      (let [b 7]
        (println (__opt_some? (.fmap (__opt_none) (fn [x] (+ (* x a) b)))))))  ;; false

    ;; T4: chained fmap with captures.
    ;; First: (fn [x] (* x scale)) where scale=2 applied to (some 3) => (some 6).
    ;; Second: (fn [x] (+ x offset)) where offset=10 applied to (some 6) => (some 16).
    (let [scale 2]
      (let [offset 10]
        (let [r2 (.fmap (.fmap (__opt_some 3) (fn [x] (* x scale)))
                        (fn [x] (+ x offset)))]
          (do
            (println (__opt_some? r2))    ;; true
            (println (__opt_unwrap r2))))))  ;; 16
    0))
