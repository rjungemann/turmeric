;; SS8: session-mp-effects -- multi-party session channels and algebraic effects coexist.
;;
;; A MpLog effect is declared for logging. Role A sends a value to B while
;; performing log effects; the handler intercepts MpLog and prints the message.
;;
;; NOTE -- permanent fiber client (NOT a CPS/DK migration target).  This program
;; performs AND handles a real algebraic effect (MpLog) entirely on the fiber
;; effect runtime, and stays there BY DESIGN: `main` is anchored by inline-C (raw
;; pthread spawn/join + inline-C session channel ops), so its body is
;; SIG-INLINE-C and can never thread a DK continuation; the role parameter is
;; TY_ROLE (SIG-REJECT).  The pthread + inline-C session/channel runtime is a
;; SEPARATE concurrency subsystem from the delimited-continuation DK effect
;; machine.  Do not attempt to CPS-admit it -- even admitting the role param only
;; reclassifies `role-a` SIG-REJECT -> SIG-TAINT off `main`'s permanent handling.
;; Analysis + decision: docs/archive/
;; cps-session-effects-permanently-fiber-bound.md.  Correct on the fiber today.

(load "stdlib/session.tur")

(defprotocol Echo [A B]
  (-> A B int)
  (-> B A int))

(defeffect MpLog [msg :cstr] :nil)

(defn role-a [^linear ch :(Role Echo A) val : int] : int
  (perform (MpLog "sending 99"))
  (let [ch (send-to ch B val)]
    (let [[result ch] (recv-from ch B)]
      (perform (MpLog "received 99"))
      (close ch)
      result)))

(defn role-b [^linear ch :(Role Echo B)] : nil
  (let [[v ch] (recv-from ch A)]
    (let [ch (send-to ch A v)]
      (close ch))))

(defn main [] : int
  (let [[ra rb] (make-protocol Echo)]
    (let [t (session-spawn (fn [] (role-b rb)))]
      (let [result
            (handle (role-a ra 99)
              (MpLog [msg] k) (do (println msg) (resume k nil)))]
        (println result)
        (session-join t))))
  0)
