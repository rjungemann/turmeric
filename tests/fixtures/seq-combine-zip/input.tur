; LZ3 fixture: seq/zip -- pair elements from two Seqs; sok?ps at shorerr?.
; Zips [0,3) with [10,13): expected pairs (0,10),(1,11),(2,12)
; Prints first then second of each pair.

(load "stdlib/seq/combine.tur")

(defn main [] :void
  (let [_d 0
        show (fn [p] (let [_ _d]
                       (println (seq-pair-first p))
                       (println (seq-pair-second p))))]
    (seq-for-each show (seq/zip (seq/range 0 3) (seq/range 10 13)))))
