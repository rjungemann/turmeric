; Phase G4: Test GADT-based GVec from stdlib/gadt-vec.tur.
; Exercises the public functions: gvec-nil, gvec-cons, gvec-len, gvec-sum,
; gvec-head-or, gvec-tail, and gvmap.
; Note: gvzip-with requires a 2-arg ptr<void> call which is not yet supported.

(load "stdlib/gadt-vec.tur")

; Helper function used by gvmap.
(defn mul [a :int b :int] :int (* a b))

(defn main [] :int
  ; gvec-len of empty = 0
  (println (gvec-len (gvec-nil)))
  ; gvec-len of [1,2,3] = 3
  (println (gvec-len (gvec-cons 1 (gvec-cons 2 (gvec-cons 3 (gvec-nil))))))
  ; gvec-sum of [1,2,3] = 6
  (println (gvec-sum (gvec-cons 1 (gvec-cons 2 (gvec-cons 3 (gvec-nil))))))
  ; head-or 99 of [] = 99
  (println (gvec-head-or 99 (gvec-nil)))
  ; head-or 99 of [5,6] = 5
  (println (gvec-head-or 99 (gvec-cons 5 (gvec-cons 6 (gvec-nil)))))
  ; tail of [1,2,3] has len 2
  (println (gvec-len (gvec-tail (gvec-cons 1 (gvec-cons 2 (gvec-cons 3 (gvec-nil)))))))
  ; gvmap (*2) [1,2,3] sums to 12
  (println (gvec-sum (gvmap (mul 2) (gvec-cons 1 (gvec-cons 2 (gvec-cons 3 (gvec-nil)))))))
  0)
