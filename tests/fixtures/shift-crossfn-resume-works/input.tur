;; Cross-function RESUME on the plain shift/reset surface (cps-backend-n6).  A
;; resuming `shift` whose delimiting `reset` is in a CALLER used to raise
;; TUR-E0016; it now auto-desugars onto the synthetic __Shift effect:
;;
;;   (shift RECV BODY)  ->  (perform (__Shift RECV'))     ; RECV' resumes via effect
;;   (reset BODY)       ->  (reset (handle BODY (__Shift [recv] ^multishot k) (recv k)))
;;
;; RECV's `cont` param is reflavored to `multishot-effect-cont` (CONT_EFFECT +
;; CK_MULTISHOT), so `(k v)` inside it resumes the delimited continuation the
;; caller's reset captured -- snapshotting before each resume, so a receiver may
;; invoke `k` any number of times.  The reset-wrapping is a gated whole-program
;; pass -- a program with no such shift is byte-for-byte unchanged.
;; direct == cps == turi.

;; --- non-capturing receiver, single resume: shift in a callee, reset in a caller ---
(defn inner [] : int (shift (fn [k : cont] : int (k 1)) 0))
(defn outer [] : int (reset (+ 10 (inner))))   ; k = (+ 10 []); (k 1) = 11

;; --- capturing receiver, single resume: closes over the shift's local `base` ---
(defn step [base : int] : int
  (shift (fn [k : cont] : int (k base)) 0))
(defn run [] : int (reset (+ 100 (step 5))))    ; k = (+ 100 []); (k 5) = 105

;; --- multi-shot receiver: resumes k twice (the plan's opening example) ---
(defn twice [] : int (shift (fn [k : cont] : int (+ (k 1) (k 2))) 0))
(defn sum2 [] : int (reset (+ 10 (twice))))     ; (10+1) + (10+2) = 23

;; --- multi-shot receiver: resumes k three times ---
(defn thrice [] : int
  (shift (fn [k : cont] : int (+ (+ (k 1) (k 2)) (k 3))) 0))
(defn sum3 [] : int (reset (+ 100 (thrice))))   ; 101 + 102 + 103 = 306

(defn main [] : int
  (println (outer))   ; 11
  (println (run))     ; 105
  (println (sum2))    ; 23
  (println (sum3))    ; 306
  0)
