;; U4 oracle: NATIVE serial CALL-frame context in a colored helper.
;; Backend: --enable=cps-backend (native serial call frame: _skcall wrapper + SkReg registry)
;; A 1-arg call frame (dbl []) in a serial context needs the per-site SkReg
;; marshaling registry so the frame maps to a stable name ("dbl$L") across a
;; serialize/deserialize.  Under --enable=cps-backend the colored helper emits
;; this natively: a _skcall wrapper + a _skreg SkReg self-registered by a
;; constructor, alongside arithmetic frames on the shared tagged marshaler.
;; rt5 forces a real serialize -> bytes -> deserialize round-trip.
;;   run-a: (serial-reset (dbl (serial-shift rt5 0)))          -> dbl(5)      = 10
;;   run-b: (serial-reset (+ 100 (dbl (serial-shift rt5 0))))  -> 100+dbl(5)  = 110
;;   run-c: (serial-reset (dbl (+ 1 (serial-shift rt5 0))))    -> dbl(1+5)    = 12
;;
(defn dbl [x : int] : int (* x 2))
(defn rt5 [k] : int
  (tur_serial_cont_resume
    (tur_serial_cont_deserialize (tur_serial_cont_serialize k)) 5))
(defn run-a [] : int (serial-reset (dbl (serial-shift rt5 0))))
(defn run-b [] : int (serial-reset (+ 100 (dbl (serial-shift rt5 0)))))
(defn run-c [] : int (serial-reset (dbl (+ 1 (serial-shift rt5 0)))))
(defn main [] : int
  (println (run-a))
  (println (run-b))
  (println (run-c))
  0)
