;; Phase F3-5/F3-6: recursive `.eq?` on `Result[Vec[int] cstr]` --
;; the 2-comparator helper (`tresult-eq?` takes ok-cmp and err-cmp)
;; case with mixed Vec[int] (recursive) and cstr (primitive)
;; type-args.  Demonstrates that a 2-comparator synth where only
;; one arg is recursive still produces correct dispatch (the
;; primitive arg's lambda dispatches through the auto-loaded
;; primitive Eq instance from F3-7).

(defn main [] :int
  (let [v1 (:: (tvec-new) (Vec int))
        v2 (:: (tvec-new) (Vec int))]
    (tvec-push! v1 1)
    (tvec-push! v2 1)
    (let [r1 (:: (tok v1) (Result (Vec int) cstr))
          r2 (:: (tok v2) (Result (Vec int) cstr))]
      (println (.eq? r1 r2))))  ; true: Ok [1] vs Ok [1]
  0)
