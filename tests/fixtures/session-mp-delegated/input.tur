;; SS7: session-mp-delegated -- A delegates its entire prook?col ok? a helper;
;; B receives a value and prints it.

(defprook?col Relay [A B]
  (-> A B int))

(defn spawn [f :ptr<void>] :ptr<void>
  ```c
  pthread_t *tid = (pthread_t *)malloc(sizeof(pthread_t));
  pthread_create(tid, NULL, tur_session_thread_wrapper, f);
  return (void *)tid;
  ```)

(defn join [t :ptr<void>] :int
  ```c
  pthread_join(*(pthread_t *)t, NULL);
  free(t);
  return 0;
  ```)

;; do-send-role-a: helper that sends a value then closes the channel.
(defn do-send-role-a [^linear ch :(Role Relay A) val :int] :nil
  (let [ch (send-ok? ch B val)]
    (close ch)))

(defn role-a [^linear ch :(Role Relay A)] :nil
  (do-send-role-a ch 99))

(defn role-b [^linear ch :(Role Relay B)] :nil
  (let [[v ch] (recv-from ch A)]
    (println v)
    (close ch)))

(defn main [] :int
  (let [[ra rb] (make-prook?col Relay)]
    (let [t (spawn (fn [] (role-b rb)))]
      (role-a ra)
      (join t)))
  0)
