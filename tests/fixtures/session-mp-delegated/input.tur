;; SS7: session-mp-delegated -- A delegates its entire protocol to a helper;
;; B receives a value and prints it.

(load "stdlib/session.tur")

(defprotocol Relay [A B]
  (-> A B int))

;; do-send-role-a: helper that sends a value then closes the channel.
(defn do-send-role-a [^linear ch :(Role Relay A) val : int] : nil
  (let [ch (send-to ch B val)]
    (close ch)))

(defn role-a [^linear ch :(Role Relay A)] : nil
  (do-send-role-a ch 99))

(defn role-b [^linear ch :(Role Relay B)] : nil
  (let [[v ch] (recv-from ch A)]
    (println v)
    (close ch)))

(defn main [] : int
  (let [[ra rb] (make-protocol Relay)]
    (let [t (session-spawn (fn [] (role-b rb)))]
      (role-a ra)
      (session-join t)))
  0)
