#lang r7rs
;; r7rs-lang-plan T5: a continuation can be invoked after its call/cc has
;; returned -- the call/cc returns again, with the new value.  Each top-level
;; form is delimited (r7rs-toplevel-reentry-reruns-forms): re-entering the
;; display form from the `if` finishes that form and then continues after
;; the `if`, so the program ends on its own, with count still 1 and no
;; newline between the re-entered display and what follows it.
;; (Until T5 this was the named error "continuation invoked after its
;; call/cc prompt returned".)
(define saved #f)
(define count 0)
(display (call/cc (lambda (k) (set! saved k) 1))) (newline)
(set! count (+ count 1))
(if (< count 3) (saved (* 10 count)))
(display " done after ") (display count) (display " entries") (newline)
