;; TY5 regression: single-capture closures in HKT contexts are unaffected.
;;
;; Verifies that the TY5 fix (multi-capture closures via :fn param) does not
;; break the single-capture case or the no-capture (named function) case.

(defclass TestFunctor [^f]
  (fmap [container [fn :fn]] : int))

;; Option helpers
(defn __opt_some [x] : int
  ```c
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn __opt_none [] : int ```c return 0; ```)

(defn __opt_some? [o] : bool
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return p != 0 && p->is_some;
  ```)

(defn __opt_unwrap [o] : int
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return (int)(p->value);
  ```)

(definstance TestFunctor [option]
  (fmap [container fn]
    ```c
    struct { bool is_some; int64_t value; } *c =
        (void *)(intptr_t)container;
    if (!c || !c->is_some) return 0;
    struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
    r->is_some = true;
    r->value = fn.fn(fn.env, c->value);
    return (int64_t)(intptr_t)r;
    ```))

;; Named function (no capture)
(defn __inc [x] : int (+ x 1))

(defn main [] : int
  (do
    ;; T1: no capture -- named function, raw function-pointer path.
    (let [result (.fmap (__opt_some 41) __inc)]
      (do
        (println (__opt_some? result))   ;; true
        (println (__opt_unwrap result)))) ;; 42

    ;; T2: single capture: (fn [x] (+ x delta)) where delta=100.
    (let [delta 100]
      (let [result (.fmap (__opt_some 23) (fn [x] (+ x delta)))]
        (do
          (println (__opt_some? result))   ;; true
          (println (__opt_unwrap result))))) ;; 123

    ;; T3: single capture, none propagates.
    (let [delta 100]
      (println (__opt_some? (.fmap (__opt_none) (fn [x] (+ x delta))))))  ;; false

    0))
