;; RT: return-type-directed typeclass dispatch, independent of schema.
;; `default-of` puts its dispatch type variable only in the return position,
;; so the concrete instance is selected from the ascribed expected type
;; rather than from any argument.
(defclass Default [a]
  (default-of [] : a))

(definstance Default [int]
  (default-of [] 42))

(definstance Default [bool]
  (default-of [] true))

(defn main [] : int
  (let [i (:: (default-of) int)
        b (:: (default-of) bool)]
    (println i)
    (println b))
  0)
