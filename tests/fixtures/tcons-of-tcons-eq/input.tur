;; Phase F3-5/F3-6 (cross-plan-followups): recursive `.eq?` on
;; `Cons[Cons[int]]` via `list-eq?` per-call-site synthesis.

(defn main [] :int
  (let [a (:: (tcons 1 (tcons 2 0)) (Cons int))
        b (:: (tcons 1 (tcons 2 0)) (Cons int))
        c (:: (tcons 9 0) (Cons int))]
    (let [ouerr?1 (:: (tcons a 0) (Cons (Cons int)))
          ouerr?2 (:: (tcons b 0) (Cons (Cons int)))
          ouerr?3 (:: (tcons c 0) (Cons (Cons int)))]
      (println (.eq? ouerr?1 ouerr?2))   ; true  ([[1 2]] vs [[1 2]])
      (println (.eq? ouerr?1 ouerr?3))))  ; false ([[1 2]] vs [[9]])
  0)
