;; RT0 graduation compatibility promise (2026-08-01): `refined` graduated, so
;; its EXPERIMENTS[] row is gone -- but a downstream `build.tur`,
;; `~/.config/turmeric/experiments.tur`, or CLI invocation that still names it
;; must keep compiling.  `GRADUATED[]` in src/runtime/experiments.c is what
;; makes `--enable=refined` a TUR-W0063 no-op instead of the hard TUR-E0310 an
;; unknown experiment name gets.
;;
;; Without this fixture graduation is a breaking change for exactly the people
;; who adopted the feature deliberately, which is the wrong population to
;; break.  The flag is in `flags`; the warning is asserted on stderr and the
;; program still runs, with discharge on (it is unconditional now).
;;
;; The sibling `refine-graduated-lang-layer-noop` pins the same promise for the
;; `#lang turmeric refined` spelling (TUR-W0064, GRADUATED_LAYERS[]).
(defn shift-up [x : #refine{ v : int | (>= v 3) }] : #refine{ r : int | (> r 0) }
  (- x 2))

(defn main [] : int
  (println (shift-up 3))
  (println "refine-graduated-enable-noop")
  0)
