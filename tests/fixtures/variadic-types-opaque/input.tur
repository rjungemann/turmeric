;; variadic-types-opaque -- :Route rest (defopaque) accepts Route args.
;;
;; Before the typed-variadic fix, a user-defined rest type silently degraded to
;; :int.  Now :Route resolves to its full opaque type and Route args are
;; accepted by identity.

(defopaque Route :int)

(defn cons-list-len [lst :int] #{Unsafe} :int
  ```c
  typedef struct { int64_t head; int64_t tail; } __tur_cons_cell;
  int64_t n = 0;
  __tur_cons_cell *p = (__tur_cons_cell *)(intptr_t)lst;
  while (p) { n++; p = (__tur_cons_cell *)(intptr_t)p->tail; }
  return (int)n;
  ```)

(defn mk-route [tag :int] :Route tag)

(defn count-routes [& items :Route] #{Unsafe} :int
  (cons-list-len items))

(defn main [] :int
  (unsafe
    (let [n (count-routes (mk-route 1) (mk-route 2) (mk-route 3))]
      (if (= n 3) 0 1))))
