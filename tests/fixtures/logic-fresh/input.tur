;; Phase B4: Logic programming -- fresh creates a new logic variable.
;; (fresh f) calls f with a new var; f returns a goal.
;; Uses the pure-Turmeric stdlib/logic.tur engine (no inline-C).

(load "stdlib/logic.tur")

(defn main [] : int
  (let [results (run-logic 1 (fresh (fn [x] (lequal x (term-int 99)))))]
    (println (bt-length results))
    0))
