;; TUR-W0043: an async body that spells a session op on endpoints it makes
;; ITSELF still warns on the compiled path.
;;
;; A body that captures an endpoint no longer warns: it runs on its own OS
;; thread (compiled-async-fiber-deadlocks-on-a-session-op; see
;; session-async-peer-on-thread).  A body that makes both endpoints has both
;; ends of the protocol in one straight-line body, and a thread does not help
;; that -- unless, as here, it hands one end to a peer on another thread.
;; The warning cannot tell the two apart, so it warns, and names
;; session-spawn.  Under --interpret the rendezvous is cooperative and no
;; warning is emitted.
;;
;; Expected output: 42
(load "stdlib/session.tur")

(defn main [] : int
  (let [t (async (fn []
                   (let [[s r] (make-session (Send int Close))]
                     (let [peer (session-spawn (fn []
                                                 (let [s (send s 42)]
                                                   (close s))))]
                       (let [[n r] (recv r)]
                         (println n)
                         (close r)
                         (session-join peer))))))]
    (await t))
  0)
