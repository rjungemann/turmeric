;; loop-invariants-plan LI0: with the `loop-invariants` gate OFF the
;; annotation still parses (and is validated as a pure bool), but nothing acts
;; on it -- no runtime check, no obligation, no diagnostic.  The invariant here
;; is false from the first iteration on, and the program runs to completion.
(defn f [n : int] : int
  (let [^mut i 0]
    (while (< i n) :invariant (< i 2)
      (set! i (+ i 1)))
    i))

(defn main [] : int
  (println (f 5))
  0)
