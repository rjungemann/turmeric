; LZ4 fixture: range-span -- smallest range enclosing both (convex hull).

(load "stdlib/range.tur")

(defn main [] :void
  ; span of [1,3] and [5,8] = [1,8]
  (let [sp (range-span (closed-range 1 3) (closed-range 5 8))]
    (println (range-bound-inclusive? (range-lower sp)))  ; true
    (println (range-bound-value      (range-lower sp)))  ; 1
    (println (range-bound-inclusive? (range-upper sp)))  ; true
    (println (range-bound-value      (range-upper sp)))) ; 8
  ; span of [2,5) and [3,8] = [2,8]  (picks wider bounds)
  (let [sp (range-span (closed-open-range 2 5) (closed-range 3 8))]
    (println (range-bound-value (range-lower sp)))  ; 2
    (println (range-bound-value (range-upper sp)))) ; 8
  ; span with unbounded: [1,3] and [5,+inf) = [1,+inf)
  (let [sp (range-span (closed-range 1 3) (at-least-range 5))]
    (println (range-bound-value (range-lower sp)))  ; 1
    (println (unbounded-above? sp))))               ; true
