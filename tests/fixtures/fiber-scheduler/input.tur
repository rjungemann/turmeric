;; Phase T21-D: fiber-scheduler — three fibers cooperatively print values.
;;
;; Scheduler: a simple ring-buffer queue of FiberBlock pointers.
;; Three fibers A, B, C each yield two values then finish.
;; The scheduler runs them in round-robin (FIFO) order.
;;
;; Expected output:
;;   A1
;;   B1
;;   C1
;;   A2
;;   B2
;;   C2
;;   done

;; ---- FiberBlock wrappers ----

(defn fiber-new-fn [fn :ptr<void> stack-size :int] :ptr<void>
  ```c
  return (void *)tur_fiber_block_new((void(*)(void))fn, (size_t)stack_size);
  ```)

(defn fiber-resume-fn [f :ptr<void>] :int
  ```c
  return tur_fiber_block_resume((FiberBlock *)f, 0);
  ```)

(defn fiber-done? [f :ptr<void>] :bool
  ```c
  return ((FiberBlock *)f)->done != 0;
  ```)

(defn fiber-free-fn [f :ptr<void>] :nil
  ```c
  tur_fiber_block_free((FiberBlock *)f);
  ```)

;; ---- Simple FIFO queue (circular buffer of void* pointers, cap 16) ----

(defn sched-new [] :ptr<void>
  ```c
  typedef struct { void *fibers[16]; int head; int tail; int count; } SchedQ;
  SchedQ *q = (SchedQ *)calloc(1, sizeof(SchedQ));
  if (!q) abort();
  return (void *)q;
  ```)

(defn sched-push [q :ptr<void> f :ptr<void>] :nil
  ```c
  typedef struct { void *fibers[16]; int head; int tail; int count; } SchedQ;
  SchedQ *sq = (SchedQ *)q;
  if (sq->count >= 16) { fprintf(stderr, "sched: full\n"); abort(); }
  sq->fibers[sq->tail] = f;
  sq->tail = (sq->tail + 1) % 16;
  sq->count++;
  ```)

(defn sched-pop [q :ptr<void>] :ptr<void>
  ```c
  typedef struct { void *fibers[16]; int head; int tail; int count; } SchedQ;
  SchedQ *sq = (SchedQ *)q;
  if (sq->count == 0) return NULL;
  void *f = sq->fibers[sq->head];
  sq->head = (sq->head + 1) % 16;
  sq->count--;
  return f;
  ```)

(defn sched-empty? [q :ptr<void>] :bool
  ```c
  typedef struct { void *fibers[16]; int head; int tail; int count; } SchedQ;
  return ((SchedQ *)q)->count == 0;
  ```)

(defn sched-free [q :ptr<void>] :nil
  ```c
  free(q);
  ```)

;; ---- Run scheduler to completion ----

(defn sched-run [q :ptr<void>] :nil
  ```c
  typedef struct { void *fibers[16]; int head; int tail; int count; } SchedQ;
  SchedQ *sq = (SchedQ *)q;
  while (sq->count > 0) {
      void *f = sq->fibers[sq->head];
      sq->head = (sq->head + 1) % 16;
      sq->count--;
      tur_fiber_block_resume((FiberBlock *)f, 0);
      if (!((FiberBlock *)f)->done)
          { /* re-enqueue */ sq->fibers[sq->tail] = f; sq->tail = (sq->tail+1)%16; sq->count++; }
      else
          tur_fiber_block_free((FiberBlock *)f);
  }
  ```)

;; ---- Fiber bodies (yield label then return) ----

(defn fiber-a [] :nil
  ```c
  puts("A1"); tur_fiber_block_yield(0);
  puts("A2"); tur_fiber_block_yield(0);
  ```)

(defn fiber-b [] :nil
  ```c
  puts("B1"); tur_fiber_block_yield(0);
  puts("B2"); tur_fiber_block_yield(0);
  ```)

(defn fiber-c [] :nil
  ```c
  puts("C1"); tur_fiber_block_yield(0);
  puts("C2"); tur_fiber_block_yield(0);
  ```)

(defn main [] :int
  (let [q (sched-new)]
    (sched-push q (fiber-new-fn fiber-a 0))
    (sched-push q (fiber-new-fn fiber-b 0))
    (sched-push q (fiber-new-fn fiber-c 0))
    (sched-run q)
    (sched-free q)
    (println "done")
    0))
