;; U5 oracle: async/await in a COLORED function (placement, not eviction).
;; `worker` is colored by the reset/shift AND also awaits a spawned future.
;; Before U5 the whole function evicted to direct emit (EX_ASYNC/EX_AWAIT hit
;; CT_UNSUPPORTED).  U5 makes async/await delegatable via CT_LETRAW -- they are
;; self-contained runtime calls (tur_async_fiber / tur_await_future) that do not
;; thread the caller's DK continuation -- so the reset/shift stays on the CT-IR
;; DK machine while the async region delegates to the proven fiber runtime.
;;   worker: (reset (shift (fn [k] k) 8)) + (await (async compute)) = 8 + 42 = 50
;;
(defn compute [] : int
  ```c
  return (int64_t)42;
  ```)
(defn worker [] : int
  (+ (reset (shift (fn [k : int] : int k) 8))
     (await (async compute))))
(defn main [] : int
  (println (worker))
  0)
