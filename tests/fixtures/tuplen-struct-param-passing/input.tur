;; Regression for the TupleN (N>=3) by-parameter ABI bug
;; (docs/archive/history/tuplen-struct-param-passed-by-pointer-codegen-mismatch.md):
;; structs > 16 bytes are passed to user defns by pointer (const T*), but
;; ABI-specialized accessors and inline-C callees take them BY VALUE. The
;; call site must deref the pbp-param pointer so the conventions agree.
;; Tuple2 (16 bytes, by value) was always fine; Tuple3..Tuple8 (>16) failed.

;; Accessor (ABI-specialized, by-value) callees, one per arity 3..8.
(defn a3 [t : (Tuple3 int int int)] : int (tuple3-3rd t))
(defn a4 [t : (Tuple4 int int int int)] : int (tuple4-4th t))
(defn a5 [t : (Tuple5 int int int int int)] : int (tuple5-5th t))
(defn a6 [t : (Tuple6 int int int int int int)] : int (tuple6-6th t))
(defn a7 [t : (Tuple7 int int int int int int int)] : int (tuple7-7th t))
(defn a8 [t : (Tuple8 int int int int int int int int)] : int (tuple8-8th t))

;; inline-C callee declares its struct param by value; the pbp-param caller
;; must deref.
(defn sum3 [t : (Tuple3 int int int)] : int
  ```c return t.e1 + t.e2 + t.e3; ```)
(defn sum3-drv [t : (Tuple3 int int int)] : int (sum3 t))

;; pbp -> pbp forwarding stays by pointer (no deref); exercise that path too.
(defn fwd3 [t : (Tuple3 int int int)] : int (a3 t))

(println (a3 (tuple3 1 2 3)))
(println (a4 (tuple4 1 2 3 4)))
(println (a5 (tuple5 1 2 3 4 5)))
(println (a6 (tuple6 1 2 3 4 5 6)))
(println (a7 (tuple7 1 2 3 4 5 6 7)))
(println (a8 (tuple8 1 2 3 4 5 6 7 8)))
(println (sum3-drv (tuple3 10 20 30)))
(println (fwd3 (tuple3 7 8 9)))
