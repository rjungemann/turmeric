#lang r7rs
;; r7rs-lang-plan R3: data.  quote/quasiquote build pairs (R7rsPair, mutable
;; through set-car!/set-cdr!), the null and eof singletons, chars, strings,
;; vectors over (Vec any), bytevectors, records, cond-expand, and the three
;; equivalence predicates -- equal? terminates on a cycle.  Runs on both
;; back ends; the interpreter and the compiled program print the same lines.
;; quote as data
(display '(1 2 3)) (newline)
(display '(a (b c) "s" #t 2.5)) (newline)
(display '(1 . 2)) (display " ") (display '(1 2 . 3)) (newline)
(display '()) (display " ") (display (null? '())) (display (pair? '(1))) (newline)
(display '#(1 2 3)) (display " ") (display (vector-ref '#(1 2 3) 1)) (newline)
(display ''a) (display " ") (display (car ''a)) (newline)
;; quasiquote
(define x 5) (define ys (list 7 8))
(display `(1 ,x ,@ys 9)) (newline)
(display `(a . ,x)) (display " ") (display `#(1 ,x)) (newline)
(display `(nested `(inner ,(outer ,x)))) (newline)
;; pairs and mutation
(define p (cons 1 2))
(set-car! p 10) (set-cdr! p '(20))
(display p) (display " ") (display (car p)) (display " ") (display (cadr p)) (newline)
(define l (list 1 2 3))
(set-car! (cdr l) "two")
(display l) (newline)
;; eq?/eqv?/equal?
(display (eq? '() '())) (display (eq? 'a 'a)) (display (eqv? 1.5 1.5)) (display (eq? (list 1) (list 1)))
(display (equal? (list 1 (vector 2 "x")) (list 1 (vector 2 "x")))) (display (equal? "ab" "ab")) (newline)
(define c (list 1 2))
(set-cdr! (cdr c) c)   ; a cycle
(display (equal? c c)) (display (list? c)) (display (list? l)) (newline)
;; chars
(display #\a) (display #\space) (display #\x3bb) (write #\a) (write #\space) (newline)
(display (char? #\a)) (display (integer? #\a)) (display (char->integer #\A)) (display (integer->char 66)) (newline)
(display (char-upcase #\a)) (display (char<? #\a #\b)) (display (char-alphabetic? #\1)) (display (char-numeric? #\1)) (newline)
;; strings
(display (string-length "hello")) (display " ") (display (string-append "ab" "cd" "e")) (display " ")
(display (substring "hello" 1 3)) (display " ") (display (string-ref "hey" 1)) (display " ")
(display (string=? "a" "a")) (display (string<? "a" "b")) (newline)
(display (string->list "abc")) (display " ") (display (list->string (list #\x #\y))) (display " ")
(display (symbol->string 'sym)) (display " ") (display (eq? (string->symbol "dyn") 'dyn)) (display " ")
(display (number->string 42)) (display (number->string 2.5)) (newline)
;; vectors and bytevectors
(define v (make-vector 3 0))
(vector-set! v 1 'mid)
(display v) (display (vector-length v)) (display (vector->list v)) (display (list->vector '(1 2))) (display (vector? v)) (newline)
(define b (bytevector 1 2 255))
(bytevector-u8-set! b 0 9)
(display b) (display (bytevector-u8-ref b 2)) (display (bytevector-length b)) (display (bytevector? b)) (newline)
;; records
(define-record-type <point> (make-point x y) point? (x point-x set-point-x!) (y point-y))
(define pt (make-point 3 4))
(set-point-x! pt 30)
(display (point-x pt)) (display (point-y pt)) (display (point? pt)) (display (point? 5)) (newline)
;; cond-expand and eof
(cond-expand (turmeric (display "on-turmeric")) (else (display "elsewhere"))) (newline)
(display (eof-object? (eof-object))) (display (eof-object)) (newline)
(write (list "s" #\c 'q 1.5)) (newline)
