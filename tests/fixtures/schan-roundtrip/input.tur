;; S1: schan-roundtrip -- session-typed channel, single round trip.
;;
;; Protocol (client side): SSend int (SRecv int SClose)
;;   send 7, receive it back over the same FIFO channel, then close.
;;
;; Exercises stdlib/schan.tur end to end: the protocol phantom is threaded
;; through each operation, so the send must precede the recv and the close must
;; come last.  Reordering or skipping a step is a compile-time type error -- see
;; the schan-skip-step fixture for the negative case.
;;
;; schan-recv returns a (Pair T (SChan R)) -- the value and the advanced channel
;; together. It used to write the value through a caller-allocated cell and
;; return only the channel, a workaround for a monomorphizer defect fixed
;; 2026-06-05. See docs/archive/schan-recv-pair-signature-migration.md.

(defmodule app
  (import schan :refer [SChan SSend SRecv SClose
                        schan-new schan-send schan-recv schan-close])
  (defn main [] : int
    (let [c0 (:: (schan-new 2) (SChan (SSend int (SRecv int SClose))))
          c1 (schan-send c0 7)
          p  (schan-recv c1)
          v  (pair-fst p)
          c2 (pair-snd p)]
      (println v)
      (schan-close c2)
      0)))
