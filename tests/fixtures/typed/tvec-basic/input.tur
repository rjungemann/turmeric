;;
;; Phase TC1: tvec basic operations test

(defn test-empty [] :int
  (let [v (tvec-new)]
    (let [len (tvec-len v)]
      (tvec-free v)
      len)))

(defn test-push-get [] :int
  (let [v (tvec-new)]
    (tvec-push! v 42)
    (let [x (tvec-get v 0)]
      (tvec-free v)
      x)))

(defn test-push-multi [] :int
  (let [v (tvec-new)]
    (tvec-push! v 10)
    (tvec-push! v 20)
    (tvec-push! v 30)
    (let [len (tvec-len v)]
      (tvec-free v)
      len)))

(defn test-pop [] :int
  (let [v (tvec-new)]
    (tvec-push! v 100)
    (tvec-push! v 200)
    (let [x (tvec-pop! v)]
      (tvec-free v)
      x)))

(defn test-set [] :int
  (let [v (tvec-new)]
    (tvec-push! v 1)
    (tvec-push! v 2)
    (tvec-push! v 3)
    (tvec-set! v 1 99)
    (let [x (tvec-get v 1)]
      (tvec-free v)
      x)))

(defn test-eq [] :bool
  (let [a (tvec-new)]
    (let [b (tvec-new)]
      (tvec-push! a 1)
      (tvec-push! a 2)
      (tvec-push! b 1)
      (tvec-push! b 2)
      (let [result (tvec-eq? a b (fn [x y] (= x y)))]
        (tvec-free a)
        (tvec-free b)
        result))))

(println (test-empty))
(println (test-push-get))
(println (test-push-multi))
(println (test-pop))
(println (test-set))
(println (test-eq))
