;;
;; Phase TC1: tslice basic operations test

(extern-c free [p :ptr<void>] :void)

(defn make-arr [] :ptr<void>
  ```c
  int64_t *arr = malloc(3 * sizeof(int64_t));
  arr[0] = 10;
  arr[1] = 20;
  arr[2] = 30;
  return (void*)arr;
  ```)

(defn test-slice-len [] :int
  (let [arr (make-arr)]
    (let [s (tslice-new arr 3)]
      (let [len (tslice-len s)]
        (tslice-free s)
        (free arr)
        len))))

(defn test-slice-get-0 [] :int
  (let [arr (make-arr)]
    (let [s (tslice-new arr 3)]
      (let [x (tslice-get s 0)]
        (tslice-free s)
        (free arr)
        x))))

(defn test-slice-get-1 [] :int
  (let [arr (make-arr)]
    (let [s (tslice-new arr 3)]
      (let [x (tslice-get s 1)]
        (tslice-free s)
        (free arr)
        x))))

(defn test-slice-eq [] :bool
  (let [arr1 (make-arr)]
    (let [arr2 (make-arr)]
      (let [s1 (tslice-new arr1 3)]
        (let [s2 (tslice-new arr2 3)]
          (let [result (tslice-eq? s1 s2 (fn [a b] (= a b)))]
            (tslice-free s1)
            (tslice-free s2)
            (free arr1)
            (free arr2)
            result))))))

(println (test-slice-len))
(println (test-slice-get-0))
(println (test-slice-get-1))
(println (test-slice-eq))
