;;
;; Phase TC2: tgrid basic operations test

(defn test-new-dims [] :int
  (let [g (tgrid-new 4 3)]
    (let [w (tgrid-width g)]
      (let [h (tgrid-height g)]
        (tgrid-free g)
        (* w h)))))

(defn test-set-get [] :int
  (let [g (tgrid-new 4 3)]
    (tgrid-set! g 1 2 99)
    (let [v (tgrid-get g 1 2)]
      (tgrid-free g)
      v)))

(defn test-default-zero [] :int
  (let [g (tgrid-new 4 3)]
    (let [v (tgrid-get g 0 0)]
      (tgrid-free g)
      v)))

(defn test-multiple-cells [] :int
  (let [g (tgrid-new 3 3)]
    (tgrid-set! g 0 0 1)
    (tgrid-set! g 1 1 2)
    (tgrid-set! g 2 2 3)
    (let [s (+ (tgrid-get g 0 0)
               (+ (tgrid-get g 1 1)
                  (tgrid-get g 2 2)))]
      (tgrid-free g)
      s)))

(println (test-new-dims))
(println (test-set-get))
(println (test-default-zero))
(println (test-multiple-cells))
