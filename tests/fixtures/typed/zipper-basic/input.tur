;;
;; Phase TC2: tzipper basic operations test

(extern-c free [p :ptr<void>] :void)

(defn make-arr3 [] : ptr<void>
  ```c
  int64_t *arr = malloc(3 * sizeof(int64_t));
  arr[0] = 1;
  arr[1] = 2;
  arr[2] = 3;
  return (void*)arr;
  ```)

(defn make-empty [] : ptr<void>
  ```c
  return NULL;
  ```)

;; zipper-new copies its left/right inputs (see stdlib/tzipper.tur);
;; the caller still owns and must free the originals. make-empty returns
;; NULL, which free() accepts as a no-op.

(defn test-focus [] : int
  (let [left (make-arr3)]
    (let [right (make-arr3)]
      (let [z (zipper-new left 2 10 right 2)]
        (let [f (zipper-focus z)]
          (zipper-free z)
          (free left)
          (free right)
          f)))))

(defn test-move-right-focus [] : int
  (let [empty (make-empty)]
    (let [right (make-arr3)]
      (let [z (zipper-new empty 0 10 right 3)]
        (let [opt (zipper-move-right z)]
          (let [z2 (unwrap-or opt (:: 0 (Zipper int)))]
            (let [f (zipper-focus z2)]
              (zipper-free z)
              (free empty)
              (free right)
              f)))))))

(defn test-move-left-none [] : int
  (let [empty (make-empty)]
    (let [right (make-arr3)]
      (let [z (zipper-new empty 0 10 right 3)]
        (let [opt (zipper-move-left z)]
          (let [is-none (not (some? opt))]
            (zipper-free z)
            (free empty)
            (free right)
            (if is-none 1 0)))))))

(println (test-focus))
(println (test-move-right-focus))
(println (test-move-left-none))
