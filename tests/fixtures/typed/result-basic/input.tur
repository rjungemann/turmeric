;;
;; Phase TC1: result basic operations test

(defn test-ok [] : bool
  (ok? (ok 1)))

(defn test-err-not-ok [] : bool
  (ok? (err 0)))

(defn test-err? [] : bool
  (err? (err 5)))

(defn test-ok-val [] : int
  (ok-val (ok 42)))

(defn test-err-val [] : int
  (err-val (err 404)))

(defn test-result-eq-ok [] : bool
  (let [eq (fn [a b] (= a b))]
    (result-eq? (ok 1) (ok 1) eq eq)))

(defn test-result-eq-err [] : bool
  (let [eq (fn [a b] (= a b))]
    (result-eq? (err 5) (err 5) eq eq)))

(defn test-result-neq [] : bool
  (let [eq (fn [a b] (= a b))]
    (result-eq? (ok 1) (ok 2) eq eq)))

(defn test-result-map-ok [] : bool
  (let [eq (fn [a b] (= a b))]
    (result-eq? (result-map (ok 5) (fn [x] (* x 3))) (ok 15) eq eq)))

(defn test-result-map-err [] : bool
  (let [eq (fn [a b] (= a b))]
    (result-eq? (result-map (err 42) (fn [x] (* x 3))) (err 42) eq eq)))

(defn test-result-map-preserves-tag [] : bool
  (ok? (result-map (ok 1) (fn [x] (+ x 1)))))

(println (test-ok))
(println (test-err-not-ok))
(println (test-err?))
(println (test-ok-val))
(println (test-err-val))
(println (test-result-eq-ok))
(println (test-result-eq-err))
(println (test-result-neq))
(println (test-result-map-ok))
(println (test-result-map-err))
(println (test-result-map-preserves-tag))
