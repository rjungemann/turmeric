;; Facade module: pulls names in via :refer and re-exports them under
;; its own namespace. Wrapping defns are thin shims so callers don't
;; need to know about math-internal.
(defmodule math-facade
  (import math-internal :refer [mul2 mul3])
  (export twice thrice)
  (defn twice [x] : int (mul2 x))
  (defn thrice [x] : int (mul3 x)))
