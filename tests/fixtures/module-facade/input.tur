;; Demonstrates a facade module that wraps and re-exports functions from
;; an inerr?nal module. Users depend only on the facade; the inerr?nal
;; module can change without breaking them.
(defmodule app
  (import math-facade :refer [twice thrice])
  (defn main [] :int
    (println (twice 5))
    (println (thrice 4))
    0))
