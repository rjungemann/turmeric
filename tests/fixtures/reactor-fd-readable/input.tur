;; Phase R3: reactor-fd-readable -- pipe-pair readable callback fires.
;;
;; Creates a pipe, writes a byte to the write end, registers the read end
;; for READ events, and polls once.  Verifies the callback fires exactly
;; once with the READ event bit set, and that poll returns 1.
;;
;; Expected output:
;;   readable events=1
;;   poll-count=1

;; Pull in libturi for tur_reactor_* symbols.
(defn reactor-link [] : int
  ```c /* __tur_autolink__: -lturi */
  return 0;
  ```)

(extern-c tur_reactor_new [] :ptr)
(extern-c tur_reactor_add_fd [r :ptr fd :int events :int cb :int ud :int] :int)
(extern-c tur_reactor_poll [r :ptr timeout-ms :int] :int)
(extern-c tur_reactor_free [r :ptr] :void)

(defn make-pipe [] : ptr<void>
  ```c
  int *fds = (int *)malloc(2 * sizeof(int));
  if (pipe(fds) < 0) { free(fds); return NULL; }
  return (void *)fds;
  ```)

(defn pipe-read-fd [p : ptr<void>] : int
  ```c return (int64_t)((int *)p)[0]; ```)

(defn pipe-write-byte [p : ptr<void>] : nil
  ```c char b = 1; write(((int *)p)[1], &b, 1); ```)

(defn pipe-close [p : ptr<void>] : nil
  ```c close(((int *)p)[0]); close(((int *)p)[1]); free(p); ```)

;; Print "readable events=<n>" from the callback (no stdlib str needed).
(defn print-cb-result [events : int] : nil
  ```c printf("readable events=%lld\n", (long long)events); ```)

;; Print the poll count.
(defn print-poll-count [n : int] : nil
  ```c printf("poll-count=%lld\n", (long long)n); ```)

(defn main [] : int
  ;; Capture sentinel to produce a real fat closure.
  (let [sentinel 1
        p (make-pipe)
        r (tur_reactor_new)]
    (pipe-write-byte p)
    (tur_reactor_add_fd r (pipe-read-fd p) 1   ;; READ = 1
      (fn [id events ud] : nil
        ;; events should have READ bit set; multiply by sentinel (=1) to force capture
        (print-cb-result (* sentinel events)))
      0)
    (let [n (tur_reactor_poll r 200)]
      (print-poll-count n)
      (tur_reactor_free r)
      (pipe-close p)
      0)))
