;; ET3-F2: Two handlers for different effects composed.
(defeffect Log [msg :cstr] :nil)
(defeffect Counter [] :int)
(defn main [] :int
  (let [result
    (handle
      (handle
        (do (perform (Log "tick")) (+ (perform (Counter)) 1))
        (Counter [] k) (resume k 41))
      (Log [msg] k) (do (println msg) (resume k nil)))]
    (println result)
    0))
