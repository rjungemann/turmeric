;; EF-4: a `(Role G R)` form is a valid defstruct/ADT field type.
;;
;; `(Role Ping A)` is a linear multi-party role endpoint (TY_ROLE, a role
;; pointer at the C level).  It lowers like a `(Session P)` field (explicit
;; TY_ROLE storage case, int64 pointer carrier); previously it hit the DS-A4
;; "not supported as a struct/ADT field" hard error
;; (docs/archive/history/structdef-exotic-field-forms-plan.md).
;;
;; Role A's endpoint (from make-protocol) is stored in a RoleA struct; role B
;; runs on a thread.  Main reads the role endpoint back out of the field, sends
;; 42 to B, recvs the echo, and prints it.
;;
;; Expected output: 42

(defprotocol Ping [A B]
  (-> A B int)
  (-> B A int))

(defn spawn [f : ptr<void>] : ptr<void>
  ```c
  pthread_t *tid = (pthread_t *)malloc(sizeof(pthread_t));
  pthread_create(tid, NULL, tur_session_thread_wrapper, f);
  return (void *)tid;
  ```)

(defn join [t : ptr<void>] : int
  ```c
  pthread_join(*(pthread_t *)t, NULL);
  free(t);
  return 0;
  ```)

(defstruct RoleA [ch : (Role Ping A)])

(defn role-b [^linear ch : (Role Ping B)] : nil
  (let [[v ch] (recv-from ch A)]
    (let [ch (send-to ch A v)]
      (close ch))))

(defn main [] : int
  (let [[ra rb] (make-protocol Ping)]
    (let [box (RoleA ra)]
      (let [t (spawn (fn [] (role-b rb)))]
        ;; read the A role endpoint back out of the field, then use it
        (let [c0 (.ch box)]
          (let [c1 (send-to c0 B 42)]
            (let [[v c2] (recv-from c1 B)]
              (println v)
              (close c2)
              (join t)))))))
  0)
