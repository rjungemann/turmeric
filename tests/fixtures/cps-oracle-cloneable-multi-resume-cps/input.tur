;; U0 oracle (cps-backend-unification-plan): direct-vs-CPS value-equality net.
;; Backend: --enable=cps-backend (CT-IR; falls back to emit_cps.c today)
;; This program is one of a cps-oracle-cloneable-multi-resume / cps-oracle-cloneable-multi-resume-cps twin pair sharing one input
;; expected.stdout; the value MUST stay equal under both backends across every
;; phase of the port. See docs/upcoming/v2/cps-backend-unification-u0-inventory.md.
;;
;; CPS-CL9: Resume the same continuation twice.
;; The continuation captures the "rest of the reset body" after the shift.
;; Cloning allows independent resumes.

(defn k-identity [k] : int k)

(defn main [] : int
  (let [k (cloneable-reset
            (cloneable-shift k-identity 0))]
    (println (tur_cloneable_cont_resume (tur_cloneable_cont_clone k) 10))
    (println (tur_cloneable_cont_resume k 20)))
  0)
