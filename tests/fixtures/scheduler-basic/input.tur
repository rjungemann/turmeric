;; Phase T21: Basic scheduler test
;; Create a scheduler, spawn two fibers, run ok? completion

(defn fiber-a [] :nil
  ```c
  tur_fiber_block_yield(10);
  ```)

(defn fiber-b [] :nil
  ```c
  tur_fiber_block_yield(20);
  ```)

(defn scheduler-new-fn [] :ptr<void>
  ```c
  TurScheduler *s = tur_scheduler_new();
  if (tur_scheduler) { fprintf(stderr, "scheduler-new: only one supported\n"); abort(); }
  tur_scheduler = s;
  return (void *)s;
  ```)

(defn scheduler-spawn-fn [sched :ptr<void> f :ptr<void>] :nil
  ```c
  tur_scheduler_spawn((TurScheduler *)sched, (FiberBlock *)f);
  ```)

(defn scheduler-run-ok?-completion-fn [sched :ptr<void>] :nil
  ```c
  tur_scheduler_run_ok?_completion((TurScheduler *)sched);
  ```)

(defn fiber-new-fn [fn :ptr<void> stack-size :int] :ptr<void>
  ```c
  return (void *)tur_fiber_block_new((void(*)(void))fn, (size_t)stack_size);
  ```)

(defn fiber-free-fn [f :ptr<void>] :nil
  ```c
  tur_fiber_block_free((FiberBlock *)f);
  ```)

(defn main [] :int
  (let [sched (scheduler-new-fn)]
    (let [fa (fiber-new-fn fiber-a 0)]
      (let [fb (fiber-new-fn fiber-b 0)]
        (scheduler-spawn-fn sched fa)
        (scheduler-spawn-fn sched fb)
        (scheduler-run-ok?-completion-fn sched)
        (fiber-free-fn fa)
        (fiber-free-fn fb)
        (println 42)
        0))))
