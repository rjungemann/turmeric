;; Phase B4: Logic programming -- conjoined (conjunction) applies both goals.
;; Both (x = 1) and (y = 2) must hold: 1 result.
;; Uses the pure-Turmeric stdlib/logic.tur engine (no inline-C).

(load "stdlib/logic.tur")

(defn main [] : int
  (let [results (run-logic 1 (conjoined (lequal (term-var 0) (term-int 1))
                                        (lequal (term-var 1) (term-int 2))))]
    (println (bt-length results))
    0))
