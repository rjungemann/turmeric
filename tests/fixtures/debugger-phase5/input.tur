;; debugger Phase 5 acceptance fixture -- rich type display in native debuggers.
;;
;; `probe` receives a by-value Result as a parameter and returns a by-value
;; Option.  Built with `tur --debug build` (-g -Og + `#line` directives) and
;; with the gdb pretty-printers in tools/debug/turmeric_gdb.py loaded, a native
;; debugger renders both in Turmeric shape rather than the C carrier:
;;
;;   (gdb) break probe... ; run
;;   r = (ok 14)                          <- Result{is_ok,ok_val,err_val}
;;   (gdb) finish
;;   Value returned is (some 42)          <- Option__int{is_some,value}
;;
;; Why this shape: under -Og (which a self-contained single-file build needs so
;; the optimizer can DCE preloaded stdlib defns that reference libturi-only
;; symbols -- see Phase 4), the reliably-materialized inspection points for a
;; by-value aggregate are a memory-passed parameter (Result is 24 bytes -> spill
;; slot, visible even unused) and a function return value (`finish`).  `o`'s
;; payload comes from `seed` (a volatile inline-C value) so the optimizer cannot
;; constant-fold the option away.  Driven by tests/run-phase5-gdb.sh.
;;
;; RM4 (reclamation-plan): Option/Result monomorphs are by value by default, so
;; `probe` is emitted only as its by-value ABI clone `probe__spec__...` (the
;; erased base is unreferenced and DCE'd), and `o` / `r` are the aggregates
;; themselves, not carrier words.  Under -Og gcc scalarizes the by-value `r`
;; away (`<optimized out>` at the breakpoint, whether or not the body reads
;; it), so the parameter is no longer an inspection point; the two RETURN
;; VALUES are: `finish` out of `parse` renders `(ok 14)`, `finish` out of the
;; probe clone renders `(some 42)`.  `parse`'s argument comes from `seed` so
;; the call is not folded into `main` and `parse` keeps its symbol.  The
;; driver breaks on `parse` by name and on the clone with `rbreak ^probe`.
;;
;; The Result parameter is a CONCRETE instantiation `(Result int cstr)`, which
;; monomorphizes to the by-value carrier struct `tur_adt_Result__int__cstr`
;; (matching how `(Option A)` monomorphizes to `tur_adt_Option__int` at A=int).
;; A BARE, unparameterized `Result` is a generic ADT and is passed as the int64
;; carrier (a boxed pointer), which a pretty-printer cannot dispatch on -- so the
;; by-value-aggregate inspection point this fixture asserts requires the concrete
;; form.  The pretty-printer's `^(tur_adt_)?Result(__.*)?$` regex matches the
;; monomorphized name.  See
;; docs/archive/history/phase5-gdb-bare-result-lowered-to-int64-carrier.md.
;;
;; See docs/archive/history/debugger-plan.md (Phase 5) and
;; docs/archive/history/debugger-native-types-plan.md.

(defn seed [] : int
  ```c
  volatile int64_t v = 42;
  return v;
  ```)

(defn parse [b : int] : (Result int cstr)
  (if (= b 0) (err "zero") (ok (* b 2))))

(defn probe [A] [o : (Option A) r : (Result int cstr)] : (Option A)
  o)

(defn main [] : int
  (let [res (probe (some (seed)) (parse (- (seed) 35)))]
    (unwrap res)))
