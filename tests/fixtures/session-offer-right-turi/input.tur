;; Interpreter variant of session offer/choose taking the Right branch
;; (turi-session-types-plan, Slice C).
;;
;; The peer selects the Right branch (choose-right) and closes; the main context
;; offers, matches Right, and prints a sentinel.  Exercises the choose-right /
;; offer-Right side of the cooperative branch-slot rendezvous.
;;
;; Expected output: 999
(defn main [] : int
  (let [[s r] (make-session (Choose (Send int Close) Close))]
    (let [t (async (fn []
                     (let [s (choose-right s)]
                       (close s))))]
      (match (offer r)
        (Left r)
          (let [[n r] (recv r)]
            (close r) (await t) (println n))
        (Right r)
          (do (close r) (await t) (println 999)))))
  0)
