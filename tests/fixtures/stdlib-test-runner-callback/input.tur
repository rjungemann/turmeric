(defn assert [expected actual] :bool
  (if (= expected actual)
    true
    (do
      (println "Assertion failed: expected")
      (println expected)
      (println "but got")
      (println actual)
      false)))

(defn assert-true [x] :bool
  (if (= x 1)
    true
    (do
      (println "Assertion failed: expected true")
      false)))

(defn assert-false [x] :bool
  (if (= x 1)
    (do
      (println "Assertion failed: expected false")
      false)
    true))

(defn assert-nil [x] :bool
  (if (= x 0)
    true
    (do
      (println "Assertion failed: expected nil")
      false)))

(defn run-test [name :cstr ^fat test-fn] :int
  (if (= (test-fn) 1)
    (do
      (println ".")
      1)
    (do
      (println "F")
      (println name)
      0)))

(defn t-pass [] :int 1)
(defn t-fail [] :int 0)

(defn main [] :int
  (println (run-test "pass" t-pass))
  (println (run-test "fail" t-fail))
  0)
