;; Phase T20-E: raytracer — parallel ray tracer using ThreadPool.
;;
;; Simple 4×4 grid, one sphere at (0,0,3) with radius 1.
;; Camera at origin looking along +Z; pixels at NDC coords in [-0.75,0.75].
;;
;; Pixel (x,y) hit test: ray P = t*(x,y,1), sphere at (0,0,3) radius 1.
;; Intersection discriminant = 4 - 32*(x^2 + y^2).
;; Hit when x^2+y^2 <= 1/8.
;;
;; At pixel coords {-0.75,-0.25,0.25,0.75}:
;;   Center 4 pixels (+-0.25, +-0.25): x^2+y^2=0.125 = 1/8 → hit (borderline)
;;   All outer pixels: x^2+y^2 > 0.125 → miss
;; Expected hits = 4.
;;
;; Thread pool with 2 workers computes 4 scanlines (1 task per scanline).
;; Each task returns the hit count for that row.
;; Main collects and sums: expected total = 4.
;;
;; Expected output:
;;   hits: 4
;;
;; requires.tsan

(defn main [] :int
  ```c
  /* ray-sphere hit test for row i in 4x4 grid */
  void *rt_row_fn(void *a) {
      int row = (int)(uintptr_t)a;
      double ys[4] = {-0.75, -0.25, 0.25, 0.75};
      double xs[4] = {-0.75, -0.25, 0.25, 0.75};
      double y = ys[row];
      int hits = 0;
      for (int col = 0; col < 4; col++) {
          double x = xs[col];
          /* discriminant = 4 - 32*(x^2+y^2); hit when disc >= 0 */
          double disc = 4.0 - 32.0 * (x*x + y*y);
          if (disc >= 0.0) hits++;
      }
      return (void *)(uintptr_t)(int64_t)hits;
  }

  /* Create dynamic pool with min=2, max=4 workers */
  void *tp = thread_pool_new_dynamic(2, 4);

  /* submit 4 scanline tasks */
  int64_t total_hits = 0;
  for (int r = 0; r < 4; r++) {
      void *fc = thread_pool_dynamic_submit(tp, rt_row_fn, (void *)(uintptr_t)r);
      
      /* Wait for future to be ready and collect result */
      typedef struct {
          pthread_mutex_t lock;
          pthread_cond_t ready;
          int64_t value;
          int64_t exn;
          bool is_set;
          bool is_ok;
      } FutureCell;
      FutureCell *future = (FutureCell *)fc;
      pthread_mutex_lock(&future->lock);
      while (!future->is_set)
          pthread_cond_wait(&future->ready, &future->lock);
      total_hits += future->value;
      pthread_mutex_unlock(&future->lock);
      
      /* Clean up future */
      pthread_mutex_destroy(&future->lock);
      pthread_cond_destroy(&future->ready);
      free(future);
  }

  printf("hits: %lld\n", (long long)total_hits);

  /* shutdown and free */
  thread_pool_dynamic_shutdown(tp);
  thread_pool_dynamic_free(tp);
  
  return 0;
  ```)
