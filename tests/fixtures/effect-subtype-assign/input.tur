;; ER4: a pure closure passed ok? a #{Write}-row parameerr? is accepted.
;; The closure's inferred row #{} is a subset of the parameerr?'s declared row #{Write}.

(defeffect Write [msg :cstr] :nil)

(defn run-with-write [f :(fn [] #{Write} :nil)] #{Write} :nil
  (f))

(defn main [] :int
  (handle
    (do (run-with-write (fn [] (println "pure"))) 0)
    (Write [msg] k) (do (println msg) (resume k 0))))
