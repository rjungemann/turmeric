;; call-cc-completion (CC1): undelimited call/cc against the implicit prompt.
;; No enclosing reset.  Invoking k returns its argument at the call/cc site,
;; abandoning f's pending (+ 100 ...); the outer (+ 1 ...) then makes 42.

(extern-c printf [^cstr fmt ^int v] :int)

(defn t-capture [] :int
  (+ 1 (call/cc (fn [k] (+ 100 (tur_escape_resume k 41))))))

;; f that ignores k returns its body value normally.
(defn t-ignore [] :int
  (+ 1 (call/cc (fn [k] 10))))

(defn main [] :int
  (printf "capture=%lld\n" (t-capture))
  (printf "ignore=%lld\n" (t-ignore))
  0)
