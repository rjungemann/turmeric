;; generic-spec-carrier-crossings -- a value typed as the enclosing generic's
;; own type variable `A`, produced and consumed inside the generic body, at
;; representations the int64 carrier does not hold by value (float, float32,
;; cstr).  Each line was a silent wrong answer, a segfault, or invalid C:
;;
;;   tail   `(vec-get v 0)` as the body: the carrier word returned into a
;;          `double` spec by VALUE conversion (7.1 printed 4.61968e+18)
;;   let    the same, let-bound, at cstr: the word dereferenced as a pointer
;;          to a cstr (segfault)
;;   box    `(.val (Box x))`: the ctor typed as the erased `Box`, its int64
;;          field value-converted (4.61968e+18 / 1.088632e+09)
;;   some   `(match (some ...) ...)` over a generic call: matched as
;;          `Option__int` (invalid C)
;;   vec    `(vec-push! w x)` with `x : A`: the double stored as 7, read back
;;          as 3.45846e-323
;;
;; Generated by tests/generic-spec-matrix.py's producer/sink shapes; see
;; docs/archive/generic-spec-carrier-crossings.md.

(defstruct Box [A] [val : A])

(defn ident [A] [x : A] : A x)

(defn tail-get [A] [v : (Vec A)] : A (vec-get v 0))
(defn let-get  [A] [v : (Vec A)] : A (let [y (vec-get v 0)] y))
(defn box-get  [A] [v : (Vec A)] : A (.val (Box (vec-get v 0))))
(defn box-par  [A] [x : A] : A (.val (Box x)))
(defn some-get [A] [v : (Vec A)] : A
  (match (some (vec-get v 0))
    (Some q) q
    (None) (vec-get v 0)))
(defn vec-par  [A] [x : A] : A
  (let [w (vec-new)]
    (vec-push! w x)
    (vec-get w 0)))
(defn vec-get2 [A] [v : (Vec A)] : A
  (let [w (vec-new)]
    (vec-push! w (vec-get v 0))
    (vec-get w 0)))
(defn pair-get [A] [v : (Vec A)] : A (pair-fst (pair (vec-get v 0) 0)))
(defn id-get   [A] [v : (Vec A)] : A (ident (vec-get v 0)))

(defn main [] : int
  (let [vf (:: (vec-new) (Vec float))
        vs (:: (vec-new) (Vec float32))
        vc (:: (vec-new) (Vec cstr))]
    (vec-push! vf 7.1)
    (vec-push! vs (:: 3.25 float32))
    (vec-push! vc "hi")
    (println (tail-get vf))
    (println (tail-get vs))
    (println (tail-get vc))
    (println (let-get vf))
    (println (let-get vs))
    (println (let-get vc))
    (println (box-get vf))
    (println (box-get vs))
    (println (box-get vc))
    (println (box-par 7.1))
    (println (box-par (:: 3.25 float32)))
    (println (some-get vf))
    (println (some-get vs))
    (println (some-get vc))
    (println (vec-par 7.1))
    (println (vec-par (:: 3.25 float32)))
    (println (vec-par "hi"))
    (println (vec-get2 vf))
    (println (vec-get2 vs))
    (println (pair-get vf))
    (println (pair-get vc))
    (println (id-get vf))
    (println (id-get vs)))
  0)
