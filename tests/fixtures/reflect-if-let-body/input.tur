;; reflected-measures RF3: `let` and `if` in a reflected body.  There is no
;; if-then-else TERM in the logic, so a body under an `if` is admitted as a
;; proposition rather than an equation:
;;   (h > 0 => count-pos(xs) = 1 + rest) and (not (h > 0) => count-pos(xs) = rest)
;; with `rest` the (unfolded) recursive call the `let` bound.
(defdata Lst [] (Cons [hd : int tl : Lst]) (Nil))

(defn ^reflect count-pos [xs : Lst] : int
  (match xs
    (Nil) 0
    (Cons h t) (let [rest (count-pos t)]
                 (if (> h 0) (+ 1 rest) rest))))

(defn two-pos [xs : #refine{ v : Lst | (= (count-pos v) 2) }] : int 2)

(defn main [] : int
  (println (two-pos (Cons 1 (Cons -5 (Cons 3 (Nil))))))
  (println "reflect-if-let-body")
  0)
