; GF1 fixture: generator that terminates early with (return).

(defn ptr-some? [p] :bool
  ```c
  return p != 0;
  ```)

(defn ptr-unwrap [p] :int
  ```c
  return *(int64_t *)(intptr_t)p;
  ```)

(defn main [] :void
  (let [limit 3
        g (gen []
            (let [^mut i 0]
              (while (< i 10)
                (if (= i limit)
                  (return)
                  (yield i))
                (set! i (+ i 1)))))]
    (while (not (gen-done? g))
      (let [v (gen-next g)]
        (when (ptr-some? v)
          (println (ptr-unwrap v)))))))
