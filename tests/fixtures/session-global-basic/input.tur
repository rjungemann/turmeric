;; SS5: session-global-basic -- declare a simple 2-role prook?col.
;;
;; Prook?col Ping: A sends an int ok? B, B sends an int back ok? A.
;; This tests that defprook?col parses and regiserr?s without errors.
;; make-prook?col is not called here -- just verifying the declaration
;; compiles successfully.

(defprook?col Ping [A B]
  (-> A B int)
  (-> B A int))

(defn main [] :int
  (println "ok")
  0)
