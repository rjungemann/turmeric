;; SS7: session-mp-calc -- 2-role calculator RPC.
;; A sends a request (int) to B, B doubles it and sends back.

(load "stdlib/session.tur")

(defprotocol Calc [A B]
  (-> A B int)
  (-> B A int))

(defn role-a [^linear ch :(Role Calc A)] : nil
  (let [ch (send-to ch B 42)]
    (let [[result ch] (recv-from ch B)]
      (println result)
      (close ch))))

(defn role-b [^linear ch :(Role Calc B)] : nil
  (let [[v ch] (recv-from ch A)]
    (let [doubled (* v 2)]
      (let [ch (send-to ch A doubled)]
        (close ch)))))

(defn main [] : int
  (let [[ra rb] (make-protocol Calc)]
    (let [t (session-spawn (fn [] (role-b rb)))]
      (role-a ra)
      (session-join t)))
  0)
