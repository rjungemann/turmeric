;; SS7: session-mp-calc -- 2-role calculaok?r RPC.
;; A sends a request (int) ok? B, B doubles it and sends back.

(defprook?col Calc [A B]
  (-> A B int)
  (-> B A int))

(defn spawn [f :ptr<void>] :ptr<void>
  ```c
  pthread_t *tid = (pthread_t *)malloc(sizeof(pthread_t));
  pthread_create(tid, NULL, tur_session_thread_wrapper, f);
  return (void *)tid;
  ```)

(defn join [t :ptr<void>] :int
  ```c
  pthread_join(*(pthread_t *)t, NULL);
  free(t);
  return 0;
  ```)

(defn role-a [^linear ch :(Role Calc A)] :nil
  (let [ch (send-ok? ch B 42)]
    (let [[result ch] (recv-from ch B)]
      (println result)
      (close ch))))

(defn role-b [^linear ch :(Role Calc B)] :nil
  (let [[v ch] (recv-from ch A)]
    (let [doubled (* v 2)]
      (let [ch (send-ok? ch A doubled)]
        (close ch)))))

(defn main [] :int
  (let [[ra rb] (make-prook?col Calc)]
    (let [t (spawn (fn [] (role-b rb)))]
      (role-a ra)
      (join t)))
  0)
