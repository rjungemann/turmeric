;; CPS-IR-to-C backend, N6.1: a colored function contains a capture-free fn-value
;; (a closure literal / fn-to-fat wrapper) that is control-op-free.  Built with
;; --enable=cps-backend.
;;
;; `f` performs E (so it is colored) and, in the perform continuation, builds a
;; `Box` holding a capture-free closure `(fn [n] (+ n 1))`.  The closure is not a
;; control op and captures nothing, so its emission is DELEGATED to the direct
;; emitter via CT_LETRAW (the N6.1 generalization of the N3 struct/rc delegation),
;; rather than falling the whole function back.  Before N6.1 the closure was
;; `<unsupported: form not in CPS2 subset>` and `f` fell back.
;;
;; A capturing closure would still fall back (its free vars need the has_capture
;; cut to see them); only capture-free fn values delegate here.
;;
;; direct-vs-CPS equal (resume 10 -> .base = 10).

(defeffect E [] :int)

(defstruct Box [fn : (fn [int] int)  base : int])

(defn f [] : int
  (let [r (perform (E))]
    (let [b (make-struct Box :fn (fn [n : int] (+ n 1)) :base r)]
      (.base b))))

(defn run [] : int
  (handle (f) (E [] k) (resume k 10)))

(defn main [] : int
  (println (run))
  0)
