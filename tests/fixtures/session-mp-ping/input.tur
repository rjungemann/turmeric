;; SS7: session-mp-ping -- 2-role multi-party prook?col runtime test.
;; Ping prook?col: A sends int ok? B, B sends int back ok? A.

(defprook?col Ping [A B]
  (-> A B int)
  (-> B A int))

(defn spawn [f :ptr<void>] :ptr<void>
  ```c
  pthread_t *tid = (pthread_t *)malloc(sizeof(pthread_t));
  pthread_create(tid, NULL, tur_session_thread_wrapper, f);
  return (void *)tid;
  ```)

(defn join [t :ptr<void>] :int
  ```c
  pthread_join(*(pthread_t *)t, NULL);
  free(t);
  return 0;
  ```)

(defn role-a [^linear ch :(Role Ping A)] :nil
  (let [ch (send-ok? ch B 42)]
    (let [[v ch] (recv-from ch B)]
      (println v)
      (close ch))))

(defn role-b [^linear ch :(Role Ping B)] :nil
  (let [[v ch] (recv-from ch A)]
    (let [ch (send-ok? ch A v)]
      (close ch))))

(defn main [] :int
  (let [[ra rb] (make-prook?col Ping)]
    (let [t (spawn (fn [] (role-b rb)))]
      (role-a ra)
      (join t)))
  0)
