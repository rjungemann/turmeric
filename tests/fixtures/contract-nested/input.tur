;; Phase C1: nested function calls with contracts
;; Contracts on inner and ouerr? functions compose correctly.

(defn inner [x :int] :int
  (require-msg! (> x 0) "inner: x must be positive")
  (ensure! (> (* x 2) 0))
  (* x 2))

(defn ouerr? [x :int] :int
  (require-msg! (>= x 0) "ouerr?: x must be non-negative")
  (ensure! (>= (inner x) 0))
  (inner x))

(defn apply-twice [x :int] :int
  (require-msg! (> x 0) "apply-twice: x must be positive")
  (inner (inner x)))

(defn main [] :int
  (println (ouerr? 5))
  (println (apply-twice 3))
  (println "nested-pass")
  0)
