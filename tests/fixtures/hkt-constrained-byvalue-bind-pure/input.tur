;; constrained-hkt-byvalue-carriers + the gap-1 return-dispatch fix, together:
;; a `bind`-then-`pure` combinator over an ABSTRACT type constructor, called at
;; the stdlib Option -- a by-value carrier.
;;
;; `pure` needs return-directed dispatch against the constraint (gap 1) and the
;; continuation's `(Option int)` return needs the carrier-spill box (gap 2).
;; Neither worked before; the two together are the shape real monadic code has.

(defn bind-then-pure [^m] [^Monad m ^Applicative m x : (m int)] : (m int)
  (bind x (fn [v] (pure (+ v 1)))))

(defn main [] : int
  (println (unwrap-or (bind-then-pure (some 41)) -1))   ; 42
  0)
