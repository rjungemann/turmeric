;; `pure` (return-directed) on the abstract type constructor of a constrained
;; poly fn, instantiated at the stdlib Option -- a by-value carrier.
;;
;; Needs the gap-1 return-dispatch fix to resolve at all, and re-resolution to
;; land on Applicative[Option] rather than the representative the elaborator
;; picked (Applicative[Schema], whose `pure` builds a Schema).
;;
;; NOTE: `pure` inside a LIFTED CONTINUATION -- `(bind x (fn [v] (pure ...)))`
;; -- is NOT yet correct; the lambda is emitted outside any specialization and
;; keeps the Schema representative.  See
;; docs/reported/constrained-hkt-spec-keeps-representative-instance.md.  That
;; shape is deliberately absent here: it currently prints the right number only
;; because Schema's tag word reads as Option's `is_some`.

(defn just-pure [^m] [^Applicative m x : (m int)] : (m int)
  (pure 7))

(defn main [] : int
  (println (unwrap-or (just-pure (some 0)) -1))   ; 7
  0)
