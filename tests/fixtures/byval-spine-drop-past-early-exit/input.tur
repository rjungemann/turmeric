;; byval-spine-drop-past-early-exit -- a by-value ADT local in a scope whose end
;; is never reached still releases its box chain.
;;
;; `drop_localowned_<T>(&xs)` is a TRAILING free, emitted after the let body.
;; Two exits jump past it, and neither had been given the drop:
;;
;;   face i  -- a tail self-call.  emit_tail emits a tail-position `let` INLINE
;;              (emit_fns.c, the `tco_let_simple` arm) and repeats the `any`
;;              drop bookkeeping there, but never repeated the spine drop, so a
;;              tail-recursive accumulator loop that builds a list per turn
;;              leaked the whole spine every turn.  Not "jumped past": never
;;              EMITTED -- the emitted `drive()` had no drop call in it at all.
;;   face ii -- an explicit `return`.  emit_let_value collected the spine drop
;;              only when the body had no return, so a `(return ...)` body got
;;              none, and the returning path leaked the spine on every call.
;;
;; Measured before the fix: 2 boxes x N turns, flat -- 200 at 100, 800 at 400.
;;
;; The drop now rides the early-exit channel the `any` drop already uses
;; (`any_scope_drops`), which fires AFTER the back-edge assigns the argument
;; temporaries to the parameters and AFTER a `return` hoists its value to a
;; temp.  What makes that sound is a gate on the enclosing SIGNATURE: every
;; parameter and the result must be a non-pointer scalar, so nothing the next
;; iteration receives, and nothing the return hands out, can point into the
;; spine being freed.  A match binder aliasing the spine (`t` in `(Cons h t)`)
;; threaded through an `any` parameter is what the gate refuses -- pinned next
;; door in byval-spine-drop-refused-nonscalar-param.
;;
;; Both spine paths are here: the direct recursive field (`tl : Rec`) and the
;; `:any` field (the Saffron shape, written with explicit widens so the file
;; needs no `#lang` line).  Both glue through `drop_localowned_<T>`; the
;; sibling report's `drop_recspine_` name is stale.
;;
;; Every read of `xs` is an INLINE `match`, on purpose.  Handing `xs` to a
;; callee that takes the ADT by value (`[xs : Rec]`) MOVES it -- the callee
;; owns it and nothing discharges it there (byvalue-recursive-adt-boxes-are-
;; never-freed, Residue 1) -- so `drops_local_owned` is never set and there is
;; no drop for this fix to fire.  The first draft of this fixture did exactly
;; that and leaked all 1400 boxes with the fix in place.
;;
;; requires.leak-check with no known-leak: the loop counts make one missing
;; free visible, and a drop fired too early would abort as a use-after-free.

(defdata Rec [] (RCons [hd : int tl : Rec]) (RNil))
(defdata Dyn [] (DCons [hd : any tl : any]) (DNil))

;; face i, direct recursive field: the let body IS the tail self-call.
(defn loop-rec [i : int n : int acc : int] : int
  (if (= i n)
    acc
    (let [xs (RCons i (RCons 2 (RNil)))]
      (loop-rec (+ i 1) n (+ acc (match xs (RCons h t) h (RNil) 0))))))

;; face i, :any field: same shape, the other glue path.
(defn loop-dyn [i : int n : int acc : int] : int
  (if (= i n)
    acc
    (let [xs (DCons (:: i any) (:: (DCons (:: 2 any) (:: (DNil) any)) any))]
      (loop-dyn (+ i 1) n (+ acc (match xs (DCons h t) (cast h int) (DNil) 0))))))

;; face ii, both paths: the let body ends in an explicit `return`.
(defn once-rec [i : int] : int
  (let [xs (RCons i (RCons 2 (RNil)))]
    (return (match xs (RCons h t) h (RNil) 0))))

(defn once-dyn [i : int] : int
  (let [xs (DCons (:: i any) (:: (DNil) any))]
    (return (match xs (DCons h t) (cast h int) (DNil) 0))))

;; A non-tail driver for the `return` cases, so their scopes are entered once
;; per turn and the drop has to fire on the returning path each time.
(defn drive [i : int n : int] : int
  (if (= i n)
    0
    (+ (+ (once-rec i) (once-dyn i)) (drive (+ i 1) n))))

(defn main [] : int
  (println (loop-rec 0 200 0))   ;; 0+1+...+199 = 19900
  (println (loop-dyn 0 200 0))   ;; 19900
  (println (drive 0 200))        ;; 2 * 19900 = 39800
  0)
