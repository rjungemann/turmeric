; GF2 fixture: gen-collect -- materialise all generator values into an array.

(load "stdlib/gen.tur")

(defn main [] : void
  (let [g   (gen []
              (yield 10)
              (yield 20)
              (yield 30))
        arr (gen-collect g)
        ^mut i 0]
    (while (< i (gen-arr-len arr))
      (println (gen-arr-get arr i))
      (set! i (+ i 1)))))
