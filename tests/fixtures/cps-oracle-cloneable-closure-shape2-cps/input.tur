(load "stdlib/workflow.tur")
;; U7 (cps-backend-unification): native cloneable/serial Shape 2 CLOSURE receiver.
;; Shape 2 is an arithmetic/call context around the shift, reified as DK frames;
;; the receiver is handed the captured (multi-shot / marshalable) continuation.
;; A named-fn receiver rode the dk_shift env as a bare fn ptr; a capturing closure
;; could not.  Now emit_cl_shift_bodyfn bakes the closure's thunk into the per-site
;; body fn and emit_cl_shift_env passes the closure env as the dk_shift env, so a
;; capturing closure receiver works across every Shape 2 context (single/multi
;; arithmetic frame, a 1-arg call frame) for both the multi-shot cloneable path and
;; the marshalable serial path.  direct == cps (verified through resume + save/resume).
(defn dbl [n : int] : int (* n 2))
(defn resume-ctx [x : int] : int
  (cloneable-reset (+ 10 (cloneable-shift (fn [k : cont] (+ x (k 5))) 0))))   ; x + (10+5)
(defn ignore-ctx [x : int] : int
  (cloneable-reset (+ 10 (cloneable-shift (fn [k : cont] (+ x 1)) 0))))        ; x + 1
(defn multishot [x : int] : int
  (cloneable-reset (+ 1 (cloneable-shift (fn [k : cont] (+ (k x) (k x))) 0)))) ; (1+x)+(1+x)
(defn two-frame [x : int] : int
  (cloneable-reset (* 2 (+ 10 (cloneable-shift (fn [k : cont] (+ x (k 3))) 0))))) ; x + (10+3)*2
(defn call-frame [x : int] : int
  (cloneable-reset (dbl (cloneable-shift (fn [k : cont] (+ x (k 5))) 0))))     ; x + (5*2)
(defn serial-ctx [x : int] : int
  (serial-reset (+ 10 (serial-shift (fn [k : ptr<void>] (+ x (resume-cont! (save-cont! k) 5))) 0)))) ; x + (10+5)
(defn main [] : int
  (println (resume-ctx 100))
  (println (ignore-ctx 100))
  (println (multishot 5))
  (println (two-frame 100))
  (println (call-frame 100))
  (println (serial-ctx 100))
  0)
