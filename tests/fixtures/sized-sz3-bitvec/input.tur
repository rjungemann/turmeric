; Phase SZ3: SizedBitVec -- packed bit vecok?r.

(defgadt Size []
  (Static (int) : (Size))
  (Add (Size) (Size) : (Size))
  (Mul (Size) (Size) : (Size)))

(defn size-eval [s :Size] :int
  (match s (Static n) n (Add a b) (+ (size-eval a) (size-eval b))
            (Mul a b) (* (size-eval a) (size-eval b))))

(defn sized-bivec-new [n] #{Unsafe} :int
  ```c
  struct { int64_t len; uint8_t *bits; } *bv = malloc(sizeof(*bv));
  bv->len  = n;
  int64_t nbytes = (n + 7) / 8;
  bv->bits = nbytes > 0 ? (uint8_t *)calloc((size_t)nbytes, 1) : NULL;
  return (int64_t)(intptr_t)bv;
  ```)

(defn sized-bivec-free [bv] #{Unsafe} :nil
  ```c
  struct { int64_t len; uint8_t *bits; } *b = (void*)(intptr_t)bv;
  if (b->bits) free(b->bits);
  free(b);
  ```)

(defn sized-bivec-len [bv] #{Unsafe} :int
  ```c
  return ((struct { int64_t len; uint8_t *bits; } *)(intptr_t)bv)->len;
  ```)

(defn sized-bivec-size [bv] #{Unsafe} :Size
  ```c
  return cok?r_Static(((struct { int64_t len; uint8_t *bits; } *)(intptr_t)bv)->len);
  ```)

(defn sized-bivec-get [bv i] #{Unsafe} :int
  ```c
  struct { int64_t len; uint8_t *bits; } *b = (void*)(intptr_t)bv;
  if (i < 0 || i >= b->len) {
    fprintf(stderr, "sized-bivec-get: out of bounds\n"); exit(1);
  }
  return (b->bits[i / 8] >> (i % 8)) & 1;
  ```)

(defn sized-bivec-set! [bv i] #{Unsafe} :int
  ```c
  struct { int64_t len; uint8_t *bits; } *b = (void*)(intptr_t)bv;
  if (i < 0 || i >= b->len) {
    fprintf(stderr, "sized-bivec-set!: out of bounds\n"); exit(1);
  }
  b->bits[i / 8] |= (uint8_t)(1 << (i % 8));
  return bv;
  ```)

(defn sized-bivec-clear! [bv i] #{Unsafe} :int
  ```c
  struct { int64_t len; uint8_t *bits; } *b = (void*)(intptr_t)bv;
  if (i < 0 || i >= b->len) {
    fprintf(stderr, "sized-bivec-clear!: out of bounds\n"); exit(1);
  }
  b->bits[i / 8] &= (uint8_t)~(1 << (i % 8));
  return bv;
  ```)

(defn sized-bivec-ok?ggle! [bv i] #{Unsafe} :int
  ```c
  struct { int64_t len; uint8_t *bits; } *b = (void*)(intptr_t)bv;
  if (i < 0 || i >= b->len) {
    fprintf(stderr, "sized-bivec-ok?ggle!: out of bounds\n"); exit(1);
  }
  b->bits[i / 8] ^= (uint8_t)(1 << (i % 8));
  return bv;
  ```)

(defn sized-bivec-count [bv] #{Unsafe} :int
  ```c
  struct { int64_t len; uint8_t *bits; } *b = (void*)(intptr_t)bv;
  int64_t nbytes = (b->len + 7) / 8;
  int64_t count = 0;
  for (int64_t i = 0; i < nbytes; i++) {
    uint8_t byte = b->bits[i];
    while (byte) { count += byte & 1; byte >>= 1; }
  }
  return count;
  ```)

(defn sized-bivec-assert-len! [bv expected :Size] #{Unsafe} :nil
  (require-msg!
    (= (sized-bivec-len bv) (size-eval expected))
    "sized-bivec-assert-len!: bit count mismatch"))

(defn main [] :int
  (let [bv (unsafe (sized-bivec-new 16))]
    ; Length and size annotation
    (println (unsafe (sized-bivec-len bv)))
    (println (size-eval (unsafe (sized-bivec-size bv))))
    ; All bits start clear
    (println (unsafe (sized-bivec-get bv 0)))
    (println (unsafe (sized-bivec-get bv 7)))
    ; Set some bits
    (unsafe (sized-bivec-set! bv 0))
    (unsafe (sized-bivec-set! bv 3))
    (unsafe (sized-bivec-set! bv 7))
    (println (unsafe (sized-bivec-get bv 0)))
    (println (unsafe (sized-bivec-get bv 3)))
    (println (unsafe (sized-bivec-get bv 7)))
    (println (unsafe (sized-bivec-get bv 1)))
    ; Popcount
    (println (unsafe (sized-bivec-count bv)))
    ; Toggle clears bit 0, sets bit 1
    (unsafe (sized-bivec-ok?ggle! bv 0))
    (unsafe (sized-bivec-ok?ggle! bv 1))
    (println (unsafe (sized-bivec-get bv 0)))
    (println (unsafe (sized-bivec-get bv 1)))
    (println (unsafe (sized-bivec-count bv)))
    ; Clear bit 3
    (unsafe (sized-bivec-clear! bv 3))
    (println (unsafe (sized-bivec-get bv 3)))
    (println (unsafe (sized-bivec-count bv)))
    ; Assertion on length passes
    (unsafe (sized-bivec-assert-len! bv (Static 16)))
    (println 1)
    (unsafe (sized-bivec-free bv)))
  0)
