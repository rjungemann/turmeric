;; typed-collection-eq-consumers-plan step 7 (Set): with set-eq-full /
;; set-eq-driver / set-count / set-hamt rewritten to by-value (Set A) (Path A,
;; mirroring Eq[Map]), a concrete (Set int) receiver dispatches Eq via the
;; typed per-A spec __inst_Eq_eq_qu_Set__spec__... over Set__int *, rather than
;; the int64 carrier set_hyeq_hyfull.  Set is already a non-transparent :heap
;; struct ((hamt :ptr<void>)), so no representation change was needed -- only
;; the consumer-side by-value rewrite.  A typed (Set int) handle also flows
;; into a user fn taking the concrete heap type.

(defn size-of [s : (Set int)] : int
  (set-count s))

(defn main [] : int
  (let [a (:: (set-add (set-add (set-new) 1 1) 2 2) (Set int))
        b (:: (set-add (set-add (set-new) 2 2) 1 1) (Set int))
        c (:: (set-add (set-new) 1 1) (Set int))]
    (println (size-of a))                                  ; 2
    (println (eq? (:: a (Set int)) (:: b (Set int))))      ; true
    (println (eq? (:: a (Set int)) (:: c (Set int)))))     ; false
  0)
