;; CPS-IR-to-C backend, N6.3 tail: a *capturing handler case* -- the handler
;; body itself references an enclosing local (not just the post-handle
;; continuation).  Built with --enable=cps-backend.
;;
;; `run`'s handler case is `(resume k (+ base 1))`, which references the enclosing
;; parameter `base`.  A handler case is lifted as an LH_HANDLER_CASE helper whose
;; env carries its scalar source captures:
;;   typedef struct { int64_t f0; } run_hc0_env;   // f0 = base
;;   e->f0 = base;  dk_handler(E, run_hc0, (intptr_t)e, ...);
;; and the helper reads `int64_t base = e->f0;`.  Two things had to land for this:
;;   1. collect_caps_case gathers the case body's captures (excluding the case's
;;      own params + k), and
;;   2. collect_caps_rec grew a CT_RESUME arm so a *resuming* case body (the common
;;      shape) is admitted instead of bailing to the zero-capture fallback.
;;
;; direct-vs-CPS equal: base=40, case resumes (base+1)=41.

(defeffect E [] :int)

(defn work [] : int
  (perform (E)))

(defn run [base : int] : int
  (handle (work) (E [] k) (resume k (+ base 1))))

(defn main [] : int
  (println (run 40))
  0)
