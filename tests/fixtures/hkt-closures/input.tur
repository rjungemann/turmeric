;; Phase HKT TY5: HKT + multi-capture closures via dot-method dispatch.
;;
;; Before TY5 the only way to pass a capturing closure to an HKT method was
;; to write a custom fat-closure helper (__fmap_option_clos) and call it
;; directly, bypassing typeclass dispatch.  TY5 removes that workaround:
;;
;; 1. The typeclass method signature uses :fn for the function parameter.
;; 2. The instance body calls through tur_poly_fn_t so both raw function
;;    pointers and fat closures work uniformly.
;; 3. Calling sites use (.fmap ...) and pass (fn [x] (+ x n)) directly --
;;    no manual cast, no custom helper.

(defclass TestFunctor [^f]
  (fmap [container [fn :fn]] : int))

;; Option helpers
(defn __opt_some [x] : int
  ```c
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn __opt_some? [o] : bool
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return p != 0 && p->is_some;
  ```)

(defn __opt_unwrap [o] : int
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return (int)(p->value);
  ```)

;; TestFunctor[option] using tur_poly_fn_t calling convention.
;; fn.fn(fn.env, val) works for both named functions and fat closures.
(definstance TestFunctor [option]
  (fmap [container fn]
    ```c
    struct { bool is_some; int64_t value; } *c =
        (void *)(intptr_t)container;
    if (!c || !c->is_some) return 0;
    struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
    r->is_some = true;
    r->value = fn.fn(fn.env, c->value);
    return (int64_t)(intptr_t)r;
    ```))

;; Named helper functions for tests 1 & 2 (raw fn-ptr path).
(defn __add5   [x] : int (+ x 5))
(defn __square [x] : int (* x x))

(defn main [] : int
  (do
    ;; Test 1: named function, tur_poly_fn_t calling convention.
    (let [opt (__opt_some 10)]
      (let [result (.fmap opt __add5)]
        (do
          (println (__opt_some? result))   ;; true
          (println (__opt_unwrap result))))) ;; 15

    ;; Test 2: named function, tur_poly_fn_t calling convention.
    (let [opt2 (__opt_some 7)]
      (let [result2 (.fmap opt2 __square)]
        (do
          (println (__opt_some? result2))   ;; true
          (println (__opt_unwrap result2))))) ;; 49

    ;; Test 3: TY5 -- single-capture closure, no manual cast or custom helper.
    ;; Fat closure captures let-bound `n`; passed directly to .fmap; result 15.
    (let [n 5]
      (let [opt3 (__opt_some 10)]
        (let [result3 (.fmap opt3 (fn [x] (+ x n)))]
          (do
            (println (__opt_some? result3))   ;; true
            (println (__opt_unwrap result3)))))) ;; 15

    ;; Test 4: TY5 -- multi-capture closure, no manual cast or custom helper.
    ;; Fat closure captures `a` and `b`; passed directly to .fmap; result 17.
    (let [a 3]
      (let [b 4]
        (let [opt4 (__opt_some 10)]
          (let [result4 (.fmap opt4 (fn [x] (+ x (+ a b))))]
            (do
              (println (__opt_some? result4))   ;; true
              (println (__opt_unwrap result4))))))) ;; 17
    0))
