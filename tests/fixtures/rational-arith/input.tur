;; rational-arith -- exact Rational arithmetic, and `+`/`-`/`*`/`/` reaching it
;; through the N0 builtin-miss -> Num typeclass dispatch.
;;
;; The headline case is 1/3 + 1/6 = 1/2 EXACTLY -- the sum floats get wrong.
;; The operator forms and the named rat/* forms must agree, because `+` on a
;; type with no builtin operator row is defined to be `Num.add`.
(load "stdlib/rational.tur")

(defn pr [r : Rational] : void
  (let [s (rat->string r)]
    (do (println (string/to-cstr s)) (string/release s))))

(defn main [] : int
  ;; Exact addition -- 1/3 + 1/6 is 1/2 on the nose.
  (pr (rat/add #rat{1/3} #rat{1/6}))
  (pr (+ #rat{1/3} #rat{1/6}))
  ;; ... where the float route rounds twice on the way: neither 1/3 nor 1/6 is
  ;; a dyadic fraction, so `0.3333... + 0.1666...` only lands near 0.5.  The
  ;; rational sum is 1/2 first and converts once, at the very end.
  (println (rat->float (+ #rat{1/3} #rat{1/6})))
  ;; The classic 1/3 + 1/3 + 1/3 = 1, exact.
  (pr (+ #rat{1/3} #rat{1/3} #rat{1/3}))
  ;; Subtraction / negation.
  (pr (rat/sub #rat{1/2} #rat{1/6}))
  (pr (- #rat{1/2} #rat{1/6}))
  (pr (rat/neg #rat{3/4}))
  (pr (- #rat{3/4}))
  ;; Multiplication cross-cancels: (2/3)(3/4) = 1/2, never 6/12.
  (pr (rat/mul #rat{2/3} #rat{3/4}))
  (pr (* #rat{2/3} #rat{3/4}))
  (pr (* #rat{2/3} #rat{3/4} #rat{1/5}))
  ;; Division and reciprocal.
  (pr (rat/div #rat{1/2} #rat{3/4}))
  (pr (/ #rat{1/2} #rat{3/4}))
  (pr (rat/recip #rat{-3/4}))
  ;; Sums that stay exact across many terms.
  (pr (+ #rat{1/2} #rat{1/3} #rat{1/7} #rat{1/42}))
  ;; Primitive arithmetic is untouched -- the builtin row still wins.
  (println (+ 1 2 3))
  (println (* 2.5 4.0))
  (println (- 10 3))
  0)
