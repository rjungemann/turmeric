#lang r7rs
;; The Scheme half: one turn on the shared map, the garbage between turns,
;; the churner's loop, and the check.  `step!` runs with the crew's mutex
;; held, so `n`, the map and `present` change one turn at a time.
(define-library (stress)
  (export step! garbage! churn! checksum)
  (import (scheme base) (turmeric sharedmap))
  (begin
    (define slots 97)
    (define present (make-vector slots #f))
    (define n 0)
    (define (value k) (list k (* k k) (number->string k) (make-vector 3 k)))
    (define (step!)
      (set! n (+ n 1))
      (let ((k (modulo (* n 7) slots)))
        (sm-assoc! k (value k))
        (vector-set! present k #t))
      (if (= 0 (modulo n 3))
          (let ((d (modulo (* n 11) slots)))
            (sm-dissoc! d)
            (vector-set! present d #f)))
      #t)
    (define (garbage!)
      (length (list n n n n))
      (make-vector 24 n)
      (string-append "g" (number->string n))
      #t)
    (define (churn!)
      (let lp ((i 10000))
        (cond ((= i 0) #t)
              (else (list i i i)
                    (make-string 40 #\a)
                    ;; a large object (over 32 KiB) now and then
                    (if (= 0 (modulo i 500)) (make-vector 5000 i))
                    (lp (- i 1))))))
    (define (checksum)
      (let lp ((k 0) (count 0) (ok #t))
        (if (= k slots)
            (list 'turns n 'present count 'map-count (sm-count) 'intact ok)
            (if (vector-ref present k)
                (lp (+ k 1) (+ count 1) (and ok (equal? (sm-get k) (value k))))
                (lp (+ k 1) count ok)))))))
