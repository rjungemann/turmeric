;; KB-004 regression: (:: carrier (Result int int)) -> ok-val
;;
;; The subject of this fixture is the carrier->struct `::` bridge: a function
;; returns the int64_t Result carrier, the caller ascribes it to
;; (Result int int) via ::, and the emitter must bridge the carrier to the
;; concrete Result__int__int struct so that ok-val (which takes the struct by
;; value) receives the right type.
;;
;; NOTE: double-if-ok deliberately stays on the inline-C carrier ABI.  It used
;; to call result-map, but result-map is now by-value (Track A retype); this
;; fixture keeps a dedicated carrier producer so the KB-004 bridge stays
;; covered independently of result-map's signature.

(defn double-if-ok [r : int] : int
  ```c
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *res = (void*)(intptr_t)r;
  if (!res) return 0;
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *out = malloc(sizeof(*out));
  out->tag = res->tag;
  if (res->tag == 0) out->as.ok_val = res->as.ok_val * 2;
  else               out->as.err_val = res->as.err_val;
  return (int64_t)(intptr_t)out;
  ```)

(defn main [] : int
  (let [r (double-if-ok (ok 21))
        v (ok-val (:: r (Result int int)))]
    (println v)
    0))
