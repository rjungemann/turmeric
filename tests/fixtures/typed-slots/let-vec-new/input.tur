;; KB-010 regression: (let [v []:int]) should compile cleanly
;;
;; vec-new returns :int (carrier ABI).  When the result is ascribed to (Vec int)
;; via ::, the emitter previously produced Vec__int v = vec_new(); which is a
;; C-level type error (int64_t assigned to struct).  The bridge in the EX_ASCRIBE
;; emission path now inserts a pointer dereference so the declaration is correct.

(defn main [] :int
  (let [v []:int]
    (println "allocated")
    0))
