(defn main [] : int
  (let [o  (:: (some 2.5) (Option float))
        p  (:: (make-struct Pair 1 2.5) (Pair int float))
        r1 (:: (ok 3.75) (Result float cstr))
        r2 (:: (err "err") (Result float cstr))]
    (println (unwrap o))
    (println (pair-fst p))
    (println (pair-snd p))
    (println (ok-val r1))
    (println (err-val r2))
    0))
