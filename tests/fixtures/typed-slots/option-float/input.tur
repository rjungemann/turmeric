;; TS3.4: typed Option[float] round-trips a float through a typed payload
;; slot.  The `value` field is read as a `double` from the Option__float
;; layout -- no user-side bit-cast.

(defn main [] : int
  (let [o (:: (some 2.5) (Option float))]
    (println (some? o))
    (println (unwrap o))
    (println (unwrap o)))
  ;; A none-shaped Option[float] still carries a typed (but unused) payload.
  (let [n (:: (none) (Option float))]
    (println (some? n)))
  0)
