(defn id-explicit [A] [x :A] :A
  x)

(defn id-explicit-spaced [A] [x : A] : A
  x)

(defn id-implicit [a x : a] : a
  x)

(defn main [] : int
  (println (id-explicit 3))
  (println (id-explicit-spaced 2.5))
  (println ((fn [A] [x :A] :A x) 4.5))
  (println (id-implicit 7))
  (println (id-implicit 2.5))
  0)
