;; arc-basic -- Arc<T>, atomic reference counting, through stdlib/arc.tur.
;;
;; This fixture used to hand-roll its OWN control block in inline C:
;;   struct { uint64_t strong; uint64_t weak; int64_t value; }
;; which had already drifted from the real ArcControlBlock in
;; src/runtime/arc.h (that one carries `value` as a pointer plus a drop_fn and
;; a type kind). The runtime existed the whole time; what was missing was a
;; language surface over it, so the only user in the tree reimplemented it and
;; the two definitions diverged unnoticed -- the same shape as the HttpdConn
;; redeclaration defect. See docs/archive/stdlib-arc-surface-missing.md.
;;
;; The assertions below are unchanged from that version; only the
;; implementation moved to the shared module, so this now exercises the real
;; runtime rather than a copy of it.

(defmodule app
  (import arc :refer [arc-new arc-clone arc-get arc-strong-count arc-drop])

  (defn main [] : int
    ;; create
    (let [a (arc-new 42)]
      (println (arc-get a))
      (println (arc-strong-count a))

      ;; clone -- same underlying block, strong count increases
      (let [b (arc-clone a)]
        (println (arc-strong-count a))
        (println (arc-get b))

        ;; drop clone -- strong count back to 1
        (arc-drop b)
        (println (arc-strong-count a)))

      ;; drop original
      (arc-drop a))
    0))
