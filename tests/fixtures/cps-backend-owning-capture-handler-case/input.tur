;; CPS-IR-to-C backend, env-capture story E1 + Track B (leak-clean owning
;; capture): an OWNING value (an `rc<int>` handle) captured into a genuinely
;; MULTI-SHOT handler CASE body.  Built with the always-on cps-backend.
;;
;; A handler case body runs once *per perform* -- potentially many times in a
;; loop -- so it is classified MULTI-SHOT (collect_caps_case forces
;; g_cap_single_shot = false).  Before E1 an owning capture there failed the
;; Copy-only capture gate (cap_ty_ok) and the whole function fell back to the
;; direct emitter.  E1 admits an rc handle through the cap_owning_ok gate.
;;
;; Track B (leak-clean): the reachable owning-capture-into-a-case shape is
;; BORROW-ONLY -- the case reads the handle (here `(rc/strong-count r)`) but does
;; not consume it; the enclosing `f` owns it and drops it exactly once on its
;; straight-line path.  (A case that consumes the capture without `f` also
;; consuming it evicts upstream: the fn's scope-exit auto-drop becomes an
;; unlowered EX_DEFER -- see
;; docs/archive/cps-handler-case-consumes-owning-capture-evicts.md.)  So the
;; capture rides the multi-shot env by a BARE SHALLOW ALIAS
;; (owning_cap_borrow_only downgrades it): no incref on read-out, no env clone --
;; leak-clean, and the observed strong count is EXACT (1, not the inflated 2 an
;; incref-on-read-out would show).  This is the reachable-shape realization of the
;; env-capture plan's leak-clean bar without a DK-node teardown.
;;
;; Ownership (verified by inspecting the emitted C):
;;   rc/of       -> r refcount 1
;;   case body   -> reads r out of the shared env by a bare alias (no incref) and
;;                  observes (rc/strong-count r) = 1
;;   post-handle -> the single straight-line (rc/drop r) brings it to 0 and frees.
;; No incref, no double-free, no leak: runs under normal LeakSanitizer.
;;
;; A *consuming* multi-shot capture (an rc dropped in the case AND straight-line
;; in the fn -- the rare double-consume that still reaches CPS) keeps the
;; memory-safe incref-on-read-out (Option A) path instead; that is unchanged.
;;
;; Value: g performs E once; the case resumes with (rc/strong-count r) = 1, so g
;; returns 1 and f returns 1.

(defeffect E [] :int)

(defn g [] : int
  (perform (E)))

(defn f [] : int
  (let [r (rc/of 5)]
    (let [v (handle (g)
              (E [] k)
              (resume k (rc/strong-count r)))]
      (rc/drop r)
      v)))

(defn main [] : int
  (println (f))
  0)
