; Combining plain ADTs and GADTs
(defdata Color :copy (Red) (Green) (Blue))

(defgadt Expr [a]
  (Lit int : (Expr int))
  (Add (Expr int) (Expr int) : (Expr int)))

(defn color-ok?-int [c] :int
  (match c
    (Red)   1
    (Green) 2
    (Blue)  3))

(defn eval-expr [e] :int
  (match e
    (Lit n)   n
    (Add l r) (+ (eval-expr l) (eval-expr r))))

(defn main [] :int
  (println (color-ok?-int (Red)))
  (println (eval-expr (Add (Lit 10) (Lit 20))))
  (println (color-ok?-int (Green)))
  0)
