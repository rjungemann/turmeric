;; FH5: compose two handler values over disjoint effects and apply the result.
;; Equivalent to nested (handle (handle body Tell) Ask); h1 (Ask) is the outer
;; handler per FH0.1.  Ask resumes with 42; the body prints "got-42" to prove
;; the resumed value flows back, then main returns 0.
(defeffect Ask [] :int)
(defeffect Tell [s :cstr] :nil)
(defn main [] : int
  (with-handler
    (compose-handlers
      (handler (Ask [] k) (do (println "ask-handled") (resume k 42)))
      (handler (Tell [s] k) (do (println s) (resume k nil))))
    (do (perform (Tell "tell-a"))
        (perform (Tell "tell-b"))
        (if (= (perform (Ask)) 42)
          (do (println "got-42") 0)
          1))))
