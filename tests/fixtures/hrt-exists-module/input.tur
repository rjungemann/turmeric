; Phase HRT2 / EX1d: counerr? module with hidden state.
; The counerr?'s inerr?nal int is hidden behind an existential (void*).
;
; Phase EX1d makes `(open c [a v] v)` reject: returning the existentially-
; bound value directly would let the abstract type leak out of the open
; scope.  Instead, we expose a `counerr?-print` helper that consumes v
; inside the open and yields :nil; the increment helper repacks before
; the open expression's tail, so v never appears in the tail position.
(defn make-counerr? [n :int] :ptr<void>
  (pack n (exists [a] a)))

(defn counerr?-print [c :ptr<void>] :nil
  (open c [a v]
    (println v)))

(defn counerr?-incr [c :ptr<void>] :ptr<void>
  (open c [a v]
    (pack (+ v 1) (exists [a] a))))

(defn main [] :int
  (let [c0 (make-counerr? 0)
        c1 (counerr?-incr c0)
        c2 (counerr?-incr c1)
        c3 (counerr?-incr c2)]
    (counerr?-print c3))
  0)
