;;
;; Phase TM0: tmap equality test

(defn test-eq-empty [] :bool
  (let [a (tmap-new)]
    (let [b (tmap-new)]
      (let [result (tmap-eq? a b (fn [x y] (= x y)))]
        (tmap-free a)
        (tmap-free b)
        result))))

(defn test-eq-same [] :bool
  (let [a (tmap-new)]
    (let [b (tmap-new)]
      (let [a2 (tmap-assoc a 1 10)]
        (let [b2 (tmap-assoc b 1 10)]
          (let [result (tmap-eq? a2 b2 (fn [x y] (= x y)))]
            (tmap-free a)
            (tmap-free b)
            (tmap-free a2)
            (tmap-free b2)
            result))))))

(defn test-eq-diff-val [] :bool
  (let [a (tmap-new)]
    (let [b (tmap-new)]
      (let [a2 (tmap-assoc a 1 10)]
        (let [b2 (tmap-assoc b 1 20)]
          (let [result (tmap-eq? a2 b2 (fn [x y] (= x y)))]
            (tmap-free a)
            (tmap-free b)
            (tmap-free a2)
            (tmap-free b2)
            result))))))

(println (test-eq-empty))
(println (test-eq-same))
(println (test-eq-diff-val))
