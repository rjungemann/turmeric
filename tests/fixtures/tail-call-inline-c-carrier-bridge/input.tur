;;
;; Regression: a pure-Turmeric `defn` whose declared return type is a
;; carrier-ABI aggregate (Option/Result) and whose body is a tail call to an
;; inline-C `defn` returning the same aggregate must emit the carrier->by-value
;; bridge at the return site.  Before the fix, the wrapper's signature was the
;; by-value struct but the inline-C callee returned int64_t and the generated
;; `return helper(...)` failed to type-check.  See
;; docs/archive/history/tail-call-inline-c-carrier-bridge.md.

(defn captures-get [caps : int key : cstr] : (Result cstr cstr)
  ```c return tur_box_ok((int64_t)(intptr_t)"ok-val"); ```)

(defn opt-get [k : int] : (Option cstr)
  ```c return tur_box_some((int64_t)(intptr_t)"some-val"); ```)

;; Plain tail call: pure-Turmeric wrapper around inline-C carrier helper.
(defn capture [caps : int name : cstr] : (Result cstr cstr)
  (captures-get caps name))

;; Option mirror.
(defn opt-wrap [k : int] : (Option cstr)
  (opt-get k))

;; if-branched tail.
(defn ifwrap [k : int] : (Result cstr cstr)
  (if (= k 0)
    (captures-get k "a")
    (captures-get k "b")))

;; do-block tail.
(defn dowrap [k : int] : (Result cstr cstr)
  (do
    (captures-get k "a")))

;; let-body tail.
(defn letwrap [k : int] : (Result cstr cstr)
  (let [_x 1]
    (captures-get k "b")))

(defn main [] : int
  (println (ok-val (capture 0 "x")))
  (println (unwrap (opt-wrap 0)))
  (println (ok-val (ifwrap 0)))
  (println (ok-val (dowrap 0)))
  (println (ok-val (letwrap 0)))
  0)
