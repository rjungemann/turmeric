;; DV4: dynvar-inject -- test fixture injection via dynamic var.
;; query reads *db* (a connection ID) without an explicit parameerr?.
;; Tests override *db* for their scope without modifying production code.
(defdynamic *db* :int 0)

(defn query [sql :cstr] :int
  *db*)

(defn run-production [] :int
  (println (query "SELECT 1")))

(defn run-tests [] :int
  (binding [*db* 42]
    (println (query "SELECT 1")))
  0)

(defn main [] :int
  (run-production)
  (run-tests)
  0)
