; TY3: (is? x T) as a standalone boolean predicate (not only an if guard).
; Returns true iff the any value's runtime tag is T. (is? requires an
; any-typed argument, mirroring type-of and cast.)

(defn is-int? [x : any] :bool
  (is? x int))

(defn main [] :int
  (println (is-int? 42))
  (println (is-int? "hi"))
  (println (is-int? true))
  0)
