;; Route B (constrained-hkt-lifted-lambda-keeps-representative-instance):
;; `pure` inside a LIFTED CONTINUATION -- `(bind x (fn [v] (pure ...)))` -- must
;; dispatch to the instance the CALLER chose, reading the Applicative dict from
;; the continuation's closure env (the nested-mapper dict lowering), never a
;; baked representative.
;;
;; The two instances tag `pure`'s payload differently (+100 vs +200), so a
;; representative-instance dispatch would print one number twice; 107 then 207
;; proves the continuation's `pure` went through the caller's dict.  This is the
;; decisive shape: it cannot pass by layout coincidence.
(defopaque T1 [a] :int)
(defn mk-t1  [A] [x : A] : (T1 A) ```c return (int64_t)x; ```)
(defn mk-t1b [A] [x : A] : (T1 A) ```c return (int64_t)x + 100; ```)
(defn un-t1  [A] [b : (T1 A)] : A ```c return (int64_t)b; ```)
(definstance Monad [T1] (bind [ma k] (k (un-t1 ma))))
(definstance Applicative [T1] (pure [x] (mk-t1b x)) (ap [ff fa] fa))

(defopaque T2 [a] :int)
(defn mk-t2  [A] [x : A] : (T2 A) ```c return (int64_t)x; ```)
(defn mk-t2b [A] [x : A] : (T2 A) ```c return (int64_t)x + 200; ```)
(defn un-t2  [A] [b : (T2 A)] : A ```c return (int64_t)b; ```)
(definstance Monad [T2] (bind [ma k] (k (un-t2 ma))))
(definstance Applicative [T2] (pure [x] (mk-t2b x)) (ap [ff fa] fa))

(defn btp [^m] [^Monad m ^Applicative m x : (m int)] : (m int)
  (bind x (fn [v] (pure (+ v 1)))))

(defn at-t1 [g (forall [(m :: * -> *)] [(Monad m) (Applicative m)] (-> (m int) (m int)))] : int
  (un-t1 (g (mk-t1 6))))
(defn at-t2 [g (forall [(m :: * -> *)] [(Monad m) (Applicative m)] (-> (m int) (m int)))] : int
  (un-t2 (g (mk-t2 6))))

(defn main [] : int
  (println (at-t1 btp))   ; want 107
  (println (at-t2 btp))   ; want 207
  0)
