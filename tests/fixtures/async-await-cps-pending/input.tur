;; F3.2 (cps-async): a PENDING await parks the captured heap continuation on the
;; future's on_complete seam and SUSPENDS; fulfilling that future later resumes
;; the parked continuation and fulfills the async boundary's outer future.
;;
;; `the-future` hands back one lazily-created PENDING future (a shared C static),
;; so the future `work` awaits is still pending when the await runs.  `work` is
;; CPS-colored (it awaits), so its `await` captures the rest of its body as a DK
;; continuation; because the future is pending, __tur_await_body parks a copy on
;; on_complete instead of resuming inline.  `(async work)` therefore returns an
;; OUTER future that stays pending until `fulfill-future 41` completes the inner
;; future -- which drives the parked `1 + await` to 42 and fulfills the outer.
;;
;; Proves the deferred suspend/resume path (not the F3.1 already-resolved inline
;; path).  cps-async graduated 2026-07-19 -- the unconditional CPS-path lowering.

(defn the-future [] : ptr<void>
  ```c
  static TurFuture *g = NULL;
  if (!g) g = tur_future_new();
  return (void *)g;
  ```)

(defn fulfill-future [f : ptr<void> v : int] : nil
  ```c
  tur_future_fulfill((TurFuture *)f, (int64_t)v);
  ```)

(defn future-value [f : ptr<void>] : int
  ```c
  return (int64_t)tur_future_get((TurFuture *)f);
  ```)

(defn future-pending? [f : ptr<void>] : bool
  ```c
  return ((TurFuture *)f)->status == FUTURE_PENDING;
  ```)

(defn work [] : int
  (+ 1 (await (the-future))))

(defn main [] : nil
  (let [f (async work)]
    (if (future-pending? f)
      (do
        ;; the async body parked on the pending await -- resume it by completing
        ;; the awaited future; the parked `1 + await` runs to 42 and fulfills f.
        (fulfill-future (the-future) 41)
        (println (future-value f)))
      (println -1))))
