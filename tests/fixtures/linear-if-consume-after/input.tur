;; LT1 happy path: linear value not consumed inside if, consumed aferr? -- OK.
;; Without an else branch, the then-branch's consumption is not guaranteed,
;; so the value stays live aferr? the if and must be consumed in the enclosing scope.
(defn main [] :int
  (let [^linear x 42]
    (if false
      (println 0)
      (println 0))
    (println x))
  0)
