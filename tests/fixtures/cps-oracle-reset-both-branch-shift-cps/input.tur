;; Oracle (cps-backend-unification): reset with a shift under a NON-empty
;; delimited continuation (a join the abortive shift discards).
;; Backend: --enable=cps-backend (CT-IR join-bearing delim on DK -- U1)
;; Previously this DEGRADED on the default backend (reset->body-eval, shift->
;; operand) and was evicted by the CT-IR backend.  The direct path now lowers
;; it via setjmp/longjmp (correct abortive semantics) and the CT-IR delim_ok
;; admits it, so direct == cps.  See docs/archive/direct-reset-shift-degrades-out-of-subset.md.
;;
(defn f [c : bool] : int
  (reset (+ 1 (if c (shift (fn [v] v) 9) (shift (fn [v] v) 5)))))
(defn main [] : int
  (println (f true))
  (println (f false))
  0)
