;; constrained-generic-instance-vec-element-unascribed -- a constrained
;; parametric instance body must dispatch a class method on its ELEMENT type
;; even when the element is read through an UNASCRIBED carrier helper
;; (`(tag (vec-get v i))`, with no `(:: e A)` ascription).
;;
;; Root cause (docs/archive/history/unascribed-carrier-helper-read-collapses-element-tyvar.md):
;; `vec-get` is the generic carrier helper `(defn vec-get [A] [v : (Vec A)
;; i : int] : A ...)`.  Its `:A` result is summarized to the int64 carrier
;; (TY_INT) at elaboration, so the `tag` receiver's elaborated type is TY_INT --
;; elaboration matches `Tag[int]` exactly and emit's dispatch re-resolver
;; (emit_core.c:emit_reresolve_disp_type) saw no tyvar to re-resolve, leaving the
;; baked `int` representative.  An explicit `(:: (vec-get v i) A)` worked around
;; it (see constrained-generic-instance-vec-element-dispatch); this fixture pins
;; the *unascribed* form.
;;
;; Fix: emit_reresolve_disp_type recovers the element tyvar from the carrier
;; helper's own signature -- its `result_full_type` is the type-param `R`, which
;; also occurs in a parameter's declared full type (`v : (Vec R)`); structurally
;; matching that parameter against the actual argument's `(Vec A)` recovers the
;; constraint var `A`, which then grounds per ABI specialization.

;; --- Case 1: mis-dispatch with an int instance present (Tag : a -> int). ---
(defclass Tag [a] (tag [x] : int))
(definstance Tag [int]  (tag [x] 1))
(definstance Tag [bool] (tag [x] 2))

(definstance Tag [Vec] [(Tag A)]
  (tag [x]
    (let [v (:: x (Vec A))]
      (if (>= (vec-len v) 1)
        (tag (vec-get v 0))   ;; unascribed -- must still dispatch on the element
        0))))

;; --- Case 2: no int instance -- only cstr + float (json-container shape). ---
(defclass Enc [a] (enc [x] : cstr))
(definstance Enc [cstr]  (enc [x] x))
(definstance Enc [float] (enc [x] "F"))

(definstance Enc [Vec] [(Enc A)]
  (enc [x]
    (let [v (:: x (Vec A))]
      (if (>= (vec-len v) 1)
        (enc (vec-get v 0))   ;; unascribed
        "empty"))))

(defn main [] : int
  (let [vi (:: (vec-new) (Vec int))
        vb (:: (vec-new) (Vec bool))
        vs (:: (vec-new) (Vec cstr))
        vf (:: (vec-new) (Vec float))]
    (vec-push! vi 7)
    (vec-push! vb true)
    (vec-push! vs "hello")
    (vec-push! vf 3.25)
    (println (tag vi))   ;; Tag[int]  -> 1
    (println (tag vb))   ;; Tag[bool] -> 2 (not Tag[int] -> 1)
    (println (enc vs))   ;; Enc[cstr] -> hello
    (println (enc vf))   ;; Enc[float] -> F
    0))
