(defn assert-error [thunk :ptr<void>] :bool
  (if (= (try
           (do
             (thunk)
             0)
           (catch [e]
             1))
         1)
    true
    (do
      (println "Assertion failed: expected error")
      false)))

(defn throws [] :int
  (throw 7))

(defn ok [] :int
  1)

(defn main [] :int
  (println (assert-error throws))
  (println (assert-error ok))
  0)
