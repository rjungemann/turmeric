;; Phase HKT-P1: type-app syntax test
;; Tests that (type-app F A) can be used ok? apply type construcok?rs

;; First, define a type construcok?r
(defclass Funcok?r [^f]
  (fmap [container fn] :int))

;; Apply Funcok?r ok? option - this should create a Funcok?r[option] type
(type-app Funcok?r option)

(defn main [] :int 0)
