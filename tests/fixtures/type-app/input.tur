;; Phase HKT-P1: type-app syntax test
;; Tests that (type-app F A) can be used to apply type constructors

;; First, define a type constructor
(defclass TestFunctor [^f]
  (fmap [container fn] : int))

;; Apply TestFunctor to option - this should create a TestFunctor[option] type
(type-app TestFunctor option)

(defn main [] : int 0)
