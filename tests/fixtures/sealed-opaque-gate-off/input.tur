;; sealed-opaque, gate OFF: `:sealed` still PARSES and imposes nothing without
;; --enable=sealed-opaque. This is deliberate -- a parse error would make
;; adopting :sealed in a spice a breaking change for every consumer who has not
;; opted into the experiment, which is the opposite of what an opt-in prototype
;; should cost. Note there is no `flags` file here: that is the point.
;;
;; The cast below is the very one TUR-E0302 rejects when the gate is on. It is
;; in the same module here, so it would be legal either way; what this fixture
;; pins is that the ATTRIBUTE alone does not change compilation.
(defopaque Tok :int :sealed)

(defn tok-new [n : int] : Tok (:: n Tok))
(defn tok-num [t : Tok] : int (:: t :int))

(defn main [] : int
  (println (tok-num (tok-new 42)))
  0)
