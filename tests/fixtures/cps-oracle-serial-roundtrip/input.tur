;; CPS regression oracle (cps-backend-unification): pins the runtime value.
;; See docs/archive/cps-backend-unification-u0-inventory.md.
;;
;; Phase 21: Serializable typeclass -- primitive round-trip test
;;
;; Tests that serialize + deserialize is the identity for int, bool, and cstr.

(load "stdlib/serial.tur")

(extern-c printf [^cstr fmt ^int v] :int)

;; Helper: check int round-trip
(defn check-int [expected : int] : int
  (let [b (.serialize expected)]
    (let [got (__inst_Serializable_deserialize_int b)]
      (if (= got expected)
        (do
          (printf "int ok: %ld\n" expected)
          1)
        (do
          (printf "int FAIL: got %ld\n" got)
          0)))))

;; Helper: check bool round-trip
(defn check-bool [expected : bool] : int
  (let [b (.serialize expected)]
    (let [got (__inst_Serializable_deserialize_bool b)]
      (if (= got expected)
        (do
          (printf "bool ok: %ld\n" (if expected 1 0))
          1)
        (do
          (printf "bool FAIL\n")
          0)))))

(defn main [] : int
  (do
    (check-int 0)
    (check-int 42)
    (check-int -1)
    (check-bool true)
    (check-bool false)
    0))
