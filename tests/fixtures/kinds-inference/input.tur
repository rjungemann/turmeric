;; Phase HKT §2: Kind inference from definstance usage.
;; 'TestFunctor' is declared with plain [f] (no ^f annotation).
;; The kind of f is inferred as * -> * from the definstance [option] declaration.

(defclass TestFunctor [f]
  (fmap [container fn] : int))

(defn __opt_some [x] : int
  ```c
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true; r->value = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn __opt_unwrap [o] : int
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return (int64_t)(p->value);
  ```)

(defn __fmap_option [container fn] : int
  ```c
  struct { bool is_some; int64_t value; } *c =
      (void *)(intptr_t)container;
  if (!c || !c->is_some) return 0;
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = ((int64_t(*)(int64_t))(intptr_t)fn)(c->value);
  return (int64_t)(intptr_t)r;
  ```)

;; No ^f on TestFunctor, yet this instance provides a KIND_ARROW type arg.
;; The kind-check pass infers TestFunctor param[0] : * -> * from this.
(definstance TestFunctor [option]
  (fmap [container fn] (__fmap_option container fn)))

(defn double-it [x] : int (* x 2))

(defn main [] : int
  (do
    (let [o (__opt_some 7)]
      (let [o2 (.fmap o double-it)]
        (println (__opt_unwrap o2))))  ;; 14
    0))
