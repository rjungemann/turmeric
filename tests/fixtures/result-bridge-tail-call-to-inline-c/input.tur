;; result-bridge-tail-call-to-inline-c -- a pure-Turmeric defn whose declared
;; return type is a by-value carrier-ABI aggregate ((Result cstr cstr)) and
;; whose body is a tail call to an inline-C helper that returns the same
;; declared type.
;;
;; The inline-C helper is lowered with the carrier ABI (C return type
;; `int64_t`), but the pure-Turmeric wrapper is lowered with the by-value
;; struct ABI (C return type `Result__cstr__cstr`).  The return-position
;; lowering must insert the carrier->by-value bridge at the tail call site --
;; the same bridge that already fires for #{Construct} and __inst_ tail
;; leaves.  Without the fix, codegen emits a bare
;; `return inlineC_helper(...);` and cc rejects with "incompatible types when
;; returning type 'int64_t' but 'Result__cstr__cstr' was expected".
;;
;; Regression for docs/archive/history/result-bridge-tail-call-from-pure-tur-to-inline-c.md.

(defn captures-get [caps : int key : cstr] : (Result cstr cstr)
  ```c
  return tur_box_ok((int64_t)(intptr_t)"hello");
  ```)

(defn captures-fail [caps : int key : cstr] : (Result cstr cstr)
  ```c
  return tur_box_err((int64_t)(intptr_t)"missing");
  ```)

;; Pure-Turmeric wrapper: tail call to inline-C carrier helper, declared as a
;; by-value (Result cstr cstr).
(defn capture [caps : int name : cstr] : (Result cstr cstr)
  (captures-get caps name))

(defn capture-fail [caps : int name : cstr] : (Result cstr cstr)
  (captures-fail caps name))

(defn main [] : int
  (println (ok-val  (capture       0 "x")))
  (println (err-val (capture-fail  0 "y")))
  0)
