;; Phase T23: workstealing-balance — verify work distributes across threads.
;;
;; Creates 2 OS threads, each with its own work-stealing deque.
;; Main pushes 8 items into deque[0].
;; Thread-0 pops from its own deque; thread-1 steals from deque[0].
;; Both threads atomically increment a shared counter per processed item.
;;
;; Inlined work-stealing deque — test binaries are single-TU and do not
;; link scheduler.c separately.
;;
;; Expected output:
;;   items-processed: 8

;; ---------------------------------------------------------------------------
;; BWsd typedef (redeclared in every function that touches the struct)
;; ---------------------------------------------------------------------------

;; Global BalState accessor: pass a real ptr to set, call g_state(NULL)
;; from C blocks to get.
(defn g-state [set-to : ptr<void>] : ptr<void>
  ```c
  static void *s = NULL;
  if (set_to) s = set_to;
  return s;
  ```)

;; Allocate a work-stealing deque with the given power-of-2 capacity.
(defn bwsd-new [cap : int] : ptr<void>
  ```c
  typedef struct {
      void  **buffer;
      size_t  capacity;
      size_t  mask;
      size_t  top;
      size_t  bottom;
  } BWsd;
  BWsd *d = (BWsd *)calloc(1, sizeof(BWsd));
  if (!d) { fprintf(stderr, "bwsd-new: oom\n"); abort(); }
  d->buffer = (void **)calloc((size_t)cap, sizeof(void *));
  if (!d->buffer) { free(d); fprintf(stderr, "bwsd-new: buf oom\n"); abort(); }
  d->capacity = (size_t)cap;
  d->mask     = (size_t)cap - 1;
  __atomic_store_n((size_t *)&d->top,    (size_t)0, __ATOMIC_RELAXED);
  __atomic_store_n((size_t *)&d->bottom, (size_t)0, __ATOMIC_RELAXED);
  return (void *)d;
  ```)

;; Push an item (owner / bottom side).
(defn bwsd-push [d : ptr<void> item : ptr<void>] : nil
  ```c
  typedef struct {
      void  **buffer;
      size_t  capacity;
      size_t  mask;
      size_t  top;
      size_t  bottom;
  } BWsd;
  BWsd *dq = (BWsd *)d;
  size_t b = __atomic_load_n((size_t *)&dq->bottom, __ATOMIC_RELAXED);
  size_t t = __atomic_load_n((size_t *)&dq->top,    __ATOMIC_ACQUIRE);
  if (b - t >= dq->capacity) { fprintf(stderr, "bwsd-push: full\n"); abort(); }
  dq->buffer[b & dq->mask] = item;
  __atomic_store_n((size_t *)&dq->bottom, b + 1, __ATOMIC_RELEASE);
  ```)

;; Pop from the bottom (owner side); returns 0 / NULL if empty.
(defn bwsd-pop [d : ptr<void>] : ptr<void>
  ```c
  typedef struct {
      void  **buffer;
      size_t  capacity;
      size_t  mask;
      size_t  top;
      size_t  bottom;
  } BWsd;
  BWsd *dq = (BWsd *)d;
  size_t b = __atomic_load_n((size_t *)&dq->bottom, __ATOMIC_ACQUIRE);
  size_t t = __atomic_load_n((size_t *)&dq->top,    __ATOMIC_ACQUIRE);
  if (b == t) return NULL;
  b--;
  void *item = dq->buffer[b & dq->mask];
  __atomic_store_n((size_t *)&dq->bottom, b, __ATOMIC_RELEASE);
  return item;
  ```)

;; Steal from the top (thief / CAS side); returns 0 / NULL on failure.
(defn bwsd-steal [d : ptr<void>] : ptr<void>
  ```c
  typedef struct {
      void  **buffer;
      size_t  capacity;
      size_t  mask;
      size_t  top;
      size_t  bottom;
  } BWsd;
  BWsd *dq = (BWsd *)d;
  size_t t   = __atomic_load_n((size_t *)&dq->top,    __ATOMIC_ACQUIRE);
  size_t bot = __atomic_load_n((size_t *)&dq->bottom, __ATOMIC_ACQUIRE);
  if (bot == t) return NULL;
  void *item = dq->buffer[t & dq->mask];
  if (__atomic_compare_exchange_n((size_t *)&dq->top, &t, t + 1,
                                   0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
      return item;
  }
  return NULL;
  ```)

;; Free a deque.
(defn bwsd-free [d : ptr<void>] : nil
  ```c
  typedef struct {
      void  **buffer;
      size_t  capacity;
      size_t  mask;
      size_t  top;
      size_t  bottom;
  } BWsd;
  BWsd *dq = (BWsd *)d;
  free(dq->buffer);
  free(dq);
  ```)

;; Worker thread: pop from own deque, steal from deques[1-idx].
;; arg = thread index (0 or 1) packed as (void *)(intptr_t)idx.
;; BalState is accessed via g_state(NULL) — a direct C call to the
;; Turmeric-generated g_state function (forward-declared in same TU).
(defn bal-worker [arg : ptr<void>] : ptr<void>
  ```c
  typedef struct {
      void  **deques;   /* void *[2] */
      int64_t counter;  /* items processed so far (atomic) */
      int64_t target;
      pthread_mutex_t done_lock;
      pthread_cond_t  done_cond;
  } BalState;
  /* g_hystate is the C name for Turmeric's g-state function */
  BalState *state = (BalState *)g_hystate(NULL);
  int my    = (int)(intptr_t)arg;
  int other = 1 - my;
  void **deques = (void **)state->deques;

  while (1) {
      int64_t cnt = __atomic_load_n(&state->counter, __ATOMIC_ACQUIRE);
      if (cnt >= state->target) break;

      /* Try own deque, then steal */
      void *item = bwsd_hypop(deques[my]);
      if (!item) item = bwsd_hysteal(deques[other]);

      if (item) {
          int64_t new_cnt = __atomic_add_fetch(&state->counter, 1, __ATOMIC_SEQ_CST);
          if (new_cnt >= state->target) {
              pthread_mutex_lock(&state->done_lock);
              pthread_cond_broadcast(&state->done_cond);
              pthread_mutex_unlock(&state->done_lock);
          }
      } else {
          /* Yield briefly to avoid busy-spin hogging a core */
          struct timespec ts = { .tv_sec = 0, .tv_nsec = 100000 };
          nanosleep(&ts, NULL);
      }
  }
  return NULL;
  ```)

;; Spawn 2 worker threads with function pointer fn.
;; Returns a malloc'd pthread_t[2] — caller must join and free.
(defn launch-workers [fn : ptr<void>] : ptr<void>
  ```c
  pthread_t *threads = (pthread_t *)malloc(2 * sizeof(pthread_t));
  if (!threads) { fprintf(stderr, "launch-workers: oom\n"); abort(); }
  for (int i = 0; i < 2; i++) {
      pthread_create(&threads[i], NULL,
                     (void *(*)(void *))fn,
                     (void *)(intptr_t)i);
  }
  return (void *)threads;
  ```)

;; Join 2 worker threads and free the handle array.
(defn join-workers [handles : ptr<void>] : nil
  ```c
  pthread_t *threads = (pthread_t *)handles;
  for (int i = 0; i < 2; i++) pthread_join(threads[i], NULL);
  free(threads);
  ```)

;; Allocate and initialise a BalState; sets the global via g-state.
(defn make-state [deque0 : ptr<void> deque1 : ptr<void> n : int] : ptr<void>
  ```c
  typedef struct {
      void  **deques;
      int64_t counter;
      int64_t target;
      pthread_mutex_t done_lock;
      pthread_cond_t  done_cond;
  } BalState;
  void **dq = (void **)malloc(2 * sizeof(void *));
  if (!dq) { fprintf(stderr, "make-state: oom\n"); abort(); }
  dq[0] = deque0;
  dq[1] = deque1;
  BalState *s = (BalState *)calloc(1, sizeof(BalState));
  if (!s) { free(dq); fprintf(stderr, "make-state: oom\n"); abort(); }
  s->deques  = dq;
  __atomic_store_n(&s->counter, (int64_t)0, __ATOMIC_RELAXED);
  s->target  = (int64_t)n;
  pthread_mutex_init(&s->done_lock, NULL);
  pthread_cond_init(&s->done_cond, NULL);
  /* Register in global so bal_hyworker can find it */
  g_hystate((void *)s);
  return (void *)s;
  ```)

;; Wait until all items are processed, then return the final count.
(defn wait-done [state : ptr<void>] : int
  ```c
  typedef struct {
      void  **deques;
      int64_t counter;
      int64_t target;
      pthread_mutex_t done_lock;
      pthread_cond_t  done_cond;
  } BalState;
  BalState *s = (BalState *)state;
  pthread_mutex_lock(&s->done_lock);
  while (__atomic_load_n(&s->counter, __ATOMIC_ACQUIRE) < s->target) {
      pthread_cond_wait(&s->done_cond, &s->done_lock);
  }
  pthread_mutex_unlock(&s->done_lock);
  return (int64_t)__atomic_load_n(&s->counter, __ATOMIC_ACQUIRE);
  ```)

;; Print final count to stdout.
(defn print-count [count : int] : nil
  ```c
  printf("items-processed: %lld\n", (long long)count);
  ```)

;; Free a BalState (call after all workers have joined).
(defn free-state [state : ptr<void>] : nil
  ```c
  typedef struct {
      void  **deques;
      int64_t counter;
      int64_t target;
      pthread_mutex_t done_lock;
      pthread_cond_t  done_cond;
  } BalState;
  BalState *s = (BalState *)state;
  pthread_mutex_destroy(&s->done_lock);
  pthread_cond_destroy(&s->done_cond);
  free(s->deques);
  free(s);
  ```)

(defn main [] : int
  (let [d0 (bwsd-new 16)]
    (let [d1 (bwsd-new 16)]
      ;; Push 8 sentinel items into deque[0]
      (bwsd-push d0 d0)
      (bwsd-push d0 d0)
      (bwsd-push d0 d0)
      (bwsd-push d0 d0)
      (bwsd-push d0 d0)
      (bwsd-push d0 d0)
      (bwsd-push d0 d0)
      (bwsd-push d0 d0)
      ;; Build shared state (also registers it as global for workers)
      (let [state (make-state d0 d1 8)]
        ;; Spawn workers
        (let [handles (launch-workers bal-worker)]
          ;; Wait for all items to be consumed
          (let [count (wait-done state)]
            ;; Join and print
            (join-workers handles)
            (print-count count)
            (free-state state)
            (bwsd-free d0)
            (bwsd-free d1)
            0))))))
