;; Phase HKT H4: Implicit kind inference from usage.
;; When a function uses a typeclass method call (.fmap container fn),
;; the kind of the container's type constructor is inferred from the
;; typeclass definition.  No explicit ^f annotation is required when
;; the typeclass method already documents the kind requirement.


(defclass TestFunctor [^f]
  (fmap [container fn] : int))

(defn __opt_some [x] : int
  ```c
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true; r->value = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn __opt_unwrap [o] : int
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return (int)(p->value);
  ```)

(defn __fmap_option [container fn] : int
  ```c
  struct { bool is_some; int64_t value; } *c =
      (void *)(intptr_t)container;
  if (!c || !c->is_some) return 0;
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = ((int64_t(*)(int64_t))(intptr_t)fn)(c->value);
  return (int64_t)(intptr_t)r;
  ```)

(definstance TestFunctor [option]
  (fmap [container fn] (__fmap_option container fn)))

;; No explicit ^f: kind is inferred from the .fmap usage.
(defn map-and-add [container fn addend] : int
  (let [mapped (.fmap container fn)]
    (+ (__opt_unwrap mapped) addend)))

(defn negate [x] : int (- 0 x))

(defn main [] : int
  (do
    ;; map-and-add (some 10) negate 3 => (-10 + 3) = -7
    (let [opt (__opt_some 10)]
      (println (map-and-add opt negate 3)))
    0))
