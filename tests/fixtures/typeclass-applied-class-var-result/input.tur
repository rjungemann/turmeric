;; A kind-* class whose method result is the class variable APPLIED --
;; `(wrap-self [x : a] : (Option a))` -- gets that variable substituted in each
;; instance's impl, as a bare `: a` result always was: `Wrap [Pt]` returns
;; `(Option Pt)`, not the open `(Option a)` that lowered to the carrier.  Plain
;; Turmeric, static dispatch; the dynamic half is
;; saffron-dyn-applied-class-var-result.  7.1 so a float element shows.
(defdata Pt (Pt [px : int py : int]))
(defclass Wrap [a] (wrap-self [x : a] : (Option a)))
(definstance Wrap [int] (wrap-self [x] (some x)))
(definstance Wrap [Pt] (wrap-self [x] (some x)))
(defclass Twice [a] (twice [x : a] : (Vec a)))
(definstance Twice [float] (twice [x] (vec-of x x)))
(definstance Twice [Pt] (twice [x] (vec-of (Pt (.py x) (.px x)) x)))
(defn main [] : int
  (println (unwrap (.wrap-self 41)))                 ; 41
  (println (.px (unwrap (.wrap-self (Pt 5 2)))))     ; 5
  (println (vec-get (.twice 7.1) 1))                 ; 7.1
  (println (.px (vec-get (.twice (Pt 3 9)) 1)))      ; 3
  (println (vec-len (.twice (Pt 3 9))))              ; 2
  0)
