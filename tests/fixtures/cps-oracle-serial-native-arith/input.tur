;; U4 oracle: NATIVE arithmetic serial context in a colored helper.
;; The serial-reset lives in a non-main colored helper, so under --enable=cps-backend
;; it emits natively (a _skbody shift helper + __sk_frame_for_tag tagged frames),
;; not via the emit_cps.c delegation.  rt5 forces a real serialize -> bytes ->
;; deserialize round-trip of the captured continuation, so the tagged-frame
;; marshaling is exercised end-to-end.
;;   run-a: (serial-reset (+ 10 (serial-shift rt5 0)))      -> (10+5)   = 15
;;   run-b: (serial-reset (* 2 (+ 1 (serial-shift rt5 0)))) -> 2*(1+5)  = 12
;;   run-c: (serial-reset (- 100 (serial-shift rt5 0)))     -> (100-5)  = 95
;;
(defn rt5 [k] : int
  (tur_serial_cont_resume
    (tur_serial_cont_deserialize (tur_serial_cont_serialize k)) 5))
(defn run-a [] : int (serial-reset (+ 10 (serial-shift rt5 0))))
(defn run-b [] : int (serial-reset (* 2 (+ 1 (serial-shift rt5 0)))))
(defn run-c [] : int (serial-reset (- 100 (serial-shift rt5 0))))
(defn main [] : int
  (println (run-a))
  (println (run-b))
  (println (run-c))
  0)
