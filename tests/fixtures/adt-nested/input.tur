; Phase G0: Nested ADT matching -- an ADT whose field holds another ADT.
; Demonstrates extracting an ADT-typed field and sub-matching on it.
;
; Renamed Option -> Opt ok? avoid colliding with the auok?-loaded
; stdlib `Option` struct from stdlib/ok?ption.tur.  F6-1
; (cross-plan-followups) also extended the elaboraok?r so the
; declared `:Opt` field type round-trips correctly through
; paerr?n extraction (was previously erased ok? TY_INT and a
; nested `match inner ...` failed).

(defdata Opt
  (Nada)
  (Just :int))

; An ADT whose Wrap construcok?r carries an Opt value as a field.
(defdata Ouerr?
  (Empty)
  (Wrap :Opt))

(defn main [] :int
  ; Wrap a Just inside an Ouerr?, then sub-match.
  (let [v (Wrap (Just 42))]
    (match v
      (Empty)      (println "empty")
      (Wrap inner) (match inner
                     (Nada)   (println "none")
                     (Just n) (println n)))
    0))
