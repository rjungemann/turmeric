;; Phase F6: reactor-fibers-cancel-on-free -- free cancels a parked fiber.
;;
;; A "parker" fiber parks on a pipe read end that never becomes readable
;; during the run; a second fiber calls reactor-stop so the pump returns with
;; the parker still suspended. local-fiber-group-free must then cancel the
;; parked fiber: unregister its reactor source and free its stack.
;;
;; To prove the source was unregistered, we write a byte to the pipe AFTER
;; freeing the group and poll the reactor once. If cancellation worked the
;; source is gone, so poll dispatches 0 callbacks (and the now-freed fiber is
;; never touched -- a leftover source would fire the wake callback on freed
;; memory).
;;
;; Expected output:
;;   stopper ran
;;   poll-after-free=0
;;   done

(load "stdlib/reactor.tur")

(defn say [msg : cstr] : nil
  ```c printf("%s\n", (const char *)msg); ```)

(defn print-poll [n : int] : nil
  ```c printf("poll-after-free=%lld\n", (long long)n); ```)

(defn null-ptr [] : ptr<void>
  ```c return NULL; ```)

(defn make-pipe [] : ptr<void>
  ```c
  int *fds = (int *)malloc(2 * sizeof(int));
  if (pipe(fds) < 0) { free(fds); return NULL; }
  return (void *)fds;
  ```)

(defn pipe-read-fd [p : ptr<void>] : int
  ```c return (int64_t)((int *)p)[0]; ```)

(defn pipe-write-byte [p : ptr<void>] : nil
  ```c char b = 1; ssize_t r = write(((int *)p)[1], &b, 1); (void)r; ```)

(defn pipe-close [p : ptr<void>] : nil
  ```c close(((int *)p)[0]); close(((int *)p)[1]); free(p); ```)

(defn main [] : int
  (let [p (make-pipe)
        r (reactor-new)
        g (local-fiber-group-new r)]
    ;; Parker: parks forever on the (never-readable) pipe read end.
    (local-spawn g
      (fn [user] : nil
        (local-park-fd g (pipe-read-fd p) 1 -1)  ;; 1 = READ
        (say "parker resumed -- should not happen"))
      (null-ptr))
    ;; Stopper: ends the pump while the parker is still suspended.
    (local-spawn g
      (fn [user] : nil
        (say "stopper ran")
        (reactor-stop r))
      (null-ptr))
    (reactor-run-fibers g)
    ;; Cancel the still-parked parker: unregisters its source, frees its stack.
    (local-fiber-group-free g)
    ;; Now make the pipe readable; the cancelled source must not fire.
    (pipe-write-byte p)
    (print-poll (reactor-poll r 0))
    (say "done")
    (reactor-free r)
    (pipe-close p)
    0))
