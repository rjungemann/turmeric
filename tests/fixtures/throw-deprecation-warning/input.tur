;; throw-deprecation-plan DEPR-W0: elaborating `throw` or `try` /
;; `catch` emits TUR-D0002.  The forms still compile and run while
;; the deprecation window is open.

(defn safe-div [a : int b : int] : int
  (try
    (if (= b 0)
      (throw 42)
      (/ a b))
    (catch [e] -1)))

(defn main [] : int
  (println (safe-div 10 2))
  (println (safe-div 10 0))
  0)
