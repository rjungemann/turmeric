;; End-to-end fixture for stdlib/arrow.tur.
;; Exercises the public surface: arr, >>>, arrow-first, arrow-second,
;; par-comp, arrow-split, arrow-const, arrow-dup.
;;
;; The arrow combinators return closures; we call them via tur-call-closure1
;; (Turmeric does not yet support direct application of int-typed closures).

(load "stdlib/arrow.tur")

;; Call a Turmeric closure (heap struct: { int64_t __fn; ...env... }) with
;; one argument. TUR_APPLY1 (runtime preamble) reads the __fn slot and invokes
;; it with (env, arg), replacing the hand-written fat-closure cast.
(defn tur-call-closure1 [f x] : int
  ```c
  return TUR_APPLY1(f, x);
  ```)

;; Construct / read a heap pair of int64s with the layout that arrow.tur's
;; inline-C helpers expect (a struct of two int64 fields). The stdlib's
;; typed (tuple2 a b) returns a struct value, not an int64 pointer, so it
;; can't be threaded through the closure-calling helper above.
(defn pair-new [a b] : int
  ```c
  struct { int64_t e1; int64_t e2; } *p = malloc(sizeof(*p));
  p->e1 = a;
  p->e2 = b;
  return (int64_t)(intptr_t)p;
  ```)

(defn pair-e1 [p] : int
  ```c
  return ((int64_t *)(intptr_t)p)[0];
  ```)

(defn pair-e2 [p] : int
  ```c
  return ((int64_t *)(intptr_t)p)[1];
  ```)

(defn add1 [x] : int (+ x 1))
(defn mul2 [x] : int (* x 2))

(defn main [] : int
  ;; arr normalizes a function to a fat closure; (arr add1) applied to 5 = 6
  (println (tur-call-closure1 (arr add1) 5))

  ;; >>>: (add1 >>> mul2)(3) = mul2(add1(3)) = 2*(3+1) = 8
  (println (tur-call-closure1 (>>> add1 mul2) 3))

  ;; (>>> g f) with swapped args matches the prior <<<: 2*(3+1) = 8
  (println (tur-call-closure1 (>>> add1 mul2) 3))

  ;; arrow-first: add1 on first of Tuple2(5, 10) -> Tuple2(6, 10)
  (let [p (pair-new 5 10)
        r (tur-call-closure1 (arrow-first add1) p)]
    (println (pair-e1 r))
    (println (pair-e2 r)))

  ;; arrow-second: mul2 on second of Tuple2(5, 10) -> Tuple2(5, 20)
  (let [p (pair-new 5 10)
        r (tur-call-closure1 (arrow-second mul2) p)]
    (println (pair-e1 r))
    (println (pair-e2 r)))

  ;; par-comp: add1 on first, mul2 on second of Tuple2(5, 10) -> Tuple2(6, 20)
  ;; par-comp's first four params are phantom type parameters; pass 0.
  (let [p (pair-new 5 10)
        r (tur-call-closure1 (par-comp 0 0 0 0 add1 mul2) p)]
    (println (pair-e1 r))
    (println (pair-e2 r)))

  ;; arrow-split: (add1 &&& mul2)(3) -> Tuple2(4, 6)
  ;; arrow-split's first three params are phantom type parameters; pass 0.
  (let [r (tur-call-closure1 (arrow-split 0 0 0 add1 mul2) 3)]
    (println (pair-e1 r))
    (println (pair-e2 r)))

  ;; arrow-const: ignores input, always returns 99
  (println (tur-call-closure1 (arrow-const 99) 42))
  (println (tur-call-closure1 (arrow-const 99) 0))

  ;; arrow-dup: plain defn, call directly: Tuple2(7, 7)
  (let [r (arrow-dup 7)]
    (println (pair-e1 r))
    (println (pair-e2 r)))

  0)
