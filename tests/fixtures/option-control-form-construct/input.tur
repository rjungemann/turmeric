;;
;; option-lowering-mid-migration regression: a function whose declared return
;; is a carrier-ABI aggregate (Option/Result) but whose value is constructed by
;; carrier producers (some/none/ok/err) behind a control form (if/let/do) must
;; not straddle the carrier and by-value lowerings.  Before the fix the if/let/do
;; result temp was declared by-value (Option__int) while the branch assignments
;; produced the int64 carrier, and the return readback dereffed the struct as a
;; pointer -- a hard cc error.

;; if directly in the body
(defn opt-if [b : bool] : (Option int)
  (if b (some 1) (none)))

;; let wrapping an if
(defn opt-let [b : bool] : (Option int)
  (let [x 5]
    (if b (some x) (none))))

;; do wrapping a let wrapping an if
(defn opt-do [b : bool] : (Option int)
  (do
    (let [y 9]
      (if b (some y) (none)))))

;; Result through an if
(defn res-if [b : bool] : (Result int cstr)
  (if b (ok 7) (err "bad")))

;; if-value bound in a let and consumed by field access in the same fn
(defn opt-consume [b : bool] : int
  (let [o (if b (some 11) (none))]
    (if (some? o) (unwrap o) 0)))

;; if-value fed to a carrier-ABI consumer (some?)
(defn opt-pred [b : bool] : bool
  (some? (if b (some 1) (none))))

(defn res-ok [r : (Result int cstr)] : int
  (if (ok? r) (ok-val r) (- 0 1)))

(println (unwrap (opt-if true)))
(println (some? (opt-if false)))
(println (unwrap (opt-let true)))
(println (unwrap (opt-do true)))
(println (res-ok (res-if true)))
(println (res-ok (res-if false)))
(println (opt-consume true))
(println (opt-consume false))
(println (opt-pred true))
(println (opt-pred false))
