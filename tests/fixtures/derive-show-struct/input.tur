;; SI2: derive-show generates a Show instance for a struct.
;; Tests that (derive-show Point x y) expands to the correct Show instance.
(defclass Show [a]
  (show [x] :cstr))

(definstance Show [int]
  (show [x] :cstr
    ```c
    char *buf = (char *)malloc(32);
    snprintf(buf, 32, "%lld", (long long)x);
    return (const char *)(intptr_t)buf;
    ```))

(defn str-concat [a :cstr b :cstr] :cstr
  ```c
  const char *sa = (const char*)(intptr_t)a;
  const char *sb = (const char*)(intptr_t)b;
  size_t la = strlen(sa), lb = strlen(sb);
  char *out = (char *)malloc(la + lb + 1);
  memcpy(out, sa, la);
  memcpy(out + la, sb, lb);
  out[la + lb] = '\0';
  return (int64_t)(intptr_t)out;
  ```)

;; Internal helpers for derive-show.
(defmacro derive-show-rest__ [& fields]
  (if (empty? fields)
    " }"
    (let [field (first fields)
          rest-fields (rest fields)
          is-vec (vec? field)
          label (if is-vec (first field) (symbol-name field))
          accessor-sym (if is-vec (second field) field)
          accessor-form (if is-vec
                          (list accessor-sym '__p)
                          (list (dot-sym accessor-sym) '__p))
          prefix (str-append ", " label " = ")]
      (list str-concat prefix
        (list str-concat
          (list show accessor-form)
          (list derive-show-rest__ ~@rest-fields))))))

(defmacro derive-show-body__ [TypeName & fields]
  (let [type-str (symbol-name TypeName)]
    (if (empty? fields)
      (str-append type-str " { }")
      (let [field (first fields)
            rest-fields (rest fields)
            is-vec (vec? field)
            label (if is-vec (first field) (symbol-name field))
            accessor-sym (if is-vec (second field) field)
            accessor-form (if is-vec
                            (list accessor-sym '__p)
                            (list (dot-sym accessor-sym) '__p))
            first-prefix (str-append type-str " { " label " = ")]
        (list str-concat first-prefix
          (list str-concat
            (list show accessor-form)
            (list derive-show-rest__ ~@rest-fields)))))))

(defmacro derive-show [TypeName & fields]
  (list definstance Show (vec TypeName)
    (list show (vec '__p) :cstr
      (list derive-show-body__ TypeName ~@fields))))

(defstruct Point :copy [x :int y :int])
(derive-show Point x y)

(defn main [] :int
  (let [p (make-struct Point 3 4)]
    (println (.show p)))
  0)
