;; SI2: derive-show generates a Show instance for a struct.
(defclass Show [a]
  (show [x] :cstr))

(definstance Show [int]
  (show [x] :cstr
    ```c
    char *buf = (char *)malloc(32);
    snprintf(buf, 32, "%lld", (long long)x);
    return (const char *)(intptr_t)buf;
    ```))

(defstruct Point :copy [x :int y :int])

;; Manually-expanded form of: (derive-show Point x y)
;; This is what the derive-show macro from stdlib/macros.tur generates.
(definstance Show [Point]
  (show [__p] :cstr
    ```c
    // "Point { x = " + show(x) + ", y = " + show(y) + " }"
    int nx = snprintf(NULL, 0, "%lld", (long long)__p.x);
    int ny = snprintf(NULL, 0, "%lld", (long long)__p.y);
    if (nx < 0) nx = 0;
    if (ny < 0) ny = 0;
    // "Point { x = " = 13, ", y = " = 6, " }" = 3
    size_t len = 13 + (size_t)nx + 6 + (size_t)ny + 3 + 1;
    char *buf = (char *)malloc(len);
    snprintf(buf, len, "Point { x = %lld, y = %lld }", (long long)__p.x, (long long)__p.y);
    return (const char *)(intptr_t)buf;
    ```))

(defn main [] :int
  (let [p (make-struct Point 3 4)]
    (println (.show p)))
  0)
