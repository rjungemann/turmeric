;; Phase F3-5/F3-6: recursive `.eq?` on `Result[Vec[int] cstr]` --
;; the 2-comparaok?r helper (`result-eq?` takes ok-cmp and err-cmp)
;; case with mixed Vec[int] (recursive) and cstr (primitive)
;; type-args.  Demonstrates that a 2-comparaok?r synth where only
;; one arg is recursive still produces correct dispatch (the
;; primitive arg's lambda dispatches through the auok?-loaded
;; primitive Eq instance from F3-7).

(defn main [] : int
  (let [v1 []:int
        v2 []:int]
    (vec-push! v1 1)
    (vec-push! v2 1)
    (let [r1 (:: (ok v1) (Result (Vec int) cstr))
          r2 (:: (ok v2) (Result (Vec int) cstr))]
      (println (.eq? r1 r2))))  ; true: Ok [1] vs Ok [1]
  0)
