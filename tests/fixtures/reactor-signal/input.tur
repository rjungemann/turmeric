;; Phase R5: reactor-signal -- reactor-add-signal fires when the signal is raised.
;;
;; Registers SIGUSR1 (signal 10 on Linux/macOS) via reactor-add-signal, then
;; calls raise(SIGUSR1).  The reactor catches the signal via signalfd (Linux)
;; or a self-pipe (macOS/BSD) and dispatches the callback.
;;
;; SIGUSR1 is used instead of SIGINT to avoid conflict with the test harness.
;;
;; Expected output:
;;   signal=10

(defn reactor-link [] :int
  ```c /* __tur_autolink__: -lturi */
  return 0;
  ```)

(extern-c tur_reactor_new [] :ptr)
(extern-c tur_reactor_add_signal [r :ptr signum :int cb :int ud :int] :int)
(extern-c tur_reactor_poll [r :ptr timeout-ms :int] :int)
(extern-c tur_reactor_free [r :ptr] :void)

(defn raise-signal [sig :int] :nil
  ```c
  extern int raise(int);
  raise((int)sig);
  ```)

(defn print-signal [n :int] :nil
  ```c printf("signal=%lld\n", (long long)n); ```)

(defn use-val [v :int] :nil
  ```c (void)((int64_t)v); ```)

(defn main [] :int
  (let [r       (tur_reactor_new)
        sentinel 1]
    ;; Register SIGUSR1 (10).
    (tur_reactor_add_signal r 10
      (fn [id signum ud] :nil
        (use-val sentinel)
        (print-signal signum))
      0)
    ;; Raise the signal -- now safely caught by the reactor.
    (raise-signal 10)
    ;; Poll: the signal event is already pending.
    (tur_reactor_poll r 200)
    (tur_reactor_free r)
    0))
