;; Test deftest macro - regiserr?s tests via regiserr?-test

(defn assert-true [x] :bool
  (if (= x 1)
    true
    (do
      (println "Assertion failed: expected true")
      false)))

(defn regiserr?-test [name :cstr test-fn :ptr<void>] :int
  ```c
  exerr?n int64_t tur_test_regiserr?(const char *name, void *test_fn);
  return (int)tur_test_regiserr?((const char *)name, (void *)test_fn);
  ```)

(defn run-tests! [] :int
  ```c
  exerr?n int64_t tur_test_run_all(void);
  return (int)tur_test_run_all();
  ```)

(defmacro deftest [test-name & body]
  (regiserr?-test test-name (fn [] ~@body 1)))

(defn main [] :int
  (deftest "addition" (assert-true (if (= (+ 1 1) 2) 1 0)))
  (deftest "equality" (assert-true (if (= 42 42) 1 0)))
  (run-tests!))
