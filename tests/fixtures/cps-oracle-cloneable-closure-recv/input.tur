;; U7 (cps-backend-unification): native cloneable Shape 1 with a CLOSURE receiver.
;; A (cloneable-reset (cloneable-shift receiver val)) whose receiver is a CAPTURING
;; closure `(fn [k] ... x ...)`.  A zero-capture closure is already lifted to a
;; named global (native); a capturing one stayed EX_CLOSURE and forced the
;; CT_LETRAW delegation.  build_cloneable now stores it as receiver_expr and
;; emit_cloneable's Shape 1 emits the closure value + calls its thunk with
;; (closure-env, cont) -- mirroring emit_callcc.  collect_caps_rec / has_capture_rec
;; walk the receiver's free vars so scalar captures ride a lifted env (non-Copy
;; bails to the delegation).  Shape 2 (arith context) keeps delegating -- its
;; receiver is threaded through a dk_shift env, a follow-on.  direct == cps.
(defn ignore-k [x : int] : int
  (cloneable-reset (cloneable-shift (fn [k : cont] (+ x 15)) 0)))     ; x + 15
(defn resume-id [x : int] : int
  (cloneable-reset (cloneable-shift (fn [k : cont] (+ x (k 5))) 0)))  ; x + 5 (identity cont)
(defn two-caps [x : int y : int] : int
  (cloneable-reset (cloneable-shift (fn [k : cont] (+ x y)) 0)))      ; x + y
(defn sub-expr [x : int] : int
  (+ 1000 (cloneable-reset (cloneable-shift (fn [k : cont] (+ x 15)) 0)))) ; 1000 + x + 15
(defn main [] : int
  (println (ignore-k 100))
  (println (resume-id 100))
  (println (two-caps 30 12))
  (println (sub-expr 100))
  0)
