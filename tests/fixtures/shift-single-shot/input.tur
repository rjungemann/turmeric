;; Single-shot shift (one-substrate plan, slice 3).
;;
;; A single-shot resumable continuation is a `^linear` continuation: the receiver
;; gets `k : cont` and may resume it AT MOST ONCE via the `(k v)` application
;; sugar.  Resuming twice is a compile-time error (TUR-E0101; see the negative
;; fixture errors/shift-single-shot-double-resume).  So single-shot needs no
;; separate runtime -- the shared substrate plus linear typing gives it, and the
;; `(k v)` sugar makes it ergonomic (no explicit tur_cloneable_cont_resume).
;;
;; direct == cps == turi.

;; context (+ 10 []): resume k once with 5 -> 10 + 5 = 15
(defn add-five [^linear k : cont] : int
  (k 5))

;; context (* 3 []): resume k once with 4 -> 3 * 4 = 12
(defn times-four [^linear k : cont] : int
  (k 4))

(defn main [] : int
  (println (reset (+ 10 (shift add-five 0))))
  (println (reset (* 3 (shift times-four 0))))
  0)
