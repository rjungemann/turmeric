;; Phase B1: Clone trait for the Ref (heap-allocated reference) type.
;;
;; Demonstrates that (definstance Clone [Ref] ...) implements a deep clone:
;; after .clone, both handles own independent heap allocations, so freeing
;; one does not affect the other.
;;
;; Type note: .clone returns int64_t (the new cell pointer cast), so the
;; cloned handle is read and freed via inline C helpers.

(defstruct Ref [value :int])

(defclass Clone [a]
  (clone [x] :int))

(definstance Clone [int]
  (clone [x] x))

;; Clone [Ref]: deep-copy — allocate a new cell with a copy of the value.
;; x has type Ref (struct value); x.value is the stored int64_t.
(definstance Clone [Ref]
  (clone [x] :int
    ```c
    struct { int64_t value; } *dst = malloc(sizeof(Ref));
    dst->value = x.value;
    return (int64_t)(intptr_t)dst;
    ```))

;; Read the value from a heap Ref pointer (result of .clone).
(defn ref-read [p] :int
  ```c
  struct { int64_t value; } *r = (void *)(intptr_t)p;
  return r ? r->value : -1;
  ```)

;; Free a heap Ref pointer (result of .clone).
(defn ref-drop [p]
  ```c
  free((void *)(intptr_t)p);
  ```)

(defn main [] :int
  ;; Create Ref(42), clone it; both copies read 42.  Freeing the original
  ;; does not disturb the clone (deep-copy semantics).
  (let [r (make-struct Ref 42)]
    (let [r2 (.clone r)]
      (println (ref-read r2))   ;; 42 — clone holds same value
      (ref-drop r2)
      0)))