; LZ3 fixture: seq/reduce -- fold without initial value; None if empty.
; Reduce + over [1,5) = 10; reduce on empty = None.

(load "stdlib/seq/consume.tur")

(defn main [] :void
  (let [sum (fn [a b] (+ a b))]
    (println (seq-opt-unwrap (seq/reduce sum (seq/range 1 5))))
    (println (seq-opt-some? (seq/reduce sum (empty-seq))))))
