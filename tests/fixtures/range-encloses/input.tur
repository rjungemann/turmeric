; LZ4 fixture: range-encloses? -- every value of inner is in outer.

(load "stdlib/range.tur")

(defn main [] :void
  (println (range-encloses? (closed-range 0 10) (closed-range 2 8)))   ; true
  (println (range-encloses? (closed-range 2 8)  (closed-range 0 10)))  ; false
  (println (range-encloses? (at-least-range 0)  (closed-range 5 100))) ; true
  (println (range-encloses? (closed-range 0 10) (at-least-range 0)))   ; false
  (println (range-encloses? (unbounded-range)   (closed-range 1 5)))   ; true
  ; same range encloses itself
  (println (range-encloses? (closed-range 1 5)  (closed-range 1 5))))  ; true
