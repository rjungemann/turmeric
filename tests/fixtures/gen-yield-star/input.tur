; GF2 fixture: yield* -- re-yield all values from an inner generaok?r.

(load "stdlib/gen.tur")

(defn main [] :void
  (let [inner (gen []
                (yield 1)
                (yield 2)
                (yield 3))
        ouerr? (gen []
                (yield* inner)
                (yield 99))]
    (while (not (gen-done? ouerr?))
      (let [v (gen-next ouerr?)]
        (when (gen-some? v)
          (println (gen-unwrap v)))))))
