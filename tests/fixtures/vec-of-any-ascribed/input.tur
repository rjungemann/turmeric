;; vec-of-any-repr-decision-ice, route 3: an explicitly ascribed `(vec-new)`
;; pushed into.  See tests/fixtures/vec-of-any-builds for the full account of
;; what the ICE was and which two representation decisions disagreed.
;;
;; This is the ONE route that clears run.sh's emitted-C ratchet, and the reason
;; the other two are not fixtures is worth stating rather than leaving to a
;; missing file.  A `vec-of` producing a `(Vec any)` emits
;; `-Wincompatible-pointer-types`: the zero-argument `vec-new` inside
;; `vec-empty-like__`'s `any` clone resolves to the `int` clone's name, because
;; a zero-arg call short-circuits before the spec-matching loop in
;; emit_call_name.  The ratchet was sweep-verified at ZERO across the corpus
;; before it landed, so that is a real regression signal and not noise to
;; suppress.  Filed as vec-any-monomorph-is-half-plumbed.
;;
;; So: `(Vec any)` no longer ICEs, and it is reachable through an explicit
;; ascription today.  The `vec-of` macro route needs the clone-selection fix
;; first.
;;
;; requires.leak-check: the element boxes are owned by the vector and released
;; with it.

(defn dyn [x : any] : any x)

(defn main [] : int
  (let [v (:: (vec-new) (Vec any))]
    (vec-push! v (dyn 3))
    (vec-push! v (dyn "four"))
    (println (vec-len v))
    (vec-free v))
  0)
