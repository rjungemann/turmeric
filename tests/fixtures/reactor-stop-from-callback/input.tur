;; Phase R7: reactor-stop-from-callback -- reactor-stop inside a callback unwinds cleanly.
;;
;; Writes a byte to a pipe, registers the read end for READ, then calls
;; tur_reactor_run.  The callback fires once, calls tur_reactor_stop(r) from
;; inside the dispatch loop, then returns.  tur_reactor_run must exit cleanly
;; after the current dispatch round -- it must NOT fire the callback again or
;; crash with double-free / use-after-free.
;;
;; A second fd source (never-firing) is also registered to ensure the run
;; loop does not exit due to "no active sources" -- only the stop flag.
;;
;; Expected output:
;;   callback fired
;;   run returned

(defn reactor-link [] :int
  ```c /* __tur_autolink__: -lturi */
  return 0;
  ```)

(extern-c tur_reactor_new [] :ptr)
(extern-c tur_reactor_add_fd [r :ptr fd :int events :int cb :int ud :int] :int)
(extern-c tur_reactor_run [r :ptr] :void)
(extern-c tur_reactor_stop [r :ptr] :void)
(extern-c tur_reactor_free [r :ptr] :void)

(defn make-pipe [] :ptr<void>
  ```c
  int *fds = (int *)malloc(2 * sizeof(int));
  if (pipe(fds) < 0) { free(fds); return NULL; }
  return (void *)fds;
  ```)

(defn pipe-read-fd  [p :ptr<void>] :int
  ```c return (int64_t)((int *)p)[0]; ```)

(defn pipe-write-byte [p :ptr<void>] :nil
  ```c char b = 1; write(((int *)p)[1], &b, 1); ```)

(defn pipe-close [p :ptr<void>] :nil
  ```c close(((int *)p)[0]); close(((int *)p)[1]); free(p); ```)

(defn use-val [v :ptr<void>] :nil
  ```c (void)v; ```)

(defn main [] :int
  (let [r       (tur_reactor_new)
        p-ready (make-pipe)    ;; has data -- fires immediately
        p-idle  (make-pipe)]   ;; no data -- never fires
    ;; Write so the ready pipe fires on the first poll.
    (pipe-write-byte p-ready)
    ;; Second source: keeps the reactor "active" so the loop doesn't exit
    ;; due to no-sources; only the stop flag should end the run.
    (tur_reactor_add_fd r (pipe-read-fd p-idle) 1 0 0)
    ;; Primary source: callback fires once and stops the reactor.
    (tur_reactor_add_fd r (pipe-read-fd p-ready) 1
      (fn [id events ud] :nil
        (use-val r)
        (println "callback fired")
        (tur_reactor_stop r))
      0)
    (tur_reactor_run r)
    (println "run returned")
    (tur_reactor_free r)
    (pipe-close p-ready)
    (pipe-close p-idle)
    0))
