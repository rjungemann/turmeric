;; typeclass-method-resolution-ignores-the-class, "Trap for anyone writing a
;; repro": a substructural/borrow caret in a definstance method impl's param
;; list annotates the NEXT parameter -- it is not a parameter itself.
;;
;; The defclass parser has skipped these since ECS E2d-P6; the instance-impl
;; parser did not, so repeating the class's own spelling made `^borrow` consume
;; a param slot and emitted a TWO-parameter C function.  `tur check` exited 0
;; and cc then rejected every call site with "too few arguments to function
;; call, expected 2, have 1" -- a check/build divergence.
;;
;; All four spellings must agree.  `[w]` (the spelling the report recommends and
;; spices/ecs/src/ecs/world.tur uses) was always fine; the two ^borrow rows are
;; the regression guard.
(defstruct Bar [v : int])

(defclass Foo [W]
  (foo-of [^borrow w] : int))

(definstance Foo [Bar]
  (foo-of [^borrow w] : int (.v w)))

(defclass Foo2 [W]
  (foo2-of [^borrow w] : int))

(definstance Foo2 [Bar]
  (foo2-of [^borrow w] (.v w)))

(defclass Foo3 [W]
  (foo3-of [^borrow w] : int))

(definstance Foo3 [Bar]
  (foo3-of [w] (.v w)))

(defn main [] : int
  (println (.foo-of  (Bar 7)))
  (println (.foo2-of (Bar 8)))
  (println (.foo3-of (Bar 9)))
  0)
