;; Phase HKT-P8: do-m with option monad
;; Tests that do-m works with option<T> and short-circuits on none

(defclass TestMonad [^m]
  (bind [ma fn] : int))

(defn __opt_some [x] : int
  ```c
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true; r->value = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn __opt_none [] : int
  ```c
  return 0;
  ```)

(defn __opt_some? [o] : bool
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return p != NULL && p->is_some;
  ```)

(defn __opt_unwrap [o] : int
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return p->value;
  ```)

(defn __opt_free [o] : nil
  ```c
  free((void *)(intptr_t)o);
  ```)

(defn __bind_option [ma fn] : int
  ```c
  struct { bool is_some; int64_t value; } *opt =
      (void *)(intptr_t)ma;
  if (!opt || !opt->is_some) return 0;
  /* fn is a closure env struct; first field is the function pointer */
  return TUR_APPLY1(fn, opt->value);
  ```)

(definstance TestMonad [option]
  (bind [ma fn] (__bind_option ma fn)))

;; Helper: add two options, propagating none
(defn add-options [a b] : int
  (do-m
   x a
   y b
   (__opt_some (+ x y))))

(defn main [] : int
  (let [o1 (add-options (__opt_some 10) (__opt_some 20))]
    (let [o2 (add-options (__opt_none) (__opt_some 20))]
      (let [o3 (add-options (__opt_some 10) (__opt_none))]
        (println (__opt_some? o1))   ;; true
        (println (__opt_unwrap o1))  ;; 30
        (println (__opt_some? o2))   ;; false
        (println (__opt_some? o3))   ;; false
        (__opt_free o1)
        0))))
