;; Phase HKT-P8: do-m with option monad.
;; Verifies that do-m desugars correctly using Monad.bind on option,
;; short-circuiting on none.
;; Complements hkt-do-m-result and confirms the Monad dispatch works for
;; both sum types.

(defclass Monad [^m]
  (bind [ma fn] :int))

;; ── Inline option helpers ────────────────────────────────────────────────────

(defn __opt_some [x] :int
  ```c
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn __opt_none [] :int
  ```c
  return 0;
  ```)

(defn __opt_some? [o] :bool
  ```c
  struct { bool is_some; int64_t value; } *p =
      (struct { bool is_some; int64_t value; } *)(intptr_t)o;
  return p != NULL && p->is_some;
  ```)

(defn __opt_unwrap [o] :int
  ```c
  struct { bool is_some; int64_t value; } *p =
      (struct { bool is_some; int64_t value; } *)(intptr_t)o;
  return (int)(p->value);
  ```)

;; ── Monad[option]: bind short-circuits on none ───────────────────────────────

(defn __monad_option_bind [ma fn] :int
  ```c
  struct { bool is_some; int64_t value; } *opt =
      (struct { bool is_some; int64_t value; } *)(intptr_t)ma;
  if (!opt || !opt->is_some) return 0;
  return ((int64_t(*)(int64_t))(intptr_t)fn)(opt->value);
  ```)

(definstance Monad [option]
  (bind [ma fn] (__monad_option_bind ma fn)))

;; ── Tests ────────────────────────────────────────────────────────────────────

(defn main [] :int
  (do
    ;; do-m base case: single expression — returned directly
    (let [r0 (do-m (__opt_some 42))]
      (do
        (println (__opt_some? r0))    ;; true
        (println (__opt_unwrap r0)))) ;; 42

    ;; do-m with one binding: some(5) >>= \x -> some(x*3) => some(15)
    (let [r1 (do-m x (__opt_some 5) (__opt_some (* x 3)))]
      (do
        (println (__opt_some? r1))    ;; true
        (println (__opt_unwrap r1)))) ;; 15

    ;; do-m with none propagation: none >>= ... => none
    (let [r2 (do-m x (__opt_none) (__opt_some (* x 3)))]
      (println (__opt_some? r2)))     ;; false

    ;; Chained bind via __monad_option_bind directly (no cross-lambda captures):
    ;; some(3) >>= \x -> some(x*2) = some(6) >>= \y -> some(y+1) = some(7)
    (let [step1 (__monad_option_bind (__opt_some 3) (fn [x] (__opt_some (* x 2))))]
      (let [r3 (__monad_option_bind step1 (fn [y] (__opt_some (+ y 1))))]
        (do
          (println (__opt_some? r3))    ;; true
          (println (__opt_unwrap r3))))) ;; 7

    ;; Chained bind with none: none >>= ... => none throughout
    (let [step2 (__monad_option_bind (__opt_none) (fn [x] (__opt_some (* x 2))))]
      (let [r4 (__monad_option_bind step2 (fn [y] (__opt_some (+ y 1))))]
        (println (__opt_some? r4))))    ;; false

    0))
