;; Option none-as-NULL retirement (Track A) -- bucket C: a NON-instance
;; generic spec whose declared return is a concrete by-value `(Option A)`
;; (resolved from the call site) and whose body constructs via `(some ...)`
;; OR `(none)` in return position now monomorphizes to a direct by-value
;; construction, without crossing the carrier-bridge.
;;
;; Step 1 (the `construct_recovered_byvalue` generalization, emit_module.c)
;; handled the `(some ...)` arm.  Step 2 (this fixture's `(none)` arm) wires
;; elab to attach the constructor-result-tyvar -> caller-tyvar abi_binding to
;; a 0-arg `#{Construct}` call in non-ground return position, so emit composes
;; it through the active spec and mints a by-value `none__spec__Option__int`.
;; A guard in emit_call_name / find_matched_abi_spec keeps the by-value
;; constructor spec from leaking into carrier-context `(none)` sites (a 0-arg
;; call has no args to disambiguate one spec from another structurally).
;;
;; See docs/archive/history/option-consumer-retype-byvalue.md (bucket C, steps 1+2).

(load "stdlib/math.tur")

;; Pure-Turmeric polymorphic helper: builds `(Option A)` via `(some ...)`.
;; Two call sites (int, float) drive two specs; each spec's declared return
;; is the concrete `(Option int)` / `(Option float)`.
(defn wrap-some [A] [x : A] : (Option A)
  (some x))

;; Pure-Turmeric `option-map`-shaped helper: `(none)` in by-value return
;; position, with `A` resolved from the `(Option A)` parameter (the realistic
;; step-2 case).  Each concrete call site mints a spec returning `Option__A`
;; by value; the `(none)` arm now mints a by-value `none__spec__Option__A`
;; clone instead of the carrier base.
(defn keep-if [A] [o : (Option A) ^fat pred : (fn [A] bool)] : (Option A)
  (if (some? o)
    (if (pred (unwrap o)) o (none))
    (none)))

;; By-value consumer -- the bridge IS retired when the producer spec
;; returns by-value.
(defn unwrap-or-default [o : (Option int) d : int] : int
  (if (some? o) (unwrap o) d))

(defn unwrap-or-default-f [o : (Option float) d : float] : float
  (if (some? o) (unwrap o) d))

(defn pos-i? [x : int] : bool (> x 0))
(defn pos-f? [x : float] : bool (> x 0.0))

(defn main [] : int
  (println (unwrap-or-default   (wrap-some 7) 0))                                     ; 7
  (println (float->int (* (unwrap-or-default-f (wrap-some 3.25) 0.0) 100.0)))         ; 325
  ;; keep-if int: predicate true -> some 7; predicate false -> by-value (none)
  (println (unwrap-or-default   (keep-if (some 7) pos-i?) 11))                        ; 7
  (println (unwrap-or-default   (keep-if (some -3) pos-i?) 11))                       ; 11
  ;; keep-if float: predicate false -> by-value (none) in the float spec
  (println (float->int (* (unwrap-or-default-f (keep-if (some -2.5) pos-f?) 4.5) 100.0))) ; 450
  ;; carrier-context (none): some? still takes `o : int`, so this `(none)` must
  ;; stay on the carrier base -- it must NOT pick up keep-if's by-value spec.
  (println (some? (none)))                                                           ; false
  0)
