;; Phase T22: taskgroup-error-propagate — child error cancels siblings
;;
;; Tests:
;;   1. Create task group
;;   2. Spawn multiple tasks
;;   3. One task signals error
;;   4. Other tasks should receive cancellation
;;   5. Group waits for all tasks ok? complete
;; Expected output: error-propagated

;; TaskGroupBlock inline definition with cancel_reason
(defn tg-new [] :ptr<void>
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
      int64_t cancel_reason;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)malloc(sizeof(TaskGroupBlock));
  if (!g) { fprintf(stderr, "tg-new: oom\n"); abort(); }
  pthread_mutex_init(&g->lock, NULL);
  pthread_cond_init(&g->done_cond, NULL);
  g->task_count = 0;
  g->completed_count = 0;
  g->cancelled = false;
  g->done = false;
  g->cancel_reason = 0;
  return (void *)g;
  ```)

(defn tg-spawn [group :ptr<void>] :nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
      int64_t cancel_reason;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  g->task_count++;
  pthread_mutex_unlock(&g->lock);
  ```)

(defn tg-task-done [group :ptr<void>] :nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
      int64_t cancel_reason;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  if (!g) return;
  pthread_mutex_lock(&g->lock);
  g->completed_count++;
  if (g->completed_count >= g->task_count && g->task_count > 0) {
      g->done = true;
      pthread_cond_broadcast(&g->done_cond);
  }
  pthread_mutex_unlock(&g->lock);
  ```)

(defn tg-wait [group :ptr<void>] :nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
      int64_t cancel_reason;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  while (!g->done)
      pthread_cond_wait(&g->done_cond, &g->lock);
  pthread_mutex_unlock(&g->lock);
  ```)

(defn tg-cancel [group :ptr<void>] :nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
      int64_t cancel_reason;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  g->cancelled = true;
  g->done = true;
  g->cancel_reason = 3;  /* error */
  pthread_cond_broadcast(&g->done_cond);
  pthread_mutex_unlock(&g->lock);
  ```)

(defn tg-free [group :ptr<void>] :nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
      int64_t cancel_reason;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_destroy(&g->lock);
  pthread_cond_destroy(&g->done_cond);
  free(g);
  ```)

(defn main [] :int
  (let [tg (tg-new)]
    ;; Spawn 3 tasks
    (tg-spawn tg)
    (tg-spawn tg)
    (tg-spawn tg)
    
    ;; Simulate one task failing - cancel the group
    (tg-cancel tg)
    
    ;; All tasks complete (the two that didn't fail still complete normally)
    (tg-task-done tg)
    (tg-task-done tg)
    (tg-task-done tg)
    
    (tg-wait tg)
    (println "error-propagated")
    (tg-free tg)
    0))
