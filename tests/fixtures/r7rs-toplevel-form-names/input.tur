#lang r7rs
;; A global spelled like a Turmeric special form (gen, handle, return, ...) is
;; the user's own binding: R7RS has no such form.  Definitions, uses, a
;; call/cc escape named `return`, and quoted data all keep their meaning.
(import (scheme base) (scheme write))
(define gen (lambda () 42))
(define (handle x) (+ x 1))
(define return 7)
(define (perform . xs) (length xs))
(define (first-negative lst)
  (call/cc (lambda (return)
             (for-each (lambda (x) (if (negative? x) (return x))) lst)
             #f)))
(write (list (gen) (handle 1) return (perform 1 2 3)
             (first-negative '(1 -2 3)) (first-negative '(1 2))))
(newline)
(write (list 'gen `(handle ,(handle 1)) (symbol->string 'return) (eq? 'gen 'gen)))
(newline)
(set! return (+ return 1))
(write return)
(newline)
