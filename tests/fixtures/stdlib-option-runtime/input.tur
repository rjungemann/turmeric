(defn lopt-some [x] :ptr<void>
  ```c
  struct { bool is_some; int64_t value; } *opt = malloc(sizeof(*opt));
  opt->is_some = true;
  opt->value = x;
  return opt;
  ```)

(defn lopt-none [] :ptr<void>
  ```c
  return NULL;
  ```)

(defn lopt-some? [o :ptr<void>] :bool
  ```c
  struct { bool is_some; int64_t value; } *opt = (void*)o;
  return opt != NULL && opt->is_some;
  ```)

(defn lopt-unwrap [o :ptr<void>] :int
  ```c
  struct { bool is_some; int64_t value; } *opt = (void*)o;
  if (opt == NULL || !opt->is_some) {
    fprintf(stderr, "unwrap called on none\n");
    return 0;
  }
  return (int)opt->value;
  ```)

(defn lopt-free [o :ptr<void>]
  ```c
  free(o);
  ```)

(defn main [] :int
  (let [a (lopt-some 42)]
    (let [b (lopt-none)]
      (println (lopt-some? a))
      (println (lopt-some? b))
      (println (lopt-unwrap a))
      (lopt-free a)
      0)))
