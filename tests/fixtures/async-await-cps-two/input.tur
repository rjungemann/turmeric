;; F3 gap-2 (cps-async): TWO sequential awaits in one colored body.  Each await
;; lowers to a heap-continuation dk_shift; the first await's continuation (which
;; itself contains the second await) is lifted as a RESET-continuation frame
;; threading the enclosing k, the second as a straight-line value frame.  Both
;; futures are ready, so both resume inline: 10 + 32 = 42.  cps-async graduated
;; 2026-07-19 -- this is the unconditional CPS-path lowering.
(defn future-a [] : ptr<void>
  ```c
  TurFuture *f = tur_future_new(); tur_future_fulfill(f, (int64_t)10); return (void *)f;
  ```)
(defn future-b [] : ptr<void>
  ```c
  TurFuture *f = tur_future_new(); tur_future_fulfill(f, (int64_t)32); return (void *)f;
  ```)
(defn work [] : int
  (+ (await (future-a)) (await (future-b))))
(defn main [] : nil (println (work)))
