;; typeclass-superclasses-plan SC8b step 5: Monad is declared over
;; Applicative, which is over Functor.  So a `[^Monad M]` body may call `pure`
;; and `fmap` -- the Haskell `Applicative m => Monad m` shape, and the reason
;; this step waited for `Applicative [(Result _ B)]` to ship.
;;
;; Each generic is called at Option and at Result, so a `pure` that resolved
;; to one instance for both would print a wrong line.

;; `bind` plus `pure` in the continuation: the everyday monadic shape.
(defn add-one [^Monad M] [m : (M int)] : (M int)
  (bind m (fn [x : int] : (M int) (pure (+ x 1)))))

;; `do-m` desugars to `bind`; its last line is a `pure`.  Two bindings, so the
;; second `bind` runs inside the first continuation and reaches the Monad
;; dictionary through the closure (docs/archive/hkt-generic-nested-bind-result-type.md).
(defn doubled [^Monad M] [a : (M int)] : (M int)
  (do-m x a
        y a
        (pure (+ x y))))

;; Functor, two superclass steps away.
(defn triple [^Monad M] [m : (M int)] : (M int)
  (fmap m (fn [x : int] : int (* x 3))))

(defn show-o [o : (Option int)] : int
  (match o (Some v) (do (println v) 0) (None) (do (println -1) 0)))
(defn show-r [r : (Result int int)] : int
  (match r (Ok v) (do (println v) 0) (Err e) (do (println (- 0 e)) 0)))

(defn main [] : int
  (show-o (add-one (some 41)))  ; 42
  (show-r (add-one (:: (ok 41) (Result int int))))  ; 42
  (show-r (add-one (:: (err 5) (Result int int))))  ; -5
  (show-o (doubled (some 21)))  ; 42
  (show-o (doubled (:: (none) (Option int))))  ; -1
  (show-r (doubled (:: (ok 21) (Result int int))))  ; 42
  (show-r (doubled (:: (err 7) (Result int int))))  ; -7
  (show-o (triple (some 14)))  ; 42
  (show-r (triple (:: (ok 14) (Result int int))))  ; 42
  0)
