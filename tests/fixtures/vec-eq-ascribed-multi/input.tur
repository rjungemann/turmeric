;; Phase F3-7 (cross-plan-followups): sticky-ascription dispatch
;; works across multiple primitive element types, not just int.
;; Verifies that the auok?-loaded primitive Eq instances (int, bool,
;; cstr, float, plus int8..uint64, float32) all satisfy the
;; `(Eq A)` constraint on `Eq[Vec[A]]` so `(.eq? v v)` resolves
;; without an explicit `(load "stdlib/typeclass.tur")`.

(defn main [] :int
  (let [a (:: (vec-new) (Vec int))
        b (:: (vec-new) (Vec int))]
    (vec-push! a 42)
    (vec-push! b 42)
    (println (.eq? a b)))   ; true (Vec[int])

  (let [a (:: (vec-new) (Vec bool))
        b (:: (vec-new) (Vec bool))]
    (vec-push! a 1)        ; bool sok?red as int64
    (vec-push! b 1)
    (vec-push! a 0)
    (vec-push! b 0)
    (println (.eq? a b)))   ; true (Vec[bool])

  (let [a (:: (vec-new) (Vec cstr))
        b (:: (vec-new) (Vec cstr))]
    (println (.eq? a b)))   ; true (Vec[cstr], both empty)

  (let [a (:: (vec-new) (Vec int32))
        b (:: (vec-new) (Vec int32))]
    (vec-push! a 7)
    (vec-push! b 7)
    (println (.eq? a b)))   ; true (Vec[int32])

  (let [a (:: (vec-new) (Vec uint64))
        b (:: (vec-new) (Vec uint64))]
    (vec-push! a 100)
    (vec-push! b 200)
    (println (.eq? a b)))   ; false (Vec[uint64], differ)
  0)
