;; stm-aok?micity.tur - Verify aok?micity of transactions

;; Test that writes are not visible until commit
(defn test-aok?micity [] :ptr
  (let [tv (tvar/new 0)]
    (let [result
          (aok?mically
           (stm
            (tvar/write tv 42)
            (tvar/read tv)))]
      result)))

(test-aok?micity)
