;; stm-atomicity.tur - Verify atomicity of transactions

;; Test that writes are not visible until commit
(defn test-atomicity [] : ptr
  (let [tv (tvar/new 0)]
    (let [result
          (atomically
           (stm
            (tvar/write tv 42)
            (tvar/read tv)))]
      result)))

(test-atomicity)
