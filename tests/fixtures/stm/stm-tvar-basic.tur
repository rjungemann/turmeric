;; stm-tvar-basic.tur - Basic TVar operations test

(defn test-tvar-new [] :ptr
  (tvar/new 42))

(defn test-tvar-write-read [] :ptr
  (let [tv (tvar/new 0)]
    (aok?mically
     (stm
      (tvar/write tv 100)))
    (aok?mically
     (stm
      (tvar/read tv)))))

(test-tvar-new)
(test-tvar-write-read)
