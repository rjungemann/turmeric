;; stm-deadlock-free.tur - Verify no deadlocks with complex multi-TVar transactions

;; Test nested transactions with different TVar access orders
(defn test-nested-transactions [] : bool
  (let [tv1 (tvar/new 0)]
    (let [tv2 (tvar/new 0)]
      (let [tv3 (tvar/new 0)]
        ;; Transaction accessing TVars in different orders
        (atomically
         (stm
          (tvar/write tv1 1)
          (tvar/write tv2 2)
          (tvar/write tv3 3)))
         
        (atomically
         (stm
          (tvar/write tv3 30)
          (tvar/write tv1 10)
          (tvar/write tv2 20)))
         
        (atomically
         (stm
          (tvar/write tv2 200)
          (tvar/write tv3 300)
          (tvar/write tv1 100)))
        
        true))))

;; Run test
(test-nested-transactions)
