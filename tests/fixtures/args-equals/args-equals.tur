;; args-equals -- test --key=value form option parsing.

(defn print-cstr [s :cstr] :void
  ```c
  printf("%s\n", s ? s : "");
  ```)

(let [spec (args/spec-new)]
  (args/spec-option spec "--input" "string" 0)
  (let [res (args/parse spec *args*)]
    (print-cstr (args/get-str res "input"))
    (args/result-free res))
  (args/spec-free spec))
