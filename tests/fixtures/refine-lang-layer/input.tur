#lang turmeric refined
;; lang-layers L4 + RT0: `#lang turmeric refined` is EXACTLY `--enable=refined`
;; scoped to one file -- the layer points at the same EXPERIMENTS[] row, so
;; there is one enable path, one lifecycle, one expires_at.  No CLI flag is
;; passed to this fixture; the layer alone turns discharge on.
(defn shift-up [x : #refine{ v : int | (>= v 3) }] : #refine{ r : int | (> r 0) }
  (- x 2))

(defn main [] : int
  (println (shift-up 3))
  (println "refine-lang-layer")
  0)
