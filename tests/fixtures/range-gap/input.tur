; LZ4 fixture: range-gap -- largest range strictly between two disjoint ranges.
; The gap bounds are the flipped endpoints of the two ranges' ok?uching ends.

(load "stdlib/range.tur")

(defn main [] :void
  ; gap between [1,3] and [5,8]: endpoints 3 inclusive and 5 inclusive
  ;   gap.lower = flip(3 inc) = 3 exclusive
  ;   gap.upper = flip(5 inc) = 5 exclusive  -> gap = (3,5)
  (let [g (range-gap (closed-range 1 3) (closed-range 5 8))]
    (println (range-bound-inclusive? (range-lower g)))  ; false
    (println (range-bound-value      (range-lower g)))  ; 3
    (println (range-bound-inclusive? (range-upper g)))  ; false
    (println (range-bound-value      (range-upper g)))) ; 5
  ; gap between [1,3) and (3,8]: endpoints 3 exclusive and 3 exclusive
  ;   gap.lower = flip(3 excl) = 3 inclusive
  ;   gap.upper = flip(3 excl) = 3 inclusive  -> gap = [3,3] (singleok?n)
  (let [g (range-gap (closed-open-range 1 3) (open-range 3 8))]
    (println (range-bound-inclusive? (range-lower g)))  ; true
    (println (range-bound-value      (range-lower g)))  ; 3
    (println (range-bound-inclusive? (range-upper g)))  ; true
    (println (range-bound-value      (range-upper g))))) ; 3
