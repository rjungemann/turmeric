;; Phase D0: Unambiguous dispatch -- one TestFunctor instance, erased receiver.
;; When mk returns :int (type erased) but only one TestFunctor instance is registered,
;; the fallback is unambiguous and must be accepted silently (no error).

(defclass TestFunctor [^f]
  (fmap [container fn] : int))

;; Option helpers (inline layout: { bool is_some; int64_t value; })
(defn __opt_some [x] : int
  ```c
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn __opt_some? [o] : bool
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return p != 0 && p->is_some;
  ```)

(defn __opt_unwrap [o] : int
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return (int64_t)(p->value);
  ```)

(defn __fmap_option [container fn] : int
  ```c
  struct { bool is_some; int64_t value; } *c =
      (void *)(intptr_t)container;
  if (!c || !c->is_some) return container;
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = ((int64_t(*)(int64_t))(intptr_t)fn)(c->value);
  return (int64_t)(intptr_t)r;
  ```)

;; Only one TestFunctor instance -- dispatch is unambiguous even with erased receiver.
(definstance TestFunctor [option]
  (fmap [c f] (__fmap_option c f)))

;; mk returns :int (type erased) even though it produces an option value.
(defn mk [] : int (__opt_some 42))

;; double the integer inside an option via the typeclass dispatch path
(defn twice [x] : int (* x 2))

(defn main [] : int
  (let [obj (mk)]
    (let [result (.fmap obj twice)]
      (do
        (println (__opt_some? result))
        (println (__opt_unwrap result))
        0))))
