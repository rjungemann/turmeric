;; Phase B4: Logic programming -- multi-answer query.
;; Three-way disjunction: x=1, x=2, x=3 -> 3 results when run up to 5.
;; Uses the pure-Turmeric stdlib/logic.tur engine (no inline-C).

(load "stdlib/logic.tur")

(defn main [] : int
  (let [results (run-logic 5 (disjoined (lequal (term-var 0) (term-int 1))
                                        (disjoined (lequal (term-var 0) (term-int 2))
                                                   (lequal (term-var 0) (term-int 3)))))]
    (println (bt-length results))
    0))
