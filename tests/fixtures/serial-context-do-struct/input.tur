;; Phase 21 (capture-grammar generalization): a do-tail loop that takes a rich
;; Serializable struct as its captured configuration.
;;
;;   (serial-reset (do (init) (serial-shift k v) (run-loop cfg)))
;;
;; where cfg is a Serializable value bound outside the reset. The do-tail 1-arg
;; ignore-value frame routes the env through cfg's Serializable instance
;; (serialize -> bytes, deserialize -> value), so arbitrary loop state -- packed
;; into one Serializable struct, the idiom CLAUDE.md recommends -- is captured
;; into the saved continuation and survives a save-cont!/resume-cont! round-trip.
;; This is the general "resume into the loop with its state" shape the
;; application-image-dumps plan needs.

(load "stdlib/serial.tur")
(load "stdlib/workflow.tur")

(defopaque Rec :ptr<void>)
(defn mk-rec [a : int b : int] : Rec
  ```c int64_t *r=(int64_t*)malloc(16); r[0]=a; r[1]=b; return (void *)(intptr_t)r; ```)

(definstance Serializable [Rec]
  (serialize [x]
    ```c int64_t *r=(int64_t*)(intptr_t)x; int64_t *buf=(int64_t*)malloc(24);
    buf[0]=16; buf[1]=r?r[0]:0; buf[2]=r?r[1]:0; return buf; ```)
  (deserialize [b]
    ```c int64_t *d=(int64_t*)b+1; int64_t *r=(int64_t*)malloc(16);
    r[0]=d[0]; r[1]=d[1]; return (void *)(intptr_t)r; ```))

;; the captured loop reads its Rec config.
(defn run-loop [r : Rec] : int
  ```c int64_t *p=(int64_t*)(intptr_t)r; return p?p[0]+p[1]:0; ```)

(defn rt [k : ptr<void>] : int
  (resume-cont! (save-cont! k) 0))

(defn twice [k : ptr<void>] : int
  (let [b (save-cont! k)]
    (+ (resume-cont! b 0) (resume-cont! b 0))))

(defn main [] : int
  (let [cfg (mk-rec 30 12)]
    ;; capture + marshal + resume once
    (println (serial-reset (do (println "init") (serial-shift rt 0) (run-loop cfg))))   ; 42
    ;; capture + marshal + resume twice from the same saved bytes
    (println (serial-reset (do (println "init") (serial-shift twice 0) (run-loop cfg))))) ; 84
  0)
