; IT4: any type -- A <: any for all A.
; A function accepting 'any' can be called with values of any primitive type.
; Note: pointer-sized types (cstr) require boxing codegen (deferred to IT4 polish).
; This test uses int and bool, which fit in the int64_t representation.

(defn ignore-value [x : any] :nil
  nil)

; int <: any
(ignore-value 42)
; bool <: any
(ignore-value true)

; Union simplification: (int | any) -> any
(defn accept-any [x : (int | any)] :nil
  nil)

(accept-any 99)
(accept-any false)

(println "ok")
