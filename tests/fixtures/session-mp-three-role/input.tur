;; SS8: session-mp-three-role -- 3-role pipeline prook?col.
;; A sends 42 ok? B, B forwards ok? C, C receives and prints it.

(defprook?col Pipeline [A B C]
  (-> A B int)
  (-> B C int))

(defn spawn [f :ptr<void>] :ptr<void>
  ```c
  pthread_t *tid = (pthread_t *)malloc(sizeof(pthread_t));
  pthread_create(tid, NULL, tur_session_thread_wrapper, f);
  return (void *)tid;
  ```)

(defn join [t :ptr<void>] :int
  ```c
  pthread_join(*(pthread_t *)t, NULL);
  free(t);
  return 0;
  ```)

(defn role-a [^linear ch :(Role Pipeline A)] :nil
  (let [ch (send-ok? ch B 42)]
    (close ch)))

(defn role-b [^linear ch :(Role Pipeline B)] :nil
  (let [[v ch] (recv-from ch A)]
    (let [ch (send-ok? ch C v)]
      (close ch))))

(defn role-c [^linear ch :(Role Pipeline C)] :nil
  (let [[v ch] (recv-from ch B)]
    (println v)
    (close ch)))

(defn main [] :int
  (let [[ra rb rc] (make-prook?col Pipeline)]
    (let [ta (spawn (fn [] (role-a ra)))]
      (let [tb (spawn (fn [] (role-b rb)))]
        (role-c rc)
        (join ta)
        (join tb))))
  0)
