;; SS8: session-mp-three-role -- 3-role pipeline protocol.
;; A sends 42 to B, B forwards to C, C receives and prints it.

(load "stdlib/session.tur")

(defprotocol Pipeline [A B C]
  (-> A B int)
  (-> B C int))

(defn role-a [^linear ch :(Role Pipeline A)] : nil
  (let [ch (send-to ch B 42)]
    (close ch)))

(defn role-b [^linear ch :(Role Pipeline B)] : nil
  (let [[v ch] (recv-from ch A)]
    (let [ch (send-to ch C v)]
      (close ch))))

(defn role-c [^linear ch :(Role Pipeline C)] : nil
  (let [[v ch] (recv-from ch B)]
    (println v)
    (close ch)))

(defn main [] : int
  (let [[ra rb rc] (make-protocol Pipeline)]
    (let [ta (session-spawn (fn [] (role-a ra)))]
      (let [tb (session-spawn (fn [] (role-b rb)))]
        (role-c rc)
        (session-join ta)
        (session-join tb))))
  0)
