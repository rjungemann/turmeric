(load "stdlib/arrow.tur")

(defn make-scale [k : float] : ptr<void>
  (fn [^fat sig : (fn [float] #fx{} float)] : ptr<void>
    (fn [t : float] : float (* k (sig t)))))

(defn constant [v : float] : ptr<void>
  (fn [t : float] : float v))

(defn main [] : int
  (let [^fat sf1 : (fn [ptr<void>] #fx{} ptr<void>) (make-scale 2.0)
        ^fat sf2 : (fn [ptr<void>] #fx{} ptr<void>) (make-scale 3.0)
        ^fat composed : (fn [ptr<void>] #fx{} ptr<void>) (>>> sf1 sf2)
        ^fat input : (fn [float] #fx{} float) (constant 1.0)
        ^fat out : (fn [float] #fx{} float) (composed input)]
    (println (out 0.0)))
  0)
