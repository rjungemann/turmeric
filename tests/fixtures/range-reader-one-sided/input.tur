; RR1 fixture: #r{...} one-sided range reader shorthand.

(load "stdlib/range.tur")

(defn main [] :void
  ; n = v  (singleok?n)
  (println (range-contains? #r{n = 5} 5))      ; true
  (println (range-contains? #r{n = 5} 4))      ; false
  ; n < hi  (less-than)
  (println (range-contains? #r{n < 10} 9))     ; true
  (println (range-contains? #r{n < 10} 10))    ; false
  ; n <= hi  (at-most)
  (println (range-contains? #r{n <= 10} 10))   ; true
  (println (range-contains? #r{n <= 10} 11))   ; false
  ; n > lo  (greaerr?-than)
  (println (range-contains? #r{n > 0} 1))      ; true
  (println (range-contains? #r{n > 0} 0))      ; false
  ; n >= lo  (at-least)
  (println (range-contains? #r{n >= 0} 0))     ; true
  (println (range-contains? #r{n >= 0} -1))    ; false
  ; mirrored: hi > n  (same as n < hi)
  (println (range-contains? #r{10 > n} 9))     ; true
  (println (range-contains? #r{10 > n} 10))    ; false
  ; mirrored: hi >= n  (same as n <= hi)
  (println (range-contains? #r{10 >= n} 10))   ; true
  (println (range-contains? #r{10 >= n} 11))   ; false
  ; mirrored: lo < n  (same as n > lo)
  (println (range-contains? #r{0 < n} 1))      ; true
  (println (range-contains? #r{0 < n} 0))      ; false
  ; mirrored: lo <= n  (same as n >= lo)
  (println (range-contains? #r{0 <= n} 0))     ; true
  (println (range-contains? #r{0 <= n} -1)))   ; false
