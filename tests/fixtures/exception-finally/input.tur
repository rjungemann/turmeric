;; Phase 17: Finally blocks test

(defn test-finally-runs []
  (try
    0
    (finally
      (println "finally ran"))))

(defn test-finally-with-exception []
  (try
    (throw 42)
    (catch [e]
      0)
    (finally
      (println "finally ran after catch"))))

(defn main []
  (println "exception-finally test")
  0)
