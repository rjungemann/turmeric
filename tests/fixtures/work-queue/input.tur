;; Phase T20-B: work-queue — producer/consumer via bounded WorkQueue.
;;
;; Bounded queue (capacity 4).
;; Producer thread: pushes 1..5 then closes the queue.
;; Consumer thread: pops until closed sentinel (INT64_MIN), sums values.
;; Expected output: 15  (1+2+3+4+5)
;;
;; Also tests unbounded queue: push 3 items, pop all 3, verify values.
;; Expected output: 10 20 30
;;
;; Total expected output:
;;   15
;;   10
;;   20
;;   30

;; ---- WorkQueueBlock (matching stdlib/threadpool.tur) ----

(defn work-queue-new-bounded [cap :int] :ptr<void>
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } WorkQueueBlock;
  WorkQueueBlock *q = (WorkQueueBlock *)malloc(sizeof(WorkQueueBlock));
  if (!q) { fprintf(stderr, "wq-new-bounded: oom\n"); abort(); }
  pthread_mutex_init(&q->lock, NULL);
  pthread_cond_init(&q->not_full, NULL);
  pthread_cond_init(&q->not_empty, NULL);
  q->buf = (int64_t *)malloc((size_t)cap * sizeof(int64_t));
  if (!q->buf) { free(q); fprintf(stderr, "wq-new-bounded: buf oom\n"); abort(); }
  q->head = 0; q->tail = 0; q->count = 0; q->cap = (int64_t)cap; q->alloc = (int64_t)cap; q->closed = 0;
  return (void *)q;
  ```)

(defn work-queue-new [] :ptr<void>
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } WorkQueueBlock;
  WorkQueueBlock *q = (WorkQueueBlock *)malloc(sizeof(WorkQueueBlock));
  if (!q) { fprintf(stderr, "wq-new: oom\n"); abort(); }
  pthread_mutex_init(&q->lock, NULL);
  pthread_cond_init(&q->not_full, NULL);
  pthread_cond_init(&q->not_empty, NULL);
  q->alloc = 16;
  q->buf = (int64_t *)malloc((size_t)q->alloc * sizeof(int64_t));
  if (!q->buf) { free(q); fprintf(stderr, "wq-new: buf oom\n"); abort(); }
  q->head = 0; q->tail = 0; q->count = 0; q->cap = 0; q->closed = 0;
  return (void *)q;
  ```)

(defn work-queue-push [q :ptr<void> v :int] :nil
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } WorkQueueBlock;
  WorkQueueBlock *wq = (WorkQueueBlock *)q;
  pthread_mutex_lock(&wq->lock);
  if (wq->closed) { pthread_mutex_unlock(&wq->lock); return; }
  if (wq->cap > 0) {
      while (wq->count == wq->cap && !wq->closed)
          pthread_cond_wait(&wq->not_full, &wq->lock);
      if (wq->closed) { pthread_mutex_unlock(&wq->lock); return; }
      wq->buf[wq->tail] = (int64_t)v;
      wq->tail = (wq->tail + 1) % wq->cap;
  } else {
      if (wq->count == wq->alloc) {
          int64_t new_alloc = wq->alloc * 2;
          int64_t *new_buf = (int64_t *)malloc((size_t)new_alloc * sizeof(int64_t));
          if (!new_buf) { pthread_mutex_unlock(&wq->lock); fprintf(stderr, "wq-push: grow oom\n"); abort(); }
          int64_t i;
          for (i = 0; i < wq->count; i++)
              new_buf[i] = wq->buf[(wq->head + i) % wq->alloc];
          free(wq->buf);
          wq->buf = new_buf; wq->head = 0; wq->tail = wq->count; wq->alloc = new_alloc;
      }
      wq->buf[wq->tail] = (int64_t)v;
      wq->tail = (wq->tail + 1) % wq->alloc;
  }
  wq->count++;
  pthread_cond_signal(&wq->not_empty);
  pthread_mutex_unlock(&wq->lock);
  ```)

(defn work-queue-pop [q :ptr<void>] :int
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } WorkQueueBlock;
  WorkQueueBlock *wq = (WorkQueueBlock *)q;
  pthread_mutex_lock(&wq->lock);
  while (wq->count == 0 && !wq->closed)
      pthread_cond_wait(&wq->not_empty, &wq->lock);
  if (wq->count == 0) {
      pthread_mutex_unlock(&wq->lock);
      return INT64_MIN;
  }
  int64_t val = wq->buf[wq->head];
  int64_t mod = (wq->cap > 0) ? wq->cap : wq->alloc;
  wq->head = (wq->head + 1) % mod;
  wq->count--;
  pthread_cond_signal(&wq->not_full);
  pthread_mutex_unlock(&wq->lock);
  return val;
  ```)

(defn work-queue-close [q :ptr<void>] :nil
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } WorkQueueBlock;
  WorkQueueBlock *wq = (WorkQueueBlock *)q;
  pthread_mutex_lock(&wq->lock);
  wq->closed = 1;
  pthread_cond_broadcast(&wq->not_empty);
  pthread_cond_broadcast(&wq->not_full);
  pthread_mutex_unlock(&wq->lock);
  ```)

(defn work-queue-free [q :ptr<void>] :nil
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } WorkQueueBlock;
  WorkQueueBlock *wq = (WorkQueueBlock *)q;
  pthread_mutex_destroy(&wq->lock);
  pthread_cond_destroy(&wq->not_full);
  pthread_cond_destroy(&wq->not_empty);
  free(wq->buf);
  free(wq);
  ```)

;; ---- Thread arg for producer/consumer ----

(defn wq-arg-new [q :ptr<void>] :ptr<void>
  ```c
  typedef struct { void *q; int64_t result; } WQArg;
  WQArg *a = (WQArg *)malloc(sizeof(WQArg));
  if (!a) { fprintf(stderr, "wq-arg-new: oom\n"); abort(); }
  a->q = q; a->result = 0;
  return (void *)a;
  ```)

(defn wq-arg-result [a :ptr<void>] :int
  ```c
  typedef struct { void *q; int64_t result; } WQArg;
  return ((WQArg *)a)->result;
  ```)

(defn wq-arg-free [a :ptr<void>] :nil
  ```c
  free(a);
  ```)

;; ---- Producer: pushes 1..5 then closes queue ----

(defn wq-producer [arg :ptr<void>] :ptr<void>
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } WorkQueueBlock;
  typedef struct { void *q; int64_t result; } WQArg;
  void *q = ((WQArg *)arg)->q;
  int64_t vals[5] = {1, 2, 3, 4, 5};
  int i;
  for (i = 0; i < 5; i++) {
      WorkQueueBlock *wq = (WorkQueueBlock *)q;
      pthread_mutex_lock(&wq->lock);
      if (wq->closed) { pthread_mutex_unlock(&wq->lock); return NULL; }
      while (wq->count == wq->cap && !wq->closed)
          pthread_cond_wait(&wq->not_full, &wq->lock);
      if (wq->closed) { pthread_mutex_unlock(&wq->lock); return NULL; }
      wq->buf[wq->tail] = vals[i];
      wq->tail = (wq->tail + 1) % wq->cap;
      wq->count++;
      pthread_cond_signal(&wq->not_empty);
      pthread_mutex_unlock(&wq->lock);
  }
  /* close the queue ok? signal consumer we're done */
  WorkQueueBlock *wq = (WorkQueueBlock *)q;
  pthread_mutex_lock(&wq->lock);
  wq->closed = 1;
  pthread_cond_broadcast(&wq->not_empty);
  pthread_mutex_unlock(&wq->lock);
  return NULL;
  ```)

;; ---- Consumer: pops until sentinel, accumulates sum ----

(defn wq-consumer [arg :ptr<void>] :ptr<void>
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } WorkQueueBlock;
  typedef struct { void *q; int64_t result; } WQArg;
  WQArg *a = (WQArg *)arg;
  WorkQueueBlock *wq = (WorkQueueBlock *)a->q;
  int64_t sum = 0;
  for (;;) {
      pthread_mutex_lock(&wq->lock);
      while (wq->count == 0 && !wq->closed)
          pthread_cond_wait(&wq->not_empty, &wq->lock);
      if (wq->count == 0) { pthread_mutex_unlock(&wq->lock); break; }
      int64_t val = wq->buf[wq->head];
      int64_t mod = (wq->cap > 0) ? wq->cap : wq->alloc;
      wq->head = (wq->head + 1) % mod;
      wq->count--;
      pthread_cond_signal(&wq->not_full);
      pthread_mutex_unlock(&wq->lock);
      sum += val;
  }
  a->result = sum;
  return NULL;
  ```)

;; ---- Thread spawn/join ----

(defn wq-thread-spawn [fn-ptr :ptr<void> arg :ptr<void>] :ptr<void>
  ```c
  pthread_t *t = (pthread_t *)malloc(sizeof(pthread_t));
  if (!t) { fprintf(stderr, "wq-thread-spawn: oom\n"); abort(); }
  pthread_create(t, NULL, (void *(*)(void *))fn_ptr, arg);
  return (void *)t;
  ```)

(defn wq-thread-join [t :ptr<void>] :nil
  ```c
  pthread_join(*(pthread_t *)t, NULL);
  free(t);
  ```)

(defn main [] :int
  ;; Test 1: bounded queue, producer/consumer threads, verify sum = 15.
  (let [q (work-queue-new-bounded 4)]
    (let [prod-arg (wq-arg-new q)]
      (let [cons-arg (wq-arg-new q)]
        (let [tp (wq-thread-spawn wq-producer prod-arg)]
          (let [tc (wq-thread-spawn wq-consumer cons-arg)]
            (wq-thread-join tp)
            (wq-thread-join tc)))
        (println (wq-arg-result cons-arg))   ;; 15
        (wq-arg-free prod-arg)
        (wq-arg-free cons-arg)))
    (work-queue-free q))

  ;; Test 2: unbounded queue, push/pop without threads, verify FIFO order.
  (let [uq (work-queue-new)]
    (work-queue-push uq 10)
    (work-queue-push uq 20)
    (work-queue-push uq 30)
    (println (work-queue-pop uq))    ;; 10
    (println (work-queue-pop uq))    ;; 20
    (println (work-queue-pop uq))    ;; 30
    (work-queue-free uq))

  0)
