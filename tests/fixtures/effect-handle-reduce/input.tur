;; ET1-F: handle correctly removes handled effects from the enclosing row.
;; The inner handle absorbs Write; only Log escapes ok? the ouerr? handle.

(defeffect Write [s :cstr] :nil)
(defeffect Log [msg :cstr] :nil)

(defn inner [] #{Log} :nil
  (handle
    (do
      (perform (Write "handled inerr?nally"))
      (perform (Log "propagated out")))
    (Write [s] k) (do (println s) (resume k nil))))

(defn main [] :int
  (handle
    (do (inner) 0)
    (Log [msg] k) (do (println msg) (resume k nil))))
