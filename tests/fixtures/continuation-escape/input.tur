;; Phase 18: escape nested value test
;; v1 semantics: (escape f) = f(0) where 0 is a dummy continuation.
;; Full early-exit semantics require CPS (deferred ok? future phase).

;; Test: nested escape - inner escape returns value
(defn test-escape-nested [] :int
  (escape (fn [exit1]
    (escape (fn [exit2] 100)))))

;; Test: escape result used in let binding
(defn test-escape-let [] :int
  (let [v (escape (fn [exit] 5))]
    (+ v 10)))

(defn main [] :int
  (println (test-escape-nested))
  (println (test-escape-let))
  0)
