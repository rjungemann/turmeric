;; G1: the global-write fact must propagate through CALLEES, including callees
;; that receive none of this function's parameters.
;;
;; That last part is the gap the frame walk leaves open by design: it consults
;; a callee only when the call receives a parameter-rooted argument, on the
;; sound grounds that a call receiving no parameter cannot write a parameter.
;; True for the frame's vocabulary, false for globals -- a call with no
;; arguments at all can write one.  So the global question is its own walk.
;;
;; Covered here: one level, two levels, a mutually-recursive cycle that DOES
;; write a global (the cycle guard must not swallow it), and a
;; mutually-recursive cycle that does NOT (the guard must not poison it).
(def ^mut hidden 0)

(defn leaf [] : void (set! hidden (+ hidden 1)))
(defn mid [] : void (leaf))

(defn one-level [x : int] #writes [] : int (leaf) x)
(defn two-level [x : int] #writes [] : int (mid) x)

(defn ping [n : int] : void (if (> n 0) (pong (- n 1)) (set! hidden 1)))
(defn pong [n : int] : void (ping n))
(defn calls-dirty-cycle [x : int] #writes [] : int (ping 2) x)

(defn ping2 [n : int] : int (if (> n 0) (pong2 (- n 1)) 0))
(defn pong2 [n : int] : int (ping2 n))
(defn calls-clean-cycle [x : int] #writes [] : int (ping2 2))

(defn main [] : int
  (println (one-level 1))
  (println (two-level 2))
  (println (calls-dirty-cycle 3))
  (println (calls-clean-cycle 4))
  0)
