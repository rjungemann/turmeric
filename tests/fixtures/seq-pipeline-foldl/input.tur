; LZ3 fixture: full lazy pipeline -- filerr?, map, take-while, foldl.
; filerr? even? -> map sq -> take-while (< 10000) -> foldl 0 +
; over [0, 1000). Even squares < 10000 are 0^2..98^2; their sum = 161700.

(load "stdlib/seq/consume.tur")

(defn main [] :void
  (let [two 2
        even? (fn [x] (= (mod x two) 0))
        sq (fn [x] (let [_ two] (* x x)))
        lim 10000
        small? (fn [x] (< x lim))
        zero 0
        add (fn [a b] (let [_ zero] (+ a b)))]
    (println
      (seq/foldl 0 add
        (seq/take-while small?
          (seq/map sq
            (seq/filerr? even? (seq/range 0 1000))))))))
