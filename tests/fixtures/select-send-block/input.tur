;; Phase SEL1: select-send-block -- (select ...) with :send clauses.
;;
;; Two consumer threads drain separate channels (ch-a and ch-b).
;; The main thread uses (select ((ch-a :send v) ...) ((ch-b :send v) ...)) 6
;; times to distribute 6 values across whichever channel has space.
;;
;; Consumer A accumulates values from ch-a.
;; Consumer B accumulates values from ch-b.
;; Each consumer receives exactly 3 values (staggered via cap=1 channels so that
;; the select must block when both are full).
;;
;; The select sends values 1, 2, 3, 4, 5, 6 in sequence.
;; Because send-select is non-deterministic as to WHICH channel gets each value,
;; we verify only that all 6 values are delivered: sum-a + sum-b = 21.
;; Expected output: 21

(defn chan-new [cap :int] :ptr<void>
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t  not_full;
      pthread_cond_t  not_empty;
      int64_t        *buf;
      int64_t         head;
      int64_t         tail;
      int64_t         count;
      int64_t         cap;
      void           *recv_waiters;
      void           *send_waiters;
  } ChanBlock;
  ChanBlock *ch = (ChanBlock *)malloc(sizeof(ChanBlock));
  if (!ch) { fprintf(stderr, "chan-new: oom\n"); abort(); }
  ch->buf = (int64_t *)malloc(sizeof(int64_t) * (size_t)cap);
  if (!ch->buf) { free(ch); fprintf(stderr, "chan-new: buf oom\n"); abort(); }
  pthread_mutex_init(&ch->lock, NULL);
  pthread_cond_init(&ch->not_full, NULL);
  pthread_cond_init(&ch->not_empty, NULL);
  ch->head = 0; ch->tail = 0; ch->count = 0; ch->cap = (int64_t)cap;
  ch->recv_waiters = NULL; ch->send_waiters = NULL;
  return (void *)ch;
  ```)

(defn chan-free [ch :ptr<void>] :nil
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count; int64_t cap;
      void *recv_waiters; void *send_waiters;
  } ChanBlock;
  ChanBlock *c = (ChanBlock *)ch;
  pthread_mutex_destroy(&c->lock);
  pthread_cond_destroy(&c->not_full);
  pthread_cond_destroy(&c->not_empty);
  free(c->buf);
  free(c);
  ```)

;; Consumer: receives n values from ch, returns their sum via a result channel.
(defn consumer [arg :ptr<void>] :ptr<void>
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count; int64_t cap;
      void *recv_waiters; void *send_waiters;
  } ChanBlock;
  typedef struct { void *ch; int64_t n; int64_t result; } CArg;
  CArg *a = (CArg *)arg;
  void *ch = a->ch;
  int64_t sum = 0;
  int64_t i;
  for (i = 0; i < a->n; i++) {
      ChanBlock *c = (ChanBlock *)ch;
      pthread_mutex_lock(&c->lock);
      while (c->count == 0) pthread_cond_wait(&c->not_empty, &c->lock);
      int64_t v = c->buf[c->head];
      c->head = (c->head + 1) % c->cap;
      c->count--;
      pthread_cond_signal(&c->not_full);
      tur_waiter_signal_one(c->send_waiters);
      pthread_mutex_unlock(&c->lock);
      sum += v;
  }
  a->result = sum;
  return NULL;
  ```)

(defn carg-new [ch :ptr<void> n :int] :ptr<void>
  ```c
  typedef struct { void *ch; int64_t n; int64_t result; } CArg;
  CArg *a = (CArg *)malloc(sizeof(CArg));
  if (!a) { fprintf(stderr, "carg-new: oom\n"); abort(); }
  a->ch = ch; a->n = (int64_t)n; a->result = 0;
  return (void *)a;
  ```)

(defn carg-result [a :ptr<void>] :int
  ```c
  typedef struct { void *ch; int64_t n; int64_t result; } CArg;
  return ((CArg *)a)->result;
  ```)

(defn carg-free [a :ptr<void>] :nil
  ```c
  free(a);
  ```)

(defn thread-spawn-fn [fn-ptr :ptr<void> arg :ptr<void>] :ptr<void>
  ```c
  pthread_t *t = (pthread_t *)malloc(sizeof(pthread_t));
  if (!t) { fprintf(stderr, "thread-spawn: oom\n"); abort(); }
  pthread_create(t, NULL, (void *(*)(void *))fn_ptr, arg);
  return (void *)t;
  ```)

(defn thread-join [t :ptr<void>] :nil
  ```c
  pthread_join(*(pthread_t *)t, NULL);
  free(t);
  ```)

;; Send 6 values via select :send across two channels.
;; Consumers each drain exactly 3 values.
(defn send-loop [ch-a :ptr<void> ch-b :ptr<void> iter :int v :int] :int
  (if (= iter 0)
    0
    (let [_ (select ((ch-a :send v) 0)
                    ((ch-b :send v) 0))]
      (send-loop ch-a ch-b (- iter 1) (+ v 1)))))

(defn main [] :int
  (let [ch-a (chan-new 1)
        ch-b (chan-new 1)]
    (let [arg-a (carg-new ch-a 3)
          arg-b (carg-new ch-b 3)]
      (let [tp-a (thread-spawn-fn consumer arg-a)
            tp-b (thread-spawn-fn consumer arg-b)]
        ;; Send values 1..6 across both channels via select :send
        (send-loop ch-a ch-b 6 1)
        (thread-join tp-a)
        (thread-join tp-b)
        (let [sum (+ (carg-result arg-a) (carg-result arg-b))]
          (println sum)    ;; 21  (1+2+3+4+5+6)
          (carg-free arg-a)
          (carg-free arg-b)
          (chan-free ch-a)
          (chan-free ch-b))))
    0))
