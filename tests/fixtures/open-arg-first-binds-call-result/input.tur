;; open-arg-first-binds-call-result -- an argument that fixes nothing about a
;; type variable (`(none)`, `(err "e")`, `(vec-new)`) passed BEFORE the one
;; that does.  The open argument bound the callee's `A` to its own free
;; variable first, and the later concrete argument did not replace it, so the
;; call's RESULT typed as `int` while the spec ran at the real type:
;;
;;     (get-or (none) 1.5)        printed 1
;;     (ok-or (err "e") 2.75)     printed 2
;;     (first-or (vec-new) 9.5)   printed 9
;;     (get-or (none) "dflt")     printed the string's address
;;
;; Silent, because the callee's variable and `(none)`'s are both named `A`
;; and the rule that keeps the ENCLOSING signature's variable bound let the
;; coincidence through; under any other name it was "expected A, got float".
;; The argument order with the concrete argument first was always right.

(defstruct Pt [x : float y : float])

(defn get-or [A] [o : (Option A) d : A] : A
  (match o
    (Some v) v
    (None) d))

(defn get-or-b [B] [o : (Option B) d : B] : B
  (match o
    (Some v) v
    (None) d))

(defn ok-or [A] [r : (Result A cstr) d : A] : A
  (match r
    (Ok v) v
    (Err e) d))

(defn first-or [A] [v : (Vec A) d : A] : A
  (if (= (vec-len v) 0) d (vec-get v 0)))

(defn main [] : int
  (println (get-or (none) 1.5))
  (println (get-or-b (none) 7.1))
  (println (get-or (none) "dflt"))
  (println (.y (get-or (none) (Pt 7.1 3.25))))
  (println (ok-or (err "e") 2.75))
  (println (first-or (vec-new) 9.5))
  (let [x (get-or (none) 1.5)]
    (println (+ x 0.25)))
  ;; the concrete-first order, unchanged
  (println (get-or (some 4.5) 1.5))
  0)
