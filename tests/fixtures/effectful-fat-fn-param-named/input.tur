;; effectful-fat-fn-param-named -- a NAMED effectful defn passed as a `^fat`
;; parameter whose fn type carries a non-empty effect row.
;;
;; The sibling fixture effectful-fat-fn-param covers the inline-lambda shapes.
;; This one pins the named-defn shape, which hit TWO separate defects:
;;
;;  1. The E2a registry lookup keyed on the parameter's own value. `logit__cps`
;;     IS registered under `(intptr_t)logit`, and the fat record's direct-entry
;;     slot holds exactly `logit` -- but a `^fat` param carries the record, not
;;     the entry, so the lookup missed and the miss was called through NULL.
;;     See docs/archive/history/effectful-fn-typed-param-call-segfaults.md.
;;
;;  2. Boxing `logit` into that fat record was counted as *performing* its
;;     effect, so the handled body containing the box construction was refused
;;     by the CPS admission -- evicting the handler, tainting the effect,
;;     co-evicting `logit`, and landing its `perform` in the direct emitter,
;;     an ICE.  Taking a function's address runs nothing; only the call does.
;;     See docs/archive/history/named-effectful-defn-as-fat-fn-value-ices.md.
;;
;; Defect 2 is why the call's POSITION matters here: before it was fixed, only
;; the sole-`handle`-body shape reached codegen at all.  Each position below
;; took a different path to the same crash, so all three are exercised.

(defeffect Log [n : int] : nil)

(defn logit [x : int] #fx{Log} : nil
  (perform (Log x)))

;; the fn-value is called in non-tail position (the heap-join emit site)
(defn run-join [^fat lg : (fn [int] #fx{Log} nil) n : int] #fx{Log} : int
  (do (lg n) 7))

;; the fn-value is called in tail position
(defn run-tail [^fat lg : (fn [int] #fx{Log} nil) n : int] #fx{Log} : nil
  (lg n))

(defn main [] : int
  (handle
    (do
      ;; sequenced inside a `do` -- previously ICEd
      (run-join logit 1)
      (run-tail logit 2)
      ;; result nested in a builtin call -- previously ICEd
      (println (run-join logit 3))
      0)
    (Log [n] k) (do (println n) (resume k nil))))
