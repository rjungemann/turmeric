; Phase N3: arithmetic with new numeric types
(println (+ 10i8 20i8))
(println (- 100i8 50i8))
(println (* 3i8 4i8))
(println (/ 100i8 7i8))
(println (mod 100i8 7i8))
(println (+ 100u16 200u16))
(println (+ 1000000i32 2000000i32))
(println (+ 1.5f32 2.5f32))
(println (* 1.5f32 2.0f32))
(println (< 1i32 2i32))
(println (> 5u16 3u16))
(println (= 42u8 42u8))
(println (not= 1i8 2i8))
