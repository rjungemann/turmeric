;; list-homog-byvalue-aggregate-element -- a (list ...) literal whose elements
;; are by-value aggregates (Option is a by-value struct) must construct.
;;
;; Root cause (docs/archive/history/list-homog-helper-carrier-typed-byvalue-aggregate-element.md):
;; the (list ...) macro chains a compile-time homogeneity check
;; `tur-list-homog__ [A] [a :A b :A]` over adjacent elements. Its inline-C body
;; is a no-op; the type unification that enforces homogeneity already runs at
;; elaboration. But its single C signature takes the int64 carrier, so when an
;; element is a by-value aggregate (Option__int) the emitted -- and dead --
;; runtime call rejected it at the C level:
;;   incompatible type for argument 1 of 'tur_hylist_hyhomog_un_un'
;;   note: expected 'int64_t' but argument is of type 'Option__int'
;;
;; Fix: emit_stmt elides the dead homogeneity call when an argument is a
;; by-value (non-heap) aggregate -- scalar / float / cstr / heap-pointer
;; elements still coerce into the carrier and keep their existing codegen, so
;; the homogeneity check (and its TUR-E0001 on a genuinely heterogeneous list)
;; is unchanged. The list of Options now builds and its elements round-trip
;; through the typed accessors.

(defn opt-or [o : (Option int) d : int] : int
  (if (.is-some o) (.value o) d))

(defn main [] : int
  (let [xs (:: (list (some 42) (some 7) (some 100)) (Cons (Option int)))]
    (let [h0 (.head xs)
          t0 (:: (.tail xs)  (Cons (Option int)))
          h1 (.head t0)
          t1 (:: (.tail t0)  (Cons (Option int)))
          h2 (.head t1)]
      (println (opt-or h0 0))
      (println (opt-or h1 0))
      (println (opt-or h2 0))))
  0)
