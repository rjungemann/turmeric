(defn ls-new [data : ptr<void> length] : ptr<void>
  ```c
  struct { int64_t *p; size_t len; } *s = malloc(sizeof(*s));
  s->p = (int64_t*)data;
  s->len = (size_t)length;
  return s;
  ```)

(defn ls-len [s : ptr<void>] : int
  ```c
  struct { int64_t *p; size_t len; } *slice = (void*)s;
  return (int)slice->len;
  ```)

(defn ls-get [s : ptr<void> i] : int
  ```c
  struct { int64_t *p; size_t len; } *slice = (void*)s;
  if (i >= 0 && (size_t)i < slice->len) return (int)slice->p[i];
  fprintf(stderr, "slice index out of bounds\n");
  return 0;
  ```)

(defn ls-free [s : ptr<void>]
  ```c
  free(s);
  ```)

(defn make-buf [] : ptr<void>
  ```c
  int64_t *p = malloc(sizeof(int64_t) * 3);
  p[0] = 4;
  p[1] = 5;
  p[2] = 6;
  return p;
  ```)

(defn free-buf [p : ptr<void>]
  ```c
  free((void*)p);
  ```)

(defn main [] : int
  (let [p (make-buf)]
    (let [s (ls-new p 3)]
      (println (ls-len s))
      (println (ls-get s 0))
      (println (ls-get s 2))
      (ls-free s)
      (free-buf p)
      0)))
