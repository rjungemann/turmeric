; gc-deterministic: predictable collection -- multiple zombies collected at once.
; Both a and b become zombies; a single gc! collects both.
; Subsequent upgrade calls return none for both (not alive).
(defn lgc-some? [o : ptr<void>] : bool
  ```c
  struct { int tag; int64_t value; } *opt = (void*)o;
  return opt != NULL && opt->tag == 1;
  ```)

(defn main [] : int
  (gc-enable!)
  (let [a (rc/of 1)
        b (rc/of 2)]
    (let [wa (weak a)
          wb (weak b)]
      (rc/drop a)
      (rc/drop b)
      (gc!)
      (let [ua (upgrade wa)
            ub (upgrade wb)]
        (println (+ (if (lgc-some? ua) 1 0) (if (lgc-some? ub) 1 0))))))  ; expected: 0
  0)
