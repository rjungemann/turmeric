;; Phase R3: Error From/Inok? typeclass instances
;; Tests the From typeclass instances for error type upcasting
;;
;; Note: In v1, we use a simplified approach since the typeclass system
;; doesn't support generic instances for user-defined struct types yet.

;; Define error struct types locally
(defstruct Error [message :cstr cause :ptr<void>])
(defstruct IoError [message :cstr errno_val :int])
(defstruct ParseError [message :cstr line :int col :int file :cstr])

(defn main [] :int
  (do
    ;; Test that error structs can be created and used
    (let [io-err (make-struct IoError "file not found" 2)]
      (println "IoError created"))
    
    (let [parse-err (make-struct ParseError "syntax error" 10 5 "test.tur")]
      (println "ParseError created"))
    
    (let [err (make-struct Error "base error" 0)]
      (println "Error created"))
    
    0))
