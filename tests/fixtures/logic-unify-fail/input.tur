;; Phase B4: Logic programming -- unification failure.
;; Unify (term-int 1) with (term-int 2): fails, 0 results.
;; Uses the pure-Turmeric stdlib/logic.tur engine (no inline-C).

(load "stdlib/logic.tur")

(defn main [] : int
  (let [results (run-logic 1 (lequal (term-int 1) (term-int 2)))]
    (println (bt-length results))
    0))
