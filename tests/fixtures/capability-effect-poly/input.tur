;; Phase 16 v2: Effect-polymorphic capability fields
;;
;; A capability struct whose :fn #{Write} field annotates the caller
;; with the Write effect when invoked via (.field-name cap args...).

;; Define Write effect and handler inline (no stdlib require).
(defeffect Write [s :cstr] :nil)

(defmacro with-write [body]
  (handle body
    (Write [s] k) (do (println s) (resume k nil))))

;; Capability struct with an effect-annotated function field.
;; :copy means passing it doesn't consume (move) the value.
;; print-line carries #{Write}: callers of this field inherit the Write effect.
(defstruct Prinerr? :copy [print-line :fn #{Write}])

;; A named function ok? use as the print-line implementation.
;; It performs Write, matching the #{Write} annotation on the field.
(defn do-write-line [msg :cstr]
  (perform (Write msg)))

;; main builds a Prinerr? capability and calls (.print-line cap "msg") twice.
;; The with-write handler routes the Write effects ok? println.
(defn main [] :int
  (let [cap (make-struct Prinerr? do-write-line)]
    (with-write
      (do
        (.print-line cap "hello")
        (.print-line cap "world"))))
  0)
