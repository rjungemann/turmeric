; RM3: bare-identifier reader macros (`#foo` with no body).
;
; Registered with `:none`. The template is a literal datum -- no body to
; splice and no `$N` markers. Whatever follows `#foo` is left for the
; next read; in particular, `#foo(...)` is read as the bare expansion
; followed by a regular `(...)` form, *unless* a `(name, '(')` entry is
; also registered (it would win the lookup).

; --- A bare constant ------------------------------------------------------
; #zero  ->  0
(reader-macros/define 'zero :none '0)
(println #zero)                       ; 0

; --- A bare float literal -------------------------------------------------
; #pi    ->  3.14159
(reader-macros/define 'pi :none '3.14159)
(println #pi)                         ; 3.14159

; --- A bare expression ----------------------------------------------------
; #two-plus-three  ->  (+ 2 3)
(reader-macros/define 'two-plus-three :none '(+ 2 3))
(println #two-plus-three)             ; 5

; --- Bare expansion inside a surrounding call -----------------------------
; Demonstrates that `#zero`/`#pi` work as ordinary atoms in argument
; positions.
(println (+ #zero #zero 7))           ; 7
