;; forall-dict-pass-nested-mapper-general-plan (Phase 3 acceptance): a dispatch
;; TWO lambdas deep.  The outer van Laarhoven mapper builds an inner mapper and
;; hands it to a (concrete Identity) `fmap`; the INNER mapper `(fn [y] (show y))`
;; dispatches `show` on the focus tyvar.  The constraint dict must thread through
;; each enclosing lambda's env: the inner mapper captures the Show dict, and the
;; outer mapper FORWARDS that same dict inward through its own env so the inner
;; closure can be constructed with it.  Previously rejected with TUR-E0311
;; (dispatch buried in a deeper nested lambda).

;; Identity a -- fmap runs the mapped function (so `show` actually runs).
(defopaque Identity [a] :int)
(defn mk-id [A] [x : A] : (Identity A) ```c return (int64_t)x; ```)
(defn run-id [A] [i : (Identity A)] : A ```c return (int64_t)i; ```)
(definstance Functor [Identity]
  (fmap [i g] (mk-id (g (run-id i)))))

;; Const r a -- fmap IGNORES the mapped function.
(defopaque Const [r a] :int)
(defn mk-const [A] [x : A] : (Const A A) ```c return (int64_t)x; ```)
(defn get-const [R A] [c : (Const R A)] : R ```c return (int64_t)c; ```)
(definstance Functor [(Const r)]
  (fmap [c g] (mk-const (get-const c))))

(defclass Show [a] (show [x] : cstr))
(definstance Show [int]
  (show [x] : cstr
    ```c
    char *buf = (char *)malloc(24);
    snprintf(buf, 24, "int:%lld", (long long)x);
    return (const char *)buf;
    ```))
(definstance Show [bool]
  (show [x] : cstr
    ```c
    return x ? "bool:true" : "bool:false";
    ```))

;; deep-lens: forall f a. (Functor f, Show a) => (a -> f a) -> a -> (f cstr)
;; The mapper passed to the outer (dict-dispatched) `fmap` is itself an ENCLOSING
;; lambda: it runs a concrete Identity `fmap` over an INNER mapper that does the
;; `show` dispatch.  Two lambdas deep -- the Show dict threads through both envs.
(defn deep-lens [^f a] [^Functor f ^Show a g : (-> a (f a)) s : a] : (f cstr)
  (fmap (g s)
        (fn [x : a] : cstr
          (run-id (fmap (mk-id x) (fn [y : a] : cstr (show y)))))))

(defn shown-int
    [l (forall [(f :: * -> *) a] [(Functor f) (Show a)] (-> (-> a (f a)) a (f cstr)))
     s : int] : cstr
  (run-id (l (fn [x : int] : (Identity int) (mk-id x)) s)))

(defn shown-bool
    [l (forall [(f :: * -> *) a] [(Functor f) (Show a)] (-> (-> a (f a)) a (f cstr)))
     s : bool] : cstr
  (run-id (l (fn [x : bool] : (Identity bool) (mk-id x)) s)))

(defn peek-int
    [l (forall [(f :: * -> *) a] [(Functor f) (Show a)] (-> (-> a (f a)) a (f cstr)))
     s : int] : int
  (get-const (l (fn [x : int] : (Const int int) (mk-const x)) s)))

(defn main [] : int
  (println (shown-int deep-lens 7))       ; int:7     (two-deep show, Show int)
  (println (shown-bool deep-lens true))   ; bool:true (two-deep show, Show bool)
  (println (peek-int deep-lens 42))       ; 42        (Const ignores the mapper)
  0)
