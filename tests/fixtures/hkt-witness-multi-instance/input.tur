;; Phase D1: Type witness with multiple instances -- disambiguation case.
;; Both TestFunctor[option] and TestFunctor[vec] are in scope.
;; @option and @vec witnesses select the correct implementation each time,
;; producing correct output for both types through erased-type receivers.

(defclass TestFunctor [^f]
  (fmap [container fn] : int))

;; Option helpers
(defn __opt_some [x] : int
  ```c
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn __opt_some? [o] : bool
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return p != 0 && p->is_some;
  ```)

(defn __opt_unwrap [o] : int
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return (int64_t)(p->value);
  ```)

(defn __fmap_option [container fn] : int
  ```c
  struct { bool is_some; int64_t value; } *c =
      (void *)(intptr_t)container;
  if (!c || !c->is_some) return container;
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = ((int64_t(*)(int64_t))(intptr_t)fn)(c->value);
  return (int64_t)(intptr_t)r;
  ```)

;; Vec helpers (minimal single-element vec)
(defn __vec_of [x] : int
  ```c
  struct { int64_t len; int64_t item; } *r = malloc(sizeof(*r));
  r->len = 1;
  r->item = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn __vec_get0 [v] : int
  ```c
  struct { int64_t len; int64_t item; } *p =
      (void *)(intptr_t)v;
  return p->item;
  ```)

(defn __fmap_vec [container fn] : int
  ```c
  struct { int64_t len; int64_t item; } *c =
      (void *)(intptr_t)container;
  struct { int64_t len; int64_t item; } *r = malloc(sizeof(*r));
  r->len = c->len;
  r->item = ((int64_t(*)(int64_t))(intptr_t)fn)(c->item);
  return (int64_t)(intptr_t)r;
  ```)

(definstance TestFunctor [option]
  (fmap [c f] (__fmap_option c f)))

(definstance TestFunctor [vec]
  (fmap [c f] (__fmap_vec c f)))

(defn add5 [x] : int (+ x 5))
(defn twice [x] : int (* x 2))

;; Both return :int (erased type).
(defn mk-opt [] : int (__opt_some 10))
(defn mk-vec [] : int (__vec_of 7))

(defn main [] : int
  (do
    ;; @option witness -> TestFunctor[option]: fmap add5 (some 10) => some 15
    (let [o (mk-opt)]
      (let [o2 (.fmap @option o add5)]
        (do
          (println (__opt_some? o2))   ;; true
          (println (__opt_unwrap o2))))) ;; 15

    ;; @vec witness -> TestFunctor[vec]: fmap twice (vec-of 7) => vec-of 14
    (let [v (mk-vec)]
      (let [v2 (.fmap @vec v twice)]
        (println (__vec_get0 v2))))    ;; 14
    0))
