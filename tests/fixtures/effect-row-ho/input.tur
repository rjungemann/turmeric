;; ER2: higher-order function with row variable propagates its argument's effects.
;; run-twice is polymorphic in the effects of f.

(defeffect Ask [] :int)

(defn run-twice [f :(fn [] #{e} :int)] #{e} : int
  (+ (f) (f)))

(defn main [] : int
  (let [result
    (handle
      (run-twice (fn [] (perform (Ask))))
      (Ask [] k) (resume k 21))]
    (println result)
    0))
