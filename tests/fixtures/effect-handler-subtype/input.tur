;; ET3-F3: Handler subtyping -- run a function that performs Write and collect result.
(defeffect Write [s :cstr] :nil)
(defn compute [] :int
  (do (perform (Write "result")) 42))
(defn main [] :int
  (let [r (handle (compute)
    (Write [s] k) (do (println s) (resume k nil)))]
    (println r)
    0))
