;;
;; Phase P1: HAMT merge test

(extern-c free [p :ptr] :void)

(defn ptr= [a :ptr b :ptr] :bool
  ```c
  return a == b;
  ```)

(defn alloc-int [x :int] :ptr
  ```c
  int64_t *p = malloc(sizeof(int64_t));
  *p = (int64_t)x;
  return (void *)p;
  ```)

;; Test: merge disjoint maps
(defn test-merge-disjoint [] :int
  (let [k1 (alloc-int 1)]
    (let [k2 (alloc-int 2)]
      (let [v1 (alloc-int 10)]
        (let [v2 (alloc-int 20)]
          (let [h1 (hamt/hash-ptr k1)]
            (let [h2 (hamt/hash-ptr k2)]
              (let [m1 (hamt/new)]
                (let [m2 (hamt/set m1 h1 k1 v1)]
                  (let [m3 (hamt/new)]
                    (let [m4 (hamt/set m3 h2 k2 v2)]
                      (let [merged (hamt/merge m2 m4)]
                        (let [c (hamt/count merged)]
                          (let [r1 (hamt/get merged h1 k1)]
                            (let [r2 (hamt/get merged h2 k2)]
                              (hamt/free m1)
                              (hamt/free m2)
                              (hamt/free m3)
                              (hamt/free m4)
                              (hamt/free merged)
                              (free k1)
                              (free k2)
                              (free v1)
                              (free v2)
                              (if (and (= c 2) (ptr= r1 v1) (ptr= r2 v2)) 1 0))))))))))))))))

;; Test: merge with overlapping keys (b wins)
(defn test-merge-overlapping [] :int
  (let [k1 (alloc-int 1)]
    (let [v1 (alloc-int 10)]
      (let [v2 (alloc-int 20)]
        (let [h1 (hamt/hash-ptr k1)]
          (let [m1 (hamt/new)]
            (let [m2 (hamt/set m1 h1 k1 v1)]
              (let [m3 (hamt/new)]
                (let [m4 (hamt/set m3 h1 k1 v2)]
                  (let [merged (hamt/merge m2 m4)]
                    (let [c (hamt/count merged)]
                      (let [r (hamt/get merged h1 k1)]
                        (hamt/free m1)
                        (hamt/free m2)
                        (hamt/free m3)
                        (hamt/free m4)
                        (hamt/free merged)
                        (free k1)
                        (free v1)
                        (free v2)
                        (if (and (= c 1) (ptr= r v2)) 1 0)))))))))))))

(println (test-merge-disjoint))
(println (test-merge-overlapping))
