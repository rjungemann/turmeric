;; A float payload through the multi-party router (send-to / recv-from).
;;
;; The router cells carry the same int64 word as a binary channel, so the
;; float bit-reinterpretation applies to tur_router_send / tur_router_recv
;; too (session-payloads-are-int64-only).  Non-zero fractional part on
;; purpose.
;;
;; Expected output: 2.75
(load "stdlib/session.tur")

(defprotocol Measure [A B]
  (-> A B float))

(defn role-a [^linear ch :(Role Measure A)] :nil
  (let [ch (send-to ch B 2.75)]
    (close ch)))

(defn role-b [^linear ch :(Role Measure B)] :nil
  (let [[v ch] (recv-from ch A)]
    (println v)
    (close ch)))

(defn main [] :int
  (let [[ra rb] (make-protocol Measure)]
    (let [t (session-spawn (fn [] (role-b rb)))]
      (role-a ra)
      (session-join t)))
  0)
