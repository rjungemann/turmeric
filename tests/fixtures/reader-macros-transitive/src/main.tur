;; Entry file. The macros referenced here AND in the imported lib/util
;; come from the spice manifest's :reader-macros entry.
(defmodule main
  (import lib/util :refer [doubled-pi sum-of-first-five])
  (defn main [] :int
    (println (sum-of-first-five))   ; 15
    (println (doubled-pi))          ; 6.28318
    (println #sum[10 20 30])        ; 60
    0))
