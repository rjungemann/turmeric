;; SC7: the Alternative [Schema] instance -- alt-or is a two-arm first-match
;; choice (like schema/alt), empty is the never-matching schema.
(load "stdlib/json.tur")
(load "stdlib/schema.tur")

(defn main [] : int
  (let [lit1 (:: (make-struct Schema (schema/literal-int 1)) (Schema int))
        anyi (:: (make-struct Schema (schema/int)) (Schema int))
        choice (alt-or lit1 anyi)]
    ;; 1 matches the literal arm
    (println (schema-decode! (.raw choice) (json/int 1)))
    ;; 5 fails the literal arm, falls through to the int arm
    (println (schema-decode! (.raw choice) (json/int 5))))
  0)
