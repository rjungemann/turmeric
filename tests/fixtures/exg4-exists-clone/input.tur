; Phase EXG4-2: rc/clone accepts a constrained existential and returns
; a counted reference to the same record.  Both the original binding and
; the clone open successfully; each auto-drop fires once at scope exit,
; balancing the pack's strong count back to zero exactly once.
(defclass Show [a]
  (show [x] :cstr))

(definstance Show [int]
  (show [x] :cstr
    ```c
    char *buf = (char *)malloc(24);
    snprintf(buf, 24, "%lld", (long long)x);
    return (const char *)buf;
    ```))

(defn main [] :int
  (let [e1 (pack 7 (exists [a] [(Show a)] a))
        e2 (rc/clone e1)]
    (open e1 [_ v]
      (println (.show v)))
    (open e2 [_ v]
      (println (.show v))))
  0)
