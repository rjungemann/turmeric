;; Phase 15: Derived typeclass instances
;; NOTE: renamed Eq -> MyEqDerived to avoid orphan-instance error against the
;; auto-loaded stdlib Eq typeclass.

(defclass MyEqDerived [a]
  (eq? [x y] :bool))

(definstance MyEqDerived [int]
  (eq? [x y] (= x y)))

(definstance MyEqDerived [bool]
  (eq? [x y] (= x y)))

;; Derived instance for option<T> if Eq T
;; For v1, we just verify the syntax is accepted
;; Actual derived instance mechanism deferred
(defn main [] :int
  0)
