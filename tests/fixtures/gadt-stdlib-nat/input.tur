; Phase G4: Test type-level Nat GADT from stdlib/nat.tur.
; Demonstrates nat-ok?-int, nat-add, and recursive Nat construction.

(defgadt Nat []
  (Zero : (Nat))
  (Succ (Nat) : (Nat)))

(defn nat-ok?-int [n :Nat] :int
  (match n
    (Zero)   0
    (Succ p) (+ 1 (nat-ok?-int p))))

(defn nat-add [a :Nat b :Nat] :Nat
  (match a
    (Zero)   b
    (Succ p) (Succ (nat-add p b))))

(defn main [] :int
  ; Print integer equivalents of 0, 1, 2, 3
  (println (nat-ok?-int (Zero)))
  (println (nat-ok?-int (Succ (Zero))))
  (println (nat-ok?-int (Succ (Succ (Zero)))))
  (println (nat-ok?-int (Succ (Succ (Succ (Zero))))))
  ; Print sum: 1 + 2 = 3
  (println (nat-ok?-int (nat-add (Succ (Zero)) (Succ (Succ (Zero))))))
  0)
