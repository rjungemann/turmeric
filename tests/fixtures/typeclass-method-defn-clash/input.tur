; A user-defined typeclass method and a free top-level defn share a name.
; They now coexist (fix (1)): a bare (render 5) dispatches to the matching
; instance because the receiver's type (int) selects Showy [int] -- so the
; method's "from-method" runs, not the free defn.  The free defn still wins
; for receiver types that have no instance.  The compiler emits TUR-W0039 to
; surface the shared name; the dotted form (.render ...) always dispatches.
;
; See docs/archive/history/typeclass-methods-share-value-namespace-with-defns.md
(defclass Showy [a]
  (render [x] : cstr))

(definstance Showy [int]
  (render [x] "from-method"))

(defn render [x : int] : cstr
  "from-free-defn")

(defn main [] : int
  (println (render 5))
  0)
