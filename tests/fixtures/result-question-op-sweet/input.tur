#lang sweet-exp

;; Phase R1: the ? operator composes with sweet-exp neoteric call syntax.
;; Pins both the neoteric spelling ?(expr) and the traditional (? expr).

(defn u-ok [x : int] : ptr<void>
  ```c
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *r = malloc(sizeof(*r));
  r->tag = 0; r->as.ok_val = x; return r;
  ```)

(defn u-ok-val [r : ptr<void>] : int
  ```c
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *r2 = (void*)r;
  return r2->as.ok_val;
  ```)

(defn produce [] : ptr<void>
  (u-ok 21))

(defn run-neoteric [] : ptr<void>
  (let [x ?(produce())]
    (u-ok (* x 2))))

(defn run-trad [] : ptr<void>
  (let [y (? (produce))]
    (u-ok (+ y 1))))

(defn main [] : int
  (println (u-ok-val (run-neoteric)))
  (println (u-ok-val (run-trad)))
  0)
