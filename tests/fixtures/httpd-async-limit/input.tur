;; A4: httpd-async-limit -- in-flight cap returns 503 when exceeded.
;;
;; The async server is configured with max-in-flight=2. Four clients
;; connect; two grab the available slots and their handlers HOLD the
;; slots until the other two have been rejected with 503 + "server at
;; capacity" (observed via the busy counter). Only then do the held
;; handlers respond 200. Gating on the observed rejections (rather
;; than a fixed handler delay) makes ok=2/busy=2 independent of
;; scheduling: a client thread descheduled for hundreds of ms on a
;; loaded CI box can neither sneak into a freed slot nor connect after
;; the server stopped (the latter used to deadlock the fixture -- see
;; docs/archive/macos-jit-leg-intermittent-45min-hang.md).
;;
;; Expected output:
;;   ok=2
;;   busy=2
;;   handler-ran=2
;;   done

(load "stdlib/httpd.tur")
(load "stdlib/chan.tur")

(defn print-tag [s : cstr v : int] : nil
  ```c printf("%s=%d\n", s, (int)v); ```)

(defn client-worker [arg : ptr<void>] : ptr<void>
  ```c
  #include <time.h>
  struct timespec ts = { 0, 30000000L };
  nanosleep(&ts, NULL);
  int64_t *args = (int64_t *)arg;
  int64_t port = args[0];
  int64_t *ok_counter   = (int64_t *)(intptr_t)args[1];
  int64_t *busy_counter = (int64_t *)(intptr_t)args[2];
  free(arg);
  int fd = socket(AF_INET, SOCK_STREAM, 0);
  if (fd < 0) return NULL;
  /* Backstop: if the server ever fails to answer, fail the counts inside
   * the fixture's own 10s window instead of blocking in recv() forever
   * (a hung client hangs main's pthread_join, and on a host without a
   * timeout(1) binary that used to eat the whole CI job). */
  struct timeval rcv_to = { 8, 0 };
  setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &rcv_to, sizeof(rcv_to));
  struct sockaddr_in addr;
  memset(&addr, 0, sizeof(addr));
  addr.sin_family      = AF_INET;
  addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
  addr.sin_port        = htons((uint16_t)port);
  if (connect(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) { close(fd); return NULL; }
  const char *req = "GET / HTTP/1.0\r\n\r\n";
  send(fd, req, strlen(req), 0);
  char drain[256];
  int total = 0;
  while (total < (int)sizeof(drain) - 1) {
      ssize_t r = recv(fd, drain + total, sizeof(drain) - 1 - (size_t)total, 0);
      if (r <= 0) break;
      total += (int)r;
  }
  drain[total] = '\0';
  if (strncmp(drain, "HTTP/1.0 200", 12) == 0) {
      __sync_fetch_and_add(ok_counter, 1);
  } else if (strncmp(drain, "HTTP/1.0 503", 12) == 0) {
      __sync_fetch_and_add(busy_counter, 1);
  }
  close(fd);
  return NULL;
  ```)

(defn run-server-async [h : ptr<void>] : ptr<void>
  ```c httpd_hyrun_hyasync(h); return NULL; ```)

(defn spawn-server-async [h : ptr<void>] : ptr<void>
  ```c
  pthread_t *t = (pthread_t *)malloc(sizeof(pthread_t));
  pthread_create(t, NULL, (void *(*)(void *))run_hyserver_hyasync, (void *)h);
  return (void *)t;
  ```)

(defn alloc-counter [] : ptr<void>
  ```c return (void *)calloc(1, sizeof(int64_t)); ```)

(defn read-counter [p : ptr<void>] : int
  ```c return p ? *(int64_t *)p : 0; ```)

(defn free-counter [p : ptr<void>] : nil
  ```c free(p); ```)

(defn spawn-client [port : int ok : ptr<void> busy : ptr<void>] : ptr<void>
  ```c
  int64_t *args = (int64_t *)malloc(3 * sizeof(int64_t));
  args[0] = (int64_t)port;
  args[1] = (int64_t)(intptr_t)ok;
  args[2] = (int64_t)(intptr_t)busy;
  pthread_t *t = (pthread_t *)malloc(sizeof(pthread_t));
  pthread_create(t, NULL, (void *(*)(void *))client_hyworker, (void *)args);
  return (void *)t;
  ```)

(defn join-thread [t : ptr<void>] : nil
  ```c pthread_join(*(pthread_t *)t, NULL); free(t); ```)

(defn main [] : int
  (let [donech    (chan-new 4)
        ok        (alloc-counter)
        busy      (alloc-counter)
        handler   (fn [c : ptr<void>] : nil
                    ;; Hold this in-flight slot until both over-cap
                    ;; clients have received their 503 and counted it,
                    ;; then respond. Guarantees exactly two rejections.
                    (while (< (read-counter busy) 2)
                      (httpd-await-timer c 10))
                    (httpd-resp-status! c 200)
                    (httpd-resp-body! c "served")
                    (chan-send donech 1))
        ;; max-in-flight=2 -- only two concurrent slots.
        h         (httpd-new-async-with-limit 0 handler 2)
        port      (httpd-async-port h)
        server    (spawn-server-async h)
        c1        (spawn-client port ok busy)
        c2        (spawn-client port ok busy)
        c3        (spawn-client port ok busy)
        c4        (spawn-client port ok busy)]
    ;; Wait for the two handler runs that the cap permits.
    (let [_ (chan-recv donech)] (let [_ (chan-recv donech)] 0))
    ;; Join the clients BEFORE stopping the server: both 503s are
    ;; already counted (the handlers gate on that) and both 200s are in
    ;; flight on a still-running server, so every client terminates.
    ;; Stopping first would race a slow client's connect into a listen
    ;; backlog that nobody drains.
    (join-thread c1)
    (join-thread c2)
    (join-thread c3)
    (join-thread c4)
    (httpd-stop-async h)
    (join-thread server)
    ;; Now all clients have finished receiving + counting. Print stats.
    (print-tag "ok"          (read-counter ok))
    (print-tag "busy"        (read-counter busy))
    (print-tag "handler-ran" 2)
    (println "done")
    (free-counter ok)
    (free-counter busy)
    (httpd-async-free h)
    (chan-free donech)
    0))
