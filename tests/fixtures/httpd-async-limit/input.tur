;; A4: httpd-async-limit -- in-flight cap returns 503 when exceeded.
;;
;; The async server is configured with max-in-flight=2 and a 100ms slow
;; handler. Four clients connect simultaneously; the first two grab the
;; available slots and succeed; the remaining two should be rejected
;; with 503 + "server at capacity" without the handler running for them.
;;
;; Expected output:
;;   ok=2
;;   busy=2
;;   handler-ran=2
;;   done

(load "stdlib/httpd.tur")
(load "stdlib/chan.tur")

(defn print-tag [s :cstr v :int] :nil
  ```c printf("%s=%d\n", s, (int)v); ```)

(defn client-worker [arg :ptr<void>] :ptr<void>
  ```c
  #include <time.h>
  struct timespec ts = { 0, 30000000L };
  nanosleep(&ts, NULL);
  int64_t *args = (int64_t *)arg;
  int64_t port = args[0];
  int64_t *ok_counter   = (int64_t *)(intptr_t)args[1];
  int64_t *busy_counter = (int64_t *)(intptr_t)args[2];
  free(arg);
  int fd = socket(AF_INET, SOCK_STREAM, 0);
  if (fd < 0) return NULL;
  struct sockaddr_in addr;
  memset(&addr, 0, sizeof(addr));
  addr.sin_family      = AF_INET;
  addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
  addr.sin_port        = htons((uint16_t)port);
  if (connect(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) { close(fd); return NULL; }
  const char *req = "GET / HTTP/1.0\r\n\r\n";
  send(fd, req, strlen(req), 0);
  char drain[256];
  int total = 0;
  while (total < (int)sizeof(drain) - 1) {
      ssize_t r = recv(fd, drain + total, sizeof(drain) - 1 - (size_t)total, 0);
      if (r <= 0) break;
      total += (int)r;
  }
  drain[total] = '\0';
  if (strncmp(drain, "HTTP/1.0 200", 12) == 0) {
      __sync_fetch_and_add(ok_counter, 1);
  } else if (strncmp(drain, "HTTP/1.0 503", 12) == 0) {
      __sync_fetch_and_add(busy_counter, 1);
  }
  close(fd);
  return NULL;
  ```)

(defn run-server-async [h :ptr<void>] :ptr<void>
  ```c httpd_run_async(h); return NULL; ```)

(defn spawn-server-async [h :ptr<void>] :ptr<void>
  ```c
  pthread_t *t = (pthread_t *)malloc(sizeof(pthread_t));
  pthread_create(t, NULL, (void *(*)(void *))run_server_async, (void *)h);
  return (void *)t;
  ```)

(defn alloc-counter [] :ptr<void>
  ```c return (void *)calloc(1, sizeof(int64_t)); ```)

(defn read-counter [p :ptr<void>] :int
  ```c return p ? *(int64_t *)p : 0; ```)

(defn free-counter [p :ptr<void>] :nil
  ```c free(p); ```)

(defn spawn-client [port :int ok :ptr<void> busy :ptr<void>] :ptr<void>
  ```c
  int64_t *args = (int64_t *)malloc(3 * sizeof(int64_t));
  args[0] = (int64_t)port;
  args[1] = (int64_t)(intptr_t)ok;
  args[2] = (int64_t)(intptr_t)busy;
  pthread_t *t = (pthread_t *)malloc(sizeof(pthread_t));
  pthread_create(t, NULL, (void *(*)(void *))client_worker, (void *)args);
  return (void *)t;
  ```)

(defn join-thread [t :ptr<void>] :nil
  ```c pthread_join(*(pthread_t *)t, NULL); free(t); ```)

(defn main [] :int
  (let [donech    (chan-new 4)
        ok        (alloc-counter)
        busy      (alloc-counter)
        handler   (fn [c :ptr<void>] :nil
                    (httpd-await-timer c 100)
                    (httpd-resp-status! c 200)
                    (httpd-resp-body! c "served")
                    (chan-send donech 1))
        ;; max-in-flight=2 -- only two concurrent slots.
        h         (httpd-new-async-with-limit 0 handler 2)
        port      (httpd-async-port h)
        server    (spawn-server-async h)
        c1        (spawn-client port ok busy)
        c2        (spawn-client port ok busy)
        c3        (spawn-client port ok busy)
        c4        (spawn-client port ok busy)]
    ;; Wait for the two handler runs that the cap permits.
    (let [_ (chan-recv donech)] (let [_ (chan-recv donech)] 0))
    (httpd-stop-async h)
    (join-thread server)
    (join-thread c1)
    (join-thread c2)
    (join-thread c3)
    (join-thread c4)
    ;; Now all clients have finished receiving + counting. Print stats.
    (print-tag "ok"          (read-counter ok))
    (print-tag "busy"        (read-counter busy))
    (print-tag "handler-ran" 2)
    (println "done")
    (free-counter ok)
    (free-counter busy)
    (httpd-async-free h)
    (chan-free donech)
    0))
