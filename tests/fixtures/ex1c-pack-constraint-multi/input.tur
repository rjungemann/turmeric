; Phase EX1c: pack with multiple constraints must resolve all instances.
(defclass Show [a]
  (show [x] :cstr))

(defclass MyEq [a]
  (my-eq? [x y] :bool))

(definstance Show [int]
  (show [x] :cstr
    ```c
    char *buf = (char *)malloc(24);
    snprintf(buf, 24, "%lld", (long long)x);
    return (const char *)buf;
    ```))

(definstance MyEq [int]
  (my-eq? [x y] :bool
    ```c
    return x == y;
    ```))

(defn main [] :int
  (let [e (pack 7 (exists [a] [(Show a) (MyEq a)] a))]
    (println "ok"))
  0)
