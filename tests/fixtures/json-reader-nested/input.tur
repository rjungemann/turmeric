;; Nested objects and arrays compose; retrieve through both levels.
(defn nums-len [] : int
  (json/array-len
    (json/get! #json({"nums": [1, 2, 3], "meta": {"ok": true}}) "nums")))
(defn meta-ok [] : bool
  (json/get-bool
    (json/get!
      (json/get! #json({"nums": [1, 2, 3], "meta": {"ok": true}}) "meta")
      "ok")))
(println (nums-len))
(println (if (meta-ok) 1 0))
