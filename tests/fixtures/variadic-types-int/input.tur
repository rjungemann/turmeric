;; variadic-types-int -- primitive :int rest still type-checks (regression).
;;
;; Checks the fast-path TypeKind comparison is unchanged: an :int rest accepts
;; :int args and the cons-list is walked correctly.

(defn cons-list-len [lst :int] #fx{Unsafe} :int
  ```c
  typedef struct { int64_t head; int64_t tail; } __tur_cons_cell;
  int64_t n = 0;
  __tur_cons_cell *p = (__tur_cons_cell *)(intptr_t)lst;
  while (p) { n++; p = (__tur_cons_cell *)(intptr_t)p->tail; }
  return (int)n;
  ```)

(defn sum-rest [& xs :int] #fx{Unsafe} :int
  (cons-list-len xs))

(defn main [] :int
  (unsafe
    (let [n (sum-rest 10 20 30 40)]
      (if (= n 4) 0 1))))
