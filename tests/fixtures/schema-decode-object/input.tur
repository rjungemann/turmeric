;; SC1: decode a JSON object against a two-field object schema.
;; A valid object decodes ok; a type-mismatched field and a missing field
;; each surface as an accumulated SchemaError.

(load "stdlib/json.tur")
(load "stdlib/schema.tur")

(defn user-schema [] : int
  (schema/field
    (schema/field (schema/object-new) "name" (schema/str))
    "age" (schema/int)))

;; valid -> ok
(defn test-valid [] : int
  (let [r (schema-decode (user-schema)
                         (json/decode "{\"name\": \"alice\", \"age\": 30}"))]
    (if (schema-decode-ok? r) 1 0)))

;; wrong type for age -> err with one error on path "age"
(defn test-type-mismatch [] : cstr
  (let [r (schema-decode (user-schema)
                         (json/decode "{\"name\": \"alice\", \"age\": \"x\"}"))]
    (schema-error-message (schema-decode-errors r))))

;; missing field -> err
(defn test-missing [] : cstr
  (let [r (schema-decode (user-schema)
                         (json/decode "{\"name\": \"alice\"}"))]
    (schema-error-message (schema-decode-errors r))))

(println (test-valid))
(println (test-type-mismatch))
(println (test-missing))
