;; Phase T20-D: thread-pool-dynamic — dynamic-scaling thread pool.
;;
;; Creates a pool starting with min=1 workers, scaling up to max=4 when
;; all workers are busy.  Submits 8 tasks and verifies that all produce
;; correct results.
;;
;; Each task returns its index; expected sum = 0+1+2+3+4+5+6+7 = 28.
;; Expected output:
;;   sum: 28
;;
;; requires.tsan

(defn main [] :int
  ```c
  /* identity task: returns arg unchanged */
  void *dyn_identity_fn(void *arg) { return arg; }

  /* Create dynamic pool with min=1, max=4 workers */
  void *tp = thread_pool_new_dynamic(1, 4);

  /* submit 8 tasks */
  int64_t sum = 0;
  for (int i = 0; i < 8; i++) {
      void *fc = thread_pool_dynamic_submit(tp, dyn_identity_fn, (void *)(uintptr_t)(int64_t)i);
      
      /* Wait for future to be ready and collect result */
      typedef struct {
          pthread_mutex_t lock;
          pthread_cond_t ready;
          int64_t value;
          int64_t exn;
          bool is_set;
          bool is_ok;
      } FutureCell;
      FutureCell *future = (FutureCell *)fc;
      pthread_mutex_lock(&future->lock);
      while (!future->is_set)
          pthread_cond_wait(&future->ready, &future->lock);
      sum += future->value;
      pthread_mutex_unlock(&future->lock);
      
      /* Clean up future */
      pthread_mutex_destroy(&future->lock);
      pthread_cond_destroy(&future->ready);
      free(future);
  }

  printf("sum: %lld\n", (long long)sum);

  /* shutdown and free */
  thread_pool_dynamic_shutdown(tp);
  thread_pool_dynamic_free(tp);
  
  return 0;
  ```)
