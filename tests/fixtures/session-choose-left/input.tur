;; SS0b + SS1 + SS2: session-choose-left -- select the Left branch of a Choose session.
;;
;; Creates a [Session[Choose Close Close], Session[Branch Close Close]] pair.
;; The main thread picks Left with choose-left; a receiver thread uses offer
;; and handles the Left branch by printing "left".
;;
;; Expected output: left
(defn spawn [f : ptr<void>] : ptr<void>
  ```c
  pthread_t *tid = (pthread_t *)malloc(sizeof(pthread_t));
  pthread_create(tid, NULL, tur_session_thread_wrapper, f);
  return (void *)tid;
  ```)

(defn join [t : ptr<void>] : int
  ```c
  pthread_join(*(pthread_t *)t, NULL);
  free(t);
  return 0;
  ```)

(defn main [] : int
  (let [[s r] (make-session (Choose Close Close))]
    (let [t (spawn (fn []
                     (match (offer r)
                       (Left r) (do (close r) (println "left"))
                       (Right r) (close r))))]
      (let [s (choose-left s)]
        (close s)
        (join t))))
  0)
