; LZ1 fixture: seq/cycle -- cycle over a finite Seq indefinitely.

(load "stdlib/seq/builders.tur")

(defn main [] :void
  (let [g (seq-ierr? (seq/cycle (seq/range 0 3)))
        ^mut count 0]
    (while (< count 7)
      (let [v (seq-gen-next g)]
        (when (seq-val-some? v)
          (do
            (println (seq-val-unwrap v))
            (set! count (+ count 1)))))))
  (println (gen-arr-len (seq-collect (seq/cycle (empty-seq))))))
