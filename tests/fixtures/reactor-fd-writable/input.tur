;; Phase R3: reactor-fd-writable -- pipe write-end is immediately WRITE-ready.
;;
;; Registers the write end of a fresh pipe for WRITE events and polls once.
;; A pipe's write end is always writable (unless the internal buffer is full),
;; so the callback should fire in the first poll round.
;;
;; Expected output:
;;   writable
;;   poll-count=1

(defn reactor-link [] :int
  ```c /* __tur_autolink__: -lturi */
  return 0;
  ```)

(extern-c tur_reactor_new [] :ptr)
(extern-c tur_reactor_add_fd [r :ptr fd :int events :int cb :int ud :int] :int)
(extern-c tur_reactor_poll [r :ptr timeout-ms :int] :int)
(extern-c tur_reactor_free [r :ptr] :void)

(defn make-pipe [] :ptr<void>
  ```c
  int *fds = (int *)malloc(2 * sizeof(int));
  if (pipe(fds) < 0) { free(fds); return NULL; }
  return (void *)fds;
  ```)

(defn pipe-write-fd [p :ptr<void>] :int
  ```c return (int64_t)((int *)p)[1]; ```)

(defn pipe-close [p :ptr<void>] :nil
  ```c close(((int *)p)[0]); close(((int *)p)[1]); free(p); ```)

(defn print-poll-count [n :int] :nil
  ```c printf("poll-count=%lld\n", (long long)n); ```)

;; No-op: used to force fat-closure allocation when sentinel is captured.
(defn use-val [v :int] :nil
  ```c (void)((int64_t)v); ```)

(defn main [] :int
  (let [sentinel 1
        p (make-pipe)
        r (tur_reactor_new)]
    (tur_reactor_add_fd r (pipe-write-fd p) 2   ;; WRITE = 2
      (fn [id events ud] :nil
        (use-val sentinel)   ;; captures sentinel -> real fat closure
        (println "writable"))
      0)
    (let [n (tur_reactor_poll r 200)]
      (print-poll-count n)
      (tur_reactor_free r)
      (pipe-close p)
      0)))
