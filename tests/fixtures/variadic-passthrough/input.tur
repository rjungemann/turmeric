;; AR10: variadic-passthrough -- forward rest-list to another variadic.
;;
;; Checks:
;;   (1) A variadic wrapper can receive a rest-list and pass individual
;;       values to another variadic by holding the cons-list as an int
;;       and re-passing elements.
;;   (2) Demonstrates cons-list manipulation in inline-C (Unsafe context).

;; Walk a __tur_cons_cell list and compute its length.
(defn cons-list-len [lst : int] #{Unsafe} : int
  ```c
  typedef struct { int64_t head; int64_t tail; } __tur_cons_cell;
  int64_t n = 0;
  __tur_cons_cell *p = (__tur_cons_cell *)(intptr_t)lst;
  while (p) { n++; p = (__tur_cons_cell *)(intptr_t)p->tail; }
  return n;
  ```)

;; Walk a __tur_cons_cell list and sum all heads.
(defn cons-list-sum [lst : int] #{Unsafe} : int
  ```c
  typedef struct { int64_t head; int64_t tail; } __tur_cons_cell;
  int64_t acc = 0;
  __tur_cons_cell *p = (__tur_cons_cell *)(intptr_t)lst;
  while (p) { acc += p->head; p = (__tur_cons_cell *)(intptr_t)p->tail; }
  return acc;
  ```)

;; Base variadic summer -- sums the rest list.
(defn base-sum [& rest : int] #{Unsafe} : int
  (cons-list-sum rest))

;; Passthrough: receives a rest-list by-pointer and reports its length + sum.
;; Returns (len * 100 + sum) so a single int encodes both values.
(defn report-list [lst : int] #{Unsafe} : int
  (+ (* (cons-list-len lst) 100)
     (cons-list-sum lst)))

;; Variadic wrapper that forwards the rest-list for inspection.
(defn variadic-report [tag : int & rest : int] #{Unsafe} : int
  (+ (* tag 10000)
     (report-list rest)))

(defn main [] : int
  (unsafe
    (let [;; (variadic-report 1) => tag=1, rest=nil => 1*10000 + 0 = 10000
          r0 (variadic-report 1)
          ;; (variadic-report 2 10 20 30) => tag=2, rest=[10,20,30]
          ;; len=3, sum=60 => 3*100+60=360 => 2*10000+360=20360
          r3 (variadic-report 2 10 20 30)
          ;; (base-sum 1 2 3 4 5) => 15
          s5 (base-sum 1 2 3 4 5)]
      (if (= r0 10000)
        (if (= r3 20360)
          (if (= s5 15)
            0
            1)
          2)
        3))))
