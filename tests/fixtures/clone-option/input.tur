;; Phase B1: Clone trait for an option-like struct type
;;
;; Uses a user-defined Option struct (mirroring the built-in option layout)
;; to demonstrate that Clone performs an independent deep copy of the value.

(defstruct Option [value :int])

(defclass Clone [a]
  (clone [x] :int))

(definstance Clone [int]
  (clone [x] x))

;; Clone [Option]: deep-copy the struct value into a heap allocation.
;; x has type Option (struct value) inside the generated C function;
;; field access uses x.value.
(definstance Clone [Option]
  (clone [x] :int
    ```c
    struct { int64_t value; } *dst = malloc(sizeof(Option));
    dst->value = x.value;
    return (int64_t)(intptr_t)dst;
    ```))

;; Accessor for a heap-allocated Option pointer (returned by Clone.clone).
(defn heap-option-value [p] :int
  ```c
  struct { int64_t value; } *opt = (void *)(intptr_t)p;
  return opt ? opt->value : -1;
  ```)

(defn main [] :int
  ;; Clone an Option(55) and verify the cloned cell has the same value.
  (let [opt (make-struct Option 55)]
    (let [opt2 (.clone opt)]
      (println (heap-option-value opt2))))
  0)