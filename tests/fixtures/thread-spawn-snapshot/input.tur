;; Phase T19-F codegen snapshot: thread-spawn-snapshot
;;
;; Minimal thread-spawn + join.  The golden expected.c documents the
;; pthread_create trampoline pattern emitted by the compiler.
;; No runtime execution (no expected.stdout); only expected.c is checked.

(defn worker [arg : ptr<void>] : ptr<void>
  ```c
  return NULL;
  ```)

(defn thread-spawn-fn [fn-ptr : ptr<void> arg : ptr<void>] : ptr<void>
  ```c
  pthread_t *t = (pthread_t *)malloc(sizeof(pthread_t));
  if (!t) { fprintf(stderr, "thread-spawn-fn: oom\n"); abort(); }
  pthread_create(t, NULL, (void *(*)(void *))fn_ptr, arg);
  return (void *)t;
  ```)

(defn thread-join [t : ptr<void>] : nil
  ```c
  pthread_join(*(pthread_t *)t, NULL);
  free(t);
  ```)

(defn make-arg [] : ptr<void>
  ```c
  int64_t *p = (int64_t *)malloc(sizeof(int64_t));
  if (!p) abort();
  *p = 0;
  return (void *)p;
  ```)

(defn free-arg [p : ptr<void>] : nil
  ```c
  free(p);
  ```)

(defn main [] : int
  (let [arg (make-arg)]
    (let [t (thread-spawn-fn worker arg)]
      (thread-join t))
    (free-arg arg))
  0)
