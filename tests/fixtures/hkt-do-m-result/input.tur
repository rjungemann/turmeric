;; Phase HKT-P8: do-m with result monad
;; Tests that do-m works with result<T, E> and short-circuits on err

(defclass TestMonad [^m]
  (bind [ma fn] : int))

(defn __res_ok [x] : int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *r = malloc(sizeof(*r));
  r->is_ok = true; r->ok_val = x; r->err_val = 0;
  return (int64_t)(intptr_t)r;
  ```)

(defn __res_err [e] : int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *r = malloc(sizeof(*r));
  r->is_ok = false; r->ok_val = 0; r->err_val = e;
  return (int64_t)(intptr_t)r;
  ```)

(defn __res_ok? [r] : bool
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *p =
      (void *)(intptr_t)r;
  return p != NULL && p->is_ok;
  ```)

(defn __res_unwrap [r] : int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *p =
      (void *)(intptr_t)r;
  return p->ok_val;
  ```)

(defn __res_err_val [r] : int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *p =
      (void *)(intptr_t)r;
  return p->err_val;
  ```)

(defn __res_free [r] : nil
  ```c
  free((void *)(intptr_t)r);
  ```)

(defn __bind_result [ma fn] : int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res =
      (void *)(intptr_t)ma;
  if (!res || !res->is_ok) return ma;
  /* fn is a closure env struct; first field is the function pointer */
  return TUR_APPLY1(fn, res->ok_val);
  ```)

(definstance TestMonad [result]
  (bind [ma fn] (__bind_result ma fn)))

;; Helper: add two results, propagating err
(defn add-results [a b] : int
  (do-m
   x a
   y b
   (__res_ok (+ x y))))

(defn main [] : int
  (let [r1 (add-results (__res_ok 10) (__res_ok 20))]
    (let [r2 (add-results (__res_err 999) (__res_ok 20))]
      (let [r3 (add-results (__res_ok 10) (__res_err 42))]
        (println (__res_ok? r1))      ;; true
        (println (__res_unwrap r1))   ;; 30
        (println (__res_ok? r2))      ;; false
        (println (__res_err_val r2))  ;; 999
        (println (__res_ok? r3))      ;; false
        (__res_free r1)
        (__res_free r2)
        (__res_free r3)
        0))))
