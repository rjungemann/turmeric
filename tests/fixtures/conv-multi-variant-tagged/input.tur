;; CONV-S2 (struct/ADT convergence): a multi-variant ADT keeps its tagged-union
;; representation -- `int tag` in the typedef, a `__r->tag = N` store in each
;; constructor, and a `switch (__scrut->tag)` in `match`.  Only the
;; single-variant case (conv-single-variant-flat) drops the tag.  The
;; expected.c snapshot guards that the tag layout for multi-variant ADTs is
;; unchanged by the single-variant flattening.

(defdata Shape
  (Circle [radius : int])
  (Rect   [w : int h : int]))

(defn area [s] : int
  (match s
    (Circle r)  (* 3 (* r r))
    (Rect w h)  (* w h)))

(defn main [] : int
  (let [c (Circle :radius 2)
        r (Rect :w 3 :h 4)]
    (println (area c))           ; 12
    (println (area r))           ; 12
    0))
