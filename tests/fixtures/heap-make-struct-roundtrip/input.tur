;; end-to-end-monomorphization (M3->M7 Vec typed-pointer vertical slice, step 2):
;; a :heap-tagged parameterized struct's `make-struct` heap-allocates the header
;; and returns a TYPED POINTER (Box__int * / Box__bool *), and field access
;; dereferences through it -- no int64 carrier, no by-value header copy.  Two
;; distinct element types prove per-element monomorphization (the header layout
;; is identical; only the C type label on the pointer differs).  This is the
;; proxy for vec-new/.len/.data before the real stdlib Vec flip.
(defstruct Box :heap [A] (val :A) (tag :int))

(defn main [] : int
  (let [bi (:: (make-struct Box :val 42 :tag 7) (Box int))
        bb (:: (make-struct Box :val true :tag 9) (Box bool))]
    (println (.val bi))            ; 42
    (println (:: (.val bb) bool))  ; true
    (println (.tag bb))            ; 9
    (println (.val bi)))           ; 42 (heap field read in tail position)
  0)
