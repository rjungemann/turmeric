; LZ1 fixture: seq/unfold -- build a Seq from a seed via a step function.
; The step function returns Some(pair(value, next-seed)) or None.

(load "stdlib/seq/builders.tur")

;;; make-some-pair -- allocate Some(pair(val, next-seed)) for seq/unfold
(defn make-some-pair [val :int nxt :int] :int
  ```c
  struct { int64_t first; int64_t second; } *p = malloc(sizeof(*p));
  p->first = val; p->second = nxt;
  struct { bool is_some; int64_t value; } *opt = malloc(sizeof(*opt));
  opt->is_some = true;
  opt->value = (int64_t)(intptr_t)p;
  return (int64_t)(intptr_t)opt;
  ```)

;;; make-none -- allocate None for seq/unfold
(defn make-none [] :int
  ```c
  struct { bool is_some; int64_t value; } *opt = malloc(sizeof(*opt));
  opt->is_some = false;
  opt->value = 0;
  return (int64_t)(intptr_t)opt;
  ```)

(defn main [] :void
  (let [limit 5
        f (fn [n] (if (< n limit) (make-some-pair n (+ n 1)) (make-none)))]
    (seq-for-each println (seq/unfold 0 f))))
