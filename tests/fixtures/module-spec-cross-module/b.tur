;;; module-spec-cross-module/b.tur -- calls double-it at :float (concrete type).
;;; J6: b borrows the clone body from a.

(defmodule b
  (import a :refer [double-it])
  (export run main)
  (defn run [] : int
    (let [f (double-it 3.0)
          i (double-it 5)]
      (println f)
      (println i)
      0))
  (defn main [] : int
    (run)))
