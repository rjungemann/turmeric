(load "stdlib/free.tur")

;; RF3: Free monad as a small DSL interpreter.
;;
;; DSL: a toy calculator effect
;;   (CalcAdd a b) -- add two numbers
;;   (CalcMul a b) -- multiply two numbers
;;
;; We encode operations as Free DSL values and interpret them.

(defdata CalcOp
  (CalcAdd :int :int)
  (CalcMul :int :int))

;; Smart constructors: lift each operation into Free
(defn calc-add [a : int b : int] : int
  (free-lift (CalcAdd a b)))

(defn calc-mul [a : int b : int] : int
  (free-lift (CalcMul b a)))

;; Interpreter: evaluate one CalcOp
(defn run-calc-op [op : int] : int
  (match op
    (CalcAdd a b) (+ a b)
    (CalcMul a b) (* a b)))

(defn main [] : int
  ;; Build a program: add(3,4) => 7, mul(7,2) => 14
  ;; The interpreter lambdas don't capture, so ^fat auto-shims them.
  (unsafe
    (let [step1 (calc-add 3 4)
          step2 (calc-mul 2 (free-run (fn [op] (run-calc-op op)) step1))]
      (let [result (free-run (fn [op] (run-calc-op op)) step2)]
        (println result)
        0))))
