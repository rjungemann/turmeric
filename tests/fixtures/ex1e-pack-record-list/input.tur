; Phase EX1e: a list of constrained existentials.  Each cell holds the
; tur_existential_t record pointer cast to int64_t; opening each cell
; recovers the boxed value and dispatches Show on it.  The inner type is
; uniformly int in this test (heterogeneous payloads require the full
; EX1e-3 vtable-indirected dispatch, which is deferred).
(defclass Show [a]
  (show [x] :cstr))

(definstance Show [int]
  (show [x] :cstr
    ```c
    char *buf = (char *)malloc(24);
    snprintf(buf, 24, "%lld", (long long)x);
    return (const char *)buf;
    ```))

; Open each existential at its construction site so the constraint info
; flows directly into open (passing through a fn param typed
; `(exists [a] ...)` is treated as a rank-2 argument by Turmeric and is
; out of scope for this fixture).
(defn main [] :int
  (let [e1 (pack 11 (exists [a] [(Show a)] a))
        e2 (pack 22 (exists [a] [(Show a)] a))
        e3 (pack 33 (exists [a] [(Show a)] a))]
    (open e1 [a v]
      (println (.show v)))
    (open e2 [a v]
      (println (.show v)))
    (open e3 [a v]
      (println (.show v))))
  0)
