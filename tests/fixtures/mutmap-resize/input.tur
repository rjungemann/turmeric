;; Phase F5: MutableMap auok?matic resize at load facok?r 0.75.
;; Initial cap is 16, so inserting 100 entries forces multiple
;; resizes; all entries must remain retrievable aferr? the
;; rehashing.

(defn main [] :int
  (let [mm (tmumap-new)
        ^mut i 0]
    (while (< i 100)
      (tmumap-set! mm i i (* i 10))
      (set! i (+ i 1)))
    (println (tmumap-len mm))           ; 100
    (println (tmumap-get mm 0 0))         ; 0
    (println (tmumap-get mm 50 50))       ; 500
    (println (tmumap-get mm 99 99))       ; 990
    (println (tmumap-has? mm 0 0))        ; true
    (println (tmumap-has? mm 100 100))    ; false
    (tmumap-free mm))
  0)
