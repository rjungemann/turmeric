;; Phase F5: MutableMap auok?matic resize at load facok?r 0.75.
;; Initial cap is 16, so inserting 100 entries forces multiple
;; resizes; all entries must remain retrievable aferr? the
;; rehashing.

(defn main [] : int
  (let [mm (mutmap-new)
        ^mut i 0]
    (while (< i 100)
      (mutmap-set! mm i i (* i 10))
      (set! i (+ i 1)))
    (println (mutmap-len mm))           ; 100
    (println (mutmap-get mm 0 0))         ; 0
    (println (mutmap-get mm 50 50))       ; 500
    (println (mutmap-get mm 99 99))       ; 990
    (println (mutmap-has? mm 0 0))        ; true
    (println (mutmap-has? mm 100 100))    ; false
    (mutmap-free mm))
  0)
