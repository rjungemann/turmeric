;; niche-elem-comparator-conventions -- what each *-eq? helper hands its
;; comparator, and that both parameter spellings agree with it.
;;
;; A niche (Option P) is carried as its payload pointer.  The `*-eq?` family
;; splits on whether a helper walks its own payload slots or iterates a HAMT:
;;
;;   Vec     vec-eq?      a->data[i]                -- the stored WORD
;;   Cons    list-eq?     (list-head l)             -- word
;;   Option  option-eq?   the (Some v) match binder -- word
;;   Result  result-eq?   the sum's payload slot    -- word
;;   Pair    pair-eq?     a->fst / a->snd           -- word
;;   Map     map-eq?      the HAMT value            -- box
;;   Set     set-eq-cmp?  the HAMT key              -- box
;;
;; A comparator fed a WORD must reinterpret it; unboxing it as a carrier box
;; reads the payload's own first words as a tag and a value.  The synthesized
;; comparator says which it is by naming its params `__cmp_slot_*`, and that
;; decision used to be `strcmp(sd->name, "Vec") == 0` -- so plain `(eq? a b)`
;; was silently wrong for every OTHER word-passing container once the niche
;; graduated.  `(eq? (some (some "aa")) (some (some "bb")))` answered TRUE.
;;
;; Every assertion below is a PAIR: equal payloads in distinct allocations,
;; then different payloads.  The second is the one that catches this -- the
;; broken path answered "eq" for both, so an equal-only probe passes while the
;; comparison is doing nothing at all.
;;
;; Map and Set take the OPPOSITE convention and so are the other half of this
;; fixture: their erased comparator is the one that is right (the ascription
;; unboxes a box that really is there) and their TYPED one was wrong, emitted
;; as the niche pointer while receiving a box address -- so a value compared
;; unequal to ITSELF.  A niche-typed parameter whose caller hands over a box
;; now arrives as the carrier and is unboxed at body entry.
(load "stdlib/string.tur")
(load "stdlib/pair.tur")
(load "stdlib/map.tur")
(load "stdlib/set.tur")

(defn main [] : int
  (let [aa1 (:: (some (string/from-cstr "aa")) (Option String))
        aa2 (:: (some (string/from-cstr "aa")) (Option String))
        bb  (:: (some (string/from-cstr "bb")) (Option String))]

    ;; 1. the SYNTHESIZED comparator: plain (eq? a b) over a nested niche
    (let [v (:: (vec-new) (Vec (Option String)))
          w (:: (vec-new) (Vec (Option String)))
          u (:: (vec-new) (Vec (Option String)))]
      (vec-push! v aa1) (vec-push! w aa2) (vec-push! u bb)
      (println (if (eq? v w) "vec-eq" "vec-ne"))
      (println (if (eq? v u) "vec-eq" "vec-ne")))
    (let [o1 (:: (some aa1) (Option (Option String)))
          o2 (:: (some aa2) (Option (Option String)))
          o3 (:: (some bb)  (Option (Option String)))]
      (println (if (eq? o1 o2) "opt-eq" "opt-ne"))
      (println (if (eq? o1 o3) "opt-eq" "opt-ne")))
    (let [r1 (:: (ok aa1) (Result (Option String) cstr))
          r2 (:: (ok aa2) (Result (Option String) cstr))
          r3 (:: (ok bb)  (Result (Option String) cstr))]
      (println (if (eq? r1 r2) "res-eq" "res-ne"))
      (println (if (eq? r1 r3) "res-eq" "res-ne")))

    ;; 2. a comparator the USER writes inline, with ERASED params that ascribe
    ;;    the word back to the element -- the shape that has no convention of
    ;;    its own and takes the mark from the call it appears in.
    (let [l1 (cons aa1 0)
          l2 (cons aa2 0)
          l3 (cons bb 0)]
      (println (if (list-eq? l1 l2 (fn [p q] : bool (eq? (:: p (Option String)) (:: q (Option String))))) "list-eq" "list-ne"))
      (println (if (list-eq? l1 l3 (fn [p q] : bool (eq? (:: p (Option String)) (:: q (Option String))))) "list-eq" "list-ne")))
    (let [q1 (:: (ok aa1) (Result (Option String) cstr))
          q2 (:: (ok aa2) (Result (Option String) cstr))
          q3 (:: (ok bb)  (Result (Option String) cstr))]
      (println (if (result-eq? q1 q2 (fn [p q] : bool (eq? (:: p (Option String)) (:: q (Option String)))) (fn [p q] : bool true)) "rc-eq" "rc-ne"))
      (println (if (result-eq? q1 q3 (fn [p q] : bool (eq? (:: p (Option String)) (:: q (Option String)))) (fn [p q] : bool true)) "rc-eq" "rc-ne")))

    ;; 3. TYPED params through the same helpers must agree with the erased ones
    (let [l1 (cons aa1 0)
          l2 (cons aa2 0)
          l3 (cons bb 0)]
      (println (if (list-eq? l1 l2 (fn [p : (Option String) q : (Option String)] : bool (eq? p q))) "lt-eq" "lt-ne"))
      (println (if (list-eq? l1 l3 (fn [p : (Option String) q : (Option String)] : bool (eq? p q))) "lt-eq" "lt-ne")))

    ;; 4. the BOX-passing half: Map and Set, both spellings.  The third pair in
    ;;    each group puts the SAME String pointer on both sides -- no convention
    ;;    can make a value unequal to itself, which is what made the typed
    ;;    verdict a defect rather than a judgement about intended semantics.
    (let [m1 (:: (map-assoc (map-new) 1 aa1) (Map int (Option String)))
          m2 (:: (map-assoc (map-new) 1 aa2) (Map int (Option String)))
          m3 (:: (map-assoc (map-new) 1 bb)  (Map int (Option String)))
          ms (:: (map-assoc (map-new) 1 aa1) (Map int (Option String)))]
      (println (if (map-eq? m1 m2 (fn [p q] : bool (eq? (:: p (Option String)) (:: q (Option String))))) "mu-eq" "mu-ne"))
      (println (if (map-eq? m1 m3 (fn [p q] : bool (eq? (:: p (Option String)) (:: q (Option String))))) "mu-eq" "mu-ne"))
      (println (if (map-eq? m1 m2 (fn [p : (Option String) q : (Option String)] : bool (eq? p q))) "mt-eq" "mt-ne"))
      (println (if (map-eq? m1 m3 (fn [p : (Option String) q : (Option String)] : bool (eq? p q))) "mt-eq" "mt-ne"))
      (println (if (map-eq? m1 ms (fn [p : (Option String) q : (Option String)] : bool (eq? p q))) "mt-eq" "mt-ne")))
    (let [s1 (:: (set-add-eq-o (set-new) 1 aa1 0 0) (Set (Option String)))
          s2 (:: (set-add-eq-o (set-new) 1 aa2 0 0) (Set (Option String)))
          s3 (:: (set-add-eq-o (set-new) 1 bb 0 0)  (Set (Option String)))
          ss (:: (set-add-eq-o (set-new) 1 aa1 0 0) (Set (Option String)))]
      (println (if (set-eq-cmp? s1 s2 (fn [p q] : bool (eq? (:: p (Option String)) (:: q (Option String))))) "su-eq" "su-ne"))
      (println (if (set-eq-cmp? s1 s3 (fn [p q] : bool (eq? (:: p (Option String)) (:: q (Option String))))) "su-eq" "su-ne"))
      (println (if (set-eq-cmp? s1 s2 (fn [p : (Option String) q : (Option String)] : bool (eq? p q))) "st-eq" "st-ne"))
      (println (if (set-eq-cmp? s1 s3 (fn [p : (Option String) q : (Option String)] : bool (eq? p q))) "st-eq" "st-ne"))
      (println (if (set-eq-cmp? s1 ss (fn [p : (Option String) q : (Option String)] : bool (eq? p q))) "st-eq" "st-ne")))

    ;; 5. `pair-eq?` is a MACRO -- it splices the comparator into call position
    ;;    against a `.fst` field read, so there is no named callee whose
    ;;    parameter contract could carry either mark.  A direct application does
    ;;    not need one: the ARGUMENT is at the call, and a concrete niche-typed
    ;;    argument IS the payload word.  The third line varies only the int
    ;;    component, so it also pins that the SECOND comparator still sees an
    ;;    ordinary int -- the marking is per parameter, not per lambda.
    (let [pa (:: (pair aa1 1) (Pair (Option String) int))
          pb (:: (pair aa2 1) (Pair (Option String) int))
          pc (:: (pair bb 1)  (Pair (Option String) int))
          pd (:: (pair aa2 2) (Pair (Option String) int))]
      (println (if (pair-eq? pa pb (fn [a b] : bool (eq? (:: a (Option String)) (:: b (Option String)))) (fn [a b] : bool (= a b))) "pu-eq" "pu-ne"))
      (println (if (pair-eq? pa pc (fn [a b] : bool (eq? (:: a (Option String)) (:: b (Option String)))) (fn [a b] : bool (= a b))) "pu-eq" "pu-ne"))
      (println (if (pair-eq? pa pd (fn [a b] : bool (eq? (:: a (Option String)) (:: b (Option String)))) (fn [a b] : bool (= a b))) "pu-eq" "pu-ne"))
      (println (if (pair-eq? pa pb (fn [a : (Option String) b : (Option String)] : bool (eq? a b)) (fn [a b] : bool (= a b))) "pt-eq" "pt-ne"))
      (println (if (pair-eq? pa pc (fn [a : (Option String) b : (Option String)] : bool (eq? a b)) (fn [a b] : bool (= a b))) "pt-eq" "pt-ne")))

    ;; 6. a NON-niche element through the same helpers: the mark must be inert
    (let [a (cons 1 (cons 2 0))
          b (cons 1 (cons 2 0))
          c (cons 1 (cons 3 0))]
      (println (if (list-eq? a b (fn [p q] : bool (= p q))) "int-eq" "int-ne"))
      (println (if (list-eq? a c (fn [p q] : bool (= p q))) "int-eq" "int-ne")))
    0))
