; P4 of docs/archive/history/ecs-e2c-sized-dense-needs-bounded-world.md:
; stdlib/sized-handle-existential.tur provides generic pack-sized /
; open-sized macros that wrap native pack/open for any phantom-indexed
; sized handle.  Exercising the pattern on (SizedVec n int): a fresh
; SizedVec is lifted into (exists [n] (SizedVec n int)), opened under
; a fresh abstract n, and its length printed.
;
; SizedVec is the validated path today; the same macros on a phantom
; defopaque like (SizedBuf n) currently trip an open-projection gap
; tracked in
; docs/archive/history/pack-open-phantom-opaque-body-type-collapses.md.

(load "stdlib/sized.tur")
(load "stdlib/sized-handle-existential.tur")

(defn main [] : int
  (let [packed (pack-sized (SVCons 1 (SVCons 2 (SVCons 3 (SVNil))))
                           [n] (SizedVec n int))]
    (open-sized packed n sv
      (println (sized-vec-len sv))))
  0)
