;; Phase CCL: capturing closures passed directly to typeclass methods.
;; Exercises the (fn, env) pairs in dict structs feature: fat closures
;; whose environment pointer is packed into tur_poly_fn_t at call sites.

(defclass TestFunctor [^f]
  (fmap [container [fn :fn]] : int))

(defclass TestMonad [^m]
  (bind [ma [fn :fn]] : int))

;; Option helpers
(defn __opt_some [x] : int
  ```c
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn __opt_none [] : int
  ```c
  return 0;
  ```)

(defn __opt_some? [o] : bool
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return p != 0 && p->is_some;
  ```)

(defn __opt_unwrap [o] : int
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return (int)(p->value);
  ```)

;; Functor [option] -- fn is tur_poly_fn_t; call via fn.fn(fn.env, arg).
(definstance TestFunctor [option]
  (fmap [container fn]
    ```c
    struct { bool is_some; int64_t value; } *c =
        (void *)(intptr_t)container;
    if (!c || !c->is_some) return 0;
    struct { bool is_some; int64_t value; } *r =
        malloc(sizeof(struct { bool is_some; int64_t value; }));
    r->is_some = true;
    r->value = fn.fn(fn.env, c->value);
    return (int64_t)(intptr_t)r;
    ```))

;; TestMonad [option] -- fn is tur_poly_fn_t; call via fn.fn(fn.env, arg).
(definstance TestMonad [option]
  (bind [ma fn]
    ```c
    struct { bool is_some; int64_t value; } *opt =
        (void *)(intptr_t)ma;
    if (!opt || !opt->is_some) return 0;
    return fn.fn(fn.env, opt->value);
    ```))

;; Test 5 helper: named function (non-closure path)
(defn __double [x] : int (* x 2))

(defn main [] : int
  (do
    ;; Test 1: single captured variable through .fmap
    ;; (some 10) fmap (fn [x] (+ x delta)) where delta = 5 => (some 15)
    (let [delta 5]
      (let [opt (__opt_some 10)]
        (let [result (.fmap opt (fn [x] (+ x delta)))]
          (do
            (println (__opt_some? result))   ;; true
            (println (__opt_unwrap result)))))) ;; 15

    ;; Test 2: multi-capture closure through .fmap
    ;; (some 10) fmap (fn [x] (+ (* x a) b)) where a=2, b=3 => (some 23)
    (let [a 2]
      (let [b 3]
        (let [opt (__opt_some 10)]
          (let [result (.fmap opt (fn [x] (+ (* x a) b)))]
            (do
              (println (__opt_some? result))   ;; true
              (println (__opt_unwrap result))))))) ;; 23

    ;; Test 3: capturing closure through .bind
    ;; (some 4) bind (fn [x] (some (* x scale))) where scale=3 => (some 12)
    (let [scale 3]
      (let [r (.bind (__opt_some 4) (fn [x] (__opt_some (* x scale))))]
        (do
          (println (__opt_some? r))     ;; true
          (println (__opt_unwrap r))))) ;; 12

    ;; Test 4: none propagates through .fmap with capturing closure
    (let [delta 5]
      (let [opt (__opt_none)]
        (let [result (.fmap opt (fn [x] (+ x delta)))]
          (println (__opt_some? result))))) ;; false

    ;; Test 5: named function still works (non-closure path)
    (let [opt (__opt_some 7)]
      (let [result (.fmap opt __double)]
        (do
          (println (__opt_some? result))   ;; true
          (println (__opt_unwrap result))))) ;; 14

    0))
