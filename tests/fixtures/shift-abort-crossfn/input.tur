;; Surface unification (one-substrate plan): ONE shift, two lowerings.
;;
;; A shift whose receiver IGNORES its continuation is an abortive shift, and is
;; lowered via the dynamic-abort path -- so it works CROSS-FUNCTION (shift in a
;; callee, reset in a caller) and under arbitrary contexts, exactly like the
;; legacy abortive `shift`.  A resuming receiver (uses `k`) keeps the reified,
;; lexically-scoped path.  The routing is by whether the receiver uses `k`, and
;; applies to lambda, closure, AND named-fn receivers.
;;
;; direct == cps == turi.

;; ignore-k LAMBDA receiver, cross-function: delivers (+ x 5) = 105
(defn inner [x : int] : int
  (shift (fn [k : cont] (+ x 5)) 0))

(defn outer [x : int] : int
  (reset (inner x)))

;; ignore-k lambda under a non-trivial context: the abortive shift discards
;; (+ 100 []), delivering 7 to the reset.
(defn discard-ctx [] : int
  (reset (+ 100 (shift (fn [k : cont] 7) 0))))

;; ignore-k NAMED receiver, cross-function (item A): a top-level fn whose body
;; never references its continuation param also routes to the abort path.
(defn abort-42 [k : cont] : int
  42)

(defn named-crossfn [] : int
  (reset (+ 1 (call-shift))))

(defn call-shift [] : int
  (shift abort-42 0))

(defn main [] : int
  (println (outer 100))       ; 105
  (println (discard-ctx))     ; 7
  (println (named-crossfn))   ; 42 (context (+ 1 []) discarded)
  0)
