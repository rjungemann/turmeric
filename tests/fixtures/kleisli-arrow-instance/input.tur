;; kleisli-arrow-instance -- the Kleisli arrow over Option as a second Category
;; instance plus an HONEST ArrowZero (the (->) arrow has no zero; Kleisli's is
;; \_ -> none).  With two Category instances in scope the nullary (ident) /
;; (zero-arrow) are ambiguous, so each is ascribed to :Kleisli to pick the head.
;;
;; The ascription-disambiguated arrows are reused across multiple applications --
;; a regression guard for the now-fixed
;; docs/archive/history/opaque-ascription-cast-marks-value-move-once.md (an unrestricted
;; opaque ascribed via (:: ... :Kleisli) must stay freely copyable).
(load "stdlib/kleisli.tur")

;; M2b: with `some`/`none` now polymorphic, each Option construction is
;; ascribed back to :int so the Kleisli carrier-ABI machinery threads it as
;; an int64 handle (same as pre-M2b).
(defn safe-recip [x : int] : int
  (if (= x 0) (:: (none) :int) (:: (some (/ 100 x)) :int)))
(defn add1m [x : int] : int (:: (some (+ x 1)) :int))

(defn main [] : int
  ;; identity Kleisli: \a -> some a -- the ascribed arrow `i` is applied twice
  ;; some? takes by-value (Option A); bridge from k-apply's carrier int via (:: r (Option int)).
  (let [i (:: (ident) :Kleisli)]
    (println (some? (:: (k-apply i 41) (Option int))))   ;; true
    (println (unwrap-or-carrier (k-apply i 41) 0)))              ;; 41

  ;; Kleisli composition over some: (100/5)=20 then +1 = 21.  `fg` is reused:
  ;; applied to 5 (some path) and 0 (none short-circuit).
  (let [f  (kleisli safe-recip)
        g  (kleisli add1m)
        fg (:: (comp f g) :Kleisli)]
    (println (unwrap-or-carrier (k-apply fg 5) -7))                  ;; 21
    (println (some? (:: (k-apply fg 0) (Option int)))))      ;; false (none short-circuits)

  ;; honest zero arrow: ignore input, fail with none
  (let [z (:: (zero-arrow) :Kleisli)]
    (println (some? (:: (k-apply z 99) (Option int)))))      ;; false
  0)
