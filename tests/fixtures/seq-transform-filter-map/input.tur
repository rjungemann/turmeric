; LZ2 fixture: seq/filter-map -- map and filter in a single pass.

(load "stdlib/seq/transform.tur")

;;; make-some -- allocate Some(v) for filter-map tests
(defn make-some [v : int] : int
  ```c
  struct { bool is_some; int64_t value; } *opt = malloc(sizeof(*opt));
  opt->is_some = true; opt->value = v;
  return (int64_t)(intptr_t)opt;
  ```)

;;; make-none -- allocate None for filter-map tests
(defn make-none [] : int
  ```c
  struct { bool is_some; int64_t value; } *opt = malloc(sizeof(*opt));
  opt->is_some = false; opt->value = 0;
  return (int64_t)(intptr_t)opt;
  ```)

(defn main [] : void
  (let [two 2
        f (fn [x] (if (= (mod x two) 0) (make-some (* x two)) (make-none)))]
    (seq-for-each println (seq/filter-map f (seq/range 0 6)))))
