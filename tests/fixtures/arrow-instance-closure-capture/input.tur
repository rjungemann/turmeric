;; arrow-instance-closure-capture -- Arrow [(->)] methods carry capturing
;; closures through dispatch, locking the closure-returning instance-method
;; codegen path.
;;
;; Each arrow argument below is a closure that captures a free, let-bound
;; variable (k, base, ...).  The composed arrow must dispatch through the (->)
;; instance dict and still see the captured environment -- the dict fields are
;; int64_t closure carriers, not void*, so the fat box survives composition.

(load "stdlib/arrow.tur")

(defn pair-new [a b] : int
  ```c struct { int64_t e1; int64_t e2; } *p = malloc(sizeof(*p));
  p->e1 = a; p->e2 = b; return (int64_t)(intptr_t)p; ```)
(defn pair-e1 [p] : int ```c return ((int64_t *)(intptr_t)p)[0]; ```)
(defn pair-e2 [p] : int ```c return ((int64_t *)(intptr_t)p)[1]; ```)

(defn main [] : int
  ;; >>> over two capturing closures: (x + k) then (x * scale).
  (let [k     100
        scale 3
        h     (>>> (fn [x : int] : int (+ x k))
                   (fn [x : int] : int (* x scale)))]
    (println (h 5)))                  ;; (5+100)*3 = 315

  ;; arr lifts a capturing closure; the wrapper keeps the captured env.
  (let [base 7
        a    (arr (fn [x : int] : int (+ x base)))]
    (println (a 35)))                 ;; 35 + 7 = 42

  ;; first over a capturing closure: act on slot 0, capture survives.
  (let [bump 9
        r    ((first (fn [x : int] : int (+ x bump))) (pair-new 1 2))]
    (println (pair-e1 r))             ;; 1 + 9 = 10
    (println (pair-e2 r)))            ;; 2
  0)
