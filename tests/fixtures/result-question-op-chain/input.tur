;;
;; Phase R1: Test two ? operators in sequence inside the same function.
;;

(defn u-ok [x : int] : ptr<void>
  ```c
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *result = malloc(sizeof(*result));
  result->tag = 0; result->as.ok_val = x; return result;
  ```)

(defn u-err [e : int] : ptr<void>
  ```c
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *result = malloc(sizeof(*result));
  result->tag = 1; result->as.err_val = e; return result;
  ```)

(defn u-err? [r : ptr<void>] : bool
  ```c
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *result = (void*)r;
  return result == NULL || result->tag != 0;
  ```)

(defn u-ok-val [r : ptr<void>] : int
  ```c
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *result = (void*)r;
  return result->as.ok_val;
  ```)

(defn step-a [x : int] : ptr<void>
  (if (> x 0) (u-ok (* x 10)) (u-err 1)))

(defn step-b [x : int] : ptr<void>
  (if (< x 1000) (u-ok (+ x 1)) (u-err 2)))

(defn chain [x : int] : ptr<void>
  (let [a (? (step-a x))]
    (let [b (? (step-b a))]
      (u-ok b))))

(defn main [] : int
  (let [r (chain 5)]
    (let [v (u-ok-val r)]
      (println v)
      0)))
