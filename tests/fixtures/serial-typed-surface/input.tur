;; serializable-continuations-aspirational-surface: the three names the guides
;; document -- serial-cont->bytes / bytes->serial-cont / serial-resume -- are
;; real stdlib/serial.tur functions over the save-cont!/resume-cont! runtime.
;;
;; bytes->serial-cont returns a Result: it validates the record stream (frame
;; count, tags, call-frame names registered by THIS program, env bounds) before
;; rebuilding the chain, so a foreign or damaged buffer is an Err naming the
;; problem, never an abort or a resumed garbage chain.

(defn tmp-path [name : cstr] : cstr
  ```c
  /* Resolve a scratch path at RUN TIME instead of hardcoding "/tmp/...".
   *
   * A compiled fixture is a NATIVE Windows binary, so its CRT resolves a
   * leading "/tmp" against the CURRENT DRIVE ROOT (C:\tmp, D:\tmp) rather than
   * the way the MSYS shell does.  Where that directory does not exist the open
   * simply failed and the fixture printed nothing.  tests/run.sh exports
   * TUR_TEST_TMPDIR; the "/tmp" fallback keeps this runnable by hand on POSIX.
   *
   * Four rotating buffers so a call like (f (tmp-path "a") (tmp-path "b"))
   * does not have the second call clobber the first. */
  static char bufs[4][512];
  static int slot = 0;
  char *buf = bufs[slot];
  slot = (slot + 1) & 3;
  const char *d = getenv("TUR_TEST_TMPDIR");
  if (!d || !*d) d = "/tmp";
  snprintf(buf, sizeof bufs[0], "%s/%s", d, name);
  return buf;
  ```)

(load "stdlib/serial.tur")

(def ^mut saved : ptr<void> (bytes-alloc 0))

;; The serial-shift receiver: keep the bytes, do not resume (the reset yields -1).
(defn stash [k : serial-cont] : int
  (do (set! saved (serial-cont->bytes k)) -1))

;; Resume directly, through the typed spelling of (k v).
(defn direct [k : serial-cont] : int
  (serial-resume k 7))

;; [n=1][tag=77] -- 77 is neither arithmetic (1..6) nor SK_TAG_CALL.
(defn bad-tag [] : ptr<void>
  ```c int64_t *b = malloc(24); b[0] = 16; b[1] = 1; b[2] = 77; return b; ```)

;; [n=1][SK_TAG_CALL][len=6]"nobody"[env_kind=0][env] -- a call frame whose name
;; this program never registered.
(defn foreign [] : ptr<void>
  ```c
  int64_t *b = malloc(8 + 8 + 8 + 8 + 6 + 8 + 8);
  b[0] = 8 + 8 + 8 + 6 + 8 + 8;
  uint8_t *c = (uint8_t *)(b + 1);
  int64_t n = 1, tag = 100, L = 6, ek = 0, env = 0;
  memcpy(c, &n, 8); c += 8; memcpy(c, &tag, 8); c += 8; memcpy(c, &L, 8); c += 8;
  memcpy(c, "nobody", 6); c += 6; memcpy(c, &ek, 8); c += 8; memcpy(c, &env, 8);
  return b;
  ```)

;; A real buffer cut off after the frame count.
(defn truncated [] : ptr<void>
  ```c int64_t *b = malloc(16); b[0] = 8; b[1] = 3; return b; ```)

(defn report [r : (Result serial-cont cstr)] : void
  (match r
    (Ok k)  (println (serial-resume k 5))
    (Err m) (println m)))

(defn main [] : int
  (do
    (println (serial-reset (+ 10 (serial-shift direct 0))))   ; 17
    (println (serial-reset (* 3 (serial-shift stash 0))))     ; -1
    (report (bytes->serial-cont saved))                       ; 15
    ;; the same bytes through the file helpers
    (cont-to-file saved (tmp-path "tur-serial-typed-surface.bin"))
    (report (bytes->serial-cont (cont-from-file (tmp-path "tur-serial-typed-surface.bin"))))  ; 15
    (report (bytes->serial-cont (bad-tag)))
    (report (bytes->serial-cont (foreign)))
    (report (bytes->serial-cont (truncated)))
    (report (bytes->serial-cont (cont-from-file (tmp-path "tur-serial-typed-surface-missing.bin"))))
    0))
