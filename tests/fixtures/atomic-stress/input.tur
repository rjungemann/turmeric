;; Phase T19-E: atomic-stress — 100 threads each perform 100 atomic increments
;; on a shared counter.  Expected final count: 10000.
;;
;; Designed as a TSan stress test; requires.tsan.

;; Atomic counter helpers (seq-cst __atomic builtins).
(defn atomic-new [init :int] :ptr<void>
  ```c
  int64_t *cell = (int64_t *)malloc(sizeof(int64_t));
  if (!cell) { fprintf(stderr, "atomic-new: oom\n"); abort(); }
  __atomic_store_n(cell, (int64_t)init, __ATOMIC_SEQ_CST);
  return (void *)cell;
  ```)

(defn atomic-load [p :ptr<void>] :int
  ```c
  return (int64_t)__atomic_load_n((int64_t *)p, __ATOMIC_SEQ_CST);
  ```)

(defn atomic-free [p :ptr<void>] :nil
  ```c
  free(p);
  ```)

;; Thread arg: { counter ptr, iterations }
(defn as-arg-new [counter :ptr<void> iters :int] :ptr<void>
  ```c
  typedef struct { int64_t *counter; int64_t iters; } ASArg;
  ASArg *a = (ASArg *)malloc(sizeof(ASArg));
  if (!a) { fprintf(stderr, "as-arg-new: oom\n"); abort(); }
  a->counter = (int64_t *)counter;
  a->iters   = (int64_t)iters;
  return (void *)a;
  ```)

;; Worker: atomically increments counter iters times.
(defn as-worker [arg :ptr<void>] :ptr<void>
  ```c
  typedef struct { int64_t *counter; int64_t iters; } ASArg;
  ASArg *a = (ASArg *)arg;
  int64_t i;
  for (i = 0; i < a->iters; i++)
      __atomic_fetch_add(a->counter, (int64_t)1, __ATOMIC_SEQ_CST);
  return NULL;
  ```)

;; Spawn N threads; each gets its own ASArg (freed in join loop).
(defn as-spawn-all [fn-ptr :ptr<void> counter :ptr<void> n :int iters :int] :ptr<void>
  ```c
  typedef struct { int64_t *counter; int64_t iters; } ASArg;
  pthread_t **handles = (pthread_t **)malloc((size_t)n * sizeof(pthread_t *));
  if (!handles) { fprintf(stderr, "as-spawn-all: oom\n"); abort(); }
  int64_t i;
  for (i = 0; i < n; i++) {
      ASArg *a = (ASArg *)malloc(sizeof(ASArg));
      if (!a) { fprintf(stderr, "as-spawn-all: arg oom\n"); abort(); }
      a->counter = (int64_t *)counter;
      a->iters   = (int64_t)iters;
      pthread_t *t = (pthread_t *)malloc(sizeof(pthread_t));
      if (!t) { fprintf(stderr, "as-spawn-all: thread oom\n"); abort(); }
      pthread_create(t, NULL, (void *(*)(void *))fn_ptr, (void *)a);
      handles[i] = t;
  }
  return (void *)handles;
  ```)

(defn as-join-all [handles :ptr<void> n :int] :nil
  ```c
  pthread_t **hs = (pthread_t **)handles;
  int64_t i;
  for (i = 0; i < n; i++) {
      pthread_join(*hs[i], NULL);
      free(hs[i]);
  }
  free(hs);
  ```)

(defn main [] :int
  (let [counter (atomic-new 0)]
    (let [handles (as-spawn-all as-worker counter 100 100)]
      (as-join-all handles 100))
    (println (atomic-load counter))   ;; 10000
    (atomic-free counter))
  0)
