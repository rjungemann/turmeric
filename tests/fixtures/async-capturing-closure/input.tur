;; Regression fixture for the (async <capturing-closure>) SIGSEGV
;; (docs/archive/compiled-async-capturing-closure-segfault.md).
;;
;; A capturing lambda is a FAT closure box `{ __fn, captures... }`, not a bare
;; function pointer.  EX_ASYNC path (a) used to cast the box straight to
;; `int64_t(*)(void)` and call it -- jumping to the box address (data as code)
;; and crashing at every depth, on BOTH the fiber and cps-async paths.  The fix
;; routes a boxed closure to tur_async_fiber_closure, which reads the thunk out
;; of slot 0 and invokes it with the box as its env.
;;
;; Exercises three capture shapes: a direct closure literal, a let-bound closure,
;; and a recursive capturing async (the archived a-rec repro shape).  Runs on the
;; unconditional CPS/DK async lowering (cps-async graduated 2026-07-19; the fiber
;; path was deleted in the CPS endgame's Stage G).

(defn add-cap [x : int] : int
  (await (async (fn [] : int (+ x 1)))))

(defn add-cap-let [x : int] : int
  (let [c (fn [] : int (+ x 10))]
    (await (async c))))

;; recursive capturing async: each level spawns a closure that captures nothing
;; but calls a-rec (- n 1); a-rec threads its own captures.  Sums 1 n times.
(defn a-rec [n : int] : int
  (if (= n 0)
    0
    (+ 1 (await (async (fn [] : int (a-rec (- n 1))))))))

(defn main [] : nil
  (println (add-cap 41))       ;; 42
  (println (add-cap-let 32))   ;; 42
  (println (a-rec 100)))       ;; 100
