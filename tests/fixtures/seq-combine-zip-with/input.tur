; LZ3 fixture: seq/zip-with -- combine pairs with a function.
; Adds corresponding elements from [0,3) and [10,13): expected 10 12 14

(load "stdlib/seq/combine.tur")

(defn main [] :void
  (let [add (fn [a b] (+ a b))]
    (seq-for-each println
      (seq/zip-with add (seq/range 0 3) (seq/range 10 13)))))
