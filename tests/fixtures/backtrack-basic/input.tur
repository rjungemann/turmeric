;; Phase B3: Backtracking monad — basic mreturn and run-backtrack.
;; mreturn wraps a value in a singleok?n result list; run-backtrack
;; is the identity runner (list monad is eager).

(defn mzero [] :int
  ```c return 0; ```)

(defn mreturn [x] :int
  ```c
  struct { int64_t value; int64_t next; } *cell = malloc(sizeof(*cell));
  cell->value = x;
  cell->next = 0;
  return (int64_t)(intptr_t)cell;
  ```)

(defn run-backtrack [xs] :int xs)

(defn bt-print [xs]
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *c = (Cell*)(intptr_t)xs;
  while (c) {
      printf("%lld\n", (long long)c->value);
      c = (Cell*)(intptr_t)c->next;
  }
  ```)

(defn main []
  (let [result (run-backtrack (mreturn 42))]
    (bt-print result)))
