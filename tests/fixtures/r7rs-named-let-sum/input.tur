#lang r7rs
;; r7rs-lang-plan R2 exit criterion: a named-let loop summing a list runs
;; under --interpret.  Every R2 piece is on the path: `define` with a formals
;; list, named `let` (a letrec-bound lambda), `if` under Scheme truthiness,
;; the prelude's `null?`/`car`/`cdr`/`list` reached through the rename table,
;; and `display`/`newline` on the write primitives.
;;
;; requires.interp-only: the compiled back end cannot yet emit a letrec-bound
;; closure over `any` that calls itself (docs/reported/
;; r7rs-compiled-dynamic-shapes.md); the plan stages R7RS interpreter-first
;; and lifts the compiled path in R6.
(define (sum lst)
  (let loop ((l lst) (acc 0))
    (if (null? l)
        acc
        (loop (cdr l) (+ acc (car l))))))
(display (sum (list 1 2 3 4)))
(newline)
(display (sum (list 1.5 2.5)))
(newline)
(display (sum '()))
(newline)
