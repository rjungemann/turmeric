;; Phase X3: basic set operations -- construction, membership, count.

(defn main [] : int
  (let [s0 (set-new)]
    (let [s1 (set-add s0 1 1)]
      (let [s2 (set-add s1 2 2)]
        (let [s3 (set-add s2 3 3)]
          (println (set-member? s3 1 1))   ; true
          (println (set-member? s3 2 2))   ; true
          (println (set-member? s3 3 3))   ; true
          (println (set-member? s3 4 4))   ; false
          (println (set-count s3))         ; 3
          (set-free s0)
          (set-free s1)
          (set-free s2)
          (set-free s3)))))
  (let [empty (set-new)]
    (println (set-count empty))        ; 0
    (println (set-member? empty 1 1))  ; false
    (set-free empty))
  0)
