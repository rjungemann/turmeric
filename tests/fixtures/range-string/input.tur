;; string-adoption-stdlib-plan batch 3: owned String siblings for the tur/range
;; formatters. range-fmt-string / range->str-string / bound-fmt-string /
;; bound-show-fmt-string adopt the always-fresh cstr each formatter allocates
;; into an owned String (via string/adopt-cstr). bound->str is deliberately
;; excluded (its Unbounded branch returns a static literal); its owned sibling
;; bound->str-string ships in stdlib/range-bound-string.tur (Bucket B). See the
;; bound-string fixture for that one.
(load "stdlib/range-string.tur")

(defn demo [] : int
  (do
    (println (string/to-cstr (range->str-string (closed-open-range 1 5))))
    (println (string/to-cstr (range->str-string (at-most-range 5))))
    (println (string/to-cstr (range-fmt-string 1 1 2 5)))
    (println (string/to-cstr (bound-fmt-string 1 3)))
    (println (string/to-cstr (bound-fmt-string 2 3)))
    (println (string/to-cstr (bound-show-fmt-string 1 3)))
    (println (string/to-cstr (bound-show-fmt-string 2 3)))
    0))

(demo)
