;; Phase HKT H3: All five built-in HKT typeclasses declared together.
;; This compilation test verifies that TestFunctor, TestApplicative, TestMonad,
;; Foldable, and Traversable can all be defined in the same program
;; and that instances compile cleanly.
;; (Renamed Functor -> TestFunctor to avoid conflict with auto-loaded
;; stdlib/typeclass-functor.tur; see KB-032.)

(defclass TestFunctor [^f]
  (fmap [container fn] : int))

(defclass TestApplicative [^f]
  (pure [x] : int)
  (ap [ff fa] : int))

(defclass TestMonad [^m]
  (bind [ma fn] : int))

(defclass Foldable [^t]
  (foldl [ta init fn] : int)
  (foldr [ta init fn] : int))

(defclass Traversable [^t]
  (traverse [ta fn] : int))

;; Minimal instances so the typeclasses are exercised.
(definstance TestFunctor [option]
  (fmap [container fn] 0))

(definstance TestApplicative [option]
  (pure [x] 0)
  (ap [ff fa] 0))

(definstance TestMonad [option]
  (bind [ma fn] 0))

(definstance Foldable [vec]
  (foldl [ta init fn] init)
  (foldr [ta init fn] init))

(definstance Traversable [option]
  (traverse [ta fn] 0))

(defn main [] : int 0)
