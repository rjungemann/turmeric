;; Phase T19: mutex-basic — POSIX mutex lock/unlock/destroy via pthread.h.
;;
;; Mutex is represented as a :ptr<void> pointing to a heap-allocated
;; pthread_mutex_t.  The mutex is initialized with PTHREAD_MUTEX_INITIALIZER
;; semantics (default attributes).

(defn mutex-new [] : ptr<void>
  ```c
  pthread_mutex_t *m = (pthread_mutex_t *)malloc(sizeof(pthread_mutex_t));
  if (!m) { fprintf(stderr, "mutex-new: out of memory\n"); abort(); }
  pthread_mutex_init(m, NULL);
  return (void *)m;
  ```)

(defn mutex-lock [m : ptr<void>] : nil
  ```c
  pthread_mutex_lock((pthread_mutex_t *)m);
  ```)

(defn mutex-unlock [m : ptr<void>] : nil
  ```c
  pthread_mutex_unlock((pthread_mutex_t *)m);
  ```)

(defn mutex-try-lock [m : ptr<void>] : bool
  ```c
  return pthread_mutex_trylock((pthread_mutex_t *)m) == 0;
  ```)

(defn mutex-free [m : ptr<void>] : nil
  ```c
  pthread_mutex_destroy((pthread_mutex_t *)m);
  free(m);
  ```)

(defn main [] : int
  (let [m (mutex-new)]
    ;; lock/unlock round trip
    (mutex-lock m)
    (println 1)
    (mutex-unlock m)
    (println 2)

    ;; try-lock succeeds when unlocked
    (let [got (mutex-try-lock m)]
      (println got)
      ;; try-lock fails when already locked
      (let [got2 (mutex-try-lock m)]
        (println got2))
      (mutex-unlock m))

    (mutex-free m))
  0)
