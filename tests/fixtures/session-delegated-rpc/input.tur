;; SS4: session-delegated-rpc -- delegated session integration test.
;;
;; Demonstrates that a session channel can be passed to a helper function
;; (do-send-recv) that takes ownership of the linear channel and completes
;; the protocol.  The caller loses the binding after delegation.
;;
;; Protocol (client view): Send int (Recv int Close)
;;
;; Expected output: 99

;; do-send-recv: take ownership of the channel, send val, recv response, close.
;; Returns the response integer.

(load "stdlib/session.tur")

(defn do-send-recv [^linear ch :(Session (Send int (Recv int Close))) val : int] : int
  (let [ch (send ch val)]
    (let [[resp ch] (recv ch)]
      (close ch)
      resp)))

;; request: delegate the entire send+recv to do-send-recv.
(defn request [^linear ch :(Session (Send int (Recv int Close))) val : int] : int
  (do-send-recv ch val))

;; echo-server: receive an int and send it back unchanged.
(defn echo-server [^linear ch :(Session (Recv int (Send int Close)))] : nil
  (let [[n ch] (recv ch)]
    (let [ch (send ch n)]
      (close ch))))

(defn main [] : int
  (let [[s r] (make-session (Send int (Recv int Close)))]
    (let [t (session-spawn (fn [] (echo-server r)))]
      (let [result (request s 99)]
        (println result)
        (session-join t))))
  0)
