;; Phase 19D: Deep-handler continuation capture
;; Demonstrates that k can be stored and resumed after the handle form exits.
(defeffect Ask [] :int)

(defn compute [] : int
  (let [x (perform (Ask))]
    (* x 2)))

(let [^mut k-store 0]
  (let [first-result
        (handle (compute)
          (Ask [] k)
          (do (set! k-store k)
              0))]
    (println first-result)
    (let [second-result (resume k-store 5)]
      (println second-result))))
