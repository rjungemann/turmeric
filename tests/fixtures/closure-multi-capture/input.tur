;; HKT-P3: Multi-capture closure borrow-check smoke test.
;; A closure that captures three let-bound values and returns their sum.
;; The borrow checker must accept all three captures without false positives.

(defn main [] : int
  (let [a 10]
    (let [b 20]
      (let [c 30]
        (let [f (fn [] (+ a (+ b c)))]
          (do
            (println (f))
            0))))))
