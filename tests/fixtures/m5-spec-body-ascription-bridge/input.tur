;; M5 residual-straddle (docs/m5-residual-straddle-retirement.md):
;; A Path A spec body that uses `(:: x :int)` to widen a by-value
;; carrier-ABI param (e.g. Vec__int) to the int64 carrier for a
;; downstream carrier-helper call (vec-get, vec-len, etc.) previously
;; mis-emitted: the call-arg emit path at emit_expr.c:2419 stripped
;; the EX_ASCRIBE wrapper BEFORE emit_value ran, bypassing the
;; CK_CONCRETE -> CK_CARRIER bridge at emit_expr.c:4393.  Result:
;; `vec_hyget(x, ...)` with x as by-value Vec__int -> cc type error.
;;
;; Fix: preserve EX_ASCRIBE when its target is TY_INT and the inner
;; is a by-value carrier-ABI EX_VAR -- those are exactly the cases
;; where the L4393 bridge needs to fire.

(defn at1-helper [A]
  [x : (Vec A)]
  : A
  (vec-get (:: x :int) 0))

(defn vec-eq-loop-spec-probe [A]
  [(Eq A)]
  [x : (Vec A) y : (Vec A) i : int len : int]
  : bool
  (if (= i len)
    true
    (if (eq? (:: (vec-get (:: x :int) i) A) (:: (vec-get (:: y :int) i) A))
      (vec-eq-loop-spec-probe x y (+ i 1) len)
      false)))

(defn main [] : int
  (let [a (:: (vec-of) (Vec int))]
    (vec-push! a 42)
    (vec-push! a 17)
    (let [first (at1-helper a)
          loop-eq (vec-eq-loop-spec-probe a a 0 2)]
      (if (and (= first 42) loop-eq) 0 1))))
