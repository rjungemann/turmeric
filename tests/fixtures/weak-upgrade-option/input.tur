;; Verify that (upgrade w) returns option<rc<T>>:
;;   - some (non-NULL) when the rc is still alive
;;   - none (NULL) after the rc has been dropped

(defn ptr-opt-some? [o : ptr<void>] : bool
  ```c
  struct { int tag; int64_t value; } *opt = (void*)o;
  return opt != NULL && opt->tag == 1;
  ```)

(defn main [] : int
  ;; Case 1: rc still alive -- upgrade should succeed (some)
  (let [rc1 (rc/of 42)]
    (let [w1 (weak rc1)
          opt1 (upgrade w1)]
      (println (ptr-opt-some? opt1))))   ; expected: true

  ;; Case 2: rc dropped -- upgrade should fail (none / NULL)
  (let [w2 (let [rc2 (rc/of 99)]
              (weak rc2))]
    (let [opt2 (upgrade w2)]
      (println (ptr-opt-some? opt2))))   ; expected: false

  0)
