;; application-image-dumps-plan (AI3.1): TUR-W0706.
;;
;; `do-init` is the cold-start root of a with-image-cache-after-init call.  It
;; writes two globals: `tracked`, declared with defimage-global (in the image,
;; silent), and `hidden`, a plain def ^mut reached through a callee (NOT in the
;; image -- a warm start silently sees 0).  Exactly one warning, for `hidden`,
;; at the macro call.  The program still builds and runs.

(defn tmp-path [name : cstr] : cstr
  ```c
  /* Resolve a scratch path at RUN TIME instead of hardcoding "/tmp/...".
   *
   * A compiled fixture is a NATIVE Windows binary, so its CRT resolves a
   * leading "/tmp" against the CURRENT DRIVE ROOT (C:\tmp, D:\tmp) rather than
   * the way the MSYS shell does.  Where that directory does not exist the open
   * simply failed and the fixture printed nothing.  tests/run.sh exports
   * TUR_TEST_TMPDIR; the "/tmp" fallback keeps this runnable by hand on POSIX.
   *
   * Four rotating buffers so a call like (f (tmp-path "a") (tmp-path "b"))
   * does not have the second call clobber the first. */
  static char bufs[4][512];
  static int slot = 0;
  char *buf = bufs[slot];
  slot = (slot + 1) & 3;
  const char *d = getenv("TUR_TEST_TMPDIR");
  if (!d || !*d) d = "/tmp";
  snprintf(buf, sizeof bufs[0], "%s/%s", d, name);
  return buf;
  ```)

(load "stdlib/image.tur")

(defn img-rm [path : cstr] : void
  ```c remove(path); ```)

(def ^mut hidden 0)
(defimage-global tracked :int 0)

(defn bump-hidden [] : int
  (do (set! hidden (+ hidden 1)) 0))

(defn do-init [] : int
  (do (bump-hidden) (set! tracked 5) 0))

(defn do-loop [] : int
  (do (println hidden) (println tracked) 0))

(defn main [] : int
  (do
    (image/track-globals! tracked)
    (img-rm (tmp-path "tur-warn-image-global.img"))
    (with-image-cache-after-init (tmp-path "tur-warn-image-global.img") do-init do-loop)
    (img-rm (tmp-path "tur-warn-image-global.img"))
    0))
