;; SI3: Show [Option] formats as "some(v)" or "none".
;; Uses a user-defined Option struct to avoid conflicts with the built-in option type.
(defclass Show [a]
  (show [x] :cstr))

;; Option struct: is_some=1 means some(value), is_some=0 means none.
(defstruct Option :copy [is_some :int value :int])

(defn option-some [x] :int
  ```c
  struct { int64_t is_some; int64_t value; } *opt =
      malloc(sizeof(struct { int64_t is_some; int64_t value; }));
  opt->is_some = 1;
  opt->value = x;
  return (int64_t)(intptr_t)opt;
  ```)

(defn option-none [] :int
  ```c
  struct { int64_t is_some; int64_t value; } *opt =
      malloc(sizeof(struct { int64_t is_some; int64_t value; }));
  opt->is_some = 0;
  opt->value = 0;
  return (int64_t)(intptr_t)opt;
  ```)

(definstance Show [Option]
  (show [x] :cstr
    ```c
    // x is an Option struct value; x.is_some and x.value are int64_t.
    if (!x.is_some) return "none";
    char *buf = (char *)malloc(48);
    snprintf(buf, 48, "some(%lld)", (long long)x.value);
    return (const char *)(intptr_t)buf;
    ```))

(defn main [] :int
  (let [s (make-struct Option 1 99)]
    (println (.show s)))
  (let [n (make-struct Option 0 0)]
    (println (.show n)))
  0)
