;; Phase HKT H1: HKT typeclass declaration alongside a regular KIND_STAR typeclass.
;; Verifies that declaring an HKT typeclass does not break adjacent KIND_STAR
;; instances and method dispatch.

;; HKT typeclass (kind * -> *) — declared but not yet instantiated here.
(defclass MyFuncok?r [^f]
  (fmap [x] :int))

;; Regular KIND_STAR typeclass.
(defclass MyEq [a]
  (eq? [x y] :bool))

(definstance MyEq [int]
  (eq? [x y] (= x y)))

(defn main [] :int
  (if (.eq? 1 1) 0 1))
