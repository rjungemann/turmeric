;; cli-args-basic -- verify *args* contains passed CLI arguments.
;; Prints the first argument from *args* using the cons cell layout.
(defn print-first-arg [lst : int] : void
  ```c
  struct __tur_cons { int64_t value; int64_t next; };
  struct __tur_cons *c = (struct __tur_cons *)(intptr_t)lst;
  printf("%s\n", (const char *)(intptr_t)c->value);
  ```)

(print-first-arg *args*)
