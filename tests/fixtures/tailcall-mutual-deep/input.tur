;; proper-tail-calls T5 (docs/upcoming/proper-tail-calls-plan.md, T-D5):
;; mutual tail calls run in constant stack at -O0.
;;
;; The `flags` file builds this at -O0 (`--debug`).  Section 2.4 of the plan is
;; the reason: at -O2 clang inlines a SMALL cycle into a loop, so an -O2 run of
;; this file would pass with or without T5 and measure only the C compiler.  At
;; -O0 nothing inlines, and each group below either became one fused function
;; with a dispatch loop or overflows the C stack long before 10,000,000.
;;
;; Four groups, each exercising a different part of the lowering:
;;
;;   c0 .. c7  -- an 8-member cycle, the widest group allowed (risk TR4).
;;   fa / fb   -- members of DIFFERENT arity and parameter types (float, cstr),
;;                with a self tail call inside the group: every member keeps
;;                its own slots, and a self call jumps through them too.
;;   ma / mb   -- a jump out of a `match` arm under an owned `ref<T>` local
;;                (T4's drop glue fires before the jump), a NON-tail call to a
;;                member (through its wrapper), and a tail call to a function
;;                outside the group (an ordinary C tail call).
;;   ta / tb   -- a group of two whose members share no parameter name.
;;
;; `^tailcall` on every in-group call is the assertion: before T5 each one was
;; TUR-E0716 ("the callee is a DIFFERENT function").

(defdata Step
  (Done)
  (More int))

(defn classify [n : int] : Step
  (if (= n 0)
    (Done)
    (More (- n 1))))

(defn c0 [n : int] : int (if (= n 0) 0 ^tailcall (c1 (- n 1))))
(defn c1 [n : int] : int (if (= n 0) 1 ^tailcall (c2 (- n 1))))
(defn c2 [n : int] : int (if (= n 0) 2 ^tailcall (c3 (- n 1))))
(defn c3 [n : int] : int (if (= n 0) 3 ^tailcall (c4 (- n 1))))
(defn c4 [n : int] : int (if (= n 0) 4 ^tailcall (c5 (- n 1))))
(defn c5 [n : int] : int (if (= n 0) 5 ^tailcall (c6 (- n 1))))
(defn c6 [n : int] : int (if (= n 0) 6 ^tailcall (c7 (- n 1))))
(defn c7 [n : int] : int (if (= n 0) 7 ^tailcall (c0 (- n 1))))

(defn fa [n : int x : float] : float
  (if (= n 0)
    x
    ^tailcall (fb (- n 1) {x + 7.1} "step")))

(defn fb [n : int x : float tag : cstr] : float
  (if (= n 0)
    x
    (if (= (mod n 3) 0)
      ^tailcall (fb (- n 1) x tag)
      ^tailcall (fa (- n 1) x))))

(defn finish [x : int] : int
  (+ x 1000))

(defn ma [n : int acc : int] : int
  (let [b (ref 1)]
    (match (classify n)
      (Done)   (+ acc (mb 0 0))
      (More v) ^tailcall (mb v (+ acc @b)))))

(defn mb [n : int acc : int] : int
  (if (= n 0)
    (finish acc)
    ^tailcall (ma (- n 1) (+ acc 1))))

(defn ta [count : int] : int
  (if (= count 0) 10 ^tailcall (tb count 0)))

(defn tb [left : int seen : int] : int
  (if (= left 0) seen ^tailcall (ta (- left 1))))

(defn main [] : int
  (println (c0 10000003))
  (println (fa 9 0.0))
  (println (fa 10000000 0.0))
  (println (ma 10000000 0))
  (println (ta 10000000))
  0)
