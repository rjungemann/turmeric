;; Phase R1: basic result type predicates and accessors

(defn u-ok [x : int] : ptr<void>
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *result = malloc(sizeof(*result));
  result->is_ok = true; result->ok_val = x; result->err_val = 0; return result;
  ```)
(defn u-err [e : int] : ptr<void>
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *result = malloc(sizeof(*result));
  result->is_ok = false; result->ok_val = 0; result->err_val = e; return result;
  ```)
(defn u-ok? [r : ptr<void>] : bool
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *result = (void*)r;
  return result != NULL && result->is_ok;
  ```)
(defn u-err? [r : ptr<void>] : bool
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *result = (void*)r;
  return result == NULL || !result->is_ok;
  ```)
(defn u-ok-val [r : ptr<void>] : int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *result = (void*)r;
  return result->ok_val;
  ```)
(defn u-err-val [r : ptr<void>] : int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *result = (void*)r;
  return result->err_val;
  ```)
(defn u-result-unwrap [r : ptr<void>] : int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *result = (void*)r;
  if (result == NULL || !result->is_ok) { fprintf(stderr, "u-result-unwrap: u-err\n"); abort(); }
  return (int)result->ok_val;
  ```)
(defn u-result-unwrap-or [r : ptr<void> default_val : int] : int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *result = (void*)r;
  if (result != NULL && result->is_ok) return (int)result->ok_val;
  return default_val;
  ```)
(defn u-result-expect [r : ptr<void> msg : cstr] : int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *result = (void*)r;
  if (result == NULL || !result->is_ok) { fprintf(stderr, "expect: %s\n", (const char*)msg); abort(); }
  return (int)result->ok_val;
  ```)

(defn main [] : int
  (let [r1 (u-ok 42)]
    (let [r2 (u-err 7)]
      (do
        (println (u-ok? r1))
        (println (u-ok? r2))
        (println (u-err? r1))
        (println (u-err? r2))
        (println (u-ok-val r1))
        (println (u-err-val r2))
        (println (u-result-unwrap r1))
        (println (u-result-unwrap-or r2 99))
        (println (u-result-expect r1 "should not abort"))
        0))))
