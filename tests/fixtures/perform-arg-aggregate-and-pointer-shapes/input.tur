;; perform-does-not-typecheck-its-arguments, third pass: the POSITIVE half of
;; the aggregate / pointer shape rule.  Everything here is a shape an ordinary
;; call accepts, so `perform` must keep accepting it or the check would be
;; stricter than the language: the same struct, the same applied Option, a fn
;; value / nil / a typed pointer at a ptr<void> parameter, and a by-value
;; `(Option int)` at an effect parameter.
;;
;; That last row also pins abi-scan-misses-effect-operands: the ABI
;; specialization scan had no arm for a `perform` ARGUMENT or a `resume`
;; VALUE, so `(some 5)` in the perform and `(unwrap-or o 0)` in the handler
;; clause were emitted unspecialized (implicit declarations, a hard cc error)
;; in the colored function this program needs.
(defstruct Point [x : int y : int])
(defeffect EP [p : Point] : int)
(defeffect EO [o : (Option int)] : int)
(defeffect PV [h : ptr<void>] : int)
(defeffect EI [w : int] : int)

(defn cb [x : int] : int (+ x 1))

(defn w-point [] : int (perform (EP (Point 3 4))))
(defn w-opt   [] : int (perform (EO (some 5))))
(defn w-fn    [] : int (perform (PV cb)))
(defn w-nil   [] : int (perform (PV nil)))
(defn w-ptr   [] : int (perform (PV (:: nil ptr<int>))))

(defn main [] : int
  (println (handle (w-point) (EP [p] k) (resume k (+ (.x p) (.y p)))))
  (println (handle (w-opt)   (EO [o] k) (resume k (unwrap-or o 0))))
  (println (handle (w-fn)    (PV [h] k) (resume k 1)))
  (println (handle (w-nil)   (PV [h] k) (resume k 2)))
  (println (handle (w-ptr)   (PV [h] k) (resume k 3)))
  0)
