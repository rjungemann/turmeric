;;
;; Phase TP3: Tuple6/7/8 construction and positional accessors.
;; Verifies that the arbitrary-arity Kind encoding (uint16_t) supports
;; defstruct families with arity 6, 7, and 8.

(defn t6-3rd  [] :cstr (tuple6-3rd  (tuple6 1 2 "three" 4 5 6)))
(defn t7-last [] :int  (tuple7-7th  (tuple7 10 20 30 40 50 60 77)))
(defn t8-mid  [] :int  (tuple8-4th  (tuple8 1 2 3 42 5 6 7 8)))

(println (t6-3rd))
(println (t7-last))
(println (t8-mid))
