;; hkt-generic-calls-generic: a constrained generic calling another constrained
;; generic at its own abstract type constructor.
;;
;; The inner call pins the callee's constraints to the caller's abstract `M`,
;; so it elaborated against the callee itself: its carrier base, with method
;; calls resolved to a representative instance.  A dict clone shares its
;; original's body, and cloning `add-one` converts its continuation into a
;; dictionary-capturing closure and retires the old wrapper -- which the plain
;; `add-one` still named, so the program failed to link.  When a caller is
;; cloned, such a call is now redirected to the callee's clone with the
;; caller's dictionaries forwarded.  The clone returns the carrier, so its
;; result is unboxed wherever the caller's spec grounds `(M int)` to a by-value
;; type: an argument, a `let`, an `if` arm, and the caller's own tail.
;;
;; `chain-twice` forwards a continuation parameter through two levels, and
;; `count-down` is directly recursive.
(defn add-one [^Monad M ^Applicative M] [m : (M int)] : (M int)
  (bind m (fn [x : int] : (M int) (pure (+ x 1)))))

(defn add-two [^Monad M ^Applicative M] [m : (M int)] : (M int)
  (add-one (add-one m)))

(defn add-four [^Monad M ^Applicative M] [m : (M int)] : (M int)
  (let [t (add-two m)]
    (add-two t)))

(defn count-down [^Monad M ^Applicative M] [m : (M int) n : int] : (M int)
  (if (> n 0) (count-down (add-one m) (- n 1)) m))

(defn chain [^Monad M] [m : (M int) k : (fn [int] (M int))] : (M int)
  (bind m k))

(defn chain-twice [^Monad M] [m : (M int) k : (fn [int] (M int))] : (M int)
  (chain (chain m k) k))

(defn inc-o [x : int] : (Option int) (some (+ x 1)))
(defn inc-r [x : int] : (Result int int) (ok (+ x 1)))

(defn show-o [o : (Option int)] : int
  (match o (Some v) (do (println v) 0) (None) (do (println -1) 0)))
(defn show-r [r : (Result int int)] : int
  (match r (Ok v) (do (println v) 0) (Err e) (do (println (- 0 e)) 0)))

(defn main [] : int
  (let [b    5
        capo (fn [x : int] : (Option int) (some (+ x b)))]
    (show-o (add-two (some 40)))                                  ; 42
    (show-o (add-two (:: (none) (Option int))))                   ; -1
    (show-r (add-two (:: (ok 40) (Result int int))))              ; 42
    (show-r (add-two (:: (err 7) (Result int int))))              ; -7
    (show-o (add-four (some 38)))                                 ; 42
    (show-o (count-down (some 37) 5))                             ; 42
    (show-r (count-down (:: (ok 37) (Result int int)) 5))         ; 42
    (show-o (chain-twice (some 40) inc-o))                        ; 42
    (show-o (chain-twice (some 32) capo))                         ; 42
    (show-r (chain-twice (:: (ok 40) (Result int int)) inc-r)))   ; 42
  0)
