;; Phase F3-5/F3-6 (cross-plan-followups): recursive `.eq?` on
;; `Set[Vec[int]]` via the new `tset-eq-cmp?` stdlib helper.
;;
;; The hash-only `tset-eq?` is wrong for non-primitive elements
;; (two structurally-equal Vec[int] pointers hash differently).
;; F3-5 added `tset-eq-cmp?` -- an O(n*m) variant that takes an
;; element comparator -- and routes Set's recursive dispatch
;; through it so `Set[Vec[int]]` etc. compare structurally.

(defn main [] :int
  (let [v1 (:: (tvec-new) (Vec int))
        v2 (:: (tvec-new) (Vec int))
        v3 (:: (tvec-new) (Vec int))]
    (tvec-push! v1 42)
    (tvec-push! v2 42)
    (tvec-push! v3 99)
    ;; tset-add takes (s hash x); for non-primitive elements we
    ;; supply the pointer as the hash.  The dispatcher's
    ;; comparator handles structural comparison element-by-element.
    (let [s1 (:: (tset-add (tset-new) v1 v1) (Set (Vec int)))
          s2 (:: (tset-add (tset-new) v2 v2) (Set (Vec int)))
          s3 (:: (tset-add (tset-new) v3 v3) (Set (Vec int)))]
      (println (.eq? s1 s2))   ; true:  {[42]} == {[42]}
      (println (.eq? s1 s3)))) ; false: {[42]} vs {[99]}
  0)
