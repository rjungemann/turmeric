;; CPS-IR-to-C backend, N6.3: a perform continuation that captures an INTERMEDIATE
;; computed value (a CPS-introduced result var, not a source binding).  Built with
;; --enable=cps-backend.
;;
;; `(+ (+ x y) (perform E))` computes `(+ x y)` into a fresh CPS var `tN` before
;; the perform, and the continuation `(+ tN <result>)` captures `tN`.  N6.3's
;; capture collector now handles CPS-var captures as well as source-var captures:
;; a fresh CPS var is named the same way (`tN`) at its declaration and every
;; reference, so it is carried in the continuation env exactly like a source
;; capture.  Before this the collector bailed on any captured CPS var and `f`
;; fell back.
;;
;; direct-vs-CPS equal: (3 + 4) + (resume 100) = 7 + 100 = 107.

(defeffect E [] :int)

(defn f [x : int y : int] : int
  (+ (+ x y) (perform (E))))

(defn run [] : int
  (handle (f 3 4) (E [] k) (resume k 100)))

(defn main [] : int
  (println (run))
  0)
