;; Phase 19: with-read-console handler — reads integers from stdin.
(defeffect Read [] :int)

(defn read-int-console [] :int
  ```c
  int _v = 0;
  scanf("%d", &_v);
  return (int64_t)_v;
  ```)

(defmacro with-read-console [body]
  (handle body
    (Read [] k) (resume k (read-int-console))))

(let [x (with-read-console (perform (Read)))]
  (println (+ x 1)))
