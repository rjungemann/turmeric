;; The multi-shot fold: a `^multishot` handler clause that resumes its
;; continuation once per loop iteration.  This is the direct expression of
;; bounded nondeterminism -- fold the continuation over a range -- and it was
;; the blocking case in docs/reported/handler-clause-statement-if-ices-emitter.md
;; (the shape effects-vs-monads.md documented the payload-indirection
;; workaround for).
;;
;; The loop lowers to a synthesized helper (CT_LOOP) entered from the handler
;; case; each `(resume k i)` is a dk_invoke against the same k the
;; straight-line double-resume already used, so the loop only changes how many
;; times.  The assertions are sums THROUGH the continuation: the handle body's
;; arithmetic must run once per resume, so a wrong resume count or a lost
;; continuation changes the number, not just the timing.
;;
;; requires.compiled: turi's fiber-based effect runtime aborts on a multishot
;; resume from the SECOND iteration of a `while` (the same three resumes
;; written straight-line work) -- see
;; docs/reported/turi-multishot-resume-in-while-aborts.md.  The compiled path
;; is the one under test here.
(defeffect Choose [lo : int hi : int] : int)

;; 2*(1+2+..+n), via a non-main function so the loop helper is exercised
;; outside the entry function too.
(defn doubled-sum [n : int] : int
  (handle (* 2 (perform (Choose 1 n)))
          (Choose [lo hi] ^multishot k)
          (let [^mut a 0 ^mut i lo]
            (while (<= i hi) (set! a (+ a (resume k i))) (set! i (+ i 1)))
            a)))

(defn main [] : int
  ;; bare perform body: sum 1..3 = 6
  (println (handle (perform (Choose 1 3))
                   (Choose [lo hi] ^multishot k)
                   (let [^mut a 0 ^mut i lo]
                     (while (<= i hi) (set! a (+ a (resume k i))) (set! i (+ i 1)))
                     a)))
  ;; the continuation does work per resume: (10+1)+(10+2)+(10+3) = 36
  (println (handle (+ 10 (perform (Choose 1 3)))
                   (Choose [lo hi] ^multishot k)
                   (let [^mut a 0 ^mut i lo]
                     (while (<= i hi) (set! a (+ a (resume k i))) (set! i (+ i 1)))
                     a)))
  ;; 2*(1+2+3+4) = 20, twice -- the helper re-enters cleanly across calls
  (println (doubled-sum 4))
  (println (doubled-sum 4))
  0)
