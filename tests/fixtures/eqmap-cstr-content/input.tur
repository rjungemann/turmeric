;; GHE5/#4: structural equality of :cstr-keyed maps is CONTENT-correct.
;;
;; The Eq[Map] dispatch (.eq?) on a concrete Map[cstr V] receiver synthesises a
;; content-aware comparison that threads the MapKey[cstr] key comparator (and a
;; recursive value comparator) at the concrete call site.  So two maps whose
;; keys are equal *text* but distinct *pointers* compare equal -- which the old
;; identity-keyed Eq[Map] could not do.

;; dupe -- a freshly-allocated, DISTINCT pointer with the same text.
(defn dupe [s :cstr] :cstr
  ```c const char* p=(const char*)(intptr_t)s; size_t n=0; while(p[n])n++;
  char* d=(char*)malloc(n+1); for(size_t i=0;i<=n;i++)d[i]=p[i];
  return (const char*)d; ```)

(defn main [] :int
  (let [a  (map-assoc (map-assoc (:: (map-new) (Map cstr int)) "name" 1) "age" 2)
        ;; same content, all keys distinct pointers
        b  (map-assoc (map-assoc (:: (map-new) (Map cstr int)) (dupe "name") 1) (dupe "age") 2)
        ;; same keys, one different value
        c  (map-assoc (map-assoc (:: (map-new) (Map cstr int)) "name" 1) "age" 99)
        ;; different key set
        d  (map-assoc (:: (map-new) (Map cstr int)) "name" 1)]
    (println (if (.eq? a b) 1 0))   ; 1 -- content-equal via distinct pointers
    (println (if (.eq? a c) 1 0))   ; 0 -- value differs
    (println (if (.eq? a d) 1 0))   ; 0 -- key set differs
    (println (if (.eq? a a) 1 0)))  ; 1 -- reflexive
  0)
