;;; Phase R2: catch-unwind returns err(panic) for a panicking thunk, and the
;;; panic message round-trips through the boxed payload.
(defn panic-msg [r : int] : cstr
  ```c
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *res = (void*)(intptr_t)r;
  if (!res || res->tag == 0) return "(ok)";
  tur_panic_payload *p = (tur_panic_payload*)(intptr_t)res->as.err_val;
  return p ? (const char*)tur_panic_payload_value(p) : "(null)";
  ```)

(defn boom [] : int (panic "boom happened"))

(defn main [] : int
  (let [r (catch-unwind (fn [] : int (boom)))]
    (if (err? r)
      (println (panic-msg r))
      (println "no panic")))
  (println "survived")
  0)
