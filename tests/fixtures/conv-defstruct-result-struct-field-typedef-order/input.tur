;; conv-defstruct-result-struct-field-typedef-order -- flag-on canary for the
;; CONV-S1 seam 4 typedef-ordering / value-struct-field fix.
;;
;; `User` embeds an `(Option cstr)` applied-type field, so it does NOT lower (the
;; field-lowerability gate legitimately rejects applied-type fields).  But the
;; stdlib `Result`/`Option` DO lower under the flag, so a lowered
;; `Result__User__cstr` / `Option__User` monomorph holds the value-struct `User`.
;; The monomorph stores it as a heap pointer `User *` (matching the carrier-box
;; layout the prelude helpers produce), which:
;;   - lets a guarded forward `typedef struct User User;` satisfy the C typedef
;;     ordering (the monomorph + its ctor reference `User` only by pointer), so
;;     the embedding monomorph no longer needs `User`'s full typedef flushed
;;     ahead of it;
;;   - heap-boxes the value at the monomorph ctor call, NULLs the unused-variant
;;     slot, and derefs at the accessor.
;; Inert at default (there `Result`/`Option` are structs).

(defstruct User [id : int  nick : (Option cstr)])

(defn mk-ok [u : User] : (Result User cstr) (ok u))
(defn mk-err [] : (Result User cstr) (err "boom"))

(defn describe [r : (Result User cstr)] : cstr
  (if (ok? r) "ok" "err"))

(defn wrap-opt [u : User] : (Option User) (some u))

(defn main [] : int
  (let [u1   (make-struct User 7 (:: (some "al") (Option cstr)))
        u2   (make-struct User 9 (:: (none) (Option cstr)))
        u3   (make-struct User 42 (:: (none) (Option cstr)))
        r1   (mk-ok u1)
        r2   (mk-err)
        o1   (wrap-opt u2)
        back (ok-val r1)]
    (println (describe r1))          ; ok
    (println (describe r2))          ; err
    (if (some? o1) (println "some") (println "none"))   ; some
    (println (.id back))             ; 7
    (println (.id (unwrap o1))))     ; 9
  0)
