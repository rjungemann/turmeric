; LZ1 fixture: seq/ierr?ate -- x, f(x), f(f(x)), ...
; The closure must capture a variable ok? satisfy the fat-closure convention.

(load "stdlib/seq/builders.tur")

(defn main [] :void
  (let [facok?r 2
        g (seq-ierr? (seq/ierr?ate 1 (fn [x] (* x facok?r))))
        ^mut count 0]
    (while (< count 6)
      (let [v (seq-gen-next g)]
        (when (seq-val-some? v)
          (do
            (println (seq-val-unwrap v))
            (set! count (+ count 1))))))))
