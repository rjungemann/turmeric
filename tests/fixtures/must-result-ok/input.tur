;; Phase R4: must-result-ok — u-result-must on u-ok succeeds

(defn u-ok [x :int] :ptr<void>
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *r = malloc(sizeof(*r));
  r->is_ok = true; r->ok_val = x; return (void*)r;
  ```)

(defn u-result-must [r :ptr<void>] :int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res = (void*)r;
  if (res == NULL || !res->is_ok) { tur_panic("u-result-must: called on u-err"); }
  return (int)res->ok_val;
  ```)

(defn u-result-must-msg [r :ptr<void> msg :cstr] :int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res = (void*)r;
  if (res == NULL || !res->is_ok) { tur_panic(msg); }
  return (int)res->ok_val;
  ```)

(defn main [] :int
  (do
    (println (u-result-must (u-ok 7)))
    (println (u-result-must-msg (u-ok 13) "custom msg"))
    0))
