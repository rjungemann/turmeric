;; fat-box-ascribed-aggregate-return: a :ptr<void> fat-closure box that returns
;; a typed aggregate (Pair), ascribed to a (fn ...) type and applied, then
;; field-accessed.  The `::` re-types the box to TY_FN, so the call head used
;; to miss the closure-dispatch path and call the box as a thin function
;; pointer -- a jump into the env struct, i.e. a segfault.  It must instead
;; dispatch through slot 0 (read __fn, pass the box as env) and reconstitute
;; the by-value Pair return.
;; See docs/archive/history/vec-typed-fat-closure-readback-fixture-regressed-codegen.md
;; (the "Remaining gap" / third pattern).

(defn mk-fpair [a : float b : float] : ptr<void>
  (fn [t : float] : (Pair float float) (pair a b)))

(defn mk-ipair [a : int b : int] : ptr<void>
  (fn [t : float] : (Pair int int) (pair a b)))

(defn main [] : int
  ;; let-bound fat box, ascribed + applied, both fields read back
  (let [ps (mk-fpair 1.5 2.5)
        p  ((:: ps (fn [float] #fx{} (Pair float float))) 0.0)]
    (println (pair-fst p))
    (println (pair-snd p)))
  ;; direct application (no intermediate let binding), int element type
  (let [q ((:: (mk-ipair 7 9) (fn [float] #fx{} (Pair int int))) 0.0)]
    (println (pair-fst q))
    (println (pair-snd q)))
  0)
