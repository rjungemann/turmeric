;; CPS-IR-to-C backend, N6.3: a *fat-closure (fn value) capture* -- a continuation
;; captures a rank-2 fn-value parameter and calls it.  Built with
;; --enable=cps-backend.
;;
;; `f`'s post-handle continuation is `(fnv <handle-result>)`, an indirect call
;; through the fn-value parameter `fnv`.  A fn value is a fat closure
;; (`tur_poly_fn_t` = { fn ptr; env ptr }): 16 bytes, wider than the scalar env
;; slot, but Copy -- a borrowed function value the callee never drops (its owner
;; outlives the call).  So it rides the continuation env by value, exactly like an
;; owning-free by-value aggregate:
;;   typedef struct { DK *__k; tur_poly_fn_t f0; } f_hk0_env;   // f0 = fnv
;;   e->f0 = fnv;   and the helper reads `tur_poly_fn_t fnv = e->f0;`
;; then the delegated `fnv.fn(fnv.env, r)` call resolves against that local.
;; Before this, a captured fat closure bailed (a fat closure cannot be truncated
;; into a scalar slot) and `f` fell back; now `cap_add` admits an is_poly_fn
;; capture with `tur_poly_fn_t` as its env-field type.
;;
;; direct-vs-CPS equal: handle resumes 50; fnv=dbl; dbl(50) = 100.

(defeffect E [] :int)

(defn g [] : int
  (perform (E)))

(defn dbl [n : int] : int
  (* n 2))

(defn f [fnv : (fn [int] int)] : int
  (let [r (handle (g) (E [] k) (resume k 50))]
    (fnv r)))

(defn main [] : int
  (println (f dbl))
  0)
