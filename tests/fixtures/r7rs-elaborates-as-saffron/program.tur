#lang saffron
;; r7rs-lang-plan R1's exit criterion was that this file, with its directive
;; swapped to `#lang r7rs`, printed what it prints under Saffron: "R7RS is
;; Saffron's dynamic substrate under a Scheme reader", shown by passing every
;; Turmeric-shaped form below through the Scheme lowering untouched.  That
;; pass-through is gone: Turmeric syntax does not leak into Scheme source
;; (docs/reported/r7rs-turmeric-syntax-leaks.md, items 1 and 7), so hook.sh
;; now pins the other side of the same line -- the program still runs under
;; Saffron, and the same text under `#lang r7rs` is refused at its first
;; Turmeric form, on both back ends, with the message that says where
;; Turmeric code goes.  The substrate is still shared; it is just reached
;; from Scheme through `(import (turmeric ...))` now.
;;
;; The body is saffron-default-any's: an unannotated parameter defaults to
;; `any` and is called at three unrelated types, plus one annotated (static)
;; function, plus a local literal that stays concrete.
(defn id [x] x)
(defn thru [y] (id y))
(defn annotated [n : int] : int (+ n 1))
(defn local [] : int (let [k 42] k))

(defn main [] : int
  (println (type-of (id 1)))
  (println (type-of (id "s")))
  (println (type-of (thru 7.1)))
  (println (annotated 41))
  (println (local))
  (println (+ 7.1 (thru 7.1)))
  0)
