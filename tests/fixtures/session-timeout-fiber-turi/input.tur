;; Regression: a `recv-timeout` evaluated INSIDE an async fiber must observe its
;; deadline (turi-fiber-recv-timeout-ignores-its-deadline).
;;
;; A fiber's park is a swapcontext that only resumes when something enqueues
;; it, and the only thing that did was the peer's deposit -- so the deadline was
;; unreachable until the value it was meant to preempt arrived, and the timed
;; receive took the Left (success) branch however late that was.  The compiled
;; path (pthread_cond_timedwait) took Right.  Same program, two branches.
;;
;; The 50ms deadline expires long before the peer's 800ms send, so the fiber
;; must take the Right (timeout) branch.  The ORDER of the two lines is the
;; assertion that matters: printing `fiber-timeout` before `main-about-to-send`
;; is what distinguishes an observed deadline from "no value was ever
;; deposited", which is how the pre-existing session-timeout-expired-turi
;; fixture could pass with the timed wait entirely stubbed out.
;;
;; Expected output:
;;   fiber-timeout
;;   main-about-to-send
(defn main [] : int
  (let [[r s] (make-session (Recv int (Timeout Close Close)))]
    (let [t (async (fn []
                     (match (recv-timeout r 50)
                       (Left pair) (let [[v r] pair] (println v) (close r))
                       (Right r)   (do (println "fiber-timeout") (close r)))))]
      (await (sleep-async 800))
      (println "main-about-to-send")
      (let [s (send s 99)] (close s) (await t))))
  0)
