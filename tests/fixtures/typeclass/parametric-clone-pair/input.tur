;; CloneI: a LOCAL carrier-slot class (method declared `: int`).  This used
;; to be spelled `Clone`, silently merging with the identical stdlib class;
;; stdlib Clone is now `(clone [x : a] : a)` (committed, per-instance typed),
;; so the carrier-slot shape this fixture exercises needs its own class.
;; A constrained instance over a struct: `Clone [KV]` requires `Clone int`, and
;; the body clones the fields through the constrained instance.
;;
;; Lived as a loose `tests/fixtures/typeclass/parametric-clone-pair.tur` that no
;; harness ran -- run.sh reported the directory PASS without opening the file.
;; When finally run it did not compile: it named its struct `Pair`, which the
;; auto-loaded stdlib already defines, and the resulting redefinition cascaded
;; into a spurious TUR-E0013 orphan-instance error on the instance below.  The
;; struct is renamed here; the fixture's actual subject (a constrained instance
;; over a user-defined struct) is unchanged and now asserts a value.  See
;; docs/archive/fixture-dirs-with-loose-tur-files-pass-without-running.md.
(defstruct KV [first : int second : int])

(defclass CloneI [a]
  (clonei [x] : int))

(definstance CloneI [int]
  (clonei [x] x))

(definstance CloneI [KV]
  [CloneI int]
  (clonei [x] (+ (.clonei (.first x)) (.clonei (.second x)))))

(defn main [] : int
  (println (.clonei (KV 3 4)))    ; 7
  (println (.clonei 5))           ; 5
  0)
