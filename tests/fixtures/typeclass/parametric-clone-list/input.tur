;; CloneI: a LOCAL carrier-slot class (method declared `: int`).  This used
;; to be spelled `Clone`, silently merging with the identical stdlib class;
;; stdlib Clone is now `(clone [x : a] : a)` (committed, per-instance typed),
;; so the carrier-slot shape this fixture exercises needs its own class.
;; The same constrained-instance shape over a cons-cell struct.
;;
;; Lived as a loose `tests/fixtures/typeclass/parametric-clone-list.tur` that no
;; harness ran.  When finally run it failed in the C compiler, not the checker:
;; its instance body was `(clonei [x] x)` against a method declared `: int`, so
;; it returned the struct where an int64 was expected.  `tur check` accepts that
;; mismatch whenever a struct/ADT is on either side of it -- a separate hole,
;; filed as docs/archive/struct-return-type-mismatch-unchecked-until-cc.md.
;; Written here the way the fixture's name implies: clone the int field through
;; the `Clone int` constraint.  See
;; docs/archive/fixture-dirs-with-loose-tur-files-pass-without-running.md.
(defstruct Node [head : int tail : ptr<void>])

(defclass CloneI [a]
  (clonei [x] : int))

(definstance CloneI [int]
  (clonei [x] x))

(definstance CloneI [Node]
  [CloneI int]
  (clonei [x] (.clonei (.head x))))

(defn main [] : int
  (println (.clonei (Node 9 (:: 0 :ptr<void>))))   ; 9
  0)
