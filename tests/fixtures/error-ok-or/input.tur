;; Phase R3: error-ok-or — convert option to result using u-ok-or

;; ─── inline option helpers ───────────────────────────────────────────────────
(defn u-some [x :int] :ptr<void>
  ```c
  struct { bool is_some; int64_t value; } *opt = malloc(sizeof(*opt));
  opt->is_some = true; opt->value = x; return (void*)opt;
  ```)

(defn u-none [] :ptr<void>
  ```c
  struct { bool is_some; int64_t value; } *opt = malloc(sizeof(*opt));
  opt->is_some = false; opt->value = 0; return (void*)opt;
  ```)

;; ─── inline result helpers ───────────────────────────────────────────────────
(defn u-ok? [r :ptr<void>] :bool
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res = (void*)r;
  return res->is_ok;
  ```)

(defn u-ok-val [r :ptr<void>] :int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res = (void*)r;
  return (int)res->ok_val;
  ```)

;; u-ok-or — convert option to result: u-some(v) → u-ok(v), u-none → u-err(e)
(defn u-ok-or [opt :ptr<void> e :int] :ptr<void>
  ```c
  struct { bool is_some; int64_t value; } *o = (void*)opt;
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *result = malloc(sizeof(*result));
  if (o != NULL && o->is_some) {
    result->is_ok   = true;
    result->ok_val  = o->value;
    result->err_val = 0;
  } else {
    result->is_ok   = false;
    result->ok_val  = 0;
    result->err_val = e;
  }
  return result;
  ```)

;; ─── inline show for a simple error code ────────────────────────────────────
(defn show-err-code [code :int] :cstr
  ```c
  switch (code) {
    case 1: return "not-found";
    case 2: return "permission-denied";
    default: return "unknown-error";
  }
  ```)

(defn main [] :int
  (do
    ;; u-some option → u-ok result
    (let [opt1 (u-some 42)]
      (let [r1 (u-ok-or opt1 1)]
        (if (u-ok? r1)
          (println (u-ok-val r1))
          (println "unexpected u-err"))))

    ;; u-none option with u-err code 1 → u-err result
    (let [opt2 (u-none)]
      (let [r2 (u-ok-or opt2 1)]
        (if (u-ok? r2)
          (println "unexpected u-ok")
          (println (show-err-code 1)))))

    ;; u-none option with u-err code 2 → u-err result
    (let [opt3 (u-none)]
      (let [r3 (u-ok-or opt3 2)]
        (if (u-ok? r3)
          (println "unexpected u-ok")
          (println (show-err-code 2)))))

    0))
