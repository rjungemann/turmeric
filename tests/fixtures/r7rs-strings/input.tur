#lang r7rs
;; r7rs-lang-plan T3: strings are sequences of characters, and the ones a
;; procedure newly allocates are mutable.  A literal is an immutable cstr (R7RS
;; allows it); `make-string`, `string`, `string-copy`, `substring`,
;; `string-append`, `list->string` ... give an R7rsString of code points.
;; Every string procedure takes either kind and counts characters, never
;; bytes: one Greek lambda is one character.  Both back ends.
(import (scheme base) (scheme write) (scheme read) (scheme char))
(define (show x) (write x) (newline))

;; The mutators (chibi's own cases, overlapping string-copy! included).
(show (let ((str (string #\a #\b #\c))) (string-set! str 1 #\-) str))
(show (let ((s (string #\a #\b #\c))) (string-set! s 1 #\x1F700)
        (list (string-length s) (char->integer (string-ref s 1)))))
(show (let ((str (make-string 5 #\x))) (string-fill! str #\- 2 3) str))
(show (let ((str (string-copy "abcde"))) (string-copy! str 1 "12345" 0 2) str))
(show (let ((str (string-copy "abcde"))) (string-copy! str 1 str 0 2) str))
(show (let ((str (string-copy "abcde"))) (string-copy! str 3 str 0 2) str))

;; Characters, not bytes -- on a literal too.
(show (list (string-length "\x3BB;") (string-ref "a\x3BB;b" 1)
            (char->integer (string-ref (read (open-input-string "\"\\x03BB;\"")) 0))))
(show (list (string-append "ab" (string #\c) "\x3BB;") (substring "h\x3BB;llo" 1 3)
            (string->list "a\x3BB;") (list->string (list #\a #\x3BB))))

;; A literal and a mutable string with the same characters are equal, and
;; every procedure takes either.
(show (list (equal? "abc" (string #\a #\b #\c)) (string=? "abc" (string-copy "abc"))
            (string<? "abc" (string #\a #\c)) (string-upcase (string #\a #\x3BB))))
(show (list (string->symbol (string-append "fo" "o")) (string->number (string #\4 #\2))
            (string->utf8 "a\x3BB;b" 1 2) (utf8->string (bytevector 206 187))))
(show (list (string-map char-upcase "abc") (string->vector "a\x3BB;") (vector->string #(#\a #\b))
            (string-ci=? "ABC" (string-copy "abc"))))
(define p (open-output-string))
(write-string (string-copy "hello") p 1 3)
(show (get-output-string p))
(display (string-append "dis" "play")) (newline)
