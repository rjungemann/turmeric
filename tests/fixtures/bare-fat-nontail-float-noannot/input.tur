;; Phase B gate (bare-fat-result-monomorphization-plan): a bare `^fat g`
;; parameter (no fn-type annotation) whose call `(g x)` yields a :float result
;; consumed in a NON-tail position, with NO annotation on the let binding.
;;
;; Phase A's tail-only retype structurally cannot reach this let-init call, so
;; `(g x)` would stay int64 and `(use-float y)` would fail.  Phase B defers the
;; canonical (int) body and re-elaborates `run-with` per call site over the
;; incoming closure's result kind -- here TY_FLOAT -- so `y` is float and the
;; result lands in xmm0.  Expected stdout: 7.
(defn use-float [y : float] : float y)
(defn run-with [^fat g x : float] : float
  (let [y (g x)]
    (use-float y)))
(defn make-scale [k : float] : ptr<void>
  (fn [x : float] : float (* x k)))
(defn main [] : int
  (println (run-with (make-scale 2.0) 3.5))   ;; 2.0 * 3.5 = 7
  0)
