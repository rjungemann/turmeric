;;; session-timeout-expired -- sender delays too long; receiver takes the timeout branch.
(load "stdlib/session.tur")

(defn sleep-ms [ms : int] : int
  ```c
  struct timespec req = { .tv_sec = ms / 1000, .tv_nsec = (ms % 1000) * 1000000L };
  struct timespec rem;
  while (nanosleep(&req, &rem) == -1) req = rem;
  return 0;
  ```)

(defn main [] : int
  (let [[r s] (make-session (Recv int (Timeout Close Close)))]
    (let [t (session-spawn (fn []
                     (sleep-ms 200)
                     (let [s (send s 99)]
                       (close s))))]
      (match (recv-timeout r 50)
        (Left pair)
          (let [[v r] pair]
            (println v)
            (close r)
            (session-join t))
        (Right r)
          (do (println "timeout") (close r) (session-join t)))))
  0)
