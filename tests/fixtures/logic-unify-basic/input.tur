;; Phase B4: Logic programming -- basic unification.
;; Unify (term-var 0) with (term-int 42): 1 result, var 0 walks to 42.
;; Uses the pure-Turmeric stdlib/logic.tur engine (no inline-C), so it runs
;; under both the compiled path and the tree-walking interpreter.

(load "stdlib/logic.tur")

(defn main [] : int
  (let [x       (term-var 0)
        results (run-logic 1 (lequal x (term-int 42)))]
    (println (bt-length results))
    (println (term-int-val (reify-walk x results)))
    0))
