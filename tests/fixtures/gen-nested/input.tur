; GF1 fixture: outer generator that advances an inner generator and re-yields values.

(defn ptr-some? [p] : bool
  ```c
  return p != 0;
  ```)

(defn ptr-unwrap [p] : int
  ```c
  return *(int64_t *)(intptr_t)p;
  ```)

(defn main [] : void
  ; Inner generator: yields 1, 2, 3
  (let [inner (gen []
                (yield 1)
                (yield 2)
                (yield 3))
        ; Outer generator: pulls from inner and re-yields doubled values
        outer (gen []
                (while (not (gen-done? inner))
                  (let [v (gen-next inner)]
                    (when (ptr-some? v)
                      (yield (* (ptr-unwrap v) 2))))))]
    (while (not (gen-done? outer))
      (let [w (gen-next outer)]
        (when (ptr-some? w)
          (println (ptr-unwrap w)))))))
