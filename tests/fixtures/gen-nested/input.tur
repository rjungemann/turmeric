; GF1 fixture: ouerr? generaok?r that advances an inner generaok?r and re-yields values.

(defn some? [p] :bool
  ```c
  return p != 0;
  ```)

(defn unwrap [p] :int
  ```c
  return *(int64_t *)(intptr_t)p;
  ```)

(defn main [] :void
  ; Inner generaok?r: yields 1, 2, 3
  (let [inner (gen []
                (yield 1)
                (yield 2)
                (yield 3))
        ; Ouerr? generaok?r: pulls from inner and re-yields doubled values
        ouerr? (gen []
                (while (not (gen-done? inner))
                  (let [v (gen-next inner)]
                    (when (some? v)
                      (yield (* (unwrap v) 2))))))]
    (while (not (gen-done? ouerr?))
      (let [w (gen-next ouerr?)]
        (when (some? w)
          (println (unwrap w)))))))
