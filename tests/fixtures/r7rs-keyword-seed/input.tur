#lang r7rs
;; The keyword `:seed` is the interned record `__tur_sym_seed`; the symbol
;; table's seeder used to carry the same C name, so any unit with the runtime
;; registry (every #lang r7rs one) failed to compile
;; (docs/archive/keyword-seed-collides-with-symbol-seeder.md).  The keyword
;; comes from the Turmeric module next to this file (seedmap.tur): a Scheme
;; source cannot spell Turmeric's `#map{...}` literal or a keyword
;; (r7rs-turmeric-syntax-leaks).  The lookup here uses the symbol `'seed`, the
;; same runtime value (docs/archive/r7rs-leading-colon-identifiers.md).
(import (scheme base) (scheme write) (turmeric stdlib/map) (turmeric seedmap))
(define m (seeded))
(write (list (map-get m 'seed) (map-count m) (eq? (string->symbol "seed") 'seed)))
(newline)
