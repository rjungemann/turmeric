;; constrained-generic-instance-vec-element-dispatch -- a constrained
;; parametric instance body must dispatch a class method on its ELEMENT type
;; (recovered from a carrier helper like vec-get via an explicit `(:: e A)`
;; ascription), not on a single fixed representative instance.
;;
;; Root cause (docs/archive/constrained-generic-instance-method-dispatch-ignores-constraint.md):
;; inside `(definstance C [Vec] [(C A)] ...)` an element read `(vec-get v i)`
;; returns the carrier helper's `:A`, which collapses to the int64 carrier at
;; elaboration.  The documented idiom is to ascribe the read to the constraint
;; var -- `(c (:: (vec-get v i) A))` -- but the emit-side method re-resolver
;; (emit_core.c:emit_reresolve_method_call) stripped that ascription before its
;; tyvar check and read the inner carrier `int`, baking the int representative.
;; Two failure modes resulted:
;;   * with an `int` instance in scope, a SILENT wrong-dispatch (every element
;;     encoded via the int instance); and
;;   * with no `int` instance, a hard TUR_E0020 (no carrier representative to
;;     stand in for the erased receiver).
;;
;; Fix: (1) the re-resolver honours an ascription-to-constraint-tyvar receiver,
;; and (2) when no `int` instance exists the abstract-tyvar dispatch falls back
;; to any carrier-compatible scalar instance (cstr/bool/...) as the
;; representative, so the base clone stays valid C and emit re-dispatches the
;; element call to the concrete A per ABI specialization.

;; --- Case 1: mis-dispatch with an int instance present (Tag : a -> int). ---
(defclass Tag [a] (tag [x] : int))
(definstance Tag [int]  (tag [x] 1))
(definstance Tag [bool] (tag [x] 2))

(definstance Tag [Vec] [(Tag A)]
  (tag [x]
    (let [v (:: x (Vec A))]
      (if (>= (vec-len v) 1)
        (tag (:: (vec-get v 0) A))
        0))))

;; --- Case 2: no int instance -- only cstr + float (json-container shape). ---
(defclass Enc [a] (enc [x] : cstr))
(definstance Enc [cstr]  (enc [x] x))
(definstance Enc [float] (enc [x] "F"))

(definstance Enc [Vec] [(Enc A)]
  (enc [x]
    (let [v (:: x (Vec A))]
      (if (>= (vec-len v) 1)
        (enc (:: (vec-get v 0) A))
        "empty"))))

(defn main [] : int
  (let [vb (:: (vec-new) (Vec bool))
        vs (:: (vec-new) (Vec cstr))
        vf (:: (vec-new) (Vec float))]
    (vec-push! vb true)
    (vec-push! vs "hello")
    (vec-push! vf 3.25)
    (println (tag vb))   ;; Tag[bool] -> 2 (not Tag[int] -> 1)
    (println (enc vs))   ;; Enc[cstr] -> hello
    (println (enc vf))   ;; Enc[float] -> F
    0))
