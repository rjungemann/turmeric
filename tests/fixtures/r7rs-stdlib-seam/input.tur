#lang r7rs
;; r7rs-lang-plan R3 / D9 exit criterion: a Scheme program calling stdlib's
;; persistent map (stdlib/hamt behind stdlib/map) and vec through the
;; `(turmeric <module>)` import head, and getting the right answer on both
;; back ends.  Each argument crosses the seam through Saffron's checked cast.
(import (scheme base) (scheme write)
        (turmeric stdlib/map)
        (only (turmeric stdlib/vec) vec-new vec-push! vec-len vec-get))
;; `(map-new)` rather than a `#map{}` literal: its open `(Map K V)` result is
;; grounded to `(Map any any)`, and the key crosses `map-assoc`'s `(& K)` key
;; check as a borrowed box (saffron-open-generic-result-not-grounded).
;; The keys are Scheme symbols: `'k` is the runtime value a Turmeric
;; keyword `:k` is, and a bare `:k` in Scheme is an R7RS identifier
;; (docs/archive/r7rs-leading-colon-identifiers.md).
(define m (map-assoc (map-assoc (map-new) 'a 1) 'k 42))
(display (map-get m 'k)) (newline)
(display (map-count m)) (newline)
(define v (vec-new))
(vec-push! v 7)
(vec-push! v 8)
(display (vec-len v)) (display " ") (display (vec-get v 1)) (newline)
