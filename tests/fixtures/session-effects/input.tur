;; SS4: session-effects -- session channels and algebraic effects coexist.
;;
;; Demonstrates that a session channel (linear) and an effect handler can be
;; used in the same function without interfering with each other.
;;
;; A SessionLog effect is declared for logging.  A function performs a session
;; send+recv AND performs SessionLog effects; both are wrapped in a handler
;; that intercepts SessionLog, prints the message, and resumes the continuation.
;;
;; The session linearity obligation is satisfied by closing the channel after
;; the recv.  The handler never holds or touches the channel.
;;
;; Expected output:
;; sending 99
;; received 99
;; 99

(defeffect SessionLog [msg :cstr] :nil)

(defn spawn [f : ptr<void>] : ptr<void>
  ```c
  pthread_t *tid = (pthread_t *)malloc(sizeof(pthread_t));
  pthread_create(tid, NULL, tur_session_thread_wrapper, f);
  return (void *)tid;
  ```)

(defn join [t : ptr<void>] : int
  ```c
  pthread_join(*(pthread_t *)t, NULL);
  free(t);
  return 0;
  ```)

;; exchange: perform a send+recv on a session channel while logging with effects.
(defn exchange [^linear ch :(Session (Send int (Recv int Close))) val : int] : int
  (perform (SessionLog "sending 99"))
  (let [ch (send ch val)]
    (let [[result ch] (recv ch)]
      (perform (SessionLog "received 99"))
      (close ch)
      result)))

(defn main [] : int
  (let [[s r] (make-session (Send int (Recv int Close)))]
    (let [t (spawn (fn []
                     (let [[v r] (recv r)]
                       (let [r (send r v)]
                         (close r)))))]
      (let [result
            (handle (exchange s 99)
              (SessionLog [msg] k) (do (println msg) (resume k nil)))]
        (println result)
        (join t))))
  0)
