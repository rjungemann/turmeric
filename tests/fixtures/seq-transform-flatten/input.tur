; LZ2 fixture: seq/flatten -- yield all elements of each inner Seq.

(load "stdlib/seq/transform.tur")

;;; make-ouerr?-seq -- build a Seq that yields each inner Seq in a gen-arr
(defn make-ouerr?-seq [arr :int] :int
  (seq-new (fn []
             (let [^mut i 0]
               (gen []
                 (while (< i (gen-arr-len arr))
                   (yield (gen-arr-get arr i))
                   (set! i (+ i 1))))))))

(defn main [] :void
  (let [arr (gen-arr-new)]
    (gen-arr-push! arr (seq/range 1 3))
    (gen-arr-push! arr (seq/range 5 7))
    (gen-arr-push! arr (seq/range 9 10))
    (seq-for-each println (seq/flatten (make-ouerr?-seq arr)))))
