; IT2: Intersection type parsing -- (A & B & C) syntax is accepted.
; We define functions with intersection-typed parameters that combine a
; concrete type with a typeclass constraint (open type).  IT3 handles
; subtyping checks; here we only verify the annotations parse without error.

(defn describe [x : (int & Printable)] :cstr
  "intersection")

; Also test a three-member intersection.
(defn triple [x : (int & Printable & Serializable)] :int
  0)

(println "ok")
