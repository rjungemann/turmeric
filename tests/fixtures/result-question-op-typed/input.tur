;;
;; Phase R1: the ? operator propagates the err branch early.
;;
;; run(false) makes (produce false) yield an err Result; the ? operator
;; must return that err Result from `run` unchanged, so main observes the
;; original err payload (99) rather than the ok path.
;;

(defn u-ok [x : int] : ptr<void>
  ```c
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *r = malloc(sizeof(*r));
  r->tag = 0; r->as.ok_val = x; return r;
  ```)

(defn u-err [e : int] : ptr<void>
  ```c
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *r = malloc(sizeof(*r));
  r->tag = 1; r->as.err_val = e; return r;
  ```)

(defn u-err-val [r : ptr<void>] : int
  ```c
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *r2 = (void*)r;
  return r2->as.err_val;
  ```)

(defn produce [b : bool] : ptr<void>
  (if b (u-ok 7) (u-err 99)))

(defn run [b : bool] : ptr<void>
  ;; When b is false, (? (produce b)) returns the err Result early.
  (let [x (? (produce b))]
    (u-ok (* x 2))))

(defn main [] : int
  (let [r (run false)]
    (println (u-err-val r))
    0))
