;; G7 (language-readiness-for-typed-signal-plan): compose two float SFs
;; via stdlib/arrow.tur's generic typed >>> combinator.
;;
;; Uses non-capturing named functions so the type parameters A=float, B=float,
;; C=float are visible to the call site and the inner body is emitted with the
;; correct tur_thunk_double_double_t dispatch ABI.

(load "stdlib/arrow.tur")

(defn scale-2 [x : float] : float (* x 2.0))
(defn add-1   [x : float] : float (+ x 1.0))
(defn call-f [^fat f :(fn [float] #{} float) x : float] : float (f x))

(defn main [] : int
  (let [h1 (>>> add-1 scale-2)]
    (println (call-f h1 3.0))    ;; (3.0 + 1.0) * 2.0 = 8
    (println (call-f h1 4.0)))   ;; (4.0 + 1.0) * 2.0 = 10
  0)
