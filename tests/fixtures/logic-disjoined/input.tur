;; Phase B4: Logic programming -- disjoined (disjunction) gives both alternatives.
;; (x=1) or (x=2): 2 results.
;; Uses the pure-Turmeric stdlib/logic.tur engine (no inline-C).

(load "stdlib/logic.tur")

(defn main [] : int
  (let [results (run-logic 5 (disjoined (lequal (term-var 0) (term-int 1))
                                        (lequal (term-var 0) (term-int 2))))]
    (println (bt-length results))
    0))
