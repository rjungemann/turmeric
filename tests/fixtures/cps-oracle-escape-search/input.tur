;; CPS regression oracle (cps-backend-unification): pins the runtime value.
;; See docs/archive/cps-backend-unification-u0-inventory.md.
;;
;; call-cc-completion (CC3.2): escape as early-exit from a search loop.
;; (k x) aborts the moment the first positive element is seen -- no enclosing
;; reset.  When nothing is positive, control falls through to the -1 default.
(extern-c printf [^cstr fmt ^int v] :int)

(defn first-positive [] : int
  (escape (fn [k]
    (when (> -3 0) (k -3))
    (when (>  0 0) (k 0))
    (when (>  7 0) (k 7))     ; first positive: aborts here with 7
    (when (>  9 0) (k 9))
    -1)))

(defn none-positive [] : int
  (escape (fn [k]
    (when (> -3 0) (k -3))
    (when (> -1 0) (k -1))
    -1)))                     ; k never invoked -> default -1

(defn main [] : int
  (printf "first=%lld\n" (first-positive))
  (printf "none=%lld\n" (none-positive))
  0)
