; LZ3 fixture: seq/all? -- true if every element satisfies pred; short-circuits.
; all >5 in [10,15) = true; all >5 in [0,10) = false.

(load "stdlib/seq/consume.tur")

(defn main [] : void
  (let [five 5
        big? (fn [x] (> x five))]
    (println (seq/all? big? (seq/range 10 15)))
    (println (seq/all? big? (seq/range 0 10)))))
