;; Phase T20-D: thread-pool-shutdown — verify shutdown drains in-flight tasks.
;;
;; Test: Create a thread pool, submit 5 tasks, shutdown, verify all tasks completed.
;;
;; Expected output:
;;   shutdown: 10  (sum of 0+1+2+3+4 = 10)

(defn tp-identity [arg : ptr<void>] : ptr<void>
  ```c
  return arg;
  ```)

;; Worker thread for the custom thread pool.
(defn tp-sd-worker-fn [arg : ptr<void>] : ptr<void>
  ```c
  typedef struct {
      void *queue;
      pthread_t *threads;
      int64_t n_threads;
      volatile int stop_flag;
  } TPBlock;
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } TPQBlock;
  typedef struct { void *(*fn)(void *); void *arg; void *promise_cell; } TPTask;
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t ready;
      int64_t value; int64_t exn; bool is_set; bool is_ok;
  } TPFutCell;
  TPBlock *tp = (TPBlock *)arg;
  TPQBlock *q = (TPQBlock *)tp->queue;
  while (1) {
      int64_t task_ptr;
      pthread_mutex_lock(&q->lock);
      while (q->count == 0 && !q->closed)
          pthread_cond_wait(&q->not_empty, &q->lock);
      if (q->count == 0 && q->closed) {
          pthread_mutex_unlock(&q->lock);
          break;
      }
      task_ptr = q->buf[q->head];
      int64_t mod = (q->cap > 0) ? q->cap : q->alloc;
      q->head = (q->head + 1) % mod;
      q->count--;
      pthread_cond_signal(&q->not_full);
      pthread_mutex_unlock(&q->lock);
      if (task_ptr == INT64_MIN || task_ptr == 0) break;
      TPTask *task = (TPTask *)(uintptr_t)task_ptr;
      void *result = task->fn(task->arg);
      TPFutCell *fc = (TPFutCell *)task->promise_cell;
      pthread_mutex_lock(&fc->lock);
      if (!fc->is_set) {
          fc->value = (int64_t)(uintptr_t)result;
          fc->is_set = true; fc->is_ok = true;
          pthread_cond_broadcast(&fc->ready);
      }
      pthread_mutex_unlock(&fc->lock);
      free(task);
  }
  return NULL;
  ```)

(defn main [] : int
  ```c
  typedef struct {
      void *queue;
      pthread_t *threads;
      int64_t n_threads;
      volatile int stop_flag;
  } TPBlock;
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } TPQBlock;
  typedef struct { void *(*fn)(void *); void *arg; void *promise_cell; } TPTask;
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t ready;
      int64_t value; int64_t exn; bool is_set; bool is_ok;
  } TPFutCell;

  /* Create thread pool with 2 workers */
  TPBlock *tp = (TPBlock *)malloc(sizeof(TPBlock));
  tp->n_threads = 2; tp->stop_flag = 0;
  TPQBlock *q = (TPQBlock *)malloc(sizeof(TPQBlock));
  pthread_mutex_init(&q->lock, NULL);
  pthread_cond_init(&q->not_full, NULL);
  pthread_cond_init(&q->not_empty, NULL);
  q->alloc = 16; q->buf = (int64_t *)malloc((size_t)q->alloc * sizeof(int64_t));
  q->head = 0; q->tail = 0; q->count = 0; q->cap = 0; q->closed = 0;
  tp->queue = (void *)q;
  tp->threads = (pthread_t *)malloc(2 * sizeof(pthread_t));
  for (int i = 0; i < 2; i++) {
      pthread_create(&tp->threads[i], NULL,
                     (void *(*)(void *))tp_hysd_hyworker_hyfn, (void *)tp);
  }

  /* Submit 5 tasks */
  TPFutCell *futures[5];
  for (int i = 0; i < 5; i++) {
      futures[i] = (TPFutCell *)malloc(sizeof(TPFutCell));
      pthread_mutex_init(&futures[i]->lock, NULL);
      pthread_cond_init(&futures[i]->ready, NULL);
      futures[i]->is_set = false; futures[i]->is_ok = false;

      TPTask *task = (TPTask *)malloc(sizeof(TPTask));
      task->fn = (void *(*)(void *))tp_hyidentity;
      task->arg = (void *)(uintptr_t)i;
      task->promise_cell = (void *)futures[i];

      pthread_mutex_lock(&q->lock);
      q->buf[q->tail] = (int64_t)(uintptr_t)task;
      q->tail = (q->tail + 1) % q->alloc;
      q->count++;
      pthread_cond_signal(&q->not_empty);
      pthread_mutex_unlock(&q->lock);
  }

  /* Shutdown pool (should drain all in-flight tasks) */
  pthread_mutex_lock(&q->lock);
  q->closed = 1;
  pthread_cond_broadcast(&q->not_empty);
  pthread_cond_broadcast(&q->not_full);
  pthread_mutex_unlock(&q->lock);
  for (int i = 0; i < 2; i++) {
      pthread_join(tp->threads[i], NULL);
  }

  /* Collect results - all tasks should have completed */
  int sum = 0;
  for (int i = 0; i < 5; i++) {
      pthread_mutex_lock(&futures[i]->lock);
      if (!futures[i]->is_set) {
          fprintf(stderr, "shutdown: task %d not completed!\n", i);
          abort();
      }
      sum += (int)futures[i]->value;
      pthread_mutex_unlock(&futures[i]->lock);
  }
  printf("shutdown: %d\n", sum);

  /* Cleanup */
  for (int i = 0; i < 5; i++) {
      pthread_mutex_destroy(&futures[i]->lock);
      pthread_cond_destroy(&futures[i]->ready);
      free(futures[i]);
  }
  free(q->buf);
  pthread_mutex_destroy(&q->lock);
  pthread_cond_destroy(&q->not_full);
  pthread_cond_destroy(&q->not_empty);
  free(q);
  free(tp->threads);
  free(tp);

  return 0;
  ```)
