#lang r7rs
;; r7rs-gc threads, stage B (docs/upcoming/r7rs-gc-threads-plan.md): a
;; thread blocked in a read the collector does not wrap is stopped and
;; resumed by three hundred collections (the stop signal restarts the
;; interrupted system call), and the byte written after reaches it: 90 is Z.
(import (scheme base) (scheme write) (turmeric pipeq))
(display (pipe-run)) (newline)
