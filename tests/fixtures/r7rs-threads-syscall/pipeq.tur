;; pipeq -- a thread blocked reading a pipe through stdio (fgetc: a read
;; the collector does not wrap, so the thread is not parked and every
;; collection sends it the stop signal in the middle of the system call)
;; while this thread collects; then a byte is written and the reader has it.
(defmodule pipeq
  (export pipe-run)
  ```c
  typedef struct { int rfd; int got; } PipeQ;
  static void *pq_reader(void *raw) {
      PipeQ *q = (PipeQ *)raw;
      FILE *f = fdopen(q->rfd, "r");
      q->got = fgetc(f);
      fclose(f);
      return NULL;
  }
  ```
  (defn pipe-run [] : int
    ```c
    int fds[2];
    if (pipe(fds) != 0) abort();
    PipeQ *q = (PipeQ *)calloc(1, sizeof *q);
    q->rfd = fds[0]; q->got = -1;
    pthread_t t;
    if (pthread_create(&t, NULL, pq_reader, q) != 0) abort();
    for (int i = 0; i < 300; i++) {
        void *junk = malloc(64); (void)junk;
        tur_gc_collect();
    }
    if (write(fds[1], "Z", 1) != 1) abort();
    pthread_join(t, NULL);
    close(fds[1]);
    return q->got;
    ```))
