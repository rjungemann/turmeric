;; TCE / test-suite-idioms Phase E: typed empty-container literals.
;; A fused `:T` element-type suffix on a vec or set literal pins the
;; collection's element type, so an empty `[]:int` / `#set{}:int`
;; recovers its element type without a verbose `(:: (vec-new) (Vec int))`
;; ascription.  Desugars to `(:: <literal> (Vec T))` / `(:: <literal> (Set T))`.
(defn main [] :int
  ;; []:int -- empty typed vec; .eq? dispatch recovers Eq[Vec[int]]
  (let [a []:int
        b []:int
        c []:int]
    (vec-push! a 1)
    (vec-push! a 2)
    (vec-push! b 1)
    (vec-push! b 2)
    (vec-push! c 1)
    (vec-push! c 99)
    (println (.eq? a b))    ; true:  both [1 2]
    (println (.eq? a c))    ; false: [1 2] vs [1 99]
    (println (vec-len a)))  ; 2
  ;; #set{}:int -- empty typed set
  (let [s (set-add #set{}:int 7 7)]
    (println (set-count s)))  ; 1
  ;; nested (parenthesized) element type
  (let [vv []:(Vec int)]
    (println (vec-len vv)))   ; 0
  0)
