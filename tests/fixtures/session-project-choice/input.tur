;; SS6: projection through a choice.
;; Protocol: A chooses: left -> A sends int to B; right -> protocol ends.
;; project(Choose2, A) = Session[Choose (Send int Close) Close]
;; project(Choose2, B) = Session[Branch (Recv int Close) Close]
(defprotocol Choose2 [A B]
  (choice A
    [left  (-> A B int)]
    [right]))

(defn spawn [f :ptr<void>] :ptr<void>
  ```c
  pthread_t *tid = (pthread_t *)malloc(sizeof(pthread_t));
  pthread_create(tid, NULL, tur_session_thread_wrapper, f);
  return (void *)tid;
  ```)

(defn join [t :ptr<void>] :int
  ```c
  pthread_join(*(pthread_t *)t, NULL);
  free(t);
  return 0;
  ```)

(defn role-a [^linear ch :(project Choose2 A)] :nil
  (let [ch (choose-left ch)]
    (let [ch (send ch 99)]
      (close ch))))

(defn role-b [^linear ch :(project Choose2 B)] :nil
  (match (offer ch)
    (Left ch)
      (let [[v ch] (recv ch)]
        (println v)
        (close ch))
    (Right ch)
      (close ch)))

(defn main [] :int
  (let [[ca cb] (make-session (Choose (Send int Close) Close))]
    (let [t (spawn (fn [] (role-b cb)))]
      (role-a ca)
      (join t)))
  0)
