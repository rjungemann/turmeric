; Phase SZ2: Stack allocation -- sized-buf-with-stack and sized-buf-compute.
;
; sized-buf-with-stack allocates n elements on the stack (alloca) and calls
; a non-capturing function with the buffer. The buffer is automatically freed
; when the enclosing function returns -- no malloc/free overhead.
;
; sized-buf-compute demonstrates the allocation dispatch strategy:
; n <= 64 uses stack (alloca), n > 64 falls back to heap (malloc).

(defn sized-buf-with-stack [n f] #fx{Unsafe} : int
  ```c
  int64_t *stack_data = alloca((size_t)n * sizeof(int64_t));
  memset(stack_data, 0, (size_t)n * sizeof(int64_t));
  struct { int64_t len; int64_t *data; } stack_buf = { n, stack_data };
  int64_t buf_ptr = (int64_t)(intptr_t)&stack_buf;
  return ((int64_t(*)(int64_t))(intptr_t)f)(buf_ptr);
  ```)

(defn sized-buf-compute [n] #fx{Unsafe} : int
  ```c
  int64_t result = 0;
  if (n <= 64) {
    int64_t *stack_data = alloca((size_t)n * sizeof(int64_t));
    for (int64_t i = 0; i < n; i++) stack_data[i] = i;
    for (int64_t i = 0; i < n; i++) result += stack_data[i];
  } else {
    int64_t *heap_data = (int64_t *)malloc((size_t)n * sizeof(int64_t));
    for (int64_t i = 0; i < n; i++) heap_data[i] = i;
    for (int64_t i = 0; i < n; i++) result += heap_data[i];
    free(heap_data);
  }
  return result;
  ```)

(defn sized-buf-set! [b i v] #fx{Unsafe} : int
  ```c
  struct { int64_t len; int64_t *data; } *buf = (void*)(intptr_t)b;
  if (i >= 0 && i < buf->len) { buf->data[i] = v; return b; }
  fprintf(stderr, "sized-buf-set!: index out of bounds\n"); exit(1);
  ```)

(defn sized-buf-sum [b] #fx{Unsafe} : int
  ```c
  struct { int64_t len; int64_t *data; } *buf = (void*)(intptr_t)b;
  int64_t s = 0;
  for (int64_t i = 0; i < buf->len; i++) s += buf->data[i];
  return s;
  ```)

; Non-capturing callback for sized-buf-with-stack
(defn fill-and-sum [b] : int
  (unsafe (sized-buf-set! b 0 10))
  (unsafe (sized-buf-set! b 1 20))
  (unsafe (sized-buf-set! b 2 30))
  (unsafe (sized-buf-sum b)))

; Another callback: compute sum of indices 0..n-1
(defn index-sum [b] : int
  ```c
  struct { int64_t len; int64_t *data; } *buf = (void*)(intptr_t)b;
  for (int64_t i = 0; i < buf->len; i++) buf->data[i] = i;
  int64_t s = 0;
  for (int64_t i = 0; i < buf->len; i++) s += buf->data[i];
  return s;
  ```)

(defn main [] : int
  ; sized-buf-with-stack: stack allocation, static size 3
  (println (unsafe (sized-buf-with-stack 3 fill-and-sum)))
  ; sized-buf-with-stack: stack allocation, static size 5 (0+1+2+3+4=10)
  (println (unsafe (sized-buf-with-stack 5 index-sum)))
  ; sized-buf-compute: n=5 uses stack (0+1+2+3+4=10)
  (println (unsafe (sized-buf-compute 5)))
  ; sized-buf-compute: n=1 (just 0)
  (println (unsafe (sized-buf-compute 1)))
  ; sized-buf-compute: n=0 (empty sum)
  (println (unsafe (sized-buf-compute 0)))
  ; sized-buf-compute: n=100 uses heap (0+1+...+99=4950)
  (println (unsafe (sized-buf-compute 100)))
  ; sized-buf-compute: n=10 uses stack (0+1+...+9=45)
  (println (unsafe (sized-buf-compute 10)))
  0)
