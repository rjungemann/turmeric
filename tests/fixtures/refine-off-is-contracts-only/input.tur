;; RT0: with the `refined` experiment OFF, refinement elaboration is purely
;; additive -- the file behaves exactly as it did with contract types alone.
;; No discharge pass runs, no TUR-W0372/W0373 is emitted, and every predicate
;; is checked at runtime.
;;
;; The second call violates the parameter refinement, which the RUNTIME check
;; catches: the entry check exists whether or not the experiment is on.  (Its
;; absence for the `x : #refine{...}` spelling was a real hole -- the
;; annotation reaches the elaborator wrapped in a type-annotation node and the
;; old Form-shaped test missed it, so the check was silently never injected.)
(defn double-pos [x : #refine{ v : int | (> v 0) }] : #refine{ r : int | (> r 0) }
  (* x 2))

(defn main [] : int
  (println (double-pos 5))
  (println (double-pos 0))
  (println "unreachable")
  0)
