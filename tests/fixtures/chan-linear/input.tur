;; stdlib-linearity-affinity-plan (L1): Chan is a :linear resource handle.
;;
;; A Chan owns a heap-allocated ChanBlock (mutex, condvars, ring buffer) that
;; must be destroyed exactly once with chan-free. The multi-use accessors
;; chan-send / chan-recv declare their handle ^borrow, so sending and receiving
;; repeatedly reads the handle without consuming it; only chan-free consumes.
;; Under -Xlinear this whole sequence type-checks while dropping the Chan
;; (TUR-E0100) or freeing it twice (TUR-E0101) is rejected.
;;
;; Expected output: chan ok
(load "stdlib/chan.tur")

(defn main [] : int
  (let [ch (chan-new 4)]
    (chan-send ch 10)
    (chan-send ch 20)
    ;; borrow again -- still legal after earlier borrows
    (let [a (chan-recv ch)
          b (chan-recv ch)]
      ;; the single consumption
      (chan-free ch)
      (if (= (+ a b) 30)
        (println "chan ok")
        (println "chan BAD"))
      0)))
