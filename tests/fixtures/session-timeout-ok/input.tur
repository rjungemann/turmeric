;;; session-timeout-ok -- sender sends before timeout; receiver gets the value.
(load "stdlib/session.tur")

(defn main [] : int
  (let [[r s] (make-session (Recv int (Timeout Close Close)))]
    (let [t (session-spawn (fn []
                     (let [s (send s 42)]
                       (close s))))]
      (match (recv-timeout r 1000)
        (Left pair)
          (let [[v r] pair]
            (println v)
            (close r)
            (session-join t))
        (Right r)
          (do (println "timeout") (close r) (session-join t)))))
  0)
