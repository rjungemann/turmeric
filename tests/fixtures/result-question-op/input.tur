;;
;; Phase R1: Test the ? operator for unwrapping results
;;
;; The ? operator unwraps a result, returning the u-ok value if u-ok,
;; or returning early with the u-err value if u-err.

;; Define u-ok and u-err inline (self-contained, like result-basic fixture)
(defn u-ok [x : int] : ptr<void>
  ```c
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *result = malloc(sizeof(*result));
  result->tag = 0; result->as.ok_val = x; return result;
  ```)

(defn u-err [e : int] : ptr<void>
  ```c
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *result = malloc(sizeof(*result));
  result->tag = 1; result->as.err_val = e; return result;
  ```)

(defn u-ok? [r : ptr<void>] : bool
  ```c
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *result = (void*)r;
  return result != NULL && result->tag == 0;
  ```)

(defn u-err? [r : ptr<void>] : bool
  ```c
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *result = (void*)r;
  return result == NULL || result->tag != 0;
  ```)

(defn u-ok-val [r : ptr<void>] : int
  ```c
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *result = (void*)r;
  return result->as.ok_val;
  ```)

(defn u-err-val [r : ptr<void>] : int
  ```c
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *result = (void*)r;
  return result->as.err_val;
  ```)

(defn get-value [b : bool] : ptr<void>
  (if b (u-ok 42) (u-err 1)))

(defn use-question [b : bool] : ptr<void>
  ;; The ? operator lowers through __tur-q-is-err? / __tur-q-ok-val in
  ;; stdlib/result.tur, which are #{} safe.  No (unsafe ...) wrapper needed.
  (let [x (? (get-value b))]
    (u-ok (* x 2))))

(defn main [] : int
  (let [r1 (use-question true)]
    (let [v1 (u-ok-val r1)]
      (println v1)
      0)))
