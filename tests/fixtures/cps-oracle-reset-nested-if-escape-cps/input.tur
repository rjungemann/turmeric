;; U1 oracle (cps-backend-unification-plan): raw reset/shift branch-escape on DK.
;; Backend: --enable=cps-backend (CT-IR raw reset/shift on DK -- U1)
;; A reset delimited body with control flow (if / nested if / do) around a
;; tail-position shift.  Before U1 the CT-IR backend evicted these to
;; emit_cps.c; now delim_ok admits them and they lower onto dk_shift/dk_run.
;; direct == cps is preserved (shift is abortive in a tail position, so the
;; discarded continuation is empty -- both backends agree).
;;
(defn f [n : int] : int
  (reset (if (= n 0)
           (shift (fn [v] v) 100)
           (if (= n 1) (shift (fn [v] v) 200) 300))))
(defn main [] : int
  (println (f 0))
  (println (f 1))
  (println (f 2))
  0)
