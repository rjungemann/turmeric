;; HKT-P3: Multi-capture closure with a ref<T> among plain values.
;; The closure captures both a ref<int> and two plain ints.
;; The borrow checker must accept all three captures without false positives —
;; in particular, capturing a ref<T> is always safe (ref<T> is a managed
;; heap reference, not a stack borrow).

(defn main [] :int
  (let [r (ref 5)]
    (let [a 10]
      (let [b 20]
        (let [v @r]
          (let [f (fn [] (+ v (+ a b)))]
            (do
              (println (f))
              0)))))))
