;;
;; Phase TC2: tzipper basic operations test

(extern-c free [p :ptr<void>] :void)

(defn make-arr3 [] : ptr<void>
  ```c
  int64_t *arr = malloc(3 * sizeof(int64_t));
  arr[0] = 1;
  arr[1] = 2;
  arr[2] = 3;
  return arr;
  ```)

;; zipper-new copies its left/right inputs (see stdlib/tzipper.tur);
;; the caller still owns and must free the originals.

(defn test-focus [] : int
  (let [left (make-arr3)]
    (let [right (make-arr3)]
      (let [z (zipper-new left 2 10 right 2)]
        (let [f (zipper-focus z)]
          (zipper-free z)
          (free left)
          (free right)
          f)))))

(defn test-move-right-focus [] : int
  (let [left (make-arr3)]
    (let [right (make-arr3)]
      (let [z (zipper-new left 0 10 right 3)]
        (let [opt (zipper-move-right z)]
          (let [z2 (unwrap-or opt (:: 0 (Zipper int)))]
            (let [f (zipper-focus z2)]
              ;; z2 is a SECOND zipper: zipper-move-right-raw mallocs a fresh
              ;; struct and fresh left/right arrays rather than mutating z.
              ;; Freeing only z leaks all three (40 + 16 + 8 bytes), which is
              ;; this fixture's own scaffolding and was being counted against
              ;; the compiler in the RM1 leak sweep.
              (zipper-free z2)
              (zipper-free z)
              (free left)
              (free right)
              f)))))))

(println (test-focus))
(println (test-move-right-focus))
