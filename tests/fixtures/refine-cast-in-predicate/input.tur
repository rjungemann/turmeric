;; RT2: `(as T e)` inside a predicate is a builtin conversion, not a measure.
;;
;; It used to fall through to the measure encoder, which declared `as` as an
;; abstract measure at the position-default sort (Int) and the type name as a
;; variable -- an Int-sorted opaque term for a real value, which S2's integer
;; hull then tightened into a contradiction (see the sibling
;; `errors/refine-cast-in-predicate-refuted`, where that shape is now refuted
;; at compile time instead).
;;
;; This fixture pins the OPAQUE case.  `(as int v)` over a real is C
;; truncation, encoded as an uninterpreted Int-sorted term with no axioms, so
;; the obligation is unknown -- no proof, and no counterexample either (the
;; search declines a VC with an uninterpreted symbol).  The runtime check is
;; all that stands, and it must fire: (as int 2.5) is 2, and `r >= 3` is
;; false.
(defn t [x : #refine{ v : float | (<= (as float (as int v)) 2.75) }] : #refine{ r : int | (>= r 3) }
  (as int x))

(defn main [] : int
  (println (t 2.5))
  (println "unreachable")
  0)
