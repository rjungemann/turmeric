#lang r7rs
;; r7rs-lang-plan R6 exit criteria, on both back ends: call/cc as an escape
;; (early return, multiple values through k), dynamic-wind with normal and
;; escaping exits and nested winds, with-exception-handler / raise /
;; raise-continuable / guard (clauses, re-raise to an outer guard, an escape
;; through a wind frame, a handler that returns from `raise`), error objects,
;; parameterize / make-parameter with a converter and restoration on escape,
;; delay / delay-force / force / make-promise (memoized once, a 100000-deep
;; delay-force chain in constant space).
;; call/cc as an escape
(display (call/cc (lambda (k) (+ 1 (k 41))))) (newline)
(display (call-with-current-continuation (lambda (k) 3))) (newline)
(define (find-first pred lst)
  (call/cc (lambda (return)
    (for-each (lambda (x) (if (pred x) (return x))) lst)
    #f)))
(display (find-first even? '(1 3 4 5))) (newline)
(display (find-first even? '(1 3 5))) (newline)
;; multiple values through a continuation
(call-with-values (lambda () (call/cc (lambda (k) (k 1 2))))
  (lambda (a b) (display (list a b)) (newline)))
;; dynamic-wind, normal and escaping
(dynamic-wind (lambda () (display "[in]"))
              (lambda () (display "body"))
              (lambda () (display "[out]")))
(newline)
(display (call/cc (lambda (k)
  (dynamic-wind (lambda () (display "<"))
                (lambda () (k 'escaped))
                (lambda () (display ">"))))))
(newline)
;; nested winds unwind innermost first
(call/cc (lambda (k)
  (dynamic-wind (lambda () (display "a"))
    (lambda () (dynamic-wind (lambda () (display "b")) (lambda () (k 0)) (lambda () (display "B"))))
    (lambda () (display "A")))))
(newline)
;; exceptions
(display (with-exception-handler
  (lambda (e) 10)
  (lambda () (+ 1 (raise-continuable 'oops)))))
(newline)
(display (guard (e (#t (list 'caught e))) (raise 'boom))) (newline)
(display (guard (e ((symbol? e) 'sym) ((string? e) 'str)) (raise "s"))) (newline)
(display (guard (e ((error-object? e) (list (error-object-message e) (error-object-irritants e))))
  (error "bad thing" 1 2)))
(newline)
(display (guard (e (#f 'no)) 'body-value)) (newline)
;; guard re-raises to an outer guard when no clause matches
(display (guard (outer (#t (list 'outer outer)))
  (guard (inner ((number? inner) 'num)) (raise 'not-a-number))))
(newline)
;; the handler runs with the outer handler installed; a wind after runs on escape
(display (guard (e (#t (list 'g e)))
  (dynamic-wind (lambda () (display "(")) (lambda () (raise 'x)) (lambda () (display ")")))))
(newline)
;; parameterize
(define p (make-parameter 10 (lambda (x) (* x 2))))
(display (p)) (newline)
(parameterize ((p 3)) (display (p)) (newline))
(display (p)) (newline)
(define q (make-parameter "a"))
(display (guard (e (#t (q))) (parameterize ((q "b")) (raise 'z)))) (newline)
;; promises
(define count 0)
(define pr (delay (begin (set! count (+ count 1)) (* 6 7))))
(display (promise? pr)) (newline)
(display (force pr)) (display " ") (display (force pr)) (display " ") (display count) (newline)
(display (force 5)) (newline)
(define (stream-loop n) (delay-force (if (= n 0) (delay 'done) (stream-loop (- n 1)))))
(display (force (stream-loop 100000))) (newline)
(display (force (make-promise 9))) (newline)
;; raise with a handler that returns is an error to the outer handler
(display (guard (e (#t (error-object-message e)))
  (with-exception-handler (lambda (x) 'ignored) (lambda () (raise 'inner)))))
(newline)
