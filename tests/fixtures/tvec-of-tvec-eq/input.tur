;; Phase F3-5 / F3-6 (cross-plan-followups): recursive structural
;; equality on Vec[Vec[int]] via `.eq?` dispatch.  The dispatcher
;; recognises the typed-collection `Eq[Vec]` instance dispatching
;; on a TY_APP(Vec, TY_APP(...)) receiver and synthesises a direct
;; call to `tvec-eq?` with an inline comparator lambda whose
;; params are ascribed to the element type.  The inner `.eq?` then
;; re-enters the dispatcher at the next level down.  Recursion
;; terminates at primitive element types where F3-7's single-level
;; dispatch takes over.
;;
;; Companion to the older `tvec-of-tvec-eq-manual` fixture which
;; demonstrates the manual rewrite that F3-5 now performs
;; automatically.

(defn main [] :int
  (let [inner-a (:: (tvec-new) (Vec int))
        inner-b (:: (tvec-new) (Vec int))
        inner-c (:: (tvec-new) (Vec int))]
    (tvec-push! inner-a 1)
    (tvec-push! inner-b 1)
    (tvec-push! inner-c 2)
    (let [outer-1 (:: (tvec-new) (Vec (Vec int)))
          outer-2 (:: (tvec-new) (Vec (Vec int)))
          outer-3 (:: (tvec-new) (Vec (Vec int)))]
      (tvec-push! outer-1 inner-a)
      (tvec-push! outer-2 inner-b)
      (tvec-push! outer-3 inner-c)
      ;; Recursive dispatch: outer's element comparator is Eq[Vec[int]],
      ;; which itself uses (= a b) on int elements.
      (println (.eq? outer-1 outer-2))    ; true  ([[1]] vs [[1]])
      (println (.eq? outer-1 outer-3)))   ; false ([[1]] vs [[2]])

    ;; Three-level deep: Vec[Vec[Vec[int]]]
    (let [mid1 (:: (tvec-new) (Vec (Vec int)))
          mid2 (:: (tvec-new) (Vec (Vec int)))]
      (tvec-push! mid1 inner-a)
      (tvec-push! mid2 inner-b)
      (let [top1 (:: (tvec-new) (Vec (Vec (Vec int))))
            top2 (:: (tvec-new) (Vec (Vec (Vec int))))]
        (tvec-push! top1 mid1)
        (tvec-push! top2 mid2)
        (println (.eq? top1 top2)))))    ; true ([[[1]]] vs [[[1]]])
  0)
