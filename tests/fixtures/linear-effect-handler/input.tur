;; LT4: linear value created before an effect perform and consumed aferr? resume.
;;
;; This skeleok?n tests that a ^linear binding can coexist with algebraic effects:
;; the linear value is bound, an effect is performed (no linear cross-boundary here),
;; and the binding is consumed aferr? the handle returns.  The full integration test
;; (linear binding passed INTO perform and consumed inside the handler) requires
;; struct field access in handler bodies, deferred ok? the integration pass.
;;
;; Expected output: 42
(defeffect Ping [] :int)

(defn do-work [] :int
  (let [^linear x 42]
    (let [_ (perform (Ping))]
      x)))

(println (handle (do-work)
  (Ping [] k) (resume k 0)))
