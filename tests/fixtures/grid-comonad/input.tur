;; Test GridCtx Comonad: extend with Conway's Game of Life rule.
;; Uses a blinker pattern (period-2 oscillator) to verify correctness.
;;
;; C struct layout shared by all inline C blocks:
;;   typedef struct { int64_t *data; int64_t width; int64_t height; int64_t cx; int64_t cy; } GCtx;

;; ── Comonad typeclass ────────────────────────────────────────────────────────
(defclass Comonad [^w]
  (extract   [wa]     : int)
  (extend    [wa fn]  : int)
  (duplicate [wa]     : int))

;; ── GridCtx helpers ──────────────────────────────────────────────────────────

(defn lgrid-new [width height] : int
  ```c
  typedef struct { int64_t *data; int64_t width; int64_t height; int64_t cx; int64_t cy; } GCtx;
  GCtx *g = malloc(sizeof(GCtx));
  g->data   = calloc((size_t)(width * height), sizeof(int64_t));
  g->width  = width;
  g->height = height;
  g->cx = 0;
  g->cy = 0;
  return (int64_t)(intptr_t)g;
  ```)

(defn grid-set [g x y val] : int
  ```c
  typedef struct { int64_t *data; int64_t width; int64_t height; int64_t cx; int64_t cy; } GCtx;
  GCtx *p = (GCtx *)(intptr_t)g;
  if (x < 0 || x >= p->width || y < 0 || y >= p->height) return 0;
  p->data[y * p->width + x] = val;
  return 0;
  ```)

(defn grid-focus [g] : int
  ```c
  typedef struct { int64_t *data; int64_t width; int64_t height; int64_t cx; int64_t cy; } GCtx;
  GCtx *p = (GCtx *)(intptr_t)g;
  return p->data[p->cy * p->width + p->cx];
  ```)

(defn grid-print [g] : int
  ```c
  typedef struct { int64_t *data; int64_t width; int64_t height; int64_t cx; int64_t cy; } GCtx;
  GCtx *p = (GCtx *)(intptr_t)g;
  for (int64_t y = 0; y < p->height; y++) {
    for (int64_t x = 0; x < p->width; x++) {
      putchar(p->data[y * p->width + x] ? '#' : '.');
    }
    putchar('\n');
  }
  return 0;
  ```)

;; extend: for each cell (x,y), call fn with a temporary GCtx focused there.
(defn __gridctx_extend [g fn] : int
  ```c
  typedef struct { int64_t *data; int64_t width; int64_t height; int64_t cx; int64_t cy; } GCtx;
  GCtx *src = (GCtx *)(intptr_t)g;
  int64_t w = src->width, h = src->height;
  int64_t *out_data = malloc((size_t)(w * h) * sizeof(int64_t));
  GCtx tmp;
  tmp.data   = src->data;
  tmp.width  = w;
  tmp.height = h;
  for (int64_t y = 0; y < h; y++) {
    for (int64_t x = 0; x < w; x++) {
      tmp.cx = x;
      tmp.cy = y;
      out_data[y * w + x] = ((int64_t(*)(int64_t))(intptr_t)fn)((int64_t)(intptr_t)&tmp);
    }
  }
  GCtx *out = malloc(sizeof(GCtx));
  out->data   = out_data;
  out->width  = w;
  out->height = h;
  out->cx     = src->cx;
  out->cy     = src->cy;
  return (int64_t)(intptr_t)out;
  ```)

(definstance Comonad [gridctx]
  (extract   [wa]    (grid-focus wa))
  (extend    [wa fn] (__gridctx_extend wa fn))
  (duplicate [wa]    (__gridctx_extend wa (fn [g] g))))

;; ── Conway's Game of Life rule ────────────────────────────────────────────────
;; Receives a GCtx focused at the cell to evaluate.

(defn life-rule [g] : int
  ```c
  typedef struct { int64_t *data; int64_t width; int64_t height; int64_t cx; int64_t cy; } GCtx;
  GCtx *p = (GCtx *)(intptr_t)g;
  int64_t alive = p->data[p->cy * p->width + p->cx];
  int count = 0;
  for (int dy = -1; dy <= 1; dy++) {
    for (int dx = -1; dx <= 1; dx++) {
      if (dx == 0 && dy == 0) continue;
      int nx = (int)p->cx + dx;
      int ny = (int)p->cy + dy;
      if (nx >= 0 && nx < (int)p->width && ny >= 0 && ny < (int)p->height) {
        if (p->data[ny * p->width + nx]) count++;
      }
    }
  }
  if (alive && count < 2) return 0;  /* underpopulation */
  if (alive && count > 3) return 0;  /* overpopulation  */
  if (alive)              return 1;  /* survival        */
  if (count == 3)         return 1;  /* reproduction    */
  return 0;
  ```)

;; ── Main ─────────────────────────────────────────────────────────────────────
;; Blinker: horizontal row of 3 at row 2, columns 1-3 in a 5x5 grid.
;; Gen 0: .....  .....  .###.  .....  .....
;; Gen 1: .....  ..#..  ..#..  ..#..  .....  (vertical)
;; Gen 2: same as gen 0 (period 2)

(defn main [] : int
  (let [g0 (lgrid-new 5 5)]
    (do
      (grid-set g0 1 2 1)
      (grid-set g0 2 2 1)
      (grid-set g0 3 2 1)
      (grid-print g0)
      (let [g1 (.extend g0 life-rule)]
        (do
          (grid-print g1)
          (let [g2 (.extend g1 life-rule)]
            (do
              (grid-print g2)
              0)))))))
