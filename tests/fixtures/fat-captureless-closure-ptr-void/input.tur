;; Regression fixture for captureless-closure-not-boxed-at-fat-ptr-void-boundary.
;; A captureless closure (the SF returned by a nullary `(invert)`) is codegen'd
;; as a BARE fn pointer, not a { thunk, env } fat box.  When ascribed to the
;; :ptr<void> carrier and passed to a ^fat parameter, the ^fat call site used to
;; treat the TY_PTR_VOID argument as "already fat" and pass it through unshimmed
;; -- the consumer then fat-dispatched the code address as slot 0 and segfaulted.
;; Now the ascription is stripped so the bare fn auto-shims into a fat box, just
;; like a capturing closure does.  Both representations must print -0.5.

;; captures nothing -> bare fn ptr
(defn invert []
  (fn [^fat sig : (fn [float] float)]
    (fn [t : float] : float (- 0.0 (sig t)))))

;; forces a capture -> already a fat box (the working control)
(defn invert-cap []
  (let [z 0.0]
    (fn [^fat sig : (fn [float] float)]
      (fn [t : float] : float (- z (sig t))))))

(defn konst [k : float] (let [kv k] (fn [t : float] : float kv)))

;; apply an SF to a signal through the ptr<void> carrier (the __apply-sf shape)
(defn apply-sf [^fat sf  : (fn [ptr<void>] #{} ptr<void>)
                ^fat sig : (fn [float]     #{} float)] : ptr<void>
  (sf sig))

(defn main [] : int
  (let [^fat out : (fn [float] #{} float)
             (apply-sf (:: (invert) :ptr<void>) (:: (konst 0.5) :ptr<void>))]
    (println (out 0.0)))                  ;; captureless -> -0.5
  (let [^fat out : (fn [float] #{} float)
             (apply-sf (:: (invert-cap) :ptr<void>) (:: (konst 0.5) :ptr<void>))]
    (println (out 0.0)))                  ;; capturing control -> -0.5
  0)
