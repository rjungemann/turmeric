;; Phase T24: select! macro — await the first of multiple futures
;;
;; Tests that we can await the first of multiple futures to complete.

(defn async-done? [fut : ptr<void>] : bool
  ```c
  typedef enum { FUTURE_PENDING, FUTURE_FULFILLED, FUTURE_REJECTED } TurFutureStatus;
  typedef struct TurFuture {
      TurFutureStatus status;
      int64_t value;
      const char *error;
      struct { void (*fn)(struct TurFuture *, int64_t); void *env; } on_complete;
  } TurFuture;
  TurFuture *f = (TurFuture *)fut;
  return f && (f->status == FUTURE_FULFILLED || f->status == FUTURE_REJECTED);
  ```)

(defn compute-42 [] : int
  ```c
  return (int64_t)42;
  ```)

(defn compute-99 [] : int
  ```c
  return (int64_t)99;
  ```)

(defn main [] : int
  (let [fut1 (async compute-42)
        fut2 (async compute-99)]
    ;; Wait for fut1, then check fut2
    (let [x (await fut1)]
      (println "Got:42")
      (if (async-done? fut2)
        (let [y (await fut2)]
          (println "Got:99"))))
    0))
