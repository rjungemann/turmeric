;; Phase 19 / T21-B: fiber-effect
;;
;; Verifies that effect handler chains are fiber-local: a handler installed
;; inside a fiber intercepts performs from within that fiber, and a separate
;; handler installed in the main context handles performs from the main context,
;; without cross-contamination.
;;
;; Expected output:
;;   10
;;   99

(defeffect Ask [] :int)

(defn fiber-new-fn [fn : ptr<void> stack-size : int] : ptr<void>
  ```c
  return (void *)tur_fiber_block_new((void(*)(void))fn, (size_t)stack_size);
  ```)

(defn fiber-resume-fn [f : ptr<void> arg : int] : int
  ```c
  return tur_fiber_block_resume((FiberBlock *)f, (int64_t)arg);
  ```)

(defn fiber-free-fn [f : ptr<void>] : nil
  ```c
  tur_fiber_block_free((FiberBlock *)f);
  ```)

(defn fiber-yield-fn [v : int] : nil
  ```c
  tur_fiber_block_yield((int64_t)v);
  ```)

;; The fiber body installs its own handler for Ask (returns 10),
;; performs Ask, yields the result, then returns.
(defn fiber-body [] : nil
  (let [result (handle (perform (Ask))
                 (Ask [] k) (resume k 10))]
    (fiber-yield-fn result)))

(defn main [] : int
  (let [f (fiber-new-fn fiber-body 0)]
    ;; Resume fiber once — it installs its own Ask handler, performs Ask,
    ;; yields the result (10), then the fiber is paused.
    (let [fval (fiber-resume-fn f 0)]
      (println fval)
      (fiber-free-fn f)
      ;; Now in the main context, install a different handler for Ask (returns 99).
      (let [mval (handle (perform (Ask))
                   (Ask [] k) (resume k 99))]
        (println mval)
        0))))
