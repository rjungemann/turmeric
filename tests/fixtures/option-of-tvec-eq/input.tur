;; Phase F3-5/F3-6: recursive `.eq?` on `Option[Vec[int]]` via
;; `option-eq?` per-call-site synthesis.

(defn main [] : int
  (let [v1 []:int
        v2 []:int
        v3 []:int]
    (vec-push! v1 42)
    (vec-push! v2 42)
    (vec-push! v3 99)
    (let [o1 (:: (some v1) (Option (Vec int)))
          o2 (:: (some v2) (Option (Vec int)))
          o3 (:: (some v3) (Option (Vec int)))
          on (:: (none)    (Option (Vec int)))]
      (println (.eq? o1 o2))   ; true:  Some [42] vs Some [42]
      (println (.eq? o1 o3))   ; false: Some [42] vs Some [99]
      (println (.eq? o1 on)))) ; false: Some vs None
  0)
