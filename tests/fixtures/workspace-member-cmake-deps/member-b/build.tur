;;; member-b deliberately omits any :spices entry for member-a, so member-a
;;; is reachable only through the workspace :members list.  By default its
;;; :cmake-deps must NOT be pulled in; a spice that wants a sibling's native
;;; dep declares that sibling in :spices.
(defpackage member-b
  :name    "member-b"
  :version "0.1.0"
  :cmake-deps #map{
    "fakelib" #map{:url "https://example.invalid/fakelib.git"
                :ref "v2.0.0"}
  })
