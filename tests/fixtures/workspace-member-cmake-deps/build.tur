;;; workspace-transitive-native-deps-plan regression: a workspace whose
;;; two members do NOT list each other in :spices.  Sibling members'
;;; modules are importable purely via the workspace :members resolution
;;; (see auto_append_spice_includes in src/main.c), so a sibling's
;;; :cmake-deps must participate in the build too.  Here both members
;;; declare the same-named :cmake-deps with different :ref; building
;;; member-b must still see member-a's contribution (seeded from
;;; :members) and emit the "conflicting :cmake-deps" diagnostic.
(defpackage workspace-member-cmake-deps
  :name    "workspace-member-cmake-deps"
  :version "0.1.0"
  :members ["member-a" "member-b"])
