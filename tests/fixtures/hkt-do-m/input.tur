;; Phase HKT H6: do-m macro for monadic do-notation.
;; (do-m var1 ma1 var2 ma2 ... body)
;; Desugars to: (.bind ma1 (fn [var1] (.bind ma2 (fn [var2] body))))

(defclass TestFunctor [^f]
  (fmap [container fn] : int))

(defclass TestMonad [^m]
  (bind [ma fn] : int))

;; Option helpers
(defn __opt_some [x] : int
  ```c
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn __opt_none [] : int
  ```c
  return 0;
  ```)

(defn __opt_some? [o] : bool
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return p != 0 && p->is_some;
  ```)

(defn __opt_unwrap [o] : int
  ```c
  struct { bool is_some; int64_t value; } *p =
      (void *)(intptr_t)o;
  return (int)(p->value);
  ```)

(defn __fmap_option [container fn] : int
  ```c
  struct { bool is_some; int64_t value; } *c =
      (void *)(intptr_t)container;
  if (!c || !c->is_some) return 0;
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = ((int64_t(*)(int64_t))(intptr_t)fn)(c->value);
  return (int64_t)(intptr_t)r;
  ```)

(defn __bind_option [ma fn] : int
  ```c
  struct { bool is_some; int64_t value; } *opt =
      (void *)(intptr_t)ma;
  if (!opt || !opt->is_some) return 0;
  return ((int64_t(*)(int64_t))(intptr_t)fn)(opt->value);
  ```)

(definstance TestFunctor [option]
  (fmap [container fn] (__fmap_option container fn)))

(definstance TestMonad [option]
  (bind [ma fn] (__bind_option ma fn)))

(defn main [] : int
  (do
    ;; do-m base case: single expression — returned directly
    (let [result3 (do-m (__opt_some 99))]
      (do
        (println (__opt_some? result3))   ;; true
        (println (__opt_unwrap result3)))) ;; 99

    ;; do-m with one binding and non-capturing body
    ;; (do-m x (some 5) (some (* x 3))) => some 15
    (let [result (do-m x (__opt_some 5) (__opt_some (* x 3)))]
      (do
        (println (__opt_some? result))    ;; true
        (println (__opt_unwrap result)))) ;; 15

    ;; do-m with None propagation (one binding)
    (let [result2 (do-m x (__opt_none) (__opt_some (* x 3)))]
      (println (__opt_some? result2)))    ;; false

    ;; Chained bind via __bind_option directly (not do-m), testing monad chaining
    ;; __bind_option (some 3) (\x -> some (x * 2)) = some 6
    ;; __bind_option (some 6) (\y -> some (y + 1)) = some 7
    (let [step1 (__bind_option (__opt_some 3) (fn [x] (__opt_some (* x 2))))]
      (let [result4 (__bind_option step1 (fn [y] (__opt_some (+ y 1))))]
        (do
          (println (__opt_some? result4))   ;; true
          (println (__opt_unwrap result4))))) ;; 7
    0))
