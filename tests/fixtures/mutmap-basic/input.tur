;; Phase F5 (cross-plan-followups): MutableMap basic operations.
;; insert, lookup (has? + get), len, free.

(defn main [] : int
  (let [mm (mutmap-new)]
    (println (mutmap-len mm))         ; 0
    (mutmap-set! mm 1 1 100)
    (mutmap-set! mm 2 2 200)
    (mutmap-set! mm 3 3 300)
    (println (mutmap-len mm))         ; 3
    (println (mutmap-get mm 2 2))      ; 200
    (println (mutmap-has? mm 2 2))     ; true
    (println (mutmap-has? mm 99 99))   ; false
    ;; Update existing key keeps len at 3
    (mutmap-set! mm 2 2 222)
    (println (mutmap-len mm))         ; 3
    (println (mutmap-get mm 2 2))      ; 222
    (mutmap-free mm))
  0)
