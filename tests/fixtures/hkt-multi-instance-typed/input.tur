;; Phase HKT §1 (updated for D0): Two Funcok?r instances coexisting.
;; Dispatch is unambiguous here because each call site has a typed receiver
;; (the lierr?al int 10 is TY_INT matching Funcok?r[int], and true is TY_BOOL
;; matching Funcok?r[bool] -- both are exact matches, not erased-type fallbacks).

(defclass MyShow [a]
  (show [x] :cstr))

(definstance MyShow [int]
  (show [x] :cstr "int"))

(definstance MyShow [bool]
  (show [x] :cstr "bool"))

(defn main [] :int
  (do
    (println (.show 42))    ;; exact match: TY_INT -> MyShow[int]
    (println (.show true))  ;; exact match: TY_BOOL -> MyShow[bool]
    0))
