;; U3 oracle (cps-backend-unification): a colored fn containing a cloneable-reset.
;; f is colored by its base reset/shift and CPS-emitted; the self-contained
;; cloneable-reset (multi-shot delimited region) is delegated to the direct
;; emitter via CT_LETRAW (reusing the dk_copy_range multi-shot runtime) instead
;; of forcing the whole function to evict.  direct == cps.
;;
(defn f [] : int
  (+ (reset (shift (fn [v] v) 10))
     (cloneable-reset 5)))
(defn main [] : int
  (println (f))
  0)
