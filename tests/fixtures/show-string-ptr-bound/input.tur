;; show-owned-result-plan stage 3: complete the ShowString surface for the two
;; instances stage 1 deferred -- ptr<void> (the result<T,E> carrier) and Bound.
;; Both Show bodies mix a borrowed literal with a fresh malloc, so ShowString
;; builds the owned String directly (ptr<void>: from a stack buffer; Bound:
;; adopt the malloc arms, from-cstr the "unbounded" literal).  Content matches
;; Show exactly.
(load "stdlib/range.tur")

;; A result<T,E>-shaped carrier as a raw ptr<void> (SR2b tagged layout:
;; { int tag; payload } with tag 0 = Ok, 1 = Err, payload at offset 8).
(defn mk-ok [v : int] : ptr<void>
  ```c
  struct R { int tag; int64_t payload; };
  struct R *r = (struct R*)malloc(sizeof(struct R));
  r->tag = 0; r->payload = v;
  return (void*)r;
  ```)
(defn mk-err [v : int] : ptr<void>
  ```c
  struct R { int tag; int64_t payload; };
  struct R *r = (struct R*)malloc(sizeof(struct R));
  r->tag = 1; r->payload = v;
  return (void*)r;
  ```)

(defn emit [s : String] : void
  (do (println (string/to-cstr s)) (string/release s)))

(defn main [] : int
  (do
    ;; Bound: Show vs ShowString parity
    (emit (show (Inclusive 3)))     ; [3
    (emit (show (Exclusive 5)))     ; (5
    (emit (show (Unbounded)))       ; unbounded
    ;; ptr<void> result carrier: Show vs ShowString parity
    (let [a (mk-ok 42)] (emit (show (:: a ptr<void>))))   ; ok(42)
    (let [b (mk-err 7)] (emit (show (:: b ptr<void>))))   ; err(7)
    0))
