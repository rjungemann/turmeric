;; TCE2: vec-of infers a single element type A and stores it through the
;; carrier. Homogeneous float and cstr literals round-trip; reads ascribe A.

(defn main [] : int
  (let [fs (vec-of 0.5 1.5 2.5)
        ss (vec-of "x" "y")]
    (println (:: (vec-get fs 0) :float))
    (println (:: (vec-get fs 2) :float))
    (println (vec-len fs))
    (println (:: (vec-get ss 1) :cstr))
    (println (vec-len ss))
    0))
