;; Phase T19-E: thread-stress — spawn 100 threads, each increments an atomic
;; counter by 1, then join all.  Expected final count: 100.
;;
;; Designed as a TSan stress test; requires.tsan ensures it only runs when
;; ThreadSanitizer is active.

;; Atomic counter helpers (seq-cst __atomic builtins).
(defn atomic-new [init :int] :ptr<void>
  ```c
  int64_t *cell = (int64_t *)malloc(sizeof(int64_t));
  if (!cell) { fprintf(stderr, "atomic-new: oom\n"); abort(); }
  __atomic_store_n(cell, (int64_t)init, __ATOMIC_SEQ_CST);
  return (void *)cell;
  ```)

(defn atomic-load [p :ptr<void>] :int
  ```c
  return (int64_t)__atomic_load_n((int64_t *)p, __ATOMIC_SEQ_CST);
  ```)

(defn atomic-add! [p :ptr<void> delta :int] :int
  ```c
  return (int64_t)__atomic_fetch_add((int64_t *)p, (int64_t)delta, __ATOMIC_SEQ_CST);
  ```)

(defn atomic-free [p :ptr<void>] :nil
  ```c
  free(p);
  ```)

;; Thread arg: pointer to the shared counter.
(defn counter-arg-new [counter :ptr<void>] :ptr<void>
  ```c
  return counter;   /* pass counter directly as arg */
  ```)

;; Worker: increments the counter by 1.
(defn stress-worker [arg :ptr<void>] :ptr<void>
  ```c
  __atomic_fetch_add((int64_t *)arg, (int64_t)1, __ATOMIC_SEQ_CST);
  return NULL;
  ```)

;; Spawn/join helpers.
(defn ts-thread-spawn [fn-ptr :ptr<void> arg :ptr<void>] :ptr<void>
  ```c
  pthread_t *t = (pthread_t *)malloc(sizeof(pthread_t));
  if (!t) { fprintf(stderr, "ts-thread-spawn: oom\n"); abort(); }
  pthread_create(t, NULL, (void *(*)(void *))fn_ptr, arg);
  return (void *)t;
  ```)

(defn ts-thread-join [t :ptr<void>] :nil
  ```c
  pthread_join(*(pthread_t *)t, NULL);
  free(t);
  ```)

;; Spawn N threads running stress-worker against the counter; join them all;
;; return an array (ptr<void>) of N pthread_t handles.
;; We spawn in a loop via inline C to avoid 100 explicit let bindings.
(defn spawn-all [counter :ptr<void> n :int] :ptr<void>
  ```c
  pthread_t **handles = (pthread_t **)malloc((size_t)n * sizeof(pthread_t *));
  if (!handles) { fprintf(stderr, "spawn-all: oom\n"); abort(); }
  int64_t i;
  for (i = 0; i < n; i++) {
      pthread_t *t = (pthread_t *)malloc(sizeof(pthread_t));
      if (!t) { fprintf(stderr, "spawn-all: thread oom\n"); abort(); }
      pthread_create(t, NULL,
          (void *(*)(void *))stress_worker,
          (void *)counter);
      handles[i] = t;
  }
  return (void *)handles;
  ```)

(defn join-all [handles :ptr<void> n :int] :nil
  ```c
  pthread_t **hs = (pthread_t **)handles;
  int64_t i;
  for (i = 0; i < n; i++) {
      pthread_join(*hs[i], NULL);
      free(hs[i]);
  }
  free(hs);
  ```)

(defn main [] :int
  (let [counter (atomic-new 0)]
    (let [handles (spawn-all counter 100)]
      (join-all handles 100))
    (println (atomic-load counter))   ;; 100
    (atomic-free counter))
  0)
