;; Phase F5: reactor-fibers-park-chan -- park on a channel, unpark on send.
;;
;; A receiver fiber parks on a channel; a sender fiber sends a value and then
;; calls reactor-wake so the driver's blocking poll returns promptly and the
;; channel bridge delivers the value (the documented same-thread pattern).
;;
;; Expected output:
;;   sent 99
;;   got 99
;;   completed=2

(load "stdlib/reactor.tur")
(load "stdlib/chan.tur")

(defn print-sent [n : int] : nil
  ```c printf("sent %lld\n", (long long)n); ```)

(defn print-got [n : int] : nil
  ```c printf("got %lld\n", (long long)n); ```)

(defn print-completed [n : int] : nil
  ```c printf("completed=%lld\n", (long long)n); ```)

(defn null-ptr [] : ptr<void>
  ```c return NULL; ```)

;; Borrow a Chan and hand back its raw ptr<void> representation without
;; consuming the linear handle.  A linear Chan cannot be aliased across two
;; fiber closures, so main keeps sole ownership of `ch` (freeing it once at the
;; end) and lends this non-linear raw pointer to both fibers instead.
(defn chan-raw [^borrow ch : Chan] : ptr<void>
  ```c return (void *)ch; ```)

(defn main [] : int
  (let [r   (reactor-new)
        g   (local-fiber-group-new r)
        ch  (chan-new 4)
        chp (chan-raw ch)]
    ;; Receiver: park until a value arrives.  local-park-chan (tur/reactor) is
    ;; not yet handle-typed (Tier 2), so it takes the channel's ptr<void>
    ;; representation -- the borrowed raw pointer `chp`, captured by env.
    (local-spawn g
      (fn [user] : nil
        (print-got (local-park-chan g chp)))
      (null-ptr))
    ;; Sender: send then wake so the poll returns and the bridge fires.  The
    ;; raw pointer is reinterpreted back to a Chan for the (borrowing) send.
    (local-spawn g
      (fn [user] : nil
        (chan-send (:: chp Chan) 99)
        (print-sent 99)
        (reactor-wake r))
      (null-ptr))
    (let [n (reactor-run-fibers g)]
      (print-completed n)
      (local-fiber-group-free g)
      (chan-free ch)
      (reactor-free r)
      0)))
