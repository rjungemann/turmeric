;; Phase F5: MutableMap structural equality via tmutmap-eq?.
;; Same key/value sets compare equal regardless of insertion order;
;; differing sets compare unequal.

(defn main [] :int
  (let [a (tmutmap-new)
        b (tmutmap-new)
        c (tmutmap-new)]
    (tmutmap-set! a 1 1 100)
    (tmutmap-set! a 2 2 200)
    (tmutmap-set! a 3 3 300)
    ;; b: same key/value set, different insertion order
    (tmutmap-set! b 3 3 300)
    (tmutmap-set! b 2 2 200)
    (tmutmap-set! b 1 1 100)
    ;; c: differs in one value
    (tmutmap-set! c 1 1 100)
    (tmutmap-set! c 2 2 999)
    (tmutmap-set! c 3 3 300)
    (println (tmutmap-eq? a b (fn [x y] (= x y))))   ; true
    (println (tmutmap-eq? a c (fn [x y] (= x y))))   ; false
    ;; Same content via the typeclass dispatch (uses (= x y))
    (println (.eq? (:: a (MutableMap int int))
                   (:: b (MutableMap int int))))     ; true
    (tmutmap-free a)
    (tmutmap-free b)
    (tmutmap-free c))
  0)
