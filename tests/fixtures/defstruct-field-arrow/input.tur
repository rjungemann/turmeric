; EF-1: an (arrow ...) / (-> A B) form is a valid defstruct/ADT field type.
;
; `(-> int int)` is an alternate spelling of `(fn [int] int)`; it lowers to
; TY_FN and rides the int64 carrier slot exactly as a `fn`-typed field does
; (docs/archive/structdef-exotic-field-arrow-plan.md).  Previously this hit
; the DS-A4 "not yet supported as a struct/ADT field" hard error.

(defstruct Cell [f : (-> int int)])

(defn main [] : int
  (let [c (Cell (fn [x : int] : int (+ x 1)))]
    (println (.f c 41))   ; 42 -- field stored, read back, and invoked
    0))
