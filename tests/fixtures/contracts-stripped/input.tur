;; Phase C2: under --no-contracts, a failing assert! is stripped entirely,
;; so the program runs to completion instead of panicking. contract-enabled?
;; folds to false.
(defn main [] :int
  (assert! (= 1 2))
  (if (contract-enabled?)
    (println "enabled")
    (println "disabled"))
  (println "reached-end")
  0)
