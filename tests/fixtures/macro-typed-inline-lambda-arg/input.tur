;; Regression: a typed inline lambda `(fn [x : int] : void ...)` passed as a
;; macro argument must be spliced verbatim, not validated under compile-time
;; fn rules (which require bare-symbol params).
;; docs/archive/history/macro-typed-inline-lambda-arg.md

(defmacro with-thing [binding & body]
  `(let [~(first binding) ~(first (rest binding))]
     ~@body))

(defn apply-cb [f : (fn [int] void) x : int] : int
  (f x)
  x)

(defn main [] : int
  (with-thing [r (apply-cb (fn [n : int] : void (println n)) 7)]
    (println r))
  0)
