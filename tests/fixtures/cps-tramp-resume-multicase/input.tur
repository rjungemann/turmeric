(defeffect Add [] :int)
(defeffect Mul [] :int)
(defn loop [n : int acc : int] : int
  (if (= n 0) acc
    (loop (- n 1) (+ (+ acc (perform (Add))) (perform (Mul))))))
(defn run [] : int
  (handle (loop 500000 0)
    (Add [] k) (resume k 1)
    (Mul [] k) (resume k 2)))
(defn main [] : int (println (run)) 0)
