;; Phase T22: taskgroup-nested — nested task groups
;;
;; Tests:
;;   1. Create outer task group
;;   2. Create inner task group  
;;   3. Spawn tasks in both groups
;;   4. Complete all tasks
;;   5. Wait for both groups
;; Expected output: nested-complete

;; TaskGroupBlock inline definition
(defn tg-new [] : ptr<void>
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)malloc(sizeof(TaskGroupBlock));
  if (!g) { fprintf(stderr, "tg-new: oom\n"); abort(); }
  pthread_mutex_init(&g->lock, NULL);
  pthread_cond_init(&g->done_cond, NULL);
  g->task_count = 0;
  g->completed_count = 0;
  g->cancelled = false;
  g->done = false;
  return (void *)g;
  ```)

(defn tg-spawn [group : ptr<void>] : nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  g->task_count++;
  pthread_mutex_unlock(&g->lock);
  ```)

(defn tg-task-done [group : ptr<void>] : nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  if (!g) return;
  pthread_mutex_lock(&g->lock);
  g->completed_count++;
  if (g->completed_count >= g->task_count && g->task_count > 0) {
      g->done = true;
      pthread_cond_broadcast(&g->done_cond);
  }
  pthread_mutex_unlock(&g->lock);
  ```)

(defn tg-wait [group : ptr<void>] : nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  while (!g->done)
      pthread_cond_wait(&g->done_cond, &g->lock);
  pthread_mutex_unlock(&g->lock);
  ```)

(defn tg-free [group : ptr<void>] : nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_destroy(&g->lock);
  pthread_cond_destroy(&g->done_cond);
  free(g);
  ```)

(defn main [] : int
  (let [outer (tg-new)
        inner (tg-new)]
    ;; Spawn tasks in outer group
    (tg-spawn outer)
    (tg-spawn outer)
    
    ;; Spawn tasks in inner group
    (tg-spawn inner)
    
    ;; Complete all tasks
    (tg-task-done outer)
    (tg-task-done outer)
    (tg-task-done inner)
    
    ;; Wait for both groups
    (tg-wait inner)
    (tg-wait outer)
    
    (println "nested-complete")
    
    (tg-free inner)
    (tg-free outer)
    0))
