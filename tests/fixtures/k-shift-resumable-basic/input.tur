;; Resumable delimited control -- the canonical k-reset / k-shift surface
;; (one-substrate plan).  k-shift captures the delimited continuation k and hands
;; it to the receiver, which resumes it -- the standard shift/reset semantics,
;; NOT the abortive `shift` (whose receiver instead gets the body value).
;;
;; Slice 1 aliases k-reset/k-shift onto the proven cloneable pipeline, so this
;; runs on the same substrate as cloneable-shift: the DK machine (compiled) and
;; the reified-context TuriCont capture (interpreter).  direct == cps == turi.
;;
;; `step` resumes k twice (cloneable/multi-shot): context (+ 10 []) gives
;;   (10 + 1) + (10 + 2) = 23.

(defn step [k] : int
  (+ (tur_cloneable_cont_resume (tur_cloneable_cont_clone k) 1)
     (tur_cloneable_cont_resume k 2)))

(defn main [] : int
  (println (k-reset (+ 10 (k-shift step 0))))
  ;; a second context (* 2 []): (2*1) + (2*2) = 6
  (println (k-reset (* 2 (k-shift step 0))))
  0)
