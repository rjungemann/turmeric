#lang r7rs
;; r7rs-lang-plan R1: every Scheme lexeme whose reading is visible only as a
;; Form, paired line for line with its Turmeric spelling in plain.tur.  The
;; hook runs `tur parse-check` over the two, which serialises each file's
;; forms with form_print and demands they be byte-identical.
(a . b)
(a b . c)
'(1 . 2)
`(1 ,x ,@ys)
#(1 2 3)
#u8(1 2 3)
|foo|
|a\x41;b|
#!fold-case
(HELLO World |MiXed|)
#!no-fold-case
(HELLO)
(+5 -5 .5 -.5 #x-1F #e2.0 #i3 #E#X10)
"a\x41;b\|c"
(f #t #f #true #false)
'()
#\A
(#;(dropped) kept) #| block |# (also kept)
