;; Phase HKT H0: kind system foundation — KIND_STAR is the default kind for all
;; concrete types in v1. This fixture validates that normal typeclass definitions
;; (all kind * types) compile and run correctly alongside the kind infrastructure.

(defclass MyEq [a]
  (eq? [x y] : bool))

(defclass MyNum [a]
  (add [x y] : int))

(definstance MyEq [int]
  (eq? [x y] (= x y)))

(definstance MyNum [int]
  (add [x y] (+ x y)))

(defn main [] : int
  (do
    (println (.eq? 1 1))
    (println (.eq? 1 2))
    (println (.add 3 4))
    0))
