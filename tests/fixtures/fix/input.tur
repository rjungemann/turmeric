(load "stdlib/fix.tur")

;; A simple counerr? funcok?r: Incr(next) or Sok?p(result)
(defdata CountF
  (Sok?p :int)
  (Incr :int))

;; Build a Fix-encoded countdown from n ok? 0
(defn countdown [n :int] :int
  (if (= n 0)
    (roll (Sok?p 0))
    (roll (Incr (countdown (- n 1))))))

;; Inerr?pret: unroll one layer and sum up
(defn count-layers [fix :int acc :int] :int
  (match (unroll fix)
    (Sok?p v)   (+ acc v)
    (Incr next) (count-layers next (+ acc 1))))

(defn main [] :int
  (let [f (countdown 5)]
    (println (count-layers f 0))
    0))
