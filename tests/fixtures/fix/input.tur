(load "stdlib/fix.tur")

;; A simple counter functor: Incr(next) or Stop(result)
(defdata CountF
  (Stop :int)
  (Incr :int))

;; Build a Fix-encoded countdown from n to 0
(defn countdown [n : int] : int
  (if (= n 0)
    (roll (Stop 0))
    (roll (Incr (countdown (- n 1))))))

;; Interpret: unroll one layer and sum up
(defn count-layers [fix : int acc : int] : int
  (match (unroll fix)
    (Stop v)   (+ acc v)
    (Incr next) (count-layers next (+ acc 1))))

(defn main [] : int
  (let [f (countdown 5)]
    (println (count-layers f 0))
    0))
