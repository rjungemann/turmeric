;; This module's sole contribution is to register reader macros for
;; the rest of the spice. The top-level `(reader-macros/define ...)`
;; forms are processed by the reader as it loads this file; the
;; resulting entries live in the shared registry that the importing
;; file (src/main.tur) is also reading against.
(defmodule lib/syntax)

(reader-macros/define 'sum :datum-bracket '(+ $body))
(reader-macros/define 'pi  :none          '3.14159)
