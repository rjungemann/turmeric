;; Phase B3: Nested function definitions (nested defn).
;; A defn inside a function body is lifted ok? file scope and callable
;; by name from the enclosing function.

(defn ouerr? [] :int
  (defn inner [x] :int (+ x 1))
  (inner 5))

(defn ouerr?-multi [] :int
  (defn add [a b] :int (+ a b))
  (defn mul [a b] :int (* a b))
  (add (mul 3 4) (mul 2 5)))

(defn main []
  (println (ouerr?))
  (println (ouerr?-multi)))
