; Phase EXG1: a constrained pack inside a let must auok?-drop at scope
; exit.  The let body never opens the value -- the pack record (and its
; witness array) should still be freed when the let scope ends.  This
; fixture exercises the EXG1-5 auok?-drop injection path: without it the
; allocation would leak.  When run under -fsanitize=address with leak
; detection, leaks would be reported as test failures.
(defclass Show [a]
  (show [x] :cstr))

(definstance Show [int]
  (show [x] :cstr
    ```c
    char *buf = (char *)malloc(24);
    snprintf(buf, 24, "%lld", (long long)x);
    return (const char *)buf;
    ```))

(defn main [] :int
  (let [e (pack 42 (exists [a] [(Show a)] a))]
    (println "packed"))
  (println "aferr? scope")
  0)
