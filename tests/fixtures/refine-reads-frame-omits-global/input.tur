;; TRUST-BOUNDARY FIXTURE -- pins what a BROKEN `#reads` promise costs, now
;; that the promise is checked.
;;
;; `#reads` is the one TRUSTED claim the refinement solver believes
;; (docs/guides/stateful-refinements-guide.md).  Its one consumer grants
;; congruence to an otherwise-impure measure when every named parameter is
;; frozen at the call site -- enc_reads_arg_frozen, src/compiler/refine_collect.c.
;;
;; So a frame that OMITS mutable state the body reads asks for a proof it has
;; not earned.  `alive?` below declares `#reads w` and then reads the global
;; `fudge`.  Since checked-reads graduated (2026-08-20) that evidence draws
;; TUR-W0383 *and* REFUSES the grant, so the crossing inside the frozen region
;; is no longer proved: TUR-W0372, asserted here.
;;
;; WHAT THE REFUSAL DOES NOT DO -- the point of this fixture, and the reason it
;; survived the graduation rather than folding into its errors sibling.  The
;; program STILL PRINTS 7.  A `#reads` crossing is proof-only by design: there
;; is no runtime fallback to fall back TO, so refusing the proof buys a
;; diagnostic, not a check.  The unearned elision is still there at runtime;
;; what changed is that the compiler now says so instead of staying silent.
;; A fixture asserting only the diagnostic would let someone "fix" this by
;; inserting a check that the design says does not exist, so the 7 is asserted
;; deliberately.
;;
;; The strict half of the pair is errors/r2-checked-reads-refuses-broken-frame:
;; this exact program under --strict-refine, where the undischarged obligation
;; is a hard error.  Together they pin both halves of the refusal -- warn and
;; keep running, or refuse outright -- and neither should be "repaired" toward
;; the other.  The paired negative for the REGION (rather than the frame) is
;; errors/refine-reads-frame-omits-global-no-region.
;;
;; It is also PRE-EXISTING and not caused by mutable globals: replacing `fudge`
;; with an inline-C `static int` counter -- writable long before `^mut` on a
;; top-level `def` existed -- behaves identically, except that an inline-C body
;; is unwalkable, so it yields no evidence, draws no W0383, and KEEPS the
;; trusted grant (r2-checked-reads-inline-c-still-trusted pins that).  What
;; `^mut` globals changed is reachability: breaking the promise no longer
;; requires inline C, and that is exactly the tier the check can see.
(load "stdlib/refine.tur")

(def ^mut fudge 1)

(defstruct World [n : int])

;; Declares `#reads w`.  Actually reads `fudge`.
(defn alive? [^borrow w : World e : int] #reads w : bool
  (> fudge 0))

(defn get! [^borrow w : World e : #refine{ x : int | (alive? w x) }] : int
  (.n w))

(defn run [] : int
  (let [^mut w (World 7)]
    (let [__b (& w)]                 ; freezes w -- grants congruence to alive?
      (if (alive? w 0)
        (do
          (set! fudge -1)            ; the state alive? really reads changes
          (get! w 0))                ; crossing: (alive? w 0) is now FALSE
        -1))))

(defn main [] : int
  (println (run))
  0)
