;; Phase HKT H2: Nested typeclass dispatch.
;; Two typeclasses (MyEq and MyOrd), each with instances for int.
;; Verifies that methods from distinct typeclasses dispatch independently.

(defclass MyEq [a]
  (eq? [x y] : bool))

(definstance MyEq [int]
  (eq? [x y] (= x y)))

(defclass MyOrd [a]
  (lt? [x y] : bool))

(definstance MyOrd [int]
  (lt? [x y] (< x y)))

(defn main [] : int
  (do
    (println (.eq? 1 1))
    (println (.eq? 1 2))
    (println (.lt? 3 5))
    (println (.lt? 7 2))
    0))
