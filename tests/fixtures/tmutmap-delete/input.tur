;; Phase F5: MutableMap deletion semantics.  Deletion leaves a
;; tombstone so probe chains stay intact; subsequent set! to the
;; same slot reuses the tombstone (tomb count drops, len up).

(defn main [] :int
  (let [mm (tmutmap-new)]
    (tmutmap-set! mm 1 1 100)
    (tmutmap-set! mm 2 2 200)
    (tmutmap-set! mm 3 3 300)
    (println (tmutmap-delete! mm 2 2))   ; true
    (println (tmutmap-len mm))           ; 2
    (println (tmutmap-has? mm 2 2))      ; false
    (println (tmutmap-get mm 1 1))        ; 100 (probe chain intact)
    (println (tmutmap-get mm 3 3))        ; 300
    ;; Deleting absent key returns false, leaves len unchanged
    (println (tmutmap-delete! mm 99 99)) ; false
    (println (tmutmap-len mm))           ; 2
    (tmutmap-free mm))
  0)
