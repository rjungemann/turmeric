;; Phase R6a: a let [_ ...] binding is an explicit discard and does not warn.
(defn mk [] : ptr<void>
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *r = malloc(sizeof(*r));
  r->is_ok = true; r->ok_val = 1; r->err_val = 0; return r;
  ```)
(defn main [] : int
  (let [_ (mk)]
    (println 1)
    0))
