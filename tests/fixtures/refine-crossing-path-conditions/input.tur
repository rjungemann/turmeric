;; Path conditions for call-site crossings.
;;
;; A crossing is collected during elaboration and discharged after the whole
;; unit -- which is what lets it see every callee's refinement, and is why the
;; deferral is load-bearing. The cost was that a call inside a branch was
;; checked WITHOUT the condition that selected the branch. Both of these were
;; unknown; under --strict-refine, losing either is a compile error.
;;
;; The conditions are recovered syntactically: `call_form` is a pointer into
;; the caller's body, so walking the body down to that exact node collects
;; every branch entered on the way. No condition stack is threaded through
;; expression elaboration.

(defn sdiv [n : int d : #refine{ d : int | (not= d 0) }] : int
  (/ n d))

;; The guard is what makes the argument legal, and now the compiler agrees.
(defn safe-quotient [x : int] : int
  (if (= x 0)
    0
    (sdiv 10 x)))

;; The canonical decreasing-argument recursion: `n - 1 >= 0` follows from
;; `n >= 0` (in the environment) AND `n != 0` (the branch), and only the first
;; of those was available before.
(defn countdown [n : #refine{ n : int | (>= n 0) }] : int
  (if (= n 0)
    0
    (+ 1 (countdown (- n 1)))))

(defn main [] : int
  (println (safe-quotient 5))
  (println (countdown 3))
  0)
