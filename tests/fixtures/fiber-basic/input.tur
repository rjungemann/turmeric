; T21-C: fiber-basic — create a fiber, resume it once, get return value.
;
; The fiber body yields 42 back to the caller.
; Expected output: 42

(defn fiber-body [] :int
  ```c
  tur_fiber_block_yield(42);
  return 0;
  ```)

(defn fiber-block-new [fn :ptr<void> stack-size :int] :ptr<void>
  ```c
  FiberBlock *f = tur_fiber_block_new((void(*)(void))fn, (size_t)stack_size);
  return (int64_t)(intptr_t)f;
  ```)

(defn fiber-block-resume [f :ptr<void> arg :int] :int
  ```c
  return tur_fiber_block_resume((FiberBlock *)(intptr_t)f, arg);
  ```)

(defn fiber-block-free [f :ptr<void>] :nil
  ```c
  tur_fiber_block_free((FiberBlock *)(intptr_t)f);
  ```)

(let f (fiber-block-new fiber-body 0))
(let result (fiber-block-resume f 0))
(println result)
(fiber-block-free f)
