;; Phase 1b: spaced rest-type annotation with a user-defined opaque type
;; (`& items : Route`) elaborates and enforces identity-based type checking.
;; Codegen must match the fused-form sibling fixture `variadic-types-opaque`.

(defopaque Route :int)

(defn cons-list-len [lst : int] #{Unsafe} : int
  ```c
  typedef struct { int64_t head; int64_t tail; } __tur_cons_cell;
  int64_t n = 0;
  __tur_cons_cell *p = (__tur_cons_cell *)(intptr_t)lst;
  while (p) { n++; p = (__tur_cons_cell *)(intptr_t)p->tail; }
  return (int)n;
  ```)

(defn mk-route [tag : int] : Route tag)

(defn count-routes [& items : Route] #{Unsafe} : int
  (cons-list-len items))

(defn main [] : int
  (unsafe
    (let [n (count-routes (mk-route 1) (mk-route 2) (mk-route 3))]
      (if (= n 3) 0 1))))
