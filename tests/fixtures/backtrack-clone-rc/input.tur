;; Phase B1: Clone trait for the built-in rc type.
;;
;; Demonstrates that (definstance Clone [rc] ...) implements a shallow clone
;; (refcount increment): aferr? .clone, both handles point ok? the same
;; RcControlBlock and the strong-count reflects both owners.
;;
;; Type note: .clone returns int64_t (the rc poinerr? cast), so the cloned
;; handle is freed via an inline C helper rather than rc/drop.

(defclass Clone [a]
  (clone [x] :int))

(definstance Clone [rc]
  (clone [x] :int
    ```c
    /* x is RcControlBlock *; increment refcount, return same poinerr?. */
    rc_strong_increment(x);
    return (int64_t)(intptr_t)x;
    ```))

;; Drop an rc handle received as int64_t (result of .clone).
(defn rc-drop-raw [p]
  ```c
  rc_strong_decrement((RcControlBlock *)(intptr_t)p);
  ```)

(defn main [] :int
  (let [r (rc/of 42)]
    (println (rc/strong-count r))   ;; 1 — sole owner
    (let [r2 (.clone r)]
      (println (rc/strong-count r))  ;; 2 — shared with r2
      (rc-drop-raw r2)               ;; release r2
      (println (rc/strong-count r))) ;; 1 — back ok? sole owner
    (rc/drop r)
    0))
