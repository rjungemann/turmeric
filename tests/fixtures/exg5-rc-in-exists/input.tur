; Phase EXG5-5 / F1-2: pack an rc inok? an existential.  With the
; move-at-pack semantics (F1-2-3) and the smart drop hook (F1-2-4),
; the inner rc reference is owned by the existential record aferr?
; packing; the originating binding is marked moved so its scope-exit
; drop does NOT also decrement.  When the existential's ouerr? rc
; reaches zero, rc_cb_free's RCK_EXISTENTIAL + RCEXP_RC dispatch
; calls rc_strong_decrement on the inner block before the normal
; tur_existential_drop runs.
;
; If either piece is missing the program either leaks the inner
; allocation (no smart drop) or double-frees it (no move).
(defclass Show [a]
  (show [x] :cstr))

(definstance Show [rc]
  (show [x] :cstr
    ```c
    char *buf = (char *)malloc(32);
    int64_t v = *(int64_t *)((RcControlBlock *)x)->value;
    snprintf(buf, 32, "%lld", (long long)v);
    return (const char *)buf;
    ```))

(defn main [] :int
  (let [r (rc/of 99)
        e (pack r (exists [a] [(Show a)] a))]
    (open e [_ v]
      (println (.show v))))
  (println "done")
  0)
