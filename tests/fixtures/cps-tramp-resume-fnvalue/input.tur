;; E2 (cps-tramp-resume): an effect performed inside an INDIRECTLY-called
;; effectful fn-value must reach the caller's DK handler -- the fn-value's __cps
;; entry is threaded the continuation via the direct->cps registry, instead of the
;; callback running under its own root prompt (`unhandled effect`). Covers a named
;; effectful fn AND a lambda, passed both through a separate HOF and to a handler-
;; installer that invokes it inside its own handle.
(defeffect Ask [] :int)

(defn perf [] : int (perform (Ask)))
(defn call-it [f : (fn [] #fx{Ask} int)] : int (f))
(defn run-sep [] : int
  (handle (call-it perf) (Ask [] k) (resume k 5)))
(defn run-with [f : (fn [] #fx{Ask} int)] : int
  (handle (f) (Ask [] k) (resume k 7)))

(defn main [] : int
  (println (run-sep))                    ;; 5  -- fn-value through a separate HOF
  (println (run-with perf))              ;; 7  -- named fn into a handler-installer
  (println (run-with (fn [] (perform (Ask)))))  ;; 7 -- lambda into a handler-installer
  0)
