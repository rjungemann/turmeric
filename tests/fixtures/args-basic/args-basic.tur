;; args-basic -- test flag and space-separated option parsing.
;; run.args: --verbose --input hello

(load "stdlib/args.tur")

(defn print-cstr [s : cstr] : void
  ```c
  printf("%s\n", s ? s : "");
  ```)

(defn print-bool [b : bool] : void
  ```c
  printf("%s\n", b ? "true" : "false");
  ```)

(let [spec (args/spec-new)]
  (args/spec-flag   spec "--verbose")
  (args/spec-option spec "--input" "string" (none))
  (let [res (args/parse spec *args*)]
    (print-cstr (args/get-str res "input"))
    (print-bool (args/get-bool res "verbose"))
    (args/result-free res))
  (args/spec-free spec))
