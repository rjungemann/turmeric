;;
;; Phase P2: Lisp bindings Eq instance test

(import stdlib/hamt.tur)

(extern-c malloc [^int size] :ptr<void>)
(extern-c free [^ptr<void> p] :void)

(defn alloc-key [x]
  (let [p (malloc 8)]
    (ptr-set! (cast p :ptr<int>) 0 x)
    p))

;; Test: equal maps
(defn test-eq-same [] :int
  (let [k1 (alloc-key 1)]
    (let [v1 (alloc-key 100)]
      (let [m1 (hamt/new)]
        (let [m2 (hamt/set m1 (hamt_hash_ptr k1) k1 v1)]
          (let [m3 (hamt/new)]
            (let [m4 (hamt/set m3 (hamt_hash_ptr k1) k1 v1)]
              (let [equal (eq? m2 m4)]
                (hamt/free m1)
                (hamt/free m2)
                (hamt/free m3)
                (hamt/free m4)
                (free k1)
                (free v1)
                (if equal 1 0)))))))))

;; Test: unequal maps (different keys)
(defn test-eq-different-keys [] :int
  (let [k1 (alloc-key 1)]
    (let [k2 (alloc-key 2)]
      (let [v1 (alloc-key 100)]
        (let [m1 (hamt/new)]
          (let [m2 (hamt/set m1 (hamt_hash_ptr k1) k1 v1)]
            (let [m3 (hamt/new)]
              (let [m4 (hamt/set m3 (hamt_hash_ptr k2) k2 v1)]
                (let [equal (eq? m2 m4)]
                  (hamt/free m1)
                  (hamt/free m2)
                  (hamt/free m3)
                  (hamt/free m4)
                  (free k1)
                  (free k2)
                  (free v1)
                  (if equal 0 1))))))))))

;; Test: unequal maps (different values)
(defn test-eq-different-values [] :int
  (let [k1 (alloc-key 1)]
    (let [v1 (alloc-key 100)]
      (let [v2 (alloc-key 200)]
        (let [m1 (hamt/new)]
          (let [m2 (hamt/set m1 (hamt_hash_ptr k1) k1 v1)]
            (let [m3 (hamt/new)]
              (let [m4 (hamt/set m3 (hamt_hash_ptr k1) k1 v2)]
                (let [equal (eq? m2 m4)]
                  (hamt/free m1)
                  (hamt/free m2)
                  (hamt/free m3)
                  (hamt/free m4)
                  (free k1)
                  (free v1)
                  (free v2)
                  (if equal 0 1))))))))))
