;;; tests/r7rs/srfi/4/tests.scm -- SRFI 4's tests: contrib/cowan/srfi/4/
;;; shared-tests.scm from the SRFI's repository (MIT, as the SRFI), as
;;; top-level forms for tests/r7rs/run-conformance.py (r7rs-srfi-plan D7).
;;; Its `test` procedure ran the same checks for each of the ten types; here
;;; each call is written out, its (is-same? result expected) checks are
;;; (test-assert (same? result expected)), and its vec0..vec3 are top-level
;;; defines named for the type.  The last group is Turmeric's: element range
;;; checks, the type checks, and u8vector being the bytevector.

(test-begin "srfi-4: homogeneous numeric vectors")

;; Test for sameness

(define relerr (expt 2 -24))
(define (same? result expected)
  (cond
    ((and (number? result) (number? expected) (inexact? result) (inexact? expected))
     (let ((abserr (abs (* expected relerr))))
       (<= (- expected abserr) result (+ expected abserr))))
    ((and (number? result) (number? expected))
     (= result expected))
    ((and (pair? result) (pair? expected))
     (list-same? result expected))
    (else
      (equal? result expected))))

(define (list-same? result expected)
  (cond
    ((and (null? result) (null? expected))
     #t)
    ((and (pair? result) (pair? expected))
     (and (same? (car result) (car expected)) (list-same? (cdr result) (cdr expected))))
    (else
     #f)))


;; STARTING u8vector TESTS
(define u8-vec0 (make-u8vector 3))
(define u8-vec1 (make-u8vector 3 3))
(define u8-vec2 (u8vector 1 2 3))
(define u8-vec3 (list->u8vector '(3 2 1)))
(test-assert (same? (u8vector? u8-vec0) #t))
(test-assert (same? (u8vector? u8-vec1) #t))
(test-assert (same? (u8vector? u8-vec2) #t))
