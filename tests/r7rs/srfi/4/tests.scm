;; ---- Turmeric: range and type checks ----

(test-error (s8vector 128))
(test-error (s8vector -129))
(test-error (u8vector 256))
(test-error (u16vector -1))
(test-error (u16vector 65536))
(test-error (s16vector 32768))
(test-error (u32vector 4294967296))
(test-error (s32vector -2147483649))
(test-error (u64vector 18446744073709551616))
(test-error (s64vector 9223372036854775808))
(test-error (s64vector -9223372036854775809))
(test-error (s16vector 1.5))
(test-error (f64vector 'x))
(test-error (make-u16vector 2 -1))
(test-error (list->u32vector '(1 -1)))
(test-error (s16vector-set! (s16vector 1) 0 40000))
(test-error (s16vector-ref (s16vector 1) 1))
(test-error (s16vector-length (u16vector 1)))
(test-error (u8vector-length (s8vector 1)))
(test #t (inexact? (f32vector-ref (f32vector 1) 0)))
(test #t (inexact? (f64vector-ref (make-f64vector 1 7) 0)))
(test 2.5 (f64vector-ref (f64vector 2.5) 0))

;; ---- Turmeric: disjoint types; u8vector is the bytevector ----

(test '(#t #f #f #f) (map (lambda (p) (p (s8vector)))
                          (list s8vector? u8vector? s16vector? vector?)))
(test '(#f #t #f) (map (lambda (p) (p (u16vector)))
                       (list f32vector? u16vector? f64vector?)))
(test #t (u8vector? (bytevector 1 2)))
(test #t (bytevector? (u8vector 1 2)))
(test #t (equal? (u8vector 1 2) (bytevector 1 2)))
(test 0 (s8vector-length (s8vector)))
(test '() (u64vector->list (make-u64vector 0)))
(test '(0 0) (s32vector->list (make-s32vector 2 0)))

(test-end)
