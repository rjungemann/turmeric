  true)

;; ============================================================
;; Main Test Runner
;; ============================================================

(defn run-all-tests []
  (let [tests [
    ["message pool creation" test-message-pool-creation]
    ["message pool alloc" test-message-pool-alloc]
    ["message pool free" test-message-pool-free]
    ["message pool reuse" test-message-pool-reuse]
    ["inline synth set" test-inline-synth-set]
    ["inline osc send" test-inline-osc-send]
    ["batch send" test-batch-send]
    ["bundle send" test-bundle-send]
    ["measure latency" test-measure-latency]
    ["measure throughput" test-measure-throughput]
    ["message leak detection" test-message-leak-detection]
    ["no leak with macro" test-no-leak-with-macro]
    ["benchmark osc send" benchmark-osc-send]
    ["benchmark message construction" benchmark-message-construction]
    ["compare with baseline" test-compare-with-baseline]
    ["overhead measurement" test-overhead-measurement]
  ]]
    (doseq [[name test-fn] tests]
      (print (str "Testing: " name " ... "))
      (try
        (let [result (test-fn)]
          (if result
            (println " PASS")
            (println " FAIL")))
        (catch e
          (println (str " ERROR: " (error->string e))))))
    (println "\nPerformance tests complete.")))

;; Run tests if executed directly
(when (== (get *argv* 0) "run")
  (run-all-tests))
