;;
;; SCSCM Performance Tests
;; Phase H tests from scscm-hcsynth-livecoding-plan.md
;;

(import scscm/types scscm/ffi scscm/msg scscm/perf)

;; ============================================================
;; Message Pooling Tests
;; ============================================================

(defn test-message-pool-creation []
  (let [pool (make-osc-message-pool 10)]
    (assert (== (len (:messages pool)) 10) "Pool should have 10 messages")
    true))

(defn test-message-pool-alloc []
  (let [pool (make-osc-message-pool 10)]
    (let [msg (pool-alloc pool)]
      (assert (some? msg) "Should allocate a message")
      true)))

(defn test-message-pool-free []
  (let [pool (make-osc-message-pool 10)]
    (let [msg (pool-alloc pool)]
      (let [pool2 (pool-free pool msg)]
        (assert (== (len (:available pool2)) 1) "Should have 1 available message")
        true)))))

(defn test-message-pool-reuse []
  (let [pool (make-osc-message-pool 10)]
    (let [msg1 (pool-alloc pool)]
      (let [pool2 (pool-free pool msg1)]
        (let [msg2 (pool-alloc pool2)]
          (assert (some? msg2) "Should reuse freed message")
          true))))))

