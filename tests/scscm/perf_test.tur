;; ============================================================
;; Batch Sending Tests
;; ============================================================

(defn test-batch-send []
  ;; Test batch message sending
  (let [messages [
    (osc-message "/ping")
    (osc-message "/ping")
    (osc-message "/ping")
  ]]
    (doseq [msg messages]
      (hc_osc_free_message msg))
    true))

(defn test-bundle-send []
  ;; Test bundle sending
  true)

;; ============================================================
;; Performance Measurement Tests
;; ============================================================

(defn test-measure-latency []
  ;; Test latency measurement for single message
  (let [start (now)]
    (osc-send "/ping")
    (let [elapsed (- (now) start)]
      (println (str "Single message latency: " elapsed " seconds"))
      true)))

(defn test-measure-throughput []
  ;; Test throughput measurement
  (let [count 100]
    (let [start (now)]
      (dotimes [i count]
        (osc-send "/ping"))
      (let [elapsed (- (now) start)]
        (let [per-msg (/ elapsed count)]
          (println (str "Throughput: " (/ 1.0 per-msg) " msg/sec"))
          true))))))

;; ============================================================
;; Memory Leak Tests
;; ============================================================

(defn test-message-leak-detection []
  ;; Test for message memory leaks
  (dotimes [i 1000]
    (let [msg (osc-message "/test")]
      (hc_osc_free_message msg)))
  true)

(defn test-no-leak-with-macro []
  ;; Test that with-osc-message macro doesn't leak
  (dotimes [i 1000]
    (with-osc-message [msg "/test"]
      (osc-add! msg 1)
      (osc-add! msg 2)))
  true)

;; ============================================================
;; Benchmark Functions
;; ============================================================

(defn benchmark-osc-send []
  ;; Benchmark OSC send performance
  (let [iterations 10000]
    (let [start (now)]
      (dotimes [i iterations]
        (osc-send "/ping"))
      (let [elapsed (- (now) start)]
        (let [per-msg (/ elapsed iterations)]
          (println (str "OSC send: " (/ 1.0 per-msg) " msg/sec over " iterations " messages"))
          true))))))

(defn benchmark-message-construction []
  ;; Benchmark message construction
  (let [iterations 10000]
    (let [start (now)]
      (dotimes [i iterations]
        (with-osc-message [msg "/test"]
          (osc-add! msg 1)
          (osc-add! msg 2.0)
          (osc-add! msg "hello")))
      (let [elapsed (- (now) start)]
        (let [per-msg (/ elapsed iterations)]
          (println (str "Message construction: " (/ 1.0 per-msg) " msg/sec"))
          true))))))

