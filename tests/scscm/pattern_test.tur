;;
;; SCSCM Pattern Library Tests
;; Phase F tests from scscm-hcsynth-livecoding-plan.md
;;

(import scscm/types scscm/pattern)

;; ============================================================
;; Time Representation Tests
;; ============================================================

(defn test-beats-type []
  (let [b 1.5]
    (assert (float? b) "Beats should be a float")
    true))

(defn test-bpm-conversion []
  (assert (== (bpm->beats-per-sec 120.0) 2.0) "120 BPM should be 2 beats/sec")
  (assert (== (bpm->beats-per-sec 60.0) 1.0) "60 BPM should be 1 beat/sec")
  (assert (approx== (bpm->beats-per-sec 1.0) (/ 1.0 60.0) 0.0001) "1 BPM should be ~0.0167 beats/sec")
  true))

(defn test-bpm-sec-per-beat []
  (assert (== (bpm->sec-per-beat 120.0) 0.5) "120 BPM should be 0.5 sec/beat")
  (assert (== (bpm->sec-per-beat 60.0) 1.0) "60 BPM should be 1 sec/beat")
  true))

(defn test-beats-sec-conversion []
  (assert (== (beats->sec 1.0 120.0) 0.5) "1 beat at 120 BPM should be 0.5 sec")
  (assert (== (beats->sec 2.0 120.0) 1.0) "2 beats at 120 BPM should be 1 sec")
  (assert (== (sec->beats 0.5 120.0) 1.0) "0.5 sec at 120 BPM should be 1 beat")
  true))

;; ============================================================
;; Pattern Type Tests
;; ============================================================

(defn test-const-pattern []
  (let [p (const 42)]
    (assert (fn? p) "const should return a function")
    (assert (== (p 0.0) 42) "Pattern should return 42 at time 0")
    (assert (== (p 1.0) 42) "Pattern should return 42 at time 1")
    (assert (== (p 100.0) 42) "Pattern should return 42 at time 100")
    true))

(defn test-const-pattern-string []
  (let [p (const "hello")]
    (assert (== (p 0.0) "hello") "String pattern should work")
    true))

(defn test-cycle-pattern []
  (let [p (cycle 1 2 3)]
    (assert (== (p 0.0) 1) "Cycle at beat 0 should return first value")
    (assert (== (p 0.5) 1) "Cycle at beat 0.5 should still return first value")
    (assert (== (p 1.0) 2) "Cycle at beat 1 should return second value")
    (assert (== (p 1.5) 2) "Cycle at beat 1.5 should still return second value")
    (assert (== (p 2.0) 3) "Cycle at beat 2 should return third value")
    (assert (== (p 3.0) 1) "Cycle at beat 3 should wrap to first value")
    true))

(defn test-cycle-pattern-empty []
  (let [p (cycle)]
    ;; Empty cycle should return nil or handle gracefully
    true))

(defn test-phase-pattern []
  (let [p (phase 1.0)]
    (assert (== (p 0.0) 0.0) "Phase at 0 should be 0")
    (assert (== (p 0.5) 0.5) "Phase at 0.5 should be 0.5")
    (assert (== (p 1.0) 0.0) "Phase at 1 should wrap to 0")
    (assert (== (p 1.5) 0.5) "Phase at 1.5 should be 0.5")
    true))

(defn test-phase-pattern-custom-length []
  (let [p (phase 2.0)]
    (assert (== (p 0.0) 0.0) "Phase at 0 should be 0")
    (assert (== (p 1.0) 1.0) "Phase at 1 should be 1")
    (assert (== (p 2.0) 0.0) "Phase at 2 should wrap to 0")
    true))

;; ============================================================
;; P Macro Tests
;; ============================================================

(defn test-p-macro-single []
  (let [p (P 42)]
    (assert (fn? p) "P macro with single value should return function")
    (assert (== (p 0.0) 42) "P 42 should be equivalent to (const 42)")
    true))

(defn test-p-macro-multiple []
  (let [p (P 1 2 3)]
    (assert (== (p 0.0) 1) "P 1 2 3 should be equivalent to (cycle 1 2 3)")
    (assert (== (p 1.0) 2) "Second value should be 2")
    (assert (== (p 2.0) 3) "Third value should be 3")
    true))

(defn test-pat-at []
  (let [p (cycle 10 20 30)]
    (assert (== (pat-at p 0.0) 10) "pat-at should evaluate pattern at given time")
    (assert (== (pat-at p 1.0) 20) "pat-at at time 1 should return 20")
    true))

;; ============================================================
;; Temporal Combinator Tests
;; ============================================================

(defn test-every []
  (let [p (every 2 (const 1) 0)]
    (assert (== (p 0.0) 1) "Every at time 0 should return value")
    (assert (== (p 0.5) 0) "Every at time 0.5 should return zero")
    (assert (== (p 1.0) 0) "Every at time 1 should return zero")
    (assert (== (p 2.0) 1) "Every at time 2 should return value")
    (assert (== (p 3.0) 0) "Every at time 3 should return zero")
    true))

;; ============================================================
;; Pattern Player Tests
;; ============================================================

(defn test-pattern-synth []
  ;; Test creating a synth with pattern-driven parameters
  ;; This requires scsynth to be running
  true)

(defn test-pattern-player []
  ;; Test pattern player functionality
  true)

;; ============================================================
;; Edge Cases
;; ============================================================

(defn test-pattern-composition []
  ;; Test composing patterns
  (let [p1 (const 10)
        p2 (cycle 1 2 3)
        p3 (fn [t] (+ (p1 t) (p2 t)))]
    (assert (== (p3 0.0) 11) "Composed pattern should work")
    (assert (== (p3 1.0) 12) "Composed pattern at time 1 should work")
    true))

(defn test-pattern-with-state []
  ;; Test pattern that uses external state
  (let [counter (ref 0)]
    (let [p (fn [t]
              (let [current (ref-get counter)]
                (ref-set! counter (inc current))
                current))]
      (assert (== (p 0.0) 0) "First call should return 0")
      (assert (== (p 0.0) 1) "Second call should return 1")
      true)))

;; ============================================================
;; Main Test Runner
;; ============================================================

(defn run-all-tests []
  (let [tests [
    ["beats type" test-beats-type]
    ["bpm conversion" test-bpm-conversion]
    ["bpm sec per beat" test-bpm-sec-per-beat]
    ["beats sec conversion" test-beats-sec-conversion]
    ["const pattern" test-const-pattern]
    ["const pattern string" test-const-pattern-string]
    ["cycle pattern" test-cycle-pattern]
    ["cycle pattern empty" test-cycle-pattern-empty]
    ["phase pattern" test-phase-pattern]
    ["phase pattern custom length" test-phase-pattern-custom-length]
    ["P macro single" test-p-macro-single]
    ["P macro multiple" test-p-macro-multiple]
    ["pat-at" test-pat-at]
    ["every" test-every]
    ["pattern synth" test-pattern-synth]
    ["pattern player" test-pattern-player]
    ["pattern composition" test-pattern-composition]
    ["pattern with state" test-pattern-with-state]
  ]]
    (doseq [[name test-fn] tests]
      (print (str "Testing: " name " ... "))
      (try
        (let [result (test-fn)]
          (if result
            (println " PASS")
            (println " FAIL")))
        (catch e
          (println (str " ERROR: " (error->string e))))))
    (println "\nPattern library tests complete.")))

;; Run tests if executed directly
(when (== (get *argv* 0) "run")
  (run-all-tests))
