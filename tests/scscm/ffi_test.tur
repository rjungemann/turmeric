;; tests/scscm/ffi_test.tur — FFI Tests
;;
;; Tests for the FFI bindings to hcsynth C API.
;;
;; Note: These tests require hcsynth to be linked and available.

(import scscm/ffi :ffi)
(import scscm/types :types)

;; Test world creation and destruction
(defn test-world-lifecycle []
  (let [world_id (ffi/hc_wasm_world_create 48000 512)]
    (assert (not (== world_id 0)) "World creation should succeed")
    
    (let [sample_rate (ffi/hc_wasm_world_sample_rate world_id)]
      (assert (== sample_rate 48000) "Sample rate should be 48000"))
    
    (let [block_size (ffi/hc_wasm_world_block_size world_id)]
      (assert (== block_size 512) "Block size should be 512"))
    
    (let [result (ffi/hc_wasm_world_destroy world_id)]
      (assert (== result 0) "World destruction should succeed"))
    
    true))

;; Test UGen listing
(defn test-list-ugens []
  (let [world_id (ffi/hc_wasm_world_create 48000 512)]
    (defer (ffi/hc_wasm_world_destroy world_id))
    
    (let [buffer (malloc 8192)]
      (defer (free buffer))
      (let [result (ffi/hc_wasm_list_ugens buffer 8192)]
        (assert (>= result 0) "UGen listing should succeed")
        true))))

;; Test world status
(defn test-world-status []
  (let [world_id (ffi/hc_wasm_world_create 48000 512)]
    (defer (ffi/hc_wasm_world_destroy world_id))
    
    (let [buffer (malloc 1024)]
      (defer (free buffer))
      (let [result (ffi/hc_wasm_get_status world_id buffer 1024)]
        (assert (>= result 0) "Status retrieval should succeed")
        true))))

;; Test synth lifecycle (requires SynthDef to be loaded)
;; This test will fail if "sin" SynthDef is not loaded
(defn test-synth-lifecycle []
  (let [world_id (ffi/hc_wasm_world_create 48000 512)]
    (defer (ffi/hc_wasm_world_destroy world_id))
    
    ;; Note: In a real test, we would load a SynthDef first
    ;; For now, we just test that the functions exist and have correct signatures
    
    ;; Test synth-new returns an error (0) since no SynthDef is loaded
    (let [result (ffi/hc_wasm_synth_new world_id "nonexistent" 1000 ffi/ADD_TO_TAIL 1)]
      ;; Result will be -1 since SynthDef doesn't exist
      (assert (or (== result 0) (== result -1)) "synth_new should return 0 or -1")
      true)))

;; Test node ID allocator
(defn test-node-id-allocator []
  (let [allocator (types/node-id-allocator-new 1000)]
    (let [id1 (types/node-id-alloc allocator)]
      (assert (== id1 1000) "First ID should be 1000")
      
      (let [id2 (types/node-id-alloc allocator)]
        (assert (== id2 1001) "Second ID should be 1001")
        
        (let [id3 (types/node-id-alloc allocator)]
          (assert (== id3 1002) "Third ID should be 1002")
          true)))))

;; Run all tests
(defn run-all-tests []
  (println "Running FFI tests...")
  
  (println "  test-world-lifecycle..." (test-world-lifecycle))
  (println "  test-list-ugens..." (test-list-ugens))
  (println "  test-world-status..." (test-world-status))
  (println "  test-synth-lifecycle..." (test-synth-lifecycle))
  (println "  test-node-id-allocator..." (test-node-id-allocator))
  
  (println "All FFI tests completed"))

(run-all-tests)
