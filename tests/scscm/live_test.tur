;;
;; SCSCM Live-Coding Integration Tests
;; Phase E tests from scscm-hcsynth-livecoding-plan.md
;;

(import scscm/types scscm/ffi scscm/msg scscm/synth scscm/live)

;; ============================================================
;; Session Management Tests
;; ============================================================

(defn test-session-creation []
  ;; Test creating a live-coding session
  (let [session (scscm-connect "127.0.0.1" 57110)]
    (assert (== (:server-addr session) "127.0.0.1") "Server address should match")
    (assert (== (:server-port session) 57110) "Server port should match")
    (assert (== (:next-node-id session) 1000) "Next node-id should start at 1000")
    (assert (== (len (:synth-defs session)) 0) "Should start with empty synth-defs")
    (assert (== (len (:active-synths session)) 0) "Should start with empty active-synths")
    true))

(defn test-session-default []
  ;; Test default session creation
  (let [session (scscm-connect)]
    (assert (== (:server-addr session) "127.0.0.1") "Default address should be 127.0.0.1")
    (assert (== (:server-port session) 57110) "Default port should be 57110")
    true))

;; ============================================================
;; Node ID Management Tests
;; ============================================================

(defn test-alloc-node-id []
  ;; Test allocating node IDs
  (let [session (scscm-connect)]
    (let [id1 (alloc-node-id session)]
      (assert (== id1 1000) "First node-id should be 1000")
      (let [session2 (alloc-node-id session)]
        (assert (== (:next-node-id session2) 1002) "Next node-id should increment to 1002")
        true)))))

(defn test-custom-start-node-id []
  ;; Test session with custom starting node-id
  (let [session (update (scscm-connect) :next-node-id (const 5000))]
    (let [id1 (alloc-node-id session)]
      (assert (== id1 5000) "First node-id should be 5000")
      true)))

;; ============================================================
;; Synth Replacement Tests
;; ============================================================

(defn test-synth-replace []
  ;; Test replacing a synth
  ;; This requires scsynth running with 'sine' and 'saw' SynthDefs
  (let [session (scscm-connect)]
    (let [old-node (synth-new "sine" :freq 440.0 :amp 0.5)]
      (let [new-node (synth-replace session old-node "saw" :freq 880.0 :amp 0.25)]
        (assert (> new-node 0) "New node should have valid id")
        ;; The old node should be freed
        true)))))

(defn test-synth-replace-preserve-params []
  ;; Test replacing synth while preserving some parameters
  (let [session (scscm-connect)]
    (let [old-node (synth-new "sine" :freq 440.0 :amp 0.5 :pan 0.0)]
      (let [new-node (synth-replace session old-node "sine" :freq 660.0 :amp 0.3 :pan 0.5)]
        (assert (> new-node 0) "New node should have valid id")
        true)))))

;; ============================================================
;; Play Note Tests
;; ============================================================

(defn test-play-note []
  ;; Test playing a note
  (let [session (scscm-connect)]
    (let [synth (play-note session "sine" 60 100 1.0)]
      (assert (> synth 0) "play-note should return valid synth id")
      true)))

(defn test-midi-to-hz []
  ;; Test MIDI note to Hz conversion
  (assert (approx== (midi->hz 69) 440.0 0.001) "MIDI 69 should be 440 Hz")
  (assert (approx== (midi->hz 60) 261.626 0.01) "MIDI 60 should be ~261.63 Hz")
  (assert (approx== (midi->hz 0) 8.176 0.01) "MIDI 0 should be ~8.18 Hz")
  (assert (approx== (midi->hz 127) 12543.85 0.01) "MIDI 127 should be ~12543.85 Hz")
  true))

(defn test-vel-to-amp []
  ;; Test velocity to amplitude conversion
  (assert (== (vel->amp 127) 1.0) "Velocity 127 should be amplitude 1.0")
  (assert (== (vel->amp 0) 0.0) "Velocity 0 should be amplitude 0.0")
  (assert (== (vel->amp 64) 0.5079) "Velocity 64 should be ~0.508")
  true))

;; ============================================================
;; Deferred Execution Tests
;; ============================================================

(defn test-defer-after []
  ;; Test deferred execution
  ;; Note: This is a basic test - actual timing depends on implementation
  (let [executed? (ref false)]
    (defer-after 44100 (fn [] (ref-set! executed? true)))
    ;; Can't easily test timing in a unit test without sleeping
    true))

;; ============================================================
;; Session State Tests
;; ============================================================

(defn test-session-add-synth []
  ;; Test adding synth to session tracking
  (let [session (scscm-connect)]
    (let [synth-id (synth-new "sine" :freq 440.0)]
      (let [session2 (session-add-synth session synth-id "sine" {:freq 440.0 :amp 0.5})]
        (assert (== (len (:active-synths session2)) 1) "Should have 1 active synth")
        (assert (contains? (:active-synths session2) synth-id) "Should contain the synth id")
        true)))))

(defn test-session-remove-synth []
  ;; Test removing synth from session tracking
  (let [session (scscm-connect)]
    (let [synth-id (synth-new "sine" :freq 440.0)]
      (let [session2 (session-add-synth session synth-id "sine" {})]
        (let [session3 (session-remove-synth session2 synth-id)]
          (assert (== (len (:active-synths session3)) 0) "Should have 0 active synths after removal")
          true))))))

;; ============================================================
;; Connection Monitoring Tests
;; ============================================================

(defn test-check-connection []
  ;; Test connection checking
  (let [session (scscm-connect)]
    (let [connected? (check-connection session)]
      ;; This will return true if scsynth is running and responding to pings
      true)))

;; ============================================================
;; Synth Def Management Tests
;; ============================================================

(defn test-register-synthdef []
  ;; Test registering a SynthDef specification
  (let [session (scscm-connect)]
    (let [params [
      (make-param-spec "freq" 440.0 20.0 20000.0 "Hz" :exp)
      (make-param-spec "amp" 0.5 0.0 1.0 "" :linear)
    ]]
      (let [spec (make-synthdef-spec "test-synth" params)]
        (let [session2 (register-synthdef session spec)]
          (assert (contains? (:synth-defs session2) "test-synth") "Should contain registered synthdef")
          true))))))

;; ============================================================
;; Main Test Runner
;; ============================================================

(defn run-all-tests []
  (let [tests [
    ["session creation" test-session-creation]
    ["session default" test-session-default]
    ["alloc node-id" test-alloc-node-id]
    ["custom start node-id" test-custom-start-node-id]
    ["synth replace" test-synth-replace]
    ["synth replace preserve params" test-synth-replace-preserve-params]
    ["play note" test-play-note]
    ["midi to hz" test-midi-to-hz]
    ["vel to amp" test-vel-to-amp]
    ["defer after" test-defer-after]
    ["session add synth" test-session-add-synth]
    ["session remove synth" test-session-remove-synth]
    ["check connection" test-check-connection]
    ["register synthdef" test-register-synthdef]
  ]]
    (doseq [[name test-fn] tests]
      (print (str "Testing: " name " ... "))
      (let [result (test-fn)]
        (if result
          (println " PASS")
          (println " FAIL"))))
    (println "\nLive-coding integration tests complete.")))

;; Run tests if executed directly
(when (== (get *argv* 0) "run")
  (run-all-tests))
