;;
;; SCSCM Message Builder Tests
;; Phase B tests from scscm-hcsynth-livecoding-plan.md
;;

(import scscm/types scscm/msg scscm/ffi)

;; ============================================================
;; Basic Message Construction Tests
;; ============================================================

(defn test-osc-message-creation []
  (let [msg (osc-message "/test")]
    (assert (not (null? msg)) "Message creation should succeed")
    (hc_osc_free_message msg)
    true))

(defn test-osc-message-with-args []
  (let [msg (osc-message "/test")]
    (defer (hc_osc_free_message msg))
    (osc-add! msg 42)
    (osc-add! msg 3.14)
    (osc-add! msg "hello")
    true))

(defn test-osc-send-simple []
  ;; This test sends a simple /ping message
  ;; Requires scsynth to be running on localhost:57110
  (let [result (osc-send "/ping")]
    (assert (== result 0) "Ping message should send successfully")
    true))

(defn test-with-osc-message-macro []
  ;; Test the scoped message building macro
  (with-osc-message [msg "/test"]
    (osc-add! msg 1)
    (osc-add! msg 2)
    (osc-add! msg 3)
    (assert (not (null? msg)) "Message should be valid within scope")
    0)
  true)

;; ============================================================
;; Message Argument Tests
;; ============================================================

(defn test-add-int32 []
  (with-osc-message [msg "/int"]
    (let [result (osc-add! msg 12345)]
      (assert (== result 0) "Adding int32 should succeed")
      true)))

(defn test-add-float []
  (with-osc-message [msg "/float"]
    (let [result (osc-add! msg 3.14159)]
      (assert (== result 0) "Adding float should succeed")
      true)))

(defn test-add-string []
  (with-osc-message [msg "/string"]
    (let [result (osc-add! msg "hello world")]
      (assert (== result 0) "Adding string should succeed")
      true)))

(defn test-add-multiple-types []
  (with-osc-message [msg "/mixed"]
    (osc-add! msg 42)
    (osc-add! msg 2.718)
    (osc-add! msg "test")
    (osc-add! msg 100)
    true))

;; ============================================================
;; scsynth-Specific Message Tests
;; ============================================================

(defn test-synth-new-message []
  ;; Test constructing a /s_new message
  (with-osc-message [msg "/s_new"]
    (osc-add! msg "sine")  ;; synth def name
    (osc-add! msg 1000)    ;; node id (0 = auto)
    (osc-add! msg 0)       ;; add action (0 = add to tail)
    (osc-add! msg "freq")  ;; first arg name
    (osc-add! msg 440.0)   ;; first arg value
    true))

(defn test-n-set-message []
  ;; Test constructing a /n_set message
  (with-osc-message [msg "/n_set"]
    (osc-add! msg 1000)    ;; node id
    (osc-add! msg "freq")  ;; param name
    (osc-add! msg 880.0)   ;; param value
    true))

(defn test-n-free-message []
  ;; Test constructing a /n_free message
  (with-osc-message [msg "/n_free"]
    (osc-add! msg 1000)    ;; node id
    true))

(defn test-group-new-message []
  ;; Test constructing a /g_new message
  (with-osc-message [msg "/g_new"]
    (osc-add! msg 0)       ;; node id (0 = auto)
    (osc-add! msg 0)       ;; add action
    true))

;; ============================================================
;; Batch/Bundle Message Tests
;; ============================================================

(defn test-batch-messages []
  ;; Test sending multiple messages
  (osc-send "/ping")
  (osc-send "/ping")
  (osc-send "/ping")
  true)

(defn test-bundle-construction []
  ;; Test bundle construction (if available)
  (with-osc-message [msg "/test"]
    (osc-add! msg 1)
    true))

;; ============================================================
;; Error Handling Tests
;; ============================================================

(defn test-invalid-message []
  ;; Test handling of NULL message
  (let [msg null]
    (assert (null? msg) "Null message should be handled")
    true))

(defn test-unsupported-type []
  (let [panicked (catch-unwind
                    (fn [] (with-osc-message [msg "/test"]
                              (osc-add! msg (list 1 2 3)))))]
    (assert (panic? panicked) "Adding a list to an OSC message should panic")
    true))

;; ============================================================
;; Main Test Runner
;; ============================================================

(defn run-all-tests []
  (let [tests [
    ["Message creation" test-osc-message-creation]
    ["Message with args" test-osc-message-with-args]
    ["Send simple" test-osc-send-simple]
    ["with-osc-message macro" test-with-osc-message-macro]
    ["Add int32" test-add-int32]
    ["Add float" test-add-float]
    ["Add string" test-add-string]
    ["Add multiple types" test-add-multiple-types]
    ["synth new message" test-synth-new-message]
    ["n_set message" test-n-set-message]
    ["n_free message" test-n-free-message]
    ["group new message" test-group-new-message]
    ["Batch messages" test-batch-messages]
    ["Bundle construction" test-bundle-construction]
    ["Invalid message" test-invalid-message]
    ["Unsupported type" test-unsupported-type]
  ]]
    (doseq [[name test-fn] tests]
      (print (str "Testing: " name " ... "))
      (let [result (test-fn)]
        (if result
          (println " PASS")
          (println " FAIL"))))
    (println "\nMessage builder tests complete.")))

;; Run tests if executed directly
(when (== (get *argv* 0) "run")
  (run-all-tests))
