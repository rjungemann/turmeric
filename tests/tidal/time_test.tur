;;
;; Tidal Time Module Tests
;; Phase A tests from tidalcycles-dsl-plan.md
;;

(import tidal/time)

;; ============================================================
;; Type Tests
;; ============================================================

(defn test-beats-type []
  (let [b 2.5]
    (assert (float? b) "Beats should be represented as float")
    true))

(defn test-seconds-type []
  (let [s 1.5]
    (assert (float? s) "Seconds should be represented as float")
    true))

(defn test-samples-type []
  (let [s 44100]
    (assert (int? s) "Samples should be represented as int")
    true))

;; ============================================================
;; BPM Conversion Tests
;; ============================================================

(defn test-bpm-to-beats-per-sec []
  (assert (== (bpm->beats-per-sec 120.0) 2.0) "120 BPM = 2 beats/sec")
  (assert (== (bpm->beats-per-sec 60.0) 1.0) "60 BPM = 1 beat/sec")
  (assert (== (bpm->beats-per-sec 180.0) 3.0) "180 BPM = 3 beats/sec")
  (assert (approx== (bpm->beats-per-sec 1.0) (/ 1.0 60.0) 0.0001) "1 BPM = ~0.0167 beats/sec")
  true))

(defn test-bpm-to-sec-per-beat []
  (assert (== (bpm->sec-per-beat 120.0) 0.5) "120 BPM = 0.5 sec/beat")
  (assert (== (bpm->sec-per-beat 60.0) 1.0) "60 BPM = 1 sec/beat")
  (assert (== (bpm->sec-per-beat 180.0) (/ 1.0 3.0) 0.0001) "180 BPM = ~0.333 sec/beat")
  true))

;; ============================================================
;; Time Conversion Tests
;; ============================================================

(defn test-beats-to-sec []
  (assert (== (beats->sec 1.0 120.0) 0.5) "1 beat at 120 BPM = 0.5 sec")
  (assert (== (beats->sec 2.0 120.0) 1.0) "2 beats at 120 BPM = 1 sec")
  (assert (== (beats->sec 4.0 120.0) 2.0) "4 beats at 120 BPM = 2 sec")
  (assert (== (beats->sec 1.0 60.0) 1.0) "1 beat at 60 BPM = 1 sec")
  true))

(defn test-sec-to-beats []
  (assert (== (sec->beats 0.5 120.0) 1.0) "0.5 sec at 120 BPM = 1 beat")
  (assert (== (sec->beats 1.0 120.0) 2.0) "1 sec at 120 BPM = 2 beats")
  (assert (== (sec->beats 2.0 120.0) 4.0) "2 sec at 120 BPM = 4 beats")
  (assert (== (sec->beats 1.0 60.0) 1.0) "1 sec at 60 BPM = 1 beat")
  true))

(defn test-roundtrip-conversion []
  ;; Test that beats->sec->beats is identity
  (let [beats 3.5]
    (let [bpm 120.0]
      (let [sec (beats->sec beats bpm)]
        (let [beats2 (sec->beats sec bpm)]
          (assert (approx== beats2 beats 0.0001) "Roundtrip conversion should be identity")
          true))))))

;; ============================================================
;; Samples Conversion Tests
;; ============================================================

(defn test-samples-to-sec []
  (let [sample-rate 44100.0]
    (assert (== (samples->sec 44100 sample-rate) 1.0) "44100 samples at 44100 Hz = 1 sec")
    (assert (== (samples->sec 22050 sample-rate) 0.5) "22050 samples at 44100 Hz = 0.5 sec")
    true))

(defn test-sec-to-samples []
  (let [sample-rate 44100.0]
    (assert (== (sec->samples 1.0 sample-rate) 44100) "1 sec at 44100 Hz = 44100 samples")
    (assert (== (sec->samples 0.5 sample-rate) 22050) "0.5 sec at 44100 Hz = 22050 samples")
    true))

(defn test-samples-beats-roundtrip []
  (let [sample-rate 44100.0]
    (let [beats 2.0]
      (let [bpm 120.0]
        (let [sec (beats->sec beats bpm)]
          (let [samples (sec->samples sec sample-rate)]
            (let [sec2 (samples->sec samples sample-rate)]
              (let [beats2 (sec->beats sec2 bpm)]
                (assert (approx== beats2 beats 0.0001) "Samples roundtrip should preserve beats")
                true))))))))))

;; ============================================================
;; Tempo Tracking Tests
;; ============================================================

(defn test-make-tempo []
  (let [tempo (make-tempo 120.0)]
    (assert (== (:bpm tempo) 120.0) "Tempo BPM should be 120")
    (assert (some? (:start-time tempo)) "Should have start time")
    true))

(defn test-tempo-at []
  (let [tempo (make-tempo 120.0)]
    (let [beats (tempo->beats tempo 1.0)]
      (assert (== beats 2.0) "At 120 BPM, 1 second = 2 beats")
      true)))

(defn test-tempo-beats-per-sec []
  (let [tempo (make-tempo 120.0)]
    (assert (== (tempo-beats-per-sec tempo) 2.0) "120 BPM = 2 beats/sec")
    true))

;; ============================================================
;; Edge Cases
;; ============================================================

(defn test-zero-bpm []
  ;; Test handling of zero BPM
  (assert (thrown? (bpm->beats-per-sec 0.0)) "Zero BPM should cause error")
  true)

(defn test-negative-bpm []
  ;; Test handling of negative BPM
  (assert (thrown? (bpm->beats-per-sec -60.0)) "Negative BPM should cause error")
  true)

(defn test-very-high-bpm []
  ;; Test very high BPM values
  (let [bpm 1000.0]
    (let [bps (bpm->beats-per-sec bpm)]
      (assert (== bps (/ bpm 60.0)) "High BPM should still convert correctly")
      true))))

(defn test-very-low-bpm []
  ;; Test very low BPM values
  (let [bpm 1.0]
    (let [bps (bpm->beats-per-sec bpm)]
      (assert (approx== bps (/ 1.0 60.0) 0.0001) "Low BPM should still convert correctly")
      true))))

;; ============================================================
;; Main Test Runner
;; ============================================================

(defn run-all-tests []
  (let [tests [
    ["beats type" test-beats-type]
    ["seconds type" test-seconds-type]
    ["samples type" test-samples-type]
    ["bpm to beats/sec" test-bpm-to-beats-per-sec]
    ["bpm to sec/beat" test-bpm-to-sec-per-beat]
    ["beats to sec" test-beats-to-sec]
    ["sec to beats" test-sec-to-beats]
    ["roundtrip conversion" test-roundtrip-conversion]
    ["samples to sec" test-samples-to-sec]
    ["sec to samples" test-sec-to-samples]
    ["samples beats roundtrip" test-samples-beats-roundtrip]
    ["make tempo" test-make-tempo]
    ["tempo at" test-tempo-at]
    ["tempo beats/sec" test-tempo-beats-per-sec]
    ["zero bpm" test-zero-bpm]
    ["negative bpm" test-negative-bpm]
    ["very high bpm" test-very-high-bpm]
    ["very low bpm" test-very-low-bpm]
  ]]
    (doseq [[name test-fn] tests]
      (print (str "Testing: " name " ... "))
      (let [result (test-fn)]
        (if result
          (println " PASS")
          (println " FAIL"))))
    (println "\nTime module tests complete.")))

;; Run tests if executed directly
(when (== (get *argv* 0) "run")
  (run-all-tests))
