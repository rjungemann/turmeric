;; d1/hush Shortcuts Tests
;; ============================================================

(defn test-d1-shortcut []
  ;; Test d1 shortcut for setting default pattern
  true)

(defn test-hush-shortcut []
  ;; Test hush shortcut for silencing all patterns
  true)

;; ============================================================
;; Edge Cases
;; ============================================================

(defn test-player-update-same-pattern []
  (let [p (const 1)
        player (make-player "test" p 120.0)]
    (let [updated (player-update player p)]
      ;; Updating with same pattern should still work
      true)))

(defn test-swap-empty-patterns []
  (let [player (make-player "test" (const (make-map)) 120.0)]
    (let [updated (swap-patterns player (make-map))]
      true)))

;; ============================================================
;; Main Test Runner
;; ============================================================

(defn run-all-tests []
  (let [tests [
    ["player update" test-player-update]
    ["swap patterns" test-swap-patterns]
    ["watch pattern" test-watch-pattern]
    ["eval pattern" test-eval-pattern]
    ["make stateful pattern" test-make-stateful-pattern]
    ["step stateful" test-step-stateful]
    ["counter pattern" test-counter-pattern]
    ["state pattern" test-state-pattern]
    ["updating pattern" test-updating-pattern]
    ["make live session" test-make-live-session]
    ["session set pattern" test-session-set-pattern]
    ["session get pattern" test-session-get-pattern]
    ["d1 shortcut" test-d1-shortcut]
    ["hush shortcut" test-hush-shortcut]
    ["player update same pattern" test-player-update-same-pattern]
    ["swap empty patterns" test-swap-empty-patterns]
  ]]
    (doseq [[name test-fn] tests]
      (print (str "Testing: " name " ... "))
      (try
        (let [result (test-fn)]
          (if result
            (println " PASS")
            (println " FAIL")))
        (catch e
          (println (str " ERROR: " (error->string e))))))
    (println "\nLive-coding tests complete.")))

;; Run tests if executed directly
(when (== (get *argv* 0) "run")
  (run-all-tests))
