;;
;; Tidal Structural Combinators Tests
;; Phase C tests from tidalcycles-dsl-plan.md
;;

(import tidal/pattern tidal/structural)

;; ============================================================
;; Sequential Combination Tests
;; ============================================================

(defn test-seq-basic []
  (let [p (seq (const 1) (const 2) (const 3))]
    (assert (== (p 0.0) 1) "seq at time 0.0 should return first pattern")
    (assert (== (p 0.5) 1) "seq at time 0.5 should still return first pattern")
    (assert (== (p 1.0) 2) "seq at time 1.0 should return second pattern")
    (assert (== (p 1.5) 2) "seq at time 1.5 should still return second pattern")
    (assert (== (p 2.0) 3) "seq at time 2.0 should return third pattern")
    (assert (== (p 3.0) 1) "seq at time 3.0 should wrap to first pattern")
    true))

(defn test-seq-cycles []
  (let [p (seq (cycle 1 2) (cycle 3 4))]
    (assert (== (p 0.0) 1) "seq of cycles at time 0 should return 1")
    (assert (== (p 0.5) 2) "seq of cycles at time 0.5 should return 2")
    (assert (== (p 1.0) 3) "seq of cycles at time 1.0 should return 3")
    (assert (== (p 1.5) 4) "seq of cycles at time 1.5 should return 4")
    (assert (== (p 2.0) 1) "seq of cycles at time 2.0 should wrap to 1")
    true))

(defn test-seq-single []
  (let [p (seq (const 42))]
    (assert (== (p 0.0) 42) "seq with single pattern should work")
    true))

(defn test-seq-empty []
  (let [p (seq)]
    ;; Empty seq should return nil or handle gracefully
    true))

(defn test-seq-n []
  ;; seq-n with custom lengths
  (let [p (seq-n [(const 1) 0.5] [(const 2) 0.5])]
    (assert (== (p 0.0) 1) "seq-n at time 0 should return 1")
    (assert (== (p 0.25) 1) "seq-n at time 0.25 should still return 1")
    (assert (== (p 0.5) 2) "seq-n at time 0.5 should return 2")
    (assert (== (p 0.75) 2) "seq-n at time 0.75 should still return 2")
    (assert (== (p 1.0) 1) "seq-n at time 1.0 should wrap to 1")
    true))

;; ============================================================
;; Parallel Combination Tests
;; ============================================================

(defn test-stack []
  (let [p (stack (const 1) (const 2) (const 3))]
    (let [result (p 0.0)]
      (assert (vec? result) "stack should return a vector")
      (assert (== (len result) 3) "stack should return vector of length 3")
      (assert (== (get result 0) 1) "First element should be 1")
      (assert (== (get result 1) 2) "Second element should be 2")
      (assert (== (get result 2) 3) "Third element should be 3")
      true)))

(defn test-stack-with []
  (let [p (stack-with (fn [v] (reduce + 0 v)) (const 1) (const 2) (const 3))]
    (assert (== (p 0.0) 6) "stack-with sum should return 6")
    true))

(defn test-sum []
  (let [p (sum (const 1) (const 2) (const 3))]
    (assert (== (p 0.0) 6) "sum should add all pattern values")
    true))

(defn test-sum-cycles []
  (let [p (sum (cycle 1 2) (cycle 3 4))]
    (assert (== (p 0.0) 4) "sum of cycles at time 0 should be 1+3=4")
    (assert (== (p 1.0) 6) "sum of cycles at time 1 should be 2+4=6")
    true))

(defn test-multiply []
  (let [p (multiply (const 2) (const 3))]
    (assert (== (p 0.0) 6) "multiply should multiply all pattern values")
    true))

(defn test-multiply-cycles []
  (let [p (multiply (cycle 1 2) (cycle 3 4))]
    (assert (== (p 0.0) 3) "multiply of cycles at time 0 should be 1*3=3")
    (assert (== (p 1.0) 8) "multiply of cycles at time 1 should be 2*4=8")
    true))

;; ============================================================
;; Conditional Pattern Tests
;; ============================================================

(defn test-when []
  (let [p (when (cycle true false) (const 1) 0)]
    (assert (== (p 0.0) 1) "when at time 0 (condition true) should return 1")
    (assert (== (p 1.0) 0) "when at time 1 (condition false) should return 0")
    (assert (== (p 2.0) 1) "when at time 2 (condition true) should return 1")
    true))

(defn test-when-const-true []
  (let [p (when (const true) (const 42) 0)]
    (assert (== (p 0.0) 42) "when with always true condition should always return value")
    (assert (== (p 100.0) 42) "when with always true should always return value")
    true))

(defn test-when-const-false []
  (let [p (when (const false) (const 42) 0)]
    (assert (== (p 0.0) 0) "when with always false condition should always return zero")
    (assert (== (p 100.0) 0) "when with always false should always return zero")
    true))

(defn test-if-pat []
  (let [p (if-pat (cycle true false) (const 1) (const 2))]
    (assert (== (p 0.0) 1) "if-pat at time 0 (true) should return 1")
    (assert (== (p 1.0) 2) "if-pat at time 1 (false) should return 2")
    true))

(defn test-every []
  (let [p (every 2 (const 1) 0)]
    (assert (== (p 0.0) 1) "every at time 0 should return value")
    (assert (== (p 1.0) 0) "every at time 1 should return zero")
    (assert (== (p 2.0) 1) "every at time 2 should return value")
    (assert (== (p 3.0) 0) "every at time 3 should return zero")
    true))

(defn test-nth []
  (let [p (nth 2 (const 1) 0)]
    (assert (== (p 0.0) 1) "nth at time 0 should return value")
    (assert (== (p 1.0) 0) "nth at time 1 should return zero")
    (assert (== (p 2.0) 1) "nth at time 2 should return value")
    true))

;; ============================================================
;; Euclidean Rhythm Tests
;; ============================================================

(defn test-euclid-basic []
  (let [p (euclid 8 4)]
    ;; 4 hits in 8 steps - should give us a pattern
    (assert (fn? p) "euclid should return a function")
    true))

(defn test-euclid-values []
  (let [p (euclid 8 3)]
    ;; 3 hits in 8 steps - check some values
    (let [result (p 0.0)]
      (assert (float? result) "euclid should return float")
      true))))

(defn test-euclid-offset []
  (let [p (euclid 8 4 1)]
    ;; With offset
    (assert (fn? p) "euclid with offset should work")
    true))

;; ============================================================
;; Pattern Selection Tests
;; ============================================================

(defn test-select []
  (let [p (select (cycle 0 1 0 1) (const 10) (const 20))]
    (assert (== (p 0.0) 10) "select at time 0 (index 0) should return 10")
    (assert (== (p 1.0) 20) "select at time 1 (index 1) should return 20")
    (assert (== (p 2.0) 10) "select at time 2 (index 0) should return 10")
    true))

(defn test-select-wrap []
  (let [p (select (cycle 0 1 2 3) (const 10) (const 20) (const 30))]
    (assert (== (p 0.0) 10) "select should wrap index")
    (assert (== (p 3.0) 30) "select at index 3 should work")
    true))

(defn test-first-nonzero []
  (let [p (first-nonzero 0 (const 0) (const 0) (const 5) (const 0))]
    (assert (== (p 0.0) 5) "first-nonzero should return first non-zero value")
    true))

(defn test-first-nonzero-all-zero []
  (let [p (first-nonzero 0 (const 0) (const 0) (const 0))]
    (assert (== (p 0.0) 0) "first-nonzero with all zeros should return default")
    true))

;; ============================================================
;; Edge Cases
;; ============================================================

(defn test-seq-nested []
  (let [p (seq (seq (const 1) (const 2)) (const 3))]
    (assert (== (p 0.0) 1) "Nested seq should work")
    (assert (== (p 0.5) 2) "Nested seq at time 0.5 should return 2")
    (assert (== (p 1.0) 3) "Nested seq at time 1.0 should return 3")
    true))

(defn test-stack-single []
  (let [p (stack (const 42))]
    (let [result (p 0.0)]
      (assert (== (len result) 1) "stack with single pattern should work")
      (assert (== (get result 0) 42) "Single stack should return value in vector")
      true)))

;; ============================================================
;; Main Test Runner
;; ============================================================

(defn run-all-tests []
  (let [tests [
    ["seq basic" test-seq-basic]
    ["seq cycles" test-seq-cycles]
    ["seq single" test-seq-single]
    ["seq empty" test-seq-empty]
    ["seq-n" test-seq-n]
    ["stack" test-stack]
    ["stack-with" test-stack-with]
    ["sum" test-sum]
    ["sum cycles" test-sum-cycles]
    ["multiply" test-multiply]
    ["multiply cycles" test-multiply-cycles]
    ["when" test-when]
    ["when const true" test-when-const-true]
    ["when const false" test-when-const-false]
    ["if-pat" test-if-pat]
    ["every" test-every]
    ["nth" test-nth]
    ["euclid basic" test-euclid-basic]
    ["euclid values" test-euclid-values]
    ["euclid offset" test-euclid-offset]
    ["select" test-select]
    ["select wrap" test-select-wrap]
    ["first-nonzero" test-first-nonzero]
    ["first-nonzero all zero" test-first-nonzero-all-zero]
    ["seq nested" test-seq-nested]
    ["stack single" test-stack-single]
  ]]
    (doseq [[name test-fn] tests]
      (print (str "Testing: " name " ... "))
      (let [result (test-fn)]
        (if result
          (println " PASS")
          (println " FAIL"))))
    (println "\nStructural combinators tests complete.")))

;; Run tests if executed directly
(when (== (get *argv* 0) "run")
  (run-all-tests))
