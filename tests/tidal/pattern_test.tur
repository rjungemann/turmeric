;;
;; Tidal Pattern Module Tests
;; Phase A tests from tidalcycles-dsl-plan.md
;;

(import tidal/pattern)

;; ============================================================
;; Constant Pattern Tests
;; ============================================================

(defn test-const-int []
  (let [p (const 42)]
    (assert (fn? p) "const should return a function")
    (assert (== (p 0.0) 42) "Pattern should return 42 at any time")
    (assert (== (p 1.0) 42) "Pattern should return 42 at time 1")
    (assert (== (p 100.0) 42) "Pattern should return 42 at time 100")
    true))

(defn test-const-float []
  (let [p (const 3.14)]
    (assert (== (p 0.0) 3.14) "Float constant should work")
    true))

(defn test-const-string []
  (let [p (const "hello")]
    (assert (== (p 0.0) "hello") "String constant should work")
    true))

(defn test-const-list []
  (let [p (const [1 2 3])]
    (assert (== (p 0.0) [1 2 3]) "List constant should work")
    true))

(defn test-const-map []
  (let [p (const {:freq 440.0 :amp 0.5})]
    (assert (== (p 0.0) {:freq 440.0 :amp 0.5}) "Map constant should work")
    true))

;; ============================================================
;; Cycle Pattern Tests
;; ============================================================

(defn test-cycle-basic []
  (let [p (cycle 1 2 3)]
    (assert (== (p 0.0) 1) "Cycle at beat 0 should return first value")
    (assert (== (p 0.5) 1) "Cycle at beat 0.5 should still return first value")
    (assert (== (p 1.0) 2) "Cycle at beat 1 should return second value")
    (assert (== (p 1.5) 2) "Cycle at beat 1.5 should still return second value")
    (assert (== (p 2.0) 3) "Cycle at beat 2 should return third value")
    (assert (== (p 3.0) 1) "Cycle at beat 3 should wrap to first value")
    (assert (== (p 4.0) 2) "Cycle at beat 4 should return second value")
    true))

(defn test-cycle-single []
  (let [p (cycle 42)]
    (assert (== (p 0.0) 42) "Single element cycle should work")
    (assert (== (p 1.0) 42) "Single element cycle should repeat")
    true))

(defn test-cycle-floats []
  (let [p (cycle 0.5 1.0 1.5)]
    (assert (== (p 0.0) 0.5) "Float cycle should work")
    (assert (== (p 1.0) 1.0) "Float cycle at beat 1 should work")
    true))

(defn test-cycle-strings []
  (let [p (cycle "a" "b" "c")]
    (assert (== (p 0.0) "a") "String cycle should work")
    (assert (== (p 1.0) "b") "String cycle at beat 1 should work")
    true))

(defn test-cycle-empty []
  (let [p (cycle)]
    ;; Empty cycle - should return nil or handle gracefully
    true))

;; ============================================================
;; Phase Pattern Tests
;; ============================================================

(defn test-phase-default []
  (let [p (phase)]
    (assert (== (p 0.0) 0.0) "Phase at 0 should be 0")
    (assert (== (p 0.5) 0.5) "Phase at 0.5 should be 0.5")
    (assert (== (p 1.0) 0.0) "Phase at 1 should wrap to 0")
    (assert (== (p 1.5) 0.5) "Phase at 1.5 should be 0.5")
    (assert (== (p 2.5) 0.5) "Phase at 2.5 should be 0.5")
    true))

(defn test-phase-custom []
  (let [p (phase 2.0)]
    (assert (== (p 0.0) 0.0) "Phase at 0 should be 0")
    (assert (== (p 1.0) 1.0) "Phase at 1 should be 1")
    (assert (== (p 2.0) 0.0) "Phase at 2 should wrap to 0")
    (assert (== (p 3.0) 1.0) "Phase at 3 should be 1")
    true))

(defn test-phase-fractional []
  (let [p (phase 0.5)]
    (assert (== (p 0.0) 0.0) "Phase at 0 should be 0")
    (assert (== (p 0.25) 0.5) "Phase at 0.25 should be 0.5 (wraps)")
    (assert (== (p 0.5) 0.0) "Phase at 0.5 should wrap to 0")
    true))

;; ============================================================
;; P Macro Tests
;; ============================================================

(defn test-p-macro-single-value []
  (let [p (P 42)]
    (assert (fn? p) "P with single value should return function")
    (assert (== (p 0.0) 42) "P 42 should return 42")
    true))

(defn test-p-macro-multiple-values []
  (let [p (P 1 2 3)]
    (assert (== (p 0.0) 1) "P 1 2 3 should cycle through values")
    (assert (== (p 1.0) 2) "P at beat 1 should return 2")
    (assert (== (p 2.0) 3) "P at beat 2 should return 3")
    (assert (== (p 3.0) 1) "P at beat 3 should wrap to 1")
    true))

(defn test-p-macro-strings []
  (let [p (P "a" "b")]
    (assert (== (p 0.0) "a") "P with strings should work")
    (assert (== (p 1.0) "b") "P at beat 1 should return b")
    true))

;; ============================================================
;; Pattern Application Tests
;; ============================================================

(defn test-pat-at []
  (let [p (cycle 10 20 30)]
    (assert (== (pat-at p 0.0) 10) "pat-at at time 0 should return 10")
    (assert (== (pat-at p 1.0) 20) "pat-at at time 1 should return 20")
    (assert (== (pat-at p 2.5) 30) "pat-at at time 2.5 should return 30")
    true))

(defn test-pat-at-const []
  (let [p (const 100)]
    (assert (== (pat-at p 0.0) 100) "pat-at with const should work")
    (assert (== (pat-at p 999.0) 100) "pat-at with const at any time should work")
    true))

;; ============================================================
;; Pattern Type Tests
;; ============================================================

(defn test-pattern-type []
  (let [p (const 42)]
    (assert (fn? p) "Pattern should be a function")
    true))

(defn test-numeric-pattern []
  (let [p (const 3.14)]
    (assert (float? (p 0.0)) "Numeric pattern should return float")
    true))

;; ============================================================
;; Edge Cases
;; ============================================================

(defn test-pattern-negative-time []
  (let [p (cycle 1 2 3)]
    (assert (== (p -1.0) 3) "Negative time should work (wraps)")
    (assert (== (p -2.0) 2) "Negative time should wrap correctly")
    true))

(defn test-pattern-large-time []
  (let [p (cycle 1 2 3)]
    (assert (== (p 1000.0) 1) "Large time should wrap correctly")
    (assert (== (p 1001.0) 2) "Large time + 1 should wrap correctly")
    true))

(defn test-pattern-nil-values []
  (let [p (cycle nil "a" nil "b")]
    (assert (nil? (p 0.0)) "Pattern with nil should return nil")
    (assert (== (p 1.0) "a") "Pattern should return non-nil values")
    true))

;; ============================================================
;; Main Test Runner
;; ============================================================

(defn run-all-tests []
  (let [tests [
    ["const int" test-const-int]
    ["const float" test-const-float]
    ["const string" test-const-string]
    ["const list" test-const-list]
    ["const map" test-const-map]
    ["cycle basic" test-cycle-basic]
    ["cycle single" test-cycle-single]
    ["cycle floats" test-cycle-floats]
    ["cycle strings" test-cycle-strings]
    ["cycle empty" test-cycle-empty]
    ["phase default" test-phase-default]
    ["phase custom" test-phase-custom]
    ["phase fractional" test-phase-fractional]
    ["P macro single" test-p-macro-single-value]
    ["P macro multiple" test-p-macro-multiple-values]
    ["P macro strings" test-p-macro-strings]
    ["pat-at" test-pat-at]
    ["pat-at const" test-pat-at-const]
    ["pattern type" test-pattern-type]
    ["numeric pattern" test-numeric-pattern]
    ["pattern negative time" test-pattern-negative-time]
    ["pattern large time" test-pattern-large-time]
    ["pattern nil values" test-pattern-nil-values]
  ]]
    (doseq [[name test-fn] tests]
      (print (str "Testing: " name " ... "))
      (let [result (test-fn)]
        (if result
          (println " PASS")
          (println " FAIL"))))
    (println "\nPattern module tests complete.")))

;; Run tests if executed directly
(when (== (get *argv* 0) "run")
  (run-all-tests))
