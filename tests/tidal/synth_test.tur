;; ============================================================
;; Edge Cases
;; ============================================================

(defn test-note-pattern-zero-dur []
  (let [p (note-pattern (const 60) (const 100) (const 0.0))]
    (let [result (p 0.0)]
      (assert (== (result :dur) 0.0) "Zero duration should be preserved")
      true)))

(defn test-note-pattern-gate-false []
  (let [p (note-pattern (const 60) (const 100) (const 0.25) (const false))]
    (let [result (p 0.0)]
      (assert (== (result :gate) 0.0) "Gate false should map to 0.0")
      true)))

;; ============================================================
;; Main Test Runner
;; ============================================================

(defn run-all-tests []
  (let [tests [
    ["note to freq" test-note-to-freq]
    ["note pattern basic" test-note-pattern-basic]
    ["note pattern varying" test-note-pattern-varying]
    ["chord pattern" test-chord-pattern]
    ["arpeggio pattern" test-arpeggio-pattern]
    ["arpeggio speed" test-arpeggio-speed]
    ["drum pattern" test-drum-pattern]
    ["kick" test-kick]
    ["snare" test-snare]
    ["hat" test-hat]
    ["pat to param" test-pat-to-param]
    ["pats to params" test-pats-to-params]
    ["pattern synth player" test-pattern-synth-player]
    ["make player" test-make-player]
    ["player start stop" test-player-start-stop]
    ["pat synth integration" test-pat-synth-integration]
    ["note pattern zero dur" test-note-pattern-zero-dur]
    ["note pattern gate false" test-note-pattern-gate-false]
  ]]
    (doseq [[name test-fn] tests]
      (print (str "Testing: " name " ... "))
      (let [result (test-fn)]
        (if result
          (println " PASS")
          (println " FAIL"))))
    (println "\nSynth integration tests complete.")))

;; Run tests if executed directly
(when (== (get *argv* 0) "run")
  (run-all-tests))
