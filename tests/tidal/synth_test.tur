;;
;; Tidal Synth Integration Tests
;; Phase F tests from tidalcycles-dsl-plan.md
;;

(import tidal/pattern tidal/synth scscm/synth)

;; ============================================================
;; Note Pattern Tests
;; ============================================================

(defn test-note-to-freq []
  (assert (approx== (note->freq 69) 440.0 0.001) "MIDI 69 should be 440 Hz")
  (assert (approx== (note->freq 60) 261.626 0.01) "MIDI 60 should be ~261.63 Hz")
  (assert (approx== (note->freq 0) 8.176 0.01) "MIDI 0 should be ~8.18 Hz")
  true))

(defn test-note-pattern-basic []
  (let [pitch (const 60)
        vel (const 100)
        dur (const 0.25)
        gate (const true)
        p (note-pattern pitch vel dur gate)]
    (let [result (p 0.0)]
      (assert (map? result) "Note pattern should return map")
      (assert (contains? result :freq) "Should have freq key")
      (assert (contains? result :amp) "Should have amp key")
      (assert (contains? result :gate) "Should have gate key")
      (assert (contains? result :dur) "Should have dur key")
      true)))

(defn test-note-pattern-varying []
  (let [pitch (cycle 60 62 64)
        p (note-pattern pitch)]
    (assert (approx== ((p 0.0) :freq) (note->freq 60) 0.001) "Note pattern should use varying pitch")
    (assert (approx== ((p 1.0) :freq) (note->freq 62) 0.001) "Note pattern at time 1 should use next pitch")
    true))

;; ============================================================
;; Chord Pattern Tests
;; ============================================================

(defn test-chord-pattern []
  (let [notes [(const 60) (const 64) (const 67)]]
    (let [p (apply chord-pattern notes)]
      (let [result (p 0.0)]
        (assert (vec? result) "Chord pattern should return vector")
        (assert (== (len result) 3) "Should have 3 notes")
        true))))

;; ============================================================
;; Arpeggio Pattern Tests
;; ============================================================

(defn test-arpeggio-pattern []
  (let [chord (const [60 64 67])
        p (arp-pattern chord 4.0)]
    (assert (int? (p 0.0)) "Arpeggio should return integer (MIDI note)")
    true))

(defn test-arpeggio-speed []
  (let [chord (const [60 64 67])
        p (arp-pattern chord 2.0)]
    (assert (== (p 0.0) 60) "Arpeggio at time 0 should return first note")
    (assert (== (p 0.5) 64) "Arpeggio at time 0.5 should return second note")
    true))

;; ============================================================
;; Drum Pattern Tests
;; ============================================================

(defn test-drum-pattern []
  (let [hits [(36 127) (38 100) (42 80)]]
    (let [p (apply drum-pattern hits)]
      (let [result (p 0.0)]
        (assert (map? result) "Drum pattern should return map")
        (assert (contains? result :note) "Should have note key")
        (assert (contains? result :vel) "Should have vel key")
        true))))

(defn test-kick []
  (let [p (kick [0.0 0.5])]
    (let [result (p 0.0)]
      (assert (map? result) "Kick pattern should return map")
      (assert (== (result :note) 36) "Kick should use note 36")
      true)))

(defn test-snare []
  (let [p (snare [0.5 1.0])]
    (let [result (p 0.0)]
      (assert (map? result) "Snare pattern should return map")
      (assert (== (result :note) 38) "Snare should use note 38")
      true)))

(defn test-hat []
  (let [p (hat [0.0 0.25 0.5 0.75])]
    (let [result (p 0.0)]
      (assert (map? result) "Hat pattern should return map")
      (assert (== (result :note) 42) "Hat should use note 42")
      true)))

