;;
;; Tidal Timing Tests
;; Phase G tests from tidalcycles-dsl-plan.md
;;

(import tidal/timing)

;; ============================================================
;; BeatClock Tests
;; ============================================================

(defn test-make-beat-clock []
  (let [clock (make-beat-clock 120.0 44100.0)]
    (assert (== (:bpm clock) 120.0) "Clock BPM should be 120")
    (assert (== (:sample-rate clock) 44100.0) "Clock sample rate should be 44100")
    (assert (some? (:samples-per-beat clock)) "Should have samples per beat")
    true))

(defn test-clock-samples-per-beat []
  (let [clock (make-beat-clock 120.0 44100.0)]
    (let [samples-per-beat (/ 44100.0 2.0)]
      (assert (approx== (:samples-per-beat clock) samples-per-beat 0.001) "Samples per beat should be correct")
      true)))

(defn test-clock-to-beats []
  (let [clock (make-beat-clock 120.0 44100.0)]
    (assert (== (clock->beats clock 0) 0.0) "0 samples should be 0 beats")
    (assert (== (clock->beats clock 44100) 2.0) "44100 samples at 120 BPM should be 2 beats")
    true))

(defn test-clock-to-samples []
  (let [clock (make-beat-clock 120.0 44100.0)]
    (assert (== (clock->samples clock 0.0) 0) "0 beats should be 0 samples")
    (assert (== (clock->samples clock 1.0) 22050) "1 beat at 120 BPM should be 22050 samples")
    true))

;; ============================================================
;; Audio Pattern Tests
;; ============================================================

(defn test-audio-pattern []
  (let [p (audio-pattern (const 0.5) (make-beat-clock 120.0 44100.0))]
    (assert (fn? p) "audio-pattern should return a function")
    true))

(defn test-audio-pattern-evaluation []
  (let [p (audio-pattern (const 0.5) (make-beat-clock 120.0 44100.0))]
    (let [result (p 0)]
      (assert (float? result) "Audio pattern should return float")
      true)))

(defn test-audio-pattern-cycle []
  (let [p (audio-pattern (cycle 0.0 0.5 1.0) (make-beat-clock 120.0 44100.0))]
    (assert (float? (p 0)) "Audio pattern with cycle should work")
    true))

;; ============================================================
;; Mix Audio Patterns Tests
;; ============================================================

(defn test-mix-audio-patterns []
  (let [p1 (audio-pattern (const 0.5) (make-beat-clock 120.0 44100.0))
        p2 (audio-pattern (const 0.3) (make-beat-clock 120.0 44100.0))
        mixed (mix-audio-patterns p1 p2)]
    (assert (fn? mixed) "mix-audio-patterns should return a function")
    true))

(defn test-mix-audio-patterns-evaluation []
  (let [p1 (audio-pattern (const 0.5) (make-beat-clock 120.0 44100.0))
        p2 (audio-pattern (const 0.3) (make-beat-clock 120.0 44100.0))
        mixed (mix-audio-patterns p1 p2)]
    (let [result (mixed 0)]
      (assert (approx== result 0.8 0.001) "Mixed patterns should sum")
      true)))

;; ============================================================
;; PatternScheduler Tests
;; ============================================================

(defn test-make-scheduler []
  (let [clock (make-beat-clock 120.0 44100.0)
        sched (make-pattern-scheduler clock)]
    (assert (some? sched) "Should create scheduler")
    true))

(defn test-schedule-pattern []
  ;; This requires scsynth to be running
  true)

(defn test-schedule-event []
  ;; This requires scsynth to be running
  true)

(defn test-process-events []
  ;; This requires scsynth to be running
  true)

;; ============================================================
;; Edge Cases
;; ============================================================

(defn test-clock-different-bpm []
  (let [clock (make-beat-clock 60.0 44100.0)]
    (assert (== (clock->samples clock 1.0) 44100) "At 60 BPM, 1 beat = 44100 samples")
    true))

(defn test-clock-zero-bpm []
  ;; Zero BPM should be handled gracefully
  (try
    (let [clock (make-beat-clock 0.0 44100.0)]
      false)
    (catch _ true)))

(defn test-audio-pattern-negative-sample []
  (let [p (audio-pattern (const 0.5) (make-beat-clock 120.0 44100.0))]
    (let [result (p -1)]
      (assert (float? result) "Negative sample should be handled")
      true)))

;; ============================================================
;; Main Test Runner
;; ============================================================

(defn run-all-tests []
  (let [tests [
    ["make beat clock" test-make-beat-clock]
    ["clock samples per beat" test-clock-samples-per-beat]
    ["clock to beats" test-clock-to-beats]
    ["clock to samples" test-clock-to-samples]
    ["audio pattern" test-audio-pattern]
    ["audio pattern evaluation" test-audio-pattern-evaluation]
    ["audio pattern cycle" test-audio-pattern-cycle]
    ["mix audio patterns" test-mix-audio-patterns]
    ["mix audio patterns evaluation" test-mix-audio-patterns-evaluation]
    ["make scheduler" test-make-scheduler]
    ["schedule pattern" test-schedule-pattern]
    ["schedule event" test-schedule-event]
    ["process events" test-process-events]
    ["clock different bpm" test-clock-different-bpm]
    ["clock zero bpm" test-clock-zero-bpm]
    ["audio pattern negative sample" test-audio-pattern-negative-sample]
  ]]
    (doseq [[name test-fn] tests]
      (print (str "Testing: " name " ... "))
      (try
        (let [result (test-fn)]
          (if result
            (println " PASS")
            (println " FAIL")))
        (catch e
          (println (str " ERROR: " (error->string e))))))
    (println "\nTiming tests complete.")))

;; Run tests if executed directly
(when (== (get *argv* 0) "run")
  (run-all-tests))
