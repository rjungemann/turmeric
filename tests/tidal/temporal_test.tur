;;
;; Tidal Temporal Combinators Tests
;; Phase B tests from tidalcycles-dsl-plan.md
;;

(import tidal/pattern tidal/temporal)

;; ============================================================
;; Time Scaling Tests
;; ============================================================

(defn test-slow []
  (let [p (slow 2 (cycle 1 2 3))]
    (assert (== (p 0.0) 1) "Slow at time 0 should return 1")
    (assert (== (p 0.5) 1) "Slow at time 0.5 should still return 1")
    (assert (== (p 1.0) 1) "Slow at time 1 should still return 1 (slowed by 2)")
    (assert (== (p 2.0) 2) "Slow at time 2 should return 2")
    (assert (== (p 4.0) 3) "Slow at time 4 should return 3")
    true))

(defn test-slow-factor-3 []
  (let [p (slow 3 (cycle 1 2))]
    (assert (== (p 0.0) 1) "Slow by 3 at time 0 should return 1")
    (assert (== (p 1.5) 1) "Slow by 3 at time 1.5 should still return 1")
    (assert (== (p 3.0) 2) "Slow by 3 at time 3 should return 2")
    true))

(defn test-fast []
  (let [p (fast 2 (cycle 1 2 3))]
    (assert (== (p 0.0) 1) "Fast at time 0 should return 1")
    (assert (== (p 0.5) 2) "Fast at time 0.5 should return 2 (sped up by 2)")
    (assert (== (p 1.0) 3) "Fast at time 1 should return 3")
    (assert (== (p 1.5) 1) "Fast at time 1.5 should return 1")
    (assert (== (p 2.0) 2) "Fast at time 2 should return 2")
    true))

(defn test-fast-factor-3 []
  (let [p (fast 3 (cycle 1 2))]
    (assert (== (p 0.0) 1) "Fast by 3 at time 0 should return 1")
    (assert (== (p 0.333) 1) "Fast by 3 at time 0.333 should still return 1")
    (assert (== (p 0.667) 2) "Fast by 3 at time 0.667 should return 2")
    true))

(defn test-stretch []
  ;; stretch is an alias for slow
  (let [p (stretch 2 (cycle 1 2 3))]
    (assert (== (p 0.0) 1) "Stretch should work like slow")
    (assert (== (p 2.0) 2) "Stretch by 2 at time 2 should return 2")
    true))

(defn test-compress []
  ;; compress is an alias for fast
  (let [p (compress 2 (cycle 1 2 3))]
    (assert (== (p 0.0) 1) "Compress should work like fast")
    (assert (== (p 0.5) 2) "Compress by 2 at time 0.5 should return 2")
    true))

;; ============================================================
;; Time Shifting Tests
;; ============================================================

(defn test-shift []
  (let [p (shift 0.5 (cycle 1 2 3))]
    ;; shift adds offset to time, so the pattern evaluates at (time + offset)
    (assert (== (p 0.0) 2) "Shift by 0.5 at time 0 should evaluate at 0.5, returning 2")
    (assert (== (p 0.5) 3) "Shift by 0.5 at time 0.5 should evaluate at 1.0, returning 3")
    (assert (== (p 1.0) 1) "Shift by 0.5 at time 1.0 should evaluate at 1.5, returning 1")
    true))

(defn test-shift-negative []
  (let [p (shift -0.5 (cycle 1 2 3))]
    (assert (== (p 0.0) 3) "Negative shift should work")
    (assert (== (p 0.5) 1) "Negative shift at time 0.5 should return 1")
    true))

(defn test-rot []
  ;; rot is an alias for shift
  (let [p (rot 0.5 (cycle 1 2 3))]
    (assert (== (p 0.0) 2) "rot should work like shift")
    true))

(defn test-mirror []
  (let [p (mirror (cycle 1 2 3))]
    ;; mirror reverses time within each cycle
    ;; In a 1-beat cycle: [0, 0.5) plays forward, [0.5, 1) plays backward
    (assert (== (p 0.0) 1) "Mirror at time 0 should return 1")
    (assert (== (p 0.25) 2) "Mirror at time 0.25 should return 2")
    (assert (== (p 0.5) 3) "Mirror at time 0.5 should return 3")
    (assert (== (p 0.75) 2) "Mirror at time 0.75 should return 2 (mirrored)")
    (assert (== (p 1.0) 1) "Mirror at time 1.0 should return 1")
    true))

(defn test-rev []
  ;; rev reverses time within each cycle
  (let [p (rev (cycle 1 2 3))]
    ;; In a 1-beat cycle, time is reversed: 0->1, 0.25->0.75, 0.5->0.5
    ;; So at time 0, we evaluate at 1.0, which gives us value at floor(1.0*length) mod length
    (assert (== (p 0.0) 1) "rev at time 0 should return first value (evaluates at reversed time)")
    (assert (== (p 0.5) 3) "rev at time 0.5 should return 3")
    true))

;; ============================================================
;; Repetition Tests
;; ============================================================

(defn test-repeat []
  (let [p (repeat 2 (cycle 1 2))]
    ;; repeat 2 means the pattern repeats twice per cycle
    (assert (== (p 0.0) 1) "Repeat at time 0 should return 1")
    (assert (== (p 0.25) 1) "Repeat at time 0.25 should still return 1")
    (assert (== (p 0.5) 2) "Repeat at time 0.5 should return 2")
    (assert (== (p 0.75) 2) "Repeat at time 0.75 should still return 2")
    (assert (== (p 1.0) 1) "Repeat at time 1 should return 1 (cycle restarts)")
    true))

(defn test-once []
  (let [p (once (const 42) 0)]
    (assert (== (p 0.0) 42) "once at time 0 should return value")
    (assert (== (p 0.5) 42) "once at time 0.5 should still return value")
    (assert (== (p 1.0) 0) "once at time 1 should return zero (after cycle)")
    (assert (== (p 2.0) 0) "once at time 2 should return zero")
    true))

(defn test-once-non-zero []
  (let [p (once (const "x") "default")]
    (assert (== (p 0.0) "x") "once should work with non-numeric default")
    (assert (== (p 1.0) "default") "once after cycle should return default")
    true))

;; ============================================================
;; Combining Temporal Combinators
;; ============================================================

(defn test-slow-then-fast []
  (let [p (slow 2 (fast 2 (cycle 1 2)))]
    ;; slow 2 * fast 2 = no change (factors cancel)
    (assert (== (p 0.0) 1) "Combined scaling should work")
    (assert (== (p 0.5) 2) "Combined scaling at 0.5 should work")
    true))

(defn test-nested-slow []
  (let [p (slow 2 (slow 2 (cycle 1 2)))]
    ;; slow 2 * slow 2 = slow 4
    (assert (== (p 0.0) 1) "Nested slow should work")
    (assert (== (p 2.0) 1) "Nested slow at time 2 should still return 1")
    (assert (== (p 4.0) 2) "Nested slow at time 4 should return 2")
    true))

(defn test-shift-then-slow []
  (let [p (slow 2 (shift 0.5 (cycle 1 2)))]
    ;; First shift, then slow
    (assert (== (p 0.0) 2) "Shift then slow should work")
    true))

;; ============================================================
;; Edge Cases
;; ============================================================

(defn test-slow-zero []
  (let [panicked (catch-unwind (fn [] (slow 0 (cycle 1 2))))]
    (assert (panic? panicked) "slow 0 should panic")
    true))

(defn test-slow-negative []
  ;; Slow by negative factor
  (let [p (slow -1 (cycle 1 2))]
    (assert (== (p 0.0) 1) "Negative slow factor should work (time negation)")
    true))

(defn test-fast-zero []
  ;; Fast by 0
  (let [p (fast 0 (cycle 1 2))]
    (assert (== (p 0.0) 1) "Fast by 0 should return first value always")
    (assert (== (p 100.0) 1) "Fast by 0 at any time should return first value")
    true))

;; ============================================================
;; Main Test Runner
;; ============================================================

(defn run-all-tests []
  (let [tests [
    ["slow" test-slow]
    ["slow factor 3" test-slow-factor-3]
    ["fast" test-fast]
    ["fast factor 3" test-fast-factor-3]
    ["stretch" test-stretch]
    ["compress" test-compress]
    ["shift" test-shift]
    ["shift negative" test-shift-negative]
    ["rot" test-rot]
    ["mirror" test-mirror]
    ["rev" test-rev]
    ["repeat" test-repeat]
    ["once" test-once]
    ["once non-zero" test-once-non-zero]
    ["slow then fast" test-slow-then-fast]
    ["nested slow" test-nested-slow]
    ["shift then slow" test-shift-then-slow]
    ["slow zero" test-slow-zero]
    ["slow negative" test-slow-negative]
    ["fast zero" test-fast-zero]
  ]]
    (doseq [[name test-fn] tests]
      (print (str "Testing: " name " ... "))
      (let [result (test-fn)]
        (if result
          (println " PASS")
          (println " FAIL"))))
    (println "\nTemporal combinators tests complete.")))

;; Run tests if executed directly
(when (== (get *argv* 0) "run")
  (run-all-tests))
