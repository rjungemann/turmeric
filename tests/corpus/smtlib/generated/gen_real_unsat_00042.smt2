(set-logic QF_LRA)
(set-info :status unsat)
(declare-fun p () Real)
(declare-fun q () Real)
(declare-fun r () Real)
(assert (not (and (= (- q (- -1.5 0.0)) p) (= (- 3.5 -1.5) (+ 0.0 r)))))
(assert (not (=> (<= (+ (- 0.5 3.5) (* 3.5 p)) (- (- 1.5 p) (+ -1.5 q))) (= r (+ p (* -2.5 p))))))
(assert (= -1.5 q))
(assert (not (or (< q (+ (- 3.5 -2.5) (+ r 0.5))) (>= q (+ (* 2.5 q) r)))))
(check-sat)
(exit)
