(set-logic QF_UFLIA)
(set-info :status sat)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(assert (>= (- z x) (* 1 y)))
(assert (= w (- 10 (* -1 x))))
(assert (or (or (> 2 2) (> (- x w) (+ (f z) (g y w)))) (and (< (- z w) x) (= (- x (+ -1 -3)) 2))))
(assert (not (= 5 10)))
(check-sat)
(exit)
