(set-logic QF_LIA)
(set-info :status sat)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(assert (<= x (- (- 1 -3) (+ -1 y))))
(assert (> (* 0 z) -1))
(assert (< (+ y (+ -2 3)) (* 3 z)))
(assert (and (=> (= (+ 2 (+ z -3)) w) (= (* 0 z) y)) (>= z (* 2 y))))
(check-sat)
(exit)
