(set-logic QF_UFLIA)
(set-info :status unsat)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(assert (not (<= (+ 1 y) -2)))
(assert (=> (or (>= (+ (+ -3 3) (* 10 w)) y) (> x (- -1 (* 2 y)))) (=> (>= (* -2 x) (- 3 2)) (= (* -2 z) (g (- 1 x) (* 10 w))))))
(assert (= (+ (* 1 w) (+ 2 3)) w))
(assert (=> (< (* 3 y) w) (< (- w y) (- (+ 0 3) (f 0)))))
(assert (> (- w (- 3 3)) (- (+ y 0) (+ -2 z))))
(check-sat)
(exit)
