(set-logic QF_UFLIA)
(set-info :status sat)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(assert (= (+ (f -3) x) (- (g -1 2) (+ 10 x))))
(assert (and (=> (> y (g -2 (f y))) (= w (* 5 y))) (= (g z (g 5 3)) (* -2 y))))
(check-sat)
(exit)
