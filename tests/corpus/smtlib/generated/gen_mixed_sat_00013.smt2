(set-logic QF_UFLIA)
(set-info :status sat)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(assert (>= (- (- -2 w) 5) (g y z)))
(assert (or (not (= (* -1 x) (* -2 y))) (>= y (* 0 x))))
(assert (or (not (> (- (- w z) (f 0)) y)) (and (> (+ (- x 2) (- -2 w)) (- z (f 5))) (= (+ z 2) (* -3 y)))))
(assert (= (- (g y -3) x) (f (g 1 0))))
(assert (>= x (+ (- y 1) 1)))
(check-sat)
(exit)
