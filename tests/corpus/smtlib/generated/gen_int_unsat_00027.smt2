(set-logic QF_LIA)
(set-info :status unsat)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(assert (or (<= (- (+ -2 3) (+ 1 x)) 10) (<= 10 z)))
(assert (>= y y))
(assert (not (<= x (* 5 z))))
(assert (<= (* 0 z) x))
(assert (and (not (< (- 5 w) (- z z))) (= -3 5)))
(check-sat)
(exit)
