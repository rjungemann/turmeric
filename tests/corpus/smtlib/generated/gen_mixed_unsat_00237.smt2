(set-logic QF_UFLIA)
(set-info :status unsat)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(assert (not (and (< y w) (= (g (+ 5 w) (f 5)) (* 0 z)))))
(assert (= (* 1 x) -2))
(assert (<= (- (g 2 -3) (- 1 z)) -2))
(assert (< 2 2))
(assert (<= (g (* 2 y) z) -1))
(check-sat)
(exit)
