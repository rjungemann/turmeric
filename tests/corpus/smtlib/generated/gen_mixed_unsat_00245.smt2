(set-logic QF_UFLIA)
(set-info :status unsat)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(assert (=> (or (< x (g (* 2 y) 2)) (> (- w (* 1 y)) (+ z w))) (or (= (g 2 (- x 0)) -1) (> y (* -3 w)))))
(assert (< 3 2))
(assert (> (+ (+ w 10) (+ 5 -2)) w))
(assert (=> (not (> (g (+ 2 10) (+ w w)) (* -3 z))) (<= y w)))
(check-sat)
(exit)
