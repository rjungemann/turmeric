(set-logic QF_LIA)
(set-info :status unsat)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(assert (not (>= (+ 3 y) (- (+ 2 x) 2))))
(assert (and (>= x 0) (not (< (- (* 2 x) (+ 0 5)) -2))))
(assert (> w (+ 0 w)))
(assert (and (= x 0) (not (< (- 2 y) (* 2 x)))))
(check-sat)
(exit)
