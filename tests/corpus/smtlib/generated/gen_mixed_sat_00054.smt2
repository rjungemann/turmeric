(set-logic QF_UFLIA)
(set-info :status sat)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(assert (> (+ (f z) 3) (* -3 w)))
(assert (= (+ (* -2 w) 10) (* 5 x)))
(assert (=> (< (- x (+ 1 0)) x) (>= (* 3 w) (* 2 z))))
(assert (= (f (g x y)) (+ (g 2 -1) w)))
(assert (> (- z 2) 5))
(check-sat)
(exit)
