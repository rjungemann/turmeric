(set-logic QF_UFLIA)
(set-info :status unsat)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(assert (not (=> (> (g y 0) 0) (= x x))))
(assert (= (+ (* 1 x) (* -3 z)) w))
(assert (> -3 (f (* -1 x))))
(assert (not (=> (<= x z) (>= -3 w))))
(check-sat)
(exit)
