(set-logic QF_UFLIA)
(set-info :status unsat)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(assert (and (and (< w w) (> (+ y 5) x)) (<= (f -3) (f (g 1 0)))))
(assert (or (and (= (+ (g y 5) z) (g 0 w)) (<= z (* -3 y))) (or (> (+ -3 y) (f (- z w))) (= (- (g z -3) (f -3)) (* -3 z)))))
(check-sat)
(exit)
