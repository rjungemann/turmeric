(set-logic QF_UFLIA)
(set-info :status sat)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(assert (<= x 10))
(assert (=> (=> (<= (+ (f 2) 2) 10) (>= x (* 0 w))) (=> (= y x) (>= (+ (g z 0) -3) y))))
