(set-logic QF_LRA)
(set-info :status unsat)
(declare-fun p () Real)
(declare-fun q () Real)
(declare-fun r () Real)
(assert (< r (- (- -2.5 1.5) p)))
(assert (or (>= (- r q) 0.5) (not (< (+ (- 1.5 -2.5) r) p))))
(assert (> (- q (* 0.5 q)) (* 3.5 r)))
(assert (<= -2.5 p))
(assert (<= (* 0.0 r) -2.5))
(check-sat)
(exit)
