(set-logic QF_UFLIA)
(set-info :status sat)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(assert (or (<= (* 2 z) x) (= (- x y) w)))
(assert (=> (> (- w z) (+ (f 2) (* -2 y))) (<= x (- (f -2) (- 0 w)))))
(check-sat)
(exit)
