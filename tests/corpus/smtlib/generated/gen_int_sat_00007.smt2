(set-logic QF_LIA)
(set-info :status sat)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(assert (and (= (+ (+ 0 w) (- z 0)) y) (= (- (+ x -2) (* 5 z)) (- (- 10 x) (+ x 5)))))
(assert (=> (<= x z) (=> (= (+ (+ 5 -1) w) (- -1 3)) (> z (+ (+ 1 x) -2)))))
(check-sat)
(exit)
