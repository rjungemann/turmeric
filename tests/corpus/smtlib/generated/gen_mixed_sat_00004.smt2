(set-logic QF_UFLIA)
(set-info :status sat)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(assert (or (or (<= w (f w)) (< (+ z x) (g (+ 10 0) (- 5 0)))) (and (> (+ (+ 3 -2) (- z -1)) (* 2 y)) (<= (+ (+ 5 y) w) (- 0 -2)))))
(assert (and (= (g 10 (* -2 x)) (+ (+ z y) y)) (or (= (- 10 (* 5 z)) x) (<= -2 x))))
(check-sat)
(exit)
