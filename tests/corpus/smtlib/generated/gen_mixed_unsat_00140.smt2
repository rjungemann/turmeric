(set-logic QF_UFLIA)
(set-info :status unsat)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(assert (= w x))
(assert (>= (- (* -1 w) z) (f x)))
(assert (> z (+ (* 2 w) (+ 5 -1))))
(assert (or (>= (g (- 0 3) x) 2) (or (= z (+ (* 0 z) (* -3 w))) (< y (+ (f 5) (- 0 -1))))))
(assert (< 2 0))
(check-sat)
(exit)
