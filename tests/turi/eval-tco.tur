;; Phase TCO: tail call optimization tests.
;;
;; These functions would overflow the call stack without TCO at large N.
;; Expected stdout (for N=100000):
;;   100000
;;   5000050000
;;   done
;;   120
;;   0

;; --- Test 1: self-tail-recursive counter ---------------------------------
(defn count-down [n :int] :int
  (if (<= n 0)
    0
    (count-down (- n 1))))

(println (count-down 100000))

;; --- Test 2: accumulator tail recursion (sum 1..N) -----------------------
(defn sum-tc [n :int acc :int] :int
  (if (<= n 0)
    acc
    (sum-tc (- n 1) (+ acc n))))

(println (sum-tc 100000 0))

;; --- Test 3: mutual tail recursion (even?/odd? with if) -----------------
;; Uses if instead of match to avoid literal pattern matching (not yet in
;; interpreter; see interpreter-features-plan.md §1.1).

(defn even? [n :int] :bool
  (if (= n 0)
    true
    (odd? (- n 1))))

(defn odd? [n :int] :bool
  (if (= n 0)
    false
    (even? (- n 1))))

;; 1000 is even
(println (if (even? 1000) "done" "wrong"))

;; --- Test 4: tail call through let binding -------------------------------
(defn fact-tc [n :int acc :int] :int
  (if (<= n 1)
    acc
    (let [next-acc (* n acc)]
      (fact-tc (- n 1) next-acc))))

(println (fact-tc 5 1))

;; --- Test 5: tail call through do block ----------------------------------
(defn count-zero [n :int] :int
  (do
    (if (= n 0)
      0
      (count-zero (- n 1)))))

(println (count-zero 100000))

;; --- Test 6 (SR N2): recursion threaded through a field accessor ----------
;; The recursive call sits inside the operand of a `.v` field access
;; (`(.v (make-struct Box (fld-sum ...)))`).  Before SR N2 the field accessor
;; black-boxed its whole operand through eval_expr, so this deep non-tail
;; recursion C-recursed and tripped the eval_depth guard; the driver now models
;; EX_GET_FIELD (DK_GET_FIELD), folding the receiver onto the heap work-stack,
;; so it is heap-bounded.  fld-sum 99999 = 99999*100000/2 = 4999950000.
(defstruct Box [v :int])
(defn fld-sum [n :int] :int
  (if (= n 0)
    0
    (+ n (.v (make-struct Box (fld-sum (- n 1)))))))
(println (fld-sum 99999))

;; --- Test 7 (SR N3): recursion through a type ascription `::` -------------
;; The recursive call is the operand of a `(:: ... :int)` ascription, another
;; single-operand black-box form.  Before SR N3 the ascription black-boxed its
;; operand through eval_expr; the driver now models it (DK_UNARY), folding the
;; operand onto the work-stack.  asc-sum 80000 = 80000*80001/2 = 3200040000.
(defn asc-sum [n :int] :int
  (if (= n 0)
    0
    (+ n (:: (asc-sum (- n 1)) :int))))
(println (asc-sum 80000))

;; --- Test 8 (SR N3): recursion through (return ...) ----------------------
;; The recursive call is the operand of a `(return ...)`; the call boundary
;; consumes the returning flag, so the enclosing `+` still accumulates.  Modeled
;; by DK_UNARY too.  ret-sum 60000 = 60000*60001/2 = 1800030000.
(defn ret-sum [n :int] :int
  (if (= n 0)
    0
    (return (+ n (ret-sum (- n 1))))))
(println (ret-sum 60000))

;; --- Test 9 (SR N3b): abortive shift reached through a driven fn body ------
;; `shift-thunk`'s body is `(shift f n)` in tail position, so applying it
;; (`(shift-thunk 50000)`) drives EX_SHIFT in eval_drive_ex.  Before SR N3b the
;; driver black-boxed the shift through eval_expr, which applied the receiver f
;; on a re-entrant C frame (turi_call); the driver now models it
;; (DK_NATIVE_RESUME + abortive_shift_resume), so f(body) folds onto the
;; work-stack and then aborts to the reset boundary.  The receiver here does
;; deep non-tail recursion (`deep-shift v`), proving the callback is heap-bounded
;; through the driven shift; the enclosing `(+ 100 ...)` is discarded by the
;; abort.  deep-shift 50000 = 50000.
(defn deep-shift [n :int] :int
  (if (= n 0) 0 (+ 1 (deep-shift (- n 1)))))
(defn shift-thunk [n :int] :int
  (shift (fn [v :int] (deep-shift v)) n))
(println (reset (+ 100 (shift-thunk 50000))))
