;; Phase TCO: tail call optimization tests.
;;
;; These functions would overflow the call stack without TCO at large N.
;; Expected stdout (for N=100000):
;;   100000
;;   5000050000
;;   done
;;   120
;;   0

;; --- Test 1: self-tail-recursive counter ---------------------------------
(defn count-down [n :int] :int
  (if (<= n 0)
    0
    (count-down (- n 1))))

(println (count-down 100000))

;; --- Test 2: accumulator tail recursion (sum 1..N) -----------------------
(defn sum-tc [n :int acc :int] :int
  (if (<= n 0)
    acc
    (sum-tc (- n 1) (+ acc n))))

(println (sum-tc 100000 0))

;; --- Test 3: mutual tail recursion (even?/odd? with if) -----------------
;; Uses if instead of match to avoid literal pattern matching (not yet in
;; interpreter; see interpreter-features-plan.md §1.1).

(defn even? [n :int] :bool
  (if (= n 0)
    true
    (odd? (- n 1))))

(defn odd? [n :int] :bool
  (if (= n 0)
    false
    (even? (- n 1))))

;; 1000 is even
(println (if (even? 1000) "done" "wrong"))

;; --- Test 4: tail call through let binding -------------------------------
(defn fact-tc [n :int acc :int] :int
  (if (<= n 1)
    acc
    (let [next-acc (* n acc)]
      (fact-tc (- n 1) next-acc))))

(println (fact-tc 5 1))

;; --- Test 5: tail call through do block ----------------------------------
(defn count-zero [n :int] :int
  (do
    (if (= n 0)
      0
      (count-zero (- n 1)))))

(println (count-zero 100000))

;; --- Test 6 (SR N2): recursion threaded through a field accessor ----------
;; The recursive call sits inside the operand of a `.v` field access
;; (`(.v (make-struct Box (fld-sum ...)))`).  Before SR N2 the field accessor
;; black-boxed its whole operand through eval_expr, so this deep non-tail
;; recursion C-recursed and tripped the eval_depth guard; the driver now models
;; EX_GET_FIELD (DK_GET_FIELD), folding the receiver onto the heap work-stack,
;; so it is heap-bounded.  fld-sum 99999 = 99999*100000/2 = 4999950000.
(defstruct Box [v :int])
(defn fld-sum [n :int] :int
  (if (= n 0)
    0
    (+ n (.v (make-struct Box (fld-sum (- n 1)))))))
(println (fld-sum 99999))

;; --- Test 7 (SR N3): recursion through a type ascription `::` -------------
;; The recursive call is the operand of a `(:: ... :int)` ascription, another
;; single-operand black-box form.  Before SR N3 the ascription black-boxed its
;; operand through eval_expr; the driver now models it (DK_UNARY), folding the
;; operand onto the work-stack.  asc-sum 80000 = 80000*80001/2 = 3200040000.
(defn asc-sum [n :int] :int
  (if (= n 0)
    0
    (+ n (:: (asc-sum (- n 1)) :int))))
(println (asc-sum 80000))

;; --- Test 8 (SR N3): recursion through (return ...) ----------------------
;; The recursive call is the operand of a `(return ...)`; the call boundary
;; consumes the returning flag, so the enclosing `+` still accumulates.  Modeled
;; by DK_UNARY too.  ret-sum 60000 = 60000*60001/2 = 1800030000.
(defn ret-sum [n :int] :int
  (if (= n 0)
    0
    (return (+ n (ret-sum (- n 1))))))
(println (ret-sum 60000))

;; --- Test 9 (SR N3b): abortive shift reached through a driven fn body ------
;; `shift-thunk`'s body is `(shift f n)` in tail position, so applying it
;; (`(shift-thunk 50000)`) drives EX_SHIFT in eval_drive_ex.  Before SR N3b the
;; driver black-boxed the shift through eval_expr, which applied the receiver f
;; on a re-entrant C frame (turi_call); the driver now models it
;; (DK_NATIVE_RESUME + abortive_shift_resume), so f(body) folds onto the
;; work-stack and then aborts to the reset boundary.  The receiver here does
;; deep non-tail recursion (`deep-shift v`), proving the callback is heap-bounded
;; through the driven shift; the enclosing `(+ 100 ...)` is discarded by the
;; abort.  deep-shift 50000 = 50000.
(defn deep-shift [n :int] :int
  (if (= n 0) 0 (+ 1 (deep-shift (- n 1)))))
(defn shift-thunk [n :int] :int
  (shift (fn [v :int] (deep-shift v)) n))
(println (reset (+ 100 (shift-thunk 50000))))

;; --- Test 10 (SR N4): deeply NESTED reset/shift is heap-bounded -----------
;; Each level establishes its own (reset (+ 1 (shift ...))) and aborts to it.
;; Before SR N4 the reset boundary was a setjmp C frame (eval_reset_boundary),
;; so this nesting C-recursed and tripped the eval_depth guard at ~500 levels.
;; The driver now models the reset boundary on the work-stack (DK_RESET) and the
;; abortive shift unwinds via the env->aborting signal instead of longjmp, so the
;; nesting folds onto the heap.  Each level's shift aborts (discarding the +1),
;; so nest-sh N = 0 for all N.
(defn nest-sh [n :int] :int
  (if (= n 0)
    0
    (reset (+ 1 (shift (fn [v :int] (nest-sh (- n 1))) 0)))))
(println (nest-sh 200000))

;; --- Test 11 (SR N4 Slice 2): deeply NESTED call/cc is heap-bounded --------
;; Each level is its own (call/cc (fn [k] (+ 1 (g (- n 1))))) returning normally
;; (the escape k is never invoked).  Before SR N4 Slice 2 the call/cc boundary
;; was a setjmp escape pad (eval_callcc_escape), so this nesting C-recursed and
;; tripped the guard at ~500.  The driver now models it on the work-stack
;; (DK_ESCAPE) and (k v) unwinds via env->aborting, so it folds onto the heap.
;; nest-cc N adds 1 per level: nest-cc 200000 = 200000.
(defn nest-cc [n :int] :int
  (if (= n 0)
    0
    (call/cc (fn [k] (+ 1 (nest-cc (- n 1)))))))
(println (nest-cc 200000))

;; --- Test 12 (SR N4 Slice 3): nested serial/cloneable reset heap-bounded ----
;; A serial-/cloneable-reset whose body does not reach its capturing shift is a
;; plain prompt boundary; the driver models it on the work-stack (DK_RESET with
;; PROMPT_SERIAL/CLONEABLE) instead of the eval_reset_boundary C frame, so deep
;; nesting folds onto the heap (was: recursion limit at ~500).
(defn nest-cl [n :int] :int
  (if (= n 0) 0 (cloneable-reset (+ 1 (nest-cl (- n 1))))))
(println (nest-cl 200000))
(defn nest-se [n :int] :int
  (if (= n 0) 0 (serial-reset (+ 1 (nest-se (- n 1))))))
(println (nest-se 200000))

;; --- Test 13 (SR N4 Slice 4): recursive CAPTURING serial-shift heap-bounded -
;; The shift receiver recursively triggers another capturing serial-reset.
;; Before Slice 4 the receiver ran on a re-entrant C frame (ts_capture_and_run's
;; turi_call), so this C-recursed and tripped the guard at ~500.  The driver now
;; reifies the context (bounded) and applies the receiver on the work-stack
;; (DK_NATIVE_RESUME), folding the recursion onto the heap.  Each level aborts
;; into the shift (the +1 is discarded by the capture), so cap-rec N = 0.
(defn cap-rec [n :int] :int
  (serial-reset
    (+ 1 (serial-shift (fn [k] (if (= n 0) 0 (cap-rec (- n 1)))) 0))))
(println (cap-rec 200000))

;; --- Test 14 (SR N4 Slice 5): recursive continuation RESUME heap-bounded -----
;; A continuation captured by cloneable-shift is resumed; its captured frame
;; calls a function that captures + resumes another continuation.  Before Slice 5
;; ts_cont_resume applied each captured frame via a synchronous turi_call, so
;; this nested-resume C-recursed and tripped the guard at ~500.  The driver now
;; folds the resume on the work-stack (DK_CONT_FOLD), re-requesting each call
;; frame, so it is heap-bounded.  re-go N folds down to 0.
(defn re-step [x :int] :int (if (= x 0) 0 (re-go (- x 1))))
(defn re-go [n :int] :int
  (let [k (cloneable-reset (re-step (cloneable-shift (fn [kk] kk) 0)))]
    (tur_cloneable_cont_resume k n)))
(println (re-go 200000))

;; --- Test 15 (SR N4 Slice 6): recursive resume-cont! heap-bounded -----------
;; Same as Slice 5 but via the resume-cont!/save-cont! workflow native rather
;; than the tur_cloneable_cont_resume builtin.  Before Slice 6 native_resume_cont
;; folded synchronously in ts_cont_resume and C-recursed on nested resumes; the
;; driver now routes it through DK_CONT_FOLD too.  rc-go N folds down to 0.
(defn rc-step [x :int] :int (if (= x 0) 0 (rc-go (- x 1))))
(defn rc-go [n :int] :int
  (let [k (cloneable-reset (rc-step (cloneable-shift (fn [kk] kk) 0)))]
    (resume-cont! (save-cont! k) n)))
(println (rc-go 200000))

;; --- Test 16 (SR N4 Slice 7): recursive is_pure capture fold heap-bounded ----
;; When a capturing reset's body takes a pure (non-shift) arm at runtime, the
;; reified context is applied to that pure value via a fold.  Here the context is
;; a call frame `(ip-step _ n)` whose function recurses into another capturing
;; reset.  Before Slice 7 that fold ran synchronously in ts_cont_resume and
;; C-recursed; the driver now folds it on the work-stack (DK_CONT_FOLD).
;; ip-go N folds down to 0.
(defn ip-step [unused :int n :int] :int (if (= n 0) 0 (ip-go (- n 1))))
(defn ip-go [n :int] :int
  (cloneable-reset (ip-step (if (> n 0) 1 (cloneable-shift (fn [k] 0) 0)) n)))
(println (ip-go 200000))

;; (Former Test 17 -- "control operator inside a try body" -- removed: the
;; `try`/`catch` special form it exercised no longer exists in the language
;; (only `try-with` remains), so `(catch [e] 0)` now parses `[e]` as a vec
;; literal and errors with `unbound symbol 'e'` at elaboration, aborting the
;; whole `:reload`.  See docs/archive/history/eval-tco-stale-try-catch.md.)

;; --- Test 18 (C1): deeply NESTED catch-unwind stays heap-bounded ------------
;; Each level wraps the next recursion in its own (catch-unwind (fn [] ...)).
;; Phase C1 (turi-c-scoped-forms-heap-bounding-plan) models the catch-unwind
;; boundary on the driver work-stack (DK_CATCH_UNWIND) -- the thunk is applied
;; via the have_apply channel and a panic under it unwinds via the env->panicking
;; signal instead of a setjmp/longjmp landing pad -- so catch-unwind no longer
;; rides the eval_apply / eval_depth re-entry path (a prerequisite for retiring
;; the guard in C4).  The catch result is discarded; the outer level returns n,
;; so cu-rec N = N (reaching it proves the whole chain folded onto the heap).
;; (The COMPILED backend still C-recurses on this shape and SIGSEGVs at ~200000;
;; the interpreter succeeding here is the documented interpreter-superset stance.)
(defn cu-rec [n :int] :int
  (if (= n 0)
    0
    (do (catch-unwind (fn [] : int (cu-rec (- n 1)))) n)))
(println (cu-rec 200000))

;; --- Test 19 (C1): a panic signal propagates up deep recursion to a catch ----
;; deep-panic does deep non-tail recursion (heap-bounded since SR N2) and panics
;; at the bottom; a single top-level catch-unwind catches it.  With C1 the panic
;; is a work-stack signal, so it propagates up ~200000 driver frames to the
;; DK_CATCH_UNWIND boundary (firing each frame's defers on the way) without a
;; longjmp.  The catch result is discarded; cu-catch-deep N returns N.
(defn deep-panic [n :int] :int
  (if (= n 0) (panic "deep boom") (+ 1 (deep-panic (- n 1)))))
(defn cu-catch-deep [n :int] :int
  (do (catch-unwind (fn [] : int (deep-panic n))) n))
(println (cu-catch-deep 200000))

;; --- Test 20 (C2): deeply NESTED atomically is heap-bounded -----------------
;; Each level runs the next recursion inside its own (atomically (stm ...)).
;; Before Phase C2 the transaction boundary was an eval_atomically C frame plus
;; an eval_expr of the stm body, so this nesting C-recursed and tripped the
;; eval_depth guard ("recursion limit exceeded") at 200000.  The driver now
;; models the boundary on the work-stack (DK_ATOMICALLY) and the stm body
;; sequence too (DK_STM_SEQ), so the recursion inside the block folds onto the
;; heap.  Each atomically commits its (empty) write-log and returns the body
;; value, so at-rec N = N.
(defn at-rec [n :int] :int
  (if (= n 0) 0 (atomically (stm (+ 1 (at-rec (- n 1)))))))
(println (at-rec 200000))

;; --- Test 21 (C3): deeply NESTED effect handler is heap-bounded -------------
;; Two recursive-handler shapes that both used to trip the eval_depth guard
;; ("recursion limit exceeded") at 200000, because ws_capturable's static depth
;; budget rejected the self-recursive handler and the whole (handle ...) fell to
;; the ucontext fiber path (eval_handle), which C-recurses one fiber per level:
;;   - hb-rec: recursion in the handle BODY -- fixed by cycle-aware ws_capturable
;;     (Phase C3 Step 1), so the handle runs on the work-stack DK_PROMPT path and
;;     the body recursion folds.
;;   - hr-rec: recursion in the resume VALUE arg -- fixed by driving that arg on
;;     the work-stack (Phase C3 Step 2, DK_RESUME) instead of eval_expr.
;; Each level's handler resumes k, so both fold to n.
(defeffect TcoAsk [] :int)
(defn hb-rec [n :int] :int
  (if (= n 0) 0
    (handle (+ (perform (TcoAsk)) (hb-rec (- n 1)))
      (TcoAsk [] k) (resume k 1))))
(println (hb-rec 200000))
(defn hr-rec [n :int] :int
  (if (= n 0) 0
    (handle (+ 1 (perform (TcoAsk)))
      (TcoAsk [] k) (resume k (hr-rec (- n 1))))))
(println (hr-rec 200000))
