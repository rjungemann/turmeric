;; D4 sign-off probe: atom-rec -- a recursion carrying an int64-carrier
;; (defopaque handle) param, crossing catch-unwind.  step(c, n) folds to (c + n).
(defopaque Counter :int)

(defn step [c : Counter n : int] : int
  (if (= n 0)
    (:: c int)
    (do (catch-unwind (fn [] : int (step (:: (+ (:: c int) 1) Counter) (- n 1))))
        (+ (:: c int) n))))

(defn main [] : int
  (println (step (:: 0 Counter) 1000000))
  0)
