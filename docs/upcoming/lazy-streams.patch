 ;; Stream: the solution stream (list / backtracking monad) of search states.
 ;;   StNil             -- no solutions
 ;;   StCons subst rest -- one solution substitution, followed by the rest
+;;   StInc thunk       -- an IMMATURE stream: the rest of the search, not yet
+;;                        run.  This is what makes `run-logic 1` cost one
+;;                        solution instead of the whole search space, and what
+;;                        lets a recursive relation terminate at all.
 
-(defdata Stream :copy (StNil) (StCons :Subst :Stream))
+(defopaque StThunk :ptr<void>)
+
+(defdata Stream :copy (StNil) (StCons :Subst :Stream) (StInc :StThunk))
+
+;;; StThunk -- a delayed Stream, carrier is the fat-closure pointer.
+;;;
+;;; The carrier is `:ptr<void>` and NOT `:fn`: a `:fn` field accepts a
+;;; capturing closure, type-checks, and segfaults when it is forced, because
+;;; the ascription that calls it back assumes a bare function pointer while a
+;;; capturing lambda is a fat closure.  This is the same route `Goal` takes,
+;;; for the same reason.  See docs/reported/closure-in-defdata-field.md.
+;;;
+;;; Since: lazy-streams
+
+;;; st-force -- run a delayed stream one step.
+
+(defn st-force [th : StThunk] : Stream ((:: th (fn [] Stream))))
+;;; st-pull -- force a stream until it is mature (StNil or StCons).
+;;;
+;;; This is where laziness is cashed in: every consumer that needs to look at
+;;; the head of a stream pulls first, and only that much of the search runs.
+;;;
+;;; Parameters:
+;;;   xs -- a possibly-delayed stream
+;;;
+;;; Returns:
+;;;   The same stream forced to StNil or StCons.
+;;;
+;;; Since: lazy-streams
+
+(defn st-pull [xs : Stream] : Stream
+  (match xs (StInc th) (st-pull (st-force th)) _ xs))
