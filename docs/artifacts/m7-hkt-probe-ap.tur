;; M7 HKT-dispatch reference probe #3 -- Applicative `ap` shape. NOT a
;; test-suite fixture. Companion to m7-hkt-probe.tur (Functor `fmap`) and
;; m7-hkt-probe-bind.tur (Monad `bind`).
;;
;; The defining feature of `ap` (vs `fmap`/`bind`) is the FIRST argument
;;   ff : (f (fn [a] b))
;; -- an applied HKT type whose ELEMENT is itself a function type `(fn [a] b)`.
;; This stresses the element-tyvar threading on the arg side (the element of
;; `(f (fn [a] b))` is a fn, not a bare tyvar), where `fmap` had `(f a)` and
;; `bind` had a fn-RETURNING-applied continuation.
;;
;; Run: TUR_M7_HKT=1 ./build/tur run docs/artifacts/m7-hkt-probe-ap.tur; echo $?
;;   -> 42  (TARGET, REACHED 2026-06-18)
;;
;; STATUS (2026-06-18): WORKING end-to-end under TUR_M7_HKT=1 -- this probe now
;; exits 42 with NO ascription. Fix direction 1 of the (now archived) report
;; docs/archive/history/m7-hkt-ap-fn-element-carrier-erasure.md landed. With the flag
;; OFF the probe still errors by design (it has no ascriptions).
;;
;; What it took (three coordinated, flag-gated pieces):
;;   1. PRODUCER: a function value escaping into a type-variable parameter
;;      (`(some add1)` binding `some`'s `A`) is boxed via EX_FN_TO_FAT; the
;;      shim's STATIC type now keeps the precise `(fn [int] int)` signature
;;      (marked `boxed`) instead of erasing to `ptr<void>`, so `A` binds to the
;;      real fn type and `(some add1) : (Option (fn [int] int))`
;;      (src/compiler/elab_call.c). The runtime value is still a fat box.
;;   2. CALL SITE: with the producer type preserved, m7_collect_tyvar_bindings
;;      unifies decl `(f (fn a b))` against actual `(Option (fn int int))` and
;;      recovers `b` (the wrapped fn's RETURN type), so the result `(f b)`
;;      grounds to `(Option int)` and the by-value spec returns `Option__int`.
;;   3. INSTANCE BODY: the body param `ff : (Option (fn a b))` has its element
;;      fn marked `boxed` (m7_box_hkt_element_fns in elab_typeclasses.c) so
;;      calling the wrapped function -- `((.value ff) (.value fa))` -- dispatches
;;      through the fat-box thunk instead of bare-calling the box address.
;;
;; Verified for b = int (this probe -> 42) and b = cstr (the wrapped fn's RETURN
;; type drives `b` independently of `a`), and the `none` short-circuits.
;;
;; CAVEAT (legitimate inference boundary, not a bug): `(ap (none) (some 41))`
;; supplies NO function anywhere, so `b` (the wrapped fn's return type) is
;; genuinely uninferable; the fix-direction-3 guard then keeps the result
;; un-grounded and you get a clean `(type-app ? ?)` type error rather than a
;; miscompile. Annotate the `(none)` (or pass a real function) in that case.
;;
;; With the flag OFF the probe errors by design (no ascriptions).

(defclass MyApplicative [^f]
  (ap [ff : (f (fn [a] b)) fa : (f a)] : (f b)))

(definstance MyApplicative [Option]
  (ap [ff fa]
    (if (some? ff)
      (if (some? fa)
        (some ((.value ff) (.value fa)))
        (none))
      (none))))

(defn add1 [x : int] : int (+ x 1))

(defn main [] : int
  (let [r (ap (some add1) (some 41))]
    (unwrap r)))   ; TARGET: 42
