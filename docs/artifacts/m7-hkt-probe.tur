;; M7 HKT-dispatch reference probe -- NOT a test-suite fixture (it errors by
;; design with the flag OFF). It is the minimal end-to-end reproduction the M7
;; work is driven against. Kept out of tests/fixtures/ on purpose.
;;
;; Run it with: ./build/tur run docs/artifacts/m7-hkt-probe.tur
;;
;; BEHAVIOR ON HEAD, default (flag OFF) -- unchanged hard error:
;;   docs/artifacts/m7-hkt-probe.tur:<line>: error [TUR-E0001]:
;;     function 'unwrap' arg 1: expected (type-app Option tyvar 'A'),
;;     got (type-app ? ?)
;;   The producer `(gmap (some 21) dbl)` resolves to an anonymous
;;   `(type-app ? ?)` instead of `(Option int)`. (The shipped codegen path is
;;   byte-identical to HEAD; the suite runs with the flag OFF.)
;;
;; BEHAVIOR UNDER `TUR_M7_HKT=1` -- LANDED end-to-end (2026-06-19, layer 4):
;;   `TUR_M7_HKT=1 ./build/tur run docs/artifacts/m7-hkt-probe.tur; echo $?`
;;   exits 42 with NO ascription anywhere. The full chain now works:
;;     - elaborator threads g -> Option, a/b -> int  (layers 0-3, prior session)
;;     - the dispatch call attaches the element-tyvar abi_bindings (elab)
;;     - emit interns a per-(f, A) by-value instance-method spec
;;       `__inst_MyFunctor_gmap_Option__spec__Option__int_Option__int_int64_t`
;;       returning `Option__int` BY VALUE; its inner `(some ...)`/`(none)`
;;       constructs recover by value (`some__spec`, `none__spec`).
;;     - the carrier base method stays emitted for the (unused-here) dispatch
;;       dict; indirect/polymorphic HKT dispatch keeps the carrier ABI.
;;
;; The by-value path engages ONLY instance bodies that genuinely construct the
;; result IN-BODY (some/none/ok/...). Carrier inline-C bodies and bodies that
;; DELEGATE to a carrier helper (e.g. stdlib `Bifunctor [Result]` ->
;; `result-bimap [container : int]`) stay on the uniform-carrier dispatch even
;; under the flag, until the Phase-4.2 stdlib instance-body rewrites land. That
;; is why the flag is still default-OFF: enabling it by default needs Phase 4.2.

(defclass MyFunctor [^g]
  (gmap [container : (g a) f : (fn [a] b)] : (g b)))

(definstance MyFunctor [Option]
  (gmap [container f]
    (if (some? container) (some (f (.value container))) (none))))

(defn dbl [x : int] : int (* x 2))

(defn main [] : int
  (let [r (gmap (some 21) dbl)]
    (unwrap r)))   ; TARGET: 42
