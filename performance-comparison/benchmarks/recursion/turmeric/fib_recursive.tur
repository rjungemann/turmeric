;; fib_recursive -- naive doubly-recursive Fibonacci; tests call overhead.
(defn parse-first-arg [fallback :int] :int
  ```c
  struct __tur_cons { int64_t value; int64_t next; };
  struct __tur_cons *c = (struct __tur_cons *)(intptr_t)g_tur_args;
  return c ? (int64_t)atoll((const char *)(intptr_t)c->value) : fallback;
  ```)

(defn fib [n :int] :int
  (if (<= n 1)
    n
    (+ (fib (- n 1)) (fib (- n 2)))))

(println (fib (parse-first-arg 25)))
