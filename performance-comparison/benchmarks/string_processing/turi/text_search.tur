;; text_search -- count occurrences of "hello" in a generated string (interpreter-compatible).
;; Uses vec as a byte buffer instead of inline-C malloc/strstr.

;; hay-byte -- compute the haystack byte at position i.
;; Pattern: i%10 in {0..4} -> 'x' (120), {5} -> 'h', {6} -> 'e', {7,8} -> 'l', {9} -> 'o'.
;; (mod i 10) is recomputed in each branch to avoid use-after-move on the let binding.
(defn hay-byte [i :int] :int
  (if (< (mod i 10) 5) 120
    (if (= (mod i 10) 5) 104
      (if (= (mod i 10) 6) 101
        (if (= (mod i 10) 7) 108
          (if (= (mod i 10) 8) 108
            111))))))

;; fill-hay -- fill vec v of size n with the haystack pattern.
(defn fill-hay [v : (Vec int) i :int n :int] :nil
  (if (< i n)
    (do (vec-set! v i (hay-byte i))
        (fill-hay v (+ i 1) n))))

;; check-hello -- 1 if v[pos..pos+4] spells "hello" (104 101 108 108 111), 0 otherwise.
(defn check-hello [v : (Vec int) pos :int] :int
  (if (= (vec-get v pos) 104)
    (if (= (vec-get v (+ pos 1)) 101)
      (if (= (vec-get v (+ pos 2)) 108)
        (if (= (vec-get v (+ pos 3)) 108)
          (if (= (vec-get v (+ pos 4)) 111)
            1
            0)
          0)
        0)
      0)
    0))

;; search-loop -- count "hello" occurrences scanning pos from 0 to end-5 (inclusive).
(defn search-loop [v : (Vec int) pos :int end :int count :int] :int
  (if (> (+ pos 5) end)
    count
    (search-loop v (+ pos 1) end (+ count (check-hello v pos)))))

;; search-bench -- build haystack, count occurrences, return count.
(defn search-bench [hs_size :int] :int
  (let [v (vec-new-filled hs_size 0)]
    (do (fill-hay v 0 hs_size)
        (let [result (search-loop v 0 hs_size 0)]
          (do (vec-free v)
              result)))))

(println (search-bench (if (= *args* 0) 10000 (cstr->parse-int (head *args*)))))
