;; string_concat -- concatenate "hello" N times, print final length (interpreter-compatible).
;; Uses vec as a byte buffer instead of inline-C malloc/realloc.

;; fill-hello -- write "hello" bytes at position pos in vec v.
(defn fill-hello [v : (Vec int) pos :int] :nil
  (do (vec-set! v pos       104)
      (vec-set! v (+ pos 1) 101)
      (vec-set! v (+ pos 2) 108)
      (vec-set! v (+ pos 3) 108)
      (vec-set! v (+ pos 4) 111)))

;; concat-loop -- fill "hello" at offsets 0, 5, 10, ... in v.
(defn concat-loop [v : (Vec int) i :int n :int] :nil
  (if (< i n)
    (do (fill-hello v (* i 5))
        (concat-loop v (+ i 1) n))))

;; concat-bench -- build "hello"*n in a vec-backed buffer; return total byte count.
;; (* n 5) is computed twice to avoid use-after-move on a let binding.
(defn concat-bench [n :int] :int
  (let [v (vec-new-filled (* n 5) 0)]
    (do (concat-loop v 0 n)
        (vec-free v)
        (* n 5))))

(println (concat-bench (if (= *args* 0) 1000 (cstr->parse-int (head *args*)))))
