;; text_search -- count occurrences of "hello" in a generated string.
(defn head [lst :int] :int
  ```c
  struct { int64_t value; int64_t next; } *c = (void*)(intptr_t)lst;
  return c ? c->value : 0;
  ```)

(defn cstr->parse-int [s :int] :int
  ```c
  const char *cs = (const char *)(intptr_t)s;
  return cs ? (int64_t)atoll(cs) : 0;
  ```)

(defn search-bench [hs_size :int] :int
  ```c
  const char *needle = "hello";
  int nlen = 5;
  char *hay = malloc((size_t)(hs_size + 1));
  for (int64_t i = 0; i < hs_size; i++)
    hay[i] = (i % 10 < 5) ? 'x' : needle[(int)(i % 10) - 5];
  hay[hs_size] = '\0';
  int64_t count = 0;
  const char *p = hay;
  while ((p = strstr(p, needle)) != NULL) { count++; p += nlen; }
  free(hay);
  return count;
  ```)

(println (search-bench (if (= *args* 0) 10000 (cstr->parse-int (head *args*)))))
