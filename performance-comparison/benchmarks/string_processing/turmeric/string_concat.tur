;; string_concat -- concatenate "hello" N times, print final length.
(defn parse-first-arg [default :int] :int
  ```c
  struct __tur_cons { int64_t value; int64_t next; };
  struct __tur_cons *c = (struct __tur_cons *)(intptr_t)g_tur_args;
  return c ? (int64_t)atoll((const char *)(intptr_t)c->value) : default;
  ```)

(defn concat-bench [n :int] :int
  ```c
  const char *piece = "hello";
  size_t plen = 5;
  size_t total = 0;
  char *buf = malloc(1);
  buf[0] = '\0';
  for (int64_t i = 0; i < n; i++) {
    buf = realloc(buf, total + plen + 1);
    memcpy(buf + total, piece, plen + 1);
    total += plen;
  }
  free(buf);
  return (int64_t)total;
  ```)

(println (concat-bench (parse-first-arg 1000)))
