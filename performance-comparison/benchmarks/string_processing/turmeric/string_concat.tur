;; string_concat -- concatenate "hello" N times, print final length.
(defn head [lst :int] :int
  ```c
  struct { int64_t value; int64_t next; } *c = (void*)(intptr_t)lst;
  return c ? c->value : 0;
  ```)

(defn cstr->parse-int [s :int] :int
  ```c
  const char *cs = (const char *)(intptr_t)s;
  return cs ? (int64_t)atoll(cs) : 0;
  ```)

(defn concat-bench [n :int] :int
  ```c
  const char *piece = "hello";
  size_t plen = 5;
  size_t total = 0;
  char *buf = malloc(1);
  buf[0] = '\0';
  for (int64_t i = 0; i < n; i++) {
    buf = realloc(buf, total + plen + 1);
    memcpy(buf + total, piece, plen + 1);
    total += plen;
  }
  free(buf);
  return (int64_t)total;
  ```)

(println (concat-bench (if (= *args* 0) 1000 (cstr->parse-int (head *args*)))))
