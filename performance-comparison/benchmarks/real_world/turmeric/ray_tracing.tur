;; ray_tracing -- render width x height scene; print pixel checksum.
(defn head [lst :int] :int
  ```c
  struct { int64_t value; int64_t next; } *c = (void*)(intptr_t)lst;
  return c ? c->value : 0;
  ```)

(defn tail [lst :int] :int
  ```c
  struct { int64_t value; int64_t next; } *c = (void*)(intptr_t)lst;
  return c ? c->next : 0;
  ```)

(defn cstr->parse-int [s :int] :int
  ```c
  const char *cs = (const char *)(intptr_t)s;
  return cs ? (int64_t)atoll(cs) : 0;
  ```)

(defn run-raytracer [width :int height :int] :int
  ```c
  double sqrt(double);
  typedef struct { double x,y,z; } Vec3;
  typedef struct { Vec3 center; double radius; } Sphere;
  #define RT_ADD(a,b) ((Vec3){(a).x+(b).x,(a).y+(b).y,(a).z+(b).z})
  #define RT_SUB(a,b) ((Vec3){(a).x-(b).x,(a).y-(b).y,(a).z-(b).z})
  #define RT_SCALE(v,s) ((Vec3){(v).x*(s),(v).y*(s),(v).z*(s)})
  #define RT_DOT(a,b) ((a).x*(b).x+(a).y*(b).y+(a).z*(b).z)
  #define RT_NORM(v) RT_SCALE(v, 1.0/(sqrt(RT_DOT(v,v))+1e-15))
  Sphere spheres[]={{{0,0,-5},1.0},{{2,0,-7},1.5},{{-3,0,-6},0.8}};
  Vec3 light=RT_NORM(((Vec3){1,1,-1}));
  Vec3 origin={0,0,0};
  int64_t checksum=0;
  for (int64_t y=0; y<height; y++) {
    for (int64_t x=0; x<width; x++) {
      double u=((double)x/width)*2-1, v=((double)y/height)*2-1;
      Vec3 dir=RT_NORM(((Vec3){u,v,-1}));
      double best=1e18; int bi=-1;
      for (int i=0;i<3;i++) {
        Vec3 oc=RT_SUB(origin,spheres[i].center);
        double a=RT_DOT(dir,dir),b2=RT_DOT(oc,dir);
        double c=RT_DOT(oc,oc)-spheres[i].radius*spheres[i].radius;
        double d=b2*b2-a*c;
        if(d>=0){double t=(-b2-sqrt(d))/a; if(t>0.001&&t<best){best=t;bi=i;}}
      }
      if (bi>=0) {
        Vec3 hp=RT_ADD(origin,RT_SCALE(dir,best));
        Vec3 n=RT_NORM(RT_SUB(hp,spheres[bi].center));
        double diff=RT_DOT(n,light); if(diff<0) diff=0;
        checksum+=(int64_t)(diff*255);
      }
    }
  }
  #undef RT_ADD
  #undef RT_SUB
  #undef RT_SCALE
  #undef RT_DOT
  #undef RT_NORM
  return checksum;
  ```)

(println (run-raytracer
  (if (= *args* 0) 100 (cstr->parse-int (head *args*)))
  (if (= *args* 0) 75
    (if (= (tail *args*) 0) 75
      (cstr->parse-int (head (tail *args*)))))))
