;; ray_tracing -- render width x height scene; print pixel checksum.
(defn parse-arg [idx :int default :int] :int
  ```c
  struct __tur_cons { int64_t value; int64_t next; };
  struct __tur_cons *cell = (struct __tur_cons *)(intptr_t)g_tur_args;
  for (int64_t i = 0; i < idx && cell; i++)
    cell = (struct __tur_cons *)(intptr_t)cell->next;
  return cell ? (int64_t)atoll((const char *)(intptr_t)cell->value) : default;
  ```)

(defn run-raytracer [width :int height :int] :int
  ```c
  typedef struct { double x,y,z; } Vec3;
  typedef struct { Vec3 center; double radius; } Sphere;
  Vec3 vadd(Vec3 a, Vec3 b) { return (Vec3){a.x+b.x,a.y+b.y,a.z+b.z}; }
  Vec3 vsub(Vec3 a, Vec3 b) { return (Vec3){a.x-b.x,a.y-b.y,a.z-b.z}; }
  Vec3 vscale(Vec3 v, double s) { return (Vec3){v.x*s,v.y*s,v.z*s}; }
  double vdot(Vec3 a, Vec3 b) { return a.x*b.x+a.y*b.y+a.z*b.z; }
  Vec3 vnorm(Vec3 v) { double l=sqrt(vdot(v,v))+1e-15; return vscale(v,1/l); }
  int rhit(Sphere s, Vec3 ro, Vec3 rd, double *t) {
    Vec3 oc=vsub(ro,s.center);
    double a=vdot(rd,rd),b2=vdot(oc,rd),c=vdot(oc,oc)-s.radius*s.radius;
    double d=b2*b2-a*c; if(d<0) return 0;
    *t=(-b2-sqrt(d))/a; return *t>0.001;
  }
  Sphere spheres[]={{{0,0,-5},1.0},{{2,0,-7},1.5},{{-3,0,-6},0.8}};
  Vec3 light=vnorm((Vec3){1,1,-1});
  Vec3 origin={0,0,0};
  int64_t checksum=0;
  for (int64_t y=0; y<height; y++) {
    for (int64_t x=0; x<width; x++) {
      double u=((double)x/width)*2-1, v=((double)y/height)*2-1;
      Vec3 dir=vnorm((Vec3){u,v,-1});
      double best=1e18; int bi=-1;
      for (int i=0;i<3;i++) {
        double t; if(rhit(spheres[i],origin,dir,&t)&&t<best){best=t;bi=i;}
      }
      if (bi>=0) {
        Vec3 hp=vadd(origin,vscale(dir,best));
        Vec3 n=vnorm(vsub(hp,spheres[bi].center));
        double diff=fmax(0,vdot(n,light));
        checksum+=(int64_t)(diff*255);
      }
    }
  }
  return checksum;
  ```)

(println (run-raytracer (parse-arg 0 100) (parse-arg 1 75)))
