;; fibonacci -- iterative Fibonacci benchmark (interpreter-compatible).
(defn parse-first-arg [fallback :int] :int
  (if (= *args* 0)
    fallback
    (cstr->parse-int (head *args*))))

(defn fib-iter [i :int a :int b :int n :int] :int
  (if (> i n)
    b
    (fib-iter (+ i 1) b (+ a b) n)))

(defn fib [n :int] :int
  (fib-iter 2 0 1 n))

(println (fib (parse-first-arg 1000)))
