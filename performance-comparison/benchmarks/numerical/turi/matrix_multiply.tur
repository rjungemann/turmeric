;; matrix_multiply -- NxN dense matrix multiply (interpreter-compatible).
;; All algorithm logic in pure Turmeric using vec-new-filled/vec-get/vec-set!.
;; A and B are 1-filled NxN matrices stored flat; C = A*B; prints integer checksum.

;; matmul-loop -- triple loop: C[i*n+j] += A[i*n+k] * B[k*n+j]
;; Expressed as three nested tail-recursive loops over j, k, i.
(defn matmul-j [a : (Vec int) b : (Vec int) c : (Vec int) n :int i :int k :int j :int] :nil
  (if (>= j n)
    nil
    (do (vec-set! c (+ (* i n) j)
                  (+ (vec-get c (+ (* i n) j))
                     (* (vec-get a (+ (* i n) k))
                        (vec-get b (+ (* k n) j)))))
        (matmul-j a b c n i k (+ j 1)))))

(defn matmul-k [a : (Vec int) b : (Vec int) c : (Vec int) n :int i :int k :int] :nil
  (if (>= k n)
    nil
    (do (matmul-j a b c n i k 0)
        (matmul-k a b c n i (+ k 1)))))

(defn matmul-i [a : (Vec int) b : (Vec int) c : (Vec int) n :int i :int] :nil
  (if (>= i n)
    nil
    (do (matmul-k a b c n i 0)
        (matmul-i a b c n (+ i 1)))))

;; sum-loop -- sum all elements of the result matrix.
(defn sum-loop [c : (Vec int) total :int i :int n2 :int] :int
  (if (>= i n2)
    total
    (sum-loop c (+ total (vec-get c i)) (+ i 1) n2)))

(defn matmul-checksum [n :int] :int
  (let [a    (vec-new-filled (* n n) 1)
        b    (vec-new-filled (* n n) 1)
        c    (vec-new-filled (* n n) 0)]
    (do (matmul-i a b c n 0)
        (let [s (sum-loop c 0 0 (* n n))]
          (do (vec-free a) (vec-free b) (vec-free c)
              s)))))

(println (matmul-checksum (if (= *args* 0) 10 (cstr->parse-int (head *args*)))))
