;; monte_carlo_pi -- Monte Carlo estimation of pi (interpreter-compatible).
;; LCG step and loop are pure Turmeric; bit-shr, int->unit-float, println-float
;; are registered native shims.

;; lcg-next -- advance the LCG state.
(defn lcg-next [state :int] :int
  (+ (* state 6364136223846793005) 1442695040888963407))

;; mc-loop -- tail-recursive Monte Carlo inner loop.
(defn mc-loop [i :int n :int state :int inside :int] :int
  (if (>= i n)
    inside
    (let [s1 (lcg-next state)
          x  (int->unit-float (bit-shr s1 11))
          s2 (lcg-next s1)
          y  (int->unit-float (bit-shr s2 11))]
      (mc-loop (+ i 1) n s2
               (if (<= (+ (* x x) (* y y)) 1.0)
                 (+ inside 1)
                 inside)))))

;; estimate-pi -- run Monte Carlo and print the result.
(defn estimate-pi [iters :int] :nil
  (let [inside (mc-loop 0 iters 6364136223846793005 0)]
    (println-float (/ (* 4.0 (int->float inside)) (int->float iters)) 6)))

(estimate-pi (if (= *args* 0) 1000 (cstr->parse-int (head *args*))))
