;; primes -- sieve of Eratosthenes benchmark (interpreter-compatible).
;; Uses vec from stdlib instead of raw calloc/array ops.

;; mark-multiples -- tail-recursive: mark j, j+step, j+2*step, ... as composite.
(defn mark-multiples [s : (Vec int) j :int step :int limit :int] :nil
  (if (<= j limit)
    (do (vec-set! s j 1)
        (mark-multiples s (+ j step) step limit))))

;; count-primes-loop -- tail-recursive outer sieve loop.
(defn count-primes-loop [s : (Vec int) i :int limit :int count :int] :int
  (if (> i limit)
    count
    (if (= (vec-get s i) 0)
      (do (mark-multiples s (* 2 i) i limit)
          (count-primes-loop s (+ i 1) limit (+ count 1)))
      (count-primes-loop s (+ i 1) limit count))))

;; count-primes -- allocate a vec<int> sieve and run the algorithm.
(defn count-primes [limit :int] :int
  (let [s (vec-new-filled (+ limit 1) 0)]
    (let [result (count-primes-loop s 2 limit 0)]
      (vec-free s)
      result)))

(println (count-primes (if (= *args* 0) 10000 (cstr->parse-int (head *args*)))))
