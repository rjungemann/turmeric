;; monte_carlo_pi -- Monte Carlo estimation of pi using LCG PRNG.
(defn parse-first-arg [default :int] :int
  ```c
  struct __tur_cons { int64_t value; int64_t next; };
  struct __tur_cons *c = (struct __tur_cons *)(intptr_t)g_tur_args;
  return c ? (int64_t)atoll((const char *)(intptr_t)c->value) : default;
  ```)

(defn estimate-pi [iters :int] :int
  ```c
  /* LCG PRNG -- same constants as C benchmark for reproducibility */
  uint64_t state = 6364136223846793005ULL;
  #define LCG_NEXT() ({ state = state * 6364136223846793005ULL + 1442695040888963407ULL; \
                        (double)(state >> 11) / (double)(1ULL << 53); })
  int64_t inside = 0;
  for (int64_t i = 0; i < iters; i++) {
    double x = LCG_NEXT(), y = LCG_NEXT();
    if (x * x + y * y <= 1.0) inside++;
  }
  /* Return pi * 1e6 as integer to avoid float printing */
  return (int64_t)(4.0 * inside / iters * 1e6);
  #undef LCG_NEXT
  ```)

(let [pi6 (estimate-pi (parse-first-arg 1000))]
  (println pi6))
