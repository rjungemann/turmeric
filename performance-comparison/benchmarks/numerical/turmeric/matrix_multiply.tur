;; matrix_multiply -- NxN dense matrix multiply benchmark (A=B=1-filled).
(defn head [lst :int] :int
  ```c
  struct { int64_t value; int64_t next; } *c = (void*)(intptr_t)lst;
  return c ? c->value : 0;
  ```)

(defn cstr->parse-int [s :int] :int
  ```c
  const char *cs = (const char *)(intptr_t)s;
  return cs ? (int64_t)atoll(cs) : 0;
  ```)

(defn matmul-checksum [n :int] :int
  ```c
  int ni = (int)n;
  double *A = malloc((size_t)(ni * ni) * sizeof(double));
  double *B = malloc((size_t)(ni * ni) * sizeof(double));
  double *C = calloc((size_t)(ni * ni), sizeof(double));
  for (int i = 0; i < ni * ni; i++) { A[i] = 1.0; B[i] = 1.0; }
  for (int i = 0; i < ni; i++)
    for (int k = 0; k < ni; k++)
      for (int j = 0; j < ni; j++)
        C[i * ni + j] += A[i * ni + k] * B[k * ni + j];
  double s = 0;
  for (int i = 0; i < ni * ni; i++) s += C[i];
  free(A); free(B); free(C);
  return (int64_t)s;
  ```)

(println (matmul-checksum (if (= *args* 0) 10 (cstr->parse-int (head *args*)))))
