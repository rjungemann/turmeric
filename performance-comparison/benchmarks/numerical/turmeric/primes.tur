;; primes -- sieve of Eratosthenes benchmark.
(defn parse-first-arg [default :int] :int
  ```c
  struct __tur_cons { int64_t value; int64_t next; };
  struct __tur_cons *c = (struct __tur_cons *)(intptr_t)g_tur_args;
  return c ? (int64_t)atoll((const char *)(intptr_t)c->value) : default;
  ```)

(defn count-primes [limit :int] :int
  ```c
  char *sieve = calloc((size_t)(limit + 1), 1);
  int64_t count = 0;
  for (int64_t i = 2; i <= limit; i++) {
    if (!sieve[i]) {
      count++;
      for (int64_t j = 2 * i; j <= limit; j += i) sieve[j] = 1;
    }
  }
  free(sieve);
  return count;
  ```)

(println (count-primes (parse-first-arg 10000)))
