;; primes -- sieve of Eratosthenes benchmark.
;; The sieve array is managed by thin inline-C helpers; the nested loop
;; algorithm is expressed as pure Turmeric tail-recursion.
(defn head [lst :int] :int
  ```c
  struct { int64_t value; int64_t next; } *c = (void*)(intptr_t)lst;
  return c ? c->value : 0;
  ```)

(defn cstr->parse-int [s :int] :int
  ```c
  const char *cs = (const char *)(intptr_t)s;
  return cs ? (int64_t)atoll(cs) : 0;
  ```)

;; sieve-new -- allocate a zero-filled int array of 'size' elements.
(defn sieve-new [size :int] :ptr<void>
  ```c
  return calloc((size_t)size, sizeof(int64_t));
  ```)

;; sieve-get -- read element i from the sieve.
(defn sieve-get [s :ptr<void> i :int] :int
  ```c
  return ((int64_t *)s)[i];
  ```)

;; sieve-set -- write 1 to element i (mark composite).
(defn sieve-set! [s :ptr<void> i :int] :nil
  ```c
  ((int64_t *)s)[i] = 1;
  ```)

;; sieve-free -- release the sieve array.
(defn sieve-free [s :ptr<void>] :nil
  ```c
  free(s);
  ```)

;; mark-multiples -- tail-recursive inner loop: mark j, j+step, j+2*step, ...
(defn mark-multiples [s :ptr<void> j :int step :int limit :int] :nil
  (if (<= j limit)
    (do (sieve-set! s j)
        (mark-multiples s (+ j step) step limit))))

;; count-primes-loop -- tail-recursive outer loop.
(defn count-primes-loop [s :ptr<void> i :int limit :int count :int] :int
  (if (> i limit)
    count
    (if (= (sieve-get s i) 0)
      (do (mark-multiples s (* 2 i) i limit)
          (count-primes-loop s (+ i 1) limit (+ count 1)))
      (count-primes-loop s (+ i 1) limit count))))

;; count-primes -- run the sieve up to limit; return prime count.
(defn count-primes [limit :int] :int
  (let [s (sieve-new (+ limit 1))]
    (let [result (count-primes-loop s 2 limit 0)]
      (sieve-free s)
      result)))

(println (count-primes (if (= *args* 0) 10000 (cstr->parse-int (head *args*)))))
