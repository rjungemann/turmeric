;; file_write -- write N bytes to a temp file; print bytes written.
;; Buffer allocation uses raw builtins; write is via inline-C helpers;
;; the write loop is pure Turmeric tail-recursion.
(defn parse-first-arg [fallback :int] :int
  ```c
  struct __tur_cons { int64_t value; int64_t next; };
  struct __tur_cons *c = (struct __tur_cons *)(intptr_t)g_tur_args;
  return c ? (int64_t)atoll((const char *)(intptr_t)c->value) : fallback;
  ```)

;; io-alloc -- allocate n bytes and fill them with byte value v.
(defn io-alloc [n :int v :int] :ptr<void>
  ```c
  void *buf = malloc((size_t)n);
  memset(buf, (int)v, (size_t)n);
  return buf;
  ```)

;; io-free -- release a buffer.
(defn io-free [buf :ptr<void>] :nil
  ```c
  free(buf);
  ```)

;; io-fopen -- open a file for writing.
(defn io-fopen-write [path :cstr] :ptr<void>
  ```c
  return (void *)fopen(path, "wb");
  ```)

;; io-fwrite-chunk -- write up to chunk_size bytes from buf+offset to fp;
;; returns bytes actually written.
(defn io-fwrite-chunk [fp :ptr<void> buf :ptr<void> offset :int chunk :int] :int
  ```c
  return (int64_t)fwrite((char *)buf + offset, 1, (size_t)chunk, (FILE *)fp);
  ```)

;; io-fclose -- close a file handle.
(defn io-fclose [fp :ptr<void>] :nil
  ```c
  fclose((FILE *)fp);
  ```)

;; io-remove -- delete a file.
(defn io-remove [path :cstr] :nil
  ```c
  remove(path);
  ```)

;; write-loop -- tail-recursive write loop in 4096-byte chunks.
(defn write-loop [fp :ptr<void> buf :ptr<void> written :int n :int] :int
  (if (>= written n)
    written
    (let [chunk (if (< (- n written) 4096) (- n written) 4096)]
      (let [w (io-fwrite-chunk fp buf written chunk)]
        (write-loop fp buf (+ written w) n)))))

;; file-write-bench -- allocate buffer, open file, write, close, remove.
(defn file-write-bench [n :int] :int
  (let [buf (io-alloc 4096 171)]
    (let [fp (io-fopen-write "/tmp/bench_io_write_tur.bin")]
      (let [written (write-loop fp buf 0 n)]
        (do (io-fclose fp)
            (io-remove "/tmp/bench_io_write_tur.bin")
            (io-free buf)
            written)))))

(println (file-write-bench (parse-first-arg 1048576)))
