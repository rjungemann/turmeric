;; random_access -- write file_size bytes, do n_reads random seeks, print checksum.
(defn head [lst :int] :int
  ```c
  struct { int64_t value; int64_t next; } *c = (void*)(intptr_t)lst;
  return c ? c->value : 0;
  ```)

(defn tail [lst :int] :int
  ```c
  struct { int64_t value; int64_t next; } *c = (void*)(intptr_t)lst;
  return c ? c->next : 0;
  ```)

(defn cstr->parse-int [s :int] :int
  ```c
  const char *cs = (const char *)(intptr_t)s;
  return cs ? (int64_t)atoll(cs) : 0;
  ```)

(defn random-access-bench [file_size :int n_reads :int] :int
  ```c
  const char *path = "/tmp/bench_io_random_tur.bin";
  char wbuf[4096];
  FILE *fw = fopen(path, "wb");
  if (!fw) { perror("fopen"); return -1; }
  int64_t rem = file_size; int seq = 0;
  while (rem > 0) {
    int64_t chunk = rem < 4096 ? rem : 4096;
    for (int64_t i = 0; i < chunk; i++) wbuf[i] = (char)(seq++ & 0xFF);
    fwrite(wbuf, 1, (size_t)chunk, fw); rem -= chunk;
  }
  fclose(fw);
  FILE *fr = fopen(path, "rb");
  if (!fr) { perror("fopen read"); return -1; }
  uint64_t state = 12345678ULL;
  int64_t checksum = 0; unsigned char byte;
  for (int64_t i = 0; i < n_reads; i++) {
    state = state * 6364136223846793005ULL + 1442695040888963407ULL;
    int64_t offset = (int64_t)(state >> 1) % file_size;
    fseek(fr, offset, SEEK_SET);
    if (fread(&byte, 1, 1, fr)) checksum += byte;
  }
  fclose(fr); remove(path);
  return checksum;
  ```)

(println (random-access-bench
  (if (= *args* 0) 1048576 (cstr->parse-int (head *args*)))
  (if (= *args* 0) 1000
    (if (= (tail *args*) 0) 1000
      (cstr->parse-int (head (tail *args*)))))))
