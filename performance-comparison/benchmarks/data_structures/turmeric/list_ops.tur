;; list_ops -- prepend N integers to a singly-linked list, sum them.
;; Cons cells are allocated with tiny inline-C helpers; the build/sum
;; algorithm is pure Turmeric tail-recursion.
(defn head [lst :int] :int
  ```c
  struct { int64_t value; int64_t next; } *c = (void*)(intptr_t)lst;
  return c ? c->value : 0;
  ```)

(defn cstr->parse-int [s :int] :int
  ```c
  const char *cs = (const char *)(intptr_t)s;
  return cs ? (int64_t)atoll(cs) : 0;
  ```)

;; cons-make -- allocate a new cons cell (value, next pointer).
(defn cons-make [val :int nxt :ptr<void>] :ptr<void>
  ```c
  int64_t *cell = (int64_t *)malloc(2 * sizeof(int64_t));
  cell[0] = val;
  cell[1] = (int64_t)(intptr_t)nxt;
  return (void *)cell;
  ```)

;; cons-nil -- the empty list sentinel (NULL pointer).
(defn cons-nil [] :ptr<void>
  ```c
  return NULL;
  ```)

;; cons-nil? -- true if cell is the empty list.
(defn cons-nil? [cell :ptr<void>] :bool
  ```c
  return cell == NULL;
  ```)

;; cons-head -- return the value stored in a cons cell.
(defn cons-head [cell :ptr<void>] :int
  ```c
  return ((int64_t *)cell)[0];
  ```)

;; cons-tail -- return the next pointer from a cons cell.
(defn cons-tail [cell :ptr<void>] :ptr<void>
  ```c
  return (void *)(intptr_t)((int64_t *)cell)[1];
  ```)

;; cons-free-all -- free every cell in the list.
(defn cons-free-all [cell :ptr<void>] :nil
  ```c
  while (cell) {
    void *nxt = (void *)(intptr_t)((int64_t *)cell)[1];
    free(cell);
    cell = nxt;
  }
  ```)

;; build-list -- prepend integers [0, n) onto acc using tail recursion.
(defn build-list [i :int n :int acc :ptr<void>] :ptr<void>
  (if (>= i n)
    acc
    (build-list (+ i 1) n (cons-make i acc))))

;; sum-list -- accumulate the values of a cons list via tail recursion.
(defn sum-list [lst :ptr<void> acc :int] :int
  (if (cons-nil? lst)
    acc
    (sum-list (cons-tail lst) (+ acc (cons-head lst)))))

(let [n   (if (= *args* 0) 1000 (cstr->parse-int (head *args*)))
      lst (build-list 0 n (cons-nil))
      s   (sum-list lst 0)]
  (cons-free-all lst)
  (println s))
