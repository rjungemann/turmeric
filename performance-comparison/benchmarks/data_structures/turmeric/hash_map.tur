;; hash_map -- insert N integer key->value pairs into a HAMT; sum all values.
;; Uses the auto-loaded HAMT with thin inline-C helpers to box/unbox integers
;; as opaque pointers; insert and lookup loops are pure Turmeric.
(defn parse-first-arg [fallback :int] :int
  ```c
  struct __tur_cons { int64_t value; int64_t next; };
  struct __tur_cons *c = (struct __tur_cons *)(intptr_t)g_tur_args;
  return c ? (int64_t)atoll((const char *)(intptr_t)c->value) : fallback;
  ```)

;; int->ptr -- encode an integer as an opaque pointer for HAMT storage.
(defn int->ptr [n :int] :ptr<void>
  ```c
  return (void *)(intptr_t)n;
  ```)

;; ptr->int -- decode an opaque pointer back to an integer.
(defn ptr->int [p :ptr<void>] :int
  ```c
  return (int64_t)(intptr_t)p;
  ```)

;; insert-loop -- insert i -> i*2 for each i in [0, n) into HAMT m.
(defn insert-loop [m :ptr<void> i :int n :int] :ptr<void>
  (if (>= i n)
    m
    (insert-loop
      (hamt/set m
                (hamt/hash-ptr (int->ptr i))
                (int->ptr i)
                (int->ptr (* i 2)))
      (+ i 1)
      n)))

;; sum-loop -- look up every key [0, n) and accumulate the values.
(defn sum-loop [m :ptr<void> i :int n :int acc :int] :int
  (if (>= i n)
    acc
    (let [v (hamt/get m (hamt/hash-ptr (int->ptr i)) (int->ptr i))]
      (sum-loop m (+ i 1) n (+ acc (ptr->int v))))))

;; hashmap-bench -- build map, sum values, free map.
(defn hashmap-bench [n :int] :int
  (let [m (insert-loop (hamt/new) 0 n)]
    (let [s (sum-loop m 0 n 0)]
      (hamt/free m)
      s)))

(println (hashmap-bench (parse-first-arg 1000)))
