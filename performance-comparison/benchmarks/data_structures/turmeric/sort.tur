;; sort -- sort N pseudo-random int64 values; print min and max.
;; The LCG fill loop is pure Turmeric tail-recursion; sorting and raw array
;; ops use thin inline-C helpers.
(defn parse-first-arg [fallback :int] :int
  ```c
  struct __tur_cons { int64_t value; int64_t next; };
  struct __tur_cons *c = (struct __tur_cons *)(intptr_t)g_tur_args;
  return c ? (int64_t)atoll((const char *)(intptr_t)c->value) : fallback;
  ```)

;; arr-new -- allocate an uninitialized int64 array of n elements.
(defn arr-new [n :int] :ptr<void>
  ```c
  return malloc((size_t)n * sizeof(int64_t));
  ```)

;; arr-free -- release an array allocated with arr-new.
(defn arr-free [arr :ptr<void>] :nil
  ```c
  free(arr);
  ```)

;; arr-set! -- write val at index i.
(defn arr-set! [arr :ptr<void> i :int val :int] :nil
  ```c
  ((int64_t *)arr)[i] = val;
  ```)

;; arr-get -- read element at index i.
(defn arr-get [arr :ptr<void> i :int] :int
  ```c
  return ((int64_t *)arr)[i];
  ```)

;; arr-sort! -- sort n int64 elements of arr in ascending order.
(defn arr-sort! [arr :ptr<void> n :int] :nil
  ```c
  qsort(arr, (size_t)n, sizeof(int64_t), __tur_set_cmp);
  ```)

;; print-pair -- print two int64 values separated by a space.
(defn print-pair [a :int b :int] :nil
  ```c
  printf("%lld %lld\n", (long long)a, (long long)b);
  ```)

;; bit-shr1 -- logical right shift by 1 bit (to keep values non-negative).
(defn bit-shr1 [x :int] :int
  ```c
  return (int64_t)((uint64_t)x >> 1);
  ```)

;; lcg-next -- advance the LCG state.
(defn lcg-next [state :int] :int
  (+ (* state 6364136223846793005) 1442695040888963407))

;; fill-loop -- tail-recursive fill: write LCG values into arr[0..n).
(defn fill-loop [arr :ptr<void> i :int n :int state :int] :nil
  (if (< i n)
    (let [s (lcg-next state)]
      (do (arr-set! arr i (bit-shr1 s))
          (fill-loop arr (+ i 1) n s)))))

;; sort-bench -- allocate, fill, sort, report min/max, free.
(defn sort-bench [n :int] :nil
  (let [arr (arr-new n)]
    (do (fill-loop arr 0 n 12345)
        (arr-sort! arr n)
        (print-pair (arr-get arr 0) (arr-get arr (- n 1)))
        (arr-free arr))))

(sort-bench (parse-first-arg 1000))
