;; list_ops -- prepend N integers to a singly-linked list, sum them (interpreter-compatible).
;; Uses stdlib cons/head/tail operations.

;; build-list -- prepend integers [0, n) onto acc using tail recursion.
(defn build-list [i :int n :int acc :int] :int
  (if (>= i n)
    acc
    (build-list (+ i 1) n (cons i acc))))

;; sum-list -- accumulate the values of a cons list via tail recursion.
(defn sum-list [lst :int acc :int] :int
  (if (= lst 0)
    acc
    (sum-list (tail lst) (+ acc (head lst)))))

(let [n   (if (= *args* 0) 1000 (cstr->parse-int (head *args*)))
      lst (build-list 0 n (nil-value))
      s   (sum-list lst 0)]
  (println s))
