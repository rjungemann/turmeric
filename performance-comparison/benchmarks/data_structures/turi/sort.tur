;; sort -- sort N pseudo-random int64 values; print min and max (interpreter-compatible).
;; Uses vec from stdlib. Sorting done with insertion sort (O(N^2), sufficient for small N).

;; lcg-next -- advance the LCG state.
(defn lcg-next [state :int] :int
  (+ (* state 6364136223846793005) 1442695040888963407))

;; fill-loop -- fill vec with non-negative LCG values.
(defn fill-loop [v : (Vec int) i :int n :int state :int] :nil
  (if (< i n)
    (let [s (lcg-next state)]
      (do (vec-set! v i (bit-shr s 1))
          (fill-loop v (+ i 1) n s)))))

;; insertion-sort: shift elements right to find position for arr[i].
(defn insert-elem [v : (Vec int) i :int key :int] :nil
  (if (and (>= i 0) (> (vec-get v i) key))
    (do (vec-set! v (+ i 1) (vec-get v i))
        (insert-elem v (- i 1) key))
    (vec-set! v (+ i 1) key)))

(defn isort-loop [v : (Vec int) i :int n :int] :nil
  (if (>= i n)
    nil
    (do (insert-elem v (- i 1) (vec-get v i))
        (isort-loop v (+ i 1) n))))

(defn sort-bench [n :int] :nil
  (let [v (vec-new-filled n 0)]
    (do (fill-loop v 0 n 12345)
        (isort-loop v 1 n)
        (println (vec-get v 0))
        (println (vec-get v (- n 1)))
        (vec-free v))))

(sort-bench (if (= *args* 0) 1000 (cstr->parse-int (head *args*))))
