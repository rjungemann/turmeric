;; hash_map -- insert N key->value pairs into HAMT; sum all values (interpreter-compatible).
;; hamt-new/set/get/hash-ptr/free are provided by interpreter native shims (see cmd_eval stubs).

;; insert-loop -- insert i -> i*2 for each i in [0, n) into HAMT m.
(defn insert-loop [m :int i :int n :int] :int
  (if (>= i n)
    m
    (insert-loop
      (hamt-set m (hamt-hash-ptr i) i (* i 2))
      (+ i 1)
      n)))

;; sum-loop -- look up every key [0, n) and accumulate the values.
(defn sum-loop [m :int i :int n :int acc :int] :int
  (if (>= i n)
    acc
    (sum-loop m (+ i 1) n (+ acc (hamt-get m (hamt-hash-ptr i) i)))))

;; hashmap-bench -- build map, sum values, free map.
(defn hashmap-bench [n :int] :int
  (let [m (insert-loop (hamt-new) 0 n)]
    (let [s (sum-loop m 0 n 0)]
      (hamt-free m)
      s)))

(println (hashmap-bench (if (= *args* 0) 1000 (cstr->parse-int (head *args*)))))
