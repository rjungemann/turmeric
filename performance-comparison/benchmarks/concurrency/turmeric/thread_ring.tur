;; thread_ring -- pass a token around N threads M times (inline-C pthreads).
(defn head [lst :int] :int
  ```c
  struct { int64_t value; int64_t next; } *c = (void*)(intptr_t)lst;
  return c ? c->value : 0;
  ```)

(defn tail [lst :int] :int
  ```c
  struct { int64_t value; int64_t next; } *c = (void*)(intptr_t)lst;
  return c ? c->next : 0;
  ```)

(defn cstr->parse-int [s :int] :int
  ```c
  const char *cs = (const char *)(intptr_t)s;
  return cs ? (int64_t)atoll(cs) : 0;
  ```)

;; ring-worker -- pthread worker: receives token, decrements, passes to next slot.
(defn ring-worker [vp :ptr<void>] :ptr<void>
  ```c
  typedef struct {
    pthread_mutex_t mu;
    pthread_cond_t  cv;
    int             ready;
    int64_t         token;
  } TRSlot;
  typedef struct { TRSlot *ring; int id; int n; } TRArg;
  TRArg *a = (TRArg *)vp;
  TRSlot *me   = &a->ring[a->id];
  TRSlot *next = &a->ring[(a->id + 1) % a->n];
  while (1) {
    pthread_mutex_lock(&me->mu);
    while (!me->ready) pthread_cond_wait(&me->cv, &me->mu);
    int64_t tok = me->token; me->ready = 0;
    pthread_mutex_unlock(&me->mu);
    int64_t out = tok > 0 ? tok - 1 : tok;
    pthread_mutex_lock(&next->mu);
    next->token = out; next->ready = 1;
    pthread_cond_signal(&next->cv);
    pthread_mutex_unlock(&next->mu);
    if (tok <= 0) return NULL;
  }
  ```)

;; run-ring -- pass a token around n_threads pthreads, decrementing it each
;; hop, until it reaches zero. ring-worker is a sibling defn referenced from
;; this block's pthread_create call via the documented __TUR_CNAME_<name>__
;; splice (docs/guides/c-integration-guide.md) rather than a hand-spelled
;; mangled name -- the mangler is an internal detail (e.g. `ring-worker`
;; does not mangle to `ring_worker`) and a stale guess fails the C compile
;; with no Turmeric-level warning.
(defn run-ring [n_threads :int messages :int] :void
  ```c
  typedef struct {
    pthread_mutex_t mu;
    pthread_cond_t  cv;
    int             ready;
    int64_t         token;
  } TRSlot;
  typedef struct { TRSlot *ring; int id; int n; } TRArg;
  TRSlot *ring = (TRSlot *)calloc((size_t)n_threads, sizeof(TRSlot));
  for (int i = 0; i < n_threads; i++) {
    pthread_mutex_init(&ring[i].mu, NULL);
    pthread_cond_init(&ring[i].cv, NULL);
  }
  TRArg *targs = (TRArg *)malloc((size_t)n_threads * sizeof(TRArg));
  for (int i = 0; i < n_threads; i++) {
    targs[i].ring = ring; targs[i].id = i; targs[i].n = n_threads;
  }
  pthread_t *threads = (pthread_t *)malloc((size_t)n_threads * sizeof(pthread_t));
  for (int i = 0; i < n_threads; i++)
    pthread_create(&threads[i], NULL, __TUR_CNAME_ring-worker__, &targs[i]);
  pthread_mutex_lock(&ring[0].mu);
  ring[0].token = messages; ring[0].ready = 1;
  pthread_cond_signal(&ring[0].cv);
  pthread_mutex_unlock(&ring[0].mu);
  for (int i = 0; i < n_threads; i++) pthread_join(threads[i], NULL);
  printf("done\n");
  free(threads); free(targs); free(ring);
  ```)

(run-ring
  (if (= *args* 0) 4 (cstr->parse-int (head *args*)))
  (if (= *args* 0) 1000
    (if (= (tail *args*) 0) 1000
      (cstr->parse-int (head (tail *args*))))))
