;; alloc_churn -- allocate and free N small objects; measure allocation throughput.
(defn parse-first-arg [fallback :int] :int
  ```c
  struct __tur_cons { int64_t value; int64_t next; };
  struct __tur_cons *c = (struct __tur_cons *)(intptr_t)g_tur_args;
  return c ? (int64_t)atoll((const char *)(intptr_t)c->value) : fallback;
  ```)

(defn churn [n :int] :int
  ```c
  int64_t sum = 0;
  for (int64_t i = 0; i < n; i++) {
    int64_t *p = malloc(sizeof(int64_t));
    *p = i;
    sum += *p;
    free(p);
  }
  return sum;
  ```)

(println (churn (parse-first-arg 10000)))
