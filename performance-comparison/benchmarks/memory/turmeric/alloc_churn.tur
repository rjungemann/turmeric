;; alloc_churn -- allocate and free N small objects; measure allocation throughput.
(defn head [lst :int] :int
  ```c
  struct { int64_t value; int64_t next; } *c = (void*)(intptr_t)lst;
  return c ? c->value : 0;
  ```)

(defn cstr->parse-int [s :int] :int
  ```c
  const char *cs = (const char *)(intptr_t)s;
  return cs ? (int64_t)atoll(cs) : 0;
  ```)

(defn churn [n :int] :int
  ```c
  int64_t sum = 0;
  for (int64_t i = 0; i < n; i++) {
    int64_t *p = malloc(sizeof(int64_t));
    *p = i;
    sum += *p;
    free(p);
  }
  return sum;
  ```)

(println (churn (if (= *args* 0) 10000 (cstr->parse-int (head *args*)))))
