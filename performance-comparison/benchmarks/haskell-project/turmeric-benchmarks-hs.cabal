cabal-version:      2.4
-- haskell-project -- one executable per benchmark, built -O2, installed
-- into bin/ via `cabal install --install-method=copy --installdir=bin all`
-- (run_all.sh's HASKELL_BIN_DIR).  Methodology decisions (docs/methodology.md):
-- strict accumulators (BangPatterns) wherever the Turmeric column is strict,
-- and ByteString -- never lazy String -- for the string benchmarks.
name:               turmeric-benchmarks-hs
version:            0.1.0.0
build-type:         Simple

common bench
    hs-source-dirs:   src
    default-language: Haskell2010
    ghc-options:      -O2
    build-depends:    base, bytestring, containers

executable fibonacci
    import: bench
    main-is: Fibonacci.hs
executable primes
    import: bench
    main-is: Primes.hs
executable matrix_multiply
    import: bench
    main-is: MatrixMultiply.hs
executable monte_carlo_pi
    import: bench
    main-is: MonteCarloPi.hs
executable list_ops
    import: bench
    main-is: ListOps.hs
executable hash_map
    import: bench
    main-is: HashMap.hs
executable sort
    import: bench
    main-is: Sort.hs
executable string_concat
    import: bench
    main-is: StringConcat.hs
executable text_search
    import: bench
    main-is: TextSearch.hs
executable thread_ring
    import: bench
    main-is: ThreadRing.hs
    ghc-options: -O2 -threaded
executable alloc_churn
    import: bench
    main-is: AllocChurn.hs
executable fib_recursive
    import: bench
    main-is: FibRecursive.hs
executable factorial
    import: bench
    main-is: Factorial.hs
executable file_write
    import: bench
    main-is: FileWrite.hs
executable file_read
    import: bench
    main-is: FileRead.hs
executable random_access
    import: bench
    main-is: RandomAccess.hs
executable nbody
    import: bench
    main-is: Nbody.hs
executable ray_tracing
    import: bench
    main-is: RayTracing.hs
executable int_arith
    import: bench
    main-is: IntArith.hs
executable float_arith
    import: bench
    main-is: FloatArith.hs
executable function_call
    import: bench
    main-is: FunctionCall.hs
