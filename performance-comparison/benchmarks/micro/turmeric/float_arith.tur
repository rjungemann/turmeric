;; float_arith -- N iterations of FP multiply/sqrt/add; print result.
;; Algorithm is pure Turmeric tail-recursion.
;; sqrt and printf-%.6f are one-line C helpers (no stdlib equivalent yet).
(defn head [lst :int] :int
  ```c
  struct { int64_t value; int64_t next; } *c = (void*)(intptr_t)lst;
  return c ? c->value : 0;
  ```)

(defn cstr->parse-int [s :int] :int
  ```c
  const char *cs = (const char *)(intptr_t)s;
  return cs ? (int64_t)atoll(cs) : 0;
  ```)

;; tur-sqrt -- square root via libm.
(defn tur-sqrt [x :float] :float
  ```c
  double sqrt(double);
  return sqrt(x);
  ```)

;; print-float6 -- print a float with 6 decimal places (matches C benchmark output).
(defn print-float6 [x :float] :nil
  ```c
  printf("%.6f\n", x);
  ```)

;; int->float -- numeric cast int -> double.
(defn int->float [n :int] :float
  ```c
  return (double)n;
  ```)

;; float-arith-loop -- tail-recursive FP accumulator.
(defn float-arith-loop [i :int a :float b :float n :int] :float
  (if (>= i n)
    (+ a b)
    (as float (float-arith-loop (+ i 1)
                                (+ (* a 1.0000001) (tur-sqrt b))
                                (+ (* b 0.9999999) (tur-sqrt a))
                                n))))

(print-float6 (float-arith-loop 0 1.0 1.0 (if (= *args* 0) 1000000 (cstr->parse-int (head *args*)))))
