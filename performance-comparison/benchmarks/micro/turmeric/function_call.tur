;; function_call -- N tail-recursive calls; measures function-call overhead.
;; head and cstr->parse-int are inline-C here so the file is self-contained;
;; in interpreter mode these are overridden by the already-registered stdlib natives.
(defn head [lst :int] :int
  ```c
  struct { int64_t value; int64_t next; } *c = (void*)(intptr_t)lst;
  return c ? c->value : 0;
  ```)

(defn cstr->parse-int [s :int] :int
  ```c
  const char *cs = (const char *)(intptr_t)s;
  return cs ? (int64_t)atoll(cs) : 0;
  ```)

(defn loop-fn [i :int n :int acc :int] :int
  (if (>= i n)
    acc
    (loop-fn (+ i 1) n (+ acc 1))))

(println (loop-fn 0 (if (= *args* 0) 1000000 (cstr->parse-int (head *args*))) 0))
