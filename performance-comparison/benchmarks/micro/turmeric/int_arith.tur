;; int_arith -- N iterations of integer multiply-add; print result.
(defn parse-first-arg [default :int] :int
  ```c
  struct __tur_cons { int64_t value; int64_t next; };
  struct __tur_cons *c = (struct __tur_cons *)(intptr_t)g_tur_args;
  return c ? (int64_t)atoll((const char *)(intptr_t)c->value) : default;
  ```)

(defn int-arith [n :int] :int
  ```c
  int64_t a = 1, b = 1;
  for (int64_t i = 0; i < n; i++) {
    a = a * 1000003 + b;
    b = b * 999983 + a;
  }
  return a ^ b;
  ```)

(println (int-arith (parse-first-arg 1000000)))
