;; int_arith -- N iterations of integer multiply-add; print result.
;; Algorithm is pure Turmeric tail-recursion; bit-xor is a one-line C helper.
(defn head [lst :int] :int
  ```c
  struct { int64_t value; int64_t next; } *c = (void*)(intptr_t)lst;
  return c ? c->value : 0;
  ```)

(defn cstr->parse-int [s :int] :int
  ```c
  const char *cs = (const char *)(intptr_t)s;
  return cs ? (int64_t)atoll(cs) : 0;
  ```)

;; bit-xor -- bitwise XOR of two integers.
(defn bit-xor [a :int b :int] :int
  ```c
  return (int64_t)((int64_t)a ^ (int64_t)b);
  ```)

;; int-arith-loop -- tail-recursive multiply-add accumulator.
(defn int-arith-loop [i :int a :int b :int n :int] :int
  (if (>= i n)
    (bit-xor a b)
    (int-arith-loop (+ i 1)
                    (+ (* a 1000003) b)
                    (+ (* b 999983) a)
                    n)))

(println (int-arith-loop 0 1 1 (if (= *args* 0) 1000000 (cstr->parse-int (head *args*)))))
