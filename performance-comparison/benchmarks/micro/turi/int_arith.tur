;; int_arith -- N iterations of integer multiply-add (interpreter-compatible).
;; bit-xor uses a registered native shim.
(defn parse-first-arg [fallback :int] :int
  (if (= *args* 0)
    fallback
    (cstr->parse-int (head *args*))))

;; int-arith-loop -- tail-recursive multiply-add accumulator.
(defn int-arith-loop [i :int a :int b :int n :int] :int
  (if (>= i n)
    (bit-xor a b)
    (int-arith-loop (+ i 1)
                    (+ (* a 1000003) b)
                    (+ (* b 999983) a)
                    n)))

(println (int-arith-loop 0 1 1 (parse-first-arg 1000000)))
