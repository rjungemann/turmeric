;; float_arith -- N iterations of FP multiply/sqrt/add (interpreter-compatible).
;; tur-sqrt uses a registered native shim; result is an int count.

;; float-arith-loop -- tail-recursive; returns iteration count as :int.
;; Exercises float multiply, sqrt, and add each iteration.
(defn float-arith-loop [i :int a :float b :float n :int] :int
  (if (>= i n)
    i
    (float-arith-loop (+ i 1)
                      (+ (* a 1.0000001) (tur-sqrt b))
                      (+ (* b 0.9999999) (tur-sqrt a))
                      n)))

(println (float-arith-loop 0 1.0 1.0 (if (= *args* 0) 1000000 (cstr->parse-int (head *args*)))))
