{
  "name": "turmeric-debug",
  "displayName": "Turmeric",
  "description": "Syntax highlighting for Turmeric (.tur) and the Saffron dialect, plus debugging under the interpreter via the Debug Adapter Protocol (tur dap).",
  "version": "0.1.0",
  "publisher": "turmeric",
  "license": "SEE LICENSE IN ../../LICENSE",
  "engines": {
    "vscode": "^1.66.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:turmeric",
    "onDebugResolve:turmeric",
    "onDebugDynamicConfigurations:turmeric"
  ],
  "contributes": {
    "languages": [
      {
        "id": "turmeric",
        "extensions": [
          ".tur",
          ".tur.sweet"
        ],
        "aliases": [
          "Turmeric",
          "turmeric"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "breakpoints": [
      {
        "language": "turmeric"
      }
    ],
    "debuggers": [
      {
        "type": "turmeric",
        "label": "Turmeric (interpreter)",
        "languages": [
          "turmeric"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the .tur file to debug.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "description": "Arguments passed to the program (visible as *args*).",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause at the first executable node.",
                "default": true
              },
              "tur": {
                "type": "string",
                "description": "Path to the tur binary (defaults to 'tur' on PATH).",
                "default": "tur"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "turmeric",
            "request": "launch",
            "name": "Debug current Turmeric file",
            "program": "${file}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Turmeric: Launch current file",
            "description": "Debug the active .tur file under the interpreter",
            "body": {
              "type": "turmeric",
              "request": "launch",
              "name": "Debug ${1:current} Turmeric file",
              "program": "^\"\\${file}\"",
              "stopOnEntry": true
            }
          }
        ]
      },
      {
        "type": "lldb",
        "label": "Turmeric Native (CodeLLDB)",
        "configurationSnippets": [
          {
            "label": "Turmeric: Debug Native (CodeLLDB)",
            "description": "Debug a compiled Turmeric binary using CodeLLDB with pretty-printers",
            "body": {
              "type": "lldb",
              "request": "launch",
              "name": "Debug Turmeric Native (CodeLLDB)",
              "program": "^\"\\${workspaceFolder}/build/\\${fileBasenameNoExtension}\"",
              "initCommands": [
                "command script import ^\"\\${workspaceFolder}/tools/debug/turmeric_lldb.py\""
              ]
            }
          }
        ]
      }
    ],
    "grammars": [
      {
        "language": "turmeric",
        "scopeName": "source.turmeric",
        "path": "./syntaxes/turmeric.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.c": "c"
        }
      }
    ]
  }
}
