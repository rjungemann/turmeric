#!/usr/bin/env bash
#
# pre-commit hook: reject any attempt to (re)introduce docs/reported/history/.
#
# Resolved bug reports belong in the ARCHIVE -- docs/archive/ (or, for the
# per-fix paper trail, docs/archive/history/) -- never under docs/reported/.
# docs/reported/ is for OPEN findings only; it must not grow a history/ subtree.
#
# Enable (one-time, per clone):
#     git config core.hooksPath tools/git-hooks
#
set -euo pipefail

# Staged paths in this commit (added/copied/modified/renamed/type-changed).
offending="$(git diff --cached --name-only --diff-filter=ACMRT \
             | grep -E '^docs/reported/history(/|$)' || true)"

if [ -n "$offending" ]; then
    echo "ERROR: commit rejected -- docs/reported/history/ is forbidden." >&2
    echo >&2
    echo "Resolved reports go in the archive, not a history/ dir under reported:" >&2
    echo "  - docs/archive/<slug>.md           (the resolved report)" >&2
    echo "  - docs/archive/history/<slug>.md   (per-fix paper trail)" >&2
    echo >&2
    echo "Offending staged path(s):" >&2
    printf '  %s\n' $offending >&2
    exit 1
fi

exit 0
