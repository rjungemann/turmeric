; Phase G3: Type equality witnesses
; The Equal GADT witnesses type equality: (Equal a a) has one constructor Refl.
; Matching on Refl in a GADT arm refines the type variable a.

(defgadt Equal [a b]
  (Refl : (Equal a a)))

; Symmetry: if a = a then a = a (trivially via Refl)
(defn equal-sym [eq :Equal] :Equal
  (match eq
    (Refl) (Refl)))

; Transitivity: if a = a and a = a then a = a (trivially via Refl)
(defn equal-trans [eq1 :Equal eq2 :Equal] :Equal
  (match eq1
    (Refl) eq2))
