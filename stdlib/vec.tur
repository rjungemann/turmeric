;;; tur/vec -- typed Vec[A]: parameterized growable array.
;;;
;;; Parameterized growable array. Runtime layout identical to tur/vec.
;;;
;;; Since: Phase TC1-A
;; Phase TC1-A: Typed Vec[A]
;; Parameterized growable array. Runtime layout identical to vec.tur.
;; Type parameter A is tracked by the type-checker at call sites only.
;;; Vec -- parameterized growable array with element type A.
;;;
;;; Since: Phase TC1
(defstruct Vec :heap [A] (data :ptr<void>) (len :int) (cap :int))
;;; vec-new -- allocate a new empty Vec[A].
;;;
;;; Returns:
;;;   A new empty Vec[A] with len=0 and cap=0.
;;;
;;; Example:
;;;   (vec-new)  ; => empty Vec
;;;
;;; Since: Phase TC1
;; --- Producer/accessor ABI (end-to-end-monomorphization, Vec typed-pointer
;; slice) ---
;;
;; `Vec` is :heap, so `(Vec A)` lowers to a typed pointer `Vec__A *` to a
;; heap-allocated `{ data, len, cap }` header in every monomorphic position
;; (spec params, Eq[Vec] dispatch).  The producers below stay INLINE-C
;; *carrier bases*: their bodies take/return the int64 carrier (which, for a
;; :heap value, IS the header pointer) and operate on the layout-generic
;; anonymous `{ int64_t *data; int64_t len; int64_t cap; }` struct.  Two
;; reasons this is the right shape rather than pure-Turmeric make-struct/
;; field-access bodies:
;;
;;   1. The interpreter (--interpret) routes a call to a native override ONLY
;;      when the callee's body is inline-C (eval.c: the native-override-for-
;;      inline-C-functions path).  The native_vec_* builtins (src/main.c)
;;      implement Vec over the interpreter's own value model, so keeping these
;;      bodies inline-C preserves interpreter parity for free.  A pure-Turmeric
;;      body would bypass the native and run source that the tree-walker cannot
;;      execute.
;;   2. The element buffer (`data`) is int64-carried for every A, and a
;;      return-typed-A body would mint an A-monomorphized spec (e.g. returning
;;      `double` for A=float) whose carrier read numerically converts the float
;;      bits instead of bit-reinterpreting them.  Inline-C bodies are not
;;      return-specialized, so the carrier base returns the raw int64 and the
;;      call-site `(:: (vec-get v i) :float)` ascription does the correct union
;;      reinterpret.
;;
;; At concrete call sites the typed pointer reaches these int64-carrier bases
;; through the C-3 carrier reinterpret-cast (emit_carrier_bridge), so
;; `(void*)(intptr_t)v` is always valid.  Mutation is visible to all holders
;; because the handle is a shared pointer, never a by-value header copy.


(defn vec-new [A]
  []
  #{}
  : (Vec A)
  ```c
  struct { int64_t *data; int64_t len; int64_t cap; } *v = malloc(sizeof(*v));
  v->data = NULL;
  v->len = 0;
  v->cap = 0;
  return (__TUR_RET__)(intptr_t)v;
  ```)
;;; vec-len -- return the number of elements in a Vec[A].
;;;
;;; Parameters:
;;;   v -- Vec[A] pointer
;;;
;;; Returns:
;;;   Element count.
;;;
;;; Example:
;;;   (vec-len my-vec)  ; => 3
;;;
;;; Since: Phase TC1

(defn vec-len [A]
  [v : (Vec A)]
  #{}
  : int
  ```c
  struct { int64_t *data; int64_t len; int64_t cap; } *vec = (void*)(intptr_t)v;
  return (int)vec->len;
  ```)
;;; vec-get -- return the element at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- Vec[A] pointer
;;;   i -- zero-based index
;;;
;;; Returns:
;;;   The element at index i (typed A, stored as int64_t).
;;;
;;; Example:
;;;   (vec-get my-vec 0)  ; => first element
;;;
;;; Since: Phase TC1

(defn vec-get [A]
  [v : (Vec A) i :int]
  #{}
  :A
  ```c
  struct { int64_t *data; int64_t len; int64_t cap; } *vec = (void*)(intptr_t)v;
  if (i >= 0 && (size_t)i < (size_t)vec->len) return (int64_t)vec->data[i];
  fprintf(stderr, "tvec index out of bounds\n");
  exit(1);
  return 0;
  ```)
;;; vec-push! -- append an element to the Vec[A].
;;;
;;; Parameters:
;;;   v   -- Vec[A] pointer
;;;   val -- element of type A to append
;;;
;;; Example:
;;;   (vec-push! my-vec 42)
;;;
;;; Since: Phase TC1

(defn vec-push! [A]
  [v : (Vec A) val :A]
  #{}
  :nil
  ```c
  struct { int64_t *data; int64_t len; int64_t cap; } *vec = (void*)(intptr_t)v;
  if (vec->len >= vec->cap) {
    int64_t new_cap = vec->cap > 0 ? vec->cap * 2 : 4;
    int64_t *new_data = malloc(sizeof(int64_t) * new_cap);
    for (int64_t i = 0; i < vec->len; i++) new_data[i] = vec->data[i];
    free(vec->data);
    vec->data = new_data;
    vec->cap = new_cap;
  }
  vec->data[vec->len++] = (int64_t)val;
  ```)
;;; vec-pop! -- remove and return the last element of a Vec[A].
;;;
;;; Parameters:
;;;   v -- Vec[A] pointer
;;;
;;; Returns:
;;;   The last element of type A (as int64_t), or 0 if empty.
;;;
;;; Example:
;;;   (vec-pop! my-vec)  ; => last element
;;;
;;; Since: Phase TC1

(defn vec-pop! [A]
  [v : (Vec A)]
  #{}
  :A
  ```c
  struct { int64_t *data; int64_t len; int64_t cap; } *vec = (void*)(intptr_t)v;
  if (vec->len == 0) return 0;
  return (int64_t)vec->data[--vec->len];
  ```)
;;; vec-set! -- overwrite the element at index i.
;;;
;;; Parameters:
;;;   v   -- Vec[A] pointer
;;;   i   -- zero-based index
;;;   val -- new element value of type A
;;;
;;; Example:
;;;   (vec-set! my-vec 0 99)
;;;
;;; Since: Phase TC1

(defn vec-set! [A]
  [v : (Vec A) i :int val :A]
  #{}
  :void
  ```c
  struct { int64_t *data; int64_t len; int64_t cap; } *vec = (void*)(intptr_t)v;
  if (i >= 0 && (size_t)i < (size_t)vec->len) { vec->data[i] = (int64_t)val; return; }
  fprintf(stderr, "vec-set! index out of bounds\n");
  exit(1);
  ```)
;;; vec-free -- free a Vec[A] and its data buffer.
;;;
;;; Parameters:
;;;   v -- Vec[A] pointer to free
;;;
;;; Example:
;;;   (vec-free my-vec)
;;;
;;; Since: Phase TC1

(defn vec-free [A]
  [v : (Vec A)]
  #{}
  : void
  ```c
  struct { int64_t *data; int64_t len; int64_t cap; } *vec = (void*)(intptr_t)v;
  if (vec->data) free(vec->data);
  free(vec);
  ```)
;;; vec-push-each__ -- internal helper for the vec-of macro.
;;;
;;; Expands a sequence of pushes onto `v` followed by `v` itself as the
;;; final value. Recursive: each step emits `(do (vec-push! v x) ...)`.

(defmacro vec-push-each__ [v & xs]
  (if (empty? xs)
    v
    (list do (list vec-push! v (first xs)) (list vec-push-each__ v ~@(rest xs)))))
;;; tur-vec-homog__ -- internal: compile-time element homogeneity check.
;;;
;;; Both parameters share the single type variable A, so a call with two
;;; differently-typed arguments is a TUR-E0001 at elaboration. The body is a
;;; no-op; the call exists only to make the type-checker enforce that adjacent
;;; vec-of elements have the same type. No allocation (fixed arity).

(defn tur-vec-homog__ [A] [a :A b :A] :nil ```c (void)a; (void)b; ```)
;;; vec-homog-chain__ -- internal: pairwise-chain tur-vec-homog__ over xs.
;;;
;;; Emits (tur-vec-homog__ x0 x1), (tur-vec-homog__ x1 x2), ... so all
;;; elements transitively unify to one type. Zero or one element: no check.

(defmacro vec-homog-chain__ [& xs]
  (if (empty? xs)
    0
    (if (empty? (rest xs))
      0
      (list do
        (list tur-vec-homog__ (first xs) (second xs))
        (list vec-homog-chain__ ~@(rest xs))))))
;;; vec-of -- variadic Vec[A] literal.
;;;
;;; Parameters:
;;;   & xs -- zero or more elements, all of type A.
;;;
;;; Returns:
;;;   A fresh Vec[A] populated with xs in order. The element type A may be
;;;   any scalar (:int, :cstr, :bool, :nil, :float); elements are stored
;;;   through an :int carrier slot, so a :float element round-trips as a
;;;   bit-reinterpret. The handle composes with vec-len, vec-get, vec-push!,
;;;   etc. Reads recover the element type: vec-get returns :A, so a non-int
;;;   element is read with an ascription, e.g. (:: (vec-get v 0) :float).
;;;
;;; Note: all elements must unify to a single type. Mixing types -- e.g.
;;;   (vec-of 1 "x" 3.14) -- is a type error (TUR-E0001 on the offending
;;;   element). For heterogeneous fixed-arity collections, use tupleN.
;;;   Aggregate (multi-word struct/ADT) element types are not supported by
;;;   the carrier slot; those need a per-element typed layout (see TS3b).
;;;
;;; Note: under -Xdata-literals, a [...] vector in expression position lowers
;;;   to this macro, so [1 2 3] is sugar for (vec-of 1 2 3).  See
;;;   docs/guides/data-literals-guide.md.
;;;
;;; Example:
;;;   (vec-of)        ; => empty Vec
;;;   (vec-of 1 2 3)  ; => Vec containing 1, 2, 3
;;;   [1 2 3]         ; => same, with -Xdata-literals
;;;
;;; Since: Phase 2 cons-in-docs cleanup

(defmacro vec-of [& xs]
  (if (empty? xs)
    (list vec-new)
    (list let
      `[__v (vec-new)]
      (list do (list vec-homog-chain__ ~@xs) (list vec-push-each__ __v ~@xs)))))
;;; vec-eq? -- compare two Vec[A] element-wise using a comparator.
;;;
;;; Parameters:
;;;   v1     -- first Vec[A]
;;;   v2     -- second Vec[A]
;;;   cmp-fn -- comparator fn [a :int b :int] :bool
;;;
;;; Returns:
;;;   true if both vecs have the same length and all element pairs satisfy cmp-fn.
;;;
;;; Example:
;;;   (vec-eq? va vb (fn [a b] (= a b)))  ; => true
;;;
;;; Since: Phase TC1

(defn vec-eq? [v1 : int v2 : int ^fat cmp-fn]
  #{}
  : bool
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *a = (void*)(intptr_t)v1;
  struct { int64_t *data; size_t len; size_t cap; } *b = (void*)(intptr_t)v2;
  if (a->len != b->len) return false;
  /* CRU B-3: cmp-fn is a fat closure box; fat-dispatch via slot 0 (a capturing
     element comparator works; captureless lambdas are boxed at the call site). */
  for (size_t i = 0; i < a->len; i++) {
      if (!((bool(*)(void*, int64_t, int64_t))(intptr_t)((int64_t*)(intptr_t)cmp_fn)[0])((void*)(intptr_t)cmp_fn, a->data[i], b->data[i]))
          return false;
  }
  return true;
  ```)
;;; Eq [Vec] -- element-wise equality using the element type's Eq instance.
;; TC1-5: Phase PTC4 -- constrained Eq instance for Vec[A].
;; Note: element comparison uses integer equality; correct for all primitive A.
;;
;; The by-value `vec-len-byval` / `vec-eq-loop-byval` twins that the old
;; by-value `Eq [Vec]` used were retired once the instance moved to the
;; carrier-based `vec-eq?` delegation below (end-to-end-monomorphization root 2
;; retirement) -- they are no longer reachable, so they are gone (plan step 5).
;; `vec-get-byval` (the Option C twin redirect target for `vec-get` inside
;; specs) and `vec-data-get__` stay; they are part of the shared redirect
;; mechanism still used by Map/Set-bound fixtures.

(defn vec-data-get__ [data : ptr<void> i : int] : int
  ```c return ((int64_t *)(intptr_t)data)[i]; ```)
;;; vec-data-get-checked__ -- bounds-checked indexed read over a raw data ptr.
;; Internal: shared inline-C core for the by-value vec-get-byval (and the
;; carrier vec-get, if it ever delegates).  Aborts on out-of-range like
;; vec-get.


(defn vec-data-get-checked__ [data : ptr<void> i : int len : int] : int
  ```c
  if (i >= 0 && (size_t)i < (size_t)len) return ((int64_t *)(intptr_t)data)[i];
  fprintf(stderr, "tvec index out of bounds\n");
  exit(1);
  return 0;
  ```)
;;; vec-get-byval -- by-value Vec[A] indexed read (Option C twin of vec-get).
;; M5 (end-to-end-monomorphization): the by-value counterpart of vec-get.
;; The emitter redirects a `vec-get` call inside a by-value spec body here so
;; the Vec receiver flows by value instead of bridging back to the int64
;; carrier.  Dual-ABI: `.data`/`.len` field access lowers direct in a spec
;; and derefs through the carrier in the (element-agnostic) base.


(defn vec-get-byval [A]
  [v : (Vec A) i : int]
  : A
  (:: (vec-data-get-checked__ (.data v) i (.len v)) A))
;;; vec-eq-loop -- pure-Turmeric element-wise Vec[A] comparison (TCO'd index loop).
;;;
;;; Path A specializes this per element type; the self-tail-call lowers to a
;;; goto loop inside the spec (TCO-in-ABI-specs, emit_fns.c eligibility gate),
;;; so deep iteration on large vecs does not grow the C stack.  Unlike the
;;; inline-C `vec-eq?` carrier helper, the receiver flows by value: `vec-get`
;;; is redirected to `vec-get-byval` inside the spec body, so no
;;; `(:: x :int)` relabel and no concrete->carrier bridge is minted at the
;;; `Eq [Vec]` dispatch site.
;;;
;;; Parameters:
;;;   x   -- first Vec[A]
;;;   y   -- second Vec[A]
;;;   i   -- current index (start at 0)
;;;   len -- shared length (both vecs are known equal-length by the caller)
;;;   cmp -- element comparator fn [a :A b :A] :bool
;;;
;;; Returns:
;;;   true if x[i..len) equals y[i..len) under cmp.
;;;
;;; Example:
;;;   (vec-eq-loop a b 0 (vec-len a) (fn [p q] (eq? p q)))  ; => true
;;;
;;; Since: Phase M4c (TCO-in-ABI-specs)

(defn vec-eq-loop [A]
  [x : (Vec A) y : (Vec A) i : int len : int ^fat cmp : (fn [A A] bool)]
  : bool
  (if (= i len)
    true
    (if (cmp (vec-get x i) (vec-get y i))
      (vec-eq-loop x y (+ i 1) len cmp)
      false)))
;;; Eq [Vec] -- element-wise equality using the element type's Eq instance.
;; M4c (TCO-in-ABI-specs): the instance body is now pure Turmeric.  Path A
;; specializes `vec-eq-loop` to the concrete element type and the self-tail-
;; call becomes a loop after TCO, so the by-value Vec receiver never bridges
;; back to the int64 carrier.  The inline-C `vec-eq?` helper stays for
;; external callers and the un-specialized (abstract-A) carrier dispatch.
;; The earlier "carrier-based Eq [Vec] breaks the build" finding predated
;; #377 (when `(Vec A)` was a by-value `Vec__int` and the relabel was a
;; struct widening); that no longer holds, and TCO inside ABI specs (gate
;; lifted in emit_fns.c) lets the pure-Turmeric body iterate without a
;; carrier helper at all.

(definstance Eq [Vec]
  [(Eq A)]
  (eq? [x y]
    (and (= (vec-len (:: x (Vec A))) (vec-len (:: y (Vec A))))
      (vec-eq-loop (:: x (Vec A))
        (:: y (Vec A))
        0
        (vec-len (:: x (Vec A)))
        (fn [a b] (eq? a b))))))
