;; Vec type for Turmeric
;; Growable owning array

;; Create a new empty vec
(defn vec-new []
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *v = malloc(sizeof(*v));
  v->data = NULL;
  v->len = 0;
  v->cap = 0;
  return v;
  ```)

;; Get vec length - v is a pointer from vec-new
(defn vec-len [v] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *vec = (void*)v;
  return (int)vec->len;
  ```)

;; Get element at index (bounds-checked)
(defn vec-get [v i] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *vec = (void*)v;
  if (i >= 0 && (size_t)i < vec->len) return (int)vec->data[i];
  fprintf(stderr, "vec index out of bounds\n");
  exit(1);
  return 0;
  ```)

;; Push an element to the vec
(defn vec-push! [v val]
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *vec = (void*)v;
  if (vec->len >= vec->cap) {
    size_t new_cap = vec->cap > 0 ? vec->cap * 2 : 4;
    int64_t *new_data = malloc(sizeof(int64_t) * new_cap);
    for (size_t i = 0; i < vec->len; i++) new_data[i] = vec->data[i];
    free(vec->data);
    vec->data = new_data;
    vec->cap = new_cap;
  }
  vec->data[vec->len++] = val;
  ```)

;; Pop an element from the vec
(defn vec-pop! [v] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *vec = (void*)v;
  if (vec->len == 0) {
    fprintf(stderr, "vec pop from empty vec\n");
    exit(1);
  }
  return (int)vec->data[--vec->len];
  ```)

;; Free the vec and its data
(defn vec-free [v]
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *vec = (void*)v;
  free(vec->data);
  free(vec);
  ```)

;;; SINCE: Phase HKT H3
;; Functor instance for vec — apply fn to every element, return a new vec.
(defn __functor_vec_fmap [container fn] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *v =
      (struct { int64_t *data; size_t len; size_t cap; } *)(intptr_t)container;
  if (!v) return 0;
  struct { int64_t *data; size_t len; size_t cap; } *r =
      malloc(sizeof(struct { int64_t *data; size_t len; size_t cap; }));
  r->len  = v->len;
  r->cap  = v->len;
  r->data = r->len > 0 ? malloc(sizeof(int64_t) * r->len) : NULL;
  for (size_t i = 0; i < v->len; i++) {
      r->data[i] = ((int64_t(*)(int64_t))(intptr_t)fn)(v->data[i]);
  }
  return (int64_t)(intptr_t)r;
  ```)

(definstance Functor [vec]
  (fmap [container fn] (__functor_vec_fmap container fn)))

;; Foldable instance for vec.
;;   foldl :: (b -> a -> b) -> b -> t a -> b   (left fold, strict)
;;   foldr :: (a -> b -> b) -> b -> t a -> b   (right fold)
(defn __foldable_vec_foldl [ta init fn] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *v =
      (struct { int64_t *data; size_t len; size_t cap; } *)(intptr_t)ta;
  int64_t acc = init;
  if (!v) return acc;
  for (size_t i = 0; i < v->len; i++) {
      acc = ((int64_t(*)(int64_t, int64_t))(intptr_t)fn)(acc, v->data[i]);
  }
  return acc;
  ```)

(defn __foldable_vec_foldr [ta init fn] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *v =
      (struct { int64_t *data; size_t len; size_t cap; } *)(intptr_t)ta;
  int64_t acc = init;
  if (!v) return acc;
  for (size_t i = v->len; i-- > 0; ) {
      acc = ((int64_t(*)(int64_t, int64_t))(intptr_t)fn)(v->data[i], acc);
  }
  return acc;
  ```)

(definstance Foldable [vec]
  (foldl [ta init fn] (__foldable_vec_foldl ta init fn))
  (foldr [ta init fn] (__foldable_vec_foldr ta init fn)))

;; Applicative instance for vec.
;;   pure x = [x]
;;   ap [f1, f2, ...] [x1, x2, ...] = [f1 x1, f1 x2, ..., f2 x1, f2 x2, ...]
(defn __applicative_vec_pure [x] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *v =
      malloc(sizeof(struct { int64_t *data; size_t len; size_t cap; }));
  v->len = 1;
  v->cap = 1;
  v->data = malloc(sizeof(int64_t));
  v->data[0] = x;
  return (int64_t)(intptr_t)v;
  ```)

(defn __applicative_vec_ap [ff fa] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *fv =
      (struct { int64_t *data; size_t len; size_t cap; } *)(intptr_t)ff;
  struct { int64_t *data; size_t len; size_t cap; } *av =
      (struct { int64_t *data; size_t len; size_t cap; } *)(intptr_t)fa;
  if (!fv || !av) return 0;
  /* Result vec */
  struct { int64_t *data; size_t len; size_t cap; } *r =
      malloc(sizeof(struct { int64_t *data; size_t len; size_t cap; }));
  r->len = fv->len * av->len;
  r->cap = r->len;
  r->data = r->len > 0 ? malloc(sizeof(int64_t) * r->len) : NULL;
  /* Apply each function to each value */
  size_t idx = 0;
  for (size_t i = 0; i < fv->len; i++) {
      for (size_t j = 0; j < av->len; j++) {
          int64_t fn_ptr = fv->data[i];
          int64_t val = av->data[j];
          r->data[idx++] = ((int64_t(*)(int64_t))(intptr_t)fn_ptr)(val);
      }
  }
  return (int64_t)(intptr_t)r;
  ```)

(definstance Applicative [vec]
  (pure [x] (__applicative_vec_pure x))
  (ap [ff fa] (__applicative_vec_ap ff fa)))

;; Monad instance for vec.
;;   bind [a1, a2, ...] f = concat [f a1, f a2, ...]
;;   where concat flattens a vec of vecs
(defn __monad_vec_concat [outer] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *ov =
      (struct { int64_t *data; size_t len; size_t cap; } *)(intptr_t)outer;
  if (!ov) return 0;
  /* Calculate total length */
  size_t total_len = 0;
  for (size_t i = 0; i < ov->len; i++) {
      struct { int64_t *data; size_t len; size_t cap; } *iv =
          (struct { int64_t *data; size_t len; size_t cap; } *)(intptr_t)ov->data[i];
      if (iv) total_len += iv->len;
  }
  /* Build result */
  struct { int64_t *data; size_t len; size_t cap; } *r =
      malloc(sizeof(struct { int64_t *data; size_t len; size_t cap; }));
  r->len = total_len;
  r->cap = total_len;
  r->data = total_len > 0 ? malloc(sizeof(int64_t) * total_len) : NULL;
  size_t idx = 0;
  for (size_t i = 0; i < ov->len; i++) {
      struct { int64_t *data; size_t len; size_t cap; } *iv =
          (struct { int64_t *data; size_t len; size_t cap; } *)(intptr_t)ov->data[i];
      if (iv) {
          for (size_t j = 0; j < iv->len; j++) {
              r->data[idx++] = iv->data[j];
          }
      }
  }
  return (int64_t)(intptr_t)r;
  ```)

(defn __monad_vec_bind [ma fn] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *v =
      (struct { int64_t *data; size_t len; size_t cap; } *)(intptr_t)ma;
  if (!v) return 0;
  /* Map fn over each element */
  struct { int64_t *data; size_t len; size_t cap; } *mapped =
      malloc(sizeof(struct { int64_t *data; size_t len; size_t cap; }));
  mapped->len = v->len;
  mapped->cap = v->len;
  mapped->data = v->len > 0 ? malloc(sizeof(int64_t) * v->len) : NULL;
  for (size_t i = 0; i < v->len; i++) {
      mapped->data[i] = ((int64_t(*)(int64_t))(intptr_t)fn)(v->data[i]);
  }
  /* Now concat the results */
  return __monad_vec_concat((int64_t)(intptr_t)mapped);
  ```)

(definstance Monad [vec]
  (bind [ma fn] (__monad_vec_bind ma fn)))

;; Traversable instance for vec.
;; traverse :: Applicative f => (a -> f b) -> vec a -> f (vec b)
;; For vec as traversable:
;;   traverse f [] = pure []
;;   traverse f [x1, x2, ...] = (<*> ...) ... (pure (:)) (f x1) (f x2) ...
;; In v1, we use the Applicative instance's pure and ap
(defn __traversable_vec_traverse [ta fn] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *v =
      (struct { int64_t *data; size_t len; size_t cap; } *)(intptr_t)ta;
  if (!v || v->len == 0) {
      /* Empty vec: return pure [] = [] wrapped by applicative */
      /* In v1, we return an empty vec */
      struct { int64_t *data; size_t len; size_t cap; } *r =
          malloc(sizeof(struct { int64_t *data; size_t len; size_t cap; }));
      r->len = 0; r->cap = 0; r->data = NULL;
      return (int64_t)(intptr_t)r;
  }
  /* Non-empty vec: map fn over each element and collect results */
  struct { int64_t *data; size_t len; size_t cap; } *mapped =
      malloc(sizeof(struct { int64_t *data; size_t len; size_t cap; }));
  mapped->len = v->len;
  mapped->cap = v->len;
  mapped->data = v->len > 0 ? malloc(sizeof(int64_t) * v->len) : NULL;
  for (size_t i = 0; i < v->len; i++) {
      mapped->data[i] = ((int64_t(*)(int64_t))(intptr_t)fn)(v->data[i]);
  }
  /* The result is f (vec b) where f is the applicative functor */
  /* In v1, we just return the mapped vec, assuming the applicative
   * will handle the wrapping */
  return (int64_t)(intptr_t)mapped;
  ```)

(definstance Traversable [vec]
  (traverse [ta fn] (__traversable_vec_traverse ta fn)))

;; Alternative instance for vec.
;;   empty = []
;;   alt-or a b = concat [a b] (concatenate the two vecs)
(defn __alternative_vec_empty [] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *v =
      malloc(sizeof(struct { int64_t *data; size_t len; size_t cap; }));
  v->len = 0;
  v->cap = 0;
  v->data = NULL;
  return (int64_t)(intptr_t)v;
  ```)

(defn __alternative_vec_alt_or [a b] :int
  __monad_vec_concat)

(definstance Alternative [vec]
  (empty [_] (__alternative_vec_empty))
  (alt-or [a b] (__alternative_vec_alt_or a b)))

;; Phase B1: Clone instance for vec
;; Deep copies the vec struct and all its elements (v1: int64_t only)
(defn __clone_vec_clone [x] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *v =
      (struct { int64_t *data; size_t len; size_t cap; } *)(intptr_t)x;
  if (!v) return 0;
  struct { int64_t *data; size_t len; size_t cap; } *r =
      malloc(sizeof(struct { int64_t *data; size_t len; size_t cap; }));
  r->len = v->len;
  r->cap = v->cap;
  r->data = malloc(sizeof(int64_t) * v->cap);
  for (size_t i = 0; i < v->len; i++) {
      r->data[i] = v->data[i];  /* v1: int64_t copy (deep clone for primitives) */
  }
  return (int64_t)(intptr_t)r;
  ```)

(definstance Clone [vec]
  (clone [x] (__clone_vec_clone x)))
