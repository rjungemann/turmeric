;; Vec type for Turmeric
;; Growable owning array

;; Create a new empty vec
(defn vec-new []
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *v = malloc(sizeof(*v));
  v->data = NULL;
  v->len = 0;
  v->cap = 0;
  return v;
  ```)

;; Get vec length - v is a pointer from vec-new
(defn vec-len [v] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *vec = (void*)v;
  return (int)vec->len;
  ```)

;; Get element at index (bounds-checked)
(defn vec-get [v i] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *vec = (void*)v;
  if (i >= 0 && (size_t)i < vec->len) return (int)vec->data[i];
  fprintf(stderr, "vec index out of bounds\n");
  exit(1);
  return 0;
  ```)

;; Push an element to the vec
(defn vec-push! [v val]
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *vec = (void*)v;
  if (vec->len >= vec->cap) {
    size_t new_cap = vec->cap > 0 ? vec->cap * 2 : 4;
    int64_t *new_data = malloc(sizeof(int64_t) * new_cap);
    for (size_t i = 0; i < vec->len; i++) new_data[i] = vec->data[i];
    free(vec->data);
    vec->data = new_data;
    vec->cap = new_cap;
  }
  vec->data[vec->len++] = val;
  ```)

;; Pop an element from the vec
(defn vec-pop! [v] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *vec = (void*)v;
  if (vec->len == 0) {
    fprintf(stderr, "vec pop from empty vec\n");
    exit(1);
  }
  return (int)vec->data[--vec->len];
  ```)

;; Free the vec and its data
(defn vec-free [v]
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *vec = (void*)v;
  free(vec->data);
  free(vec);
  ```)

;;; SINCE: Phase HKT H3
;; Functor instance for vec — apply fn to every element, return a new vec.
(defn __functor_vec_fmap [container fn] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *v =
      (struct { int64_t *data; size_t len; size_t cap; } *)(intptr_t)container;
  if (!v) return 0;
  struct { int64_t *data; size_t len; size_t cap; } *r =
      malloc(sizeof(struct { int64_t *data; size_t len; size_t cap; }));
  r->len  = v->len;
  r->cap  = v->len;
  r->data = r->len > 0 ? malloc(sizeof(int64_t) * r->len) : NULL;
  for (size_t i = 0; i < v->len; i++) {
      r->data[i] = ((int64_t(*)(int64_t))(intptr_t)fn)(v->data[i]);
  }
  return (int64_t)(intptr_t)r;
  ```)

(definstance Functor [vec]
  (fmap [container fn] (__functor_vec_fmap container fn)))

;; Foldable instance for vec.
;;   foldl :: (b -> a -> b) -> b -> t a -> b   (left fold, strict)
;;   foldr :: (a -> b -> b) -> b -> t a -> b   (right fold)
(defn __foldable_vec_foldl [ta init fn] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *v =
      (struct { int64_t *data; size_t len; size_t cap; } *)(intptr_t)ta;
  int64_t acc = init;
  if (!v) return acc;
  for (size_t i = 0; i < v->len; i++) {
      acc = ((int64_t(*)(int64_t, int64_t))(intptr_t)fn)(acc, v->data[i]);
  }
  return acc;
  ```)

(defn __foldable_vec_foldr [ta init fn] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *v =
      (struct { int64_t *data; size_t len; size_t cap; } *)(intptr_t)ta;
  int64_t acc = init;
  if (!v) return acc;
  for (size_t i = v->len; i-- > 0; ) {
      acc = ((int64_t(*)(int64_t, int64_t))(intptr_t)fn)(v->data[i], acc);
  }
  return acc;
  ```)

(definstance Foldable [vec]
  (foldl [ta init fn] (__foldable_vec_foldl ta init fn))
  (foldr [ta init fn] (__foldable_vec_foldr ta init fn)))
