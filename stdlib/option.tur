;;; tur/option -- typed Option[A]: parameterized optional value.
;;;
;;; First-class parameterized optional value type.
;;; Runtime layout specializes the payload slot for concrete A.
;;;
;;; Since: Phase TC1-D
;; Phase TC1-D: Typed Option[A]
;; First-class parameterized optional value type.
;; Runtime layout specializes the payload slot for concrete A.
;;; Option -- parameterized optional value containing either some A or none.
;;;
;;; Since: Phase TC1
(defstruct Option [A] (is-some :bool) (value A))
;;; some -- wrap a value of type A in a some Option[A].
;;;
;;; Parameters:
;;;   x -- the value to wrap (type A, stored as int64_t)
;;;
;;; Returns:
;;;   A heap-allocated Option[A] with is-some=true.
;;;
;;; Example:
;;;   (some 42)  ; => some(42)
;;;
;;; Since: Phase TC1

(defn some [x : int]
  #{}
  : int
  ```c return tur_some(x);
  ```)
;;; none -- return the none Option[A] (NULL).
;;;
;;; Returns:
;;;   0 (NULL) representing the absent option.
;;;
;;; Example:
;;;   (none)  ; => none
;;;
;;; Since: Phase TC1

(defn none []
  #{}
  : int
  ```c return TUR_NONE;
  ```)
;;; some? -- check whether an Option[A] contains a value.
;;;
;;; Parameters:
;;;   o -- Option[A]
;;;
;;; Returns:
;;;   true if o is some, false if o is none.
;;;
;;; Example:
;;;   (some? (some 1))  ; => true
;;;   (some? (none))    ; => false
;;;
;;; Since: Phase TC1

(defn some? [o : int]
  #{}
  : bool
  ```c return tur_is_some(o);
  ```)
;;; unwrap -- extract the value from a typed Option[A].
;;;
;;; Parameters:
;;;   o -- Option[A]
;;;
;;; Returns:
;;;   The contained value of type A.
;;;
;;; Example:
;;;   (let [o (:: (make-struct Option true 7) (Option int))]
;;;     (unwrap o))  ; => 7
;;;
;;; Since: Phase TC1

(defn unwrap [A] [o : (Option A)] :A (.value o))
;;; unwrap-or -- extract the value or return a default.
;;;
;;; Parameters:
;;;   o    -- Option[A]
;;;   dflt -- value to return if o is none (type A)
;;;
;;; Returns:
;;;   The contained value, or default if none.
;;;
;;; Example:
;;;   (unwrap-or (none) 99)   ; => 99
;;;   (unwrap-or (some 7) 99) ; => 7
;;;
;;; Since: Phase TC1

(defn unwrap-or [o : int dflt : int]
  #{}
  : int
  ```c return tur_is_some(o) ? tur_opt_value(o) : dflt;
  ```)
;;; option-free -- free a heap-allocated Option[A].
;;;
;;; Parameters:
;;;   o -- Option[A] to free (may be none / 0)
;;;
;;; Example:
;;;   (option-free my-opt)
;;;
;;; Since: Phase TC1

(defn option-free [o : int]
  #{}
  : void
  ```c if (o) free((void*)(intptr_t)o);
  ```)
;;; option-map -- apply a function to the contained value if some.
;;;
;;; Parameters:
;;;   o -- Option[A]
;;;   f -- function A -> B
;;;
;;; Returns:
;;;   Option[B] with f applied if some, or none.
;;;
;;; Example:
;;;   (option-map (some 3) (fn [x] (* x 2)))  ; => some(6)
;;;
;;; Since: Phase TC1

(defn option-map [o : int ^fat f]
  #{}
  : int
  ```c struct { bool is_some; int64_t value; } *opt = (void*)(intptr_t)o;
  if (!opt || !opt->is_some) return 0;
  struct { bool is_some; int64_t value; } *r = malloc(sizeof(*r));
  r->is_some = true;
  r->value = TUR_APPLY1(f, opt->value);
  return (int64_t)(intptr_t)r;
  ```)
;;; option-eq? -- compare two Option[A] values using a comparator.
;;;
;;; Parameters:
;;;   o1     -- first Option[A]
;;;   o2     -- second Option[A]
;;;   cmp-fn -- comparator fn [a :int b :int] :bool
;;;
;;; Returns:
;;;   true if both none, or both some with equal values.
;;;
;;; Example:
;;;   (option-eq? (some 1) (some 1) (fn [a b] (= a b)))  ; => true
;;;
;;; Since: Phase TC1

(defn option-eq? [o1 : int o2 : int ^fat cmp-fn]
  #{}
  : bool
  ```c struct { bool is_some; int64_t value; } *a = (void*)(intptr_t)o1;
  struct { bool is_some; int64_t value; } *b = (void*)(intptr_t)o2;
  bool a_some = a && a->is_some;
  bool b_some = b && b->is_some;
  if (!a_some && !b_some) return true;
  if (a_some != b_some)   return false;
  /* CRU B-3: cmp-fn is a fat closure box { thunk, env... }; fat-dispatch it
     through slot 0 so a capturing comparator works (a bare thin cast would
     read the box address as code).  Captureless lambdas are boxed at the call
     site via the ^fat auto-shim. */
  return ((bool(*)(void*, int64_t, int64_t))(intptr_t)((int64_t*)(intptr_t)cmp_fn)[0])((void*)(intptr_t)cmp_fn, a->value, b->value);
  ```)
;;; Eq [Option] -- equality using the inner type's Eq instance.
;; TC1-17: Phase PTC4 -- constrained Eq instance for Option[A].
;; Note: element comparison uses integer equality; correct for all primitive A.

(definstance Eq [Option] [(Eq A)]
  (eq? [x y] (option-eq? x y (fn [a b] (= a b)))))
;; ---------------------------------------------------------------------------
;; HKT typeclass instances (stdlib-hkt-consolidation T1)
;;
;; Option is a single-parameter type constructor of kind (* -> *), so the
;; standard Functor / Applicative / Monad / Alternative instances are all
;; directly expressible. Option owns these instances (it is the home module of
;; the Option type), so they are not orphans. The class stubs are preloaded
;; before this module (see the preload list in src/main.c).
;; ---------------------------------------------------------------------------
;;; Functor [Option] -- map a function over the some payload; none unchanged.
;;;
;;; Example:
;;;   (fmap (some 21) (fn [x] (* x 2)))  ; => some(42)
;;;
;;; Since: stdlib-hkt-consolidation T1
(definstance Functor [Option]
  (fmap [container fn]
    ```c
    struct { bool is_some; int64_t value; } *o = (void*)(intptr_t)container;
    if (!o || !o->is_some) return 0;
    return tur_some(fn.fn(fn.env, o->value));
    ```))
;;; Applicative [Option] -- pure wraps in some; ap applies a some function to a
;;; some argument (none when either side is none).
;;;
;;; Example:
;;;   (ap (some f) (some 3))  ; => some(f 3)
;;;
;;; Since: stdlib-hkt-consolidation T1
(definstance Applicative [Option]
  (pure [x]
    ```c return tur_some(x); ```)
  (ap [ff fa]
    ```c
    struct { bool is_some; int64_t value; } *f = (void*)(intptr_t)ff;
    struct { bool is_some; int64_t value; } *a = (void*)(intptr_t)fa;
    if (!f || !f->is_some || !a || !a->is_some) return 0;
    /* the wrapped function is a fat-closure box; dispatch through slot 0 */
    int64_t r = ((int64_t(*)(void*, int64_t))(intptr_t)((int64_t*)(intptr_t)f->value)[0])((void*)(intptr_t)f->value, a->value);
    return tur_some(r);
    ```))
;;; Monad [Option] -- bind sequences through some; short-circuits on none.
;;;
;;; Example:
;;;   (bind (some 20) (fn [x] (some (+ x 1))))  ; => some(21)
;;;
;;; Since: stdlib-hkt-consolidation T1
(definstance Monad [Option]
  (bind [ma fn]
    ```c
    struct { bool is_some; int64_t value; } *o = (void*)(intptr_t)ma;
    if (!o || !o->is_some) return 0;
    return fn.fn(fn.env, o->value);
    ```))
;;; Alternative [Option] -- empty is none; alt-or picks the first some.
;;;
;;; Example:
;;;   (alt-or (none) (some 7))  ; => some(7)
;;;
;;; Since: stdlib-hkt-consolidation T1
(definstance Alternative [Option]
  (empty [a]
    ```c (void)a; return 0; ```)
  (alt-or [a b]
    ```c
    struct { bool is_some; int64_t value; } *x = (void*)(intptr_t)a;
    if (x && x->is_some) return a;
    return b;
    ```))
