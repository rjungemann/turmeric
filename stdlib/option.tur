;;; tur/option -- typed Option[A]: parameterized optional value.
;;;
;;; First-class parameterized optional value type.
;;; Runtime layout specializes the payload slot for concrete A.
;;;
;;; Since: Phase TC1-D
;; Phase TC1-D: Typed Option[A]
;; First-class parameterized optional value type.
;; Runtime layout specializes the payload slot for concrete A.
;;; Option -- parameterized optional value containing either some A or none.
;;;
;;; Since: Phase TC1
(defstruct Option [A] (is-some :bool) (value A))
;;; some -- wrap a value of type A in a some Option[A].
;;;
;;; Parameters:
;;;   x -- the value to wrap (type A, stored as int64_t)
;;;
;;; Returns:
;;;   A heap-allocated Option[A] with is-some=true.
;;;
;;; Example:
;;;   (some 42)  ; => some(42)
;;;
;;; Since: Phase TC1

(defn some [A] [x : A]
  #fx{Construct}
  : (Option A)
  (make-struct Option :is-some true :value x))
;;; none -- return the none Option[A] (NULL).
;;;
;;; Returns:
;;;   0 (NULL) representing the absent option.
;;;
;;; Example:
;;;   (none)  ; => none
;;;
;;; Since: Phase TC1

(defn none [A]
  #fx{Construct}
  : (Option A)
  (make-struct Option :is-some false :value (default-of A)))
;;; some? -- check whether an Option[A] contains a value.
;;;
;;; Parameters:
;;;   o -- Option[A]
;;;
;;; Returns:
;;;   true if o is some, false if o is none.
;;;
;;; Example:
;;;   (some? (some 1))  ; => true
;;;   (some? (none))    ; => false
;;;
;;; Since: Phase TC1

(defn some? [A] [o : (Option A)] : bool (.is-some o))
;;; unwrap -- extract the value from a typed Option[A].
;;;
;;; Parameters:
;;;   o -- Option[A]
;;;
;;; Returns:
;;;   The contained value of type A.
;;;
;;; Example:
;;;   (let [o (:: (make-struct Option true 7) (Option int))]
;;;     (unwrap o))  ; => 7
;;;
;;; Since: Phase TC1

(defn unwrap [A] [o : (Option A)] :A (.value o))
;;; unwrap-or -- extract the value or return a default.
;;;
;;; Parameters:
;;;   o    -- Option[A]
;;;   dflt -- value to return if o is none (type A)
;;;
;;; Returns:
;;;   The contained value, or default if none.
;;;
;;; Example:
;;;   (unwrap-or (none) 99)   ; => 99
;;;   (unwrap-or (some 7) 99) ; => 7
;;;
;;; Since: Phase TC1

(defn unwrap-or [A] [o : (Option A) dflt : A] : A
  ;; Option none-as-NULL retirement (Track A, step 1.3): by-value `(Option A)`
  ;; receiver.  Pure-Turmeric body reads `.is-some`/`.value` directly; A is
  ;; inferred from `o` or from `dflt`.  The interpreter keeps its
  ;; `native_option_unwrap_or` override.  Carrier-context callers (a producer
  ;; that still returns the int64 carrier Option) use `unwrap-or-carrier` below.
  (if (.is-some o) (.value o) dflt))
;;; unwrap-or-carrier -- carrier-ABI shim for the Track A cascade: extract the
;;; value from the int64 carrier Option, or return dflt.  Temporary surface
;;; for producers that still return the carrier Option (e.g. zipper / kleisli);
;;; retired once those producers move to by-value `(Option A)`.  See
;;; docs/archive/history/unwrap-or-byvalue-cascade.md.

(defn unwrap-or-carrier [o : int dflt : int]
  #fx{}
  : int
  ```c
  return tur_is_some(o) ? tur_opt_value(o) : dflt;
  ```)
;;; option-free -- free a heap-allocated Option[A].
;;;
;;; Parameters:
;;;   o -- Option[A] to free (may be none / 0)
;;;
;;; Example:
;;;   (option-free my-opt)
;;;
;;; Since: Phase TC1

(defn option-free [o : int]
  #fx{}
  : void
  ```c
  if (o) free((void*)(intptr_t)o);
  ```)
;; Option none-as-NULL retirement (Track A): option-map is a pure-Turmeric
;; by-value `(Option A) -> (Option B)` body.  It reads `.is-some`/`.value`
;; directly and constructs its result with `(some ...)` / `(none)` in RETURN
;; position; inside a monomorphized spec the `(some ...)` arm constructs
;; `Option__B` by value (construct_recovered_byvalue, emit_module.c) and the
;; `(none)` arm now likewise mints a by-value `none__spec` clone -- elab
;; attaches the constructor-result-tyvar -> caller-tyvar binding for the 0-arg
;; `(none)` so emit can compose it through the active spec (the step-2
;; "0-arg constructor abi_bindings" follow-up in docs/reported/option-consumer-
;; retype-byvalue.md).  The interpreter keeps its `native_option_map` override.
;;; option-map -- apply a function to the contained value if some.
;;;
;;; Parameters:
;;;   o -- Option[A]
;;;   f -- function A -> B
;;;
;;; Returns:
;;;   Option[B] with f applied if some, or none.
;;;
;;; Example:
;;;   (option-map (some 3) (fn [x] (* x 2)))  ; => some(6)
;;;
;;; Note:
;;;   Mapping over a *literal* `(none)` with an *unannotated* lambda leaves the
;;;   element type under-determined (`(none)` carries no element type) and fails
;;;   to compile -- annotate the lambda or map over a typed Option value. See
;;;   docs/archive/history/option-map-literal-none-unannotated-fn-no-A-inference.md.
;;;
;;; Since: Phase TC1

(defn option-map [A B] [o : (Option A) ^fat f : (fn [A] B)] : (Option B)
  (if (.is-some o) (some (f (.value o))) (none)))
;; Option none-as-NULL retirement (Track A): by-value `(Option A)` receivers.
;; Pure-Turmeric body reads `.is-some`/`.value` directly; none (`{is_some=false}`)
;; is never deref'd.  The interpreter keeps its `native_option_eq` override.
;;; option-eq? -- compare two Option[A] values using a comparator.
;;;
;;; Parameters:
;;;   o1     -- first Option[A]
;;;   o2     -- second Option[A]
;;;   cmp-fn -- comparator fn [a :int b :int] :bool
;;;
;;; Returns:
;;;   true if both none, or both some with equal values.
;;;
;;; Example:
;;;   (option-eq? (some 1) (some 1) (fn [a b] (= a b)))  ; => true
;;;
;;; Since: Phase TC1

(defn option-eq? [A] [o1 : (Option A)
                      o2 : (Option A)
                      ^fat cmp-fn : (fn [A A] bool)] : bool
  (if (.is-some o1)
    (if (.is-some o2) (cmp-fn (.value o1) (.value o2)) false)
    (not (.is-some o2))))
;;; Eq [Option] -- equality using the inner type's Eq instance.
;; TC1-17: Phase PTC4 -- constrained Eq instance for Option[A].
;; Note: element comparison uses integer equality; correct for all primitive A.
;; M4c-pre-ext: rewrite to consult by-value fields directly via Eq A,
;; mirroring Eq Result/Tuple2/Pair.  `option-eq?` itself stays as a free
;; helper for callers that consult it directly via the carrier ABI.  See
;; docs/archive/m4c-stdlib-carrier-helpers-block-dispatch-rewrite.md.

(definstance Eq [Option]
  [(Eq A)]
  (eq? [x y]
    (if (= (.is-some x) (.is-some y))
      (if (.is-some x) (eq? (.value x) (.value y)) true)
      false)))
;; ---------------------------------------------------------------------------
;; HKT typeclass instances (stdlib-hkt-consolidation T1)
;;
;; Option is a single-parameter type constructor of kind (* -> *), so the
;; standard Functor / Applicative / Monad / Alternative instances are all
;; directly expressible. Option owns these instances (it is the home module of
;; the Option type), so they are not orphans. The class stubs are preloaded
;; before this module (see the preload list in src/main.c).
;; ---------------------------------------------------------------------------
;;; Functor [Option] -- map a function over the some payload; none unchanged.
;;;
;;; Example:
;;;   (fmap (some 21) (fn [x] (* x 2)))  ; => some(42)
;;;
;;; Since: stdlib-hkt-consolidation T1

(definstance Functor [Option]
  (fmap [container g]
    (if (some? container) (some (g (.value container))) (none))))
;;; Applicative [Option] -- pure wraps in some; ap applies a some function to a
;;; some argument (none when either side is none).
;;;
;;; Example:
;;;   (ap (some f) (some 3))  ; => some(f 3)
;;;
;;; Since: stdlib-hkt-consolidation T1

(definstance Applicative [Option]
  (pure [x] (some x))
  (ap [ff fa]
    (if (some? ff)
      (if (some? fa) (some ((.value ff) (.value fa))) (none))
      (none))))
;;; Monad [Option] -- bind sequences through some; short-circuits on none.
;;;
;;; Example:
;;;   (bind (some 20) (fn [x] (some (+ x 1))))  ; => some(21)
;;;
;;; Since: stdlib-hkt-consolidation T1

(definstance Monad [Option]
  (bind [ma k] (if (some? ma) (k (.value ma)) (none))))
;;; Alternative [Option] -- empty is none; alt-or picks the first some.
;;;
;;; Example:
;;;   (alt-or (none) (some 7))  ; => some(7)
;;;
;;; Since: stdlib-hkt-consolidation T1

(definstance Alternative [Option]
  (empty [a] (none))
  (alt-or [x y] (if (some? x) x y)))
