;; stdlib/session.tur -- Standard session-type protocol patterns.
;;
;; Provides reusable protocol templates built on the core session primitives
;; (make-session, send, recv, choose-left, choose-right, offer, close).
;;
;; Requires: -Xsessions
;;
;; Three patterns are provided:
;;   echo    -- recursive echo server / client helpers
;;   rpc     -- generic single-shot request/response
;;   pubsub  -- publish-subscribe subscriber loop
;;
;; Since: SS4

;; ---------------------------------------------------------------------------
;; echo -- trivial echo protocol
;;
;; EchoServerProto = Rec self (Branch (Recv int (Send int self)) Close)
;; EchoClientProto = Rec self (Choose (Send int (Recv int self)) Close)
;;
;; The server repeatedly offers: if Left arrives it recvs an int, sends it
;; back, and recurses; if Right arrives it closes the channel.
;; The client uses choose-left to send one int and recv the echo, or
;; choose-right to end the conversation.
;; ---------------------------------------------------------------------------

;;; echo-server-loop -- serve the echo protocol until the client closes.
;;;
;;; Parameters:
;;;   ch -- server-side channel with protocol
;;;         Session[Rec self (Branch (Recv int (Send int self)) Close)]
;;;
;;; Returns:
;;;   nil -- the function returns after the client sends Close
;;;
;;; Example:
;;;   (spawn (fn [] (echo-server-loop server-end)))
;;;
;;; Since: SS4
(defn echo-server-loop [^linear ch :(Session (Rec self (Branch (Recv int (Send int self)) Close)))] :nil
  (match (offer ch)
    (Left ch)
      (let [[n ch] (recv ch)]
        (let [ch (send ch n)]
          (echo-server-loop ch)))
    (Right ch)
      (close ch)))

;;; echo-client-call -- send one integer and receive the echo.
;;;
;;; Parameters:
;;;   ch  -- client-side channel with protocol
;;;          Session[Rec self (Choose (Send int (Recv int self)) Close)]
;;;   val -- integer to send and have echoed back
;;;
;;; Returns:
;;;   A pair [echoed-value, updated-channel] where updated-channel still has
;;;   the recursive EchoClientProto so more calls can be made.
;;;
;;; Example:
;;;   (let [[r ch] (echo-client-call ch 42)]
;;;     (println r))   ; => 42
;;;
;;; Since: SS4
(defn echo-client-call [^linear ch :(Session (Rec self (Choose (Send int (Recv int self)) Close))) val :int] :[(int (Session (Rec self (Choose (Send int (Recv int self)) Close))))]
  (let [ch (choose-left ch)]
    (let [ch (send ch val)]
      (recv ch))))

;; ---------------------------------------------------------------------------
;; rpc -- generic single-shot request/response
;;
;; RPC protocol (client view): Send req (Recv resp Close)
;; The client sends a request, receives a response, and closes.
;; ---------------------------------------------------------------------------

;;; rpc-call -- perform a single RPC: send request, receive response, close.
;;;
;;; Parameters:
;;;   ch  -- client channel with protocol Session[Send int (Recv int Close)]
;;;   req -- integer request value to send to the server
;;;
;;; Returns:
;;;   The integer response received from the server.  The channel is fully
;;;   consumed (closed) by this call.
;;;
;;; Example:
;;;   (let [resp (rpc-call ch 21)]
;;;     (println resp))   ; => 42 (if server doubles the value)
;;;
;;; Since: SS4
(defn rpc-call [^linear ch :(Session (Send int (Recv int Close))) req :int] :int
  (let [ch (send ch req)]
    (let [[resp ch] (recv ch)]
      (close ch)
      resp)))

;; ---------------------------------------------------------------------------
;; pubsub -- publish-subscribe protocol template
;;
;; Subscriber protocol: Recv msg (Rec self (Branch (Recv msg self) Close))
;;
;; The subscriber receives an initial message then enters a loop: offer the
;; channel; if Left (another message is coming) recv and recurse; if Right
;; the topic has closed, close the channel and stop.
;; ---------------------------------------------------------------------------

;;; pubsub-recv-loop -- receive messages from a topic until it closes.
;;;
;;; Parameters:
;;;   ch      -- subscriber channel with protocol
;;;              Session[Recv int (Rec self (Branch (Recv int self) Close))]
;;;   handler -- function called with each received integer message
;;;
;;; Returns:
;;;   nil -- returns after the topic sends the Close branch
;;;
;;; Example:
;;;   (pubsub-recv-loop sub-ch (fn [msg] (println msg)))
;;;
;;; Since: SS4
(defn pubsub-recv-loop [^linear ch :(Session (Recv int (Rec self (Branch (Recv int self) Close)))) handler :(-> int nil)] :nil
  (let [[msg ch] (recv ch)]
    (handler msg)
    (pubsub-recv-loop-inner ch handler)))

;;; pubsub-recv-loop-inner -- inner recursive loop after initial recv.
(defn pubsub-recv-loop-inner [^linear ch :(Session (Rec self (Branch (Recv int self) Close))) handler :(-> int nil)] :nil
  (match (offer ch)
    (Left ch)
      (let [[msg ch] (recv ch)]
        (handler msg)
        (pubsub-recv-loop-inner ch handler))
    (Right ch)
      (close ch)))
