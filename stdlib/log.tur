;;; tur/log -- Logger capability implementation using stderr/stdout.
;;;
;;; Implements the Logger capability typeclass for real logging output.
;;;
;;; Since: Phase 16
;; Phase 16: Real Logger implementation
;;
;; Implementation of Logger capability using stderr/stdout
;; stdout/stderr/fprintf come from the preamble's <stdio.h>, and time/ctime from
;; an explicit <time.h> include in the timestamped logger's c-block below -- so
;; they are NOT extern-c-declared here. A hand-rolled `extern int64_t stderr(...)`
;; redeclares the stdio macros, and time/ctime would get the wrong C prototypes
;; versus <time.h> (matches the stdlib/io.tur and fs.tur style).
(extern-c malloc [^ptr size] :ptr)

(extern-c free [^ptr p] :void)
(load "stdlib/effects.tur")
;; stdlib-effect-rows: the log-*-direct writers emit to stdout/stderr, so they
;; add the #{IO} capability tag alongside their existing #{Unsafe}.  The Logger
;; constructors/frees only allocate and stay #{Unsafe}.
;;; Real-Logger -- create a timestamped Logger capability writing to stdout/stderr.
;;;
;;; Returns:
;;;   A heap-allocated Logger struct whose debug/info methods write to
;;;   stdout and warn/error methods write to stderr, each line prefixed
;;;   with a ctime timestamp and the level name.
;;;   Free with Real-Logger-free when done.
;;;
;;; Example:
;;;   (let [log (Real-Logger)] ...)
;;;
;;; Since: Phase 16
;; Real-Logger implementation
;; Writes to stderr with timestamps

;; file-scope-c-block: the Logger capability is a struct of function pointers,
;; so its implementations must be FILE-SCOPE C functions (a returned vtable
;; cannot point at functions nested inside the constructor body). The shared
;; struct, the timestamp helpers, and every logger's method set are hoisted here.
```c
#include <time.h>

typedef struct __tur_logger {
    void (*debug)(const char* msg);
    void (*info)(const char* msg);
    void (*warn)(const char* msg);
    void (*error)(const char* msg);
} __tur_logger;

/* Real-Logger: timestamped, debug/info -> stdout, warn/error -> stderr. */
static const char* __tur_log_timestamp(void) {
    time_t now = time(NULL);
    return ctime(&now);
}
static void __tur_log_with_level(FILE* stream, const char* level, const char* msg) {
    const char* ts = __tur_log_timestamp();
    /* Remove newline from ctime */
    char ts_buf[32];
    size_t len = strlen(ts);
    if (len > 0 && ts[len-1] == '\n') {
        memcpy(ts_buf, ts, len - 1);
        ts_buf[len - 1] = '\0';
    } else {
        strcpy(ts_buf, ts);
    }
    fprintf(stream, "[%s] [%s] %s\n", ts_buf, level, msg);
    fflush(stream);
}
static void __tur_log_real_debug(const char* msg) { __tur_log_with_level(stdout, "DEBUG", msg); }
static void __tur_log_real_info(const char* msg)  { __tur_log_with_level(stdout, "INFO",  msg); }
static void __tur_log_real_warn(const char* msg)  { __tur_log_with_level(stderr, "WARN",  msg); }
static void __tur_log_real_error(const char* msg) { __tur_log_with_level(stderr, "ERROR", msg); }

/* Simple-Logger: same routing, no timestamps. */
static void __tur_log_simple_debug(const char* msg) { fprintf(stdout, "[DEBUG] %s\n", msg); fflush(stdout); }
static void __tur_log_simple_info(const char* msg)  { fprintf(stdout, "[INFO] %s\n",  msg); fflush(stdout); }
static void __tur_log_simple_warn(const char* msg)  { fprintf(stderr, "[WARN] %s\n",  msg); fflush(stderr); }
static void __tur_log_simple_error(const char* msg) { fprintf(stderr, "[ERROR] %s\n", msg); fflush(stderr); }

/* Null-Logger: discard everything. */
static void __tur_log_null(const char* msg) { (void)msg; }
```

(defn Real-Logger []
  #{Unsafe}
  : int
  ```c __tur_logger* logger = (__tur_logger*)malloc(sizeof(__tur_logger));
  logger->debug = __tur_log_real_debug;
  logger->info  = __tur_log_real_info;
  logger->warn  = __tur_log_real_warn;
  logger->error = __tur_log_real_error;
  return (int64_t)(intptr_t)logger;
  ```)
;;; Real-Logger-free -- release a Logger capability created by Real-Logger.
;;;
;;; Parameters:
;;;   log -- the Logger pointer returned by Real-Logger.
;;;
;;; Since: Phase 16
;; Free a Real-Logger

(defn Real-Logger-free [log]
  #{Unsafe}
  : nil
  ```c free((void*)(intptr_t)log);
  ```)
;; ============================================================================
;; Simple logger without timestamps (faster)
;; ============================================================================
;;; Simple-Logger -- create a lightweight Logger capability without timestamps.
;;;
;;; Returns:
;;;   A heap-allocated Logger struct whose debug/info methods write to
;;;   stdout and warn/error methods write to stderr, each line prefixed
;;;   with only the level tag (e.g. "[DEBUG] ...").
;;;   Free with Simple-Logger-free when done.
;;;
;;; Example:
;;;   (let [log (Simple-Logger)] ...)
;;;
;;; Since: Phase 16
;; Simple-Logger implementation - no timestamps, just writes to stderr/stdout


(defn Simple-Logger []
  #{Unsafe}
  : int
  ```c __tur_logger* logger = (__tur_logger*)malloc(sizeof(__tur_logger));
  logger->debug = __tur_log_simple_debug;
  logger->info  = __tur_log_simple_info;
  logger->warn  = __tur_log_simple_warn;
  logger->error = __tur_log_simple_error;
  return (int64_t)(intptr_t)logger;
  ```)
;;; Simple-Logger-free -- release a Logger capability created by Simple-Logger.
;;;
;;; Parameters:
;;;   log -- the Logger pointer returned by Simple-Logger.
;;;
;;; Since: Phase 16
;; Free a Simple-Logger

(defn Simple-Logger-free [log]
  #{Unsafe}
  : nil
  ```c free((void*)(intptr_t)log);
  ```)
;; ============================================================================
;; Null logger (silent)
;; ============================================================================
;;; Null-Logger -- create a silent Logger capability that discards all messages.
;;;
;;; Returns:
;;;   A heap-allocated Logger struct where all four methods (debug, info,
;;;   warn, error) are no-ops.  Useful as a default/test double.
;;;   Free with Null-Logger-free when done.
;;;
;;; Example:
;;;   (let [log (Null-Logger)] ...)
;;;
;;; Since: Phase 16
;; Null-Logger implementation - discards all messages


(defn Null-Logger []
  #{Unsafe}
  : int
  ```c __tur_logger* logger = (__tur_logger*)malloc(sizeof(__tur_logger));
  logger->debug = __tur_log_null;
  logger->info  = __tur_log_null;
  logger->warn  = __tur_log_null;
  logger->error = __tur_log_null;
  return (int64_t)(intptr_t)logger;
  ```)
;;; Null-Logger-free -- release a Logger capability created by Null-Logger.
;;;
;;; Parameters:
;;;   log -- the Logger pointer returned by Null-Logger.
;;;
;;; Since: Phase 16
;; Free a Null-Logger

(defn Null-Logger-free [log]
  #{Unsafe}
  : nil
  ```c free((void*)(intptr_t)log);
  ```)
;; ============================================================================
;; Helper functions for direct logging (without capabilities)
;; ============================================================================
;;; log-debug-direct -- write a DEBUG message directly to stdout.
;;;
;;; Parameters:
;;;   msg -- the message string to log (:cstr).
;;;
;;; Example:
;;;   (log-debug-direct "starting up")
;;;   ; prints: [DEBUG] starting up
;;;
;;; Since: Phase 16
;; Log a debug message


(defn log-debug-direct [msg : cstr]
  #{Unsafe IO}
  : nil
  ```c fprintf(stdout, "[DEBUG] %s\n", msg);
  fflush(stdout);
  ```)
;;; log-info-direct -- write an INFO message directly to stdout.
;;;
;;; Parameters:
;;;   msg -- the message string to log (:cstr).
;;;
;;; Example:
;;;   (log-info-direct "server ready")
;;;   ; prints: [INFO] server ready
;;;
;;; Since: Phase 16
;; Log an info message

(defn log-info-direct [msg : cstr]
  #{Unsafe IO}
  : nil
  ```c fprintf(stdout, "[INFO] %s\n", msg);
  fflush(stdout);
  ```)
;;; log-warn-direct -- write a WARN message directly to stderr.
;;;
;;; Parameters:
;;;   msg -- the message string to log (:cstr).
;;;
;;; Example:
;;;   (log-warn-direct "config missing, using defaults")
;;;   ; prints to stderr: [WARN] config missing, using defaults
;;;
;;; Since: Phase 16
;; Log a warning message

(defn log-warn-direct [msg : cstr]
  #{Unsafe IO}
  : nil
  ```c fprintf(stderr, "[WARN] %s\n", msg);
  fflush(stderr);
  ```)
;;; log-error-direct -- write an ERROR message directly to stderr.
;;;
;;; Parameters:
;;;   msg -- the message string to log (:cstr).
;;;
;;; Example:
;;;   (log-error-direct "fatal: out of memory")
;;;   ; prints to stderr: [ERROR] fatal: out of memory
;;;
;;; Since: Phase 16
;; Log an error message

(defn log-error-direct [msg : cstr]
  #{Unsafe IO}
  : nil
  ```c fprintf(stderr, "[ERROR] %s\n", msg);
  fflush(stderr);
  ```)
