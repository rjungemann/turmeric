;;; tur/stm -- Software Transactional Memory: transactional read/write on TVars.
;;;
;;; Transactions are retried automatically on conflict.
;;;
;;; Since: Phase 20
;; stdlib/stm.tur - Software Transactional Memory (Phase 20/21)
;;
;; Minimal version for STM primitives
(extern-c malloc [^int size] :ptr)

(extern-c free [^ptr p] :void)
;; ---- Opaque handle newtype (stdlib-opaque-handle-types-plan, Tier 3) ----
;; TVar wraps the transactional-variable handle (a :ptr) with a nominally
;; distinct type, so the checker rejects passing a boxed VALUE (also a :ptr)
;; where a TVar handle is expected, or vice versa. It lowers to :ptr in the C
;; ABI, so the inline-C bodies are unchanged.

(defopaque TVar :ptr)
;;; ptr/null -- return a null pointer constant.
;;;
;;; Returns:
;;;   A :ptr value equal to NULL.
;;;
;;; Example:
;;;   (ptr/null)  ; => ptr (NULL)
;;;
;;; Since: Phase 20

(defn ptr/null []
  #fx{Unsafe}
  : ptr
  ```c
  return NULL;
  ```)
;;; tvar/new -- create a new transactional variable with an initial value.
;;;
;;; Parameters:
;;;   init -- initial integer value stored in the TVar
;;;
;;; Returns:
;;;   A TVar handle to the newly allocated transactional variable.
;;;
;;; Example:
;;;   (let [tv (tvar/new 0)] ...)  ; => ptr
;;;
;;; Since: Phase 20

(defn tvar/new [init]
  #fx{Unsafe}
  : TVar
  ```c
  TVar *tv = tur_tvar_new(NULL, (void*)(intptr_t)init);
  /* TVar is a defopaque over :ptr, which lowers to int64_t -- returning the
     bare `void *` is an int-to-pointer conversion warning under the cc-warn
     ratchet. Surfaces only when stm.tur is explicitly (load ...)ed. */
  return (void *)(intptr_t)tv;
  ```)
;;; tvar/read -- read the current value of a TVar within the active transaction.
;;;
;;; Parameters:
;;;   tv -- TVar handle returned by tvar/new
;;;
;;; Returns:
;;;   The current transactional value as a ptr.
;;;
;;; Example:
;;;   (tvar/read tv)  ; => ptr
;;;
;;; Since: Phase 20

(defn tvar/read [tv : TVar]
  #fx{Unsafe}
  : ptr
  ```c
  return (void*)tur_tvar_read(tur_stm_current_tx(), (TVar*)tv);
  ```)
;;; tvar/write -- write a new value to a TVar within the active transaction.
;;;
;;; Parameters:
;;;   tv  -- TVar handle returned by tvar/new
;;;   val -- new value to record in the transaction log
;;;
;;; Example:
;;;   (tvar/write tv new-val)
;;;
;;; Since: Phase 20

(defn tvar/write [tv : TVar val : ptr]
  #fx{Unsafe}
  : nil
  ```c
  tur_tvar_write(tur_stm_current_tx(), (TVar*)(intptr_t)tv, (void*)val);
  /* `: nil` lowers to C `void`; `return 0;` here was a -Wreturn-type warning. */
  ```)
;;; tvar/swap -- atomically replace a TVar's value and return the old value.
;;;
;;; Parameters:
;;;   tv  -- TVar handle returned by tvar/new
;;;   new -- replacement value
;;;
;;; Returns:
;;;   The previous value of the TVar within the current transaction.
;;;
;;; Example:
;;;   (tvar/swap tv new-val)  ; => ptr (old value)
;;;
;;; Since: Phase 20

(defn tvar/swap [tv : TVar new : ptr]
  #fx{Unsafe}
  : ptr
  ```c
  return (void*)tur_tvar_swap(tur_stm_current_tx(), (TVar*)tv, (void*)new);
  ```)
;;; tvar/cas -- compare-and-swap a TVar within the active transaction.
;;;
;;; Parameters:
;;;   tv  -- TVar handle returned by tvar/new
;;;   old -- expected current value
;;;   new -- desired replacement value
;;;
;;; Returns:
;;;   true if the swap was recorded (old matched); false otherwise.
;;;
;;; Example:
;;;   (tvar/cas tv expected new-val)  ; => bool
;;;
;;; Since: Phase 21

(defn tvar/cas [tv : TVar old : ptr new : ptr]
  #fx{Unsafe}
  : bool
  ```c
  return tur_tvar_cas(tur_stm_current_tx(), (TVar*)tv, (void*)old, (void*)new);
  ```)
