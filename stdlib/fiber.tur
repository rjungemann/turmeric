; Phase T21-C: Fiber API — lightweight cooperative fibers via FiberBlock.
;
; All functions delegate directly to the FiberBlock C runtime emitted into
; every compiled Turmeric program by emit.c (FiberBlock + tur_fiber_block_*).
;
; Usage:
;   (let [f (fiber-new fn-ref 0)] ...)
;   (fiber-resume f 0)          ; returns yielded or final value as :int
;   (fiber-done? f)             ; returns non-zero if fiber has returned
;   (fiber-free f)              ; release memory
;
; Inside a fiber body (fn-ref is a zero-arg function taking no args):
;   (fiber-yield 42)            ; suspend and hand 42 back to caller

(defn fiber-new [fn :ptr<void> stack-size :int] :ptr<void>
  ```c
  return (void *)tur_fiber_block_new((void(*)(void))fn, (size_t)stack_size);
  ```)

(defn fiber-resume [f :ptr<void> arg :int] :int
  ```c
  return tur_fiber_block_resume((FiberBlock *)f, (int64_t)arg);
  ```)

(defn fiber-yield [value :int] :nil
  ```c
  tur_fiber_block_yield(value);
  ```)

(defn fiber-done? [f :ptr<void>] :int
  ```c
  FiberBlock *fb = (FiberBlock *)f;
  return fb ? (int64_t)fb->done : 1;
  ```)

(defn fiber-arg [f :ptr<void>] :int
  ```c
  FiberBlock *fb = (FiberBlock *)f;
  return fb ? fb->arg : 0;
  ```)

(defn fiber-free [f :ptr<void>] :nil
  ```c
  tur_fiber_block_free((FiberBlock *)f);
  ```)

;; Phase T21: Fiber-local storage
;; Each fiber can store key-value pairs that persist for the lifetime of the fiber.
;; Keys and values are int64_t.

(defn fiber-local-get [f :ptr<void> key :int] :int
  ```c
  return tur_fiber_local_get((FiberBlock *)f, (int64_t)key);
  ```)

(defn fiber-local-set! [f :ptr<void> key :int value :int] :nil
  ```c
  tur_fiber_local_set((FiberBlock *)f, (int64_t)key, (int64_t)value);
  ```)

;; Current fiber versions - use tur_current_fiber implicitly
(defn fiber-local-current-get [key :int] :int
  ```c
  return tur_fiber_local_get(tur_current_fiber, (int64_t)key);
  ```)

(defn fiber-local-current-set! [key :int value :int] :nil
  ```c
  tur_fiber_local_set(tur_current_fiber, (int64_t)key, (int64_t)value);
  ```)

;; ---- Phase T21: Scheduler wrappers ----
;;
;; These call the cooperative scheduler's yield/park/unpark primitives.
;; Must be called from within a fiber running under a TurScheduler.

;; Yield the current fiber back to the scheduler (re-enqueues it for next turn).
(defn scheduler-yield! [] :nil
  ```c
  tur_scheduler_yield();
  ```)

;; Park the current fiber: suspend without re-enqueueing.
;; The fiber stays parked until scheduler-unpark! is called on it.
(defn scheduler-park! [] :nil
  ```c
  tur_scheduler_park();
  ```)

;; Unpark a fiber: clear its parked flag and add it back to the scheduler queue.
(defn scheduler-unpark! [f :ptr<void>] :nil
  ```c
  tur_scheduler_unpark((FiberBlock *)f);
  ```)

;; Convenience: async-sleep [ms] — sleep for approximately ms milliseconds.
;; Uses nanosleep; does not require a scheduler.
(defn async-sleep [ms :int] :nil
  ```c
  if (ms <= 0) return;
  struct timespec ts;
  ts.tv_sec  = (time_t)((int64_t)ms / 1000);
  ts.tv_nsec = (long)(((int64_t)ms % 1000) * 1000000L);
  nanosleep(&ts, NULL);
  ```)