;; Signal Processing DSP Primitives
;;
;; This module provides digital signal processing primitives as Signal Functions (SF).
;; All primitives are implemented using the Arrow typeclass hierarchy.

(import stdlib/signal/core.tur)

;; =============================================================================
;; Basic Signal Sources
;; =============================================================================

;;; sine-osc -- stateless sine-wave SF placeholder (requires time input).
;;;
;;; Parameters:
;;;   freq  -- frequency in Hz
;;;   phase -- phase offset in radians
;;;
;;; Returns:
;;;   SF<(),Sample> (use time-sine-osc for a working version).
(defn sine-osc [freq : Sample] [phase : Sample]
  : (SF () Sample)
  (arr (fn [_]
    (let [t (error "sine-osc needs time - use time-sine-osc")]
      (math/sin (+ (* 2.0 math/PI freq t) phase))))))

;;; time-sine-osc -- sine oscillator that takes an explicit time signal as input.
;;;
;;; Parameters:
;;;   freq  -- frequency in Hz
;;;   phase -- phase offset in radians
;;;
;;; Returns:
;;;   SF<Time,Sample> mapping time values to sine samples in [-1, 1].
;;;
;;; Example:
;;;   (time-sine-osc 440.0 0.0)
(defn time-sine-osc [freq : Sample] [phase : Sample]
  : (SF Time Sample)
  (arr (fn [t]
    (math/sin (+ (* 2.0 math/PI freq t) phase)))))

;;; sine -- sine oscillator that ignores its input and reads global time.
;;;
;;; Parameters:
;;;   freq  -- frequency in Hz
;;;   phase -- phase offset in radians
;;;
;;; Returns:
;;;   SF<(),Sample> producing sine samples in [-1, 1].
;;;
;;; Example:
;;;   ((sine 440.0 0.0) (constant ()))
(defn sine [freq : Sample] [phase : Sample]
  : (SF () Sample)
  (fn [_sig]
    (fn [t]
      (math/sin (+ (* 2.0 math/PI freq t) phase)))))

;;; square -- square wave oscillator.
;;;
;;; Parameters:
;;;   freq -- frequency in Hz
;;;   duty -- duty cycle (0.0 to 1.0), fraction of period that is high
;;;
;;; Returns:
;;;   SF<(),Sample> producing values in [-1, 1].
;;;
;;; Example:
;;;   ((square 220.0 0.5) (constant ()))
(defn square [freq : Sample] [duty : Sample]
  : (SF () Sample)
  (fn [_sig]
    (fn [t]
      (let [saw (mod (* freq t) 1.0)]
        (if (< saw duty) 1.0 -1.0)))))

;;; sawtooth -- sawtooth wave oscillator.
;;;
;;; Parameters:
;;;   freq -- frequency in Hz
;;;
;;; Returns:
;;;   SF<(),Sample> producing values in [0, 1).
;;;
;;; Example:
;;;   ((sawtooth 110.0) (constant ()))
(defn sawtooth [freq : Sample]
  : (SF () Sample)
  (fn [_sig]
    (fn [t]
      (mod (* freq t) 1.0))))

;;; triangle -- triangle wave oscillator.
;;;
;;; Parameters:
;;;   freq -- frequency in Hz
;;;
;;; Returns:
;;;   SF<(),Sample> producing values in [-1, 1].
;;;
;;; Example:
;;;   ((triangle 880.0) (constant ()))
(defn triangle [freq : Sample]
  : (SF () Sample)
  (fn [_sig]
    (fn [t]
      (let [x (mod (* freq t) 1.0)]
        (if (< x 0.5)
          (* 2.0 x)
          (* -2.0 (- x 1.0)))))))

;;; white-noise -- pseudo-random white noise generator.
;;;
;;; Returns:
;;;   SF<(),Sample> producing uncorrelated samples in [-1, 1].
;;;
;;; Example:
;;;   ((white-noise) (constant ()))
(defn white-noise []
  : (SF () Sample)
  (fn [_sig]
    (let [seed-ref (ref 42)]
      (fn [t]
        ;; Simple linear congruential generator
        (let [seed (* 1664525 @seed-ref + 1013904223)
              new-seed (mod seed 4294967296)]
          (set! seed-ref new-seed)
          ;; Convert to [-1, 1]
          (/ (* 2.0 new-seed) 4294967296.0 - 1.0))))))

;;; impulse -- periodic impulse train.
;;;
;;; Parameters:
;;;   freq  -- frequency in Hz
;;;   width -- width of each impulse in seconds
;;;
;;; Returns:
;;;   SF<(),Sample> outputting 1.0 during impulse windows, 0.0 otherwise.
;;;
;;; Example:
;;;   ((impulse 2.0 0.001) (constant ()))
(defn impulse [freq : Sample] [width : Sample]
  : (SF () Sample)
  (fn [_sig]
    (fn [t]
      (let [phase (mod (* freq t) 1.0)]
        (if (< phase (* freq width)) 1.0 0.0)))))

;; =============================================================================
;; Basic Signal Processors
;; =============================================================================

;;; gain -- multiply signal amplitude by a constant factor.
;;;
;;; Parameters:
;;;   g -- gain factor
;;;
;;; Returns:
;;;   SF<Sample,Sample> that scales each sample by g.
;;;
;;; Example:
;;;   (gain 0.5)  ; => -6 dB attenuation
(defn gain [g : Sample]
  : (SF Sample Sample)
  (arr (fn [x] (* g x))))

;;; offset -- add a DC bias to the signal.
;;;
;;; Parameters:
;;;   o -- offset amount
;;;
;;; Returns:
;;;   SF<Sample,Sample> that adds o to each sample.
;;;
;;; Example:
;;;   (offset 0.5)  ; shifts signal upward by 0.5
(defn offset [o : Sample]
  : (SF Sample Sample)
  (arr (fn [x] (+ x o))))

;;; invert -- negate a signal (multiply by -1).
;;;
;;; Returns:
;;;   SF<Sample,Sample> inverting polarity.
(defn invert []
  : (SF Sample Sample)
  (gain -1.0))

;;; abs-sf -- absolute value of each sample.
;;;
;;; Returns:
;;;   SF<Sample,Sample> returning |x| for each sample x.
(defn abs-sf []
  : (SF Sample Sample)
  (arr (fn [x] (math/abs x))))

;;; clip -- hard clip signal to a symmetric range.
;;;
;;; Parameters:
;;;   min-val -- minimum allowed sample value
;;;   max-val -- maximum allowed sample value
;;;
;;; Returns:
;;;   SF<Sample,Sample> clamping output to [min-val, max-val].
;;;
;;; Example:
;;;   (clip -0.8 0.8)
(defn clip [min-val : Sample] [max-val : Sample]
  : (SF Sample Sample)
  (arr (fn [x]
    (math/clamp x min-val max-val))))

;; =============================================================================
;; Mixing and Combining
;; =============================================================================

;;; add -- add the two samples of a product signal.
;;;
;;; Returns:
;;;   SF<Tuple Sample Sample, Sample> returning x + y.
;;;
;;; Example:
;;;   (add)
(defn add []
  : (SF (Tuple Sample Sample) Sample)
  (arr (fn [[x y]] (+ x y))))

;;; subtract -- subtract second sample from first.
;;;
;;; Returns:
;;;   SF<Tuple Sample Sample, Sample> returning x - y.
(defn subtract []
  : (SF (Tuple Sample Sample) Sample)
  (arr (fn [[x y]] (- x y))))

;;; multiply -- multiply the two samples of a product signal.
;;;
;;; Returns:
;;;   SF<Tuple Sample Sample, Sample> returning x * y.
;;;
;;; Example:
;;;   (multiply)  ; useful for AM or ring modulation
(defn multiply []
  : (SF (Tuple Sample Sample) Sample)
  (arr (fn [[x y]] (* x y))))

;;; mix -- linear blend of two samples with a ratio.
;;;
;;; Parameters:
;;;   ratio -- blend amount: 0.0 = all second, 1.0 = all first, 0.5 = equal
;;;
;;; Returns:
;;;   SF<Tuple Sample Sample, Sample> returning ratio*x + (1-ratio)*y.
;;;
;;; Example:
;;;   (mix 0.5)  ; equal blend
(defn mix [ratio : Sample]
  : (SF (Tuple Sample Sample) Sample)
  (arr (fn [[x y]] (+ (* ratio x) (* (- 1.0 ratio) y)))))

;;; average -- average a vector of samples.
;;;
;;; Parameters:
;;;   n -- number of signals (length of the input vector)
;;;
;;; Returns:
;;;   SF<vec Sample, Sample> returning the arithmetic mean.
(defn average [n : int]
  : (SF (vec Sample) Sample)
  (arr (fn [samples]
    (let [sum (reduce + 0.0 samples)]
      (/ sum n)))))

;; =============================================================================
;; Filters
;; =============================================================================

;;; low-pass -- one-pole IIR low-pass filter.
;;;
;;; Parameters:
;;;   alpha -- smoothing coefficient (0.0 = no smoothing, 1.0 = full smoothing)
;;;
;;; Returns:
;;;   SF<Sample,Sample> implementing y[n] = alpha*x[n] + (1-alpha)*y[n-1].
;;;
;;; Example:
;;;   (low-pass 0.1)  ; heavy smoothing
(defn low-pass [alpha : Sample]
  : (SF Sample Sample)
  (state-sf 0.0
    (fn [y-prev x]
      (let [y (+ (* alpha x) (* (- 1.0 alpha) y-prev))]
        (Tuple y y)))))

;;; high-pass -- one-pole IIR high-pass filter.
;;;
;;; Parameters:
;;;   alpha -- smoothing coefficient
;;;
;;; Returns:
;;;   SF<Sample,Sample> implementing y[n] = alpha*(y[n-1] + x[n] - x[n-1]).
;;;
;;; Example:
;;;   (high-pass 0.9)
(defn high-pass [alpha : Sample]
  : (SF Sample Sample)
  (fn [sig-in]
    (let [x-prev (ref 0.0)
          y-prev (ref 0.0)]
      (fn [t]
        (let [x (sig-in t)
              y (+ (* alpha (+ x (- @y-prev) (- x @x-prev))) @y-prev)]
          (set! x-prev x)
          (set! y-prev y)
          y)))))

;;; svf -- state variable filter with simultaneous LP/BP/HP outputs.
;;;
;;; Parameters:
;;;   freq -- normalised cutoff frequency (0.0 to 1.0, where 1.0 = Nyquist)
;;;   q    -- resonance / quality factor
;;;
;;; Returns:
;;;   SF<Sample, Tuple Sample Sample Sample> yielding (low-pass, band-pass, high-pass).
;;;
;;; Example:
;;;   (svf 0.2 1.0)
(defn svf [freq : Sample] [q : Sample]
  : (SF Sample (Tuple Sample Sample Sample))
  (fn [sig-in]
    (let [z1 (ref 0.0)
          z2 (ref 0.0)]
      (fn [t]
        (let [x (sig-in t)
              ;; SVF equations
              v1 (- x @z1)
              v2 (- @z1 @z2)
              v3 (- @z2 (* q v2))
              v4 (- v3 @z2)

              ;; Update state
              z1-new (+ @z1 (* freq v1))
              z2-new (+ @z2 (* freq v3))]
          (set! z1 z1-new)
          (set! z2 z2-new)
          (Tuple @z1 v4 (- v1 (* q v3))))))))

;;; svf-low-pass -- low-pass output from the state variable filter.
;;;
;;; Parameters:
;;;   freq -- normalised cutoff frequency
;;;   q    -- resonance
;;;
;;; Returns:
;;;   SF<Sample,Sample> (low-pass band only).
(defn svf-low-pass [freq : Sample] [q : Sample]
  : (SF Sample Sample)
  (>>> (svf freq q) (arr (fn [[lp _ _]] lp))))

;;; svf-band-pass -- band-pass output from the state variable filter.
;;;
;;; Parameters:
;;;   freq -- normalised center frequency
;;;   q    -- resonance
;;;
;;; Returns:
;;;   SF<Sample,Sample> (band-pass band only).
(defn svf-band-pass [freq : Sample] [q : Sample]
  : (SF Sample Sample)
  (>>> (svf freq q) (arr (fn [[_ bp _]] bp))))

;;; svf-high-pass -- high-pass output from the state variable filter.
;;;
;;; Parameters:
;;;   freq -- normalised cutoff frequency
;;;   q    -- resonance
;;;
;;; Returns:
;;;   SF<Sample,Sample> (high-pass band only).
(defn svf-high-pass [freq : Sample] [q : Sample]
  : (SF Sample Sample)
  (>>> (svf freq q) (arr (fn [[_ _ hp]] hp))))

;;; all-pass -- all-pass filter for phase shifting without amplitude change.
;;;
;;; Parameters:
;;;   freq -- normalised frequency parameter
;;;   q    -- resonance parameter
;;;
;;; Returns:
;;;   SF<Sample,Sample> shifting phase while preserving amplitude.
(defn all-pass [freq : Sample] [q : Sample]
  : (SF Sample Sample)
  (fn [sig-in]
    (let [z1 (ref 0.0)
          z2 (ref 0.0)]
      (fn [t]
        (let [x (sig-in t)
              v1 (- x @z1)
              v2 (- @z1 @z2)
              v3 (- @z2 (* q v2))

              z1-new (+ @z1 (* freq v1))
              z2-new (+ @z2 (* freq v3))

              ;; All-pass output: v1 - 2*v3
              y (- v1 (* 2.0 v3))]
          (set! z1 z1-new)
          (set! z2 z2-new)
          y)))))

;; =============================================================================
;; Delay and Echo Effects
;; =============================================================================

;;; delay -- feedback delay line using a circular buffer.
;;;
;;; Parameters:
;;;   delay-time -- delay length in seconds
;;;   feedback   -- feedback gain (0.0 to 1.0)
;;;   max-delay  -- buffer size in samples
;;;
;;; Returns:
;;;   SF<Sample,Sample> with delay effect applied.
;;;
;;; Example:
;;;   (delay 0.25 0.5 22050)
(defn delay [delay-time : Sample] [feedback : Sample] [max-delay : int]
  : (SF Sample Sample)
  (fn [sig-in]
    (let [;; Circular buffer implementation
          buffer (vec-create max-delay 0.0)
          write-pos (ref 0)
          ;; Calculate delay in samples (assuming 44100 Hz sample rate)
          sample-rate 44100.0
          delay-samples (int (math/round (* delay-time sample-rate)))
          read-pos-calc (fn [wp] (mod (- wp delay-samples) max-delay))]

      (fn [t]
        (let [x (sig-in t)
              wp @write-pos
              rp (read-pos-calc wp)
              y (vec-get buffer rp)
              new-val (+ x (* feedback y))]
          (vec-set! buffer wp new-val)
          (set! write-pos (mod (+ wp 1) max-delay))
          new-val)))))

;;; echo -- multi-tap echo using direct signal access.
;;;
;;; Parameters:
;;;   delay-time -- time between echoes in seconds
;;;   decay      -- amplitude decay factor per echo
;;;   num-echos  -- number of echo repetitions
;;;
;;; Returns:
;;;   SF<Sample,Sample> summing the original with decayed, delayed copies.
;;;
;;; Example:
;;;   (echo 0.3 0.6 4)
(defn echo [delay-time : Sample] [decay : Sample] [num-echos : int]
  : (SF Sample Sample)
  (fn [sig-in]
    (let [delays (map (fn [i] (* delay-time (+ i 1.0))) (range 0 num-echos))
          feedbacks (map (fn [i] (math/pow decay i)) (range 0 num-echos))]
      (fn [t]
        (let [x (sig-in t)
              ;; Sum original with delayed versions
              result (ref x)]
          (for [i 0 num-echos]
            (let [d (nth delays i)
                  fb (nth feedbacks i)
                  delayed (sig-in (- t d))]
              (set! result (+ @result (* fb delayed)))))
          @result)))))

;; =============================================================================
;; Non-linear Processors
;; =============================================================================

;;; hard-clip -- symmetric hard clipping distortion.
;;;
;;; Parameters:
;;;   threshold -- clipping level (output clamped to [-threshold, threshold])
;;;
;;; Returns:
;;;   SF<Sample,Sample> with hard-clipped output.
;;;
;;; Example:
;;;   (hard-clip 0.7)
(defn hard-clip [threshold : Sample]
  : (SF Sample Sample)
  (arr (fn [x]
    (math/clamp x (- threshold) threshold))))

;;; soft-clip -- smooth tanh-based saturation.
;;;
;;; Parameters:
;;;   drive -- drive amount (0.0 = linear, higher = more saturation)
;;;
;;; Returns:
;;;   SF<Sample,Sample> with soft-clipped output normalised to [-1, 1].
;;;
;;; Example:
;;;   (soft-clip 2.0)
(defn soft-clip [drive : Sample]
  : (SF Sample Sample)
  (arr (fn [x]
    (/ (math/tanh (* drive x)) (math/tanh drive)))))

;;; bit-crush -- reduce bit depth to create lo-fi quantisation noise.
;;;
;;; Parameters:
;;;   bits -- target bit depth (1 to 16)
;;;
;;; Returns:
;;;   SF<Sample,Sample> with quantised output.
;;;
;;; Example:
;;;   (bit-crush 8)  ; 8-bit sound
(defn bit-crush [bits : int]
  : (SF Sample Sample)
  (let [scale (math/pow 2.0 bits)
        max-val (- scale 1.0)]
    (arr (fn [x]
      (let [scaled (* 0.5 (+ x 1.0) max-val)
            quantized (math/round scaled)
            result (/ quantized max-val)]
        (* 2.0 result - 1.0))))))

;; =============================================================================
;; Envelope Followers and Dynamics
;; =============================================================================

;;; envelope-follower -- track signal amplitude with asymmetric attack/release.
;;;
;;; Parameters:
;;;   attack  -- attack smoothing coefficient (0.0 to 1.0)
;;;   release -- release smoothing coefficient (0.0 to 1.0)
;;;
;;; Returns:
;;;   SF<Sample,Sample> producing a smooth envelope signal >= 0.
;;;
;;; Example:
;;;   (envelope-follower 0.01 0.001)
(defn envelope-follower [attack : Sample] [release : Sample]
  : (SF Sample Sample)
  (fn [sig-in]
    (let [env (ref 0.0)]
      (fn [t]
        (let [x (sig-in t)
              abs-x (math/abs x)
              coeff-attack (* attack (- 1.0 @env))
              coeff-release (* release (- abs-x @env))]
          (if (> abs-x @env)
            (do (set! env (+ @env coeff-attack)) @env)
            (do (set! env (+ @env coeff-release)) @env)))))))

;;; compressor -- dynamic range compressor.
;;;
;;; Parameters:
;;;   threshold -- RMS level above which compression kicks in
;;;   ratio     -- compression ratio (e.g., 4.0 for 4:1)
;;;   attack    -- attack time constant
;;;   release   -- release time constant
;;;
;;; Returns:
;;;   SF<Sample,Sample> with gain reduction applied above threshold.
;;;
;;; Example:
;;;   (compressor 0.5 4.0 0.01 0.001)
(defn compressor [threshold : Sample] [ratio : Sample] [attack : Sample] [release : Sample]
  : (SF Sample Sample)
  (let [env-follower (envelope-follower attack release)]
    (fn [sig-in]
      (let [env (env-follower sig-in)
            gain-signal (fn [t] (if (> (env t) threshold) (math/pow (/ (env t) threshold) (- (/ 1.0 ratio))) 1.0))]
        (fn [t] (* (sig-in t) (gain-signal t)))))))

;; =============================================================================
;; Utility Functions
;; =============================================================================

;;; dc-blocker -- remove DC offset using a simple high-pass approach.
;;;
;;; Parameters:
;;;   alpha -- leakiness of the DC estimate (close to 1.0 = slow adaptation)
;;;
;;; Returns:
;;;   SF<Sample,Sample> with DC component removed.
;;;
;;; Example:
;;;   (dc-blocker 0.995)
(defn dc-blocker [alpha : Sample]
  : (SF Sample Sample)
  (fn [sig-in]
    (let [prev (ref 0.0)
          dc (ref 0.0)]
      (fn [t]
        (let [x (sig-in t)
              y (- x @dc)
              new-dc (+ @dc (* alpha y))
              new-prev x]
          (set! dc new-dc)
          (set! prev new-prev)
          y)))))

;;; sample-and-hold -- sample input at a regular rate and hold the value.
;;;
;;; Parameters:
;;;   freq -- sampling frequency in Hz
;;;
;;; Returns:
;;;   SF<Sample,Sample> that holds the last sampled value between updates.
;;;
;;; Example:
;;;   (sample-and-hold 8000.0)
(defn sample-and-hold [freq : Sample]
  : (SF Sample Sample)
  (fn [sig-in]
    (let [held (ref 0.0)
          phase (ref 0.0)]
      (fn [t]
        (let [x (sig-in t)
              new-phase (mod (+ @phase (* freq t)) 1.0)]
          (set! phase new-phase)
          (if (< new-phase @phase)  ;; Phase wrapped around
            (set! held x))
          @held)))))

;; =============================================================================
;; Filter Banks
;; =============================================================================

;;; eq-3band -- three-band parametric equaliser.
;;;
;;; Parameters:
;;;   low-gain  -- gain multiplier for low band
;;;   mid-gain  -- gain multiplier for mid band
;;;   high-gain -- gain multiplier for high band
;;;   low-freq  -- crossover between low and mid bands
;;;   high-freq -- crossover between mid and high bands
;;;
;;; Returns:
;;;   SF<Sample,Sample> with EQ applied.
;;;
;;; Example:
;;;   (eq-3band 1.5 1.0 0.8 0.1 0.6)
(defn eq-3band [low-gain : Sample] [mid-gain : Sample] [high-gain : Sample]
               [low-freq : Sample] [high-freq : Sample]
  : (SF Sample Sample)
  (let [lp (low-pass low-freq)
        hp (high-pass high-freq)
        bp (band-pass (sqrt (* low-freq high-freq)) 1.0)]
    (fn [sig-in]
      (let [low (lp sig-in)
            high (hp sig-in)
            mid (bp sig-in)]
        (fn [t] (+ (* low-gain (low t)) (* mid-gain (mid t)) (* high-gain (high t))))))))

;;; band-pass-simple -- band-pass filter constructed from low-pass and high-pass in series.
;;;
;;; Parameters:
;;;   low-freq  -- lower cutoff frequency (high-pass pole)
;;;   high-freq -- upper cutoff frequency (low-pass pole)
;;;
;;; Returns:
;;;   SF<Sample,Sample> passing frequencies between low-freq and high-freq.
;;;
;;; Example:
;;;   (band-pass-simple 0.05 0.4)
(defn band-pass-simple [low-freq : Sample] [high-freq : Sample]
  : (SF Sample Sample)
  (let [lp (low-pass high-freq)
        hp (high-pass low-freq)]
    (>>> hp lp)))
