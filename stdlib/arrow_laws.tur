;; Arrow Laws Verification
;;
;; This module verifies that Arrow instances satisfy the Arrow laws.
;; The Arrow laws are:
;;
;; 1. Identity: arr id >>> f = f and f >>> arr id = f
;; 2. Composition: arr (f . g) = arr f >>> arr g
;; 3. Associativity: (f >>> g) >>> h = f >>> (g >>> h)
;; 4. Functor laws for first and second
;; 5. Exchange law: first (arr f) >>> arr (map second g) = arr (map first f) >>> arr g
;;
;; Where:
;;   id x = x
;;   (f . g) x = f (g x)
;;   map first f (x, y) = (f x, y)
;;   map second g (x, y) = (x, g y)

(import stdlib/arrow.tur)

;; =============================================================================
;; Equality Checking for Arrows
;; =============================================================================

;;; arrows-equal -- check whether two arrows produce equal outputs on test points.
;;;
;;; Parameters:
;;;   ^arr        -- the arrow type constructor
;;;   f           -- first arrow to compare
;;;   g           -- second arrow to compare
;;;   test-points -- vector of sample inputs
;;;   tolerance   -- maximum allowed difference (float64)
;;;
;;; Returns:
;;;   true if all sampled outputs agree within tolerance, false otherwise.
;;;
;;; Example:
;;;   (arrows-equal f g (vec-of 1.0 2.0) 1e-9)  ; => true or false
;; Check if two function arrows are equal (approximately)
;; We test at multiple points
(defn arrows-equal [^arr : (Arrow arr) a b] [f : (arr a b)] [g : (arr a b)]
                 [test-points : (vec a)] [tolerance : float64]
  : bool
  (let [n (vec-length test-points)]
    (loop [i 0]
      (when (< i n)
        (let [x (vec-get test-points i)
              ;; For SF, we need to apply to a signal
              ;; For functions, we can apply directly
              ;; We'll use a generic approach

              ;; Create a constant signal from x
              sig-x (constant x)

              result-f ((. f run) sig-x)
              result-g ((. g run) sig-x)

              ;; Sample at time 0
              val-f (result-f 0.0)
              val-g (result-g 0.0)

              diff (math/abs (- val-f val-g))]
          (when (> diff tolerance)
            false)
          (recur (+ i 1))))
      true)))

;;; funcs-equal -- check whether two plain functions produce equal outputs on test points.
;;;
;;; Parameters:
;;;   f           -- first function to compare
;;;   g           -- second function to compare
;;;   test-points -- vector of sample inputs
;;;   tolerance   -- maximum allowed difference (float64)
;;;
;;; Returns:
;;;   true if all sampled outputs agree within tolerance, false otherwise.
;;;
;;; Example:
;;;   (funcs-equal inc inc (vec-of 1.0 2.0) 1e-9)  ; => true
;; Simpler version for function arrows
(defn funcs-equal [f : (-> a b)] [g : (-> a b)] [test-points : (vec a)] [tolerance : float64]
  : bool
  (let [n (vec-length test-points)]
    (loop [i 0]
      (when (< i n)
        (let [x (vec-get test-points i)
              val-f (f x)
              val-g (g x)
              diff (math/abs (- val-f val-g))]
          (when (> diff tolerance)
            false)
          (recur (+ i 1))))
      true)))

;; =============================================================================
;; Arrow Law 1: Identity
;; =============================================================================

;;; test-identity-right -- verify the law: arr id >>> f = f.
;;;
;;; Parameters:
;;;   ^arr        -- the arrow type constructor
;;;   f           -- arrow under test
;;;   test-points -- vector of sample inputs
;;;
;;; Returns:
;;;   true if the law holds within tolerance on all test points.
;; Law: arr id >>> f = f
(defn test-identity-right [^arr : (Arrow arr) a b]
                     [f : (arr a b)]
                     [test-points : (vec a)]
  : bool
  (let [id-arr (arr (fn [x] x))
        composed (>>> id-arr f)
        result (arrows-equal arr composed f test-points 1e-9)]
    result))

;;; test-identity-left -- verify the law: f >>> arr id = f.
;;;
;;; Parameters:
;;;   ^arr        -- the arrow type constructor
;;;   f           -- arrow under test
;;;   test-points -- vector of sample inputs
;;;
;;; Returns:
;;;   true if the law holds within tolerance on all test points.
;; Law: f >>> arr id = f
(defn test-identity-left [^arr : (Arrow arr) a b]
                    [f : (arr a b)]
                    [test-points : (vec a)]
  : bool
  (let [id-arr (arr (fn [x] x))
        composed (>>> f id-arr)
        result (arrows-equal arr composed f test-points 1e-9)]
    result))

;;; test-identity -- verify both identity laws for a sample arrow.
;;;
;;; Parameters:
;;;   ^arr        -- the arrow type constructor
;;;   test-points -- vector of sample inputs
;;;
;;; Returns:
;;;   true if both identity laws hold on all test points.
;; Combined identity test
(defn test-identity [^arr : (Arrow arr) a]
                [test-points : (vec a)]
  : bool
  (let [id-arr (arr (fn [x] x))
        f (arr (fn [x] (+ x 1.0)))]
    (and (test-identity-right arr f test-points)
         (test-identity-left arr f test-points))))

;; =============================================================================
;; Arrow Law 2: Composition
;; =============================================================================

;;; test-composition -- verify the law: arr (f . g) = arr f >>> arr g.
;;;
;;; Parameters:
;;;   ^arr        -- the arrow type constructor
;;;   f           -- function b -> c
;;;   g           -- function a -> b
;;;   test-points -- vector of sample inputs of type a
;;;
;;; Returns:
;;;   true if the law holds within tolerance on all test points.
;; Law: arr (f . g) = arr f >>> arr g
;; Where (f . g) x = f (g x)
(defn test-composition [^arr : (Arrow arr) a b c]
                      [f : (-> b c)] [g : (-> a b)]
                      [test-points : (vec a)]
  : bool
  (let [;; Left side: arr (f . g)
        composed-fn (fn [x] (f (g x)))
        left-side (arr composed-fn)

        ;; Right side: arr f >>> arr g
        right-side (>>> (arr f) (arr g))

        result (arrows-equal arr left-side right-side test-points 1e-9)]
    result))

;; =============================================================================
;; Arrow Law 3: Associativity
;; =============================================================================

;;; test-associativity -- verify the law: (f >>> g) >>> h = f >>> (g >>> h).
;;;
;;; Parameters:
;;;   ^arr        -- the arrow type constructor
;;;   f           -- arrow a -> b
;;;   g           -- arrow b -> c
;;;   h           -- arrow c -> d
;;;   test-points -- vector of sample inputs of type a
;;;
;;; Returns:
;;;   true if the law holds within tolerance on all test points.
;; Law: (f >>> g) >>> h = f >>> (g >>> h)
(defn test-associativity [^arr : (Arrow arr) a b c d]
                      [f : (arr a b)] [g : (arr b c)] [h : (arr c d)]
                      [test-points : (vec a)]
  : bool
  (let [left-side (>>> (>>> f g) h)
        right-side (>>> f (>>> g h))
        result (arrows-equal arr left-side right-side test-points 1e-9)]
    result))

;; =============================================================================
;; Arrow Law 4: Functor Laws for first
;; =============================================================================

;;; test-first-functor -- verify: first (arr f >>> arr g) = first (arr f) >>> first (arr g).
;;;
;;; Parameters:
;;;   ^arr        -- the arrow type constructor
;;;   f           -- function a -> b
;;;   g           -- function b -> c
;;;   test-points -- vector of sample Tuple inputs
;;;
;;; Returns:
;;;   true if the law holds within tolerance on all test points.
;; Law: first (arr f >>> arr g) = first (arr f) >>> first (arr g)
(defn test-first-functor [^arr : (Arrow arr) a b c d]
                       [f : (-> a b)] [g : (-> b c)]
                       [test-points : (vec (Tuple a d))]
  : bool
  (let [;; Left side
        fg-composed (>>> (arr f) (arr g))
        left-side (first fg-composed)

        ;; Right side
        right-side (>>> (first (arr f)) (first (arr g)))

        result (arrows-equal arr left-side right-side test-points 1e-9)]
    result))

;;; test-first-identity -- verify: first (arr id) = identity on first component.
;;;
;;; Parameters:
;;;   ^arr        -- the arrow type constructor
;;;   test-points -- vector of sample Tuple inputs
;;;
;;; Returns:
;;;   true if the law holds within tolerance on all test points.
;; Law: first (arr id) = arr (map first id) = identity on first component
(defn test-first-identity [^arr : (Arrow arr) a b]
                     [test-points : (vec (Tuple a b))]
  : bool
  (let [id-fn (fn [x] x)
        id-arr (arr id-fn)
        left-side (first id-arr)

        ;; arr (map first id) = arr (fn [(x, y)] (x, y))
        right-side (arr (fn [[x y]] [x y]))

        result (arrows-equal arr left-side right-side test-points 1e-9)]
    result))

;; =============================================================================
;; Arrow Law 5: Exchange Law
;; =============================================================================

;;; test-exchange -- verify the exchange law for Arrow.
;;;
;;; Law: first (arr f) >>> arr (map second g) = arr (map first f) >>> arr g
;;;
;;; Parameters:
;;;   ^arr        -- the arrow type constructor
;;;   f           -- function a -> b
;;;   g           -- function c -> d
;;;   test-points -- vector of sample Tuple a c inputs
;;;
;;; Returns:
;;;   true if the law holds within tolerance on all test points.
;; Law: first (arr f) >>> arr (map second g) = arr (map first f) >>> arr g
;; where:
;;   map first f (x, y) = (f x, y)
;;   map second g (x, y) = (x, g y)
(defn test-exchange [^arr : (Arrow arr) a b c d]
                   [f : (-> a b)] [g : (-> c d)]
                   [test-points : (vec (Tuple a c))]
  : bool
  (let [;; Left side: first (arr f) >>> arr (map second g)
        left-arr-f (first (arr f))
        map-second-g (fn [[x y]] [x (g y)])
        left-side (>>> left-arr-f (arr map-second-g))

        ;; Right side: arr (map first f) >>> arr g
        map-first-f (fn [[x y]] [(f x) y])
        right-side (>>> (arr map-first-f) (arr g))

        result (arrows-equal arr left-side right-side test-points 1e-9)]
    result))

;; =============================================================================
;; ArrowChoice Laws
;; =============================================================================

;;; test-left-distributes -- placeholder for ArrowChoice distribution property.
;;;
;;; Parameters:
;;;   ^arr        -- the arrow type constructor; must satisfy ArrowChoice
;;;   f           -- arrow a -> b
;;;   g           -- arrow c -> d
;;;   h           -- arrow c -> e
;;;   test-points -- vector of Either a c inputs
;;;
;;; Returns:
;;;   true (placeholder -- full law verification not yet implemented).
;; ArrowChoice Law 1: left and right are compatible with >>>
;; Law: left f >>> g = first f >>> g (for appropriate types)
;;
;; Actually, the ArrowChoice laws are more complex. We'll implement
;; the basic consistency checks.

;; Law: left f >>> (g +++ h) = (f >>> g) +++ (f >>> h)  (not quite right)
;; Better to test specific cases

;; Test that left distributes over +++ in a certain way
(defn test-left-distributes [^arr : (ArrowChoice arr) a b c d e]
                        [f : (arr a b)] [g : (arr c d)] [h : (arr c e)]
                        [test-points : (vec (Either a c))]
  : bool
  (let [;; This law might not hold for all ArrowChoice instances
        ;; We'll just verify basic properties
        true]  ;; Placeholder
    true))

;; =============================================================================
;; ArrowLoop Laws
;; =============================================================================

;;; test-loop-first -- verify: loop (first (arr f)) is equivalent to arr f.
;;;
;;; Parameters:
;;;   ^arr        -- the arrow type constructor; must satisfy ArrowLoop
;;;   f           -- function a -> b
;;;   test-points -- vector of sample inputs of type a
;;;
;;; Returns:
;;;   true if the law holds within tolerance on all test points.
;; ArrowLoop Law 1: loop (first f) = f
;; This states that looping a function on the first component is identity
(defn test-loop-first [^arr : (ArrowLoop arr) a b c]
                   [f : (-> a b)]
                   [test-points : (vec a)]
  : bool
  (let [;; loop (first (arr f)) should be equivalent to arr f
        first-f (first (arr f))
        looped (loop first-f)
        direct (arr f)

        result (arrows-equal arr looped direct test-points 1e-9)]
    result))

;; ArrowLoop Law 2: loop (arr (\ (a, c) -> (b, c))) = arr (\ a -> b)
;; This is the defining property of loop
;;
;; Actually, loop is defined to satisfy:
;;   loop f = f >>> arr fst
;; where f :: arr (a, c) (b, c)
;; and the result :: arr a b
;;
;; But this is getting into complex category theory. For practical purposes,
;; we'll just verify that loop works as expected for specific cases.

;; =============================================================================
;; Specific Tests for Function Arrow
;; =============================================================================

;;; test-function-arrow-identity -- run identity law tests on the function Arrow.
;;;
;;; Returns:
;;;   true if both identity laws pass for the function arrow.
;; Test identity for function arrow
(defn test-function-arrow-identity []
  : bool
  (let [test-points (vec-of 1.0 2.0 3.0 -1.0 0.0)
        result (test-identity (->) test-points)]
    result))

;;; test-function-arrow-composition -- run composition law test on the function Arrow.
;;;
;;; Returns:
;;;   true if the composition law passes for the function arrow.
;; Test composition for function arrow
(defn test-function-arrow-composition []
  : bool
  (let [f (fn [x] (+ x 1.0))
        g (fn [x] (* x 2.0))
        test-points (vec-of 1.0 2.0 3.0)
        result (test-composition (->) f g test-points)]
    result))

;;; test-function-arrow-associativity -- run associativity law test on the function Arrow.
;;;
;;; Returns:
;;;   true if the associativity law passes for the function arrow.
;; Test associativity for function arrow
(defn test-function-arrow-associativity []
  : bool
  (let [f (fn [x] (+ x 1.0))
        g (fn [x] (* x 2.0))
        h (fn [x] (- x 3.0))
        test-points (vec-of 1.0 2.0 3.0)
        result (test-associativity (->) f g h test-points)]
    result))

;; =============================================================================
;; Specific Tests for SF Arrow
;; =============================================================================

;;; test-sf-arrow-identity -- run identity law tests on the SF Arrow.
;;;
;;; Returns:
;;;   true if both identity laws pass for the SF arrow.
;; Test identity for SF arrow
(defn test-sf-arrow-identity []
  : bool
  (let [test-points (vec-of 1.0 2.0 3.0)
        result (test-identity SF test-points)]
    result))

;;; test-sf-arrow-composition -- run composition law test on the SF Arrow.
;;;
;;; Returns:
;;;   true if the composition law passes for the SF arrow.
;; Test composition for SF arrow
(defn test-sf-arrow-composition []
  : bool
  (let [f (fn [x] (+ x 1.0))
        g (fn [x] (* x 2.0))
        test-points (vec-of 1.0 2.0 3.0)
        result (test-composition SF f g test-points)]
    result))

;; =============================================================================
;; Main Test Function
;; =============================================================================

;;; verify-arrow-laws -- run all Arrow law tests and return overall pass/fail.
;;;
;;; Returns:
;;;   true if every individual law test passes, false if any fail.
;;;
;;; Example:
;;;   (verify-arrow-laws)  ; => true
;; Run all arrow law tests
(defn verify-arrow-laws []
  : bool
  (let [results (vec-create 10 true)

        ;; Test function arrow
        test1 (test-function-arrow-identity)
        test2 (test-function-arrow-composition)
        test3 (test-function-arrow-associativity)

        ;; Test SF arrow
        test4 (test-sf-arrow-identity)
        test5 (test-sf-arrow-composition)

        ;; Test first functor law for function arrow
        test6 (test-first-functor (->) (fn [x] (+ x 1.0)) (fn [x] (* x 2.0)) (vec-of [1.0 2.0] [3.0 4.0]))

        ;; Test exchange law for function arrow
        test7 (test-exchange (->) (fn [x] (+ x 1.0)) (fn [x] (* x 2.0)) (vec-of [1.0 2.0] [3.0 4.0]))

        all-pass true]

    (vec-set! results 0 test1)
    (vec-set! results 1 test2)
    (vec-set! results 2 test3)
    (vec-set! results 3 test4)
    (vec-set! results 4 test5)
    (vec-set! results 5 test6)
    (vec-set! results 6 test7)

    (for [i 0 7]
      (when (not (vec-get results i))
        (set! all-pass false)))

    all-pass))

;;; print-arrow-laws-results -- run all Arrow law tests and print results to stdout.
;;;
;;; Returns:
;;;   () (side-effectful -- prints pass/fail lines and an overall summary).
;;;
;;; Example:
;;;   (print-arrow-laws-results)
;; Pretty print test results
(defn print-arrow-laws-results []
  : ()
  (let [results (vec-create 10 "")]

    (vec-set! results 0 (if (test-function-arrow-identity) "PASS" "FAIL"))
    (vec-set! results 1 (if (test-function-arrow-composition) "PASS" "FAIL"))
    (vec-set! results 2 (if (test-function-arrow-associativity) "PASS" "FAIL"))
    (vec-set! results 3 (if (test-sf-arrow-identity) "PASS" "FAIL"))
    (vec-set! results 4 (if (test-sf-arrow-composition) "PASS" "FAIL"))

    (println "Arrow Laws Test Results:")
    (println "========================")
    (println "Function Arrow Identity:        " (vec-get results 0))
    (println "Function Arrow Composition:    " (vec-get results 1))
    (println "Function Arrow Associativity:   " (vec-get results 2))
    (println "SF Arrow Identity:             " (vec-get results 3))
    (println "SF Arrow Composition:         " (vec-get results 4))

    (let [all-pass (verify-arrow-laws)]
      (println "\nOverall: " (if all-pass "ALL TESTS PASSED" "SOME TESTS FAILED")))))

;; =============================================================================
;; Quick Self-Test
;; =============================================================================

;;; quick-arrow-test -- sanity check: compose two function arrows and verify output.
;;;
;;; Returns:
;;;   true if (f >>> g) applied to 5.0 equals 12.0 (within 1e-9).
;;;
;;; Example:
;;;   (quick-arrow-test)  ; => true
;; Simple sanity check that doesn't require complex typeclass machinery
(defn quick-arrow-test []
  : bool
  (let [;; Test function arrow instance
        f (arr (fn [x] (+ x 1.0)))
        g (arr (fn [x] (* x 2.0)))

        ;; Test composition
        composed (>>> f g)

        ;; Test on a value
        test-input 5.0

        ;; For function arrow, (f >>> g) x = g (f x)
        ;; f x = x + 1 = 6
        ;; g 6 = 6 * 2 = 12
        expected 12.0
        actual (composed test-input)]

    (math/abs (- actual expected) < 1e-9)))
