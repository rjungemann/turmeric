;; Pair type for Turmeric
;; A generic pair of values (a, b) - stored as int64_t
;; Phase B1: Clone trait infrastructure

(defstruct Pair [first :int second :int])

;;; pair-new -- allocate a new Pair on the heap.
;;;
;;; Parameters:
;;;   a -- first element (int64_t)
;;;   b -- second element (int64_t)
;;;
;;; Returns:
;;;   Pointer to a newly allocated Pair, as int64_t.
;;;
;;; Example:
;;;   (pair-new 1 2)  ; => <Pair ptr>
;;;
;;; Since: Phase B1
;; Create a new Pair
(defn pair-new [a b] #{Unsafe} :int
  ```c
  struct { int64_t first; int64_t second; } *p = malloc(sizeof(*p));
  p->first = a;
  p->second = b;
  return (int64_t)(intptr_t)p;
  ```)

;;; pair-first -- return the first element of a Pair.
;;;
;;; Parameters:
;;;   p -- pointer to a Pair (as int64_t)
;;;
;;; Returns:
;;;   The first element stored in the Pair.
;;;
;;; Example:
;;;   (pair-first (pair-new 10 20))  ; => 10
;;;
;;; Since: Phase B1
;; Get first element
(defn pair-first [p] #{Unsafe} :int
  ```c
  struct { int64_t first; int64_t second; } *pair = (void*)(intptr_t)p;
  return pair->first;
  ```)

;;; pair-second -- return the second element of a Pair.
;;;
;;; Parameters:
;;;   p -- pointer to a Pair (as int64_t)
;;;
;;; Returns:
;;;   The second element stored in the Pair.
;;;
;;; Example:
;;;   (pair-second (pair-new 10 20))  ; => 20
;;;
;;; Since: Phase B1
;; Get second element
(defn pair-second [p] #{Unsafe} :int
  ```c
  struct { int64_t first; int64_t second; } *pair = (void*)(intptr_t)p;
  return pair->second;
  ```)

;;; pair-free -- free a heap-allocated Pair (shallow free only).
;;;
;;; Parameters:
;;;   p -- pointer to a Pair (as int64_t)
;;;
;;; Example:
;;;   (pair-free my-pair)
;;;
;;; Since: Phase B1
;; Free a Pair (does NOT free the contained values - shallow free)
(defn pair-free [p] #{Unsafe}
  ```c
  free((void*)(intptr_t)p);
  ```)

;;; __bifunctor_pair_bimap -- apply fn-left to first and fn-right to second, returning a new Pair.
;;; SINCE: Phase HKT §6 — Stdlib HKT migration
;; Bifunctor instance for Pair.
;; bimap :: (a -> c) -> (b -> d) -> pair a b -> pair c d
(defn __bifunctor_pair_bimap [container fn-left fn-right] #{Unsafe} :int
  ```c
  struct { int64_t first; int64_t second; } *p =
      (struct { int64_t first; int64_t second; } *)(intptr_t)container;
  if (!p) return 0;
  struct { int64_t first; int64_t second; } *r = malloc(sizeof(*r));
  r->first  = ((int64_t(*)(int64_t))(intptr_t)fn_left)(p->first);
  r->second = ((int64_t(*)(int64_t))(intptr_t)fn_right)(p->second);
  return (int64_t)(intptr_t)r;
  ```)

;;; Show [Pair] -- show a Pair as "(first, second)".
(definstance Show [Pair]
  (show [p] :cstr
    ```c
    int64_t fst = p.first;
    int64_t snd = p.second;
    int n1 = snprintf(NULL, 0, "%lld", (long long)fst);
    int n2 = snprintf(NULL, 0, "%lld", (long long)snd);
    if (n1 < 0) n1 = 0;
    if (n2 < 0) n2 = 0;
    char *buf = (char *)malloc((size_t)(1 + n1 + 2 + n2 + 1 + 1));
    int off = snprintf(buf, (size_t)(n1 + 2), "(%lld", (long long)fst);
    snprintf(buf + off, (size_t)(2 + n2 + 2), ", %lld)", (long long)snd);
    return (const char *)(intptr_t)buf;
    ```))

;;; Bifunctor [Pair] -- bimap applies fn-left to first and fn-right to second.
(definstance Bifunctor [Pair]
  (bimap [container fn-left fn-right] (__bifunctor_pair_bimap container fn-left fn-right)))

;;; pair-eq? -- compare two Pairs element-wise using a comparator function.
;;;
;;; Parameters:
;;;   p1     -- first Pair pointer (as int64_t)
;;;   p2     -- second Pair pointer (as int64_t)
;;;   cmp-fn -- comparator fn [a :int b :int] :bool applied to each field
;;;
;;; Returns:
;;;   true if both elements compare equal under cmp-fn, false otherwise.
;;;
;;; Example:
;;;   (pair-eq? (pair-new 1 2) (pair-new 1 2) (fn [a b] (= a b)))  ; => true
;;;
;;; Since: Phase E1
;; Phase E1: pair-eq? -- compare two Pairs element-wise using a comparator fn.
;; cmp-fn must be a fn [a :int b :int] :bool
(defn pair-eq? [p1 p2 cmp-fn] #{Unsafe} :bool
  ```c
  struct { int64_t first; int64_t second; } *a = (void*)(intptr_t)p1;
  struct { int64_t first; int64_t second; } *b = (void*)(intptr_t)p2;
  if (a == b) return true;
  if (!a || !b) return false;
  bool first_eq  = ((bool(*)(int64_t, int64_t))(intptr_t)cmp_fn)(a->first,  b->first);
  bool second_eq = ((bool(*)(int64_t, int64_t))(intptr_t)cmp_fn)(a->second, b->second);
  return first_eq && second_eq;
  ```)

;;; Eq [Pair] -- eq? compares two Pairs using integer equality on each field.
(definstance Eq [Pair]
  (eq? [x y] (pair-eq? x y (fn [a b] (= a b)))))

;;; Clone [Pair] -- clone deep-copies the Pair struct into a new heap allocation.
;; Phase B1: Clone instance for Pair
;; Requires the Clone typeclass to already be in scope (from stdlib/typeclass.tur).
;; Deep-copies the struct value into a new heap allocation and returns it as int64_t.
;; x has type Pair (struct value) inside the generated C method, so x.first / x.second
;; are valid field accesses.
(definstance Clone [Pair]
  (clone [x] :int
    ```c
    struct { int64_t first; int64_t second; } *dst = malloc(sizeof(Pair));
    dst->first = x.first;
    dst->second = x.second;
    return (int64_t)(intptr_t)dst;
    ```))
