;; Pair type for Turmeric
;; A generic pair of values (a, b) - stored as int64_t
;; Phase B1: Clone trait infrastructure

(defstruct Pair [first :int second :int])

;; Create a new Pair
(defn pair-new [a b] :int
  ```c
  struct { int64_t first; int64_t second; } *p = malloc(sizeof(*p));
  p->first = a;
  p->second = b;
  return (int64_t)(intptr_t)p;
  ```)

;; Get first element
(defn pair-first [p] :int
  ```c
  struct { int64_t first; int64_t second; } *pair = (void*)(intptr_t)p;
  return pair->first;
  ```)

;; Get second element
(defn pair-second [p] :int
  ```c
  struct { int64_t first; int64_t second; } *pair = (void*)(intptr_t)p;
  return pair->second;
  ```)

;; Free a Pair (does NOT free the contained values - shallow free)
(defn pair-free [p]
  ```c
  free((void*)(intptr_t)p);
  ```)

;;; SINCE: Phase HKT §6 — Stdlib HKT migration
;; Bifunctor instance for Pair.
;; bimap :: (a -> c) -> (b -> d) -> pair a b -> pair c d
(defn __bifunctor_pair_bimap [container fn-left fn-right] :int
  ```c
  struct { int64_t first; int64_t second; } *p =
      (struct { int64_t first; int64_t second; } *)(intptr_t)container;
  if (!p) return 0;
  struct { int64_t first; int64_t second; } *r = malloc(sizeof(*r));
  r->first  = ((int64_t(*)(int64_t))(intptr_t)fn_left)(p->first);
  r->second = ((int64_t(*)(int64_t))(intptr_t)fn_right)(p->second);
  return (int64_t)(intptr_t)r;
  ```)

(definstance Bifunctor [Pair]
  (bimap [container fn-left fn-right] (__bifunctor_pair_bimap container fn-left fn-right)))

;; Phase B1: Clone instance for Pair
;; Requires the Clone typeclass to already be in scope (from stdlib/typeclass.tur).
;; Deep-copies the struct value into a new heap allocation and returns it as int64_t.
;; x has type Pair (struct value) inside the generated C method, so x.first / x.second
;; are valid field accesses.
(definstance Clone [Pair]
  (clone [x] :int
    ```c
    struct { int64_t first; int64_t second; } *dst = malloc(sizeof(Pair));
    dst->first = x.first;
    dst->second = x.second;
    return (int64_t)(intptr_t)dst;
    ```))
