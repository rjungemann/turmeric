;; Phase 16: Capability passing (v1 effects)
;; 
;; Capability types are ordinary structs with function pointer fields.
;; They enable zero-cost dependency injection and mocking.

;; ============================================================================
;; FileSystem capability
;; ============================================================================

;; Type definition for FileSystem capability
;; All functions return int for error codes (0 = success, non-zero = error)
(extern-c malloc [^ptr size] :ptr)
(extern-c free [^ptr p] :void)

;; FileSystem capability struct:
;;   read_file: (path: cstr, buf: ptr, buf_len: int, out_len: ptr) -> int
;;   write_file: (path: cstr, data: ptr, data_len: int) -> int
;;   delete: (path: cstr) -> int
;;   list: (path: cstr, entries: ptr, max_entries: int, out_count: ptr) -> int
(defn FileSystem-type []
  ```c
  typedef struct FileSystem FileSystem;
  struct FileSystem {
      int (*read_file)(const char* path, unsigned char* buf, int buf_len, int* out_len);
      int (*write_file)(const char* path, const unsigned char* data, int data_len);
      int (*delete)(const char* path);
      int (*list)(const char* path, char** entries, int max_entries, int* out_count);
  };
  return NULL;
  ```)

;; Constructor for FileSystem
(defn make-FileSystem [read_fn write_fn delete_fn list_fn]
  ```c
  typedef struct FileSystem FileSystem;
  FileSystem* fs = (FileSystem*)malloc(sizeof(FileSystem));
  fs->read_file = (int (*)(const char*, unsigned char*, int, int*))read_fn;
  fs->write_file = (int (*)(const char*, const unsigned char*, int))write_fn;
  fs->delete = (int (*)(const char*))delete_fn;
  fs->list = (int (*)(const char*, char**, int, int*))list_fn;
  return (void*)fs;
  ```)

;; Free a FileSystem capability
(defn FileSystem-free [fs]
  ```c
  free(fs);
  ```)

;; ============================================================================
;; Logger capability
;; ============================================================================

;; Logger capability struct:
;;   debug: (msg: cstr) -> void
;;   info: (msg: cstr) -> void
;;   warn: (msg: cstr) -> void
;;   error: (msg: cstr) -> void
(defn Logger-type []
  ```c
  typedef struct Logger Logger;
  struct Logger {
      void (*debug)(const char* msg);
      void (*info)(const char* msg);
      void (*warn)(const char* msg);
      void (*error)(const char* msg);
  };
  return NULL;
  ```)

(defn make-Logger [debug_fn info_fn warn_fn error_fn]
  ```c
  typedef struct Logger Logger;
  Logger* logger = (Logger*)malloc(sizeof(Logger));
  logger->debug = (void (*)(const char*))debug_fn;
  logger->info = (void (*)(const char*))info_fn;
  logger->warn = (void (*)(const char*))warn_fn;
  logger->error = (void (*)(const char*))error_fn;
  return (void*)logger;
  ```)

(defn Logger-free [log]
  ```c
  free(log);
  ```)

;; ============================================================================
;; Random capability
;; ============================================================================

;; Random capability struct:
;;   next-int: (min: int, max: int) -> int
;;   next-float: () -> int (scaled to 0-10000, divide by 10000.0 for float)
(defn Random-type []
  ```c
  typedef struct Random Random;
  struct Random {
      int (*next_int)(int min, int max);
      int (*next_float)(void);
  };
  return NULL;
  ```)

(defn make-Random [next_int_fn next_float_fn]
  ```c
  typedef struct Random Random;
  Random* rng = (Random*)malloc(sizeof(Random));
  rng->next_int = (int (*)(int, int))next_int_fn;
  rng->next_float = (int (*)(void))next_float_fn;
  return (void*)rng;
  ```)

(defn Random-free [rng]
  ```c
  free(rng);
  ```)

;; ============================================================================
;; Time capability
;; ============================================================================

;; Time capability struct:
;;   now: () -> int (milliseconds since epoch)
;;   sleep: (ms: int) -> void
(defn Time-type []
  ```c
  typedef struct Time Time;
  struct Time {
      int (*now)(void);
      void (*sleep)(int ms);
  };
  return NULL;
  ```)

(defn make-Time [now_fn sleep_fn]
  ```c
  typedef struct Time Time;
  Time* time = (Time*)malloc(sizeof(Time));
  time->now = (int (*)(void))now_fn;
  time->sleep = (void (*)(int))sleep_fn;
  return (void*)time;
  ```)

(defn Time-free [t]
  ```c
  free(t);
  ```)

;; ============================================================================
;; Convenience macros
;; ============================================================================

;; with-capability macro: threads a capability through all calls in body
;; Usage: (with-capability [fs (Real-FileSystem)] (fs-read fs "file.txt"))
(defmacro with-capability [binding cap_expr body]
  `(let [~binding ~cap_expr] ~body))

;; default-capability: returns the default implementation for a capability type
;; For now, this just returns NULL - users should provide their own defaults
(defn default-capability [type_name]
  nil)

;; ============================================================================
;; Helper functions for using capabilities
;; ============================================================================

;; Call read_file on a FileSystem capability
(defn fs-read [fs path buf buf_len]
  ```c
  typedef struct FileSystem FileSystem;
  FileSystem* f = (FileSystem*)fs;
  int out_len;
  return f->read_file(path, (unsigned char*)buf, buf_len, &out_len);
  ```)

;; Call write_file on a FileSystem capability
(defn fs-write [fs path data data_len]
  ```c
  typedef struct FileSystem FileSystem;
  FileSystem* f = (FileSystem*)fs;
  return f->write_file(path, (const unsigned char*)data, data_len);
  ```)

;; Call delete on a FileSystem capability
(defn fs-delete [fs path]
  ```c
  typedef struct FileSystem FileSystem;
  FileSystem* f = (FileSystem*)fs;
  return f->delete(path);
  ```)

;; Call list on a FileSystem capability
(defn fs-list [fs path entries max_entries]
  ```c
  typedef struct FileSystem FileSystem;
  FileSystem* f = (FileSystem*)fs;
  int out_count;
  return f->list(path, (char**)entries, max_entries, &out_count);
  ```)

;; Call debug on a Logger capability
(defn log-debug [log msg]
  ```c
  typedef struct Logger Logger;
  Logger* l = (Logger*)log;
  l->debug(msg);
  ```)

;; Call info on a Logger capability
(defn log-info [log msg]
  ```c
  typedef struct Logger Logger;
  Logger* l = (Logger*)log;
  l->info(msg);
  ```)

;; Call warn on a Logger capability
(defn log-warn [log msg]
  ```c
  typedef struct Logger Logger;
  Logger* l = (Logger*)log;
  l->warn(msg);
  ```)

;; Call error on a Logger capability
(defn log-error [log msg]
  ```c
  typedef struct Logger Logger;
  Logger* l = (Logger*)log;
  l->error(msg);
  ```)

;; Call next-int on a Random capability
(defn rng-next-int [rng min max]
  ```c
  typedef struct Random Random;
  Random* r = (Random*)rng;
  return r->next_int(min, max);
  ```)

;; Call next-float on a Random capability
;; Returns value in range [0, 10000) - caller should divide by 10000.0
(defn rng-next-float [rng]
  ```c
  typedef struct Random Random;
  Random* r = (Random*)rng;
  return r->next_float();
  ```)

;; Call now on a Time capability
(defn time-now [t]
  ```c
  typedef struct Time Time;
  Time* time = (Time*)t;
  return time->now();
  ```)

;; Call sleep on a Time capability
(defn time-sleep [t ms]
  ```c
  typedef struct Time Time;
  Time* time = (Time*)t;
  time->sleep(ms);
  ```)
