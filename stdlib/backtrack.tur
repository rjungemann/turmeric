;;; tur/backtrack -- backtracking monad (list monad) for non-deterministic search.
;;;
;;; Backtrack T = list T. Each "result" is a list of all possible values.
;;;
;;; Since: Phase CA0
;; stdlib/backtrack.tur -- Backtracking monad (list monad)
;;
;; Backtrack T  =  list T  (a singly-linked list of result values)
;;
;; All closures passed to mbind / fresh MUST be fat closures
;; (n_captures > 0).  Use the backtrack-do macro which guarantees this
;; by capturing a local sentinel at every binding step.
;;
;; Cell layout:  struct { int64_t value; int64_t next; }
;;
;; stdlib-hkt-consolidation T3: Backtrack is exposed as a kind-(* -> *) opaque
;; `(Backtrack A)` so it can carry real Functor / Applicative / Monad /
;; Alternative instances. The runtime carrier is unchanged -- a Backtrack handle
;; is still the same `int` Cell-list pointer the raw operations build -- the
;; phantom parameter A only lets us spell the instance heads. With the instances
;; in place, search code uses the generic `do-m` / `for` / `bind` / `alt-or`
;; surface from stdlib/macros.tur in addition to the bespoke `backtrack-do`.
;;; Backtrack -- a kind-(* -> *) handle over the list/non-determinism monad;
;;; carrier is the `int` result-list (Cell) pointer.
;;;
;;; Since: stdlib-hkt-consolidation T3
(defopaque Backtrack [A] :int)
;;; -- Helpers ────────────────────────────────────────────────────────────────
;;; bt-nil -- return the empty backtrack list (null pointer sentinel).
;;;
;;; Returns:
;;;   0 (null pointer representing the empty list).

(defn bt-nil [] : int ```c return 0; ```)
;;; bt-cons -- prepend a value to a backtrack result list.
;;;
;;; Parameters:
;;;   v    -- the value to prepend
;;;   next -- pointer to the existing result list (:int)
;;;
;;; Returns:
;;;   Pointer to the new cell (:int).

(defn bt-cons [v next] : int
  ```c
  struct { int64_t value; int64_t next; } *cell = malloc(sizeof(*cell));
  cell->value = v;
  cell->next = next;
  return (int64_t)(intptr_t)cell;
  ```)
;;; -- Core monad operations ──────────────────────────────────────────────────
;;; mzero -- the empty backtrack computation (no results).
;;;
;;; Returns:
;;;   An empty result list (:int null pointer).
;;;
;;; Example:
;;;   (mzero)  ; => 0
;; mzero — the empty backtrack computation


(defn mzero [] : int ```c return 0; ```)
;;; mreturn -- lift a single value into the backtrack monad.
;;;
;;; Parameters:
;;;   x -- the value to return
;;;
;;; Returns:
;;;   A singleton result list containing x (:int).
;;;
;;; Example:
;;;   (mreturn 42)  ; => list containing 42
;; mreturn x — singleton result

(defn mreturn [x] : int
  ```c
  struct { int64_t value; int64_t next; } *cell = malloc(sizeof(*cell));
  cell->value = x;
  cell->next = 0;
  return (int64_t)(intptr_t)cell;
  ```)
;;; mplus -- concatenate (union) two backtrack result lists.
;;;
;;; Parameters:
;;;   xs -- first result list (:int)
;;;   ys -- second result list (:int)
;;;
;;; Returns:
;;;   A new result list with all elements from xs followed by all from ys (:int).
;;;
;;; Example:
;;;   (mplus (mreturn 1) (mreturn 2))  ; => list [1, 2]
;; mplus xs ys — concat (union) of two result lists

(defn mplus [xs ys] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *xc = (Cell*)(intptr_t)xs;
  if (!xc) return ys;
  Cell *head = NULL, *tail = NULL;
  while (xc) {
      Cell *n = malloc(sizeof(Cell));
      n->value = xc->value; n->next = 0;
      if (tail) tail->next = (int64_t)(intptr_t)n; else head = n;
      tail = n;
      xc = (Cell*)(intptr_t)xc->next;
  }
  if (tail) tail->next = ys;
  return (int64_t)(intptr_t)head;
  ```)
;;; mbind -- concatMap: apply fn to each result and concatenate all outputs.
;;;
;;; fn MUST be a fat closure (struct { int64_t __fn; ... }).
;;; Use the backtrack-do macro which guarantees fat closures via forced capture.
;;;
;;; Parameters:
;;;   ma -- a backtrack result list (:int)
;;;   fn -- fat closure of type (a -> Backtrack b)
;;;
;;; Returns:
;;;   The concatenated results of applying fn to each element of ma (:int).
;;;
;;; Example:
;;;   (mbind (mreturn 3) (fn [x] (mreturn (* x 2))))  ; => list [6]
;; mbind ma f — concatMap: apply f to each element and concat all results.
;;
;; The continuation is `^fat`, and that annotation is load-bearing: the body
;; reads fat[0] as the thunk, so the value MUST be a { thunk, env } box.  The
;; param used to be untyped (the int64 carrier), which held only by
;; convention -- a CAPTURELESS lambda crossed as a thin code pointer and the
;; fat[0] read executed its first instructions as an address (SIGSEGV).  The
;; old comment said "use backtrack-do which guarantees fat closures via
;; forced capture"; `^fat` makes the compiler guarantee it instead, shimming
;; a thin fn at the call site and passing a capturing closure through.

(defn mbind [ma : int ^fat f : (fn [int] int)] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *cell = (Cell*)(intptr_t)ma;
  if (!cell) return 0;
  int64_t *fat = (int64_t*)(intptr_t)f;
  int64_t thunk = fat[0];
  Cell *rev = NULL;
  while (cell) {
      int64_t sub = ((int64_t(*)(void*, int64_t))(intptr_t)thunk)((void*)fat, cell->value);
      Cell *sc = (Cell*)(intptr_t)sub;
      while (sc) {
          Cell *n = malloc(sizeof(Cell));
          n->value = sc->value;
          n->next = (int64_t)(intptr_t)rev;
          rev = n;
          sc = (Cell*)(intptr_t)sc->next;
      }
      cell = (Cell*)(intptr_t)cell->next;
  }
  Cell *result = NULL;
  while (rev) {
      Cell *tmp = (Cell*)(intptr_t)rev->next;
      rev->next = (int64_t)(intptr_t)result;
      result = rev;
      rev = tmp;
  }
  return (int64_t)(intptr_t)result;
  ```)
;;; -- Run operations ─────────────────────────────────────────────────────────
;;; run-backtrack -- return all results from a backtrack computation (identity).
;;;
;;; Parameters:
;;;   xs -- a backtrack result list (:int)
;;;
;;; Returns:
;;;   The same result list (the list monad is already eager) (:int).
;;;
;;; Example:
;;;   (run-backtrack (mreturn 1))  ; => list [1]
;; run-backtrack xs — return all results (identity; list monad is already eager)


(defn run-backtrack [xs] : int xs)
;;; run-backtrack-depth -- return at most n results from a backtrack computation.
;;;
;;; Parameters:
;;;   xs -- a backtrack result list (:int)
;;;   n  -- maximum number of results to return (:int)
;;;
;;; Returns:
;;;   A truncated result list of length at most n (:int).
;;;
;;; Example:
;;;   (run-backtrack-depth my-results 5)  ; => first 5 results
;; run-backtrack-depth xs n — take at most n results

(defn run-backtrack-depth [xs n] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *head = NULL, *tail = NULL, *c = (Cell*)(intptr_t)xs;
  int64_t count = 0;
  while (c && count < n) {
      Cell *nc = malloc(sizeof(Cell));
      nc->value = c->value; nc->next = 0;
      if (tail) tail->next = (int64_t)(intptr_t)nc; else head = nc;
      tail = nc;
      count++;
      c = (Cell*)(intptr_t)c->next;
  }
  return (int64_t)(intptr_t)head;
  ```)
;;; -- Combinators ────────────────────────────────────────────────────────────
;;; choice -- identity combinator; xs is already a list of alternatives.
;;;
;;; Parameters:
;;;   xs -- a backtrack result list (:int)
;;;
;;; Returns:
;;;   xs unchanged (:int).
;; choice xs — identity; xs is already a list of alternatives


(defn choice [xs] : int xs)
;;; guard -- succeed with a dummy value when pred is true, fail otherwise.
;;;
;;; Parameters:
;;;   pred -- boolean condition
;;;
;;; Returns:
;;;   (mreturn 0) if pred is true, (mzero) otherwise (:int).
;;;
;;; Example:
;;;   (guard (> x 0))  ; => mreturn 0 or mzero
;; guard pred — (mreturn 0) when pred is true, else mzero

(defn guard [pred : bool] : int (if pred (mreturn 0) (mzero)))
;;; fresh -- apply a fat closure to a fresh (unbound) logic variable.
;;;
;;; The fresh variable is represented by the sentinel INT64_MIN, which is
;;; outside the practical range of logic values and distinct from 0.
;;;
;;; f MUST be a fat closure.
;;;
;;; Parameters:
;;;   f -- fat closure of type (a -> Backtrack b)
;;;
;;; Returns:
;;;   The result of applying f to the unbound sentinel (:int).

(defn fresh [^fat f : (fn [int] int)] : int
  ```c
  int64_t *fat = (int64_t*)(intptr_t)f;
  int64_t thunk = fat[0];
  int64_t unbound = INT64_MIN; /* sentinel: unbound logic variable, distinct from any valid value */
  return ((int64_t(*)(void*, int64_t))(intptr_t)thunk)((void*)fat, unbound);
  ```)
;;; once -- keep only the first result from a backtrack computation.
;;;
;;; Parameters:
;;;   xs -- a backtrack result list (:int)
;;;
;;; Returns:
;;;   A singleton list containing the first element, or empty if xs is empty (:int).
;;;
;;; Example:
;;;   (once (mplus (mreturn 1) (mreturn 2)))  ; => list [1]
;; once xs — keep only the first result

(defn once [xs] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *c = (Cell*)(intptr_t)xs;
  if (!c) return 0;
  Cell *n = malloc(sizeof(Cell));
  n->value = c->value; n->next = 0;
  return (int64_t)(intptr_t)n;
  ```)
;;; interleave -- fair interleaving of two backtrack result lists.
;;;
;;; Parameters:
;;;   xs -- first result list (:int)
;;;   ys -- second result list (:int)
;;;
;;; Returns:
;;;   A new list that alternates elements from xs and ys (:int).
;;;
;;; Example:
;;;   (interleave (mreturn 1) (mreturn 2))  ; => list [1, 2] (interleaved)
;; interleave xs ys — fair interleaving of two result lists

(defn interleave [xs ys] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *xc = (Cell*)(intptr_t)xs;
  Cell *yc = (Cell*)(intptr_t)ys;
  if (!xc) return ys;
  if (!yc) return xs;
  Cell *head = NULL, *tail = NULL;
  while (xc || yc) {
      if (xc) {
          Cell *n = malloc(sizeof(Cell));
          n->value = xc->value; n->next = 0;
          if (tail) tail->next = (int64_t)(intptr_t)n; else head = n;
          tail = n;
          xc = (Cell*)(intptr_t)xc->next;
      }
      if (yc) {
          Cell *n = malloc(sizeof(Cell));
          n->value = yc->value; n->next = 0;
          if (tail) tail->next = (int64_t)(intptr_t)n; else head = n;
          tail = n;
          yc = (Cell*)(intptr_t)yc->next;
      }
  }
  return (int64_t)(intptr_t)head;
  ```)
;;; -- List utilities ─────────────────────────────────────────────────────────
;;; bt-length -- count the number of results in a backtrack result list.
;;;
;;; Parameters:
;;;   xs -- a backtrack result list (:int)
;;;
;;; Returns:
;;;   The number of elements (:int).
;;;
;;; Example:
;;;   (bt-length (mplus (mreturn 1) (mreturn 2)))  ; => 2


(defn bt-length [xs] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  int64_t n = 0;
  Cell *c = (Cell*)(intptr_t)xs;
  while (c) { n++; c = (Cell*)(intptr_t)c->next; }
  return n;
  ```)
;;; bt-print -- print each value in a backtrack result list to stdout.
;;;
;;; Parameters:
;;;   xs -- a backtrack result list (:int)

(defn bt-print [xs]
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *c = (Cell*)(intptr_t)xs;
  while (c) {
      printf("%lld\n", (long long)c->value);
      c = (Cell*)(intptr_t)c->next;
  }
  ```)
;;; -- backtrack-do macro ─────────────────────────────────────────────────────
;;
;; Syntax (flat binding — variables and monadic values alternate):
;;   (backtrack-do body)
;;     => body
;;   (backtrack-do var ma rest...)
;;     => (let [btctx 0]
;;          (mbind ma (fn [var]
;;            (let [btunused btctx]
;;              (backtrack-do rest...)))))
;;
;; The let/fn wrapping forces every generated lambda to capture btctx
;; from the enclosing scope, ensuring all lambdas are fat closures so
;; mbind's fat-closure protocol works correctly.
;;
;; __bt-do takes ctx and un as symbol-literal positional args so they
;; can be spliced into `[~ctx 0] / `[~un ~ctx] without evaluating them
;; as compile-time variables.
;;
;; Usage:
;;   (backtrack-do x (list 1 2 3) y (list 4 5) (mreturn (+ x y)))
;;   (backtrack-do x xs _ (guard (> x 2)) (mreturn x))
;;; __bt-do -- internal helper macro that expands backtrack-do bindings.


(defmacro __bt-do [ctx un & forms]
  (if (empty? forms)
    (list mzero)
    (if (empty? (rest forms))
      (first forms)
      (let [var        (first forms)
            ma         (second forms)
            rest-forms (rest (rest forms))]
        (list let
          `[~ctx 0]
          (list mbind
            ma
            (list fn
              `[~var]
              (list let `[~un ~ctx] (list __bt-do ~ctx ~un ~@rest-forms)))))))))
;;; backtrack-do -- monadic do-notation for the backtracking monad.
;;;
;;; Syntax: (backtrack-do var1 ma1 var2 ma2 ... body)
;;;
;;; Each (var ma) pair binds var to each element of the backtrack computation ma.
;;; The final form is the body expression, which should return a backtrack value.
;;; All generated lambdas are guaranteed to be fat closures.
;;;
;;; Parameters:
;;;   forms -- alternating variable names and monadic expressions, then a body
;;;
;;; Returns:
;;;   A backtrack computation (result list) (:int).
;;;
;;; Example:
;;;   (backtrack-do x (mplus (mreturn 1) (mreturn 2))
;;;                 y (mplus (mreturn 10) (mreturn 20))
;;;                 (mreturn (+ x y)))  ; => list [11, 21, 12, 22]

(defmacro backtrack-do [& forms] (__bt-do btctx btunused ~@forms))
;;; -- HKT typeclass instances (stdlib-hkt-consolidation T3) ────────────────────
;;
;; Backtrack is a kind-(* -> *) handle (carrier: the int Cell-list pointer), so
;; the standard Functor / Applicative / Monad / Alternative instances are all
;; directly expressible and own their type. Each method delegates to an
;; int-carrier operation above. The continuation parameter of `fmap` / `bind`
;; arrives as a typeclass-method poly closure; now that a `:fn` value is a
;; first-class callable, the worker declares its callback `:fn` and applies it
;; with a plain `(f x)` -- it is captured into the deferred result-mapping
;; lambda and dispatched there (no `^fat`-sink box, no `apply-fat`).
;;; bt-apply-fat -- invoke a fat-closure box with a single argument.
;; Still used by `ap` to dispatch *function elements* pulled from a result list
;; (genuine int-carried fat boxes, not poly `:fn` continuations).

(defn bt-apply-fat [f x] : int
  ```c
  int64_t *fat = (int64_t*)(intptr_t)f;
  int64_t thunk = fat[0];
  return ((int64_t(*)(void*, int64_t))(intptr_t)thunk)((void*)fat, x);
  ```)
;;; fmap-backtrack-raw -- worker: map a `:fn` callback over every result.

(defn fmap-backtrack-raw [xs f : fn] : int (mbind xs (fn [x] (mreturn (f x)))))
;;; ap-backtrack-raw -- int worker: cartesian application of fns to arguments.

(defn ap-backtrack-raw [fs xs] : int
  (let [lxs xs]
    (mbind fs
      (fn [f]
        (let [lxs2 lxs
              lf   f]
          (mbind lxs2 (fn [x] (let [_ lf] (mreturn (bt-apply-fat lf x))))))))))
;;; Functor [Backtrack] -- map a function over every result value.
;;;
;;; Example:
;;;   (fmap (mreturn 21) (fn [x] (* x 2)))  ; => [42]
;;;
;;; Since: stdlib-hkt-consolidation T3

(definstance Functor [Backtrack]
  (fmap [container fn] (fmap-backtrack-raw (:: container :int) fn)))
;;; Applicative [Backtrack] -- pure is a singleton result; ap forms the cartesian
;;; product, applying each function result to each argument result.
;;;
;;; Example:
;;;   (ap (mreturn (fn [x] (+ x 1))) (mreturn 41))  ; => [42]
;;;
;;; Since: stdlib-hkt-consolidation T3

(definstance Applicative [Backtrack]
  (pure [x] (mreturn x))
  (ap [ff fa] (ap-backtrack-raw (:: ff :int) (:: fa :int))))
;;; Monad [Backtrack] -- bind is concatMap: feed every result into the
;;; continuation and union the outputs. This is what `do-m` / `for` lower onto.
;;;
;;; Example:
;;;   (do-m x (mplus (mreturn 1) (mreturn 2)) (mreturn (* x 10)))  ; => [10 20]
;;;
;;; Since: stdlib-hkt-consolidation T3

(definstance Monad [Backtrack]
  (bind [ma k] (mbind (:: ma :int) (fn [x] (k x)))))
;;; Alternative [Backtrack] -- empty is the failing search; alt-or unions the
;;; results of both searches (the backtracking choice).
;;;
;;; Example:
;;;   (alt-or (mreturn 1) (mreturn 2))  ; => [1 2]
;;;
;;; Since: stdlib-hkt-consolidation T3

(definstance Alternative [Backtrack]
  (empty [a] (mzero))
  (alt-or [a b] (mplus (:: a :int) (:: b :int))))
