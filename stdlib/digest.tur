;; stdlib/digest.tur -- SHA-256 and MD5 checksums.
;;
;; Self-contained implementations; no external crypto libraries required.
;; SHA-256 follows FIPS 180-4.  MD5 follows RFC 1321.

;;; digest/sha256 -- compute the SHA-256 digest of a byte buffer.
;;;
;;; Parameters:
;;;   data -- pointer (as :int) to the byte data
;;;   len  -- number of bytes to hash
;;;
;;; Returns:
;;;   A heap-allocated vec (:int) of 32 byte values (each 0-255).
;;;   Free with digest/bytes-free.
;;;
;;; Example:
;;;   (digest/sha256 buf 32)  ; => vec of 32 byte ints
;;;
;;; Since: Phase B2
(defn digest/sha256 [data :int len :int] :int
  ```c
  #include <stdint.h>
  static void sha256_transform(uint32_t st[8], const uint8_t *blk) {
    static const uint32_t K[64] = {
      0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
      0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
      0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
      0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
      0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
      0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
      0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
      0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
    };
    uint32_t w[64];
    for (int i=0;i<16;i++) w[i]=((uint32_t)blk[i*4]<<24)|((uint32_t)blk[i*4+1]<<16)|((uint32_t)blk[i*4+2]<<8)|(uint32_t)blk[i*4+3];
    for (int i=16;i<64;i++) {
      uint32_t s0=((w[i-15]>>7)|(w[i-15]<<25))^((w[i-15]>>18)|(w[i-15]<<14))^(w[i-15]>>3);
      uint32_t s1=((w[i-2]>>17)|(w[i-2]<<15))^((w[i-2]>>19)|(w[i-2]<<13))^(w[i-2]>>10);
      w[i]=w[i-16]+s0+w[i-7]+s1;
    }
    uint32_t a=st[0],b=st[1],c=st[2],d=st[3],e=st[4],f=st[5],g=st[6],h=st[7];
    for (int i=0;i<64;i++) {
      uint32_t S1=((e>>6)|(e<<26))^((e>>11)|(e<<21))^((e>>25)|(e<<7));
      uint32_t ch=(e&f)^(~e&g);
      uint32_t t1=h+S1+ch+K[i]+w[i];
      uint32_t S0=((a>>2)|(a<<30))^((a>>13)|(a<<19))^((a>>22)|(a<<10));
      uint32_t mj=(a&b)^(a&c)^(b&c);
      uint32_t t2=S0+mj;
      h=g;g=f;f=e;e=d+t1;d=c;c=b;b=a;a=t1+t2;
    }
    st[0]+=a;st[1]+=b;st[2]+=c;st[3]+=d;st[4]+=e;st[5]+=f;st[6]+=g;st[7]+=h;
  }
  const uint8_t *in = (const uint8_t*)(intptr_t)data;
  size_t n = (size_t)len;
  uint32_t st[8] = {0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19};
  uint8_t blk[64];
  size_t i;
  for (i=0; i+64<=n; i+=64) sha256_transform(st, in+i);
  size_t rem = n-i;
  memcpy(blk, in+i, rem);
  blk[rem++] = 0x80;
  if (rem > 56) { memset(blk+rem, 0, 64-rem); sha256_transform(st, blk); memset(blk, 0, 56); }
  else memset(blk+rem, 0, 56-rem);
  uint64_t bits = (uint64_t)n*8;
  for (int j=0;j<8;j++) blk[56+j]=(uint8_t)(bits>>(56-j*8));
  sha256_transform(st, blk);
  uint8_t digest[32];
  for (int j=0;j<8;j++) { digest[j*4]=(st[j]>>24)&0xff; digest[j*4+1]=(st[j]>>16)&0xff; digest[j*4+2]=(st[j]>>8)&0xff; digest[j*4+3]=st[j]&0xff; }
  struct { int64_t *data; size_t len; size_t cap; } *v = malloc(sizeof(*v));
  v->data = malloc(32 * sizeof(int64_t));
  v->len = 32; v->cap = 32;
  for (int j=0;j<32;j++) v->data[j] = (int64_t)digest[j];
  return (int64_t)(intptr_t)v;
  ```)

;;; digest/sha256-hex -- compute the SHA-256 digest as a lowercase hex string.
;;;
;;; Parameters:
;;;   data -- pointer (as :int) to the byte data
;;;   len  -- number of bytes to hash
;;;
;;; Returns:
;;;   A heap-allocated 65-byte NUL-terminated cstr (64 hex chars).
;;;   The caller must free.
;;;
;;; Example:
;;;   (digest/sha256-hex buf 4)  ; => "9f86d081..."
;;;
;;; Since: Phase B2
(defn digest/sha256-hex [data :int len :int] :cstr
  ```c
  #include <stdint.h>
  static void sha256_transform_h(uint32_t st[8], const uint8_t *blk) {
    static const uint32_t K[64] = {
      0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
      0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
      0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
      0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
      0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
      0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
      0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
      0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
    };
    uint32_t w[64];
    for (int i=0;i<16;i++) w[i]=((uint32_t)blk[i*4]<<24)|((uint32_t)blk[i*4+1]<<16)|((uint32_t)blk[i*4+2]<<8)|(uint32_t)blk[i*4+3];
    for (int i=16;i<64;i++) {
      uint32_t s0=((w[i-15]>>7)|(w[i-15]<<25))^((w[i-15]>>18)|(w[i-15]<<14))^(w[i-15]>>3);
      uint32_t s1=((w[i-2]>>17)|(w[i-2]<<15))^((w[i-2]>>19)|(w[i-2]<<13))^(w[i-2]>>10);
      w[i]=w[i-16]+s0+w[i-7]+s1;
    }
    uint32_t a=st[0],b=st[1],c=st[2],d=st[3],e=st[4],f=st[5],g=st[6],h=st[7];
    for (int i=0;i<64;i++) {
      uint32_t S1=((e>>6)|(e<<26))^((e>>11)|(e<<21))^((e>>25)|(e<<7));
      uint32_t ch=(e&f)^(~e&g);
      uint32_t t1=h+S1+ch+K[i]+w[i];
      uint32_t S0=((a>>2)|(a<<30))^((a>>13)|(a<<19))^((a>>22)|(a<<10));
      uint32_t mj=(a&b)^(a&c)^(b&c);
      uint32_t t2=S0+mj;
      h=g;g=f;f=e;e=d+t1;d=c;c=b;b=a;a=t1+t2;
    }
    st[0]+=a;st[1]+=b;st[2]+=c;st[3]+=d;st[4]+=e;st[5]+=f;st[6]+=g;st[7]+=h;
  }
  const uint8_t *in = (const uint8_t*)(intptr_t)data;
  size_t n = (size_t)len;
  uint32_t st[8] = {0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19};
  uint8_t blk[64];
  size_t i;
  for (i=0; i+64<=n; i+=64) sha256_transform_h(st, in+i);
  size_t rem = n-i;
  memcpy(blk, in+i, rem);
  blk[rem++] = 0x80;
  if (rem > 56) { memset(blk+rem, 0, 64-rem); sha256_transform_h(st, blk); memset(blk, 0, 56); }
  else memset(blk+rem, 0, 56-rem);
  uint64_t bits = (uint64_t)n*8;
  for (int j=0;j<8;j++) blk[56+j]=(uint8_t)(bits>>(56-j*8));
  sha256_transform_h(st, blk);
  uint8_t digest[32];
  for (int j=0;j<8;j++) { digest[j*4]=(st[j]>>24)&0xff; digest[j*4+1]=(st[j]>>16)&0xff; digest[j*4+2]=(st[j]>>8)&0xff; digest[j*4+3]=st[j]&0xff; }
  static const char hex[] = "0123456789abcdef";
  char *out = malloc(65);
  for (int j=0;j<32;j++) { out[j*2]=hex[digest[j]>>4]; out[j*2+1]=hex[digest[j]&0xf]; }
  out[64]='\0';
  return out;
  ```)

;;; digest/md5 -- compute the MD5 digest of a byte buffer.
;;;
;;; Parameters:
;;;   data -- pointer (as :int) to the byte data
;;;   len  -- number of bytes to hash
;;;
;;; Returns:
;;;   A heap-allocated vec (:int) of 16 byte values (each 0-255).
;;;   Free with digest/bytes-free.
;;;
;;; Example:
;;;   (digest/md5 buf 16)  ; => vec of 16 byte ints
;;;
;;; Since: Phase B2
(defn digest/md5 [data :int len :int] :int
  ```c
  #include <stdint.h>
  #define MD5_ROTL(x,n) (((x)<<(n))|((x)>>(32-(n))))
  static void md5_transform(uint32_t st[4], const uint8_t *blk) {
    static const uint32_t T[64] = {
      0xd76aa478,0xe8c7b756,0x242070db,0xc1bdceee,0xf57c0faf,0x4787c62a,0xa8304613,0xfd469501,
      0x698098d8,0x8b44f7af,0xffff5bb1,0x895cd7be,0x6b901122,0xfd987193,0xa679438e,0x49b40821,
      0xf61e2562,0xc040b340,0x265e5a51,0xe9b6c7aa,0xd62f105d,0x02441453,0xd8a1e681,0xe7d3fbc8,
      0x21e1cde6,0xc33707d6,0xf4d50d87,0x455a14ed,0xa9e3e905,0xfcefa3f8,0x676f02d9,0x8d2a4c8a,
      0xfffa3942,0x8771f681,0x6d9d6122,0xfde5380c,0xa4beea44,0x4bdecfa9,0xf6bb4b60,0xbebfbc70,
      0x289b7ec6,0xeaa127fa,0xd4ef3085,0x04881d05,0xd9d4d039,0xe6db99e5,0x1fa27cf8,0xc4ac5665,
      0xf4292244,0x432aff97,0xab9423a7,0xfc93a039,0x655b59c3,0x8f0ccc92,0xffeff47d,0x85845dd1,
      0x6fa87e4f,0xfe2ce6e0,0xa3014314,0x4e0811a1,0xf7537e82,0xbd3af235,0x2ad7d2bb,0xeb86d391
    };
    static const int S[64] = {7,12,17,22,7,12,17,22,7,12,17,22,7,12,17,22,
                               5, 9,14,20,5, 9,14,20,5, 9,14,20,5, 9,14,20,
                               4,11,16,23,4,11,16,23,4,11,16,23,4,11,16,23,
                               6,10,15,21,6,10,15,21,6,10,15,21,6,10,15,21};
    uint32_t m[16];
    for (int i=0;i<16;i++) m[i]=((uint32_t)blk[i*4])|((uint32_t)blk[i*4+1]<<8)|((uint32_t)blk[i*4+2]<<16)|((uint32_t)blk[i*4+3]<<24);
    uint32_t a=st[0],b=st[1],c=st[2],d=st[3];
    for (int i=0;i<64;i++) {
      uint32_t F2,g;
      if (i<16)      { F2=(b&c)|(~b&d); g=(uint32_t)i; }
      else if (i<32) { F2=(d&b)|(~d&c); g=(5*(uint32_t)i+1)%16; }
      else if (i<48) { F2=b^c^d;        g=(3*(uint32_t)i+5)%16; }
      else           { F2=c^(b|~d);     g=(7*(uint32_t)i)%16; }
      uint32_t tmp=d; d=c; c=b;
      b=b+MD5_ROTL(a+F2+m[g]+T[i],S[i]);
      a=tmp;
    }
    st[0]+=a;st[1]+=b;st[2]+=c;st[3]+=d;
  }
  #undef MD5_ROTL
  const uint8_t *in = (const uint8_t*)(intptr_t)data;
  size_t n = (size_t)len;
  uint32_t st[4] = {0x67452301,0xefcdab89,0x98badcfe,0x10325476};
  uint8_t blk[64];
  size_t i;
  for (i=0; i+64<=n; i+=64) md5_transform(st, in+i);
  size_t rem = n-i;
  memcpy(blk, in+i, rem);
  blk[rem++] = 0x80;
  if (rem > 56) { memset(blk+rem, 0, 64-rem); md5_transform(st, blk); memset(blk, 0, 56); }
  else memset(blk+rem, 0, 56-rem);
  uint64_t bits = (uint64_t)n*8;
  for (int j=0;j<8;j++) blk[56+j]=(uint8_t)(bits>>(j*8));
  md5_transform(st, blk);
  uint8_t digest[16];
  for (int j=0;j<4;j++) { digest[j*4]=(uint8_t)(st[j]&0xff); digest[j*4+1]=(uint8_t)((st[j]>>8)&0xff); digest[j*4+2]=(uint8_t)((st[j]>>16)&0xff); digest[j*4+3]=(uint8_t)((st[j]>>24)&0xff); }
  struct { int64_t *data; size_t len; size_t cap; } *v = malloc(sizeof(*v));
  v->data = malloc(16 * sizeof(int64_t));
  v->len = 16; v->cap = 16;
  for (int j=0;j<16;j++) v->data[j] = (int64_t)digest[j];
  return (int64_t)(intptr_t)v;
  ```)

;;; digest/md5-hex -- compute the MD5 digest as a lowercase hex string.
;;;
;;; Parameters:
;;;   data -- pointer (as :int) to the byte data
;;;   len  -- number of bytes to hash
;;;
;;; Returns:
;;;   A heap-allocated 33-byte NUL-terminated cstr (32 hex chars).
;;;   The caller must free.
;;;
;;; Example:
;;;   (digest/md5-hex buf 4)  ; => "93b885ad..."
;;;
;;; Since: Phase B2
(defn digest/md5-hex [data :int len :int] :cstr
  ```c
  #include <stdint.h>
  #define MD5_ROTL2(x,n) (((x)<<(n))|((x)>>(32-(n))))
  static void md5_transform_h(uint32_t st[4], const uint8_t *blk) {
    static const uint32_t T[64] = {
      0xd76aa478,0xe8c7b756,0x242070db,0xc1bdceee,0xf57c0faf,0x4787c62a,0xa8304613,0xfd469501,
      0x698098d8,0x8b44f7af,0xffff5bb1,0x895cd7be,0x6b901122,0xfd987193,0xa679438e,0x49b40821,
      0xf61e2562,0xc040b340,0x265e5a51,0xe9b6c7aa,0xd62f105d,0x02441453,0xd8a1e681,0xe7d3fbc8,
      0x21e1cde6,0xc33707d6,0xf4d50d87,0x455a14ed,0xa9e3e905,0xfcefa3f8,0x676f02d9,0x8d2a4c8a,
      0xfffa3942,0x8771f681,0x6d9d6122,0xfde5380c,0xa4beea44,0x4bdecfa9,0xf6bb4b60,0xbebfbc70,
      0x289b7ec6,0xeaa127fa,0xd4ef3085,0x04881d05,0xd9d4d039,0xe6db99e5,0x1fa27cf8,0xc4ac5665,
      0xf4292244,0x432aff97,0xab9423a7,0xfc93a039,0x655b59c3,0x8f0ccc92,0xffeff47d,0x85845dd1,
      0x6fa87e4f,0xfe2ce6e0,0xa3014314,0x4e0811a1,0xf7537e82,0xbd3af235,0x2ad7d2bb,0xeb86d391
    };
    static const int S[64] = {7,12,17,22,7,12,17,22,7,12,17,22,7,12,17,22,
                               5, 9,14,20,5, 9,14,20,5, 9,14,20,5, 9,14,20,
                               4,11,16,23,4,11,16,23,4,11,16,23,4,11,16,23,
                               6,10,15,21,6,10,15,21,6,10,15,21,6,10,15,21};
    uint32_t m[16];
    for (int i=0;i<16;i++) m[i]=((uint32_t)blk[i*4])|((uint32_t)blk[i*4+1]<<8)|((uint32_t)blk[i*4+2]<<16)|((uint32_t)blk[i*4+3]<<24);
    uint32_t a=st[0],b=st[1],c=st[2],d=st[3];
    for (int i=0;i<64;i++) {
      uint32_t F2,g;
      if (i<16)      { F2=(b&c)|(~b&d); g=(uint32_t)i; }
      else if (i<32) { F2=(d&b)|(~d&c); g=(5*(uint32_t)i+1)%16; }
      else if (i<48) { F2=b^c^d;        g=(3*(uint32_t)i+5)%16; }
      else           { F2=c^(b|~d);     g=(7*(uint32_t)i)%16; }
      uint32_t tmp=d; d=c; c=b;
      b=b+MD5_ROTL2(a+F2+m[g]+T[i],S[i]);
      a=tmp;
    }
    st[0]+=a;st[1]+=b;st[2]+=c;st[3]+=d;
  }
  #undef MD5_ROTL2
  const uint8_t *in = (const uint8_t*)(intptr_t)data;
  size_t n = (size_t)len;
  uint32_t st[4] = {0x67452301,0xefcdab89,0x98badcfe,0x10325476};
  uint8_t blk[64];
  size_t i;
  for (i=0; i+64<=n; i+=64) md5_transform_h(st, in+i);
  size_t rem = n-i;
  memcpy(blk, in+i, rem);
  blk[rem++] = 0x80;
  if (rem > 56) { memset(blk+rem, 0, 64-rem); md5_transform_h(st, blk); memset(blk, 0, 56); }
  else memset(blk+rem, 0, 56-rem);
  uint64_t bits = (uint64_t)n*8;
  for (int j=0;j<8;j++) blk[56+j]=(uint8_t)(bits>>(j*8));
  md5_transform_h(st, blk);
  uint8_t digest[16];
  for (int j=0;j<4;j++) { digest[j*4]=(uint8_t)(st[j]&0xff); digest[j*4+1]=(uint8_t)((st[j]>>8)&0xff); digest[j*4+2]=(uint8_t)((st[j]>>16)&0xff); digest[j*4+3]=(uint8_t)((st[j]>>24)&0xff); }
  static const char hex[] = "0123456789abcdef";
  char *out = malloc(33);
  for (int j=0;j<16;j++) { out[j*2]=hex[digest[j]>>4]; out[j*2+1]=hex[digest[j]&0xf]; }
  out[32]='\0';
  return out;
  ```)

;;; digest/bytes-free -- free a digest byte vec returned by digest/sha256 or digest/md5.
;;;
;;; Parameters:
;;;   v -- vec pointer returned by a digest function
;;;
;;; Example:
;;;   (digest/bytes-free my-digest)
;;;
;;; Since: Phase B2
(defn digest/bytes-free [v :int] :void
  ```c
  if (!v) return;
  struct { int64_t *data; size_t len; size_t cap; } *vec = (void*)(intptr_t)v;
  free(vec->data);
  free(vec);
  ```)
