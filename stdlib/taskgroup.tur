;; stdlib/taskgroup.tur — Structured concurrency with TaskGroup (Phase T22)
;;
;; TaskGroup provides structured concurrency: a group of tasks that are
;; spawned together and can be cancelled together. When a task fails or
;; the group is explicitly cancelled, all running tasks receive a cancellation
;; signal and are expected to cooperate by checking `fiber-cancelled?` and
;; exiting promptly.
;;
;; API:
;;   task-group-new       []                              → ptr<void>
;;   task-group-spawn     [group :ptr<void> f :ptr<void>] → ptr<void>  (fiber handle)
;;   task-group-join      [group :ptr<void> handle :ptr<void>] → nil  (Phase TG-002)
;;   task-group-cancel    [group :ptr<void>]            → nil
;;   task-group-cancelled? []                            → bool  (checks current fiber)
;;   task-group-cancelled? [group :ptr<void>]           → bool  (checks specific group)
;;   task-handle-done?    [handle :ptr<void>]            → bool  (Phase TG-002)
;;   task-group-done?      [group :ptr<void>]           → bool
;;   task-group-wait      [group :ptr<void>]           → nil  (blocks until done)
;;   task-group-free      [group :ptr<void>]           → nil
;;
;; TaskGroupBlock layout:
;;   { pthread_mutex_t lock;
;;     pthread_cond_t done_cond;
;;     int64_t task_count;
;;     int64_t completed_count;
;;     bool cancelled;
;;     bool done;
;;     int64_t cancel_reason; /* Phase TG-004-2: 0=manual, 1=panic, 2=timeout, 3=error */ }
;;
;; Each spawned task increments task_count. When a task completes (normally
;; or via cancellation), it must call (task-group-task-done group).
;; When all tasks complete, the group is marked done and waiters are notified.
;;
;; Cancellation is cooperative: tasks must periodically check `task-group-cancelled?`
;; or `fiber-cancelled?` and exit if cancelled.

;; ---- TaskGroup lifecycle ----

;; Create a new TaskGroup
(defn task-group-new [] :ptr<void>
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)malloc(sizeof(TaskGroupBlock));
  if (!g) { fprintf(stderr, "task-group-new: oom\n"); abort(); }
  pthread_mutex_init(&g->lock, NULL);
  pthread_cond_init(&g->done_cond, NULL);
  g->task_count = 0;
  g->completed_count = 0;
  g->cancelled = false;
  g->done = false;
  return (void *)g;
  ```)

;; Check if the current fiber has been cancelled
;; This checks a thread-local flag set by the task group
(defn fiber-cancelled? [] :bool
  ```c
  return tur_fiber_cancelled();
  ```)

;; Set the current fiber's cancelled flag (used internally by task-group-cancel)
;; This is called automatically by task-group-cancel
(defn __fiber_set_cancelled [cancelled :int] :nil
  ```c
  tur_fiber_set_cancelled((bool)cancelled);
  ```)

;; Check if a specific task group has been cancelled
(defn task-group-cancelled? [group :ptr<void>] :bool
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  bool c = g->cancelled;
  pthread_mutex_unlock(&g->lock);
  return c;
  ```)

;; Check if all tasks in the group have completed
(defn task-group-done? [group :ptr<void>] :bool
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  bool d = g->done;
  pthread_mutex_unlock(&g->lock);
  return d;
  ```)

;; Signal that a task has completed. Must be called by each spawned task.
(defn task-group-task-done [group :ptr<void>] :nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  if (!g) return;
  pthread_mutex_lock(&g->lock);
  g->completed_count++;
  if (g->completed_count >= g->task_count && g->task_count > 0) {
      g->done = true;
      pthread_cond_broadcast(&g->done_cond);
  }
  pthread_mutex_unlock(&g->lock);
  ```)

;; Wait for all tasks in the group to complete
(defn task-group-wait [group :ptr<void>] :nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  while (!g->done)
      pthread_cond_wait(&g->done_cond, &g->lock);
  pthread_mutex_unlock(&g->lock);
  ```)

;; Cancel all tasks in the group (cooperative)
;; Sets the cancelled flag and marks the group as done
;; Tasks must check `fiber-cancelled?` or `task-group-cancelled?` and exit
(defn task-group-cancel [group :ptr<void>] :nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
      int64_t cancel_reason;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  g->cancelled = true;
  g->done = true;
  g->cancel_reason = 0;  /* Phase TG-004-2: default to manual cancel (0) */
  pthread_cond_broadcast(&g->done_cond);
  pthread_mutex_unlock(&g->lock);
  /* Also set the thread-local cancelled flag for fibers in this group */
  __fiber_set_cancelled(1);
  ```)

;; Cancel all tasks in the group with a specific reason
;; Phase TG-004-2: Extended cancel with reason parameter
;;   reason: 0=manual, 1=panic, 2=timeout, 3=error
(defn task-group-cancel-with-reason [group :ptr<void> reason :int] :nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
      int64_t cancel_reason;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  g->cancelled = true;
  g->done = true;
  g->cancel_reason = reason;
  pthread_cond_broadcast(&g->done_cond);
  pthread_mutex_unlock(&g->lock);
  __fiber_set_cancelled(1);
  ```)

;; Convenience: cancel with panic reason (1)
(defn task-group-cancel-panic [group :ptr<void>] :nil
  (task-group-cancel-with-reason group 1))

;; Convenience: cancel with timeout reason (2)
(defn task-group-cancel-timeout [group :ptr<void>] :nil
  (task-group-cancel-with-reason group 2))

;; Convenience: cancel with error reason (3)
(defn task-group-cancel-error [group :ptr<void>] :nil
  (task-group-cancel-with-reason group 3))

;; Get the reason why the task group was cancelled
;; Phase TG-004-2: Returns the cancel reason code
;;   0 = manual cancel (via task-group-cancel)
;;   1 = panic in a child task
;;   2 = timeout
;;   3 = error/exception in a child task
(defn task-group-cancel-reason [group :ptr<void>] :int
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
      int64_t cancel_reason;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  int64_t reason = g->cancel_reason;
  pthread_mutex_unlock(&g->lock);
  return reason;
  ```)

;; Spawn a fiber in the task group
;; Returns a fiber handle that can be used with task-group-join (Phase TG-002)
(defn task-group-spawn [group :ptr<void> f :ptr<void>] :ptr<void>
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  typedef void (*FiberFn)(void);
  
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  g->task_count++;
  pthread_mutex_unlock(&g->lock);
  
  /* Spawn the fiber via the scheduler */
  void *fiber = tur_fiber_block_new((FiberFn)f, 0);
  if (!fiber) { fprintf(stderr, "task-group-spawn: fiber oom\n"); abort(); }
  
  /* Set the fiber's task_group so it can notify on completion (Phase TG-002) */
  typedef struct FiberBlock FiberBlock;
  ((FiberBlock *)fiber)->task_group = (void *)g;
  ((FiberBlock *)fiber)->cancelled = g->cancelled;
  
  return fiber;
  ```)

;; Wait for a specific task (fiber handle) to complete
;; Phase TG-002: task-group-join [group handle] — await specific task completion
(defn task-group-join [group :ptr<void> handle :ptr<void>] :nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  typedef struct FiberBlock FiberBlock;
  
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  FiberBlock *f = (FiberBlock *)handle;
  
  /* If fiber already done, return immediately */
  if (!f) return;
  if (f->done) return;
  
  /* Check that fiber belongs to this group */
  if (f->task_group != (void *)g) {
      fprintf(stderr, "task-group-join: fiber not from this group\n");
      return;
  }
  
  /* Wait for the fiber to complete using the group's condition variable */
  /* This is a v1 simplification - in a full implementation each fiber would
   * have its own condition variable. We use the group lock and wake up
   * whenever any task completes, then re-check our specific fiber. */
  pthread_mutex_lock(&g->lock);
  while (!f->done && !g->cancelled) {
      pthread_cond_wait(&g->done_cond, &g->lock);
  }
  pthread_mutex_unlock(&g->lock);
  ```)

;; Check if a specific task (fiber handle) has completed
;; Phase TG-002: Helper for non-blocking check
(defn task-handle-done? [handle :ptr<void>] :bool
  ```c
  typedef struct FiberBlock FiberBlock;
  FiberBlock *f = (FiberBlock *)handle;
  return f ? f->done : true;  /* NULL handle is considered "done" */
  ```)

;; Free the task group
(defn task-group-free [group :ptr<void>] :nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_destroy(&g->lock);
  pthread_cond_destroy(&g->done_cond);
  free(g);
  ```)

;; ---- TaskGroup::with macro ----

;; TaskGroup::with [group & body] - runs body, waits for all spawned tasks
(defmacro task-group-with [group & body]
  (list (do
          body
          (task-group-wait group))))

;; ---- TaskGroup::with-timeout macro (Phase T22) ----

;; TaskGroup::with-timeout [group ms & body] - runs body, auto-cancels after ms milliseconds
;; Uses a background thread to sleep and then cancel the group
(defmacro task-group-with-timeout [group ms & body]
  (list
    (let [timeout_thread (spawn-timeout-thread group ms)]
      (do
        body
        (task-group-wait group)
        (join-timeout-thread timeout_thread)))))

;; Helper: spawn a timeout thread that cancels the group
(defn spawn-timeout-thread [group :ptr<void> ms :int] :ptr<void>
  ```c
  pthread_t *t = (pthread_t *)malloc(sizeof(pthread_t));
  if (!t) { fprintf(stderr, "spawn-timeout: oom\n"); abort(); }
  
  typedef struct { void *tg; int ms; } TimeoutArg;
  TimeoutArg *arg = (TimeoutArg *)malloc(sizeof(TimeoutArg));
  if (!arg) { free(t); fprintf(stderr, "spawn-timeout: arg oom\n"); abort(); }
  arg->tg = group;
  arg->ms = (int)ms;
  
  void timeout_fn(void *raw) {
      TimeoutArg *a = (TimeoutArg *)raw;
      typedef struct { long tv_sec; long tv_nsec; } timespec;
      timespec ts = { .tv_sec = a->ms / 1000, .tv_nsec = (a->ms % 1000) * 1000000L };
      nanosleep(&ts, NULL);
      
      typedef struct {
          pthread_mutex_t lock;
          pthread_cond_t done_cond;
          int64_t task_count;
          int64_t completed_count;
          bool cancelled;
          bool done;
      } TaskGroupBlock;
      TaskGroupBlock *g = (TaskGroupBlock *)a->tg;
      pthread_mutex_lock(&g->lock);
      g->cancelled = true;
      g->done = true;
      pthread_cond_broadcast(&g->done_cond);
      pthread_mutex_unlock(&g->lock);
      free(a);
  }
  
  pthread_create(t, NULL, (void *(*)(void *))timeout_fn, arg);
  pthread_detach(*t);
  return (void *)t;
  ```)

;; Helper: join the timeout thread (detached, just free handle)
(defn join-timeout-thread [t :ptr<void>] :nil
  ```c
  pthread_t *tid = (pthread_t *)t;
  free(tid);
  ```)

;; ---- Automatic cancellation propagation (Phase TG-004-1) ----
;; 
;; When a child task panics or throws an exception, the parent task group
;; is automatically cancelled with reason=1 (panic). This is implemented in
;; the runtime's tur_fiber_shim function which wraps fiber execution with
;; a setjmp/longjmp handler that catches panics and cancels the group.
;;
;; No additional API needed - automatic cancellation propagation is built
;; into fibers that have a task_group set.

;; ---- TaskGroup::with-cancellation macro (Phase TG-003) ----
;; 
;; task-group-with-cancellation [group & body] - runs body in a context where
;; cancellation can be checked. The body should periodically call
;; (task-group-cancelled? group) or (fiber-cancelled?) to check if it should
;; exit early.
;;
;; This is essentially the same as task-group-with for v1, since cooperative
;; cancellation requires the body to explicitly check. In future versions,
;; this could provide automatic cancellation signal delivery.
;;
;; For now, this is an alias for task-group-with, with documentation about
;; how to handle cancellation cooperatively.
(defmacro task-group-with-cancellation [group & body]
  (task-group-with group body))
