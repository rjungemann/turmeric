;;; tur/condvar -- POSIX condition variable (pthread_cond_t) wrapped as ptr<void>.
;;;
;;; Must be used together with a mutex from tur/mutex.
;;;
;;; Since: Phase T19-C
;; stdlib/condvar.tur -- POSIX condition variable (Phase T19-C)
;;
;; Wraps pthread_cond_t as a :ptr<void>.  Must be used together with a mutex
;; from stdlib/mutex.tur.
;;
;; API:
;;   condvar-new        []                              -- CondVar
;;   condvar-wait       [c :CondVar m :Mutex]          -- nil
;;   condvar-signal     [c :CondVar]                   -- nil
;;   condvar-broadcast  [c :CondVar]                   -- nil
;;   condvar-free       [c :CondVar]                   -- nil
;; ---- Opaque handle newtype (stdlib-opaque-handle-types-plan, Tier 2) ----
;; CondVar wraps the underlying :ptr<void> with a nominally distinct type. This
;; closes the long-standing condvar-wait hazard: with both args bare :ptr<void>,
;; (condvar-wait m c) -- mutex and condvar swapped -- type-checked and deadlocked
;; at runtime. condvar-wait now takes a CondVar and a Mutex (imported from
;; tur/mutex below), so the swap is a compile-time error. Both lower to
;; :ptr<void> in the C ABI, so the inline-C bodies are unchanged.
(load "stdlib/mutex.tur")

(defopaque CondVar :ptr<void>)
;;; condvar-new -- allocate and initialise a new POSIX condition variable.
;;;
;;; Returns:
;;;   A CondVar handle to a heap-allocated pthread_cond_t.
;;;
;;; Example:
;;;   (let [c (condvar-new)] ...)  ; => CondVar
;;;
;;; Since: Phase T19-C

(defn condvar-new [] : CondVar
  ```c
  pthread_cond_t *c = (pthread_cond_t *)malloc(sizeof(pthread_cond_t));
  if (!c) { fprintf(stderr, "condvar-new: out of memory\n"); abort(); }
  pthread_cond_init(c, NULL);
  return (void *)(intptr_t)c;
  ```)
;;; condvar-wait -- atomically release the mutex and wait for a signal on the condition variable.
;;;
;;; Parameters:
;;;   c -- condvar handle returned by condvar-new
;;;   m -- mutex handle (from mutex-new) that the caller already holds
;;;
;;; Example:
;;;   (condvar-wait c m)
;;;
;;; Since: Phase T19-C

(defn condvar-wait [c : CondVar ^borrow m : Mutex] : nil
  ```c
  pthread_cond_wait((pthread_cond_t *)c, (pthread_mutex_t *)m);
  ```)
;;; condvar-signal -- wake one thread waiting on the condition variable.
;;;
;;; Parameters:
;;;   c -- condvar handle returned by condvar-new
;;;
;;; Example:
;;;   (condvar-signal c)
;;;
;;; Since: Phase T19-C

(defn condvar-signal [c : CondVar] : nil
  ```c
  pthread_cond_signal((pthread_cond_t *)c);
  ```)
;;; condvar-broadcast -- wake all threads waiting on the condition variable.
;;;
;;; Parameters:
;;;   c -- condvar handle returned by condvar-new
;;;
;;; Example:
;;;   (condvar-broadcast c)
;;;
;;; Since: Phase T19-C

(defn condvar-broadcast [c : CondVar] : nil
  ```c
  pthread_cond_broadcast((pthread_cond_t *)c);
  ```)
;;; condvar-free -- destroy the condition variable and release its memory.
;;;
;;; Parameters:
;;;   c -- condvar handle returned by condvar-new
;;;
;;; Example:
;;;   (condvar-free c)
;;;
;;; Since: Phase T19-C

(defn condvar-free [c : CondVar] : nil
  ```c
  pthread_cond_destroy((pthread_cond_t *)c);
  free(c);
  ```)
