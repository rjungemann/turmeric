;; Phase 17: Exception types for Turmeric
;; 
;; Standard exception types for error handling

(extern-c malloc [^int size] :ptr)
(extern-c free [^ptr p] :void)

;; ============================================================================
;; Base Error type
;; ============================================================================

;; Error - base error type with message and optional cause
(defn Error-type []
  ```c
  typedef struct Error Error;
  struct Error {
      const char* message;
      void* cause;  /* Pointer to another exception or NULL */
  };
  return NULL;
  ```)

;; Create a new Error
(defn Error. [message cause]
  ```c
  typedef struct Error Error;
  Error* err = (Error*)malloc(sizeof(Error));
  err->message = message;
  err->cause = cause;
  return (void*)err;
  ```)

;; Get the message from an Error
(defn Error-message [err]
  ```c
  typedef struct Error Error;
  Error* e = (Error*)err;
  return (void*)e->message;
  ```)

;; Get the cause from an Error
(defn Error-cause [err]
  ```c
  typedef struct Error Error;
  Error* e = (Error*)err;
  return e->cause;
  ```)

;; Free an Error
(defn Error-free [err]
  ```c
  free(err);
  ```)

;; ============================================================================
;; IoError type
;; ============================================================================

;; IoError - I/O error with message and errno
(defn IoError-type []
  ```c
  typedef struct IoError IoError;
  struct IoError {
      const char* message;
      int errno_;  /* System error number */
  };
  return NULL;
  ```)

;; Create a new IoError
(defn IoError. [message errno_val]
  ```c
  typedef struct IoError IoError;
  IoError* err = (IoError*)malloc(sizeof(IoError));
  err->message = message;
  err->errno_ = errno_val;
  return (void*)err;
  ```)

;; Get the message from an IoError
(defn IoError-message [err]
  ```c
  typedef struct IoError IoError;
  IoError* e = (IoError*)err;
  return (void*)e->message;
  ```)

;; Get the errno from an IoError
(defn IoError-errno [err]
  ```c
  typedef struct IoError IoError;
  IoError* e = (IoError*)err;
  return e->errno_;
  ```)

;; Free an IoError
(defn IoError-free [err]
  ```c
  free(err);
  ```)

;; ============================================================================
;; ParseError type
;; ============================================================================

;; ParseError - parsing error with message and source location
;; Note: Span is passed as separate fields for now
(defn ParseError-type []
  ```c
  typedef struct ParseError ParseError;
  struct ParseError {
      const char* message;
      int line;
      int col;
      const char* file;
  };
  return NULL;
  ```)

;; Create a new ParseError
(defn ParseError. [message line col file]
  ```c
  typedef struct ParseError ParseError;
  ParseError* err = (ParseError*)malloc(sizeof(ParseError));
  err->message = message;
  err->line = line;
  err->col = col;
  err->file = file;
  return (void*)err;
  ```)

;; Get the message from a ParseError
(defn ParseError-message [err]
  ```c
  typedef struct ParseError ParseError;
  ParseError* e = (ParseError*)err;
  return (void*)e->message;
  ```)

;; Get the line from a ParseError
(defn ParseError-line [err]
  ```c
  typedef struct ParseError ParseError;
  ParseError* e = (ParseError*)err;
  return e->line;
  ```)

;; Get the column from a ParseError
(defn ParseError-col [err]
  ```c
  typedef struct ParseError ParseError;
  ParseError* e = (ParseError*)err;
  return e->col;
  ```)

;; Get the file from a ParseError
(defn ParseError-file [err]
  ```c
  typedef struct ParseError ParseError;
  ParseError* e = (ParseError*)err;
  return (void*)e->file;
  ```)

;; Free a ParseError
(defn ParseError-free [err]
  ```c
  free(err);
  ```)

;; ============================================================================
;; Sugar functions for throwing exceptions
;; ============================================================================

;; throw-error - sugar for (throw (Error. message nil))
(defn throw-error [msg]
  (throw (Error. msg nil)))

;; throw-io-error - sugar for (throw (IoError. message 0))
(defn throw-io-error [msg]
  (throw (IoError. msg 0)))

;; ============================================================================
;; ValidationError type (Phase R3)
;; ============================================================================

(defn ValidationError. [message :cstr field :cstr] :ptr<void>
  ```c
  typedef struct { const char *message; const char *field; } ValidationError;
  ValidationError *err = (ValidationError*)malloc(sizeof(ValidationError));
  err->message = message;
  err->field = field;
  return (void*)err;
  ```)

(defn ValidationError-message [err :ptr<void>] :cstr
  ```c
  typedef struct { const char *message; const char *field; } ValidationError;
  ValidationError *e = (ValidationError*)err;
  return e->message;
  ```)

(defn ValidationError-field [err :ptr<void>] :cstr
  ```c
  typedef struct { const char *message; const char *field; } ValidationError;
  ValidationError *e = (ValidationError*)err;
  return e->field ? e->field : "";
  ```)

(defn ValidationError-free [err :ptr<void>] :void
  ```c
  free(err);
  ```)

;; ============================================================================
;; NotFoundError type (Phase R3)
;; ============================================================================

(defn NotFoundError. [what :cstr] :ptr<void>
  ```c
  typedef struct { const char *what; } NotFoundError;
  NotFoundError *err = (NotFoundError*)malloc(sizeof(NotFoundError));
  err->what = (const char*)(intptr_t)what;
  return (void*)err;
  ```)

(defn NotFoundError-what [err :ptr<void>] :cstr
  ```c
  typedef struct { const char *what; } NotFoundError;
  NotFoundError *e = (NotFoundError*)err;
  return e->what;
  ```)

(defn NotFoundError-free [err :ptr<void>] :void
  ```c
  free(err);
  ```)

;; ============================================================================
;; PermissionError type (Phase R3)
;; ============================================================================

(defn PermissionError. [message :cstr path :cstr] :ptr<void>
  ```c
  typedef struct { const char *message; const char *path; } PermissionError;
  PermissionError *err = (PermissionError*)malloc(sizeof(PermissionError));
  err->message = message;
  err->path = path;
  return (void*)err;
  ```)

(defn PermissionError-message [err :ptr<void>] :cstr
  ```c
  typedef struct { const char *message; const char *path; } PermissionError;
  PermissionError *e = (PermissionError*)err;
  return e->message;
  ```)

(defn PermissionError-path [err :ptr<void>] :cstr
  ```c
  typedef struct { const char *message; const char *path; } PermissionError;
  PermissionError *e = (PermissionError*)err;
  return e->path ? e->path : "";
  ```)

(defn PermissionError-free [err :ptr<void>] :void
  ```c
  free(err);
  ```)

;; ============================================================================
;; Convenience constructors (Phase R3)
;; ============================================================================

;; io-error — create an IoError with just a message (errno defaults to 0)
(defn io-error [msg :cstr] :ptr<void>
  (IoError. msg 0))

;; io-error-with-errno — create an IoError with message and errno
(defn io-error-with-errno [msg :cstr errno-val :int] :ptr<void>
  (IoError. msg errno-val))

;; parse-error — create a ParseError with message and location
(defn parse-error [msg :cstr line :int col :int file :cstr] :ptr<void>
  (ParseError. msg line col file))

;; parse-error-simple — create a ParseError with just message and line
(defn parse-error-simple [msg :cstr line :int] :ptr<void>
  (ParseError. msg line 0 "<unknown>"))

;; ============================================================================
;; Show / display functions for error types (Phase R3)
;; ============================================================================

;; show-error — format Error as "Error: <message>"
(defn show-error [err :ptr<void>] :cstr
  ```c
  typedef struct { const char *message; void *cause; } Error;
  Error *e = (Error*)err;
  extern size_t strlen(const char*);
  size_t prefix_len = 7; /* "Error: " */
  size_t msg_len = strlen(e->message);
  char *buf = (char*)malloc(prefix_len + msg_len + 1);
  memcpy(buf, "Error: ", prefix_len);
  memcpy(buf + prefix_len, e->message, msg_len + 1);
  return buf;
  ```)

;; show-io-error — format IoError as "IoError: <message> (errno=N)"
(defn show-io-error [err :ptr<void>] :cstr
  ```c
  typedef struct { const char *message; int errno_; } IoError;
  IoError *e = (IoError*)err;
  extern size_t strlen(const char*);
  size_t msg_len = strlen(e->message);
  char *buf = (char*)malloc(msg_len + 32);
  if (e->errno_ != 0) {
    snprintf(buf, msg_len + 32, "IoError: %s (errno=%d)", e->message, e->errno_);
  } else {
    snprintf(buf, msg_len + 32, "IoError: %s", e->message);
  }
  return buf;
  ```)

;; show-parse-error — format ParseError as "ParseError: <message> at <file>:<line>:<col>"
(defn show-parse-error [err :ptr<void>] :cstr
  ```c
  typedef struct { const char *message; int line; int col; const char *file; } ParseError;
  ParseError *e = (ParseError*)err;
  extern size_t strlen(const char*);
  size_t msg_len = strlen(e->message);
  size_t file_len = strlen(e->file);
  char *buf = (char*)malloc(msg_len + file_len + 64);
  snprintf(buf, msg_len + file_len + 64, "ParseError: %s at %s:%d:%d", e->message, e->file, e->line, e->col);
  return buf;
  ```)

;; show-validation-error — format ValidationError as "ValidationError: <message> (field: <field>)"
(defn show-validation-error [err :ptr<void>] :cstr
  ```c
  typedef struct { const char *message; const char *field; } ValidationError;
  ValidationError *e = (ValidationError*)err;
  extern size_t strlen(const char*);
  size_t msg_len = strlen(e->message);
  char *buf;
  if (e->field && e->field[0] != '\0') {
    size_t field_len = strlen(e->field);
    buf = (char*)malloc(msg_len + field_len + 40);
    snprintf(buf, msg_len + field_len + 40, "ValidationError: %s (field: %s)", e->message, e->field);
  } else {
    buf = (char*)malloc(msg_len + 20);
    snprintf(buf, msg_len + 20, "ValidationError: %s", e->message);
  }
  return buf;
  ```)

;; show-not-found-error — format NotFoundError as "NotFoundError: <what> not found"
(defn show-not-found-error [err :ptr<void>] :cstr
  ```c
  typedef struct { const char *what; } NotFoundError;
  NotFoundError *e = (NotFoundError*)err;
  extern size_t strlen(const char*);
  size_t what_len = strlen(e->what);
  char *buf = (char*)malloc(what_len + 30);
  snprintf(buf, what_len + 30, "NotFoundError: %s not found", e->what);
  return buf;
  ```)

;; show-permission-error — format PermissionError as "PermissionError: <message> (path: <path>)"
(defn show-permission-error [err :ptr<void>] :cstr
  ```c
  typedef struct { const char *message; const char *path; } PermissionError;
  PermissionError *e = (PermissionError*)err;
  extern size_t strlen(const char*);
  size_t msg_len = strlen(e->message);
  char *buf;
  if (e->path && e->path[0] != '\0') {
    size_t path_len = strlen(e->path);
    buf = (char*)malloc(msg_len + path_len + 40);
    snprintf(buf, msg_len + path_len + 40, "PermissionError: %s (path: %s)", e->message, e->path);
  } else {
    buf = (char*)malloc(msg_len + 20);
    snprintf(buf, msg_len + 20, "PermissionError: %s", e->message);
  }
  return buf;
  ```)

