;; ============================================================================
;; PermissionError type (Phase R3)
;; ============================================================================

(defstruct PermissionError [message :cstr path :cstr])

(defn PermissionError. [message :cstr path :cstr] :ptr<void>
  ```c
  PermissionError* err = (PermissionError*)malloc(sizeof(PermissionError));
  err->message = message;
  err->path = path;
  return (void*)err;
  ```)

(defn PermissionError-message [err :ptr<void>] :cstr
  ```c
  PermissionError* e = (PermissionError*)err;
  return e->message;
  ```)

(defn PermissionError-path [err :ptr<void>] :cstr
  ```c
  PermissionError* e = (PermissionError*)err;
  return e->path ? e->path : "";
  ```)

(defn PermissionError-free [err :ptr<void>] :void
  ```c
  free(err);
  ```)

;; ============================================================================
;; Convenience constructors (Phase R3)
;; ============================================================================

;; io-error — create an IoError with just a message (errno defaults to 0)
(defn io-error [msg :cstr] :ptr<void>
  (IoError. msg 0))

;; io-error-with-errno — create an IoError with message and errno
(defn io-error-with-errno [msg :cstr errno-val :int] :ptr<void>
  (IoError. msg errno-val))

;; parse-error — create a ParseError with message and location
(defn parse-error [msg :cstr line :int col :int file :cstr] :ptr<void>
  (ParseError. msg line col file))

;; parse-error-simple — create a ParseError with just message and line
(defn parse-error-simple [msg :cstr line :int] :ptr<void>
  (ParseError. msg line 0 "<unknown>"))

;; ============================================================================
;; Show / display functions for error types (Phase R3)
;; ============================================================================

;; show-error — format Error as "Error: <message>"
(defn show-error [err :ptr<void>] :cstr
  ```c
  Error* e = (Error*)err;
  extern size_t strlen(const char*);
  size_t prefix_len = 7; /* "Error: " */
  size_t msg_len = strlen(e->message);
  char *buf = (char*)malloc(prefix_len + msg_len + 1);
  memcpy(buf, "Error: ", prefix_len);
  memcpy(buf + prefix_len, e->message, msg_len + 1);
  return buf;
  ```)

;; show-io-error — format IoError as "IoError: <message> (errno=N)"
(defn show-io-error [err :ptr<void>] :cstr
  ```c
  IoError* e = (IoError*)err;
  extern size_t strlen(const char*);
  size_t msg_len = strlen(e->message);
  char *buf = (char*)malloc(msg_len + 32);
  if (e->errno_val != 0) {
    snprintf(buf, msg_len + 32, "IoError: %s (errno=%d)", e->message, e->errno_val);
  } else {
    snprintf(buf, msg_len + 32, "IoError: %s", e->message);
  }
  return buf;
  ```)

;; show-parse-error — format ParseError as "ParseError: <message> at <file>:<line>:<col>"
(defn show-parse-error [err :ptr<void>] :cstr
  ```c
  ParseError* e = (ParseError*)err;
  extern size_t strlen(const char*);
  size_t msg_len = strlen(e->message);
  size_t file_len = strlen(e->file);
  char *buf = (char*)malloc(msg_len + file_len + 64);
  snprintf(buf, msg_len + file_len + 64, "ParseError: %s at %s:%d:%d", e->message, e->file, e->line, e->col);
  return buf;
  ```)

;; show-validation-error — format ValidationError as "ValidationError: <message> (field: <field>)"
(defn show-validation-error [err :ptr<void>] :cstr
  ```c
  ValidationError* e = (ValidationError*)err;
  extern size_t strlen(const char*);
  size_t msg_len = strlen(e->message);
  char *buf;
  if (e->field && e->field[0] != '\0') {
    size_t field_len = strlen(e->field);
    buf = (char*)malloc(msg_len + field_len + 40);
    snprintf(buf, msg_len + field_len + 40, "ValidationError: %s (field: %s)", e->message, e->field);
  } else {
    buf = (char*)malloc(msg_len + 20);
    snprintf(buf, msg_len + 20, "ValidationError: %s", e->message);
  }
  return buf;
  ```)

;; show-not-found-error — format NotFoundError as "NotFoundError: <what> not found"
(defn show-not-found-error [err :ptr<void>] :cstr
  ```c
  NotFoundError* e = (NotFoundError*)err;
  extern size_t strlen(const char*);
  size_t what_len = strlen(e->what);
  char *buf = (char*)malloc(what_len + 30);
  snprintf(buf, what_len + 30, "NotFoundError: %s not found", e->what);
  return buf;
  ```)

;; show-permission-error — format PermissionError as "PermissionError: <message> (path: <path>)"
(defn show-permission-error [err :ptr<void>] :cstr
  ```c
  PermissionError* e = (PermissionError*)err;
  extern size_t strlen(const char*);
  size_t msg_len = strlen(e->message);
  char *buf;
  if (e->path && e->path[0] != '\0') {
    size_t path_len = strlen(e->path);
    buf = (char*)malloc(msg_len + path_len + 40);
    snprintf(buf, msg_len + path_len + 40, "PermissionError: %s (path: %s)", e->message, e->path);
  } else {
    buf = (char*)malloc(msg_len + 20);
    snprintf(buf, msg_len + 20, "PermissionError: %s", e->message);
  }
  return buf;
  ```)

;; Phase R3: Error typeclass instances for stdlib error types
;; These implement the Error typeclass (error-message, error-cause) for each error type.
;;
;; Note: In v1, all error types are represented as ptr<void> at the value level,
;; but we use defstruct to give them nominal types for typeclass instance resolution.
;;
;; Error typeclass instances for each error struct type

;; Error instance for Error (identity)
;; Note: We can't define instances for defstruct types directly in v1
;; because the typeclass system doesn't support user-defined struct types yet.
;; These instances are deferred until proper generic typeclass support lands.
;;
;; For now, we implement Error typeclass instances for ptr<void> that handle
;; each error type by casting and accessing the appropriate fields.
;;
;; See stdlib/typeclass.tur for the actual Error typeclass instance implementations.
