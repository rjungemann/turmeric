;; Phase 17/Phase R3: Exception types for Turmeric
;; 
;; Standard exception types for error handling
;; Phase R3: Using defstruct for proper typeclass integration

(extern-c malloc [^int size] :ptr)
(extern-c free [^ptr p] :void)

;; ============================================================================
;; Base Error type (Phase R3: using defstruct)
;; ============================================================================

;; Error - base error type with message and optional cause
(defstruct Error [message :cstr cause :ptr<void>])

;; Create a new Error on the heap
(defn Error. [message :cstr cause :ptr<void>] :ptr<void>
  ```c
  Error* err = (Error*)malloc(sizeof(Error));
  err->message = message;
  err->cause = cause;
  return (void*)err;
  ```)

;; Get the message from an Error pointer
(defn Error-message [err :ptr<void>] :cstr
  ```c
  Error* e = (Error*)err;
  return (void*)e->message;
  ```)

;; Get the cause from an Error pointer
(defn Error-cause [err :ptr<void>] :ptr<void>
  ```c
  Error* e = (Error*)err;
  return e->cause;
  ```)

;; Free an Error
(defn Error-free [err :ptr<void>] :void
  ```c
  free(err);
  ```)

;; ============================================================================
;; IoError type (Phase R3: using defstruct)
;; ============================================================================

(defstruct IoError [message :cstr errno_val :int])

;; Create a new IoError on the heap
(defn IoError. [message :cstr errno-val :int] :ptr<void>
  ```c
  IoError* err = (IoError*)malloc(sizeof(IoError));
  err->message = message;
  err->errno_val = errno_val;
  return (void*)err;
  ```)

;; Get the message from an IoError pointer
(defn IoError-message [err :ptr<void>] :cstr
  ```c
  IoError* e = (IoError*)err;
  return (void*)e->message;
  ```)

;; Get the errno from an IoError pointer
(defn IoError-errno [err :ptr<void>] :int
  ```c
  IoError* e = (IoError*)err;
  return e->errno_val;
  ```)

;; Free an IoError
(defn IoError-free [err :ptr<void>] :void
  ```c
  free(err);
  ```)

;; ============================================================================
;; ParseError type (Phase R3: using defstruct)
;; ============================================================================

(defstruct ParseError [message :cstr line :int col :int file :cstr])

;; Create a new ParseError on the heap
(defn ParseError. [message :cstr line :int col :int file :cstr] :ptr<void>
  ```c
  ParseError* err = (ParseError*)malloc(sizeof(ParseError));
  err->message = message;
  err->line = line;
  err->col = col;
  err->file = file;
  return (void*)err;
  ```)

;; Get the message from a ParseError pointer
(defn ParseError-message [err :ptr<void>] :cstr
  ```c
  ParseError* e = (ParseError*)err;
  return (void*)e->message;
  ```)

;; Get the line from a ParseError pointer
(defn ParseError-line [err :ptr<void>] :int
  ```c
  ParseError* e = (ParseError*)err;
  return e->line;
  ```)

;; Get the column from a ParseError pointer
(defn ParseError-col [err :ptr<void>] :int
  ```c
  ParseError* e = (ParseError*)err;
  return e->col;
  ```)

;; Get the file from a ParseError pointer
(defn ParseError-file [err :ptr<void>] :cstr
  ```c
  ParseError* e = (ParseError*)err;
  return (void*)e->file;
  ```)

;; Free a ParseError
(defn ParseError-free [err :ptr<void>] :void
  ```c
  free(err);
  ```)

;; ============================================================================
;; Sugar functions for throwing exceptions
;; ============================================================================

;; throw-error - sugar for (throw (Error. message nil))
(defn throw-error [msg :cstr] :!
  (throw (Error. msg nil)))

;; throw-io-error - sugar for (throw (IoError. message 0))
(defn throw-io-error [msg :cstr] :!
  (throw (IoError. msg 0)))

;; ============================================================================
;; ValidationError type (Phase R3)
;; ============================================================================

(defstruct ValidationError [message :cstr field :cstr])

(defn ValidationError. [message :cstr field :cstr] :ptr<void>
  ```c
  ValidationError* err = (ValidationError*)malloc(sizeof(ValidationError));
  err->message = message;
  err->field = field;
  return (void*)err;
  ```)

(defn ValidationError-message [err :ptr<void>] :cstr
  ```c
  ValidationError* e = (ValidationError*)err;
  return e->message;
  ```)

(defn ValidationError-field [err :ptr<void>] :cstr
  ```c
  ValidationError* e = (ValidationError*)err;
  return e->field ? e->field : "";
  ```)

(defn ValidationError-free [err :ptr<void>] :void
  ```c
  free(err);
  ```)

