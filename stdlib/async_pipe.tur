;; stdlib/async_pipe.tur -- Async pipe/stdio I/O for Turmeric (Phase T24)
;;
;; Non-blocking stdin/stdout operations that integrate with the cooperative
;; scheduler. Sets stdin/stdout to non-blocking mode and parks fibers when
;; the operation would block.
;;
;; API:
;;   async-read-stdin   [buf-size]  -> bytes-read (int)
;;   async-write-stdout [data len]  -> bytes-written (int)

;; Read up to buf-size bytes from stdin (non-blocking).
;; Parks the fiber on EAGAIN if running under a scheduler.
;; The read data is stored in fiber-local (key 0xA51C5D10) -- retrieve
;; with async-stdin-buf.
;;; async-read-stdin -- read up to buf-size bytes from stdin in non-blocking mode.
;;;
;;; Parameters:
;;;   buf-size -- maximum number of bytes to read
;;;
;;; Returns:
;;;   int -- bytes read (>= 0), 0 on EOF, -1 on error
;;;
;;; Example:
;;;   (async-read-stdin 1024)  ; => 42
;;;
;;; Since: Phase T24
(defn async-read-stdin [buf-size :int] #{Unsafe} :int
  ```c
  /* Set stdin non-blocking */
  int flags = fcntl(STDIN_FILENO, F_GETFL, 0);
  fcntl(STDIN_FILENO, F_SETFL, flags | O_NONBLOCK);
  char *buf = (char *)malloc((size_t)buf_size);
  if (!buf) return -1;
  while (1) {
    ssize_t n = read(STDIN_FILENO, buf, (size_t)buf_size);
    if (n >= 0) {
      if (tur_current_fiber) {
        tur_fiber_local_set(tur_current_fiber, 0xA51C5D10, (int64_t)(intptr_t)buf);
        tur_fiber_local_set(tur_current_fiber, 0xA51C5D11, n);
      }
      return (int64_t)n;
    }
    if (errno == EAGAIN || errno == EWOULDBLOCK) {
      FiberBlock *me = tur_current_fiber;
      if (me && tur_scheduler) {
        tur_io_register(STDIN_FILENO, TUR_IO_READ, me);
        me->parked = 1;
        tur_fiber_block_yield(0);
        continue;
      }
    }
    free(buf);
    return -1;
  }
  ```)

;; Retrieve the stdin read buffer after async-read-stdin.
;;; async-stdin-buf -- retrieve the buffer pointer from the last async-read-stdin call.
;;;
;;; Returns:
;;;   ptr<void> -- pointer to the read buffer in fiber-local storage (caller must free)
;;;
;;; Example:
;;;   (async-stdin-buf)  ; => buf-ptr
;;;
;;; Since: Phase T24
(defn async-stdin-buf [] #{Unsafe} :ptr<void>
  ```c
  if (!tur_current_fiber) return NULL;
  return (void*)(intptr_t)tur_fiber_local_get(tur_current_fiber, 0xA51C5D10);
  ```)

;; Retrieve the number of bytes from the last async-read-stdin.
;;; async-stdin-len -- retrieve the byte count from the last async-read-stdin call.
;;;
;;; Returns:
;;;   int -- number of bytes read in the most recent async-read-stdin
;;;
;;; Example:
;;;   (async-stdin-len)  ; => 42
;;;
;;; Since: Phase T24
(defn async-stdin-len [] #{Unsafe} :int
  ```c
  if (!tur_current_fiber) return 0;
  return tur_fiber_local_get(tur_current_fiber, 0xA51C5D11);
  ```)

;; Write len bytes from data to stdout (non-blocking).
;; Parks the fiber on EAGAIN if running under a scheduler.
;; Returns total bytes written, or -1 on error.
;;; async-write-stdout -- write len bytes from data to stdout in non-blocking mode.
;;;
;;; Parameters:
;;;   data -- pointer to the bytes to write
;;;   len  -- number of bytes to write
;;;
;;; Returns:
;;;   int -- total bytes written, or -1 on error
;;;
;;; Example:
;;;   (async-write-stdout "hello\n" 6)  ; => 6
;;;
;;; Since: Phase T24
(defn async-write-stdout [data :cstr len :int] #{Unsafe} :int
  ```c
  /* Set stdout non-blocking */
  int flags = fcntl(STDOUT_FILENO, F_GETFL, 0);
  fcntl(STDOUT_FILENO, F_SETFL, flags | O_NONBLOCK);
  int64_t total = 0;
  while (total < len) {
    ssize_t n = write(STDOUT_FILENO, data + total, (size_t)(len - total));
    if (n >= 0) {
      total += n;
      continue;
    }
    if (errno == EAGAIN || errno == EWOULDBLOCK) {
      FiberBlock *me = tur_current_fiber;
      if (me && tur_scheduler) {
        tur_io_register(STDOUT_FILENO, TUR_IO_WRITE, me);
        me->parked = 1;
        tur_fiber_block_yield(0);
        continue;
      }
    }
    return -1;
  }
  return total;
  ```)
