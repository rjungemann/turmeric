;;; tur/map -- typed Map[K V]: persistent hash map requiring Hash[K] and Eq[K].
;;;
;;; Backed by the persistent HAMT from tur/hamt.
;;;
;;; Since: Phase TM0
;; Phase TM0: Typed Map[K V]
;; K must satisfy Hash[K] and Eq[K].
;; Backed by the persistent HAMT (stdlib/hamt.tur).
;; At runtime, a Map[K V] is a heap-allocated wrapper around a HAMT ptr<void>.
;; Internal C layout: struct { void *hamt; }
;;; Map -- parameterized persistent map with key type K and value type V.
;;;
;;; Since: Phase TM0
(defstruct Map [K V] (hamt :ptr<void>))
;;; map-new -- create a new empty typed map.
;;;
;;; Returns:
;;;   An empty Map[K V].
;;;
;;; Example:
;;;   (map-new)  ; => empty Map
;;;
;;; Since: Phase TM0

(defn map-new []
  #{}
  :int
  ```c struct { void *hamt; } *m = malloc(sizeof(*m));
  m->hamt = tur_hamt_new();
  return (int64_t)(intptr_t)m;
  ```)
;;; map-hamt -- internal accessor for the HAMT backing store.

(defn map-hamt [m :int]
  #{}
  :ptr<void>
  ```c struct { void *hamt; } *map = (void*)(intptr_t)m;
  return map->hamt;
  ```)
;;; map-wrap -- internal constructor from a HAMT pointer.

(defn map-wrap [h :ptr<void>]
  #{}
  :int
  ```c struct { void *hamt; } *m = malloc(sizeof(*m));
  m->hamt = (void*)(intptr_t)h;
  return (int64_t)(intptr_t)m;
  ```)
;;; map-assoc -- insert or update a key/value pair; returns a new map.
;;;
;;; Parameters:
;;;   m   -- source Map[K V]
;;;   key -- key of type K (used as hash for scalar keys)
;;;   val -- value of type V
;;;
;;; Returns:
;;;   A new Map[K V] with the entry inserted or updated.
;;;
;;; Example:
;;;   (map-assoc my-map 1 100)  ; => updated map
;;;
;;; Since: Phase TM0

(defn map-assoc [V] [m :int key :int val :V]
  #{}
  :int
  ```c struct { void *hamt; } *map = (void*)(intptr_t)m;
  void *new_hamt = tur_hamt_set(map->hamt, (int64_t)key, (void*)(intptr_t)key, (void*)(intptr_t)val);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)
;;; map-assoc-h -- insert or update with an explicit hash; returns a new map.
;;;
;;; Parameters:
;;;   m   -- source Map[K V]
;;;   h   -- precomputed hash of key (from Hash[K] typeclass)
;;;   key -- key of type K
;;;   val -- value of type V
;;;
;;; Returns:
;;;   A new Map[K V] with the entry inserted or updated.
;;;
;;; Example:
;;;   (map-assoc-h my-map (hash k) k v)  ; => updated map
;;;
;;; Since: Phase TM0

(defn map-assoc-h [V] [m :int h :int key :int val :V]
  #{}
  :int
  ```c struct { void *hamt; } *map = (void*)(intptr_t)m;
  void *new_hamt = tur_hamt_set(map->hamt, h, (void*)(intptr_t)key, (void*)(intptr_t)val);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)
;;; map-dissoc -- remove a key from the map; returns a new map.
;;;
;;; Parameters:
;;;   m   -- source Map[K V]
;;;   h   -- precomputed hash of key
;;;   key -- key of type K
;;;
;;; Returns:
;;;   A new Map[K V] with the key removed.
;;;
;;; Example:
;;;   (map-dissoc my-map (hash k) k)  ; => map without k
;;;
;;; Since: Phase TM0

(defn map-dissoc [m :int h :int key :int]
  #{}
  :int
  ```c struct { void *hamt; } *map = (void*)(intptr_t)m;
  void *new_hamt = tur_hamt_del(map->hamt, h, (void*)(intptr_t)key);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)
;;; map-get -- look up a key; returns the value or 0 if absent.
;;;
;;; Parameters:
;;;   m   -- Map[K V]
;;;   h   -- precomputed hash of key
;;;   key -- key of type K
;;;
;;; Returns:
;;;   The value for the key, or 0 (none) if absent.
;;;
;;; Example:
;;;   (map-get my-map (hash k) k)  ; => value or 0
;;;
;;; Since: Phase TM0

(defn map-get [V] [m :int h :int key :int]
  #{}
  :V
  ```c struct { void *hamt; } *map = (void*)(intptr_t)m;
  return (int64_t)(intptr_t)tur_hamt_get(map->hamt, h, (void*)(intptr_t)key);
  ```)
;;; map-has? -- check whether a key exists in the map.
;;;
;;; Parameters:
;;;   m   -- Map[K V]
;;;   h   -- precomputed hash of key
;;;   key -- key of type K
;;;
;;; Returns:
;;;   true if the key is present, false otherwise.
;;;
;;; Example:
;;;   (map-has? my-map (hash k) k)  ; => true or false
;;;
;;; Since: Phase TM0

(defn map-has? [m :int h :int key :int]
  #{}
  :bool
  ```c struct { void *hamt; } *map = (void*)(intptr_t)m;
  return tur_hamt_has(map->hamt, h, (void*)(intptr_t)key);
  ```)
;;; map-count -- return the number of entries in the map.
;;;
;;; Parameters:
;;;   m -- Map[K V]
;;;
;;; Returns:
;;;   Integer count of key/value pairs.
;;;
;;; Example:
;;;   (map-count my-map)  ; => 3
;;;
;;; Since: Phase TM0

(defn map-count [m :int]
  #{}
  :int
  ```c struct { void *hamt; } *map = (void*)(intptr_t)m;
  return tur_hamt_count(map->hamt);
  ```)
;;; map-merge -- merge two maps; values from b win on key collision.
;;;
;;; Parameters:
;;;   a -- first Map[K V]
;;;   b -- second Map[K V] (wins on collision)
;;;
;;; Returns:
;;;   A new Map[K V] containing all entries from both maps.
;;;
;;; Example:
;;;   (map-merge map-a map-b)  ; => merged map
;;;
;;; Since: Phase TM0

(defn map-merge [a :int b :int]
  #{}
  :int
  ```c struct { void *hamt; } *ma = (void*)(intptr_t)a;
  struct { void *hamt; } *mb = (void*)(intptr_t)b;
  void *new_hamt = tur_hamt_merge(ma->hamt, mb->hamt);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)
;;; ============================================================================
;;; Content-keyed maps (TCE4)
;;;
;;; The plain map-assoc/map-get compare keys by identity (the key word is the
;;; key). That is right for :int keys but wrong for content-typed keys such as
;;; strings, where two distinct pointers may hold equal text. The *-eq family
;;; below takes an explicit hash and a key-equality closure, threaded into the
;;; runtime HAMT (tur_hamt_*_eq); the smap-* layer specializes them for :cstr
;;; keys. See docs/typed-collection-elements-plan.md (TCE4).
;;; ============================================================================

;;; cstr-hash -- xxHash64 of a NUL-terminated string's contents.
;;;
;;; Parameters:
;;;   s -- the string to hash
;;;
;;; Returns:
;;;   The 64-bit content hash, so equal text hashes equally regardless of
;;;   pointer identity.
;;;
;;; Example:
;;;   (cstr-hash "key")  ; => <stable content hash>
;;;
;;; Since: TCE4

(defn cstr-hash [s :cstr] :int
  ```c return (int64_t)tur_hamt_hash_str((const char *)(intptr_t)s); ```)
;;; tur-cstr-key-eq? -- internal: content equality of two string keys.

(defn tur-cstr-key-eq? [a :cstr b :cstr] :bool
  ```c const char *p = (const char *)(intptr_t)a;
  const char *q = (const char *)(intptr_t)b;
  while (*p && (*p == *q)) { p++; q++; }
  return *(const unsigned char *)p == *(const unsigned char *)q;
  ```)
;;; map-assoc-eq -- insert/update with an explicit hash and key-equality fn.
;;;
;;; Parameters:
;;;   m     -- source Map[K V]
;;;   h     -- precomputed content hash of key
;;;   key   -- key of type K
;;;   val   -- value of type V
;;;   keyeq -- a (fn [a :K b :K] :bool) used to compare keys that share a hash
;;;
;;; Returns:
;;;   A new Map[K V] with the entry inserted or updated. Keys that are equal
;;;   under keyeq (not just identical pointers) collapse to one entry.
;;;
;;; Example:
;;;   (map-assoc-eq m (cstr-hash k) k v tur-cstr-key-eq?)
;;;
;;; Since: TCE4

(defn map-assoc-eq [K V] [m :int h :int key :K val :V keyeq] :int
  ```c struct { void *hamt; } *map = (void *)(intptr_t)m;
  void *new_hamt = tur_hamt_set_eq(map->hamt, (uint64_t)h, (void *)(intptr_t)key,
                                   (void *)(intptr_t)val,
                                   (void *)(intptr_t)keyeq);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)
;;; map-get-eq -- look up a key using an explicit hash and key-equality fn.
;;;
;;; Parameters:
;;;   m     -- Map[K V]
;;;   h     -- precomputed content hash of key
;;;   key   -- key of type K
;;;   keyeq -- key comparison fn (see map-assoc-eq)
;;;
;;; Returns:
;;;   The value of type V, or 0 (none) if absent.
;;;
;;; Example:
;;;   (map-get-eq m (cstr-hash k) k tur-cstr-key-eq?)
;;;
;;; Since: TCE4

(defn map-get-eq [K V] [m :int h :int key :K keyeq] :V
  ```c struct { void *hamt; } *map = (void *)(intptr_t)m;
  return (int64_t)(intptr_t)tur_hamt_get_eq(map->hamt, (uint64_t)h,
                                            (void *)(intptr_t)key,
                                            (void *)(intptr_t)keyeq);
  ```)
;;; map-has-eq? -- key-existence test using an explicit hash and equality fn.
;;;
;;; Parameters:
;;;   m     -- Map[K V]
;;;   h     -- precomputed content hash of key
;;;   key   -- key of type K
;;;   keyeq -- key comparison fn (see map-assoc-eq)
;;;
;;; Returns:
;;;   true if the key is present under keyeq, false otherwise.
;;;
;;; Example:
;;;   (map-has-eq? m (cstr-hash k) k tur-cstr-key-eq?)  ; => true or false
;;;
;;; Since: TCE4

(defn map-has-eq? [K] [m :int h :int key :K keyeq] :bool
  ```c struct { void *hamt; } *map = (void *)(intptr_t)m;
  return tur_hamt_has_eq(map->hamt, (uint64_t)h, (void *)(intptr_t)key,
                         (void *)(intptr_t)keyeq);
  ```)
;;; map-dissoc-eq -- remove a key using an explicit hash and equality fn.
;;;
;;; Parameters:
;;;   m     -- source Map[K V]
;;;   h     -- precomputed content hash of key
;;;   key   -- key of type K
;;;   keyeq -- key comparison fn (see map-assoc-eq)
;;;
;;; Returns:
;;;   A new Map[K V] with the key removed.
;;;
;;; Example:
;;;   (map-dissoc-eq m (cstr-hash k) k tur-cstr-key-eq?)
;;;
;;; Since: TCE4

(defn map-dissoc-eq [K] [m :int h :int key :K keyeq] :int
  ```c struct { void *hamt; } *map = (void *)(intptr_t)m;
  void *new_hamt = tur_hamt_del_eq(map->hamt, (uint64_t)h, (void *)(intptr_t)key,
                                   (void *)(intptr_t)keyeq);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)
;;; smap-assoc -- string-keyed insert/update: Map[cstr V] by content.
;;;
;;; Parameters:
;;;   m   -- source Map[cstr V]
;;;   key -- string key (compared and hashed by content)
;;;   val -- value of type V
;;;
;;; Returns:
;;;   A new Map[cstr V]; a key equal in text to an existing one updates it,
;;;   even if the two strings are distinct pointers.
;;;
;;; Example:
;;;   (smap-assoc (map-new) "name" 1)  ; => Map {"name" -> 1}
;;;
;;; Since: TCE4

(defn smap-assoc [V] [m :int key :cstr val :V] :int
  (map-assoc-eq m (cstr-hash key) key val tur-cstr-key-eq?))
;;; smap-get -- string-keyed lookup by content; returns V or 0 if absent.
;;;
;;; Parameters:
;;;   m   -- Map[cstr V]
;;;   key -- string key (matched by content)
;;;
;;; Returns:
;;;   The value of type V, or 0 (none) if absent.
;;;
;;; Example:
;;;   (smap-get m "name")  ; => value or 0
;;;
;;; Since: TCE4

(defn smap-get [V] [m :int key :cstr] :V
  (map-get-eq m (cstr-hash key) key tur-cstr-key-eq?))
;;; smap-has? -- string-keyed existence test by content.
;;;
;;; Parameters:
;;;   m   -- Map[cstr V]
;;;   key -- string key (matched by content)
;;;
;;; Returns:
;;;   true if present, false otherwise.
;;;
;;; Example:
;;;   (smap-has? m "name")  ; => true or false
;;;
;;; Since: TCE4

(defn smap-has? [m :int key :cstr] :bool
  (map-has-eq? m (cstr-hash key) key tur-cstr-key-eq?))
;;; smap-dissoc -- string-keyed removal by content; returns a new map.
;;;
;;; Parameters:
;;;   m   -- source Map[cstr V]
;;;   key -- string key (matched by content)
;;;
;;; Returns:
;;;   A new Map[cstr V] with the key removed.
;;;
;;; Example:
;;;   (smap-dissoc m "name")  ; => map without "name"
;;;
;;; Since: TCE4

(defn smap-dissoc [m :int key :cstr] :int
  (map-dissoc-eq m (cstr-hash key) key tur-cstr-key-eq?))
;;; map-free -- free the Map wrapper (does not free HAMT; use map-free-all for that).
;;;
;;; Parameters:
;;;   m -- Map[K V] to free
;;;
;;; Example:
;;;   (map-free my-map)
;;;
;;; Since: Phase TM0

(defn map-free [m :int]
  #{}
  :void
  ```c free((void*)(intptr_t)m);
  ```)
;;; map-eq? -- compare two maps for structural equality using a value comparator.
;;;
;;; Parameters:
;;;   m1      -- first Map[K V]
;;;   m2      -- second Map[K V]
;;;   val-cmp -- comparator fn [a :int b :int] :bool applied to each value pair
;;;
;;; Returns:
;;;   true if both maps have identical keys and all corresponding values satisfy val-cmp.
;;;
;;; Example:
;;;   (map-eq? ma mb (fn [a b] (= a b)))  ; => true
;;;
;;; Since: Phase TM0

(defn map-eq? [m1 :int m2 :int val-cmp]
  #{}
  :bool
  ```c struct { void *hamt; } *map1 = (void*)(intptr_t)m1;
  struct { void *hamt; } *map2 = (void*)(intptr_t)m2;
  if (tur_hamt_count(map1->hamt) != tur_hamt_count(map2->hamt)) return false;
  uint64_t iter_buf[32];
  for (int __i = 0; __i < 32; __i++) iter_buf[__i] = 0;
  tur_hamt_iter_init((void*)iter_buf, map1->hamt);
  uint64_t hash_out;
  void *key_out = NULL, *val_out = NULL;
  while (tur_hamt_iter_next((void*)iter_buf, &hash_out, &key_out, &val_out)) {
      void *val_in_b = tur_hamt_get(map2->hamt, (int64_t)hash_out, key_out);
      if (!val_in_b) { tur_hamt_iter_free((void*)iter_buf); return false; }
      bool vals_eq = ((bool(*)(int64_t, int64_t))(intptr_t)val_cmp)(
          (int64_t)(intptr_t)val_out, (int64_t)(intptr_t)val_in_b);
      if (!vals_eq) { tur_hamt_iter_free((void*)iter_buf); return false; }
  }
  tur_hamt_iter_free((void*)iter_buf);
  return true;
  ```)
;;; Eq [Map] -- structural equality using the value type's Eq instance.
;; TM0-6: Phase PTC4 -- constrained Eq instance for Map[K V].
;; Constraints: (Eq K) ensures keys are comparable; (Eq V) uses integer equality.
;; Note: element comparison uses integer equality; correct for all primitive K/V.

(definstance Eq [Map] [(Eq K) (Eq V)]
  (eq? [x y] (map-eq? x y (fn [a b] (= a b)))))
;;; hamt-assoc-each__ -- internal helper for the hamt-of macro.
;;;
;;; Threads (map-assoc m k v) over the kv-pairs in xs, returning the final
;;; map.  Recursive: each step wraps the accumulator in one more map-assoc,
;;; so the last pair wins on duplicate keys.

(defmacro hamt-assoc-each__ [m & kvs]
  (if (empty? kvs)
    m
    (list hamt-assoc-each__
      (list map-assoc m (first kvs) (second kvs))
      ~@(rest (rest kvs)))))
;;; tur-map-homog__ -- internal: compile-time homogeneity check (see vec.tur).
;;;
;;; Both parameters share one type variable, so a call with two
;;; differently-typed arguments is a TUR-E0001 at elaboration. No-op body,
;;; fixed arity (no allocation).

(defn tur-map-homog__ [A] [a :A b :A] :nil
  ```c (void)a; (void)b; ```)
;;; hamt-homog-chain__ -- internal: enforce homogeneous keys and values.
;;;
;;; kvs is k0 v0 k1 v1 ...  Chains tur-map-homog__ over adjacent keys and
;;; adjacent values so all keys unify to one type and all values to another.

(defmacro hamt-homog-chain__ [& kvs]
  (if (empty? kvs)
    0
    (if (empty? (rest (rest kvs)))
      0
      (list do
        (list tur-map-homog__ (first kvs) (first (rest (rest kvs))))
        (list do
          (list tur-map-homog__ (second kvs) (second (rest (rest kvs))))
          (list hamt-homog-chain__ ~@(rest (rest kvs))))))))
;;; hamt-of -- variadic Map literal: alternating key/value arguments.
;;;
;;; Parameters:
;;;   & kvs -- an even number of arguments, alternating key then value.
;;;            Keys are int-valued (the carrier map-assoc hashes by value);
;;;            the #map{...} data literal normalizes keyword/string keys to
;;;            their content hash before reaching this macro. Values may be
;;;            any scalar type V (:int, :cstr, :bool, :nil, :float) -- all
;;;            values must unify to a single V, and all keys to a single
;;;            (int) key type, else TUR-E0001 on the offending element.
;;;
;;; Returns:
;;;   A fresh Map populated with the given entries; later duplicate keys win.
;;;   map-get returns the value type V, so a non-int value is read with an
;;;   ascription, e.g. (:: (map-get m k k) :cstr).
;;;
;;; Note: this is the lowering target of the #map{...} data literal
;;;   (-Xdata-literals).  Writing #map{:a 1 :b 2} is preferred over calling
;;;   hamt-of directly.
;;;
;;; Example:
;;;   (hamt-of)            ; => empty Map
;;;   (hamt-of 1 10 2 20)  ; => Map {1 -> 10, 2 -> 20}
;;;
;;; Since: DL1 (data-literals-plan)

(defmacro hamt-of [& kvs]
  (if (empty? kvs)
    (list map-new)
    (list do
      (list hamt-homog-chain__ ~@kvs)
      (list hamt-assoc-each__ (list map-new) ~@kvs))))
