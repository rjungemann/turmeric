;;; tur/map -- typed Map[K V]: persistent hash map requiring Hash[K] and Eq[K].
;;;
;;; Backed by the persistent HAMT from tur/hamt.
;;;
;;; Since: Phase TM0
;; Phase TM0: Typed Map[K V]
;; K must satisfy Hash[K] and Eq[K].
;; Backed by the persistent HAMT (stdlib/hamt.tur).
;; At runtime, a Map[K V] is a heap-allocated wrapper around a HAMT ptr<void>.
;; Internal C layout: struct { void *hamt; }
;;; Map -- parameterized persistent map with key type K and value type V.
;;;
;;; Since: Phase TM0
(defstruct Map [K V] (hamt :ptr<void>))
;;; map-new -- create a new empty typed map.
;;;
;;; Returns:
;;;   An empty Map[K V].
;;;
;;; Example:
;;;   (map-new)  ; => empty Map
;;;
;;; Since: Phase TM0

(defn map-new []
  #{}
  :int
  ```c struct { void *hamt; } *m = malloc(sizeof(*m));
  m->hamt = tur_hamt_new();
  return (int64_t)(intptr_t)m;
  ```)
;;; map-hamt -- internal accessor for the HAMT backing store.

(defn map-hamt [m :int]
  #{}
  :ptr<void>
  ```c struct { void *hamt; } *map = (void*)(intptr_t)m;
  return map->hamt;
  ```)
;;; map-wrap -- internal constructor from a HAMT pointer.

(defn map-wrap [h :ptr<void>]
  #{}
  :int
  ```c struct { void *hamt; } *m = malloc(sizeof(*m));
  m->hamt = (void*)(intptr_t)h;
  return (int64_t)(intptr_t)m;
  ```)
;;; map-assoc -- insert or update a key/value pair; returns a new map.
;;;
;;; Parameters:
;;;   m   -- source Map[K V]
;;;   key -- key of type K (used as hash for scalar keys)
;;;   val -- value of type V
;;;
;;; Returns:
;;;   A new Map[K V] with the entry inserted or updated.
;;;
;;; Example:
;;;   (map-assoc my-map 1 100)  ; => updated map
;;;
;;; Since: Phase TM0

(defn map-assoc [V] [m :int key :int val :V]
  #{}
  :int
  ```c struct { void *hamt; } *map = (void*)(intptr_t)m;
  void *new_hamt = tur_hamt_set(map->hamt, (int64_t)key, (void*)(intptr_t)key, (void*)(intptr_t)val);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)
;;; map-assoc-h -- insert or update with an explicit hash; returns a new map.
;;;
;;; Parameters:
;;;   m   -- source Map[K V]
;;;   h   -- precomputed hash of key (from Hash[K] typeclass)
;;;   key -- key of type K
;;;   val -- value of type V
;;;
;;; Returns:
;;;   A new Map[K V] with the entry inserted or updated.
;;;
;;; Example:
;;;   (map-assoc-h my-map (hash k) k v)  ; => updated map
;;;
;;; Since: Phase TM0

(defn map-assoc-h [V] [m :int h :int key :int val :V]
  #{}
  :int
  ```c struct { void *hamt; } *map = (void*)(intptr_t)m;
  void *new_hamt = tur_hamt_set(map->hamt, h, (void*)(intptr_t)key, (void*)(intptr_t)val);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)
;;; map-dissoc -- remove a key from the map; returns a new map.
;;;
;;; Parameters:
;;;   m   -- source Map[K V]
;;;   h   -- precomputed hash of key
;;;   key -- key of type K
;;;
;;; Returns:
;;;   A new Map[K V] with the key removed.
;;;
;;; Example:
;;;   (map-dissoc my-map (hash k) k)  ; => map without k
;;;
;;; Since: Phase TM0

(defn map-dissoc [m :int h :int key :int]
  #{}
  :int
  ```c struct { void *hamt; } *map = (void*)(intptr_t)m;
  void *new_hamt = tur_hamt_del(map->hamt, h, (void*)(intptr_t)key);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)
;;; map-get -- look up a key; returns the value or 0 if absent.
;;;
;;; Parameters:
;;;   m   -- Map[K V]
;;;   h   -- precomputed hash of key
;;;   key -- key of type K
;;;
;;; Returns:
;;;   The value for the key, or 0 (none) if absent.
;;;
;;; Example:
;;;   (map-get my-map (hash k) k)  ; => value or 0
;;;
;;; Since: Phase TM0

(defn map-get [V] [m :int h :int key :int]
  #{}
  :V
  ```c struct { void *hamt; } *map = (void*)(intptr_t)m;
  return (int64_t)(intptr_t)tur_hamt_get(map->hamt, h, (void*)(intptr_t)key);
  ```)
;;; map-has? -- check whether a key exists in the map.
;;;
;;; Parameters:
;;;   m   -- Map[K V]
;;;   h   -- precomputed hash of key
;;;   key -- key of type K
;;;
;;; Returns:
;;;   true if the key is present, false otherwise.
;;;
;;; Example:
;;;   (map-has? my-map (hash k) k)  ; => true or false
;;;
;;; Since: Phase TM0

(defn map-has? [m :int h :int key :int]
  #{}
  :bool
  ```c struct { void *hamt; } *map = (void*)(intptr_t)m;
  return tur_hamt_has(map->hamt, h, (void*)(intptr_t)key);
  ```)
;;; map-count -- return the number of entries in the map.
;;;
;;; Parameters:
;;;   m -- Map[K V]
;;;
;;; Returns:
;;;   Integer count of key/value pairs.
;;;
;;; Example:
;;;   (map-count my-map)  ; => 3
;;;
;;; Since: Phase TM0

(defn map-count [m :int]
  #{}
  :int
  ```c struct { void *hamt; } *map = (void*)(intptr_t)m;
  return tur_hamt_count(map->hamt);
  ```)
;;; map-merge -- merge two maps; values from b win on key collision.
;;;
;;; Parameters:
;;;   a -- first Map[K V]
;;;   b -- second Map[K V] (wins on collision)
;;;
;;; Returns:
;;;   A new Map[K V] containing all entries from both maps.
;;;
;;; Example:
;;;   (map-merge map-a map-b)  ; => merged map
;;;
;;; Since: Phase TM0

(defn map-merge [a :int b :int]
  #{}
  :int
  ```c struct { void *hamt; } *ma = (void*)(intptr_t)a;
  struct { void *hamt; } *mb = (void*)(intptr_t)b;
  void *new_hamt = tur_hamt_merge(ma->hamt, mb->hamt);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)
;;; ============================================================================
;;; Content-keyed maps (TCE4)
;;;
;;; The plain map-assoc/map-get compare keys by identity (the key word is the
;;; key). That is right for :int keys but wrong for content-typed keys such as
;;; strings, where two distinct pointers may hold equal text. The *-eq family
;;; below takes an explicit hash and a key-equality closure, threaded into the
;;; runtime HAMT (tur_hamt_*_eq); the smap-* layer specializes them for :cstr
;;; keys. See docs/typed-collection-elements-plan.md (TCE4).
;;; ============================================================================

;;; cstr-hash -- xxHash64 of a NUL-terminated string's contents.
;;;
;;; Parameters:
;;;   s -- the string to hash
;;;
;;; Returns:
;;;   The 64-bit content hash, so equal text hashes equally regardless of
;;;   pointer identity.
;;;
;;; Example:
;;;   (cstr-hash "key")  ; => <stable content hash>
;;;
;;; Since: TCE4

(defn cstr-hash [s :cstr] :int
  ```c return (int64_t)tur_hamt_hash_str((const char *)(intptr_t)s); ```)
;;; tur-cstr-key-eq? -- internal: content equality of two string keys.

(defn tur-cstr-key-eq? [a :cstr b :cstr] :bool
  ```c const char *p = (const char *)(intptr_t)a;
  const char *q = (const char *)(intptr_t)b;
  while (*p && (*p == *q)) { p++; q++; }
  return *(const unsigned char *)p == *(const unsigned char *)q;
  ```)
;;; map-assoc-eq -- insert/update with an explicit hash and key-equality fn.
;;;
;;; Parameters:
;;;   m     -- source Map[K V]
;;;   h     -- precomputed content hash of key
;;;   key   -- key of type K
;;;   val   -- value of type V
;;;   keyeq -- a (fn [a :K b :K] :bool) used to compare keys that share a hash
;;;
;;; Returns:
;;;   A new Map[K V] with the entry inserted or updated. Keys that are equal
;;;   under keyeq (not just identical pointers) collapse to one entry.
;;;
;;; Example:
;;;   (map-assoc-eq m (cstr-hash k) k v tur-cstr-key-eq?)
;;;
;;; Since: TCE4

(defn map-assoc-eq [K V] [m :int h :int key :K val :V keyeq] :int
  ```c struct { void *hamt; } *map = (void *)(intptr_t)m;
  void *new_hamt = tur_hamt_set_eq(map->hamt, (uint64_t)h, (void *)(intptr_t)key,
                                   (void *)(intptr_t)val,
                                   (void *)(intptr_t)keyeq);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)
;;; map-get-eq -- look up a key using an explicit hash and key-equality fn.
;;;
;;; Parameters:
;;;   m     -- Map[K V]
;;;   h     -- precomputed content hash of key
;;;   key   -- key of type K
;;;   keyeq -- key comparison fn (see map-assoc-eq)
;;;
;;; Returns:
;;;   The value of type V, or 0 (none) if absent.
;;;
;;; Example:
;;;   (map-get-eq m (cstr-hash k) k tur-cstr-key-eq?)
;;;
;;; Since: TCE4

(defn map-get-eq [K V] [m :int h :int key :K keyeq] :V
  ```c struct { void *hamt; } *map = (void *)(intptr_t)m;
  return (int64_t)(intptr_t)tur_hamt_get_eq(map->hamt, (uint64_t)h,
                                            (void *)(intptr_t)key,
                                            (void *)(intptr_t)keyeq);
  ```)
;;; map-has-eq? -- key-existence test using an explicit hash and equality fn.
;;;
;;; Parameters:
;;;   m     -- Map[K V]
;;;   h     -- precomputed content hash of key
;;;   key   -- key of type K
;;;   keyeq -- key comparison fn (see map-assoc-eq)
;;;
;;; Returns:
;;;   true if the key is present under keyeq, false otherwise.
;;;
;;; Example:
;;;   (map-has-eq? m (cstr-hash k) k tur-cstr-key-eq?)  ; => true or false
;;;
;;; Since: TCE4

(defn map-has-eq? [K] [m :int h :int key :K keyeq] :bool
  ```c struct { void *hamt; } *map = (void *)(intptr_t)m;
  return tur_hamt_has_eq(map->hamt, (uint64_t)h, (void *)(intptr_t)key,
                         (void *)(intptr_t)keyeq);
  ```)
;;; map-dissoc-eq -- remove a key using an explicit hash and equality fn.
;;;
;;; Parameters:
;;;   m     -- source Map[K V]
;;;   h     -- precomputed content hash of key
;;;   key   -- key of type K
;;;   keyeq -- key comparison fn (see map-assoc-eq)
;;;
;;; Returns:
;;;   A new Map[K V] with the key removed.
;;;
;;; Example:
;;;   (map-dissoc-eq m (cstr-hash k) k tur-cstr-key-eq?)
;;;
;;; Since: TCE4

(defn map-dissoc-eq [K] [m :int h :int key :K keyeq] :int
  ```c struct { void *hamt; } *map = (void *)(intptr_t)m;
  void *new_hamt = tur_hamt_del_eq(map->hamt, (uint64_t)h, (void *)(intptr_t)key,
                                   (void *)(intptr_t)keyeq);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)
;;; smap-assoc -- string-keyed insert/update: Map[cstr V] by content.
;;;
;;; Parameters:
;;;   m   -- source Map[cstr V]
;;;   key -- string key (compared and hashed by content)
;;;   val -- value of type V
;;;
;;; Returns:
;;;   A new Map[cstr V]; a key equal in text to an existing one updates it,
;;;   even if the two strings are distinct pointers.
;;;
;;; Example:
;;;   (smap-assoc (map-new) "name" 1)  ; => Map {"name" -> 1}
;;;
;;; Since: TCE4

(defn smap-assoc [V] [m :int key :cstr val :V] :int
  (map-assoc-eq m (cstr-hash key) key val tur-cstr-key-eq?))
;;; smap-get -- string-keyed lookup by content; returns V or 0 if absent.
;;;
;;; Parameters:
;;;   m   -- Map[cstr V]
;;;   key -- string key (matched by content)
;;;
;;; Returns:
;;;   The value of type V, or 0 (none) if absent.
;;;
;;; Example:
;;;   (smap-get m "name")  ; => value or 0
;;;
;;; Since: TCE4

(defn smap-get [V] [m :int key :cstr] :V
  (map-get-eq m (cstr-hash key) key tur-cstr-key-eq?))
;;; smap-has? -- string-keyed existence test by content.
;;;
;;; Parameters:
;;;   m   -- Map[cstr V]
;;;   key -- string key (matched by content)
;;;
;;; Returns:
;;;   true if present, false otherwise.
;;;
;;; Example:
;;;   (smap-has? m "name")  ; => true or false
;;;
;;; Since: TCE4

(defn smap-has? [m :int key :cstr] :bool
  (map-has-eq? m (cstr-hash key) key tur-cstr-key-eq?))
;;; smap-dissoc -- string-keyed removal by content; returns a new map.
;;;
;;; Parameters:
;;;   m   -- source Map[cstr V]
;;;   key -- string key (matched by content)
;;;
;;; Returns:
;;;   A new Map[cstr V] with the key removed.
;;;
;;; Example:
;;;   (smap-dissoc m "name")  ; => map without "name"
;;;
;;; Since: TCE4

(defn smap-dissoc [m :int key :cstr] :int
  (map-dissoc-eq m (cstr-hash key) key tur-cstr-key-eq?))
;;; ============================================================================
;;; Wide map-key carrier (WKC -- float32-map-key-carrier-plan)
;;;
;;; The runtime *-eq HAMT carries a key as a single int64_t word and calls the
;;; comparator through bool(*)(int64_t,int64_t).  For a one-word key (:int,
;;; :bool, :cstr) the value rides that word losslessly.  A :float32 / :float
;;; key does NOT: binding it to the int64_t carrier numerically converts it
;;; (1.5 -> 1), and a bool(float,float) comparator invoked through the int64_t
;;; ABI reads the wrong registers.  Both bugs predate generic dispatch -- they
;;; are properties of the one-word carrier itself.
;;;
;;; MapKey fixes the carrier per key type, at the only place that knows K
;;; concretely -- a typeclass dispatched on a K-typed argument:
;;;
;;;   mk-box : K -> int64 carrier.  One-word keys: identity.  Float keys:
;;;            a *bit* reinterpret (memcpy of raw bytes via a union), never a
;;;            numeric conversion, so 1.5 survives intact.
;;;   mk-cmp : K -> a carrier-ABI comparator bool(int64,int64) (returned as a
;;;            raw function pointer).  Float comparators reinterpret each
;;;            carrier word back to the float and compare by value, so the
;;;            runtime's int64_t ABI is honored.
;;;
;;; (hash key) still runs on the unboxed K via Hash[K], so the hash word is
;;; unaffected.  The boxed form (mk-box) and the unbox in the comparator
;;; (mk-cmp) are chosen by the same K, so they always agree.  Dispatch is
;;; resolved at compile time and the float reinterprets are inlinable, so a
;;; one-word map keeps today's representation and cost.
;;;
;;; Scope: this covers inline scalar keys (one-word + float32 + float64).
;;; Multi-word struct/ADT keys would need a heap-boxed carrier owned by the
;;; map (a runtime-ownership change); that remains a separate follow-up.
;;; ============================================================================

;;; tur-int-carrier-eq? -- carrier comparator for one-word integral keys.
;;;
;;; Used for :int and :bool keys, whose carrier word IS the value, so plain
;;; integer equality on the two carrier words is the key equality.

(defn tur-int-carrier-eq? [a :int b :int] :bool (= a b))
;;; tur-f32-carrier-eq? -- carrier comparator for :float32 keys.
;;;
;;; Reinterprets each int64 carrier word's low 32 bits back to a float and
;;; compares by value (NaN never matches, as with =).

(defn tur-f32-carrier-eq? [a :int b :int] :bool
  ```c union { float f; int64_t i; } ua, ub;
  ua.i = a; ub.i = b;
  return ua.f == ub.f;
  ```)
;;; tur-f64-carrier-eq? -- carrier comparator for :float (float64) keys.
;;;
;;; Reinterprets each int64 carrier word back to a double and compares by value.

(defn tur-f64-carrier-eq? [a :int b :int] :bool
  ```c union { double f; int64_t i; } ua, ub;
  ua.i = a; ub.i = b;
  return ua.f == ub.f;
  ```)
;;; MapKey -- per-key-type carrier boxing + a carrier-ABI comparator.
;;;
;;; Parameters:
;;;   a -- the key type
;;;
;;; Since: WKC (float32-map-key-carrier-plan)
(defclass MapKey [a]
  (mk-box [x] :int)
  (mk-cmp [x] :int))
;;; MapKey [int] -- one-word identity carrier; integer-equality comparator.

(definstance MapKey [int]
  (mk-box [x] x)
  (mk-cmp [x] :int ```c return (int64_t)(intptr_t)tur_int_carrier_eq_; ```))
;;; MapKey [bool] -- one-word 0/1 carrier; integer-equality comparator.

(definstance MapKey [bool]
  (mk-box [x] (if x 1 0))
  (mk-cmp [x] :int ```c return (int64_t)(intptr_t)tur_int_carrier_eq_; ```))
;;; MapKey [cstr] -- pointer carrier; content-equality comparator.

(definstance MapKey [cstr]
  (mk-box [x] :int ```c return (int64_t)(intptr_t)x; ```)
  (mk-cmp [x] :int ```c return (int64_t)(intptr_t)tur_cstr_key_eq_; ```))
;;; MapKey [float32] -- bit-reinterpret carrier; float-value comparator.

(definstance MapKey [float32]
  (mk-box [x] :int ```c union { float f; int64_t i; } u; u.i = 0; u.f = x; return u.i; ```)
  (mk-cmp [x] :int ```c return (int64_t)(intptr_t)tur_f32_carrier_eq_; ```))
;;; MapKey [float] -- bit-reinterpret carrier (float64); double-value comparator.

(definstance MapKey [float]
  (mk-box [x] :int ```c union { double f; int64_t i; } u; u.f = x; return u.i; ```)
  (mk-cmp [x] :int ```c return (int64_t)(intptr_t)tur_f64_carrier_eq_; ```))
;;; ============================================================================
;;; Generic content-keyed maps (GHE3 -- generic-hash-eq-dispatch-plan; WKC carrier)
;;;
;;; The -g family routes ANY scalar key type through (Hash K) + (MapKey K) by a
;;; single constrained-generic code path: (hash key) selects the per-K hash
;;; instance, (mk-box key) boxes the key into the int64 carrier (a bit
;;; reinterpret for float keys, identity for one-word keys), and (mk-cmp key)
;;; supplies a carrier-ABI bool(int64,int64) comparator threaded into the
;;; runtime *-eq HAMT.  This unifies what smap-* did by hand for :cstr with a
;;; carrier-correct path for :int / :bool / :float32 / :float keys.
;;;
;;; Dispatch is resolved entirely at compile time per monomorphization, so a
;;; distinct-pointer :cstr key still matches by content and a :float32 key
;;; round-trips by value.  For :int keys mk-box is identity and the comparator
;;; is integer =, so the result matches the plain identity-keyed map-assoc.
;;; ============================================================================

;;; map-assoc-g -- generic content-keyed insert/update for any Hash/Eq key.
;;;
;;; Parameters:
;;;   m   -- source Map[K V]
;;;   key -- key of type K (must satisfy Hash[K] and MapKey[K]).
;;;          Inline float keys (:float32 / :float) are bit-reinterpreted into
;;;          the carrier and compared by value; one-word keys are unchanged.
;;;   val -- value of type V
;;;
;;; Returns:
;;;   A new Map[K V] with the entry inserted or updated. Keys equal under
;;;   Eq[K] (not just identical) collapse to one entry.
;;;
;;; Example:
;;;   (map-assoc-g (map-new) "name" 1)  ; => Map {"name" -> 1}, content-keyed
;;;   (map-assoc-g (map-new) 42 100)    ; => Map {42 -> 100}, identity-keyed
;;;
;;; Since: GHE3 (generic-hash-eq-dispatch-plan)

(defn map-assoc-g [^Hash K ^MapKey K V] [m :int key :K val :V] :int
  (map-assoc-eq m (hash key) (mk-box key) val (mk-cmp key)))
;;; map-get-g -- generic content-keyed lookup; returns V or 0 if absent.
;;;
;;; Parameters:
;;;   m   -- Map[K V]
;;;   key -- key of type K (must satisfy Hash[K] and MapKey[K]).
;;;          Inline float keys (:float32 / :float) are bit-reinterpreted into
;;;          the carrier and compared by value; one-word keys are unchanged.
;;;
;;; Returns:
;;;   The value of type V, or 0 (none) if absent.
;;;
;;; Example:
;;;   (map-get-g m "name")  ; => value or 0
;;;
;;; Since: GHE3 (generic-hash-eq-dispatch-plan)

(defn map-get-g [^Hash K ^MapKey K V] [m :int key :K] :V
  (map-get-eq m (hash key) (mk-box key) (mk-cmp key)))
;;; map-has-g? -- generic content-keyed existence test.
;;;
;;; Parameters:
;;;   m   -- Map[K V]
;;;   key -- key of type K (must satisfy Hash[K] and MapKey[K]).
;;;          Inline float keys (:float32 / :float) are bit-reinterpreted into
;;;          the carrier and compared by value; one-word keys are unchanged.
;;;
;;; Returns:
;;;   true if the key is present under Eq[K], false otherwise.
;;;
;;; Example:
;;;   (map-has-g? m "name")  ; => true or false
;;;
;;; Since: GHE3 (generic-hash-eq-dispatch-plan)

(defn map-has-g? [^Hash K ^MapKey K] [m :int key :K] :bool
  (map-has-eq? m (hash key) (mk-box key) (mk-cmp key)))
;;; map-dissoc-g -- generic content-keyed removal; returns a new map.
;;;
;;; Parameters:
;;;   m   -- source Map[K V]
;;;   key -- key of type K (must satisfy Hash[K] and MapKey[K]).
;;;          Inline float keys (:float32 / :float) are bit-reinterpreted into
;;;          the carrier and compared by value; one-word keys are unchanged.
;;;
;;; Returns:
;;;   A new Map[K V] with the key removed.
;;;
;;; Example:
;;;   (map-dissoc-g m "name")  ; => map without "name"
;;;
;;; Since: GHE3 (generic-hash-eq-dispatch-plan)

(defn map-dissoc-g [^Hash K ^MapKey K] [m :int key :K] :int
  (map-dissoc-eq m (hash key) (mk-box key) (mk-cmp key)))
;;; map-free -- free the Map wrapper (does not free HAMT; use map-free-all for that).
;;;
;;; Parameters:
;;;   m -- Map[K V] to free
;;;
;;; Example:
;;;   (map-free my-map)
;;;
;;; Since: Phase TM0

(defn map-free [m :int]
  #{}
  :void
  ```c free((void*)(intptr_t)m);
  ```)
;;; map-eq? -- compare two maps for structural equality using a value comparator.
;;;
;;; Parameters:
;;;   m1      -- first Map[K V]
;;;   m2      -- second Map[K V]
;;;   val-cmp -- comparator fn [a :int b :int] :bool applied to each value pair
;;;
;;; Returns:
;;;   true if both maps have identical keys and all corresponding values satisfy val-cmp.
;;;
;;; Example:
;;;   (map-eq? ma mb (fn [a b] (= a b)))  ; => true
;;;
;;; Since: Phase TM0

(defn map-eq? [m1 :int m2 :int val-cmp]
  #{}
  :bool
  ```c struct { void *hamt; } *map1 = (void*)(intptr_t)m1;
  struct { void *hamt; } *map2 = (void*)(intptr_t)m2;
  if (tur_hamt_count(map1->hamt) != tur_hamt_count(map2->hamt)) return false;
  uint64_t iter_buf[32];
  for (int __i = 0; __i < 32; __i++) iter_buf[__i] = 0;
  tur_hamt_iter_init((void*)iter_buf, map1->hamt);
  uint64_t hash_out;
  void *key_out = NULL, *val_out = NULL;
  while (tur_hamt_iter_next((void*)iter_buf, &hash_out, &key_out, &val_out)) {
      void *val_in_b = tur_hamt_get(map2->hamt, (int64_t)hash_out, key_out);
      if (!val_in_b) { tur_hamt_iter_free((void*)iter_buf); return false; }
      bool vals_eq = ((bool(*)(int64_t, int64_t))(intptr_t)val_cmp)(
          (int64_t)(intptr_t)val_out, (int64_t)(intptr_t)val_in_b);
      if (!vals_eq) { tur_hamt_iter_free((void*)iter_buf); return false; }
  }
  tur_hamt_iter_free((void*)iter_buf);
  return true;
  ```)
;;; Eq [Map] -- structural equality using the value type's Eq instance.
;; TM0-6: Phase PTC4 -- constrained Eq instance for Map[K V].
;; Constraints: (Eq K) ensures keys are comparable; (Eq V) uses integer equality.
;; Note: element comparison uses integer equality; correct for all primitive K/V.

(definstance Eq [Map] [(Eq K) (Eq V)]
  (eq? [x y] (map-eq? x y (fn [a b] (= a b)))))
;;; hamt-assoc-each__ -- internal helper for the hamt-of macro.
;;;
;;; Threads (map-assoc m k v) over the kv-pairs in xs, returning the final
;;; map.  Recursive: each step wraps the accumulator in one more map-assoc,
;;; so the last pair wins on duplicate keys.

(defmacro hamt-assoc-each__ [m & kvs]
  (if (empty? kvs)
    m
    (list hamt-assoc-each__
      (list map-assoc m (first kvs) (second kvs))
      ~@(rest (rest kvs)))))
;;; tur-map-homog__ -- internal: compile-time homogeneity check (see vec.tur).
;;;
;;; Both parameters share one type variable, so a call with two
;;; differently-typed arguments is a TUR-E0001 at elaboration. No-op body,
;;; fixed arity (no allocation).

(defn tur-map-homog__ [A] [a :A b :A] :nil
  ```c (void)a; (void)b; ```)
;;; hamt-homog-chain__ -- internal: enforce homogeneous keys and values.
;;;
;;; kvs is k0 v0 k1 v1 ...  Chains tur-map-homog__ over adjacent keys and
;;; adjacent values so all keys unify to one type and all values to another.

(defmacro hamt-homog-chain__ [& kvs]
  (if (empty? kvs)
    0
    (if (empty? (rest (rest kvs)))
      0
      (list do
        (list tur-map-homog__ (first kvs) (first (rest (rest kvs))))
        (list do
          (list tur-map-homog__ (second kvs) (second (rest (rest kvs))))
          (list hamt-homog-chain__ ~@(rest (rest kvs))))))))
;;; hamt-of -- variadic Map literal: alternating key/value arguments.
;;;
;;; Parameters:
;;;   & kvs -- an even number of arguments, alternating key then value.
;;;            Keys are int-valued (the carrier map-assoc hashes by value);
;;;            the #map{...} data literal normalizes keyword keys to their
;;;            content hash before reaching this macro. Values may be any
;;;            scalar type V (:int, :cstr, :bool, :nil, :float) -- all values
;;;            must unify to a single V, and all keys to a single (int) key
;;;            type, else TUR-E0001 on the offending element.
;;;
;;; Returns:
;;;   A fresh Map populated with the given entries; later duplicate keys win.
;;;   map-get returns the value type V, so a non-int value is read with an
;;;   ascription, e.g. (:: (map-get m k k) :cstr).
;;;
;;; Note: this is the lowering target of the #map{...} data literal
;;;   (-Xdata-literals).  Writing #map{:a 1 :b 2} is preferred over calling
;;;   hamt-of directly.
;;;
;;;   For *string* keys, prefer the content-keyed smap-of (the lowering target
;;;   of #map{"k" v ...}).  GMK2: a direct (hamt-of "k" v ...) whose leading
;;;   key is a string literal is rewritten to smap-of, so string keys are
;;;   always compared by content rather than by the identity-hash carrier.
;;;
;;; Example:
;;;   (hamt-of)            ; => empty Map
;;;   (hamt-of 1 10 2 20)  ; => Map {1 -> 10, 2 -> 20}
;;;
;;; Since: DL1 (data-literals-plan)

(defmacro hamt-of [& kvs]
  (if (empty? kvs)
    (list map-new)
    (list do
      (list hamt-homog-chain__ ~@kvs)
      (list hamt-assoc-each__ (list map-new) ~@kvs))))
;;; smap-assoc-each__ -- internal helper for the smap-of macro.
;;;
;;; Like hamt-assoc-each__, but threads smap-assoc (content-keyed :cstr keys)
;;; over the kv-pairs instead of the identity-keyed map-assoc.

(defmacro smap-assoc-each__ [m & kvs]
  (if (empty? kvs)
    m
    (list smap-assoc-each__
      (list smap-assoc m (first kvs) (second kvs))
      ~@(rest (rest kvs)))))
;;; smap-homog-chain__ -- internal: enforce homogeneous values for smap-of.
;;;
;;; Keys are pinned to :cstr by smap-assoc's signature, so only the values
;;; need a homogeneity chain: tur-map-homog__ over adjacent values forces
;;; every value to unify to one type V (a mixed literal is TUR-E0001).

(defmacro smap-homog-chain__ [& kvs]
  (if (empty? kvs)
    0
    (if (empty? (rest (rest kvs)))
      0
      (list do
        (list tur-map-homog__ (second kvs) (second (rest (rest kvs))))
        (list smap-homog-chain__ ~@(rest (rest kvs)))))))
;;; smap-of -- content-keyed string-map literal: alternating key/value args.
;;;
;;; Parameters:
;;;   & kvs -- an even number of arguments, alternating string key then value.
;;;            Keys are :cstr and compared by content (distinct pointers with
;;;            equal text are the same key), via the smap-* / *-eq HAMT layer.
;;;            Values may be any scalar type V; all values must unify to one V.
;;;
;;; Returns:
;;;   A fresh content-keyed Map populated with the given entries; later
;;;   duplicate keys win. Look entries up with smap-get / smap-has? /
;;;   smap-dissoc (which hash and compare keys by content).
;;;
;;; Note: this is the lowering target of the #map{"k" v ...} data literal when
;;;   every key is a string literal (-Xdata-literals). A direct
;;;   (hamt-of "k" v ...) call with a leading string key is also rewritten to
;;;   smap-of so string keys are always content-keyed.
;;;
;;; Example:
;;;   (smap-of)                  ; => empty Map
;;;   (smap-of "a" 1 "b" 2)      ; => Map {"a" -> 1, "b" -> 2}
;;;
;;; Since: GMK2 (generic-map-key-dispatch-plan)

(defmacro smap-of [& kvs]
  (if (empty? kvs)
    (list map-new)
    (list do
      (list smap-homog-chain__ ~@kvs)
      (list smap-assoc-each__ (list map-new) ~@kvs))))
