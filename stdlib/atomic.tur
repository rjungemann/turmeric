;;; tur/atomic -- atomic load/store/add/sub/swap/CAS on 64-bit integers.
;;;
;;; Thread-safe integer operations using C11 _Atomic semantics.
;;;
;;; Since: Phase T19
;; stdlib/atomic.tur -- Atomic integer operations (Phase T19)
;;
;; Provides atomic load/store/add/sub/swap/cas on 64-bit integers,
;; implemented using the __atomic_* GCC/Clang builtins in C blocks.
;; All operations use sequentially-consistent ordering by default.
;;
;; An "atomic" value is represented as an AtomicCell handle (a :ptr<void>
;; pointing to a heap-allocated int64_t cell).
;; ---- Opaque handle newtype (stdlib-opaque-handle-types-plan, Tier 3) ----
;; AtomicCell wraps the underlying :ptr<void> with a nominally distinct type so
;; the checker rejects passing an unrelated handle where an atomic cell is
;; expected. It lowers to :ptr<void> in the C ABI, so the inline-C bodies are
;; unchanged.
(defopaque AtomicCell :ptr<void>)
;;; atomic-new -- allocate a heap-based atomic int64 cell initialised to init.
;;;
;;; Parameters:
;;;   init -- initial integer value stored in the cell
;;;
;;; Returns:
;;;   An AtomicCell handle to the new atomic cell.
;;;
;;; Example:
;;;   (def a (atomic-new 0))  ; => AtomicCell holding 0
;;;
;;; Since: Phase T19

(defn atomic-new [init : int] : AtomicCell
  ```c
  int64_t *cell = (int64_t *)malloc(sizeof(int64_t));
  if (!cell) { fprintf(stderr, "atomic-new: out of memory\n"); abort(); }
  __atomic_store_n(cell, (int64_t)init, __ATOMIC_SEQ_CST);
  return (void *)(intptr_t)cell;
  ```)
;;; atomic-load -- atomically read the current value of the cell.
;;;
;;; Parameters:
;;;   p -- atomic cell pointer from atomic-new
;;;
;;; Returns:
;;;   The current int64 value (sequentially-consistent load).
;;;
;;; Example:
;;;   (atomic-load a)  ; => 0
;;;
;;; Since: Phase T19

(defn atomic-load [p : AtomicCell] : int
  ```c
  int64_t *cell = (int64_t *)p;
  return (int64_t)__atomic_load_n(cell, __ATOMIC_SEQ_CST);
  ```)
;;; atomic-store! -- atomically write v into the cell.
;;;
;;; Parameters:
;;;   p -- atomic cell pointer from atomic-new
;;;   v -- new value to store
;;;
;;; Since: Phase T19

(defn atomic-store! [p : AtomicCell v : int] : nil
  ```c
  int64_t *cell = (int64_t *)p;
  __atomic_store_n(cell, (int64_t)v, __ATOMIC_SEQ_CST);
  ```)
;;; atomic-add! -- atomically add delta and return the old value.
;;;
;;; Parameters:
;;;   p     -- atomic cell pointer from atomic-new
;;;   delta -- amount to add (may be negative)
;;;
;;; Returns:
;;;   The value of the cell before the addition.
;;;
;;; Example:
;;;   (atomic-add! a 5)  ; => old value; cell now holds old+5
;;;
;;; Since: Phase T19

(defn atomic-add! [p : AtomicCell delta : int] : int
  ```c
  int64_t *cell = (int64_t *)p;
  return (int64_t)__atomic_fetch_add(cell, (int64_t)delta, __ATOMIC_SEQ_CST);
  ```)
;;; atomic-sub! -- atomically subtract delta and return the old value.
;;;
;;; Parameters:
;;;   p     -- atomic cell pointer from atomic-new
;;;   delta -- amount to subtract
;;;
;;; Returns:
;;;   The value of the cell before the subtraction.
;;;
;;; Since: Phase T19

(defn atomic-sub! [p : AtomicCell delta : int] : int
  ```c
  int64_t *cell = (int64_t *)p;
  return (int64_t)__atomic_fetch_sub(cell, (int64_t)delta, __ATOMIC_SEQ_CST);
  ```)
;;; atomic-swap! -- atomically replace the cell value with new-val and return the old value.
;;;
;;; Parameters:
;;;   p       -- atomic cell pointer from atomic-new
;;;   new-val -- value to store
;;;
;;; Returns:
;;;   The value of the cell before the swap.
;;;
;;; Example:
;;;   (atomic-swap! a 99)  ; => old value; cell now holds 99
;;;
;;; Since: Phase T19

(defn atomic-swap! [p : AtomicCell new-val : int] : int
  ```c
  int64_t *cell = (int64_t *)p;
  int64_t tmp = (int64_t)new_val;
  return (int64_t)__atomic_exchange_n(cell, tmp, __ATOMIC_SEQ_CST);
  ```)
;;; atomic-cas! -- compare-and-swap: if cell == expected, set to desired and return true.
;;;
;;; Parameters:
;;;   p        -- atomic cell pointer from atomic-new
;;;   expected -- value to compare against
;;;   desired  -- value to store if comparison succeeds
;;;
;;; Returns:
;;;   true if the swap occurred, false if the current value differed from expected.
;;;
;;; Example:
;;;   (atomic-cas! a 0 1)  ; => true when cell held 0; cell now holds 1
;;;
;;; Since: Phase T19

(defn atomic-cas! [p : AtomicCell expected : int desired : int] : bool
  ```c
  int64_t *cell = (int64_t *)p;
  int64_t exp_v = (int64_t)expected;
  int64_t des_v = (int64_t)desired;
  return (int64_t)__atomic_compare_exchange_n(
      cell, &exp_v, des_v, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
  ```)
;;; atomic-free -- free an atomic cell allocated by atomic-new.
;;;
;;; Parameters:
;;;   p -- atomic cell pointer from atomic-new
;;;
;;; Since: Phase T19

(defn atomic-free [p : AtomicCell] : nil
  ```c
  free(p);
  ```)
