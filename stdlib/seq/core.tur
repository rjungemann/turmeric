;; stdlib/seq/core.tur -- Core Seq type and adapters (LZ0)
;;
;; Seq is a thin wrapper around a generator-producing thunk (fat closure).
;; Calling seq-iter on a Seq invokes the thunk, returning a fresh generator.
;;
;; Internal representation:
;;   Seq is a heap-allocated int64_t[1] whose single element holds the fat
;;   closure pointer.  All mk thunks MUST be capturing closures (fat closures)
;;   so that seq-iter can use the uniform fat-closure calling convention.
;;
;; Load gen.tur before this file to access gen-arr helpers used by seq-collect.
(load "stdlib/gen.tur")
;; -------------------------------------------------------------------
;; Seq struct
;; -------------------------------------------------------------------
;;; Seq -- a lazy sequence backed by a generator-producing thunk.
;;;
;;; The mk field holds a fat closure (int64_t) that, when called,
;;; returns a fresh void* generator.  Always create with seq-new.


(defstruct Seq [mk : int])
;; -------------------------------------------------------------------
;; Internal allocation and invocation
;; -------------------------------------------------------------------
;;; seq-new -- allocate a heap Seq wrapping a fat closure mk.
;;;
;;; Parameters:
;;;   mk -- a fat closure (int64_t) that produces a fresh generator when called
;;;
;;; Returns:
;;;   int64_t pointer to the heap-allocated Seq value.
;;;
;;; Example:
;;;   (seq-new (fn [] (gen [] (yield 1))))
;;;
;;; Since: LZ0


(defn seq-new [mk : int] : int
  ```c
  int64_t *s = (int64_t *)malloc(sizeof(int64_t));
  s[0] = mk;
  return (int64_t)(intptr_t)s;
  ```)
;;; seq-iter -- invoke the Seq factory to obtain a fresh generator.
;;;
;;; Parameters:
;;;   s -- int64_t pointer to a Seq (returned by seq-new)
;;;
;;; Returns:
;;;   void* pointer to a fresh generator for s.
;;;
;;; Example:
;;;   (let [g (seq-iter my-seq)] ...)
;;;
;;; Since: LZ0

(defn seq-iter [s : int] : ptr<void>
  ```c
  int64_t mk = ((int64_t *)(intptr_t)s)[0];
  int64_t *fat = (int64_t *)(intptr_t)mk;
  int64_t fn_ptr = fat[0];
  return ((void *(*)(void *))(intptr_t)fn_ptr)((void *)fat);
  ```)
;; -------------------------------------------------------------------
;; Generator driver helpers (operate on void* generator pointers)
;; -------------------------------------------------------------------
;;; seq-gen-done -- test whether a void* generator has been exhausted.
;;;
;;; Parameters:
;;;   g -- void* generator pointer returned by seq-iter
;;;
;;; Returns:
;;;   true if the generator's __state == -1 (done), false otherwise.
;;;
;;; Example:
;;;   (seq-gen-done g)  ; => false while values remain
;;;
;;; Since: LZ0


(defn seq-gen-done [g : ptr<void>] : bool
  ```c
  typedef struct { int32_t __state; void *(*__next_fn)(void *); } __seq_gen_hdr_t;
  return ((__seq_gen_hdr_t *)g)->__state == -1;
  ```)
;;; seq-gen-next -- advance a void* generator and return the next yield pointer.
;;;
;;; Parameters:
;;;   g -- void* generator pointer returned by seq-iter
;;;
;;; Returns:
;;;   void* pointer to the yielded int64_t value, or NULL if the generator
;;;   is now exhausted.  Test with seq-val-some? before calling seq-val-unwrap.
;;;
;;; Example:
;;;   (let [v (seq-gen-next g)]
;;;     (when (seq-val-some? v) (println (seq-val-unwrap v))))
;;;
;;; Since: LZ0

(defn seq-gen-next [g : ptr<void>] : ptr<void>
  ```c
  typedef struct { int32_t __state; void *(*__next_fn)(void *); } __seq_gen_hdr_t;
  return ((__seq_gen_hdr_t *)g)->__next_fn(g);
  ```)
;;; seq-val-some? -- test whether a yield pointer is non-NULL.
;;;
;;; Parameters:
;;;   v -- void* returned by seq-gen-next
;;;
;;; Returns:
;;;   true if v is non-NULL (a value was yielded).
;;;
;;; Example:
;;;   (seq-val-some? (seq-gen-next g))  ; => true while values remain
;;;
;;; Since: LZ0

(defn seq-val-some? [v : ptr<void>] : bool
  ```c
  return v != NULL;
  ```)
;;; seq-val-unwrap -- extract the int64_t value from a yield pointer.
;;;
;;; Parameters:
;;;   v -- a non-NULL void* returned by seq-gen-next
;;;
;;; Returns:
;;;   The int64_t value that was yielded.
;;;
;;; Example:
;;;   (seq-val-unwrap v)  ; => yielded integer
;;;
;;; Since: LZ0

(defn seq-val-unwrap [v : ptr<void>] : int
  ```c
  return *(int64_t *)v;
  ```)
;; -------------------------------------------------------------------
;; Core sequence adapters
;; -------------------------------------------------------------------
;;; seq-of -- construct a single-element Seq.
;;;
;;; Parameters:
;;;   v -- the single value to yield
;;;
;;; Returns:
;;;   A Seq that yields v exactly once.
;;;
;;; Example:
;;;   (let [s (seq-of 42)] ...)  ; yields 42 then done
;;;
;;; Since: LZ0


(defn seq-of [v : int] : int (seq-new (fn [] (gen [] (yield v)))))
;;; empty-seq -- construct a Seq that yields no values.
;;;
;;; Returns:
;;;   A Seq that is immediately exhausted.
;;;
;;; Example:
;;;   ;; seq-gen-done reports "ran to completion", so a freshly-created
;;;   ;; iterator is not done yet -- drive it once first. (An unstarted
;;;   ;; generator is never done; that holds for a non-empty Seq too.)
;;;   (let [g (seq-iter (empty-seq))] (let [_ (seq-gen-next g)] (seq-gen-done g)))  ; => true
;;;
;;; Since: LZ0

(defn empty-seq [] : int
  (let [_d 0]
    (seq-new (fn [] (let [_ignore _d] (gen [] (while false (yield 0))))))))
;; --- Vec helpers (no #fx{Unsafe} so usable inside gen bodies) ---
;;; seq-vec-len -- return the length of a vec without #fx{Unsafe}.
;;; seq-vec-get -- return element at index i in a vec without #fx{Unsafe}.


(defn seq-vec-len [v : int] : int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *vec = (void *)(intptr_t)v;
  return (int64_t)vec->len;
  ```)

(defn seq-vec-get [v : int i : int] : int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *vec = (void *)(intptr_t)v;
  return vec->data[i];
  ```)
;; --- List helpers (no #fx{Unsafe} so usable inside gen bodies) ---
;;; seq-list-nil? -- test whether a list is empty (NULL).
;;; seq-list-head -- return the value of the first Cons cell.
;;; seq-list-tail -- return the next pointer of the first Cons cell.


(defn seq-list-nil? [lst : int] : bool
  ```c
  return lst == 0;
  ```)

(defn seq-list-head [lst : int] : int
  ```c
  struct { int64_t value; int64_t next; } *cell = (void *)(intptr_t)lst;
  return cell->value;
  ```)

(defn seq-list-tail [lst : int] : int
  ```c
  struct { int64_t value; int64_t next; } *cell = (void *)(intptr_t)lst;
  return cell->next;
  ```)
;;; seq-from-vec -- construct a Seq that yields all elements of a vec.
;;;
;;; Parameters:
;;;   v -- int64_t pointer to a vec (from vec-new / vec-push!)
;;;
;;; Returns:
;;;   A Seq that yields each element of v in order.
;;;
;;; Example:
;;;   (let [v (vec-new)]
;;;     (vec-push! v 10)
;;;     (vec-push! v 20)
;;;     (let [s (seq-from-vec v)] ...))
;;;
;;; Since: LZ0

(defn seq-from-vec [v : int] : int
  (seq-new (fn []
             (let [^mut i
                   0]
               (gen []
                 (while (< i (seq-vec-len v))
                   (yield (seq-vec-get v i))
                   (set! i (+ i 1))))))))
;;; seq-from-list -- construct a Seq that yields all elements of a linked list.
;;;
;;; Parameters:
;;;   l -- int64_t head pointer to a singly-linked list (Cons cells)
;;;
;;; Returns:
;;;   A Seq that yields each element from head to tail.
;;;
;;; Example:
;;;   (let [lst (cons 1 (cons 2 (nil-value)))]
;;;     (let [s (seq-from-list lst)] ...))
;;;
;;; Since: LZ0

(defn seq-from-list [l : int] : int
  (seq-new (fn []
             (let [^mut node
                   l]
               (gen []
                 (while (not (seq-list-nil? node))
                   (yield (seq-list-head node))
                   (set! node (seq-list-tail node))))))))
;; -------------------------------------------------------------------
;; Iteration macros
;; -------------------------------------------------------------------
;;; seq-for-each -- call f with every value yielded by a Seq.
;;;
;;; Parameters:
;;;   f -- a one-argument callable applied to each yielded value
;;;   s -- a Seq expression
;;;
;;; Example:
;;;   (seq-for-each println my-seq)
;;;
;;; Since: LZ0


(defmacro seq-for-each [f s]
  (let [sv (gensym sv)
        gv (gensym gv)
        it (gensym it)]
    (list let
      (vec sv s gv (list seq-iter sv))
      (list while
        (list not (list seq-gen-done gv))
        (list let
          (vec it (list seq-gen-next gv))
          (list when (list seq-val-some? it) (list f (list seq-val-unwrap it))))))))
;;; seq-collect -- materialise all values of a Seq into a gen-arr array.
;;;
;;; Parameters:
;;;   s -- a Seq expression
;;;
;;; Returns:
;;;   A gen-arr (from gen-arr-new) containing all int64_t values.
;;;   Iterate with gen-arr-len and gen-arr-get.
;;;
;;; Example:
;;;   (let [arr (seq-collect my-seq)]
;;;     (println (gen-arr-len arr)))
;;;
;;; Since: LZ0

(defmacro seq-collect [s]
  (let [sv  (gensym sv)
        gv  (gensym gv)
        res (gensym res)
        it  (gensym it)]
    (list let
      (vec sv s gv (list seq-iter sv) res (list gen-arr-new))
      (list while
        (list not (list seq-gen-done gv))
        (list let
          (vec it (list seq-gen-next gv))
          (list when
            (list seq-val-some? it)
            (list gen-arr-push! res (list seq-val-unwrap it)))))
      res)))
