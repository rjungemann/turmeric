;;; tur/threadpool -- WorkQueue<T> and ThreadPool for task-based parallelism.
;;;
;;; WorkQueue is a thread-safe FIFO backed by a mutex and condvar.
;;;
;;; Since: Phase T20-B
;; stdlib/threadpool.tur -- WorkQueue<T> and ThreadPool (Phase T20-B and T20-D)
;;
;; WorkQueue: thread-safe FIFO queue backed by a mutex + condvar.
;;
;; Two variants:
;;   work-queue-new         — unbounded (grows as needed)
;;   work-queue-new-bounded — bounded ring-buffer; push blocks when full
;;
;; Both variants share the same opaque WorkQueueBlock handle (ptr<void>).
;; Items are int64_t values (the generic T is encoded as an integer handle).
;; A sentinel value INT64_MIN (returned by pop after close) signals shutdown.
;;
;; ThreadPool: fixed-size pool of worker threads (Phase T20-D).
;;
;; API:
;;   thread-pool-new        [n :int]                     -- ThreadPoolHandle
;;   thread-pool-submit     [tp :ThreadPoolHandle task_fn :ptr<void> task_arg :ptr<void>] -- FutureHandle
;;   thread-pool-shutdown   [tp :ThreadPoolHandle]       -- nil
;;   thread-pool-free       [tp :ThreadPoolHandle]       -- nil
;; =============================================================================
;; WorkQueue (Phase T20-B)
;; =============================================================================
;; ---- WorkQueueBlock layout ----
;; Unbounded: dynamic array (int64_t *buf, capacity doubles on resize)
;;   bounded == 0
;; Bounded: ring-buffer (fixed-size buf, head/tail wrap)
;;   bounded == cap
;; Both: mutex + not_full_cond + not_empty_cond + head + tail + count + cap + closed
;;
;; typedef struct {
;;     pthread_mutex_t  lock;
;;     pthread_cond_t   not_full;
;;     pthread_cond_t   not_empty;
;;     int64_t         *buf;
;;     int64_t          head;
;;     int64_t          tail;
;;     int64_t          count;
;;     int64_t          cap;      /* 0 = unbounded (dynamic); >0 = max items */
;;     int64_t          alloc;    /* allocated slots (for unbounded growth) */
;;     int              closed;   /* 1 after work-queue-close */
;; } WorkQueueBlock;
;; ---- Opaque handle newtypes (stdlib-opaque-handle-types-plan, Tier 1) ----
;; Each handle wraps the underlying :ptr<void> with a nominally distinct type so
;; the checker rejects mixing them up: a WorkQueueHandle cannot be passed where a
;; ThreadPoolHandle is expected, a static ThreadPoolHandle cannot be passed to the
;; dynamic-pool ops (the two pools have different block layouts), and a submitted
;; FutureHandle cannot be confused with the pool that produced it. All lower to
;; :ptr<void> in the C ABI, so the inline-C bodies are unchanged.
(defopaque WorkQueueHandle :ptr<void>)

(defopaque ThreadPoolHandle :ptr<void>)

(defopaque DynThreadPoolHandle :ptr<void>)

(defopaque FutureHandle :ptr<void>)
;;; work-queue-new -- create a new unbounded work queue that grows dynamically.
;;;
;;; Returns:
;;;   A WorkQueueHandle to the WorkQueueBlock.
;;;
;;; Example:
;;;   (let [q (work-queue-new)] ...)  ; => WorkQueueHandle
;;;
;;; Since: Phase T20-B

(defn work-queue-new [] : WorkQueueHandle
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } WorkQueueBlock;
  WorkQueueBlock *q = (WorkQueueBlock *)malloc(sizeof(WorkQueueBlock));
  if (!q) { fprintf(stderr, "work-queue-new: oom\n"); abort(); }
  pthread_mutex_init(&q->lock, NULL);
  pthread_cond_init(&q->not_full, NULL);
  pthread_cond_init(&q->not_empty, NULL);
  q->alloc = 16;
  q->buf = (int64_t *)malloc((size_t)q->alloc * sizeof(int64_t));
  if (!q->buf) { free(q); fprintf(stderr, "work-queue-new: buf oom\n"); abort(); }
  q->head = 0; q->tail = 0; q->count = 0; q->cap = 0; q->closed = 0;
  return (void *)(intptr_t)q;
  ```)
;;; work-queue-new-bounded -- create a new bounded work queue with a fixed capacity.
;;;
;;; Parameters:
;;;   cap -- maximum number of items the queue can hold; push blocks when full
;;;
;;; Returns:
;;;   A WorkQueueHandle to the WorkQueueBlock.
;;;
;;; Example:
;;;   (let [q (work-queue-new-bounded 64)] ...)  ; => WorkQueueHandle
;;;
;;; Since: Phase T20-B

(defn work-queue-new-bounded [cap : int] : WorkQueueHandle
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } WorkQueueBlock;
  if (cap <= 0) { fprintf(stderr, "work-queue-new-bounded: cap must be > 0\n"); abort(); }
  WorkQueueBlock *q = (WorkQueueBlock *)malloc(sizeof(WorkQueueBlock));
  if (!q) { fprintf(stderr, "work-queue-new-bounded: oom\n"); abort(); }
  pthread_mutex_init(&q->lock, NULL);
  pthread_cond_init(&q->not_full, NULL);
  pthread_cond_init(&q->not_empty, NULL);
  q->buf = (int64_t *)malloc((size_t)cap * sizeof(int64_t));
  if (!q->buf) { free(q); fprintf(stderr, "work-queue-new-bounded: buf oom\n"); abort(); }
  q->head = 0; q->tail = 0; q->count = 0; q->cap = (int64_t)cap; q->alloc = (int64_t)cap; q->closed = 0;
  return (void *)(intptr_t)q;
  ```)
;;; work-queue-push -- push a value onto the work queue, blocking if the queue is bounded and full.
;;;
;;; Parameters:
;;;   q -- queue handle returned by work-queue-new or work-queue-new-bounded
;;;   v -- int64_t value to enqueue
;;;
;;; Example:
;;;   (work-queue-push q 42)
;;;
;;; Since: Phase T20-B

(defn work-queue-push [q : WorkQueueHandle v : int] : nil
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } WorkQueueBlock;
  WorkQueueBlock *wq = (WorkQueueBlock *)q;
  pthread_mutex_lock(&wq->lock);
  if (wq->closed) { pthread_mutex_unlock(&wq->lock); return; }
  if (wq->cap > 0) {
      while (wq->count == wq->cap && !wq->closed)
          pthread_cond_wait(&wq->not_full, &wq->lock);
      if (wq->closed) { pthread_mutex_unlock(&wq->lock); return; }
      wq->buf[wq->tail] = (int64_t)v;
      wq->tail = (wq->tail + 1) % wq->cap;
  } else {
      if (wq->count == wq->alloc) {
          int64_t new_alloc = wq->alloc * 2;
          int64_t *new_buf = (int64_t *)malloc((size_t)new_alloc * sizeof(int64_t));
          if (!new_buf) { pthread_mutex_unlock(&wq->lock); fprintf(stderr, "work-queue-push: oom\n"); abort(); }
          for (int64_t i = 0; i < wq->count; i++)
              new_buf[i] = wq->buf[(wq->head + i) % wq->alloc];
          free(wq->buf);
          wq->buf = new_buf; wq->head = 0; wq->tail = wq->count; wq->alloc = new_alloc;
      }
      wq->buf[wq->tail] = (int64_t)v;
      wq->tail = (wq->tail + 1) % wq->alloc;
  }
  wq->count++;
  pthread_cond_signal(&wq->not_empty);
  pthread_mutex_unlock(&wq->lock);
  ```)
;;; work-queue-pop -- pop a value from the work queue, blocking until one is available.
;;;
;;; Parameters:
;;;   q -- queue handle returned by work-queue-new or work-queue-new-bounded
;;;
;;; Returns:
;;;   The next int64_t value, or INT64_MIN if the queue is closed and empty.
;;;
;;; Example:
;;;   (work-queue-pop q)  ; => int (INT64_MIN signals shutdown)
;;;
;;; Since: Phase T20-B

(defn work-queue-pop [q : WorkQueueHandle] : int
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } WorkQueueBlock;
  #define WQ_CLOSED_SENTINEL INT64_MIN
  WorkQueueBlock *wq = (WorkQueueBlock *)q;
  pthread_mutex_lock(&wq->lock);
  while (wq->count == 0 && !wq->closed)
      pthread_cond_wait(&wq->not_empty, &wq->lock);
  if (wq->count == 0) {
      pthread_mutex_unlock(&wq->lock);
      return (int64_t)WQ_CLOSED_SENTINEL;
  }
  int64_t val = wq->buf[wq->head];
  int64_t mod = (wq->cap > 0) ? wq->cap : wq->alloc;
  wq->head = (wq->head + 1) % mod;
  wq->count--;
  pthread_cond_signal(&wq->not_full);
  pthread_mutex_unlock(&wq->lock);
  return val;
  ```)
;;; work-queue-close -- close the work queue, waking all blocked producers and consumers.
;;;
;;; Parameters:
;;;   q -- queue handle returned by work-queue-new or work-queue-new-bounded
;;;
;;; Example:
;;;   (work-queue-close q)
;;;
;;; Since: Phase T20-B

(defn work-queue-close [q : WorkQueueHandle] : nil
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } WorkQueueBlock;
  WorkQueueBlock *wq = (WorkQueueBlock *)q;
  pthread_mutex_lock(&wq->lock);
  wq->closed = 1;
  pthread_cond_broadcast(&wq->not_empty);
  pthread_cond_broadcast(&wq->not_full);
  pthread_mutex_unlock(&wq->lock);
  ```)
;;; work-queue-free -- destroy a work queue and release all associated memory.
;;;
;;; Parameters:
;;;   q -- queue handle returned by work-queue-new or work-queue-new-bounded
;;;
;;; Example:
;;;   (work-queue-free q)
;;;
;;; Since: Phase T20-B

(defn work-queue-free [q : WorkQueueHandle] : nil
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } WorkQueueBlock;
  WorkQueueBlock *wq = (WorkQueueBlock *)q;
  pthread_mutex_destroy(&wq->lock);
  pthread_cond_destroy(&wq->not_full);
  pthread_cond_destroy(&wq->not_empty);
  free(wq->buf);
  free(wq);
  ```)
;; =============================================================================
;; ThreadPool (Phase T20-D)
;; =============================================================================
;; ThreadPoolTask layout (stored as int64_t in the internal queue):
;;   void *(*fn)(void *)  - function to execute
;;   void *arg            - argument to pass
;;   void *promise_cell   - FutureCell* (from stdlib/future.tur layout)
;;
;; FutureCell layout:
;;   pthread_mutex_t lock
;;   pthread_cond_t ready
;;   int64_t value
;;   int64_t exn
;;   bool is_set
;;   bool is_ok
;;; tp-worker -- internal worker thread function for a fixed ThreadPool.
;;;
;;; Parameters:
;;;   arg -- ptr<void> pointing to the ThreadPoolBlock
;;;
;;; Returns:
;;;   NULL on exit.
;;;
;;; Since: Phase T20-D
;; Worker thread function: pops tasks and executes them.


(defn tp-worker [arg : ptr<void>] : ptr<void>
  ```c
  typedef struct {
      void *queue;
      pthread_t *threads;
      int64_t n_threads;
      volatile int stop_flag;
  } ThreadPoolBlock;
  ThreadPoolBlock *tp = (ThreadPoolBlock *)arg;

  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } TPQueueBlock;
  TPQueueBlock *q = (TPQueueBlock *)tp->queue;

  typedef struct {
      void *(*fn)(void *);
      void *arg;
      void *promise_cell;
  } ThreadPoolTask;

  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t ready;
      int64_t value;
      int64_t exn;
      bool is_set;
      bool is_ok;
  } FutureCell;

  #define TP_CLOSED_SENTINEL INT64_MIN

  while (1) {
      int64_t task_ptr;
      pthread_mutex_lock(&q->lock);
      while (q->count == 0 && !q->closed)
          pthread_cond_wait(&q->not_empty, &q->lock);
      if (q->count == 0 && q->closed) {
          pthread_mutex_unlock(&q->lock);
          break;
      }
      task_ptr = q->buf[q->head];
      int64_t mod = (q->cap > 0) ? q->cap : q->alloc;
      q->head = (q->head + 1) % mod;
      q->count--;
      pthread_cond_signal(&q->not_full);
      pthread_mutex_unlock(&q->lock);

      if (task_ptr == TP_CLOSED_SENTINEL || task_ptr == 0) {
          break;
      }

      ThreadPoolTask *task = (ThreadPoolTask *)(uintptr_t)task_ptr;
      void *result = task->fn(task->arg);

      FutureCell *fc = (FutureCell *)task->promise_cell;
      pthread_mutex_lock(&fc->lock);
      if (!fc->is_set) {
          fc->value = (int64_t)(uintptr_t)result;
          fc->is_set = true;
          fc->is_ok = true;
          pthread_cond_broadcast(&fc->ready);
      }
      pthread_mutex_unlock(&fc->lock);

      free(task);
  }
  return NULL;
  ```)
;;; thread-pool-new -- create a fixed-size thread pool with n worker threads.
;;;
;;; Parameters:
;;;   n -- number of worker threads to spawn (must be > 0)
;;;
;;; Returns:
;;;   A ThreadPoolHandle to the ThreadPoolBlock.
;;;
;;; Example:
;;;   (let [tp (thread-pool-new 4)] ...)  ; => ThreadPoolHandle
;;;
;;; Since: Phase T20-D
;; Create a new ThreadPool with n worker threads.

(defn thread-pool-new [n : int] : ThreadPoolHandle
  ```c
  if (n <= 0) { fprintf(stderr, "thread-pool-new: n must be > 0\n"); abort(); }

  typedef struct {
      void *queue;
      pthread_t *threads;
      int64_t n_threads;
      volatile int stop_flag;
  } ThreadPoolBlock;
  ThreadPoolBlock *tp = (ThreadPoolBlock *)malloc(sizeof(ThreadPoolBlock));
  if (!tp) { fprintf(stderr, "thread-pool-new: oom\n"); abort(); }
  tp->n_threads = (int64_t)n;
  tp->stop_flag = 0;

  /* Create internal unbounded queue */
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } TPQueueBlock;
  TPQueueBlock *q = (TPQueueBlock *)malloc(sizeof(TPQueueBlock));
  if (!q) { free(tp); fprintf(stderr, "thread-pool-new: q oom\n"); abort(); }
  pthread_mutex_init(&q->lock, NULL);
  pthread_cond_init(&q->not_full, NULL);
  pthread_cond_init(&q->not_empty, NULL);
  q->alloc = 16;
  q->buf = (int64_t *)malloc((size_t)q->alloc * sizeof(int64_t));
  if (!q->buf) {
      pthread_mutex_destroy(&q->lock);
      pthread_cond_destroy(&q->not_full);
      pthread_cond_destroy(&q->not_empty);
      free(q); free(tp);
      fprintf(stderr, "thread-pool-new: buf oom\n"); abort();
  }
  q->head = 0; q->tail = 0; q->count = 0; q->cap = 0; q->closed = 0;
  tp->queue = (void *)q;

  tp->threads = (pthread_t *)malloc((size_t)n * sizeof(pthread_t));
  if (!tp->threads) {
      free(q->buf);
      pthread_mutex_destroy(&q->lock);
      pthread_cond_destroy(&q->not_full);
      pthread_cond_destroy(&q->not_empty);
      free(q); free(tp);
      fprintf(stderr, "thread-pool-new: threads oom\n"); abort();
  }

  for (int i = 0; i < n; i++) {
      int rc = pthread_create(&tp->threads[i], NULL, (void *(*)(void *))tp_hyworker, (void *)tp);
      if (rc != 0) {
          fprintf(stderr, "thread-pool-new: pthread_create failed (%d)\n", rc);
          abort();
      }
  }

  return (void *)(intptr_t)tp;
  ```)
;;; thread-pool-submit -- submit a task to the thread pool and return a Future.
;;;
;;; Parameters:
;;;   tp       -- thread pool handle returned by thread-pool-new
;;;   task_fn  -- C function pointer (void *(*)(void *)) to execute on a worker
;;;   task_arg -- opaque argument forwarded to task_fn
;;;
;;; Returns:
;;;   A FutureHandle to a FutureCell that is fulfilled with task_fn's return value.
;;;
;;; Example:
;;;   (let [fut (thread-pool-submit tp my-fn arg)] ...)  ; => FutureHandle
;;;
;;; Since: Phase T20-D
;; Submit a task to the thread pool. Returns a Future cell (FutureHandle).
;; task_fn is a C function: void *(*)(void *)
;; The return value from task_fn is stored as the Future result.

(defn thread-pool-submit [tp : ThreadPoolHandle
                          task_fn : ptr<void>
                          task_arg : ptr<void>] : FutureHandle
  ```c
  typedef struct {
      void *queue;
      pthread_t *threads;
      int64_t n_threads;
      volatile int stop_flag;
  } ThreadPoolBlock;
  ThreadPoolBlock *pool = (ThreadPoolBlock *)tp;

  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; } FutureCell;
  FutureCell *fc = (FutureCell *)malloc(sizeof(FutureCell));
  if (!fc) { fprintf(stderr, "thread-pool-submit: fc oom\n"); abort(); }
  pthread_mutex_init(&fc->lock, NULL);
  pthread_cond_init(&fc->ready, NULL);
  fc->is_set = false; fc->is_ok = false; fc->value = 0; fc->exn = 0;

  typedef struct { void *(*fn)(void *); void *arg; void *promise_cell; } ThreadPoolTask;
  ThreadPoolTask *task = (ThreadPoolTask *)malloc(sizeof(ThreadPoolTask));
  if (!task) {
      pthread_mutex_destroy(&fc->lock);
      pthread_cond_destroy(&fc->ready);
      free(fc);
      fprintf(stderr, "thread-pool-submit: task oom\n"); abort();
  }
  task->fn = (void *(*)(void *))task_fn;
  task->arg = task_arg;
  task->promise_cell = (void *)fc;

  /* Push to internal queue */
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } TPQueueBlock;
  TPQueueBlock *q = (TPQueueBlock *)pool->queue;
  pthread_mutex_lock(&q->lock);
  if (q->cap > 0) {
      while (q->count == q->cap && !q->closed)
          pthread_cond_wait(&q->not_full, &q->lock);
      if (q->closed) { pthread_mutex_unlock(&q->lock); free(task); free(fc); return NULL; }
      q->buf[q->tail] = (int64_t)(uintptr_t)task;
      q->tail = (q->tail + 1) % q->cap;
  } else {
      if (q->count == q->alloc) {
          int64_t new_alloc = q->alloc * 2;
          int64_t *new_buf = (int64_t *)malloc((size_t)new_alloc * sizeof(int64_t));
          if (!new_buf) { pthread_mutex_unlock(&q->lock); free(task); free(fc); fprintf(stderr, "submit: grow oom\n"); abort(); }
          for (int64_t i = 0; i < q->count; i++)
              new_buf[i] = q->buf[(q->head + i) % q->alloc];
          free(q->buf);
          q->buf = new_buf; q->head = 0; q->tail = q->count; q->alloc = new_alloc;
      }
      q->buf[q->tail] = (int64_t)(uintptr_t)task;
      q->tail = (q->tail + 1) % q->alloc;
  }
  q->count++;
  pthread_cond_signal(&q->not_empty);
  pthread_mutex_unlock(&q->lock);

  return (void *)(intptr_t)fc;
  ```)
;;; thread-pool-shutdown -- signal all workers to stop and join them.
;;;
;;; Parameters:
;;;   tp -- thread pool handle returned by thread-pool-new
;;;
;;; Example:
;;;   (thread-pool-shutdown tp)
;;;
;;; Since: Phase T20-D
;; Signal all workers to stop and join them.

(defn thread-pool-shutdown [tp : ThreadPoolHandle] : nil
  ```c
  typedef struct {
      void *queue;
      pthread_t *threads;
      int64_t n_threads;
      volatile int stop_flag;
  } ThreadPoolBlock;
  ThreadPoolBlock *pool = (ThreadPoolBlock *)tp;

  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } TPQueueBlock;
  TPQueueBlock *q = (TPQueueBlock *)pool->queue;
  pthread_mutex_lock(&q->lock);
  q->closed = 1;
  pthread_cond_broadcast(&q->not_empty);
  pthread_cond_broadcast(&q->not_full);
  pthread_mutex_unlock(&q->lock);

  for (int64_t i = 0; i < pool->n_threads; i++) {
      pthread_join(pool->threads[i], NULL);
  }
  ```)
;;; thread-pool-free -- free the thread pool (must be called after shutdown).
;;;
;;; Parameters:
;;;   tp -- thread pool handle returned by thread-pool-new
;;;
;;; Example:
;;;   (thread-pool-free tp)
;;;
;;; Since: Phase T20-D
;; Free the ThreadPool (must be called after shutdown).

(defn thread-pool-free [tp : ThreadPoolHandle] : nil
  ```c
  typedef struct {
      void *queue;
      pthread_t *threads;
      int64_t n_threads;
      volatile int stop_flag;
  } ThreadPoolBlock;
  ThreadPoolBlock *pool = (ThreadPoolBlock *)tp;

  free(pool->threads);

  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } TPQueueBlock;
  TPQueueBlock *q = (TPQueueBlock *)pool->queue;
  pthread_mutex_destroy(&q->lock);
  pthread_cond_destroy(&q->not_full);
  pthread_cond_destroy(&q->not_empty);
  free(q->buf);
  free(q);
  free(pool);
  ```)
;; =============================================================================
;; Dynamic ThreadPool (Phase T20-D — auto-scaling)
;; =============================================================================
;;; thread-pool-new-dynamic -- create an auto-scaling thread pool between min and max threads.
;;;
;;; Parameters:
;;;   min_threads -- initial number of worker threads to spawn (must be > 0)
;;;   max_threads -- upper bound on workers; new threads are added when all are busy
;;;
;;; Returns:
;;;   A DynThreadPoolHandle to the DynThreadPoolBlock.
;;;
;;; Example:
;;;   (let [tp (thread-pool-new-dynamic 2 8)] ...)  ; => DynThreadPoolHandle
;;;
;;; Since: Phase T20-D
;; Create a dynamically-scaling ThreadPool with min_threads and max_threads.
;; Starts with min_threads workers, scales up to max_threads when all are busy.


(defn thread-pool-new-dynamic [min_threads : int max_threads : int] : DynThreadPoolHandle
  ```c
  if (min_threads <= 0 || max_threads < min_threads) {
      fprintf(stderr, "thread-pool-new-dynamic: 0 < min_threads <= max_threads required\n");
      abort();
  }

  typedef struct {
      void *queue;
      pthread_t *threads;
      int64_t n_threads;
      int64_t max_threads;
      volatile int64_t idle_count;
      volatile int stop_flag;
  } DynThreadPoolBlock;
  DynThreadPoolBlock *tp = (DynThreadPoolBlock *)malloc(sizeof(DynThreadPoolBlock));
  if (!tp) { fprintf(stderr, "thread-pool-new-dynamic: tp oom\n"); abort(); }
  tp->n_threads = 0;
  tp->max_threads = (int64_t)max_threads;
  tp->idle_count = 0;
  tp->stop_flag = 0;

  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } TPQueueBlock;
  TPQueueBlock *q = (TPQueueBlock *)malloc(sizeof(TPQueueBlock));
  if (!q) { free(tp); fprintf(stderr, "thread-pool-new-dynamic: q oom\n"); abort(); }
  pthread_mutex_init(&q->lock, NULL);
  pthread_cond_init(&q->not_full, NULL);
  pthread_cond_init(&q->not_empty, NULL);
  q->alloc = 16;
  q->buf = (int64_t *)malloc((size_t)q->alloc * sizeof(int64_t));
  if (!q->buf) {
      pthread_mutex_destroy(&q->lock);
      pthread_cond_destroy(&q->not_full);
      pthread_cond_destroy(&q->not_empty);
      free(q); free(tp);
      fprintf(stderr, "thread-pool-new-dynamic: buf oom\n"); abort();
  }
  q->head = 0; q->tail = 0; q->count = 0; q->cap = 0; q->closed = 0;
  tp->queue = (void *)q;

  tp->threads = (pthread_t *)malloc((size_t)max_threads * sizeof(pthread_t));
  if (!tp->threads) {
      free(q->buf);
      pthread_mutex_destroy(&q->lock);
      pthread_cond_destroy(&q->not_full);
      pthread_cond_destroy(&q->not_empty);
      free(q); free(tp);
      fprintf(stderr, "thread-pool-new-dynamic: threads oom\n"); abort();
  }

  for (int i = 0; i < min_threads; i++) {
      int rc = pthread_create(&tp->threads[tp->n_threads++], NULL, (void *(*)(void *))tp_hydyn_hyworker, (void *)tp);
      if (rc != 0) {
          fprintf(stderr, "thread-pool-new-dynamic: pthread_create failed (%d)\n", rc);
          abort();
      }
  }

  return (void *)(intptr_t)tp;
  ```)
;;; tp-dyn-worker -- internal worker thread function for a dynamic ThreadPool.
;;;
;;; Parameters:
;;;   arg -- ptr<void> pointing to the DynThreadPoolBlock
;;;
;;; Returns:
;;;   NULL on exit.
;;;
;;; Since: Phase T20-D
;; Worker for dynamic thread pool.

(defn tp-dyn-worker [arg : ptr<void>] : ptr<void>
  ```c
  typedef struct {
      void *queue;
      pthread_t *threads;
      int64_t n_threads;
      int64_t max_threads;
      volatile int64_t idle_count;
      volatile int stop_flag;
  } DynThreadPoolBlock;
  DynThreadPoolBlock *tp = (DynThreadPoolBlock *)arg;

  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } TPQueueBlock;
  TPQueueBlock *q = (TPQueueBlock *)tp->queue;

  typedef struct {
      void *(*fn)(void *);
      void *arg;
      void *promise_cell;
  } ThreadPoolTask;

  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t ready;
      int64_t value;
      int64_t exn;
      bool is_set;
      bool is_ok;
  } FutureCell;

  #define TP_CLOSED_SENTINEL INT64_MIN

  pthread_mutex_lock(&q->lock);
  tp->idle_count++;
  pthread_cond_broadcast(&q->not_empty);
  pthread_mutex_unlock(&q->lock);

  while (1) {
      int64_t task_ptr;
      pthread_mutex_lock(&q->lock);
      while (q->count == 0 && !q->closed)
          pthread_cond_wait(&q->not_empty, &q->lock);
      if (q->count == 0 && q->closed) {
          pthread_mutex_unlock(&q->lock);
          break;
      }
      task_ptr = q->buf[q->head];
      int64_t mod = (q->cap > 0) ? q->cap : q->alloc;
      q->head = (q->head + 1) % mod;
      q->count--;
      tp->idle_count--;
      pthread_cond_signal(&q->not_full);
      pthread_mutex_unlock(&q->lock);

      if (task_ptr == TP_CLOSED_SENTINEL || task_ptr == 0) break;

      ThreadPoolTask *task = (ThreadPoolTask *)(uintptr_t)task_ptr;
      void *result = task->fn(task->arg);

      FutureCell *fc = (FutureCell *)task->promise_cell;
      pthread_mutex_lock(&fc->lock);
      if (!fc->is_set) {
          fc->value = (int64_t)(uintptr_t)result;
          fc->is_set = true;
          fc->is_ok = true;
          pthread_cond_broadcast(&fc->ready);
      }
      pthread_mutex_unlock(&fc->lock);

      free(task);

      pthread_mutex_lock(&q->lock);
      tp->idle_count++;
      pthread_cond_broadcast(&q->not_empty);
      pthread_mutex_unlock(&q->lock);
  }

  tp->idle_count--;
  return NULL;
  ```)
;;; thread-pool-dynamic-submit -- submit a task to the dynamic thread pool, scaling up if needed.
;;;
;;; Parameters:
;;;   tp       -- dynamic thread pool handle returned by thread-pool-new-dynamic
;;;   task_fn  -- C function pointer (void *(*)(void *)) to execute on a worker
;;;   task_arg -- opaque argument forwarded to task_fn
;;;
;;; Returns:
;;;   A FutureHandle to a FutureCell fulfilled with task_fn's return value.
;;;
;;; Example:
;;;   (let [fut (thread-pool-dynamic-submit tp my-fn arg)] ...)  ; => FutureHandle
;;;
;;; Since: Phase T20-D
;; Submit a task to the dynamic thread pool. Returns a Future cell.

(defn thread-pool-dynamic-submit [tp : DynThreadPoolHandle
                                  task_fn : ptr<void>
                                  task_arg : ptr<void>] : FutureHandle
  ```c
  typedef struct {
      void *queue;
      pthread_t *threads;
      int64_t n_threads;
      int64_t max_threads;
      volatile int64_t idle_count;
      volatile int stop_flag;
  } DynThreadPoolBlock;
  DynThreadPoolBlock *pool = (DynThreadPoolBlock *)tp;

  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; } FutureCell;
  FutureCell *fc = (FutureCell *)malloc(sizeof(FutureCell));
  if (!fc) { fprintf(stderr, "thread-pool-dynamic-submit: fc oom\n"); abort(); }
  pthread_mutex_init(&fc->lock, NULL);
  pthread_cond_init(&fc->ready, NULL);
  fc->is_set = false; fc->is_ok = false; fc->value = 0; fc->exn = 0;

  typedef struct { void *(*fn)(void *); void *arg; void *promise_cell; } ThreadPoolTask;
  ThreadPoolTask *task = (ThreadPoolTask *)malloc(sizeof(ThreadPoolTask));
  if (!task) {
      pthread_mutex_destroy(&fc->lock);
      pthread_cond_destroy(&fc->ready);
      free(fc);
      fprintf(stderr, "thread-pool-dynamic-submit: task oom\n"); abort();
  }
  task->fn = (void *(*)(void *))task_fn;
  task->arg = task_arg;
  task->promise_cell = (void *)fc;

  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } TPQueueBlock;
  TPQueueBlock *q = (TPQueueBlock *)pool->queue;
  pthread_mutex_lock(&q->lock);
  if (q->cap > 0) {
      while (q->count == q->cap && !q->closed)
          pthread_cond_wait(&q->not_full, &q->lock);
      if (q->closed) { pthread_mutex_unlock(&q->lock); free(task); free(fc); return NULL; }
      q->buf[q->tail] = (int64_t)(uintptr_t)task;
      q->tail = (q->tail + 1) % q->cap;
  } else {
      if (q->count == q->alloc) {
          int64_t new_alloc = q->alloc * 2;
          int64_t *new_buf = (int64_t *)malloc((size_t)new_alloc * sizeof(int64_t));
          if (!new_buf) { pthread_mutex_unlock(&q->lock); free(task); free(fc); fprintf(stderr, "dyn-submit: grow oom\n"); abort(); }
          for (int64_t i = 0; i < q->count; i++)
              new_buf[i] = q->buf[(q->head + i) % q->alloc];
          free(q->buf);
          q->buf = new_buf; q->head = 0; q->tail = q->count; q->alloc = new_alloc;
      }
      q->buf[q->tail] = (int64_t)(uintptr_t)task;
      q->tail = (q->tail + 1) % q->alloc;
  }
  q->count++;

  if (pool->idle_count == 0 && pool->n_threads < pool->max_threads) {
      int rc = pthread_create(&pool->threads[pool->n_threads++], NULL, (void *(*)(void *))tp_hydyn_hyworker, (void *)pool);
      if (rc != 0) {
          fprintf(stderr, "thread-pool-dynamic-submit: pthread_create failed (%d)\n", rc);
          abort();
      }
  }

  pthread_cond_signal(&q->not_empty);
  pthread_mutex_unlock(&q->lock);

  return (void *)(intptr_t)fc;
  ```)
;;; thread-pool-dynamic-shutdown -- signal all dynamic pool workers to stop and join them.
;;;
;;; Parameters:
;;;   tp -- dynamic thread pool handle returned by thread-pool-new-dynamic
;;;
;;; Example:
;;;   (thread-pool-dynamic-shutdown tp)
;;;
;;; Since: Phase T20-D
;; Shutdown the dynamic thread pool.

(defn thread-pool-dynamic-shutdown [tp : DynThreadPoolHandle] : nil
  ```c
  typedef struct {
      void *queue;
      pthread_t *threads;
      int64_t n_threads;
      int64_t max_threads;
      volatile int64_t idle_count;
      volatile int stop_flag;
  } DynThreadPoolBlock;
  DynThreadPoolBlock *pool = (DynThreadPoolBlock *)tp;

  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } TPQueueBlock;
  TPQueueBlock *q = (TPQueueBlock *)pool->queue;
  pthread_mutex_lock(&q->lock);
  q->closed = 1;
  pthread_cond_broadcast(&q->not_empty);
  pthread_cond_broadcast(&q->not_full);
  pthread_mutex_unlock(&q->lock);

  for (int64_t i = 0; i < pool->n_threads; i++) {
      pthread_join(pool->threads[i], NULL);
  }
  ```)
;;; thread-pool-dynamic-free -- free a dynamic thread pool (must be called after shutdown).
;;;
;;; Parameters:
;;;   tp -- dynamic thread pool handle returned by thread-pool-new-dynamic
;;;
;;; Example:
;;;   (thread-pool-dynamic-free tp)
;;;
;;; Since: Phase T20-D
;; Free the dynamic thread pool (must be called after shutdown).

(defn thread-pool-dynamic-free [tp : DynThreadPoolHandle] : nil
  ```c
  typedef struct {
      void *queue;
      pthread_t *threads;
      int64_t n_threads;
      int64_t max_threads;
      volatile int64_t idle_count;
      volatile int stop_flag;
  } DynThreadPoolBlock;
  DynThreadPoolBlock *pool = (DynThreadPoolBlock *)tp;

  free(pool->threads);

  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count;
      int64_t cap; int64_t alloc; int closed;
  } TPQueueBlock;
  TPQueueBlock *q = (TPQueueBlock *)pool->queue;
  pthread_mutex_destroy(&q->lock);
  pthread_cond_destroy(&q->not_full);
  pthread_cond_destroy(&q->not_empty);
  free(q->buf);
  free(q);
  free(pool);
  ```)
