;; stdlib/tidal/transform.tur — Value Transformation Combinators
;;
;; This module provides combinators that transform pattern values
;; (arithmetic, randomness, waveforms, envelopes, etc.).

(import tidal/pattern :pattern)
(import tidal/time :time)

;; ============================================================================
;; Numeric Arithmetic Transformations
;; ============================================================================

;; Add a constant or pattern to a numeric pattern
;;
;; @param p Numeric pattern
;; @param amount Constant or NumPattern to add
;; @return NumPattern that returns p + amount
(defn add [p amount]
  (fn [time]
    (let [amt (if (float? amount) amount (amount time))]
      (+ (p time) amt))))

;; Subtract a constant or pattern from a numeric pattern
;;
;; @param p Numeric pattern
;; @param amount Constant or NumPattern to subtract
;; @return NumPattern that returns p - amount
(defn sub [p amount]
  (fn [time]
    (let [amt (if (float? amount) amount (amount time))]
      (- (p time) amt))))

;; Multiply a numeric pattern by a constant or pattern
;;
;; @param p Numeric pattern
;; @param factor Constant or NumPattern to multiply by
;; @return NumPattern that returns p * factor
(defn mul [p factor]
  (fn [time]
    (let [f (if (float? factor) factor (factor time))]
      (* (p time) f))))

;; Divide a numeric pattern by a constant or pattern
;;
;; @param p Numeric pattern
;; @param divisor Constant or NumPattern to divide by
;; @return NumPattern that returns p / divisor
(defn div [p divisor]
  (fn [time]
    (let [d (if (float? divisor) divisor (divisor time))]
      (if (== d 0)
        0.0
        (/ (p time) d)))))

;; ============================================================================
;; Range Mapping
;; ============================================================================

;; Map a numeric pattern from one range to another
;;
;; @param p Numeric pattern
;; @param from-low Lower bound of input range
;; @param from-high Upper bound of input range
;; @param to-low Lower bound of output range
;; @param to-high Upper bound of output range
;; @return NumPattern with values mapped to new range
(defn range [p from-low from-high to-low to-high]
  (fn [time]
    (let [v (p time)
          input-range (- from-high from-low)
          output-range (- to-high to-low)]
      (if (== input-range 0)
        to-low
        (let [normalized (/ (- v from-low) input-range)
              clamped (math/clamp normalized 0.0 1.0)]
          (+ to-low (* clamped output-range)))))))

;; Clamp a numeric pattern to a range
;;
;; @param p Numeric pattern
;; @param low Minimum value (inclusive)
;; @param high Maximum value (inclusive)
;; @return NumPattern with values clamped to [low, high]
(defn clamp [p low high]
  (fn [time]
    (math/clamp (p time) low high)))

;; Normalize a numeric pattern to [0, 1]
;;
;; @param p Numeric pattern
;; @param min Expected minimum value
;; @param max Expected maximum value
;; @return NumPattern with values normalized to [0, 1]
(defn normalize [p min max]
  (range p min max 0.0 1.0))

;; ============================================================================
;; Modulo and Wrapping
;; ============================================================================

;; Apply modulo to a numeric pattern
;;
;; @param p Numeric pattern
;; @param mod Modulo value
;; @return NumPattern with values wrapped to [0, mod)
(defn mod-pat [p mod]
  (fn [time]
    (mod (p time) mod)))

;; Wrap a numeric pattern to a range
;;
;; @param p Numeric pattern
;; @param low Lower bound of range
;; @param high Upper bound of range
;; @return NumPattern with values wrapped to [low, high]
(defn wrap [p low high]
  (let [range (- high low)]
    (fn [time]
      (let [v (p time)
            offset (- v low)
            wrapped (mod offset range)]
        (if (< wrapped 0)
          (+ high wrapped)
          (+ low wrapped))))))

;; ============================================================================
;; Exponential and Logarithmic
;; ============================================================================

;; Apply exponential to a numeric pattern
;;
;; @param p Numeric pattern
;; @return NumPattern with exp(p)
(defn exp-pat [p]
  (fn [time]
    (math/exp (p time))))

;; Apply logarithm to a numeric pattern
;;
;; @param p Numeric pattern
;; @param base Base of logarithm (default: math/E)
;; @return NumPattern with log_base(p)
(defn log-pat [p & [base math/E]]
  (fn [time]
    (math/log (p time) base)))

;; Power transformation
;;
;; @param p Numeric pattern
;; @param exponent Exponent
;; @return NumPattern with p^exponent
(defn pow-pat [p exponent]
  (fn [time]
    (math/pow (p time) exponent)))

;; Square root transformation
;;
;; @param p Numeric pattern
;; @return NumPattern with sqrt(p)
(defn sqrt-pat [p]
  (fn [time]
    (math/sqrt (p time))))

;; ============================================================================
;; Trigonometric Transformations
;; ============================================================================

;; Apply sine to a numeric pattern
;;
;; @param p Numeric pattern (in radians)
;; @return NumPattern with sin(p)
(defn sin-pat [p]
  (fn [time]
    (math/sin (p time))))

;; Apply cosine to a numeric pattern
;;
;; @param p Numeric pattern (in radians)
;; @return NumPattern with cos(p)
(defn cos-pat [p]
  (fn [time]
    (math/cos (p time))))

;; Apply tangent to a numeric pattern
;;
;; @param p Numeric pattern (in radians)
;; @return NumPattern with tan(p)
(defn tan-pat [p]
  (fn [time]
    (math/tan (p time))))

;; ============================================================================
;; Waveform Patterns
;; ============================================================================

;; Sine wave pattern
;;
;; @param freq Frequency in cycles per beat (default: 1.0)
;; @param amp Amplitude (default: 1.0)
;; @param phase Phase offset in radians (default: 0.0)
;; @return NumPattern that generates a sine wave
(defn sine [& [freq 1.0 amp 1.0 phase 0.0]]
  (fn [time]
    (* amp (math/sin (+ phase (* time freq math/PI 2.0))))))

;; Square wave pattern
;;
;; @param freq Frequency in cycles per beat (default: 1.0)
;; @param amp Amplitude (default: 1.0)
;; @param duty Duty cycle (0-1, default: 0.5)
;; @return NumPattern that generates a square wave
(defn square [& [freq 1.0 amp 1.0 duty 0.5]]
  (fn [time]
    (let [phase (mod (* time freq) 1.0)]
      (if (< phase duty)
        amp
        (- amp)))))

;; Sawtooth wave pattern
;;
;; @param freq Frequency in cycles per beat (default: 1.0)
;; @param amp Amplitude (default: 1.0)
;; @return NumPattern that generates a sawtooth wave
(defn saw [& [freq 1.0 amp 1.0]]
  (fn [time]
    (* amp (- 1.0 (mod (* time freq) 1.0)))))

;; Triangle wave pattern
;;
;; @param freq Frequency in cycles per beat (default: 1.0)
;; @param amp Amplitude (default: 1.0)
;; @return NumPattern that generates a triangle wave
(defn tri [& [freq 1.0 amp 1.0]]
  (fn [time]
    (let [phase (mod (* time freq) 1.0)]
      (* amp (if (< phase 0.5)
               (* 4.0 phase)
               (- 4.0 phase 2.0))))))

;; Pulse wave pattern
;;
;; @param freq Frequency in cycles per beat (default: 1.0)
;; @param amp Amplitude (default: 1.0)
;; @param width Pulse width (0-1, default: 0.5)
;; @return NumPattern that generates a pulse wave
(defn pulse [& [freq 1.0 amp 1.0 width 0.5]]
  (fn [time]
    (let [phase (mod (* time freq) 1.0)]
      (if (< phase width)
        amp
        0.0))))

;; ============================================================================
;; Randomness and Noise
;; ============================================================================

;; Add random jitter to a pattern
;;
;; @param p Pattern to add jitter to
;; @param amount Maximum jitter amount
;; @return Pattern<T> with random jitter added
(defn jitter [p amount]
  (fn [time]
    (let [v (p time)]
      (if (float? v)
        (+ v (* (rand-float) amount))
        v))))

;; Randomly select from patterns at each evaluation
;;
;; @param patterns List of patterns to randomly select from
;; @return Pattern<T> that randomly selects from patterns
(defn rand-select [& patterns]
  (let [vec-patterns (vec patterns)
        len (len vec-patterns)]
    (if (== len 0)
      (pattern/const nil)
      (fn [time]
        (let [idx (rand-int len)]
          ((get vec-patterns idx) time))))))

;; Randomly select from values at each evaluation
;;
;; @param values List of values to randomly select from
;; @return Pattern<T> that randomly selects from values
(defn rand-value [& values]
  (pattern/rand-choice values...))

;; White noise pattern
;;
;; @return NumPattern that returns random floats in [0, 1)
(defn white-noise []
  (pattern/rand-float))

;; Pink noise pattern (approximation)
;;
;; @return NumPattern that returns pink noise values
(defn pink-noise []
  (let [b0 0.0400760
        b1 0.0802569
        b2 0.1608371
        b3 0.3219404
        b4 0.6441628
        b5 1.2886018
        b6 2.5774852
        state (vec (repeat 7 0.0))]
    (fn [time]
      (let [white1 (rand-float)
            white2 (rand-float)
            white3 (rand-float)
            white4 (rand-float)
            white5 (rand-float)
            white6 (rand-float)
            
            new-state (vec
                        (+ (* b0 white1) (* 0.9947114 (get state 0))
                        (+ (* b1 white2) (* 0.9696324 (get state 1)))
                        (+ (* b2 white3) (* 0.9240049 (get state 2)))
                        (+ (* b3 white4) (* 0.7788419 (get state 3)))
                        (+ (* b4 white5) (* 0.5695113 (get state 4)))
                        (+ (* b5 white6) (* 0.2959934 (get state 5)))
                        (* b6 (get state 6)))]n      
        (set! state new-state)
        (+ (* 0.0158818 (get state 0))
           (* 0.0441182 (get state 1))
           (* 0.1102524 (get state 2))
           (* 0.2481545 (get state 3))
           (* 0.4859943 (get state 4))
           (* 0.9719887 (get state 5)))))))

;; Perlin noise pattern (simplified approximation)
;;
;; @param scale Time scale (higher = more detail)
;; @param offset Time offset
;; @return NumPattern that generates Perlin noise
(defn perlin-noise [& [scale 1.0 offset 0.0]]
  (fn [time]
    (let [t (* scale (+ time offset))]
      ;; Simplified noise function
      (rand-range -1.0 1.0))))

;; ============================================================================
;; Envelope Patterns
;; ============================================================================

;; ADSR envelope as a pattern
;;
;; @param attack Attack time in beats
;; @param decay Decay time in beats
;; @param sustain Sustain level (0-1)
;; @param release Release time in beats
;; @param gate BoolPattern for gate signal (default: const true)
;; @return NumPattern that generates ADSR envelope values
(defn adsr [attack decay sustain release & [gate (pattern/const true)]]
  (fn [time]
    (if (gate time)
      (let [t time]
        (cond
          (<= t attack) (/ t attack)
          (<= t (+ attack decay)) 
            (+ 1.0 (* -1.0 sustain (/ (- t attack) decay)))
          (<= t (+ attack decay release)) sustain
          :else (* sustain (/ (- (+ attack decay release) t) release))))
      0.0)))

;; Simple attack-release envelope
;;
;; @param attack Attack time in beats
;; @param release Release time in beats
;; @param gate BoolPattern for gate signal (default: const true)
;; @return NumPattern that generates AR envelope values
(defn ar [attack release & [gate (pattern/const true)]]
  (fn [time]
    (if (gate time)
      (let [t time]
        (cond
          (<= t attack) (/ t attack)
          :else (- 1.0 (/ (- t attack) release))))
      0.0)))

;; Exponential decay envelope
;;
;; @param decay Decay time constant in beats
;; @param gate BoolPattern for gate signal (default: const true)
;; @return NumPattern that generates exponential decay
(defn decay-exp [decay & [gate (pattern/const true)]]
  (fn [time]
    (if (gate time)
      (math/exp (* -1.0 (/ time decay)))
      0.0)))

;; Linear decay envelope
;;
;; @param decay Decay time in beats
;; @param gate BoolPattern for gate signal (default: const true)
;; @return NumPattern that generates linear decay
(defn decay-lin [decay & [gate (pattern/const true)]]
  (fn [time]
    (if (gate time)
      (math/clamp (- 1.0 (/ time decay)) 0.0 1.0)
      0.0)))

;; ============================================================================
;; Bitwise Operations (for integer patterns)
;; ============================================================================

;; Bitwise AND for integer patterns
;;
;; @param p1 First IntPattern
;; @param p2 Second IntPattern or integer
;; @return IntPattern with bitwise AND
(defn and-bit [p1 p2]
  (fn [time]
    (let [v2 (if (int? p2) p2 (p2 time))]
      (bit-and (p1 time) v2))))

;; Bitwise OR for integer patterns
;;
;; @param p1 First IntPattern
;; @param p2 Second IntPattern or integer
;; @return IntPattern with bitwise OR
(defn or-bit [p1 p2]
  (fn [time]
    (let [v2 (if (int? p2) p2 (p2 time))]
      (bit-or (p1 time) v2))))

;; Bitwise XOR for integer patterns
;;
;; @param p1 First IntPattern
;; @param p2 Second IntPattern or integer
;; @return IntPattern with bitwise XOR
(defn xor-bit [p1 p2]
  (fn [time]
    (let [v2 (if (int? p2) p2 (p2 time))]
      (bit-xor (p1 time) v2))))

;; Bitwise NOT for integer patterns
;;
;; @param p IntPattern
;; @return IntPattern with bitwise NOT
(defn not-bit [p]
  (fn [time]
    (bit-not (p time))))

;; ============================================================================
;; Rounding and Quantization
;; ============================================================================

;; Floor a numeric pattern
;;
;; @param p NumPattern
;; @return NumPattern with floor(p)
(defn floor-pat [p]
  (fn [time]
    (floor (p time))))

;; Ceiling a numeric pattern
;;
;; @param p NumPattern
;; @return NumPattern with ceil(p)
(defn ceil-pat [p]
  (fn [time]
    (ceil (p time))))

;; Round a numeric pattern
;;
;; @param p NumPattern
;; @return NumPattern with round(p)
(defn round-pat [p]
  (fn [time]
    (round (p time))))

;; Quantize a numeric pattern to nearest integer
;;
;; @param p NumPattern
;; @return NumPattern with quantized values
(defn quantize-int [p]
  (round-pat p))

;; Quantize a numeric pattern to a specific step size
;;
;; @param p NumPattern
;; @param step Step size
;; @return NumPattern with values quantized to step multiples
(defn quantize-step [p step]
  (fn [time]
    (* step (round (/ (p time) step)))))

;; ============================================================================
;; String Transformations
;; ============================================================================

;; Concatenate string patterns
;;
;; @param p1 First StrPattern
;; @param p2 Second StrPattern or string
;; @return StrPattern with concatenated strings
(defn concat-str [p1 p2]
  (fn [time]
    (let [s2 (if (cstr? p2) p2 (p2 time))]
      (str/concat (p1 time) s2))))

;; Uppercase string pattern
;;
;; @param p StrPattern
;; @return StrPattern with uppercase strings
(defn upper-pat [p]
  (fn [time]
    (str/upper (p time))))

;; Lowercase string pattern
;;
;; @param p StrPattern
;; @return StrPattern with lowercase strings
(defn lower-pat [p]
  (fn [time]
    (str/lower (p time))))
