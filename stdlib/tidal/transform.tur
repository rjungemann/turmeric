;; stdlib/tidal/transform.tur -- Value Transformation Combinators
;;
;; This module provides combinators that transform pattern values
;; (arithmetic, randomness, waveforms, envelopes, etc.).

(import tidal/pattern :pattern)
(import tidal/time :time)

;; ============================================================================
;; Numeric Arithmetic Transformations
;; ============================================================================

;;; add -- add a constant or pattern to a numeric pattern.
;;;
;;; Parameters:
;;;   p      -- base NumPattern
;;;   amount -- constant float or NumPattern to add
;;;
;;; Returns:
;;;   NumPattern returning p(t) + amount.
;;;
;;; Example:
;;;   ((add my-pat 1.0) 0.5)
(defn add [p amount]
  (fn [time]
    (let [amt (if (float? amount) amount (amount time))]
      (+ (p time) amt))))

;;; sub -- subtract a constant or pattern from a numeric pattern.
;;;
;;; Parameters:
;;;   p      -- base NumPattern
;;;   amount -- constant float or NumPattern to subtract
;;;
;;; Returns:
;;;   NumPattern returning p(t) - amount.
(defn sub [p amount]
  (fn [time]
    (let [amt (if (float? amount) amount (amount time))]
      (- (p time) amt))))

;;; mul -- multiply a numeric pattern by a constant or pattern.
;;;
;;; Parameters:
;;;   p      -- base NumPattern
;;;   factor -- constant float or NumPattern
;;;
;;; Returns:
;;;   NumPattern returning p(t) * factor.
;;;
;;; Example:
;;;   ((mul my-pat 0.5) 0.5)  ; halve the values
(defn mul [p factor]
  (fn [time]
    (let [f (if (float? factor) factor (factor time))]
      (* (p time) f))))

;;; div -- divide a numeric pattern by a constant or pattern.
;;;
;;; Parameters:
;;;   p       -- base NumPattern
;;;   divisor -- constant float or NumPattern (returns 0 if divisor is zero)
;;;
;;; Returns:
;;;   NumPattern returning p(t) / divisor.
(defn div [p divisor]
  (fn [time]
    (let [d (if (float? divisor) divisor (divisor time))]
      (if (== d 0)
        0.0
        (/ (p time) d)))))

;; ============================================================================
;; Range Mapping
;; ============================================================================

;;; range -- map pattern values from one range to another.
;;;
;;; Parameters:
;;;   p         -- NumPattern with input values
;;;   from-low  -- lower bound of input range
;;;   from-high -- upper bound of input range
;;;   to-low    -- lower bound of output range
;;;   to-high   -- upper bound of output range
;;;
;;; Returns:
;;;   NumPattern with values linearly mapped and clamped to [to-low, to-high].
;;;
;;; Example:
;;;   ((range my-pat 0.0 1.0 440.0 880.0) 0.5)  ; => 660.0
(defn range [p from-low from-high to-low to-high]
  (fn [time]
    (let [v (p time)
          input-range (- from-high from-low)
          output-range (- to-high to-low)]
      (if (== input-range 0)
        to-low
        (let [normalized (/ (- v from-low) input-range)
              clamped (math/clamp normalized 0.0 1.0)]
          (+ to-low (* clamped output-range)))))))

;;; clamp -- clamp pattern values to [low, high].
;;;
;;; Parameters:
;;;   p    -- NumPattern
;;;   low  -- minimum output value
;;;   high -- maximum output value
;;;
;;; Returns:
;;;   NumPattern with values clamped.
(defn clamp [p low high]
  (fn [time]
    (math/clamp (p time) low high)))

;;; normalize -- map pattern values to [0, 1].
;;;
;;; Parameters:
;;;   p   -- NumPattern
;;;   min -- expected minimum of p
;;;   max -- expected maximum of p
;;;
;;; Returns:
;;;   NumPattern with values normalised to [0, 1].
(defn normalize [p min max]
  (range p min max 0.0 1.0))

;; ============================================================================
;; Modulo and Wrapping
;; ============================================================================

;;; mod-pat -- apply modulo to pattern values.
;;;
;;; Parameters:
;;;   p   -- NumPattern
;;;   mod -- modulo divisor
;;;
;;; Returns:
;;;   NumPattern with values wrapped to [0, mod).
(defn mod-pat [p mod]
  (fn [time]
    (mod (p time) mod)))

;;; wrap -- wrap pattern values to stay within [low, high].
;;;
;;; Parameters:
;;;   p    -- NumPattern
;;;   low  -- lower bound
;;;   high -- upper bound
;;;
;;; Returns:
;;;   NumPattern with values wrapped into [low, high].
(defn wrap [p low high]
  (let [range (- high low)]
    (fn [time]
      (let [v (p time)
            offset (- v low)
            wrapped (mod offset range)]
        (if (< wrapped 0)
          (+ high wrapped)
          (+ low wrapped))))))

;; ============================================================================
;; Exponential and Logarithmic
;; ============================================================================

;;; exp-pat -- apply exp() to pattern values.
;;;
;;; Parameters:
;;;   p -- NumPattern (values in radians or raw)
;;;
;;; Returns:
;;;   NumPattern with e^p(t).
(defn exp-pat [p]
  (fn [time]
    (math/exp (p time))))

;;; log-pat -- apply logarithm to pattern values.
;;;
;;; Parameters:
;;;   p    -- NumPattern (must be > 0)
;;;   base -- logarithm base (default: math/E)
;;;
;;; Returns:
;;;   NumPattern with log_base(p(t)).
(defn log-pat [p & [base math/E]]
  (fn [time]
    (math/log (p time) base)))

;;; pow-pat -- raise pattern values to a constant exponent.
;;;
;;; Parameters:
;;;   p        -- NumPattern (base)
;;;   exponent -- power to raise to
;;;
;;; Returns:
;;;   NumPattern with p(t)^exponent.
(defn pow-pat [p exponent]
  (fn [time]
    (math/pow (p time) exponent)))

;;; sqrt-pat -- square root of pattern values.
;;;
;;; Parameters:
;;;   p -- NumPattern (values must be >= 0)
;;;
;;; Returns:
;;;   NumPattern with sqrt(p(t)).
(defn sqrt-pat [p]
  (fn [time]
    (math/sqrt (p time))))

;; ============================================================================
;; Trigonometric Transformations
;; ============================================================================

;;; sin-pat -- apply sin() to pattern values.
;;;
;;; Parameters:
;;;   p -- NumPattern in radians
;;;
;;; Returns:
;;;   NumPattern with sin(p(t)).
(defn sin-pat [p]
  (fn [time]
    (math/sin (p time))))

;;; cos-pat -- apply cos() to pattern values.
;;;
;;; Parameters:
;;;   p -- NumPattern in radians
;;;
;;; Returns:
;;;   NumPattern with cos(p(t)).
(defn cos-pat [p]
  (fn [time]
    (math/cos (p time))))

;;; tan-pat -- apply tan() to pattern values.
;;;
;;; Parameters:
;;;   p -- NumPattern in radians
;;;
;;; Returns:
;;;   NumPattern with tan(p(t)).
(defn tan-pat [p]
  (fn [time]
    (math/tan (p time))))

;; ============================================================================
;; Waveform Patterns
;; ============================================================================

;;; sine -- sine wave pattern oscillating at a given frequency.
;;;
;;; Parameters:
;;;   freq  -- frequency in cycles per beat (default: 1.0)
;;;   amp   -- amplitude (default: 1.0)
;;;   phase -- phase offset in radians (default: 0.0)
;;;
;;; Returns:
;;;   NumPattern generating values in [-amp, amp].
;;;
;;; Example:
;;;   ((sine 0.5 1.0 0.0) 0.25)
(defn sine [& [freq 1.0 amp 1.0 phase 0.0]]
  (fn [time]
    (* amp (math/sin (+ phase (* time freq math/PI 2.0))))))

;;; square -- square wave pattern.
;;;
;;; Parameters:
;;;   freq -- frequency in cycles per beat (default: 1.0)
;;;   amp  -- amplitude (default: 1.0)
;;;   duty -- duty cycle (0-1, default: 0.5)
;;;
;;; Returns:
;;;   NumPattern returning amp or -amp.
(defn square [& [freq 1.0 amp 1.0 duty 0.5]]
  (fn [time]
    (let [phase (mod (* time freq) 1.0)]
      (if (< phase duty)
        amp
        (- amp)))))

;;; saw -- sawtooth wave pattern.
;;;
;;; Parameters:
;;;   freq -- frequency in cycles per beat (default: 1.0)
;;;   amp  -- amplitude (default: 1.0)
;;;
;;; Returns:
;;;   NumPattern descending from amp to 0 each cycle.
(defn saw [& [freq 1.0 amp 1.0]]
  (fn [time]
    (* amp (- 1.0 (mod (* time freq) 1.0)))))

;;; tri -- triangle wave pattern.
;;;
;;; Parameters:
;;;   freq -- frequency in cycles per beat (default: 1.0)
;;;   amp  -- amplitude (default: 1.0)
;;;
;;; Returns:
;;;   NumPattern rising and falling symmetrically within [-amp, amp].
(defn tri [& [freq 1.0 amp 1.0]]
  (fn [time]
    (let [phase (mod (* time freq) 1.0)]
      (* amp (if (< phase 0.5)
               (* 4.0 phase)
               (- 4.0 phase 2.0))))))

;;; pulse -- pulse wave pattern.
;;;
;;; Parameters:
;;;   freq  -- frequency in cycles per beat (default: 1.0)
;;;   amp   -- pulse height (default: 1.0)
;;;   width -- pulse width 0-1 (default: 0.5)
;;;
;;; Returns:
;;;   NumPattern returning amp during pulse, 0.0 otherwise.
(defn pulse [& [freq 1.0 amp 1.0 width 0.5]]
  (fn [time]
    (let [phase (mod (* time freq) 1.0)]
      (if (< phase width)
        amp
        0.0))))

;; ============================================================================
;; Randomness and Noise
;; ============================================================================

;;; jitter -- add random noise to pattern values.
;;;
;;; Parameters:
;;;   p      -- base pattern
;;;   amount -- maximum jitter magnitude added to each float value
;;;
;;; Returns:
;;;   Pattern<T> with random perturbation added to numeric values.
(defn jitter [p amount]
  (fn [time]
    (let [v (p time)]
      (if (float? v)
        (+ v (* (rand-float) amount))
        v))))

;;; rand-select -- randomly pick one of several patterns on each evaluation.
;;;
;;; Parameters:
;;;   patterns -- patterns to choose from
;;;
;;; Returns:
;;;   Pattern<T> delegating to a randomly selected sub-pattern each beat.
(defn rand-select [& patterns]
  (let [vec-patterns (vec patterns)
        len (len vec-patterns)]
    (if (== len 0)
      (pattern/const nil)
      (fn [time]
        (let [idx (rand-int len)]
          ((get vec-patterns idx) time))))))

;;; rand-value -- randomly select a constant value on each evaluation.
;;;
;;; Parameters:
;;;   values -- values to choose from
;;;
;;; Returns:
;;;   Pattern<T>.
(defn rand-value [& values]
  (pattern/rand-choice values...))

;;; white-noise -- white noise pattern returning random floats in [0, 1).
;;;
;;; Returns:
;;;   NumPattern with uniform random values.
(defn white-noise []
  (pattern/rand-float))

;;; pink-noise -- approximate pink noise pattern.
;;;
;;; Returns:
;;;   NumPattern producing spectrally shaped noise.
(defn pink-noise []
  (let [b0 0.0400760
        b1 0.0802569
        b2 0.1608371
        b3 0.3219404
        b4 0.6441628
        b5 1.2886018
        b6 2.5774852
        state (vec (repeat 7 0.0))]
    (fn [time]
      (let [white1 (rand-float)
            white2 (rand-float)
            white3 (rand-float)
            white4 (rand-float)
            white5 (rand-float)
            white6 (rand-float)

            new-state (vec
                        (+ (* b0 white1) (* 0.9947114 (get state 0))
                        (+ (* b1 white2) (* 0.9696324 (get state 1)))
                        (+ (* b2 white3) (* 0.9240049 (get state 2)))
                        (+ (* b3 white4) (* 0.7788419 (get state 3)))
                        (+ (* b4 white5) (* 0.5695113 (get state 4)))
                        (+ (* b5 white6) (* 0.2959934 (get state 5)))
                        (* b6 (get state 6)))]n
        (set! state new-state)
        (+ (* 0.0158818 (get state 0))
           (* 0.0441182 (get state 1))
           (* 0.1102524 (get state 2))
           (* 0.2481545 (get state 3))
           (* 0.4859943 (get state 4))
           (* 0.9719887 (get state 5)))))))

;;; perlin-noise -- simplified Perlin-style noise pattern.
;;;
;;; Parameters:
;;;   scale  -- time scale (higher = more detail, default: 1.0)
;;;   offset -- time offset (default: 0.0)
;;;
;;; Returns:
;;;   NumPattern with smooth random values.
(defn perlin-noise [& [scale 1.0 offset 0.0]]
  (fn [time]
    (let [t (* scale (+ time offset))]
      ;; Simplified noise function
      (rand-range -1.0 1.0))))

;; ============================================================================
;; Envelope Patterns
;; ============================================================================

;;; adsr -- ADSR envelope pattern.
;;;
;;; Parameters:
;;;   attack  -- attack time in beats
;;;   decay   -- decay time in beats
;;;   sustain -- sustain level (0-1)
;;;   release -- release time in beats
;;;   gate    -- BoolPattern for gate (default: const true)
;;;
;;; Returns:
;;;   NumPattern producing ADSR envelope values.
;;;
;;; Example:
;;;   ((adsr 0.1 0.2 0.7 0.3) 0.5)
(defn adsr [attack decay sustain release & [gate (pattern/const true)]]
  (fn [time]
    (if (gate time)
      (let [t time]
        (cond
          (<= t attack) (/ t attack)
          (<= t (+ attack decay))
            (+ 1.0 (* -1.0 sustain (/ (- t attack) decay)))
          (<= t (+ attack decay release)) sustain
          :else (* sustain (/ (- (+ attack decay release) t) release))))
      0.0)))

;;; ar -- simple attack-release envelope pattern.
;;;
;;; Parameters:
;;;   attack  -- attack time in beats
;;;   release -- release time in beats
;;;   gate    -- BoolPattern (default: const true)
;;;
;;; Returns:
;;;   NumPattern.
(defn ar [attack release & [gate (pattern/const true)]]
  (fn [time]
    (if (gate time)
      (let [t time]
        (cond
          (<= t attack) (/ t attack)
          :else (- 1.0 (/ (- t attack) release))))
      0.0)))

;;; decay-exp -- exponential decay envelope pattern.
;;;
;;; Parameters:
;;;   decay -- time constant in beats
;;;   gate  -- BoolPattern (default: const true)
;;;
;;; Returns:
;;;   NumPattern returning e^(-t/decay).
(defn decay-exp [decay & [gate (pattern/const true)]]
  (fn [time]
    (if (gate time)
      (math/exp (* -1.0 (/ time decay)))
      0.0)))

;;; decay-lin -- linear decay envelope pattern.
;;;
;;; Parameters:
;;;   decay -- decay duration in beats
;;;   gate  -- BoolPattern (default: const true)
;;;
;;; Returns:
;;;   NumPattern returning max(0, 1 - t/decay).
(defn decay-lin [decay & [gate (pattern/const true)]]
  (fn [time]
    (if (gate time)
      (math/clamp (- 1.0 (/ time decay)) 0.0 1.0)
      0.0)))

;; ============================================================================
;; Bitwise Operations (for integer patterns)
;; ============================================================================

;;; and-bit -- bitwise AND of two integer patterns.
;;;
;;; Parameters:
;;;   p1 -- first IntPattern
;;;   p2 -- IntPattern or integer constant
;;;
;;; Returns:
;;;   IntPattern with bitwise AND applied.
(defn and-bit [p1 p2]
  (fn [time]
    (let [v2 (if (int? p2) p2 (p2 time))]
      (bit-and (p1 time) v2))))

;;; or-bit -- bitwise OR of two integer patterns.
;;;
;;; Parameters:
;;;   p1 -- first IntPattern
;;;   p2 -- IntPattern or integer constant
;;;
;;; Returns:
;;;   IntPattern with bitwise OR applied.
(defn or-bit [p1 p2]
  (fn [time]
    (let [v2 (if (int? p2) p2 (p2 time))]
      (bit-or (p1 time) v2))))

;;; xor-bit -- bitwise XOR of two integer patterns.
;;;
;;; Parameters:
;;;   p1 -- first IntPattern
;;;   p2 -- IntPattern or integer constant
;;;
;;; Returns:
;;;   IntPattern with bitwise XOR applied.
(defn xor-bit [p1 p2]
  (fn [time]
    (let [v2 (if (int? p2) p2 (p2 time))]
      (bit-xor (p1 time) v2))))

;;; not-bit -- bitwise NOT of an integer pattern.
;;;
;;; Parameters:
;;;   p -- IntPattern
;;;
;;; Returns:
;;;   IntPattern with bitwise NOT applied.
(defn not-bit [p]
  (fn [time]
    (bit-not (p time))))

;; ============================================================================
;; Rounding and Quantization
;; ============================================================================

;;; floor-pat -- floor each pattern value.
;;;
;;; Parameters:
;;;   p -- NumPattern
;;;
;;; Returns:
;;;   NumPattern with floor(p(t)).
(defn floor-pat [p]
  (fn [time]
    (floor (p time))))

;;; ceil-pat -- ceiling each pattern value.
;;;
;;; Parameters:
;;;   p -- NumPattern
;;;
;;; Returns:
;;;   NumPattern with ceil(p(t)).
(defn ceil-pat [p]
  (fn [time]
    (ceil (p time))))

;;; round-pat -- round each pattern value to the nearest integer.
;;;
;;; Parameters:
;;;   p -- NumPattern
;;;
;;; Returns:
;;;   NumPattern with round(p(t)).
(defn round-pat [p]
  (fn [time]
    (round (p time))))

;;; quantize-int -- quantize pattern values to nearest integer (alias for round-pat).
;;;
;;; Parameters:
;;;   p -- NumPattern
;;;
;;; Returns:
;;;   NumPattern.
(defn quantize-int [p]
  (round-pat p))

;;; quantize-step -- quantize pattern values to multiples of a step size.
;;;
;;; Parameters:
;;;   p    -- NumPattern
;;;   step -- quantization step size
;;;
;;; Returns:
;;;   NumPattern with values snapped to step multiples.
;;;
;;; Example:
;;;   ((quantize-step my-pat 0.25) 0.0)
(defn quantize-step [p step]
  (fn [time]
    (* step (round (/ (p time) step)))))

;; ============================================================================
;; String Transformations
;; ============================================================================

;;; concat-str -- concatenate two string patterns.
;;;
;;; Parameters:
;;;   p1 -- first StrPattern
;;;   p2 -- StrPattern or string constant
;;;
;;; Returns:
;;;   StrPattern with concatenated strings.
(defn concat-str [p1 p2]
  (fn [time]
    (let [s2 (if (cstr? p2) p2 (p2 time))]
      (str/concat (p1 time) s2))))

;;; upper-pat -- convert string pattern values to uppercase.
;;;
;;; Parameters:
;;;   p -- StrPattern
;;;
;;; Returns:
;;;   StrPattern with uppercased values.
(defn upper-pat [p]
  (fn [time]
    (str/upper (p time))))

;;; lower-pat -- convert string pattern values to lowercase.
;;;
;;; Parameters:
;;;   p -- StrPattern
;;;
;;; Returns:
;;;   StrPattern with lowercased values.
(defn lower-pat [p]
  (fn [time]
    (str/lower (p time))))
