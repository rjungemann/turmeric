;; stdlib/tidal/structural.tur -- Structural Pattern Combinators
;;
;; This module provides combinators that combine multiple patterns structurally
;; (sequencing, stacking, conditional triggering, etc.).

(import tidal/pattern :pattern)
(import tidal/temporal :temporal)

;; ============================================================================
;; Sequential Combination
;; ============================================================================

;;; seq -- sequence patterns end to end, each getting equal time per cycle.
;;;
;;; Parameters:
;;;   patterns -- one or more patterns to sequence
;;;
;;; Returns:
;;;   Pattern<T> cycling through patterns one beat at a time.
;;;
;;; Example:
;;;   ((seq pat-a pat-b pat-c) 1.5)  ; evaluates pat-b at sub-time 0.5
(defn seq [& patterns]
  (let [vec-patterns (vec patterns)
        len (len vec-patterns)]
    (if (== len 0)
      (pattern/const nil)
      (fn [time]
        (let [index (mod (floor time) len)
              sub-time (- time (floor time))]
          ((get vec-patterns index) sub-time))))))

;;; seq-n -- sequence patterns with custom durations per segment.
;;;
;;; Parameters:
;;;   pattern-lengths -- list of [pattern length] tuples
;;;
;;; Returns:
;;;   Pattern<T> proportionally allocating time to each segment.
(defn seq-n [& pattern-lengths]
  (let [pairs (vec pattern-lengths)
        total-length (reduce + 0.0 (map second pairs))
        len (len pairs)]
    (if (== len 0)
      (pattern/const nil)
      (fn [time]
        (let [mod-time (mod time total-length)
              ;; Find which segment we're in
              [index segment-start segment-length] (loop [i 0 acc 0.0]
                                                     (if (>= i len)
                                                       [0 0 total-length]
                                                       (let [[_ length] (get pairs i)]
                                                         (if (>= mod-time (+ acc length))
                                                           (recur (inc i) (+ acc length))
                                                           [i acc length]))))
              sub-time (- mod-time segment-start)
              scale (/ segment-length total-length)]
          ((first (get pairs index)) (/ sub-time scale)))))))

;; ============================================================================
;; Parallel Combination (Stacking)
;; ============================================================================

;;; stack -- evaluate all patterns simultaneously and return their values as a vector.
;;;
;;; Parameters:
;;;   patterns -- one or more patterns to stack
;;;
;;; Returns:
;;;   Pattern<vec<T>> where each element is one pattern's value at the current time.
;;;
;;; Example:
;;;   ((stack kick-pat snare-pat hat-pat) 0.0)
(defn stack [& patterns]
  (let [vec-patterns (vec patterns)]
    (fn [time]
      (vec (map #(% time) vec-patterns)))))

;;; stack-with -- stack patterns and fold results with a combiner function.
;;;
;;; Parameters:
;;;   f        -- function vec<T> -> U combining all pattern values
;;;   patterns -- patterns to stack
;;;
;;; Returns:
;;;   Pattern<U>.
(defn stack-with [f & patterns]
  (fn [time]
    (f (vec (map #(% time) patterns)))))

;;; sum -- pointwise sum of numeric patterns.
;;;
;;; Parameters:
;;;   patterns -- one or more NumPattern to sum
;;;
;;; Returns:
;;;   NumPattern returning the sum of all pattern values.
;;;
;;; Example:
;;;   ((sum bass-pat melody-pat) 0.5)
(defn sum [& patterns]
  (stack-with (fn [v] (reduce + 0.0 v)) patterns))

;;; multiply -- pointwise product of numeric patterns.
;;;
;;; Parameters:
;;;   patterns -- one or more NumPattern to multiply
;;;
;;; Returns:
;;;   NumPattern returning the product of all pattern values.
(defn multiply [& patterns]
  (stack-with (fn [v] (reduce * 1.0 v)) patterns))

;;; average -- pointwise average of numeric patterns.
;;;
;;; Parameters:
;;;   patterns -- one or more NumPattern to average
;;;
;;; Returns:
;;;   NumPattern returning the arithmetic mean of all pattern values.
(defn average [& patterns]
  (let [vec-patterns (vec patterns)
        len (len vec-patterns)]
    (if (== len 0)
      (pattern/const 0.0)
      (stack-with (fn [v] (/ (reduce + 0.0 v) len)) vec-patterns))))

;; ============================================================================
;; Conditional Patterns
;; ============================================================================

;;; when -- gate a pattern through a boolean condition.
;;;
;;; Parameters:
;;;   cond -- BoolPattern controlling when p fires
;;;   p    -- pattern to gate
;;;   zero -- value when condition is false (default: 0)
;;;
;;; Returns:
;;;   Pattern<T>.
;;;
;;; Example:
;;;   (when (pattern/every-n 2) kick-pat 0)
(defn when [cond p & [zero 0]]
  (fn [time]
    (if (cond time)
      (p time)
      zero)))

;;; if-pat -- select between two patterns based on a boolean pattern.
;;;
;;; Parameters:
;;;   cond   -- BoolPattern
;;;   then-p -- pattern when condition is true
;;;   else-p -- pattern when condition is false
;;;
;;; Returns:
;;;   Pattern<T>.
(defn if-pat [cond then-p else-p]
  (fn [time]
    (if (cond time)
      (then-p time)
      (else-p time))))

;;; every -- trigger a pattern every n beats.
;;;
;;; Parameters:
;;;   n    -- beat interval
;;;   p    -- pattern to trigger
;;;   zero -- value between triggers (default: 0)
;;;
;;; Returns:
;;;   Pattern<T>.
;;;
;;; Example:
;;;   (every 4 fill-pat)
(defn every [n p & [zero 0]]
  (when (temporal/every-n n) p zero))

;;; nth -- trigger a pattern when beat number mod n equals offset.
;;;
;;; Parameters:
;;;   n      -- modulo base
;;;   p      -- pattern to trigger
;;;   offset -- target remainder (default: 0)
;;;   zero   -- value when not triggered (default: 0)
;;;
;;; Returns:
;;;   Pattern<T>.
(defn nth [n p & [offset 0 zero 0]]
  (when (temporal/when-mod n offset) p zero))

;; ============================================================================
;; Euclidean Rhythm Patterns
;; ============================================================================

;;; euclid -- Euclidean rhythm distributing hits as evenly as possible.
;;;
;;; Parameters:
;;;   steps    -- total number of steps in the pattern
;;;   hits     -- number of active (hit) steps
;;;   rotation -- rotation offset (default: 0)
;;;
;;; Returns:
;;;   NumPattern returning 1 for hits and 0 for rests.
;;;
;;; Example:
;;;   ((euclid 8 5) 0.0)  ; classic 5-in-8 Euclidean rhythm
(defn euclid [steps hits & [rotation 0]]
  (let [result (vec (repeat steps 0))]
    (when (and (> steps 0) (> hits 0))
      (let [;; Generate positions using Bjorklund's algorithm
            positions (loop [remaining hits
                        current 0
                        result []]
                      (if (== remaining 0)
                        result
                        (let [step-size (ceil (/ (- steps current) remaining))
                              next-pos (+ current step-size)]
                          (recur (dec remaining) next-pos (conj result next-pos)))))]
        (doseq [pos positions]
          (let [idx (mod (+ pos rotation) steps)]
            (when (< idx steps)
              (set! result (assoc result idx 1)))))))
    (fn [time]
      (get result (mod (floor time) steps)))))

;;; euclid-vals -- Euclidean rhythm with custom on/off values.
;;;
;;; Parameters:
;;;   steps     -- total steps
;;;   hits      -- number of hit steps
;;;   on-value  -- value for hits (default: 1)
;;;   off-value -- value for rests (default: 0)
;;;   rotation  -- rotation offset (default: 0)
;;;
;;; Returns:
;;;   Pattern<T> with custom on/off values.
(defn euclid-vals [steps hits & [on-value 1 off-value 0 rotation 0]]
  (let [base (euclid steps hits rotation)]
    (fn [time]
      (if (== 1 (base time))
        on-value
        off-value))))

;; ============================================================================
;; Pattern Selection
;; ============================================================================

;;; select -- choose among patterns using an index pattern.
;;;
;;; Parameters:
;;;   index    -- NumPattern producing indices into the pattern list
;;;   patterns -- patterns to select from
;;;
;;; Returns:
;;;   Pattern<T> delegating to the selected sub-pattern.
;;;
;;; Example:
;;;   ((select (cycle 0 1 2) pat-a pat-b pat-c) 0.5)
(defn select [index & patterns]
  (let [vec-patterns (vec patterns)
        len (len vec-patterns)]
    (if (== len 0)
      (pattern/const nil)
      (fn [time]
        (let [idx (mod (int (index time)) len)]
          ((get vec-patterns idx) time))))))

;;; first-nonzero -- return the first non-zero value from a set of patterns.
;;;
;;; Parameters:
;;;   zero     -- zero sentinel value (default: 0)
;;;   patterns -- patterns to check in order
;;;
;;; Returns:
;;;   Pattern<T> returning the first non-zero pattern value.
(defn first-nonzero [& [zero 0 patterns]]
  (let [vec-patterns (vec patterns)
        len (len vec-patterns)]
    (if (== len 0)
      (pattern/const zero)
      (fn [time]
        (loop [i 0]
          (if (== i len)
            zero
            (let [v ((get vec-patterns i) time)]
              (if (!= v zero)
                v
                (recur (inc i))))))))))

;; ============================================================================
;; Index-Based Patterns
;; ============================================================================

;;; index -- return the step index within a cycle.
;;;
;;; Parameters:
;;;   cycle-length -- number of steps per cycle (default: 1)
;;;
;;; Returns:
;;;   IntPattern returning the current step index.
(defn index [& [cycle-length 1]]
  (fn [time]
    (mod (floor (* time cycle-length)) cycle-length)))

;;; first-beat -- true on the first step of each cycle.
;;;
;;; Parameters:
;;;   cycle-length -- steps per cycle (default: 1)
;;;
;;; Returns:
;;;   BoolPattern.
(defn first-beat [& [cycle-length 1]]
  (fn [time]
    (== 0 (mod (floor (* time cycle-length)) cycle-length))))

;;; last-beat -- true on the last step of each cycle.
;;;
;;; Parameters:
;;;   cycle-length -- steps per cycle (default: 1)
;;;
;;; Returns:
;;;   BoolPattern.
(defn last-beat [& [cycle-length 1]]
  (fn [time]
    (== (dec cycle-length) (mod (floor (* time cycle-length)) cycle-length))))

;; ============================================================================
;; Pattern Chaining
;; ============================================================================

;;; chain -- concatenate patterns, advancing when a sentinel value is returned.
;;;
;;; Parameters:
;;;   sentinel -- value indicating end of a pattern segment (default: nil)
;;;   patterns -- patterns to chain
;;;
;;; Returns:
;;;   Pattern<T> advancing through patterns in order.
(defn chain [& [sentinel nil patterns]]
  (let [vec-patterns (vec patterns)
        len (len vec-patterns)]
    (if (== len 0)
      (pattern/const nil)
      (fn [time]
        (loop [i 0 acc-time 0.0]
          (if (>= i len)
            sentinel
            (let [p (get vec-patterns i)
                  sub-time (- time acc-time)
                  v (p sub-time)]
              (if (== v sentinel)
                (recur (inc i) (+ acc-time 1.0))
                v))))))))

;; ============================================================================
;; Pattern Interleaving
;; ============================================================================

;;; interleave -- alternate between patterns each beat.
;;;
;;; Parameters:
;;;   patterns -- patterns to interleave
;;;
;;; Returns:
;;;   Pattern<T> cycling through patterns one per beat, with each sub-pattern
;;;   receiving compressed time equal to the number of patterns.
;;;
;;; Example:
;;;   ((interleave pat-a pat-b) 0.5)  ; reads pat-a at time 1.0
(defn interleave [& patterns]
  (let [vec-patterns (vec patterns)
        len (len vec-patterns)]
    (if (== len 0)
      (pattern/const nil)
      (fn [time]
        (let [index (mod (floor time) len)
              sub-time (- time (floor time))]
          ((get vec-patterns index) (* len sub-time)))))))

;;; interleave-n -- interleave patterns with custom durations (alias for seq-n).
;;;
;;; Parameters:
;;;   pattern-lengths -- list of [pattern length] tuples
;;;
;;; Returns:
;;;   Pattern<T>.
(defn interleave-n [& pattern-lengths]
  (seq-n pattern-lengths))

;; ============================================================================
;; Pattern Masking
;; ============================================================================

;;; mask -- let signal pass only where a boolean mask is true.
;;;
;;; Parameters:
;;;   source -- Pattern to read values from
;;;   mask   -- BoolPattern: true = pass, false = block
;;;   zero   -- value when masked (default: 0)
;;;
;;; Returns:
;;;   Pattern<T>.
;;;
;;; Example:
;;;   (mask melody-pat (euclid 8 5))
(defn mask [source mask & [zero 0]]
  (fn [time]
    (if (mask time)
      (source time)
      zero)))

;;; invert -- invert a boolean pattern.
;;;
;;; Parameters:
;;;   p -- BoolPattern to invert
;;;
;;; Returns:
;;;   BoolPattern with negated values.
(defn invert [p]
  (fn [time]
    (not (p time))))

;;; and-pat -- logical AND of two boolean patterns.
;;;
;;; Parameters:
;;;   a -- first BoolPattern
;;;   b -- second BoolPattern
;;;
;;; Returns:
;;;   BoolPattern.
(defn and-pat [a b]
  (fn [time]
    (and (a time) (b time))))

;;; or-pat -- logical OR of two boolean patterns.
;;;
;;; Parameters:
;;;   a -- first BoolPattern
;;;   b -- second BoolPattern
;;;
;;; Returns:
;;;   BoolPattern.
(defn or-pat [a b]
  (fn [time]
    (or (a time) (b time))))

;;; xor-pat -- logical XOR of two boolean patterns.
;;;
;;; Parameters:
;;;   a -- first BoolPattern
;;;   b -- second BoolPattern
;;;
;;; Returns:
;;;   BoolPattern.
(defn xor-pat [a b]
  (fn [time]
    (not= (a time) (b time))))

;; ============================================================================
;; Pattern Grouping
;; ============================================================================

;;; group -- partition patterns into groups and apply a group combiner.
;;;
;;; Parameters:
;;;   group-size    -- number of patterns per group
;;;   group-pattern -- function (time, patterns) -> T applied to each group
;;;   patterns      -- patterns to group
;;;
;;; Returns:
;;;   Pattern<T> applying group-pattern to the current group.
(defn group [group-size group-pattern & patterns]
  (let [vec-patterns (vec patterns)
        len (len vec-patterns)
        num-groups (ceil (/ len group-size))]
    (if (== len 0)
      (pattern/const nil)
      (fn [time]
        (let [group-index (mod (floor (/ time group-size)) num-groups)
              start (* group-index group-size)
              end (min (+ start group-size) len)
              group-patterns (slice vec-patterns start end)]
          (group-pattern time group-patterns))))))
