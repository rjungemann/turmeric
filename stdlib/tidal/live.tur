;; stdlib/tidal/live.tur -- Live-Coding Integration
;;
;; This module provides live-coding workflow support for Tidal patterns.
;; It enables pattern modification and re-evaluation in a REPL context.

(import tidal/pattern :pattern)
(import tidal/synth :synth)
(import tidal/structural :structural)

;; ============================================================================
;; Live Pattern Replacement
;; ============================================================================

;;; player-update -- replace the pattern in a running player.
;;;
;;; Parameters:
;;;   player      -- PatternPlayer to update
;;;   new-pattern -- new pattern to use
;;;
;;; Returns:
;;;   Updated PatternPlayer.
(defn player-update [player new-pattern]
  (synth/player-update player new-pattern))

;;; player-swap -- atomically swap the parameter map pattern in a player.
;;;
;;; Parameters:
;;;   player        -- PatternPlayer to update
;;;   new-param-map -- new parameter map pattern
;;;
;;; Returns:
;;;   Updated PatternPlayer.
(defn player-swap [player new-param-map]
  (synth/player-swap player new-param-map))

;;; player-reload -- stop a player, replace its pattern, and restart it.
;;;
;;; Parameters:
;;;   player      -- PatternPlayer to reload
;;;   new-pattern -- replacement pattern
(defn player-reload [player new-pattern]
  (synth/player-stop player)
  (player-update player new-pattern)
  (synth/player-start player))

;; ============================================================================
;; Pattern Hot-Reloading
;; ============================================================================

;;; watch-pattern -- start a player that watches a file for pattern changes.
;;;
;;; Parameters:
;;;   path            -- file path to watch for changes
;;;   session         -- scscm session
;;;   def-name        -- SynthDef name
;;;   initial-pattern -- pattern to use before any file change
;;;   bpm             -- tempo
;;;
;;; Returns:
;;;   PatternPlayer (already started).
(defn watch-pattern [path session def-name initial-pattern bpm]
  (let [player (synth/synth-pattern-player session def-name
                                               (synth/synth-params
                                                 initial-pattern
                                                 (pattern/const 1.0)
                                                 (pattern/const 0.0))
                                               bpm)
        last-mod (file/mod-time path)]

    ;; In a real implementation, we'd spawn a background task to watch the file
    ;; For now, we just return the player
    player))

;; ============================================================================
;; Pattern State Management
;; ============================================================================

;;; StatefulPattern -- a pattern that carries and evolves internal state.
(defstruct StatefulPattern<T>
  [pattern :(fn [T time/Beats] :tuple<T (pattern/Pattern<T>)>)
   state :T])

;;; make-stateful-pattern -- create a stateful pattern from an initial state and step function.
;;;
;;; Parameters:
;;;   initial -- initial state value
;;;   f       -- function (state, Beats) -> (new-state, Pattern<T>)
;;;
;;; Returns:
;;;   StatefulPattern<T>.
(defn make-stateful-pattern [initial f]
  {:pattern f
   :state initial})

;;; step-stateful -- advance a stateful pattern by one step.
;;;
;;; Parameters:
;;;   sp   -- StatefulPattern<T>
;;;   time -- current time in beats
;;;
;;; Returns:
;;;   Tuple of (new-state, updated StatefulPattern).
(defn step-stateful [sp time]
  (let [[new-state new-pat] ((:pattern sp) (:state sp) time)]
    [new-state (assoc sp :state new-state :pattern (fn [_ _] [new-state new-pat]))]))

;;; eval-stateful -- evaluate a stateful pattern at a specific time.
;;;
;;; Parameters:
;;;   sp   -- StatefulPattern<T>
;;;   time -- time in beats
;;;
;;; Returns:
;;;   Pattern value at the given time.
(defn eval-stateful [sp time]
  (let [[_ new-pat] ((:pattern sp) (:state sp) time)]
    (new-pat time)))

;; ============================================================================
;; Example: Counter Pattern
;; ============================================================================

;;; counter-pattern -- counting pattern that increments on each beat.
;;;
;;; Parameters:
;;;   max -- maximum count value before wrapping back to 0
;;;
;;; Returns:
;;;   StatefulPattern<int>.
;;;
;;; Example:
;;;   (counter-pattern 8)
(defn counter-pattern [max]
  (make-stateful-pattern 0
    (fn [count time]
      (let [new-count (mod (inc count) max)]
        [new-count (pattern/const new-count)]))))

;; ============================================================================
;; Session State Patterns
;; ============================================================================

;;; state-pattern -- pattern that reads a value from session state.
;;;
;;; Parameters:
;;;   key -- state key to read
;;;   f   -- function (state-value, time) -> T
;;;
;;; Returns:
;;;   Pattern<T>.
(defn state-pattern [key f]
  (fn [time]
    (let [value (scscm/session-get key)]
      (f value time))))

;;; updating-pattern -- pattern that reads and writes session state on each evaluation.
;;;
;;; Parameters:
;;;   key     -- state key
;;;   initial -- initial state value (used if key is not set)
;;;   f       -- function (state, time) -> (new-state, output-value)
;;;
;;; Returns:
;;;   Pattern<T>.
(defn updating-pattern [key initial f]
  (fn [time]
    (let [current (scscm/session-get key)
          [new-state value] (f current time)]
      (scscm/session-set key new-state)
      value)))

;; ============================================================================
;; Live-Coding Session
;; ============================================================================

;;; LiveSession -- a complete live-coding session with patterns and players.
(defstruct LiveSession
  [scscm-session :scscm/ScscmSession
   players :(map<int synth/PatternPlayer>)
   next-player-id :int
   patterns :(map<cstr pattern/Pattern<map>>)
   state :(map<cstr any>)])

;;; live-session-new -- create a new live-coding session.
;;;
;;; Parameters:
;;;   sample-rate -- audio sample rate (default: DEFAULT_SAMPLE_RATE)
;;;   block-size  -- audio block size (default: DEFAULT_BLOCK_SIZE)
;;;
;;; Returns:
;;;   LiveSession.
(defn live-session-new [& [sample-rate time/DEFAULT_SAMPLE_RATE
                             block-size time/DEFAULT_BLOCK_SIZE]]
  {:scscm-session (scscm/session-new sample-rate block-size)
   :players {}
   :next-player-id 0
   :patterns {}
   :state {}})

;;; live-session-destroy -- stop all players and destroy a live-coding session.
;;;
;;; Parameters:
;;;   session -- LiveSession to destroy
(defn live-session-destroy [session]
  (doseq [player (vals (:players session))]
    (synth/player-stop player))
  (scscm/session-destroy (:scscm-session session)))

;;; live-session-add-pattern -- register a named pattern in the session.
;;;
;;; Parameters:
;;;   session -- LiveSession
;;;   name    -- pattern name
;;;   pattern -- Pattern<map> to register
;;;
;;; Returns:
;;;   Updated LiveSession.
(defn live-session-add-pattern [session name pattern]
  (update session :patterns assoc name pattern))

;;; live-session-get-pattern -- retrieve a named pattern from the session.
;;;
;;; Parameters:
;;;   session -- LiveSession
;;;   name    -- pattern name
;;;
;;; Returns:
;;;   Pattern<map> or nil.
(defn live-session-get-pattern [session name]
  (get (:patterns session) name))

;;; live-session-update-pattern -- replace a named pattern in the session.
;;;
;;; Parameters:
;;;   session     -- LiveSession
;;;   name        -- pattern name
;;;   new-pattern -- replacement pattern
;;;
;;; Returns:
;;;   Updated LiveSession.
(defn live-session-update-pattern [session name new-pattern]
  (update session :patterns assoc name new-pattern))

;;; live-session-add-player -- create a player for a named pattern and add it to the session.
;;;
;;; Parameters:
;;;   session      -- LiveSession
;;;   def-name     -- SynthDef name
;;;   pattern-name -- name of the pattern to play
;;;   bpm          -- tempo
;;;
;;; Returns:
;;;   Player ID or nil if the named pattern does not exist.
(defn live-session-add-player [session def-name pattern-name bpm]
  (let [player-id (:next-player-id session)
        pattern (live-session-get-pattern session pattern-name)]
    (when pattern
      (let [player (synth/synth-pattern-player (:scscm-session session)
                                            def-name
                                            pattern
                                            bpm)]
        (update session
                :players assoc player-id player
                :next-player-id inc)))))

;;; live-session-remove-player -- stop and remove a player from the session.
;;;
;;; Parameters:
;;;   session   -- LiveSession
;;;   player-id -- ID of the player to remove
;;;
;;; Returns:
;;;   Updated LiveSession.
(defn live-session-remove-player [session player-id]
  (when-let [player (get (:players session) player-id)]
    (synth/player-stop player)
    (update session :players dissoc player-id)))

;; ============================================================================
;; Pattern Evaluation Context
;; ============================================================================

;;; live-context -- build a symbol table of live-coding bindings for a session.
;;;
;;; Parameters:
;;;   session -- LiveSession
;;;
;;; Returns:
;;;   Map of symbols to values, suitable for use as an evaluation environment.
(defn live-context [session]
  {
    ;; Time and pattern utilities
    'bpm->bps time/bpm->bps
    'bpm->spb time/bpm->spb
    'beats->sec time/beats->sec
    'sec->beats time/sec->beats
    'cycle pattern/cycle
    'const pattern/const
    'P pattern/P

    ;; Temporal combinators
    'slow temporal/slow
    'fast temporal/fast
    'shift temporal/shift
    'rot temporal/rot
    'mirror temporal/mirror
    'rev temporal/rev
    'repeat temporal/repeat

    ;; Structural combinators
    'seq structural/seq
    'stack structural/stack
    'sum structural/sum
    'multiply structural/multiply
    'when structural/when
    'every structural/every
    'euclid structural/euclid

    ;; Transform combinators
    'add transform/add
    'mul transform/mul
    'range transform/range
    'clamp transform/clamp
    'sine transform/sine
    'square transform/square
    'saw transform/saw
    'tri transform/tri

    ;; Synth integration
    'note-pattern synth/note-pattern
    'note->freq synth/note->freq
    'vel->amp synth/vel->amp
    'kick synth/kick
    'snare synth/snare
    'hat synth/hat

    ;; Session access
    'session session
    'get-pattern (fn [name] (live-session-get-pattern session name))
    'set-pattern (fn [name p] (live-session-update-pattern session name p))
    'add-player (fn [def-name pat-name bpm] (live-session-add-player session def-name pat-name bpm))
    'remove-player (fn [player-id] (live-session-remove-player session player-id))

    ;; Polyrhythm
    'polyrhythm polyrhythm/polyrhythm
    'canon polyrhythm/canon
    'spread polyrhythm/spread
  })

;;; live-eval -- evaluate a code string in the live-coding context.
;;;
;;; Parameters:
;;;   session -- LiveSession
;;;   code    -- Turmeric source string to evaluate
;;;
;;; Returns:
;;;   Result of evaluation (placeholder: returns code unchanged).
(defn live-eval [session code]
  (let [context (live-context session)]
    ;; In Turmeric, we'd use eval with this context
    ;; For now, this is a placeholder
    code))

;; ============================================================================
;; Pattern Live-Coding Helpers
;; ============================================================================

;;; def-pattern -- define a named pattern in the session by evaluating code.
;;;
;;; Parameters:
;;;   session -- LiveSession
;;;   name    -- pattern name
;;;   code    -- code string that evaluates to a pattern
(defn def-pattern [session name code]
  (let [pattern (live-eval session code)]
    (live-session-add-pattern session name pattern)))

;;; set-player-pattern -- update a running player with a new pattern from code.
;;;
;;; Parameters:
;;;   session   -- LiveSession
;;;   player-id -- player ID to update
;;;   code      -- code string that evaluates to a pattern
(defn set-player-pattern [session player-id code]
  (when-let [player (get (:players session) player-id)]
    (let [pattern (live-eval session code)]
      (player-update player pattern))))

;; ============================================================================
;; Live-Coding Shortcuts
;; ============================================================================

;;; d1 -- define a pattern and immediately start a player for it.
;;;
;;; Parameters:
;;;   session  -- LiveSession
;;;   name     -- pattern name
;;;   code     -- code string that evaluates to a pattern
;;;   def-name -- SynthDef name
;;;   bpm      -- tempo
;;;
;;; Returns:
;;;   Player ID.
(defn d1 [session name code def-name bpm]
  (def-pattern session name code)
  (live-session-add-player session def-name name bpm))

;;; hush -- stop all players in a session.
;;;
;;; Parameters:
;;;   session -- LiveSession
;;;
;;; Returns:
;;;   Updated LiveSession with no running players.
(defn hush [session]
  (doseq [[player-id player] (:players session)]
    (synth/player-stop player))
  (update session :players empty-map))

;; ============================================================================
;; Pattern Recording
;; ============================================================================

;;; PatternRecorder -- records events from a running player.
(defstruct PatternRecorder
  [session :LiveSession
   player-id :int
   events :(vec<map>)
   recording :bool])

;;; record-start -- begin recording events from a player.
;;;
;;; Parameters:
;;;   session   -- LiveSession
;;;   player-id -- player ID to record
;;;
;;; Returns:
;;;   PatternRecorder.
(defn record-start [session player-id]
  {:session session
   :player-id player-id
   :events []
   :recording true})

;;; record-stop -- stop recording and mark the recorder as done.
;;;
;;; Parameters:
;;;   recorder -- PatternRecorder
;;;
;;; Returns:
;;;   Updated PatternRecorder with recording=false.
(defn record-stop [recorder]
  (assoc recorder :recording false))

;;; record-get -- retrieve all recorded events.
;;;
;;; Parameters:
;;;   recorder -- PatternRecorder
;;;
;;; Returns:
;;;   vec<map> of recorded events.
(defn record-get [recorder]
  (:events recorder))

;;; record-play -- play back recorded events as a new player.
;;;
;;; Parameters:
;;;   session  -- LiveSession
;;;   recorder -- PatternRecorder with recorded events
;;;   def-name -- SynthDef name for playback
;;;   bpm      -- tempo
;;;
;;; Returns:
;;;   Player ID.
(defn record-play [session recorder def-name bpm]
  (let [events (:events recorder)
        player-id (:next-player-id session)]
    (update session :next-player-id inc)))
