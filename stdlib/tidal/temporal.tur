;; stdlib/tidal/temporal.tur -- Temporal Pattern Combinators
;;
;; This module provides combinators that transform patterns temporally
;; (time scaling, time shifting, repetition, etc.).

(import tidal/pattern :pattern)
(import tidal/time :time)

;; ============================================================================
;; Time Scaling Combinators
;; ============================================================================

;;; slow -- play a pattern slower by a given factor.
;;;
;;; Parameters:
;;;   factor -- slowdown factor (> 1 = slower)
;;;   p      -- pattern to slow down
;;;
;;; Returns:
;;;   Pattern<T> that plays at 1/factor speed.
;;;
;;; Example:
;;;   ((slow 2 my-pat) 1.0)  ; same as (my-pat 0.5)
(defn slow [factor p]
  (fn [time]
    (p (/ time factor))))

;;; fast -- play a pattern faster by a given factor.
;;;
;;; Parameters:
;;;   factor -- speedup factor (> 1 = faster)
;;;   p      -- pattern to speed up
;;;
;;; Returns:
;;;   Pattern<T> that plays factor times faster.
;;;
;;; Example:
;;;   ((fast 2 my-pat) 1.0)  ; same as (my-pat 2.0)
(defn fast [factor p]
  (fn [time]
    (p (* time factor))))

;;; stretch -- stretch time within a cycle (alias for slow).
;;;
;;; Parameters:
;;;   factor -- stretch factor
;;;   p      -- pattern to stretch
;;;
;;; Returns:
;;;   Pattern<T> with stretched time.
(defn stretch [factor p]
  (slow factor p))

;;; compress -- compress time within a cycle (alias for fast).
;;;
;;; Parameters:
;;;   factor -- compression factor
;;;   p      -- pattern to compress
;;;
;;; Returns:
;;;   Pattern<T> with compressed time.
(defn compress [factor p]
  (fast factor p))

;; ============================================================================
;; Time Shifting Combinators
;; ============================================================================

;;; shift -- shift a pattern forward or backward in time.
;;;
;;; Parameters:
;;;   offset -- time offset in beats (positive = later, negative = earlier)
;;;   p      -- pattern to shift
;;;
;;; Returns:
;;;   Pattern<T> shifted in time.
;;;
;;; Example:
;;;   ((shift 0.5 my-pat) 1.0)  ; same as (my-pat 1.5)
(defn shift [offset p]
  (fn [time]
    (p (+ time offset))))

;;; rot -- rotate a pattern's phase (alias for shift).
;;;
;;; Parameters:
;;;   amount -- rotation amount in beats
;;;   p      -- pattern to rotate
;;;
;;; Returns:
;;;   Pattern<T> with shifted phase.
(defn rot [amount p]
  (shift amount p))

;;; mirror -- mirror a pattern within each 2-beat window.
;;;
;;; Parameters:
;;;   p -- pattern to mirror
;;;
;;; Returns:
;;;   Pattern<T> that plays forward in [0,1) then backward in [1,2).
;;;
;;; Example:
;;;   ((mirror my-pat) 1.5)  ; reads from time 0.5
(defn mirror [p]
  (fn [time]
    (let [phase (mod time 2.0)]
      (if (< phase 1.0)
        (p phase)
        (p (- 2.0 phase))))))

;;; rev -- reverse a pattern within each 1-beat cycle.
;;;
;;; Parameters:
;;;   p -- pattern to reverse
;;;
;;; Returns:
;;;   Pattern<T> with reversed time within each cycle.
;;;
;;; Example:
;;;   ((rev my-pat) 0.25)  ; same as (my-pat 0.75)
(defn rev [p]
  (fn [time]
    (let [phase (mod time 1.0)]
      (p (- 1.0 phase)))))

;; ============================================================================
;; Repetition Combinators
;; ============================================================================

;;; repeat -- repeat a pattern n times within its cycle.
;;;
;;; Parameters:
;;;   n -- repetition count
;;;   p -- pattern to repeat
;;;
;;; Returns:
;;;   Pattern<T> playing n times faster.
;;;
;;; Example:
;;;   ((repeat 4 my-pat) 0.0)
(defn repeat [n p]
  (fast n p))

;;; once -- play a pattern only during the first beat, then return zero.
;;;
;;; Parameters:
;;;   p    -- pattern to play
;;;   zero -- value after the first cycle (default: 0)
;;;
;;; Returns:
;;;   Pattern<T> that silences after time >= 1.0.
(defn once [p & [zero 0]]
  (fn [time]
    (if (< time 1.0)
      (p time)
      zero)))

;;; for-beats -- play a pattern for a fixed number of beats, then return zero.
;;;
;;; Parameters:
;;;   duration -- duration in beats
;;;   p        -- pattern to play
;;;   zero     -- value after duration (default: 0)
;;;
;;; Returns:
;;;   Pattern<T> active for duration beats.
(defn for-beats [duration p & [zero 0]]
  (fn [time]
    (if (< time duration)
      (p (/ time duration))
      zero)))

;; ============================================================================
;; Looping Combinators
;; ============================================================================

;;; loop-cycles -- loop a pattern for a fixed number of cycles then stop.
;;;
;;; Parameters:
;;;   cycles -- number of cycles to loop
;;;   p      -- pattern to loop
;;;   zero   -- value after looping ends (default: 0)
;;;
;;; Returns:
;;;   Pattern<T>.
(defn loop-cycles [cycles p & [zero 0]]
  (fn [time]
    (if (< time cycles)
      (p (mod time 1.0))
      zero)))

;;; loop-range -- loop a pattern between two time points.
;;;
;;; Parameters:
;;;   start -- start time in beats
;;;   end   -- end time in beats
;;;   p     -- pattern to loop
;;;   zero  -- value outside [start, end) (default: 0)
;;;
;;; Returns:
;;;   Pattern<T> looping within the window.
(defn loop-range [start end p & [zero 0]]
  (fn [time]
    (if (and (>= time start) (< time end))
      (p (mod (- time start) (- end start)))
      zero)))

;; ============================================================================
;; Time Warping Combinators
;; ============================================================================

;;; warp -- remap time using an arbitrary function.
;;;
;;; Parameters:
;;;   warp-fn -- Beats -> Beats transformation applied to time before evaluation
;;;   p       -- pattern to warp
;;;
;;; Returns:
;;;   Pattern<T> evaluated at warped time.
(defn warp [warp-fn p]
  (fn [time]
    (p (warp-fn time))))

;;; warp-by -- remap time by multiplying with values from another pattern.
;;;
;;; Parameters:
;;;   warp-pat -- NumPattern producing a time-scaling factor
;;;   p        -- pattern to warp
;;;
;;; Returns:
;;;   Pattern<T> evaluated at time * warp-pat(time).
(defn warp-by [warp-pat p]
  (fn [time]
    (let [warp-value (warp-pat time)]
      (p (* time warp-value)))))

;; ============================================================================
;; Time Quantization Combinators
;; ============================================================================

;;; quantize-beat -- snap pattern evaluation to the nearest beat boundary.
;;;
;;; Parameters:
;;;   p -- pattern to quantize
;;;
;;; Returns:
;;;   Pattern<T> that only changes on whole-beat boundaries.
(defn quantize-beat [p]
  (fn [time]
    (p (floor time))))

;;; quantize -- snap pattern evaluation to multiples of n beats.
;;;
;;; Parameters:
;;;   n -- quantization grid size in beats
;;;   p -- pattern to quantize
;;;
;;; Returns:
;;;   Pattern<T> quantized to n-beat intervals.
;;;
;;; Example:
;;;   (quantize 0.25 my-pat)  ; 16th-note grid
(defn quantize [n p]
  (fn [time]
    (p (* n (floor (/ time n))))))

;;; quantize-subdiv -- snap pattern evaluation to a subdivision grid.
;;;
;;; Parameters:
;;;   subdivisions -- number of subdivisions per beat (e.g., 4 = 16th notes)
;;;   p            -- pattern to quantize
;;;
;;; Returns:
;;;   Pattern<T> quantized to 1/subdivisions-beat steps.
(defn quantize-subdiv [subdivisions p]
  (quantize (/ 1.0 subdivisions) p))

;; ============================================================================
;; Time Modulo Combinators
;; ============================================================================

;;; time-mod -- wrap time into a [0, period) window before evaluation.
;;;
;;; Parameters:
;;;   period -- period in beats
;;;   p      -- pattern to wrap
;;;
;;; Returns:
;;;   Pattern<T> evaluated with time mod period.
(defn time-mod [period p]
  (fn [time]
    (p (mod time period))))

;;; time-switch -- cycle through a list of patterns, each lasting period beats.
;;;
;;; Parameters:
;;;   period   -- duration per pattern in beats
;;;   patterns -- patterns to cycle through
;;;
;;; Returns:
;;;   Pattern<T> switching to the next pattern every period beats.
;;;
;;; Example:
;;;   ((time-switch 4 pat-a pat-b pat-c) 5.0)  ; uses pat-b
(defn time-switch [period & patterns]
  (let [vec-patterns (vec patterns)
        len (len vec-patterns)]
    (if (== len 0)
      (pattern/const nil)
      (fn [time]
        (let [index (mod (floor (/ time period)) len)]
          ((get vec-patterns index) (mod time period)))))))

;; ============================================================================
;; Composite Temporal Transformations
;; ============================================================================

;;; transform-time -- apply a sequence of temporal transformations to a pattern.
;;;
;;; Parameters:
;;;   p               -- base pattern
;;;   transformations -- list of [transform-fn args...] pairs to apply in order
;;;
;;; Returns:
;;;   Pattern<T> with all transformations applied.
;;;
;;; Example:
;;;   (transform-time (cycle 1 2 3) [slow 2] [shift 0.5] [repeat 2])
(defn transform-time [p & transformations]
  (reduce (fn [acc [transform & args]]
            (apply transform acc args))
          p
          transformations))

;; Example usage:
;; (transform-time (cycle 1 2 3) [slow 2] [shift 0.5] [repeat 2])

;; ============================================================================
;; Utility Combinators
;; ============================================================================

;;; backwards -- play a pattern in reverse within each cycle.
;;;
;;; Parameters:
;;;   p        -- pattern to reverse
;;;   duration -- cycle duration in beats (default: 1.0)
;;;
;;; Returns:
;;;   Pattern<T> playing backwards.
(defn backwards [p & [duration 1.0]]
  (fn [time]
    (p (- duration (mod time duration)))))

;;; palindrome -- play a pattern forwards then backwards (ping-pong).
;;;
;;; Parameters:
;;;   p        -- pattern to palindrome
;;;   duration -- half-period in beats (default: 1.0)
;;;
;;; Returns:
;;;   Pattern<T> playing forward then backward in a 2*duration window.
;;;
;;; Example:
;;;   ((palindrome my-pat) 1.5)  ; reads from time 0.5 (backwards half)
(defn palindrome [p & [duration 1.0]]
  (fn [time]
    (let [phase (mod time (* 2 duration))]
      (if (< phase duration)
        (p phase)
        (p (- (* 2 duration) phase))))))

;;; stutter -- repeat each value of a pattern subdivisions times.
;;;
;;; Parameters:
;;;   subdivisions -- how many times to repeat each value
;;;   p            -- pattern to stutter
;;;
;;; Returns:
;;;   Pattern<T> with stuttered output.
;;;
;;; Example:
;;;   ((stutter 4 my-pat) 0.5)  ; reads from floor(0.5/4) = 0
(defn stutter [subdivisions p]
  (fn [time]
    (let [base-time (/ time subdivisions)]
      (p (floor base-time)))))

;; ============================================================================
;; Time Window Combinators
;; ============================================================================

;;; time-window -- gate a pattern to a specific time window.
;;;
;;; Parameters:
;;;   start -- window start in beats
;;;   end   -- window end in beats
;;;   p     -- pattern to window
;;;   zero  -- value outside the window (default: 0)
;;;
;;; Returns:
;;;   Pattern<T> active only in [start, end).
(defn time-window [start end p & [zero 0]]
  (fn [time]
    (if (and (>= time start) (< time end))
      (p time)
      zero)))

;;; fade-in -- produce a linear ramp from 0 to 1 over fade-duration beats.
;;;
;;; Parameters:
;;;   fade-duration -- duration of the fade in beats
;;;   p             -- pattern (currently unused, ramp only)
;;;
;;; Returns:
;;;   NumPattern rising linearly to 1.0 then holding at 1.0.
(defn fade-in [fade-duration p]
  (fn [time]
    (if (< time fade-duration)
      (let [t (/ time fade-duration)]
        (time/lerp 0.0 1.0 t))
      1.0)))

;;; fade-out -- produce a linear ramp from 1 to 0 starting at start-time.
;;;
;;; Parameters:
;;;   fade-duration -- duration of the fade in beats
;;;   start-time    -- beat at which the fade begins
;;;   p             -- pattern (currently unused, ramp only)
;;;
;;; Returns:
;;;   NumPattern holding 1.0 before start-time, then falling to 0.0.
(defn fade-out [fade-duration start-time p]
  (fn [time]
    (if (>= time start-time)
      (let [t (/ (- time start-time) fade-duration)]
        (time/lerp 1.0 0.0 (math/clamp t 0.0 1.0)))
      1.0)))
