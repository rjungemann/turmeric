;; stdlib/tidal/temporal.tur — Temporal Pattern Combinators
;;
;; This module provides combinators that transform patterns temporally
;; (time scaling, time shifting, repetition, etc.).

(import tidal/pattern :pattern)
(import tidal/time :time)

;; ============================================================================
;; Time Scaling Combinators
;; ============================================================================

;; Slow down a pattern by a factor
;;
;; @param factor Slow factor (> 1 means slower)
;; @param p Pattern to slow down
;; @return Pattern<T> that plays slower
(defn slow [factor p]
  (fn [time]
    (p (/ time factor))))

;; Speed up a pattern by a factor
;;
;; @param factor Speed factor (> 1 means faster)
;; @param p Pattern to speed up
;; @return Pattern<T> that plays faster
(defn fast [factor p]
  (fn [time]
    (p (* time factor))))

;; Stretch time within a cycle (same as slow)
;;
;; @param factor Stretch factor
;; @param p Pattern to stretch
;; @return Pattern<T> with stretched time
(defn stretch [factor p]
  (slow factor p))

;; Compress time within a cycle (same as fast)
;;
;; @param factor Compression factor
;; @param p Pattern to compress
;; @return Pattern<T> with compressed time
(defn compress [factor p]
  (fast factor p))

;; ============================================================================
;; Time Shifting Combinators
;; ============================================================================

;; Shift pattern in time
;;
;; @param offset Time offset in beats (positive = delay, negative = advance)
;; @param p Pattern to shift
;; @return Pattern<T> shifted in time
(defn shift [offset p]
  (fn [time]
    (p (+ time offset))))

;; Rotate the values in a cycle
;; This shifts the pattern's phase
;;
;; @param amount Rotation amount in beats
;; @param p Pattern to rotate (typically a cycle pattern)
;; @return Pattern<T> with rotated phase
(defn rot [amount p]
  (shift amount p))

;; Mirror the pattern within its cycle
;;
;; @param p Pattern to mirror
;; @return Pattern<T> that is mirrored within each 2-beat cycle
(defn mirror [p]
  (fn [time]
    (let [phase (mod time 2.0)]
      (if (< phase 1.0)
        (p phase)
        (p (- 2.0 phase))))))

;; Reverse time within each cycle
;;
;; @param p Pattern to reverse
;; @return Pattern<T> with time reversed within each 1-beat cycle
(defn rev [p]
  (fn [time]
    (let [phase (mod time 1.0)]
      (p (- 1.0 phase)))))

;; ============================================================================
;; Repetition Combinators
;; ============================================================================

;; Repeat a pattern n times within its cycle
;;
;; @param n Number of repetitions
;; @param p Pattern to repeat
;; @return Pattern<T> that plays n times faster
(defn repeat [n p]
  (fast n p))

;; Play the pattern once, then return zero value
;;
;; @param p Pattern to play once
;; @param zero Value to return after first cycle (default: 0)
;; @return Pattern<T> that plays once then returns zero
(defn once [p & [zero 0]]
  (fn [time]
    (if (< time 1.0)
      (p time)
      zero)))

;; Play the pattern for a specific duration
;;
;; @param duration Duration in beats
;; @param p Pattern to play
;; @param zero Value to return after duration (default: 0)
;; @return Pattern<T> that plays for duration beats
(defn for-beats [duration p & [zero 0]]
  (fn [time]
    (if (< time duration)
      (p (/ time duration))
      zero)))

;; ============================================================================
;; Looping Combinators
;; ============================================================================

;; Loop a pattern for a specific number of cycles
;;
;; @param cycles Number of cycles to loop
;; @param p Pattern to loop
;; @param zero Value to return after looping (default: 0)
;; @return Pattern<T> that loops for cycles then returns zero
(defn loop-cycles [cycles p & [zero 0]]
  (fn [time]
    (if (< time cycles)
      (p (mod time 1.0))
      zero)))

;; Loop a pattern between start and end times
;;
;; @param start Start time in beats
;; @param end End time in beats
;; @param p Pattern to loop
;; @param zero Value to return outside [start, end) (default: 0)
;; @return Pattern<T> that loops between start and end
(defn loop-range [start end p & [zero 0]]
  (fn [time]
    (if (and (>= time start) (< time end))
      (p (mod (- time start) (- end start)))
      zero)))

;; ============================================================================
;; Time Warping Combinators
;; ============================================================================

;; Warp time using a function
;;
;; @param warp-fn Function to warp time: Beats -> Beats
;; @param p Pattern to warp
;; @return Pattern<T> with warped time
(defn warp [warp-fn p]
  (fn [time]
    (p (warp-fn time))))

;; Warp time using a pattern
;;
;; @param warp-pat Pattern that produces warp values
;; @param p Pattern to warp
;; @return Pattern<T> with time warped by warp-pat
(defn warp-by [warp-pat p]
  (fn [time]
    (let [warp-value (warp-pat time)]
      (p (* time warp-value)))))

;; ============================================================================
;; Time Quantization Combinators
;; ============================================================================

;; Quantize pattern evaluation to nearest beat
;;
;; @param p Pattern to quantize
;; @return Pattern<T> that only changes on beat boundaries
(defn quantize-beat [p]
  (fn [time]
    (p (floor time))))

;; Quantize pattern evaluation to nearest nth beat
;;
;; @param n Quantization resolution in beats
;; @param p Pattern to quantize
;; @return Pattern<T> quantized to n-beat intervals
(defn quantize [n p]
  (fn [time]
    (p (* n (floor (/ time n))))))

;; Quantize pattern evaluation to nearest subdivision
;;
;; @param subdivisions Number of subdivisions per beat (e.g., 2 = 8th notes, 4 = 16th notes)
;; @param p Pattern to quantize
;; @return Pattern<T> quantized to subdivisions
(defn quantize-subdiv [subdivisions p]
  (quantize (/ 1.0 subdivisions) p))

;; ============================================================================
;; Time Modulo Combinators
;; ============================================================================

;; Modulo time by a period
;;
;; @param period Period in beats
;; @param p Pattern to apply modulo to
;; @return Pattern<T> with time wrapped to [0, period)
(defn time-mod [period p]
  (fn [time]
    (p (mod time period))))

;; Apply different patterns to different time ranges
;;
;; @param period Period in beats for each pattern
;; @param patterns List of patterns to cycle through
;; @return Pattern<T> that cycles through patterns
(defn time-switch [period & patterns]
  (let [vec-patterns (vec patterns)
        len (len vec-patterns)]
    (if (== len 0)
      (pattern/const nil)
      (fn [time]
        (let [index (mod (floor (/ time period)) len)]
          ((get vec-patterns index) (mod time period))))))))

;; ============================================================================
;; Composite Temporal Transformations
;; ============================================================================

;; Apply multiple temporal transformations
;;
;; @param p Pattern to transform
;; @param transformations List of [transform-fn args...] to apply
;; @return Pattern<T> with all transformations applied
(defn transform-time [p & transformations]
  (reduce (fn [acc [transform & args]]
            (apply transform acc args))
          p
          transformations))

;; Example usage:
;; (transform-time (cycle 1 2 3) [slow 2] [shift 0.5] [repeat 2])

;; ============================================================================
;; Utility Combinators
;; ============================================================================

;; Swap the time direction (play pattern backwards)
;;
;; @param p Pattern to play backwards
;; @param duration Duration in beats (default: 1)
;; @return Pattern<T> that plays backwards
(defn backwards [p & [duration 1.0]]
  (fn [time]
    (p (- duration (mod time duration)))))

;; Play pattern forwards then backwards (palindrome)
;;
;; @param p Pattern to palindrome
;; @param duration Duration in beats (default: 1)
;; @return Pattern<T> that plays forwards then backwards
(defn palindrome [p & [duration 1.0]]
  (fn [time]
    (let [phase (mod time (* 2 duration))]
      (if (< phase duration)
        (p phase)
        (p (- (* 2 duration) phase))))))

;; Stutter: repeat the current value for a sub-cycle
;;
;; @param subdivisions Number of times to stutter each value
;; @param p Pattern to stutter
;; @return Pattern<T> with stuttered values
(defn stutter [subdivisions p]
  (fn [time]
    (let [base-time (/ time subdivisions)]
      (p (floor base-time)))))

;; ============================================================================
;; Time Window Combinators
;; ============================================================================

;; Only evaluate pattern within a time window
;;
;; @param start Start of window in beats
;; @param end End of window in beats
;; @param p Pattern to window
;; @param zero Value to return outside window (default: 0)
;; @return Pattern<T> that only evaluates within [start, end)
(defn time-window [start end p & [zero 0]]
  (fn [time]
    (if (and (>= time start) (< time end))
      (p time)
      zero)))

;; Fade in a pattern over time
;;
;; @param fade-duration Duration of fade in beats
;; @param p Pattern to fade in
;; @return Pattern<T> with fade-in (for numeric patterns)
(defn fade-in [fade-duration p]
  (fn [time]
    (if (< time fade-duration)
      (let [t (/ time fade-duration)]
        (time/lerp 0.0 1.0 t))
      1.0)))

;; Fade out a pattern over time
;;
;; @param fade-duration Duration of fade out in beats
;; @param start-time Start of fade out in beats
;; @param p Pattern to fade out
;; @return Pattern<T> with fade-out (for numeric patterns)
(defn fade-out [fade-duration start-time p]
  (fn [time]
    (if (>= time start-time)
      (let [t (/ (- time start-time) fade-duration)]
        (time/lerp 1.0 0.0 (math/clamp t 0.0 1.0)))
      1.0)))
