;; stdlib/tidal/pattern.tur -- Core Pattern Type and Constructors
;;
;; This module provides the fundamental Pattern type and basic pattern
;; constructors for the TidalCycles-inspired DSL.

(import tidal/time :time)

;; ============================================================================
;; Core Pattern Type
;; ============================================================================

;; A pattern is a function from time (in beats) to a value of type T
;; The time is the start time of the cycle the pattern is being evaluated for
;;
;; This is the fundamental abstraction: Pattern<T> = Beats -> T
(def-type Pattern<T> (fn [time/time:Beats] :T))

;; Type alias for numeric patterns (most common)
(def-type NumPattern (Pattern<float>))

;; Type alias for integer patterns (e.g., MIDI notes)
(def-type IntPattern (Pattern<int>))

;; Type alias for boolean patterns (e.g., triggers)
(def-type BoolPattern (Pattern<bool>))

;; Type alias for string patterns (e.g., drum names)
(def-type StrPattern (Pattern<cstr>))

;; ============================================================================
;; Pattern Evaluation
;; ============================================================================

;;; pat-at -- evaluate a pattern at a specific time.
;;;
;;; Parameters:
;;;   p    -- pattern to evaluate
;;;   time -- time in beats
;;;
;;; Returns:
;;;   Pattern value at the given time.
;;;
;;; Example:
;;;   (pat-at (const 5) 2.3)  ; => 5
(defn pat-at [p time]
  (p time))

;;; pat-start -- evaluate a pattern at time 0.
;;;
;;; Parameters:
;;;   p -- pattern to evaluate
;;;
;;; Returns:
;;;   Pattern value at time 0.
;;;
;;; Example:
;;;   (pat-start (cycle 10 20 30))  ; => 10
(defn pat-start [p]
  (p 0.0))

;; ============================================================================
;; Basic Pattern Constructors
;; ============================================================================

;;; const -- constant pattern that always returns the same value.
;;;
;;; Parameters:
;;;   value -- the value to return regardless of time
;;;
;;; Returns:
;;;   Pattern<T> that always returns value.
;;;
;;; Example:
;;;   (const 0.5)
(defn const [value]
  (fn [_time] value))

;;; silence -- pattern that always returns none (for option types).
;;;
;;; Returns:
;;;   Pattern<option<T>> that always returns none.
(defn silence []
  (fn [_time] none))

;; ============================================================================
;; Cycle Patterns
;; ============================================================================

;;; cycle -- cycle through values one per beat.
;;;
;;; Parameters:
;;;   values -- one or more values to cycle through
;;;
;;; Returns:
;;;   Pattern<T> advancing to the next value each beat.
;;;
;;; Example:
;;;   ((cycle 1 2 3) 0.0)  ; => 1
;;;   ((cycle 1 2 3) 1.0)  ; => 2
(defn cycle [& values]
  (let [vec-values (vec values)
        len (len vec-values)]
    (if (== len 0)
      (const nil)  ;; or silence for option types
      (fn [time]
        (let [index (mod (floor time) len)]
          (get vec-values index))))))

;;; fast-cycle -- cycle through values at a faster rate.
;;;
;;; Parameters:
;;;   rate   -- cycles per whole (default: 1 = same as cycle)
;;;   values -- values to cycle through
;;;
;;; Returns:
;;;   Pattern<T> cycling rate times faster than cycle.
;;;
;;; Example:
;;;   ((fast-cycle 2 1 2 3) 0.5)  ; evaluates as if time=1.0
(defn fast-cycle [rate & values]
  (let [vec-values (vec values)
        len (len vec-values)]
    (if (== len 0)
      (const nil)
      (fn [time]
        (let [index (mod (floor (* time rate)) len)]
          (get vec-values index))))))

;; ============================================================================
;; Phase Pattern
;; ============================================================================

;;; phase -- return the fractional phase within a cycle.
;;;
;;; Parameters:
;;;   cycle_length -- length of the cycle in beats (default: 1.0)
;;;
;;; Returns:
;;;   NumPattern returning phase in [0, cycle_length).
;;;
;;; Example:
;;;   ((phase 2.0) 1.5)  ; => 1.5
(defn phase [& [cycle_length 1.0]]
  (fn [time]
    (time/phase time cycle_length)))

;; ============================================================================
;; P Macro for Concise Pattern Syntax
;; ============================================================================

;;; P -- macro shorthand: (P x) => (const x), (P x y ...) => (cycle x y ...).
;;;
;;; Example:
;;;   (P 1 2 3)  ; same as (cycle 1 2 3)
;;;   (P 5)      ; same as (const 5)
(defmacro P [& exprs]
  (if (== (len exprs) 1)
    `(const ~(first exprs))
    `(cycle ~@exprs)))

;; ============================================================================
;; Random Patterns
;; ============================================================================

;;; rand-choice -- randomly pick a value from the supplied list on each evaluation.
;;;
;;; Parameters:
;;;   values -- one or more values to choose from
;;;
;;; Returns:
;;;   Pattern<T> returning a random element each time it is evaluated.
;;;
;;; Example:
;;;   ((rand-choice 1 2 3) 0.0)  ; => 1, 2, or 3 at random
(defn rand-choice [& values]
  (let [vec-values (vec values)
        len (len vec-values)]
    (if (== len 0)
      (const nil)
      (fn [_time]
        (get vec-values (rand-int len))))))

;;; rand-int -- pattern returning a random integer in [min, max) each evaluation.
;;;
;;; Parameters:
;;;   min -- minimum value (inclusive)
;;;   max -- maximum value (exclusive)
;;;
;;; Returns:
;;;   NumPattern of random integers.
(defn rand-int [min max]
  (fn [_time] (rand-int (- max min) min)))

;;; rand-float -- pattern returning a random float in [0, 1) each evaluation.
;;;
;;; Returns:
;;;   NumPattern of random floats.
(defn rand-float []
  (fn [_time] (rand-float)))

;;; rand-range -- pattern returning a random float in [min, max) each evaluation.
;;;
;;; Parameters:
;;;   min -- minimum value (inclusive)
;;;   max -- maximum value (exclusive)
;;;
;;; Returns:
;;;   NumPattern.
(defn rand-range [min max]
  (fn [_time] (+ min (* (rand-float) (- max min)))))

;; ============================================================================
;; Value Patterns
;; ============================================================================

;;; identity -- pattern that returns its time argument unchanged.
;;;
;;; Returns:
;;;   NumPattern returning the raw time value.
(defn identity []
  (fn [time] time))

;;; time-pat -- pattern returning the current time value.
;;;
;;; Returns:
;;;   NumPattern that is the identity function over time.
(defn time-pat []
  (fn [time] time))

;;; beat-number -- pattern returning the integer beat number.
;;;
;;; Returns:
;;;   NumPattern returning floor(time).
;;;
;;; Example:
;;;   ((beat-number) 2.7)  ; => 2.0
(defn beat-number []
  (fn [time] (floor time)))

;;; beat-fraction -- pattern returning the fractional part of the current beat.
;;;
;;; Returns:
;;;   NumPattern returning time - floor(time).
;;;
;;; Example:
;;;   ((beat-fraction) 2.7)  ; => 0.7
(defn beat-fraction []
  (fn [time] (- time (floor time))))

;; ============================================================================
;; Binary Choice Pattern
;; ============================================================================

;;; alt -- alternate between two values on even/odd beats.
;;;
;;; Parameters:
;;;   a -- value on even beats
;;;   b -- value on odd beats
;;;
;;; Returns:
;;;   Pattern<T> alternating between a and b.
;;;
;;; Example:
;;;   ((alt 1 2) 0.0)  ; => 1
;;;   ((alt 1 2) 1.0)  ; => 2
(defn alt [a b]
  (fn [time]
    (if (even? (floor time))
      a
      b)))

;;; if-pat -- choose between two values based on a boolean pattern.
;;;
;;; Parameters:
;;;   condition -- Boolean pattern or time -> bool function
;;;   a         -- value when condition is true
;;;   b         -- value when condition is false
;;;
;;; Returns:
;;;   Pattern<T>.
(defn if-pat [condition a b]
  (fn [time]
    (if (condition time)
      a
      b)))

;; ============================================================================
;; Comparison Patterns
;; ============================================================================

;;; every-n -- true when the beat number is a multiple of n.
;;;
;;; Parameters:
;;;   n -- modulo base
;;;
;;; Returns:
;;;   BoolPattern that is true when floor(time) mod n == 0.
;;;
;;; Example:
;;;   ((every-n 4) 4.0)  ; => true
(defn every-n [n]
  (fn [time]
    (== 0 (mod (floor time) n))))

;;; when-mod -- true when beat number mod n equals a given offset.
;;;
;;; Parameters:
;;;   n      -- modulo base
;;;   offset -- target remainder (default: 0)
;;;
;;; Returns:
;;;   BoolPattern.
(defn when-mod [n & [offset 0]]
  (fn [time]
    (== (mod (floor time) n) offset)))

;; ============================================================================
;; Conditional Pattern
;; ============================================================================

;;; when -- gate a pattern through a boolean condition.
;;;
;;; Parameters:
;;;   cond -- Boolean pattern controlling when p fires
;;;   p    -- pattern to gate
;;;   zero -- value returned when cond is false (default: 0)
;;;
;;; Returns:
;;;   Pattern<T>.
;;;
;;; Example:
;;;   (when (every-n 2) (const 1) 0)
(defn when [cond p & [zero 0]]
  (fn [time]
    (if (cond time)
      (p time)
      zero)))

;;; every -- play a pattern only every n beats.
;;;
;;; Parameters:
;;;   n    -- beat interval
;;;   p    -- pattern to play
;;;   zero -- value between triggers (default: 0)
;;;
;;; Returns:
;;;   Pattern<T>.
;;;
;;; Example:
;;;   (every 4 my-pat)
(defn every [n p & [zero 0]]
  (when (every-n n) p zero))

;; ============================================================================
;; Utility Functions
;; ============================================================================

;;; pattern-length -- attempt to determine the cycle length of a pattern.
;;;
;;; Returns:
;;;   nil (cannot be determined statically in general).
(defn pattern-length [p]
  ;; This is a best-effort detection for cycle patterns
  ;; In a real implementation, we might need pattern metadata
  nil)

;;; pattern-constant? -- check whether a pattern is constant.
;;;
;;; Returns:
;;;   false (cannot be determined statically in general).
(defn pattern-constant? [p]
  ;; Can't determine statically in general
  ;; This would require runtime analysis
  false)

;; ============================================================================
;; Pattern Metadata (Optional)
;; ============================================================================

;;; PatternWithMeta -- pattern bundled with introspection metadata.
(defstruct PatternWithMeta<T>
  [pattern :(Pattern<T>)
   name :cstr
   description :cstr
   tags :(vec<cstr>) ])

;;; with-meta -- attach metadata to a pattern.
;;;
;;; Parameters:
;;;   pattern     -- the underlying pattern
;;;   name        -- human-readable name (default: "")
;;;   description -- description of the pattern (default: "")
;;;   tags        -- categorisation tags (default: [])
;;;
;;; Returns:
;;;   PatternWithMeta<T>.
(defn with-meta [pattern & [name "" description "" tags []]]
  {:pattern pattern
   :name name
   :description description
   :tags tags})

;;; pattern-of -- extract the underlying pattern from a PatternWithMeta value.
;;;
;;; Parameters:
;;;   p -- PatternWithMeta<T>
;;;
;;; Returns:
;;;   Pattern<T>.
(defn pattern-of [p]
  (:pattern p))
