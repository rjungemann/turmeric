;; stdlib/tidal/pattern.tur — Core Pattern Type and Constructors
;;
;; This module provides the fundamental Pattern type and basic pattern
;; constructors for the TidalCycles-inspired DSL.

(import tidal/time :time)

;; ============================================================================
;; Core Pattern Type
;; ============================================================================

;; A pattern is a function from time (in beats) to a value of type T
;; The time is the start time of the cycle the pattern is being evaluated for
;;
;; This is the fundamental abstraction: Pattern<T> = Beats -> T
(def-type Pattern<T> (fn [time/time:Beats] :T))

;; Type alias for numeric patterns (most common)
(def-type NumPattern (Pattern<float>))

;; Type alias for integer patterns (e.g., MIDI notes)
(def-type IntPattern (Pattern<int>))

;; Type alias for boolean patterns (e.g., triggers)
(def-type BoolPattern (Pattern<bool>))

;; Type alias for string patterns (e.g., drum names)
(def-type StrPattern (Pattern<cstr>))

;; ============================================================================
;; Pattern Evaluation
;; ============================================================================

;; Apply a pattern at a specific time
;;
;; @param p Pattern to evaluate
;; @param time Time in beats
;; @return Pattern value at that time
(defn pat-at [p time]
  (p time))

;; Evaluate a pattern at time 0
;;
;; @param p Pattern to evaluate
;; @return Pattern value at time 0
(defn pat-start [p]
  (p 0.0))

;; ============================================================================
;; Basic Pattern Constructors
;; ============================================================================

;; Constant pattern - always returns the same value
;;
;; @param value The constant value to return
;; @return Pattern<T> that always returns value
(defn const [value]
  (fn [_time] value))

;; Silence pattern - always returns nothing (for option types)
;; In Turmeric, we use 'none' for silence
;;
;; @return Pattern<option<T>> that always returns none
(defn silence []
  (fn [_time] none))

;; ============================================================================
;; Cycle Patterns
;; ============================================================================

;; Cycle through a list of values, one per beat
;;
;; @param values List of values to cycle through
;; @return Pattern<T> that cycles through values
(defn cycle [& values]
  (let [vec-values (vec values)
        len (len vec-values)]
    (if (== len 0)
      (const nil)  ;; or silence for option types
      (fn [time]
        (let [index (mod (floor time) len)]
          (get vec-values index))))))

;; Cycle through values but at a different rate
;;
;; @param rate How many cycles per whole (default: 1)
;; @param values List of values to cycle through
;; @return Pattern<T>
(defn fast-cycle [rate & values]
  (let [vec-values (vec values)
        len (len vec-values)]
    (if (== len 0)
      (const nil)
      (fn [time]
        (let [index (mod (floor (* time rate)) len)]
          (get vec-values index))))))

;; ============================================================================
;; Phase Pattern
;; ============================================================================

;; Get the current beat position within the cycle (0 to 1)
;;
;; @param cycle_length Length of the cycle in beats (default: 1)
;; @return NumPattern that returns phase within cycle
(defn phase [& [cycle_length 1.0]]
  (fn [time]
    (time/phase time cycle_length)))

;; ============================================================================
;; P Macro for Concise Pattern Syntax
;; ============================================================================

;; Macro for cleaner pattern syntax
;; (P 1 2 3) expands to (cycle 1 2 3)
;; (P 5) expands to (const 5)
(defmacro P [& exprs]
  (if (== (len exprs) 1)
    `(const ~(first exprs))
    `(cycle ~@exprs)))

;; ============================================================================
;; Random Patterns
;; ============================================================================

;; Random choice from a list of values
;;
;; @param values List of values to choose from
;; @return Pattern<T> that returns random values
(defn rand-choice [& values]
  (let [vec-values (vec values)
        len (len vec-values)]
    (if (== len 0)
      (const nil)
      (fn [_time]
        (get vec-values (rand-int len))))))

;; Random integer in range
;;
;; @param min Minimum value (inclusive)
;; @param max Maximum value (exclusive)
;; @return NumPattern that returns random integers
(defn rand-int [min max]
  (fn [_time] (rand-int (- max min) min)))

;; Random float in range [0, 1)
;;
;; @return NumPattern that returns random floats
(defn rand-float []
  (fn [_time] (rand-float)))

;; Random float in range [min, max)
;;
;; @param min Minimum value (inclusive)
;; @param max Maximum value (exclusive)
;; @return NumPattern
(defn rand-range [min max]
  (fn [_time] (+ min (* (rand-float) (- max min)))))

;; ============================================================================
;; Value Patterns
;; ============================================================================

;; Pattern that returns its input value (identity)
;;
;; @return Pattern<T> that returns the input value
(defn identity []
  (fn [time] time))

;; Pattern that returns the time value
;;
;; @return NumPattern that returns the current time
(defn time-pat []
  (fn [time] time))

;; Pattern that returns the beat number (integer part of time)
;;
;; @return NumPattern that returns floor(time)
(defn beat-number []
  (fn [time] (floor time)))

;; Pattern that returns the fractional part of time
;;
;; @return NumPattern that returns time - floor(time)
(defn beat-fraction []
  (fn [time] (- time (floor time))))

;; ============================================================================
;; Binary Choice Pattern
;; ============================================================================

;; Pattern that alternates between two values
;;
;; @param a First value
;; @param b Second value
;; @return Pattern<T> that alternates between a and b
(defn alt [a b]
  (fn [time]
    (if (even? (floor time))
      a
      b)))

;; Pattern that returns a when condition is true, b when false
;;
;; @param condition Boolean pattern or function
;; @param a Value when condition is true
;; @param b Value when condition is false
;; @return Pattern<T>
(defn if-pat [condition a b]
  (fn [time]
    (if (condition time)
      a
      b)))

;; ============================================================================
;; Comparison Patterns
;; ============================================================================

;; Pattern that returns true when time modulo n equals 0
;;
;; @param n Modulo base
;; @return BoolPattern
(defn every-n [n]
  (fn [time]
    (== 0 (mod (floor time) n))))

;; Pattern that returns true when time modulo n equals offset
;;
;; @param n Modulo base
;; @param offset Offset (default: 0)
;; @return BoolPattern
(defn when-mod [n & [offset 0]]
  (fn [time]
    (== (mod (floor time) n) offset)))

;; ============================================================================
;; Conditional Pattern
;; ============================================================================

;; Only play pattern when condition is true, otherwise return zero value
;;
;; @param cond Boolean pattern for condition
;; @param p Pattern to play when condition is true
;; @param zero Value to return when condition is false (default: 0)
;; @return Pattern<T>
(defn when [cond p & [zero 0]]
  (fn [time]
    (if (cond time)
      (p time)
      zero)))

;; Only play pattern every n beats
;;
;; @param n Interval in beats
;; @param p Pattern to play
;; @param zero Value to return between triggers (default: 0)
;; @return Pattern<T>
(defn every [n p & [zero 0]]
  (when (every-n n) p zero))

;; ============================================================================
;; Utility Functions
;; ============================================================================

;; Get the length of a cycle pattern
;;
;; @param p Cycle pattern
;; @return Number of elements in the cycle, or nil if not a cycle pattern
(defn pattern-length [p]
  ;; This is a best-effort detection for cycle patterns
  ;; In a real implementation, we might need pattern metadata
  nil)

;; Check if a pattern is constant
;;
;; @param p Pattern to check
;; @return true if pattern always returns the same value
(defn pattern-constant? [p]
  ;; Can't determine statically in general
  ;; This would require runtime analysis
  false)

;; ============================================================================
;; Pattern Metadata (Optional)
;; ============================================================================

;; Pattern with metadata for introspection
(defstruct PatternWithMeta<T>
  [pattern :(Pattern<T>)
   name :cstr
   description :cstr
   tags :(vec<cstr>) ])

;; Create a pattern with metadata
;;
;; @param pattern The pattern
;; @param name Pattern name
;; @param description Description of what the pattern does
;; @param tags Tags for categorization
;; @return PatternWithMeta<T>
(defn with-meta [pattern & [name "" description "" tags []]]
  {:pattern pattern
   :name name
   :description description
   :tags tags})

;; Get the underlying pattern from a PatternWithMeta
;;
;; @param p PatternWithMeta
;; @return Pattern<T>
(defn pattern-of [p]
  (:pattern p))
