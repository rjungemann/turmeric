;; stdlib/tidal/time.tur -- Time Types and Utilities
;;
;; This module provides time representation and conversion utilities
;; for the TidalCycles-inspired pattern library.

;; ============================================================================
;; Time Type Definitions
;; ============================================================================

;; Time in beats (1.0 = one beat at current tempo)
(def-type Beats float)

;; Time in seconds
(def-type Seconds float)

;; Time in samples (at current sample rate)
(def-type Samples int64)

;; ============================================================================
;; BPM (Beats Per Minute) Utilities
;; ============================================================================

;;; bpm->bps -- convert BPM to beats per second.
;;;
;;; Parameters:
;;;   bpm -- beats per minute
;;;
;;; Returns:
;;;   Beats per second.
;;;
;;; Example:
;;;   (bpm->bps 120.0)  ; => 2.0
(defn bpm->bps [bpm]
  (/ bpm 60.0))

;;; bpm->spb -- convert BPM to seconds per beat.
;;;
;;; Parameters:
;;;   bpm -- beats per minute
;;;
;;; Returns:
;;;   Seconds per beat.
;;;
;;; Example:
;;;   (bpm->spb 120.0)  ; => 0.5
(defn bpm->spb [bpm]
  (/ 60.0 bpm))

;; ============================================================================
;; Beat <-> Second Conversion
;; ============================================================================

;;; beats->sec -- convert a beat count to seconds at a given BPM.
;;;
;;; Parameters:
;;;   beats -- time in beats
;;;   bpm   -- tempo in beats per minute
;;;
;;; Returns:
;;;   Time in seconds.
;;;
;;; Example:
;;;   (beats->sec 4.0 120.0)  ; => 2.0
(defn beats->sec [beats bpm]
  (* beats (bpm->spb bpm)))

;;; sec->beats -- convert seconds to beats at a given BPM.
;;;
;;; Parameters:
;;;   sec -- time in seconds
;;;   bpm -- tempo in beats per minute
;;;
;;; Returns:
;;;   Time in beats.
;;;
;;; Example:
;;;   (sec->beats 2.0 120.0)  ; => 4.0
(defn sec->beats [sec bpm]
  (* sec (bpm->bps bpm)))

;; ============================================================================
;; Beat <-> Sample Conversion
;; ============================================================================

;;; beats->samples -- convert a beat count to sample count.
;;;
;;; Parameters:
;;;   beats       -- time in beats
;;;   bpm         -- tempo in beats per minute
;;;   sample_rate -- samples per second
;;;
;;; Returns:
;;;   Time in samples (floored to integer).
;;;
;;; Example:
;;;   (beats->samples 1.0 120.0 48000)  ; => 24000
(defn beats->samples [beats bpm sample_rate]
  (let [sec (beats->sec beats bpm)]
    (floor (* sec sample_rate))))

;;; samples->beats -- convert a sample count to beat count.
;;;
;;; Parameters:
;;;   samples     -- time in samples
;;;   bpm         -- tempo in beats per minute
;;;   sample_rate -- samples per second
;;;
;;; Returns:
;;;   Time in beats.
(defn samples->beats [samples bpm sample_rate]
  (let [sec (/ samples sample_rate)]
    (sec->beats sec bpm)))

;; ============================================================================
;; Sample <-> Second Conversion
;; ============================================================================

;;; samples->sec -- convert a sample count to seconds.
;;;
;;; Parameters:
;;;   samples     -- time in samples
;;;   sample_rate -- samples per second
;;;
;;; Returns:
;;;   Time in seconds.
(defn samples->sec [samples sample_rate]
  (/ samples sample_rate))

;;; sec->samples -- convert seconds to a sample count.
;;;
;;; Parameters:
;;;   sec         -- time in seconds
;;;   sample_rate -- samples per second
;;;
;;; Returns:
;;;   Time in samples (floored).
(defn sec->samples [sec sample_rate]
  (floor (* sec sample_rate)))

;; ============================================================================
;; Time Interval Utilities
;; ============================================================================

;;; phase -- compute the phase within a cycle (time mod cycle_length).
;;;
;;; Parameters:
;;;   time         -- current time in beats
;;;   cycle_length -- cycle duration in beats (default: 1.0)
;;;
;;; Returns:
;;;   Phase in [0, cycle_length).
;;;
;;; Example:
;;;   (phase 2.7 1.0)  ; => 0.7
(defn phase [time & [cycle_length 1.0]]
  (mod time cycle_length))

;;; bar-phase -- beat position within the current bar.
;;;
;;; Parameters:
;;;   time          -- current time in beats
;;;   beats_per_bar -- beats per bar (default: 4.0)
;;;
;;; Returns:
;;;   Position in [0, beats_per_bar).
(defn bar-phase [time & [beats_per_bar 4.0]]
  (mod time beats_per_bar))

;;; bar-number -- integer bar number at the current beat time.
;;;
;;; Parameters:
;;;   time          -- current time in beats
;;;   beats_per_bar -- beats per bar (default: 4.0)
;;;
;;; Returns:
;;;   Bar index (0-based).
;;;
;;; Example:
;;;   (bar-number 8.5 4.0)  ; => 2.0
(defn bar-number [time & [beats_per_bar 4.0]]
  (floor (/ time beats_per_bar)))

;; ============================================================================
;; Tempo Change Utilities
;; ============================================================================

;; Create a tempo map: time -> BPM
;; This allows for tempo changes over time
(def-type TempoMap (fn [Beats] :float))

;;; const-tempo -- constant tempo map always returning the same BPM.
;;;
;;; Parameters:
;;;   bpm -- constant BPM
;;;
;;; Returns:
;;;   TempoMap.
(defn const-tempo [bpm]
  (fn [_] bpm))

;;; tempo-change -- tempo map with a single step change.
;;;
;;; Parameters:
;;;   start-bpm   -- initial BPM
;;;   change-time -- beat at which tempo changes
;;;   end-bpm     -- BPM after the change
;;;
;;; Returns:
;;;   TempoMap.
;;;
;;; Example:
;;;   ((tempo-change 120.0 8.0 140.0) 10.0)  ; => 140.0
(defn tempo-change [start-bpm change-time end-bpm]
  (fn [time]
    (if (>= time change-time)
      end-bpm
      start-bpm)))

;;; tempo-map -- tempo map with multiple step changes specified as time/bpm pairs.
;;;
;;; Parameters:
;;;   changes -- list of [beat-time bpm] pairs in any order
;;;
;;; Returns:
;;;   TempoMap applying the most recent change at any query time.
(defn tempo-map [& changes]
  (let [sorted (sort-by first changes)]
    (fn [time]
      (loop [i 0]
        (if (>= i (len sorted))
          (second (last sorted))
          (let [[change-time bpm] (get sorted i)]
            (if (>= time change-time)
              (recur (inc i))
              (if (== i 0)
                bpm
                (second (get sorted (dec i)))))))))))

;; ============================================================================
;; Time Warping Utilities
;; ============================================================================

;;; lerp -- linearly interpolate between two values.
;;;
;;; Parameters:
;;;   start -- start value (at time 0)
;;;   end   -- end value (at time 1)
;;;   time  -- interpolation parameter (clamped to [0, 1])
;;;
;;; Returns:
;;;   Interpolated value.
;;;
;;; Example:
;;;   (lerp 0.0 1.0 0.5)  ; => 0.5
(defn lerp [start end time]
  (+ start (* (- end start) (math/clamp time 0.0 1.0))))

;;; exp-lerp -- exponential interpolation between two values.
;;;
;;; Parameters:
;;;   start -- start value (must be > 0 if end > start)
;;;   end   -- end value
;;;   time  -- interpolation parameter (clamped to [0, 1])
;;;
;;; Returns:
;;;   Exponentially interpolated value.
;;;
;;; Example:
;;;   (exp-lerp 100.0 200.0 0.5)  ; => ~141.4
(defn exp-lerp [start end time]
  (let [clamped (math/clamp time 0.0 1.0)]
    (if (== start end)
      start
      (* start (math/pow (/ end start) clamped)))))

;; ============================================================================
;; Default Constants
;; ============================================================================

;; Default BPM (120 beats per minute)
(def DEFAULT_BPM 120.0)

;; Default sample rate (48 kHz)
(def DEFAULT_SAMPLE_RATE 48000)

;; Default block size (512 samples)
(def DEFAULT_BLOCK_SIZE 512)

;; Common time signatures (beats per bar)
(def TS_4_4 4.0)
(def TS_3_4 3.0)
(def TS_6_8 6.0)
(def TS_5_4 5.0)
(def TS_7_8 7.0)
