;; stdlib/tidal/polyrhythm.tur -- Polyrhythm and Polymeter Support
;;
;; This module provides support for polyrhythms (multiple patterns with
;; different time signatures playing simultaneously) and polymeters.

(import tidal/pattern :pattern)
(import tidal/temporal :temporal)
(import tidal/structural :structural)

;; ============================================================================
;; Polymeter Patterns
;; ============================================================================

;;; polymeter -- play a pattern with a different effective meter.
;;;
;;; Parameters:
;;;   ratio -- time scaling ratio (2.0 = twice as slow, 0.5 = twice as fast)
;;;   p     -- pattern to play with the scaled meter
;;;
;;; Returns:
;;;   Pattern<T> evaluated with time * ratio.
;;;
;;; Example:
;;;   ((polymeter 1.5 my-pat) 1.0)  ; reads my-pat at time 1.5
(defn polymeter [ratio p]
  (fn [time]
    (p (* time ratio))))

;;; polyrhythm -- play two patterns with independent cycle lengths.
;;;
;;; Parameters:
;;;   p1   -- first pattern
;;;   len1 -- cycle length for the first pattern in beats
;;;   p2   -- second pattern
;;;   len2 -- cycle length for the second pattern in beats
;;;
;;; Returns:
;;;   Pattern<Tuple T1 T2> combining both patterns at their own tempos.
;;;
;;; Example:
;;;   ((polyrhythm kick-pat 3 snare-pat 2) 0.0)
(defn polyrhythm [p1 len1 p2 len2]
  (fn [time]
    (tuple (p1 (/ time len1)) (p2 (/ time len2)))))

;;; polyrhythm-n -- play any number of patterns with independent cycle lengths.
;;;
;;; Parameters:
;;;   pattern-lengths -- list of [pattern length] tuples
;;;
;;; Returns:
;;;   Pattern<vec<T>> with one element per sub-pattern.
(defn polyrhythm-n [& pattern-lengths]
  (let [pairs (vec pattern-lengths)]
    (fn [time]
      (vec (map (fn [[p len]] (p (/ time len))) pairs)))))

;; ============================================================================
;; Nested Patterns
;; ============================================================================

;;; nest -- evaluate a pattern of patterns: outer selects the inner, inner is evaluated.
;;;
;;; Parameters:
;;;   outer            -- Pattern producing inner patterns
;;;   inner-time-scale -- time scaling applied before evaluating outer (default: 1.0)
;;;
;;; Returns:
;;;   Pattern<T> that delegates to the pattern returned by outer.
(defn nest [outer & [inner-time-scale 1.0]]
  (fn [time]
    (let [inner-pat (outer (/ time inner-time-scale))]
      (inner-pat time))))

;;; nest2 -- nested pattern with independent time scales for outer and inner.
;;;
;;; Parameters:
;;;   outer            -- Pattern producing inner patterns
;;;   outer-time-scale -- scaling applied to time when querying outer
;;;   inner-time-scale -- scaling applied to time when querying the selected inner pattern
;;;
;;; Returns:
;;;   Pattern<T>.
(defn nest2 [outer outer-time-scale inner-time-scale]
  (fn [time]
    (let [inner-pat (outer (* time outer-time-scale))]
      (inner-pat (* time inner-time-scale)))))

;; ============================================================================
;; Canon (Delayed Copies)
;; ============================================================================

;;; canon -- play delayed copies of a pattern stacked together.
;;;
;;; Parameters:
;;;   p      -- pattern to copy
;;;   copies -- number of copies to create
;;;   delay  -- time offset between successive copies in beats (default: 0.25)
;;;
;;; Returns:
;;;   Pattern<vec<T>> with copies offset by delay * i for i in [0, copies).
;;;
;;; Example:
;;;   ((canon my-pat 3 0.25) 0.0)
(defn canon [p copies delay]
  (fn [time]
    (vec (map (fn [i] (p (+ time (* i delay)))) (range 0 copies)))))

;;; canon-n -- play copies of a pattern with individually specified delays.
;;;
;;; Parameters:
;;;   p      -- pattern to copy
;;;   delays -- list of per-copy delay offsets
;;;
;;; Returns:
;;;   Pattern<vec<T>>.
(defn canon-n [p & delays]
  (let [vec-delays (vec delays)]
    (fn [time]
      (vec (map (fn [i] (p (+ time (get vec-delays i)))) (range 0 (len vec-delays)))))))

;; ============================================================================
;; Phase-Shifted Copies
;; ============================================================================

;;; spread -- phase-spread copies of a pattern across a time window.
;;;
;;; Parameters:
;;;   p             -- pattern to spread
;;;   copies        -- number of copies
;;;   spread-amount -- total time window to spread across in beats (default: 1.0)
;;;
;;; Returns:
;;;   Pattern<vec<T>> with copies evenly spaced in [0, spread-amount).
;;;
;;; Example:
;;;   ((spread my-pat 4 1.0) 0.0)
(defn spread [p copies spread-amount]
  (fn [time]
    (vec (map (fn [i] (p (+ time (* (/ i copies) spread-amount)))) (range 0 copies)))))

;;; spread-n -- phase-spread copies with individually specified offsets.
;;;
;;; Parameters:
;;;   p       -- pattern to spread
;;;   spreads -- list of per-copy phase offsets
;;;
;;; Returns:
;;;   Pattern<vec<T>>.
(defn spread-n [p & spreads]
  (let [vec-spreads (vec spreads)]
    (fn [time]
      (vec (map (fn [i] (p (+ time (get vec-spreads i)))) (range 0 (len vec-spreads)))))))

;; ============================================================================
;; Stack with Polymeter
;; ============================================================================

;;; stack-polymeter -- stack patterns each running at their own meter.
;;;
;;; Parameters:
;;;   pattern-meters -- list of [pattern meter] tuples
;;;
;;; Returns:
;;;   Pattern<vec<T>> with one element per voice.
(defn stack-polymeter [& pattern-meters]
  (let [pairs (vec pattern-meters)]
    (fn [time]
      (vec (map (fn [[p meter]] (p (* time meter))) pairs)))))

;;; stack-polyrhythm -- stack patterns each with their own cycle lengths.
;;;
;;; Parameters:
;;;   pattern-lengths -- list of [pattern length] tuples
;;;
;;; Returns:
;;;   Pattern<vec<T>>.
(defn stack-polyrhythm [& pattern-lengths]
  (stack-polymeter pattern-lengths...))

;; ============================================================================
;; Time Signature Support
;; ============================================================================

;;; timesig -- apply a sequence of time signatures to a pattern.
;;;
;;; Parameters:
;;;   p    -- pattern to apply time signatures to
;;;   sigs -- list of [beats-per-bar sub-beats-per-bar] tuples
;;;
;;; Returns:
;;;   Pattern<T> with normalised time within each bar.
(defn timesig [p & sigs]
  (let [signature-list (vec sigs)
        len (len signature-list)]
    (if (== len 0)
      p
      (fn [time]
        (let [;; Find current time signature
              [beats-per-bar _ accumulated-beats] (loop [i 0 acc 0.0]
                                                    (if (>= i len)
                                                      [(or (first (last signature-list)) 4.0) acc]
                                                      (let [[bpb sbpb] (get signature-list i)]
                                                        (if (>= time (+ acc bpb))
                                                          (recur (inc i) (+ acc bpb))
                                                          [bpb acc]))))
              bar-phase (mod (- time accumulated-beats) beats-per-bar)
              normalized-time (/ bar-phase beats-per-bar)]
          (p normalized-time))))))

;;; make-timesig -- construct a time signature specification.
;;;
;;; Parameters:
;;;   beats-per-bar    -- beats per bar (e.g., 4 for 4/4, 3 for 3/4)
;;;   sub-beats-per-bar -- sub-divisions per beat (e.g., 4 for 16th notes)
;;;
;;; Returns:
;;;   A [beats-per-bar sub-beats-per-bar] pair.
(defn make-timesig [beats-per-bar sub-beats-per-bar]
  [beats-per-bar sub-beats-per-bar])

;; ============================================================================
;; Polyrhythm Presets
;; ============================================================================

;;; three-against-two -- classic 3:2 polyrhythm.
;;;
;;; Parameters:
;;;   p1 -- pattern for the 3-beat group
;;;   p2 -- pattern for the 2-beat group
;;;
;;; Returns:
;;;   Pattern<Tuple T1 T2>.
(defn three-against-two [p1 p2]
  (polyrhythm p1 3 p2 2))

;;; four-against-three -- 4:3 polyrhythm.
;;;
;;; Parameters:
;;;   p1 -- pattern for the 4-beat group
;;;   p2 -- pattern for the 3-beat group
;;;
;;; Returns:
;;;   Pattern<Tuple T1 T2>.
(defn four-against-three [p1 p2]
  (polyrhythm p1 4 p2 3))

;;; five-against-four -- 5:4 polyrhythm.
;;;
;;; Parameters:
;;;   p1 -- pattern for the 5-beat group
;;;   p2 -- pattern for the 4-beat group
;;;
;;; Returns:
;;;   Pattern<Tuple T1 T2>.
(defn five-against-four [p1 p2]
  (polyrhythm p1 5 p2 4))

;;; five-against-three -- 5:3 polyrhythm.
;;;
;;; Parameters:
;;;   p1 -- pattern for the 5-beat group
;;;   p2 -- pattern for the 3-beat group
;;;
;;; Returns:
;;;   Pattern<Tuple T1 T2>.
(defn five-against-three [p1 p2]
  (polyrhythm p1 5 p2 3))

;;; seven-against-four -- 7:4 polyrhythm.
;;;
;;; Parameters:
;;;   p1 -- pattern for the 7-beat group
;;;   p2 -- pattern for the 4-beat group
;;;
;;; Returns:
;;;   Pattern<Tuple T1 T2>.
(defn seven-against-four [p1 p2]
  (polyrhythm p1 7 p2 4))

;; ============================================================================
;; Polyrhythm with Different Starting Points
;; ============================================================================

;;; polyrhythm-offset -- polyrhythm with independent phase offsets per pattern.
;;;
;;; Parameters:
;;;   p1      -- first pattern
;;;   len1    -- cycle length for first pattern
;;;   offset1 -- phase offset for first pattern
;;;   p2      -- second pattern
;;;   len2    -- cycle length for second pattern
;;;   offset2 -- phase offset for second pattern
;;;
;;; Returns:
;;;   Pattern<Tuple T1 T2>.
(defn polyrhythm-offset [p1 len1 offset1 p2 len2 offset2]
  (fn [time]
    (tuple (p1 (/ (+ time offset1) len1)) (p2 (/ (+ time offset2) len2)))))

;; ============================================================================
;; Polyrhythm with Custom Phasing
;; ============================================================================

;;; polyrhythm-phased -- polyrhythm with per-pattern length and phase.
;;;
;;; Parameters:
;;;   patterns-and-phases -- list of [pattern length phase] triples
;;;
;;; Returns:
;;;   Pattern<vec<T>>.
(defn polyrhythm-phased [& patterns-and-phases]
  (let [triples (vec patterns-and-phases)]
    (fn [time]
      (vec (map (fn [[p len phase]] (p (/ (+ time phase) len))) triples)))))

;; ============================================================================
;; Metric Modulation
;; ============================================================================

;;; metric-mod -- apply an arbitrary time mapping to a pattern.
;;;
;;; Parameters:
;;;   p             -- pattern to modulate
;;;   modulation-fn -- Beats -> Beats time remapping function
;;;
;;; Returns:
;;;   Pattern<T> evaluated at modulation-fn(time).
(defn metric-mod [p modulation-fn]
  (fn [time]
    (p (modulation-fn time))))

;;; metric-mod-linear -- apply a piecewise linear time mapping.
;;;
;;; Parameters:
;;;   p           -- pattern to modulate
;;;   breakpoints -- list of [input-time output-time] pairs
;;;
;;; Returns:
;;;   Pattern<T> with piecewise linear time mapping.
(defn metric-mod-linear [p & breakpoints]
  (let [sorted (sort-by first breakpoints)]
    (fn [time]
      (let [[_ _ in-start in-end out-start out-end]
            (loop [i 0]
              (if (>= i (dec (len sorted)))
                (let [[in-t out-t] (last sorted)]
                  [in-t out-t in-t out-t out-t out-t])
                (let [[in-t out-t] (get sorted i)
                      [next-in _] (get sorted (inc i))]
                  (if (<= time next-in)
                    [in-t out-t next-in out-t in-t out-t]
                    (recur (inc i))))))]
        (if (<= time in-start)
          out-start
          (if (>= time in-end)
            out-end
            (time/lerp out-start out-end (/ (- time in-start) (- in-end in-start)))))))))

;; ============================================================================
;; Polyrhythm Utilities
;; ============================================================================

;;; lcm -- least common multiple of two integers.
;;;
;;; Parameters:
;;;   a -- first number
;;;   b -- second number
;;;
;;; Returns:
;;;   LCM of a and b.
(defn lcm [a b]
  (/ (* a b) (gcd a b)))

;;; gcd -- greatest common divisor using the Euclidean algorithm.
;;;
;;; Parameters:
;;;   a -- first number
;;;   b -- second number
;;;
;;; Returns:
;;;   GCD of a and b.
(defn gcd [a b]
  (if (== b 0)
    a
    (recur b (mod a b))))

;;; polyrhythm-alignment -- find the beat at which all polyrhythm patterns realign.
;;;
;;; Parameters:
;;;   lengths -- list of cycle lengths
;;;
;;; Returns:
;;;   The LCM of all lengths (time at which all patterns complete together).
;;;
;;; Example:
;;;   (polyrhythm-alignment 3 4)  ; => 12
(defn polyrhythm-alignment [& lengths]
  (reduce lcm 1 lengths))

;; ============================================================================
;; Cross-Rhythm Patterns
;; ============================================================================

;;; cross-rhythm -- polyrhythm with per-pattern phase offsets.
;;;
;;; Parameters:
;;;   p1     -- first pattern
;;;   len1   -- cycle length for first pattern
;;;   p2     -- second pattern
;;;   len2   -- cycle length for second pattern
;;;   phase1 -- phase offset for first pattern (default: 0)
;;;   phase2 -- phase offset for second pattern (default: 0)
;;;
;;; Returns:
;;;   Pattern<Tuple T1 T2>.
(defn cross-rhythm [p1 len1 p2 len2 & [phase1 0 phase2 0]]
  (fn [time]
    (tuple (p1 (+ phase1 (/ time len1))) (p2 (+ phase2 (/ time len2))))))

;; ============================================================================
;; Hocketing
;; ============================================================================

;;; hocket -- distribute a pattern's output across multiple voices.
;;;
;;; Parameters:
;;;   p        -- source pattern
;;;   voices   -- number of voices to distribute across
;;;   selector -- IntPattern selecting the active voice (default: cycle 0..voices-1)
;;;
;;; Returns:
;;;   Pattern<vec<T>> where only the selected voice receives the pattern value.
;;;
;;; Example:
;;;   ((hocket my-pat 3) 0.0)
(defn hocket [p voices & [selector (cycle (range 0 voices))]]
  (fn [time]
    (let [v (p time)
          selected-voice (selector time)]
      (vec (map (fn [i] (if (== i selected-voice) v nil)) (range 0 voices))))))
