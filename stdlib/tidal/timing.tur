;; stdlib/tidal/timing.tur -- Sample-Accurate Timing
;;
;; This module provides sample-accurate timing utilities for pattern evaluation.

(import tidal/time :time)
(import tidal/pattern :pattern)

;; ============================================================================
;; Beat Clock
;; ============================================================================

;;; BeatClock -- tracks beat time from a running sample counter.
(defstruct BeatClock
  [bpm :float
   start-time :Seconds
   samples-per-beat :float
   sample-rate :float
   current-sample :Samples])

;;; make-beat-clock -- create a new beat clock at the given BPM and sample rate.
;;;
;;; Parameters:
;;;   bpm         -- beats per minute
;;;   sample-rate -- audio sample rate in Hz
;;;
;;; Returns:
;;;   BeatClock starting at sample 0.
;;;
;;; Example:
;;;   (make-beat-clock 120.0 48000.0)
(defn make-beat-clock [bpm sample-rate]
  {:bpm bpm
   :start-time 0.0
   :samples-per-beat (/ sample-rate (time/bpm->bps bpm))
   :sample-rate sample-rate
   :current-sample 0})

;;; clock->beats -- convert a sample offset to beats.
;;;
;;; Parameters:
;;;   clock         -- BeatClock
;;;   sample-offset -- sample count from clock start
;;;
;;; Returns:
;;;   Beats value.
(defn clock->beats [clock sample-offset]
  (/ sample-offset (:samples-per-beat clock)))

;;; clock->samples -- convert a beat offset to samples.
;;;
;;; Parameters:
;;;   clock  -- BeatClock
;;;   beats  -- beat count from clock start
;;;
;;; Returns:
;;;   Sample count.
(defn clock->samples [clock beats]
  (* beats (:samples-per-beat clock)))

;;; clock-advance -- advance the clock by a number of samples.
;;;
;;; Parameters:
;;;   clock   -- BeatClock to advance
;;;   samples -- number of samples to advance
;;;
;;; Returns:
;;;   Updated BeatClock.
(defn clock-advance [clock samples]
  (update clock :current-sample + samples))

;;; clock-now -- get the current beat time from a clock.
;;;
;;; Parameters:
;;;   clock -- BeatClock
;;;
;;; Returns:
;;;   Current beat time as a float.
(defn clock-now [clock]
  (clock->beats clock (:current-sample clock)))

;; ============================================================================
;; Sample-Accurate Scheduler
;; ============================================================================

;;; ScheduledEvent -- an event queued for future execution at a specific beat.
(defstruct ScheduledEvent
  [time :time/Beats        ;; When to trigger (in beats)
   callback :(fn [] :void)  ;; Function to call
   node-id :int           ;; Optional node ID for tracking
   pattern :option<pattern/Pattern<map>>])

;;; EventQueue -- ordered queue of scheduled events.
(defstruct EventQueue
  [events :(vec<ScheduledEvent>)])

;;; queue-new -- create an empty event queue.
;;;
;;; Returns:
;;;   Empty EventQueue.
(defn queue-new []
  {:events []})

;;; queue-push -- add an event to an event queue.
;;;
;;; Parameters:
;;;   queue -- EventQueue to add to
;;;   event -- ScheduledEvent to enqueue
;;;
;;; Returns:
;;;   Updated EventQueue.
(defn queue-push [queue event]
  (update queue :events conj event))

;;; queue-pop -- remove and return the earliest event from the queue.
;;;
;;; Parameters:
;;;   queue -- EventQueue
;;;
;;; Returns:
;;;   ScheduledEvent or nil if the queue is empty.
(defn queue-pop [queue]
  (when (not (empty? (:events queue)))
    (let [sorted (sort-by :time (:events queue))]
      (update queue :events rest))))

;;; queue-peek -- look at the earliest event without removing it.
;;;
;;; Parameters:
;;;   queue -- EventQueue
;;;
;;; Returns:
;;;   ScheduledEvent or nil if the queue is empty.
(defn queue-peek [queue]
  (when (not (empty? (:events queue)))
    (first (sort-by :time (:events queue)))))

;;; PatternScheduler -- scheduler combining a beat clock with an event queue.
(defstruct PatternScheduler
  [clock :BeatClock
   queue :EventQueue
   patterns :(map<int pattern/Pattern<map>>)
   synths :(map<int int>)  ;; node-id -> pattern-id
   next-id :int])

;;; scheduler-new -- create a new pattern scheduler.
;;;
;;; Parameters:
;;;   clock -- BeatClock to drive the scheduler
;;;
;;; Returns:
;;;   PatternScheduler with empty queues.
(defn scheduler-new [clock]
  {:clock clock
   :queue (queue-new)
   :patterns {}
   :synths {}
   :next-id 0})

;;; schedule-pattern -- schedule a pattern to be evaluated at a specific beat.
;;;
;;; Parameters:
;;;   sched    -- PatternScheduler
;;;   pattern  -- pattern to evaluate when triggered
;;;   at-beat  -- beat time to trigger
;;;   callback -- function called with the pattern result
;;;
;;; Returns:
;;;   Event ID.
(defn schedule-pattern [sched pattern at-beat callback]
  (let [event {:time at-beat
               :callback (fn [] (callback (pattern at-beat)))
               :node-id nil
               :pattern (some pattern)}]
    (queue-push (:queue sched) event)
    (let [id (:next-id sched)]
      (update sched :next-id inc))))

;;; schedule-param -- schedule a synth parameter update at a specific beat.
;;;
;;; Parameters:
;;;   sched   -- PatternScheduler
;;;   node-id -- synth node ID to update
;;;   pattern -- pattern to evaluate
;;;   at-beat -- beat time to update
;;;
;;; Returns:
;;;   Event ID.
(defn schedule-param [sched node-id pattern at-beat]
  (let [id (:next-id sched)]
    (queue-push (:queue sched)
                {:time at-beat
                 :callback (fn []
                             (panic "schedule-param callback: not yet implemented (requires synth parameter update integration)"))
                 :node-id node-id
                 :pattern (some pattern)})
    (update sched :next-id inc)))

;;; process-events -- fire all events due at or before current-beat.
;;;
;;; Parameters:
;;;   sched        -- PatternScheduler
;;;   current-beat -- current beat time
;;;
;;; Returns:
;;;   Number of events processed.
(defn process-events [sched current-beat]
  (let [count 0]
    (while (and (not (empty? (:events (:queue sched))))
               (<= (:time (queue-peek (:queue sched))) current-beat))
      (let [event (queue-pop (:queue sched))]
        (when (:callback event)
          ((:callback event)))
        (set! count (inc count))))
    count))

;;; process-samples -- advance the clock by samples and fire due events.
;;;
;;; Parameters:
;;;   sched   -- PatternScheduler
;;;   samples -- number of samples to advance
;;;
;;; Returns:
;;;   Number of events processed.
(defn process-samples [sched samples]
  (let [old-sample (:current-sample (:clock sched))
        new-sample (+ old-sample samples)]
    (set! sched (update sched :clock clock-advance samples))
    (let [current-beat (clock-now (:clock sched))]
      (process-events sched current-beat))))

;; ============================================================================
;; Audio-Rate Pattern Evaluation
;; ============================================================================

;;; audio-pattern -- wrap a pattern for audio-rate evaluation using sample offsets.
;;;
;;; Parameters:
;;;   p     -- NumPattern to evaluate
;;;   clock -- BeatClock for timing
;;;
;;; Returns:
;;;   Function: Samples -> float that evaluates p at the corresponding beat.
(defn audio-pattern [p clock]
  (let [start-beat 0.0]
    (fn [sample-offset]
      (let [beat-offset (clock->beats clock sample-offset)
            current-beat (+ start-beat beat-offset)]
        (p current-beat)))))

;;; mix-audio-patterns -- mix multiple audio-rate patterns by summation.
;;;
;;; Parameters:
;;;   patterns -- list of audio-rate functions (Samples -> float)
;;;
;;; Returns:
;;;   Function: Samples -> float returning the sum of all patterns.
(defn mix-audio-patterns [& patterns]
  (fn [sample-offset]
    (reduce + 0.0 (map #(% sample-offset) patterns))))

;;; audio-pattern-block -- render a block of audio from a pattern.
;;;
;;; Parameters:
;;;   p          -- NumPattern
;;;   clock      -- BeatClock
;;;   block-size -- number of samples per block
;;;
;;; Returns:
;;;   Function: (output-buffer, sample-offset) -> void writing block-size samples.
(defn audio-pattern-block [p clock block-size]
  (let [audio-fn (audio-pattern p clock)]
    (fn [output-buffer sample-offset]
      (for [i (range 0 block-size)]
        (let [samples (+ sample-offset i)]
          (ptr/write output-buffer i (audio-fn samples)))))))

;; ============================================================================
;; Sample-Accurate Pattern
;; ============================================================================

;;; SampleAccuratePattern -- pattern with sample-accurate timing state.
(defstruct SampleAccuratePattern
  [pattern :pattern/Pattern<float>
   clock :BeatClock
   last-sample :Samples
   last-value :float])

;;; make-sample-accurate -- wrap a pattern for sample-accurate evaluation.
;;;
;;; Parameters:
;;;   p     -- pattern to wrap
;;;   clock -- BeatClock
;;;
;;; Returns:
;;;   SampleAccuratePattern.
(defn make-sample-accurate [p clock]
  {:pattern p
   :clock clock
   :last-sample 0
   :last-value 0.0})

;;; sap-eval -- evaluate a sample-accurate pattern at a sample offset.
;;;
;;; Parameters:
;;;   sap           -- SampleAccuratePattern
;;;   sample-offset -- sample position to evaluate at
;;;
;;; Returns:
;;;   Pattern value at the corresponding beat.
(defn sap-eval [sap sample-offset]
  (let [beats (clock->beats (:clock sap) sample-offset)]
    ((:pattern sap) beats)))

;;; sap-update -- advance a sample-accurate pattern to a new sample position.
;;;
;;; Parameters:
;;;   sap        -- SampleAccuratePattern
;;;   new-sample -- new sample position
;;;
;;; Returns:
;;;   Updated SampleAccuratePattern with cached last value.
(defn sap-update [sap new-sample]
  (assoc sap :last-sample new-sample :last-value (sap-eval sap new-sample)))

;; ============================================================================
;; Timing Utilities
;; ============================================================================

;;; samples->beats -- convert sample count to beats.
;;;
;;; Parameters:
;;;   samples     -- sample count
;;;   bpm         -- tempo in BPM
;;;   sample-rate -- audio sample rate
;;;
;;; Returns:
;;;   Beat time.
(defn samples->beats [samples bpm sample-rate]
  (time/samples->beats samples bpm sample-rate))

;;; beats->samples -- convert beat time to sample count.
;;;
;;; Parameters:
;;;   beats       -- beat time
;;;   bpm         -- tempo in BPM
;;;   sample-rate -- audio sample rate
;;;
;;; Returns:
;;;   Sample count.
(defn beats->samples [beats bpm sample-rate]
  (time/beats->samples beats bpm sample-rate))

;; ============================================================================
;; Tempo Tracking
;; ============================================================================

;;; TempoTracker -- tracks beat time across multiple tempo changes.
(defstruct TempoTracker
  [bpm :float
   start-sample :Samples
   sample-rate :float
   tempo-changes :(vec<tuple<Samples float>>)])  ;; [sample bpm] pairs

;;; tempo-tracker-new -- create a new tempo tracker at a constant initial BPM.
;;;
;;; Parameters:
;;;   bpm         -- initial BPM
;;;   sample-rate -- audio sample rate
;;;
;;; Returns:
;;;   TempoTracker with no tempo changes.
(defn tempo-tracker-new [bpm sample-rate]
  {:bpm bpm
   :start-sample 0
   :sample-rate sample-rate
   :tempo-changes []})

;;; tempo-change -- record a tempo change at a specific sample position.
;;;
;;; Parameters:
;;;   tracker   -- TempoTracker
;;;   at-sample -- sample position of the tempo change
;;;   new-bpm   -- new BPM after the change
;;;
;;; Returns:
;;;   Updated TempoTracker.
(defn tempo-change [tracker at-sample new-bpm]
  (update tracker :tempo-changes conj [at-sample new-bpm]))

;;; tempo-at -- query the BPM at a specific sample position.
;;;
;;; Parameters:
;;;   tracker -- TempoTracker
;;;   sample  -- sample position to query
;;;
;;; Returns:
;;;   BPM at that sample.
(defn tempo-at [tracker sample]
  (let [changes (:tempo-changes tracker)]
    (loop [i 0 current-bpm (:bpm tracker)]
      (if (>= i (len changes))
        current-bpm
        (let [[change-sample change-bpm] (get changes i)]
          (if (>= sample change-sample)
            (recur (inc i) change-bpm)
            current-bpm))))))

;;; beats-at -- compute beat time at a sample accounting for tempo changes.
;;;
;;; Parameters:
;;;   tracker -- TempoTracker
;;;   sample  -- sample position to query
;;;
;;; Returns:
;;;   Beat time at that sample.
(defn beats-at [tracker sample]
  (let [changes (:tempo-changes tracker)
        sample-rate (:sample-rate tracker)]
    (loop [i 0 current-sample 0 current-beats 0.0 current-bpm (:bpm tracker)]
      (if (>= i (len changes))
        (+ current-beats (/ (- sample current-sample) (* (time/bpm->spb current-bpm) sample-rate)))
        (let [[change-sample change-bpm] (get changes i)
              segment-samples (- change-sample current-sample)
              segment-beats (/ segment-samples (* (time/bpm->spb current-bpm) sample-rate))]
          (if (>= sample change-sample)
            (recur (inc i) change-sample (+ current-beats segment-beats) change-bpm)
            (+ current-beats (/ (- sample current-sample) (* (time/bpm->spb current-bpm) sample-rate)))))))))

;; ============================================================================
;; Sample-Accurate Scheduling
;; ============================================================================

;;; schedule-at-sample -- schedule a callback to fire at a specific sample position.
;;;
;;; Parameters:
;;;   sched     -- PatternScheduler
;;;   at-sample -- sample position to trigger
;;;   callback  -- function to call
;;;
;;; Returns:
;;;   Event ID.
(defn schedule-at-sample [sched at-sample callback]
  (let [at-beat (samples->beats at-sample (:bpm (:clock sched)) (:sample-rate (:clock sched)))]
    (schedule-pattern sched (pattern/const 0) at-beat callback)))

;;; schedule-pattern-at-sample -- schedule a pattern evaluation at a sample position.
;;;
;;; Parameters:
;;;   sched     -- PatternScheduler
;;;   at-sample -- sample position to trigger
;;;   pattern   -- pattern to evaluate
;;;   callback  -- function called with the result
;;;
;;; Returns:
;;;   Event ID.
(defn schedule-pattern-at-sample [sched at-sample pattern callback]
  (let [at-beat (samples->beats at-sample (:bpm (:clock sched)) (:sample-rate (:clock sched)))]
    (schedule-pattern sched pattern at-beat callback)))
