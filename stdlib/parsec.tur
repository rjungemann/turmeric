;;; tur/parsec -- parser combinator library built on the backtracking monad.
;;;
;;; Provides char, string, satisfy, many, sepBy, between, and friends.
;;;
;;; Since: Phase B1
;; stdlib/parsec.tur -- Parser combinator library
;;
;; Built on the backtracking monad (list monad, inlined from backtrack.tur).
;;
;; Parser<a> = fat-closure: Input -> list (Pair a Input)
;;
;;   Input  = { int64_t str (cstr as int64_t), int64_t pos }
;;   Pair   = { int64_t first, int64_t second }
;;   Cell   = { int64_t value, int64_t next }  (backtrack result list)
;;
;; Calling conventions:
;;   • Parser constructors return :ptr<void>  (fat closure pointer)
;;   • Functions accepting parsers take :int  (the int64_t of the pointer)
;;   • A constructor whose body is a captureless `(fn ...)` annotates its
;;     return as `^fat :ptr<void>` so the compiler boxes the bare function
;;     pointer into a one-cell fat closure at the tail. This replaces the
;;     old dead-`sentinel`-capture trick that forced the fat ABI by hand.
;;
;; stdlib-hkt-consolidation T2: Parser is exposed as a kind-(* -> *) opaque type
;; constructor `(Parser A)` so it can carry real Functor / Applicative / Monad /
;; Alternative instances. The runtime carrier is unchanged -- a Parser handle is
;; still the same fat-closure pointer the raw combinators below build -- the
;; phantom parameter A only lets us spell the instance heads. With the instances
;; in place, parser code uses the generic `do-m` / `for` / `bind` / `alt-or`
;; surface from stdlib/macros.tur instead of the bespoke bind-parser/or-parser
;; combinators (which remain as the internal workers the instances delegate to).
;;; Parser -- a kind-(* -> *) handle over a backtracking parser; carrier is the
;;; fat-closure pointer (Input -> list (Pair A Input)).
;;;
;;; Since: stdlib-hkt-consolidation T2
(defopaque Parser [A] :ptr<void>)
;;; ── Backtracking monad (inlined from backtrack.tur) ──────────────────────────
;;; mzero -- return the empty backtracking result (failure).
;;;
;;; Returns:
;;;   0, the null pointer representing no results.
;;;
;;; Example:
;;;   (mzero)  ; => 0

(defn mzero [] : int ```c return 0; ```)
;;; mreturn -- lift a single value into the backtracking monad.
;;;
;;; Parameters:
;;;   x -- the int64_t value to wrap.
;;;
;;; Returns:
;;;   A newly allocated Cell containing x with a null next pointer.
;;;
;;; Example:
;;;   (mreturn 42)  ; => Cell{value=42, next=NULL}

(defn mreturn [x] : int
  ```c
  struct { int64_t value; int64_t next; } *cell = malloc(sizeof(*cell));
  cell->value = x; cell->next = 0;
  return (int64_t)(intptr_t)cell;
  ```)
;;; mplus -- concatenate two backtracking result lists.
;;;
;;; Parameters:
;;;   xs -- the first Cell list (copied into a fresh list).
;;;   ys -- the second Cell list (appended by pointer, not copied).
;;;
;;; Returns:
;;;   A new Cell list containing all results from xs followed by ys.
;;;
;;; Example:
;;;   (mplus (mreturn 1) (mreturn 2))  ; => Cell{1} -> Cell{2}

(defn mplus [xs ys] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *xc = (Cell*)(intptr_t)xs;
  if (!xc) return ys;
  Cell *head = NULL, *tail = NULL;
  while (xc) {
      Cell *n = malloc(sizeof(Cell));
      n->value = xc->value; n->next = 0;
      if (tail) tail->next = (int64_t)(intptr_t)n; else head = n;
      tail = n; xc = (Cell*)(intptr_t)xc->next;
  }
  if (tail) tail->next = ys;
  return (int64_t)(intptr_t)head;
  ```)
;;; mbind -- monadic bind for the backtracking monad.
;;;
;;; Parameters:
;;;   ma -- a Cell list of values to thread through fn.
;;;   fn -- a fat closure of type int64_t -> Cell list.
;;;
;;; Returns:
;;;   The concatenated results of applying fn to every value in ma,
;;;   preserving original order.
;;;
;;; Example:
;;;   (mbind (mreturn 1) (fn [x] (mreturn (* x 2))))  ; => Cell{2}

(defn mbind [ma : int ^borrow ^fat fn : int] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *cell = (Cell*)(intptr_t)ma;
  if (!cell) return 0;
  int64_t *fat = (int64_t*)(intptr_t)fn;
  int64_t thunk = fat[0];
  Cell *rev = NULL;
  while (cell) {
      int64_t sub = ((int64_t(*)(void*, int64_t))(intptr_t)thunk)((void*)fat, cell->value);
      Cell *sc = (Cell*)(intptr_t)sub;
      while (sc) {
          Cell *n = malloc(sizeof(Cell));
          n->value = sc->value; n->next = (int64_t)(intptr_t)rev; rev = n;
          sc = (Cell*)(intptr_t)sc->next;
      }
      cell = (Cell*)(intptr_t)cell->next;
  }
  Cell *result = NULL;
  while (rev) {
      Cell *tmp = (Cell*)(intptr_t)rev->next;
      rev->next = (int64_t)(intptr_t)result; result = rev; rev = tmp;
  }
  return (int64_t)(intptr_t)result;
  ```)
;;; bt-nil -- return the empty backtracking list.
;;;
;;; Returns:
;;;   0 (null pointer).

(defn bt-nil [] : int ```c return 0; ```)
;;; bt-cons -- prepend a value onto a backtracking Cell list.
;;;
;;; Parameters:
;;;   v   -- the int64_t value to prepend.
;;;   nxt -- the existing Cell list to prepend onto.
;;;
;;; Returns:
;;;   A new Cell with value v pointing to nxt.
;;;
;;; Example:
;;;   (bt-cons 3 (bt-nil))  ; => Cell{3, NULL}

(defn bt-cons [v nxt] : int
  ```c
  struct { int64_t value; int64_t next; } *cell = malloc(sizeof(*cell));
  cell->value = v; cell->next = nxt;
  return (int64_t)(intptr_t)cell;
  ```)
;;; bt-length -- count elements in a backtracking Cell list.
;;;
;;; Parameters:
;;;   xs -- the Cell list to measure.
;;;
;;; Returns:
;;;   The number of cells in the list as an int64_t.
;;;
;;; Example:
;;;   (bt-length (bt-cons 1 (bt-cons 2 (bt-nil))))  ; => 2

(defn bt-length [xs] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  int64_t n = 0;
  Cell *c = (Cell*)(intptr_t)xs;
  while (c) { n++; c = (Cell*)(intptr_t)c->next; }
  return n;
  ```)
;;; ── Pair helpers ─────────────────────────────────────────────────────────────
;;; pair-new -- allocate a new Pair holding two int64_t values.
;;;
;;; Parameters:
;;;   a -- the first field value.
;;;   b -- the second field value.
;;;
;;; Returns:
;;;   Pointer (as int64_t) to a heap-allocated Pair{first=a, second=b}.
;;;
;;; Example:
;;;   (pair-new 1 2)  ; => Pair{first=1, second=2}


(defn pair-new [a b] : int
  ```c
  Tuple2 *p = malloc(sizeof(Tuple2));
  p->e1 = a; p->e2 = b;
  return (int64_t)(intptr_t)p;
  ```)
;;; pair-first -- extract the first field from a Pair.
;;;
;;; Parameters:
;;;   p -- pointer (as int64_t) to a Pair.
;;;
;;; Returns:
;;;   The int64_t value stored in the first field.
;;;
;;; Example:
;;;   (pair-first (pair-new 7 8))  ; => 7

(defn pair-first [p] : int ```c return ((Tuple2 *)(intptr_t)p)->e1; ```)
;;; pair-second -- extract the second field from a Pair.
;;;
;;; Parameters:
;;;   p -- pointer (as int64_t) to a Pair.
;;;
;;; Returns:
;;;   The int64_t value stored in the second field.
;;;
;;; Example:
;;;   (pair-second (pair-new 7 8))  ; => 8

(defn pair-second [p] : int ```c return ((Tuple2 *)(intptr_t)p)->e2; ```)
;;; ── Input ────────────────────────────────────────────────────────────────────
;;
;; Input stores the source string as int64_t (raw pointer) to allow capture
;; in fat closures without cstr-to-int64_t coercion issues.
;;; input-new -- create a new Input from a C string and a starting position.
;;;
;;; Parameters:
;;;   s   -- the source string (:cstr).
;;;   pos -- the initial character position (0-based).
;;;
;;; Returns:
;;;   Pointer (as int64_t) to a heap-allocated Input{str, pos}.
;;;
;;; Example:
;;;   (input-new "hello" 0)  ; => Input at position 0


(defn input-new [s : cstr pos] : int
  ```c
  struct { int64_t str; int64_t pos; } *inp = malloc(sizeof(*inp));
  inp->str = (int64_t)(intptr_t)s; inp->pos = pos;
  return (int64_t)(intptr_t)inp;
  ```)
;;; input-at-end -- test whether an Input is at the end of its string.
;;;
;;; Parameters:
;;;   inp -- pointer (as int64_t) to an Input.
;;;
;;; Returns:
;;;   true if the current character is '\0', false otherwise.
;;;
;;; Example:
;;;   (input-at-end (input-new "" 0))  ; => true

(defn input-at-end [inp] : bool
  ```c
  struct { int64_t str; int64_t pos; } *i = (void*)(intptr_t)inp;
  const char *s = (const char*)(intptr_t)i->str;
  return s[i->pos] == '\0';
  ```)
;;; input-current-char -- return the character at the current position.
;;;
;;; Parameters:
;;;   inp -- pointer (as int64_t) to an Input.
;;;
;;; Returns:
;;;   The ASCII code of the current character as an int64_t (unsigned byte).
;;;
;;; Example:
;;;   (input-current-char (input-new "abc" 0))  ; => 97  ; 'a'

(defn input-current-char [inp] : int
  ```c
  struct { int64_t str; int64_t pos; } *i = (void*)(intptr_t)inp;
  const char *s = (const char*)(intptr_t)i->str;
  return (int64_t)(unsigned char)s[i->pos];
  ```)
;;; input-advance -- return a new Input advanced by one character.
;;;
;;; Parameters:
;;;   inp -- pointer (as int64_t) to the current Input.
;;;
;;; Returns:
;;;   A new heap-allocated Input with pos incremented by 1.
;;;
;;; Example:
;;;   (input-pos (input-advance (input-new "ab" 0)))  ; => 1

(defn input-advance [inp] : int
  ```c
  struct { int64_t str; int64_t pos; } *i = (void*)(intptr_t)inp;
  struct { int64_t str; int64_t pos; } *n = malloc(sizeof(*n));
  n->str = i->str; n->pos = i->pos + 1;
  return (int64_t)(intptr_t)n;
  ```)
;;; input-pos -- return the current position index of an Input.
;;;
;;; Parameters:
;;;   inp -- pointer (as int64_t) to an Input.
;;;
;;; Returns:
;;;   The int64_t character offset into the source string.
;;;
;;; Example:
;;;   (input-pos (input-new "abc" 2))  ; => 2

(defn input-pos [inp] : int
  ```c return ((struct { int64_t str; int64_t pos; } *)(intptr_t)inp)->pos; ```)
;;; input-remaining -- count bytes remaining in an Input.
;;;
;;; Parameters:
;;;   inp -- pointer (as int64_t) to an Input.
;;;
;;; Returns:
;;;   The number of bytes from the current position to the terminating '\0'.
;;;
;;; Example:
;;;   (input-remaining (input-new "abc" 1))  ; => 2

(defn input-remaining [inp] : int
  ```c
  struct { int64_t str; int64_t pos; } *i = (void*)(intptr_t)inp;
  const char *s = (const char*)(intptr_t)i->str;
  int64_t len = 0; while (s[i->pos + len]) len++;
  return len;
  ```)
;;; ── Fat-closure and parser application ───────────────────────────────────────
;; apply-fat: call any fat closure with a single int64_t argument
;;; apply-fat -- invoke a fat closure with one argument.
;;;
;;; Parameters:
;;;   f   -- pointer (as int64_t) to a fat closure.
;;;   arg -- the single int64_t argument to pass.
;;;
;;; Returns:
;;;   The int64_t return value of the closure.
;;;
;;; Example:
;;;   (apply-fat my-fn 42)  ; => result of calling my-fn with 42


(defn apply-fat [f : int arg : int] : int ((:: f (fn [int] int)) arg))
;; apply-parser: call a parser fat closure with an Input
;;; apply-parser -- run a parser fat closure against an Input.
;;;
;;; Parameters:
;;;   p   -- pointer (as int64_t) to a parser fat closure.
;;;   inp -- pointer (as int64_t) to the Input to parse.
;;;
;;; Returns:
;;;   A Cell list of Pair(value, remaining-Input) results.
;;;
;;; Example:
;;;   (apply-parser (item) (input-new "a" 0))  ; => Cell{Pair(97, Input@1)}

(defn apply-parser [p : int inp : int] : int ((:: p (fn [int] int)) inp))
;;; ── Core parsers ─────────────────────────────────────────────────────────────
;; pfail: always fails
;;; pfail -- parser that always fails, consuming no input.
;;;
;;; Returns:
;;;   A parser that returns mzero for any input.
;;;
;;; Example:
;;;   (run-parser (pfail) "abc")  ; => 0  (no results)


(defn pfail-raw [] ^fat :ptr<void> (fn [inp] (mzero)))
;;; pfail -- a Parser that always fails, consuming no input.
;;;
;;; Returns:
;;;   A (Parser A) that yields no results for any input. This is the
;;;   `Alternative`/`MonadPlus` zero for parsers (see `empty`).
;;;
;;; Example:
;;;   (run-parser (pfail) "abc")  ; => 0  (no results)
;;;
;;; Since: stdlib-hkt-consolidation T2

(defn pfail [A] [] : (Parser A) (:: (pfail-raw) :Parser))
;; pure v: succeed with v, consume no input
;;; pure-impl -- internal implementation for pure.
;;; Parameters:
;;;   _v  -- the value to return.
;;;   inp -- the current Input (passed through unchanged).

(defn pure-impl [_v inp] : int (mreturn (pair-new _v inp)))
;;; pure -- parser that always succeeds with a fixed value, consuming no input.
;;;
;;; Parameters:
;;;   v -- the value to embed in the parse result.
;;;
;;; Returns:
;;;   A parser that returns Pair(v, inp) without advancing the input.
;;;
;;; Example:
;;;   (run-parser (pure 99) "")  ; => Cell{Pair(99, Input@0)}

(defn pure-parser [v] : ptr<void>
  (let [_v v] (fn [inp] (let [_ _v] (pure-impl _v inp)))))
;; item: consume one character; fail at end of input
;;; item-impl -- internal implementation for item.
;;; Parameters:
;;;   inp -- the current Input.

(defn item-impl [inp] : int
  (if (input-at-end inp)
    (mzero)
    (mreturn (pair-new (input-current-char inp) (input-advance inp)))))
;;; item -- parser that consumes exactly one character.
;;;
;;; Returns:
;;;   A parser yielding the ASCII code of the next character, or
;;;   failure if at end of input.
;;;
;;; Example:
;;;   (parse-value (run-parser (item) "A"))  ; => 65  ; 'A'

(defn item-raw [] ^fat :ptr<void> (fn [inp] (item-impl inp)))
;;; item -- a Parser that consumes exactly one character.
;;;
;;; Returns:
;;;   A (Parser int) yielding the ASCII code of the next character, or
;;;   failure if at end of input.
;;;
;;; Example:
;;;   (parse-value (run-parser (item) "A"))  ; => 65  ; 'A'
;;;
;;; Since: Phase B1

(defn item [] : (Parser int) (:: (item-raw) :Parser))
;; pchar c: consume if current char equals c (c is ASCII int)
;;; pchar-impl -- internal implementation for pchar.
;;; Parameters:
;;;   _c  -- the expected ASCII character code.
;;;   inp -- the current Input.

(defn pchar-impl [_c inp] : int
  (if (input-at-end inp)
    (mzero)
    (if (= (input-current-char inp) _c)
      (mreturn (pair-new _c (input-advance inp)))
      (mzero))))
;;; pchar -- parser that matches a single specific character.
;;;
;;; Parameters:
;;;   c -- the ASCII integer code of the character to match.
;;;
;;; Returns:
;;;   A parser that succeeds with c if the next character equals c,
;;;   or fails otherwise.
;;;
;;; Example:
;;;   (parse-value (run-parser (pchar 65) "ABC"))  ; => 65  ; 'A'

(defn pchar [c] : (Parser int)
  (:: (let [_c c] (fn [inp] (let [_ _c] (pchar-impl _c inp)))) :Parser))
;; pstring s: consume if input starts with the C string s (passed as :cstr)
;;; pstring-c-impl -- internal C implementation for pstring.
;;; Parameters:
;;;   s_raw -- the pattern string as a raw int64_t pointer.
;;;   inp   -- the current Input.

(defn pstring-c-impl [s_raw inp] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  typedef struct { int64_t str; int64_t pos; } Input;
  extern size_t strlen(const char *);
  const char *s = (const char*)(intptr_t)s_raw;
  Input *i = (Input*)(intptr_t)inp;
  const char *src = (const char*)(intptr_t)i->str;
  size_t slen = strlen(s);
  for (size_t j = 0; j < slen; j++) {
      if (src[i->pos + j] != s[j]) return 0;
  }
  Input *new_inp = malloc(sizeof(Input));
  new_inp->str = i->str; new_inp->pos = i->pos + (int64_t)slen;
  Tuple2 *pr = malloc(sizeof(Tuple2)); pr->e1 = s_raw; pr->e2 = (int64_t)(intptr_t)new_inp;
  Cell *cell = malloc(sizeof(Cell)); cell->value = (int64_t)(intptr_t)pr; cell->next = 0;
  return (int64_t)(intptr_t)cell;
  ```)
;;; cstr->int -- reinterpret a :cstr pointer as an int64_t without copying.
;;;
;;; Parameters:
;;;   s -- the C string to reinterpret.
;;;
;;; Returns:
;;;   The raw pointer value of s as an int64_t.

(defn cstr->int [s : cstr] : int ```c return (int64_t)(intptr_t)s; ```)
;;; pstring -- parser that matches a literal string prefix.
;;;
;;; Parameters:
;;;   s -- the expected string literal (:cstr).
;;;
;;; Returns:
;;;   A parser that succeeds with s (as int64_t pointer) and advances
;;;   past it, or fails if the input does not start with s.
;;;
;;; Example:
;;;   (run-parser (pstring "hi") "hi there")  ; => Cell{Pair("hi", Input@2)}

(defn pstring [s : cstr] : (Parser int)
  (:: (let [_s (cstr->int s)] (fn [inp] (let [_ _s] (pstring-c-impl _s inp))))
    :Parser))
;;; ── Combinators ──────────────────────────────────────────────────────────────
;; or-parser p q: try p, then q, return all successes (backtracking)
;;; or-parser-impl -- internal implementation for or-parser.
;;; Parameters:
;;;   lp  -- the first parser (int64_t fat-closure pointer).
;;;   lq  -- the second parser (int64_t fat-closure pointer).
;;;   inp -- the current Input.


(defn or-parser-impl [lp lq inp] : int
  (mplus (apply-parser lp inp) (apply-parser lq inp)))
;;; or-parser-raw -- int-carrier worker behind or-parser / Alternative alt-or.

(defn or-parser-raw [p q] : ptr<void>
  (let [lp p
        lq q]
    (fn [inp] (let [_ lp] (or-parser-impl lp lq inp)))))
;;; or-parser -- try two parsers and return all successes from either.
;;;
;;; This is the typed `(Parser A)` worker behind the `Alternative [Parser]`
;;; `alt-or` method.
;;;
;;; Parameters:
;;;   p -- the first parser to try.
;;;   q -- the second parser to try.
;;;
;;; Returns:
;;;   A parser that returns the concatenation of results from p and q
;;;   applied to the same input (full backtracking).
;;;
;;; Example:
;;;   (run-parser (or-parser (pchar 65) (pchar 66)) "B")  ; => Cell{Pair(66, ...)}
;;;
;;; Since: Phase B1

(defn or-parser [A] [p : (Parser A) q : (Parser A)] : (Parser A)
  (:: (or-parser-raw (:: p :int) (:: q :int)) :Parser))
;; bind-parser p f: apply p, then for each (v, inp'), apply (f v) as a parser
;; f must be a fat closure: value -> Parser
;;; bind-parser-inner -- apply continuation f to a single parse Pair.
;;; Parameters:
;;;   lf   -- the continuation fat closure (value -> Parser).
;;;   pair -- a Pair(value, remaining-Input) from the first parser.

(defn bind-parser-inner [f : fn pair] : int
  (apply-parser (f (pair-first pair)) (pair-second pair)))
;;; bind-parser-impl -- internal implementation for bind-parser.
;;; Parameters:
;;;   lp  -- the first parser.
;;;   lf  -- the continuation fat closure.
;;;   inp -- the current Input.

(defn bind-parser-impl [lp f : fn inp] : int
  (mbind (apply-parser lp inp) (fn [pair] (bind-parser-inner f pair))))
;;; bind-parser -- sequence two parsers, threading the first result into the second.
;;;
;;; Parameters:
;;;   p -- the first parser.
;;;   f -- a `:fn` continuation of type value -> Parser; receives the parsed
;;;        value and returns the next parser to run. A `(fn ...)` literal
;;;        coerces into this slot.
;;;
;;; Returns:
;;;   A parser that runs p, then for each result calls (f value) and runs
;;;   the resulting parser on the remaining input.
;;;
;;; Example:
;;;   (bind-parser (item) (fn [c] (pure c)))  ; identity parser

(defn bind-parser [p f : fn] : ptr<void>
  (let [lp p] (fn [inp] (let [_ lp] (bind-parser-impl lp f inp)))))
;; then-parser p q: apply p, discard result, apply q
;;; then-parser-impl -- internal implementation for then-parser.
;;; Parameters:
;;;   lp  -- the first parser (result discarded).
;;;   lq  -- the second parser (result kept).
;;;   inp -- the current Input.

(defn then-parser-impl [lp lq inp] : int
  (let [lq2 lq]
    (mbind (apply-parser lp inp)
      (fn [pair] (let [_ lq2] (apply-parser lq2 (pair-second pair)))))))
;;; then-parser-raw -- int-carrier worker behind then-parser.

(defn then-parser-raw [p q] : ptr<void>
  (let [lp p
        lq q]
    (fn [inp] (let [_ lp] (then-parser-impl lp lq inp)))))
;;; then-parser -- sequence two parsers, discarding the first result.
;;;
;;; Equivalent to `(bind p (fn [_] q))` against the `Monad [Parser]` instance.
;;;
;;; Parameters:
;;;   p -- parser whose result is discarded.
;;;   q -- parser whose result is kept.
;;;
;;; Returns:
;;;   A parser that runs p, then runs q on the remaining input,
;;;   returning only q's results.
;;;
;;; Example:
;;;   (run-parser (then-parser (pchar 40) (item)) "(x")
;;;   ; => Cell{Pair(120, Input@2)}  ; 'x' only
;;;
;;; Since: Phase B1

(defn then-parser [A B] [p : (Parser A) q : (Parser B)] : (Parser B)
  (:: (then-parser-raw (:: p :int) (:: q :int)) :Parser))
;; many p: match p zero or more times (greedy); returns one result
;;; many-c-impl -- internal C implementation of greedy zero-or-more repetition.
;;; Parameters:
;;;   p_raw -- parser fat closure as int64_t.
;;;   inp   -- the current Input.

(defn many-c-impl [p_raw inp] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  typedef struct { int64_t str; int64_t pos; } Input;
  int64_t *fat_p = (int64_t*)(intptr_t)p_raw;
  int64_t thunk_p = fat_p[0];
  int64_t current_inp = inp;
  Cell *rev_list = NULL;
  for (;;) {
      int64_t matches = ((int64_t(*)(void*, int64_t))(intptr_t)thunk_p)((void*)fat_p, current_inp);
      if (!matches) break;
      Cell *match_cell = (Cell*)(intptr_t)matches;
      Tuple2 *pr = (Tuple2*)(intptr_t)match_cell->value;
      Input *old_i = (Input*)(intptr_t)current_inp;
      Input *new_i = (Input*)(intptr_t)pr->e2;
      if (new_i->pos <= old_i->pos) break;
      Cell *nc = malloc(sizeof(Cell)); nc->value = pr->e1; nc->next = (int64_t)(intptr_t)rev_list; rev_list = nc;
      current_inp = pr->e2;
  }
  Cell *fwd = NULL;
  while (rev_list) {
      Cell *tmp = (Cell*)(intptr_t)rev_list->next;
      rev_list->next = (int64_t)(intptr_t)fwd; fwd = rev_list; rev_list = tmp;
  }
  Tuple2 *result_pair = malloc(sizeof(Tuple2)); result_pair->e1 = (int64_t)(intptr_t)fwd; result_pair->e2 = current_inp;
  Cell *result_cell = malloc(sizeof(Cell)); result_cell->value = (int64_t)(intptr_t)result_pair; result_cell->next = 0;
  return (int64_t)(intptr_t)result_cell;
  ```)
;;; many -- greedily match a parser zero or more times.
;;;
;;; Parameters:
;;;   p -- the parser to repeat.
;;;
;;; Returns:
;;;   A parser that always succeeds, yielding a Cell list of all
;;;   matched values and the remaining Input after the last match.
;;;   Returns an empty list when p does not match at all.
;;;
;;; Example:
;;;   (run-parser (many (pchar 97)) "aab")
;;;   ; => Cell{Pair(Cell{97,97}, Input@2)}

(defn many [A] [p : (Parser A)] : (Parser int)
  (:: (let [_p (:: p :int)] (fn [inp] (let [_ _p] (many-c-impl _p inp))))
    :Parser))
;; many1 p: one or more; fails if p doesn't match at least once
;;; many1-impl -- internal implementation for many1.
;;; Parameters:
;;;   _p  -- the parser to repeat.
;;;   inp -- the current Input.

(defn many1-impl [_p inp] : int
  (if (input-at-end inp)
    (mzero)
    (let [first-results (apply-parser _p inp)]
      (if (= first-results 0) (mzero) (many-c-impl _p inp)))))
;;; many1 -- greedily match a parser one or more times.
;;;
;;; Parameters:
;;;   p -- the parser to repeat.
;;;
;;; Returns:
;;;   A parser that succeeds only when p matches at least once, then
;;;   greedily repeats, returning results identical in structure to many.
;;;
;;; Example:
;;;   (run-parser (many1 (pchar 97)) "aab")
;;;   ; => Cell{Pair(Cell{97,97}, Input@2)}
;;;   (run-parser (many1 (pchar 97)) "bbb")  ; => 0  (fails)

(defn many1 [A] [p : (Parser A)] : (Parser int)
  (:: (let [_p (:: p :int)] (fn [inp] (let [_ _p] (many1-impl _p inp))))
    :Parser))
;; optional p: match p zero or one times; 0 = none, pair-first = some-value
;;; optional-impl -- internal implementation for optional.
;;; Parameters:
;;;   _p  -- the parser to attempt.
;;;   inp -- the current Input.

(defn optional-impl [_p inp] : int
  (mplus (apply-parser _p inp) (mreturn (pair-new 0 inp))))
;;; optional -- match a parser zero or one times.
;;;
;;; Parameters:
;;;   p -- the parser to attempt.
;;;
;;; Returns:
;;;   A parser that returns two results when p succeeds (the match and
;;;   a fallback with value 0), or one result with value 0 when p fails.
;;;   Check pair-first: 0 means absent, non-zero means the parsed value.
;;;
;;; Example:
;;;   (run-parser (optional (pchar 65)) "ABC")  ; => two results
;;;   (run-parser (optional (pchar 65)) "XYZ")  ; => Cell{Pair(0, Input@0)}

(defn optional [A] [p : (Parser A)] : (Parser int)
  (:: (let [_p (:: p :int)] (fn [inp] (let [_ _p] (optional-impl _p inp))))
    :Parser))
;;; ── Runners ──────────────────────────────────────────────────────────────────
;; run-parser p s: run parser p on string s; return all partial+full parses
;;; run-parser -- run a parser against a raw C string.
;;;
;;; Parameters:
;;;   p -- the parser to run.
;;;   s -- the input string (:cstr).
;;;
;;; Returns:
;;;   A Cell list of Pair(value, remaining-Input) for all successful
;;;   parses, including partial ones.
;;;
;;; Example:
;;;   (run-parser (pchar 65) "ABC")  ; => Cell{Pair(65, Input@1)}


(defn run-parser [A] [p : (Parser A) s : cstr] : int
  (let [inp (input-new s 0)] (apply-parser (:: p :int) inp)))
;; run-parser-full p s: return mreturn(value) for first full-input parse, mzero if none
;;; run-parser-full-c -- internal C helper to extract the first full-input parse.
;;; Parameters:
;;;   results -- Cell list returned by run-parser.

(defn run-parser-full-c [results] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  typedef struct { int64_t str; int64_t pos; } Input;
  Cell *c = (Cell*)(intptr_t)results;
  while (c) {
      Tuple2 *pr = (Tuple2*)(intptr_t)c->value;
      Input *inp_p = (Input*)(intptr_t)pr->e2;
      const char *s = (const char*)(intptr_t)inp_p->str;
      if (s[inp_p->pos] == '\0') {
          Cell *r = malloc(sizeof(Cell)); r->value = pr->e1; r->next = 0;
          return (int64_t)(intptr_t)r;
      }
      c = (Cell*)(intptr_t)c->next;
  }
  return 0;
  ```)
;;; run-parser-full -- run a parser and return only the first complete parse.
;;;
;;; Parameters:
;;;   p -- the parser to run.
;;;   s -- the input string (:cstr).
;;;
;;; Returns:
;;;   A Cell wrapping the parsed value if the entire input was consumed,
;;;   or 0 (mzero) if no full parse exists.
;;;
;;; Example:
;;;   (run-parser-full (many (pchar 97)) "aaa")
;;;   ; => Cell{value=Cell{97,97,97}}
;;;   (run-parser-full (pchar 97) "ab")  ; => 0  (leftover input)

(defn run-parser-full [A] [p : (Parser A) s : cstr] : int
  (run-parser-full-c (run-parser p s)))
;;; ── Result helpers ───────────────────────────────────────────────────────────
;; parse-value: extract value from first parse result (first = result value)
;;; parse-value -- extract the parsed value from the first result in a Cell list.
;;;
;;; Parameters:
;;;   results -- a Cell list returned by run-parser or run-parser-full.
;;;
;;; Returns:
;;;   The int64_t value from pair-first of the first Cell, or 0 if empty.
;;;
;;; Example:
;;;   (parse-value (run-parser (pchar 65) "A"))  ; => 65


(defn parse-value [results] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *c = (Cell*)(intptr_t)results;
  if (!c) return 0;
  Tuple2 *pr = (Tuple2*)(intptr_t)c->value;
  return pr->e1;
  ```)
;; parse-result-count: count number of parse results
;;; parse-result-count -- count the number of parse results in a result list.
;;;
;;; Parameters:
;;;   results -- a Cell list returned by run-parser.
;;;
;;; Returns:
;;;   The number of successful parse results as an int64_t.
;;;
;;; Example:
;;;   (parse-result-count (run-parser (or-parser (pchar 65) (pchar 65)) "A"))
;;;   ; => 2  (both branches succeed)

(defn parse-result-count [results] : int (bt-length results))
;; print-char-list: print a linked list of character values
;;; print-char-list -- print each integer value in a Cell list, space-separated.
;;;
;;; Parameters:
;;;   lst -- a bt-cons Cell list of int64_t character codes.
;;;
;;; Example:
;;;   (print-char-list (bt-cons 65 (bt-cons 66 (bt-nil))))
;;;   ; prints: 65 66

(defn print-char-list [lst]
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *c = (Cell*)(intptr_t)lst;
  while (c) { printf("%lld", (long long)c->value); if (c->next) printf(" "); c = (Cell*)(intptr_t)c->next; }
  printf("\n");
  ```)
;; char-list-length: count elements in a bt-cons list
;;; char-list-length -- count elements in a bt-cons character list.
;;;
;;; Parameters:
;;;   lst -- a bt-cons Cell list.
;;;
;;; Returns:
;;;   The number of elements as an int64_t.
;;;
;;; Example:
;;;   (char-list-length (bt-cons 1 (bt-cons 2 (bt-nil))))  ; => 2

(defn char-list-length [lst] : int (bt-length lst))
;;; ── HKT typeclass instances (stdlib-hkt-consolidation T2) ────────────────────
;;
;; Parser is a kind-(* -> *) handle (carrier: the fat-closure pointer), so the
;; standard Functor / Applicative / Monad / Alternative instances are all
;; directly expressible and own their type (no orphans). Each method delegates
;; to a worker above. The continuation parameter of `fmap` / `bind` arrives as a
;; typeclass-method poly closure; now that a `:fn` value is a first-class
;; callable, the worker declares its callback `:fn` and applies it directly
;; (captured into the deferred parser closure), so the instance bodies just hand
;; the continuation straight through -- no `^fat`-sink shim, no `apply-fat`.
;;; fmap-parser-raw -- worker: map a `:fn` callback over the value arm of a parser.

(defn fmap-parser-raw [p f : fn] : ptr<void>
  (let [lp p]
    (fn [inp]
      (let [_ lp]
        (mbind (apply-parser lp inp)
          (fn [pair]
            (mreturn (pair-new (f (pair-first pair)) (pair-second pair)))))))))
;;; ap-parser-raw -- int worker: sequential application of a parser of functions.

(defn ap-parser-raw [pf pa] : ptr<void>
  (let [lpf pf
        lpa pa]
    (fn [inp]
      (let [_ lpf]
        (mbind (apply-parser lpf inp)
          (fn [fpair]
            (let [_ lpa]
              (mbind (apply-parser lpa (pair-second fpair))
                (fn [apair]
                  (mreturn (pair-new (apply-fat (pair-first fpair)
                                       (pair-first apair))
                             (pair-second apair))))))))))))
;;; Functor [Parser] -- map a function over each parsed value.
;;;
;;; Example:
;;;   (fmap (item) (fn [c] (+ c 1)))  ; parse a char, return its successor
;;;
;;; Since: stdlib-hkt-consolidation T2

(definstance Functor [Parser]
  (fmap [container fn] (:: (fmap-parser-raw (:: container :int) fn) :Parser)))
;;; Applicative [Parser] -- pure injects a value without consuming input; ap
;;; runs a parser of functions then a parser of arguments, applying one to the
;;; other.
;;;
;;; Example:
;;;   (ap (pure (fn [x] (* x 2))) (item))
;;;
;;; Since: stdlib-hkt-consolidation T2

(definstance Applicative [Parser]
  (pure [x] (:: (pure-parser x) :Parser))
  (ap [ff fa] (:: (ap-parser-raw (:: ff :int) (:: fa :int)) :Parser)))
;;; Monad [Parser] -- bind sequences parsers, threading each parsed value into
;;; the continuation. This is what `do-m` / `for` lower onto.
;;;
;;; Example:
;;;   (do-m a (item) b (item) (pure (+ a b)))
;;;
;;; Since: stdlib-hkt-consolidation T2

(definstance Monad [Parser]
  (bind [ma k] (:: (bind-parser (:: ma :int) k) :Parser)))
;;; Alternative [Parser] -- empty is the always-failing parser; alt-or runs both
;;; parsers and unions their results (full backtracking choice).
;;;
;;; Example:
;;;   (alt-or (pchar 65) (pchar 66))  ; match 'A' or 'B'
;;;
;;; Since: stdlib-hkt-consolidation T2

(definstance Alternative [Parser]
  (empty [a] (:: (pfail-raw) :Parser))
  (alt-or [a b] (:: (or-parser-raw (:: a :int) (:: b :int)) :Parser)))
