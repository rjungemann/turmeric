;;; tur/comonad -- Comonad typeclass -- the categorical dual of Monad.
;;;
;;; Provides extract, extend, and duplicate operations.
;;;
;;; Since: Phase CA0
;; Phase CA0: Comonad typeclass -- dual of Monad.
;;
;; Laws:
;;   extract (extend f w) = f w           (left identity)
;;   extend extract w     = w             (right identity)
;;   extend f (extend g w) = extend (fn [w'] (f (extend g w'))) w  (associativity)
;;
;; In v1: all container values are int64_t (holding heap pointers).
;; extract :: w a -> a
;; extend  :: (w a -> b) -> w a -> w b
;; duplicate :: w a -> w (w a)   (derived: extend id)
;;; Comonad -- typeclass dual to Monad; supports extract and extend.
;;;
;;; Parameters:
;;;   ^w -- the comonadic type constructor (kind * -> *)
;;;
;;; Returns:
;;;   extract returns the focused value (:int); extend applies a function at
;;;   every position and returns a new container (:int); duplicate wraps each
;;;   position in its own context (:int).
;;;
;;; Since: Phase CA0
(defclass Comonad [^w]
  (extract [wa] : int)
  (extend [wa f : fn] : int)
  (duplicate [wa] : int))
;; -- Identity comonad ────────────────────────────────────────────────────────
;; Identity w a = Identity a
;; Represented as a heap-allocated { int64_t value; } struct.
;; extract (Identity a) = a
;; extend f (Identity a) = Identity (f (Identity a))
;;; __identity_new -- allocate a new Identity comonad cell wrapping x.


(defn __identity_new [x] : int
  ```c int64_t *p = malloc(sizeof(int64_t));
  *p = x;
  return (int64_t)(intptr_t)p;
  ```)
;;; __identity_get -- read the value stored in an Identity comonad cell.

(defn __identity_get [wa] : int
  ```c int64_t *p = (int64_t *)(intptr_t)wa;
  return *p;
  ```)
;;; __identity_extract -- extract the value from an Identity comonad cell.

(defn __identity_extract [wa] : int
  ```c int64_t *p = (int64_t *)(intptr_t)wa;
  return *p;
  ```)
;;; __identity_extend -- apply fn to the Identity cell and wrap the result.
;;;
;;; CRU Phase 1: extend takes its function as a `:fn` poly-closure carrier and
;;; applies it directly in Turmeric -- both a captureless lambda and a capturing
;;; closure round-trip through the carrier, so `extend` no longer crashes on a
;;; capturing closure the way the old bare-thin-cast `int64_t(*)(int64_t,int64_t)`
;;; invocation did.

(defn __identity_extend [wa f : fn] : int
  ;; extend f w = Identity (f w)
  (__identity_new (f wa)))
;;; __identity_duplicate -- wrap an Identity cell inside another Identity cell.

(defn __identity_duplicate [wa] : int
  ```c /* duplicate w = Identity w   (the outer Identity wraps the original) */
  int64_t *p = malloc(sizeof(int64_t));
  *p = wa;
  return (int64_t)(intptr_t)p;
  ```)
;;; Comonad [identity] -- Comonad instance for the Identity comonad.

(definstance Comonad [identity]
  (extract [wa] (__identity_extract wa))
  (extend [wa f] (__identity_extend wa f))
  (duplicate [wa] (__identity_duplicate wa)))
;; -- Pair (Product) comonad ──────────────────────────────────────────────────
;; Pair e a = (e, a)   -- carries a fixed environment e alongside a value a.
;; Represented as a Tuple2: e1 = env, e2 = val (backed by stdlib/tuple.tur).
;; extract (e, a) = a
;; extend f (e, a) = (e, f (e, a))
;;; __pair_new -- allocate a new Pair comonad cell with environment and value.


(defn __pair_new [env val] : int
  ```c Tuple2 *p = (Tuple2 *)malloc(sizeof(Tuple2));
  p->e1 = env;
  p->e2 = val;
  return (int64_t)(intptr_t)p;
  ```)
;;; __pair_env -- read the environment component of a Pair comonad cell.

(defn __pair_env [wa] : int
  ```c Tuple2 *p = (Tuple2 *)(intptr_t)wa;
  return p->e1;
  ```)
;;; __pair_val -- read the value component of a Pair comonad cell.

(defn __pair_val [wa] : int
  ```c Tuple2 *p = (Tuple2 *)(intptr_t)wa;
  return p->e2;
  ```)
;;; __pair_extract -- extract the value from a Pair comonad cell.

(defn __pair_extract [wa] : int
  ```c Tuple2 *p = (Tuple2 *)(intptr_t)wa;
  return p->e2;
  ```)
;;; __pair_extend -- extend over a Pair cell: (e, a) -> (e, f (e, a)).
;;;
;;; CRU Phase 1: extend takes its function as a `:fn` poly-closure carrier (see
;;; __identity_extend) so a capturing closure works.

(defn __pair_extend [wa f : fn] : int
  ;; extend f (e, a) = (e, f (e, a))
  (__pair_new (__pair_env wa) (f wa)))
;;; __pair_duplicate -- duplicate a Pair cell: (e, a) -> (e, (e, a)).

(defn __pair_duplicate [wa] : int
  ```c /* duplicate (e, a) = (e, (e, a)) */
  Tuple2 *src = (Tuple2 *)(intptr_t)wa;
  Tuple2 *p = (Tuple2 *)malloc(sizeof(Tuple2));
  p->e1 = src->e1;
  p->e2 = wa;
  return (int64_t)(intptr_t)p;
  ```)
;;; Comonad [pair] -- Comonad instance for the Pair (product) comonad.

(definstance Comonad [pair]
  (extract [wa] (__pair_extract wa))
  (extend [wa f] (__pair_extend wa f))
  (duplicate [wa] (__pair_duplicate wa)))
