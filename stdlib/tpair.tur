;;; tur/tpair -- typed Pair[A B]: parameterized two-element tuple.
;;;
;;; Generic two-element tuple with typed first and second elements.
;;; Runtime layout identical to tur/pair.
;;;
;;; Since: Phase TC1-F
;; Phase TC1-F: Typed Pair[A B]
;; Generic two-element tuple with typed first and second elements.
;; Runtime layout identical to pair.tur: { int64_t first; int64_t second; }

;;; Pair -- parameterized two-element tuple with element types A and B.
;;;
;;; Since: Phase TC1
(defstruct Pair [A B]
  (fst :int)
  (snd :int))

;;; tpair -- allocate a new Pair[A B] on the heap.
;;;
;;; Parameters:
;;;   a -- first element (type A)
;;;   b -- second element (type B)
;;;
;;; Returns:
;;;   A heap-allocated Pair[A B].
;;;
;;; Example:
;;;   (tpair 1 2)  ; => (1, 2)
;;;
;;; Since: Phase TC1
(defn tpair [a :int b :int] #{} :int
  ```c
  struct { int64_t fst; int64_t snd; } *p = malloc(sizeof(*p));
  p->fst = a;
  p->snd = b;
  return (int64_t)(intptr_t)p;
  ```)

;;; tpair-fst -- return the first element of a Pair[A B].
;;;
;;; Parameters:
;;;   p -- Pair[A B]
;;;
;;; Returns:
;;;   The first element of type A.
;;;
;;; Example:
;;;   (tpair-fst (tpair 10 20))  ; => 10
;;;
;;; Since: Phase TC1
(defn tpair-fst [p :int] #{} :int
  ```c
  struct { int64_t fst; int64_t snd; } *pair = (void*)(intptr_t)p;
  return (int64_t)pair->fst;
  ```)

;;; tpair-snd -- return the second element of a Pair[A B].
;;;
;;; Parameters:
;;;   p -- Pair[A B]
;;;
;;; Returns:
;;;   The second element of type B.
;;;
;;; Example:
;;;   (tpair-snd (tpair 10 20))  ; => 20
;;;
;;; Since: Phase TC1
(defn tpair-snd [p :int] #{} :int
  ```c
  struct { int64_t fst; int64_t snd; } *pair = (void*)(intptr_t)p;
  return (int64_t)pair->snd;
  ```)

;;; tpair-free -- free a heap-allocated Pair[A B] (shallow free only).
;;;
;;; Parameters:
;;;   p -- Pair[A B] to free
;;;
;;; Example:
;;;   (tpair-free my-pair)
;;;
;;; Since: Phase TC1
(defn tpair-free [p :int] #{} :void
  ```c
  free((void*)(intptr_t)p);
  ```)

;;; tpair-eq? -- compare two Pair[A B] values element-wise.
;;;
;;; Parameters:
;;;   p1      -- first Pair[A B]
;;;   p2      -- second Pair[A B]
;;;   fst-cmp -- comparator for first element fn [a :int b :int] :bool
;;;   snd-cmp -- comparator for second element fn [a :int b :int] :bool
;;;
;;; Returns:
;;;   true if both first and second elements are equal under their comparators.
;;;
;;; Example:
;;;   (tpair-eq? (tpair 1 2) (tpair 1 2) (fn [a b] (= a b)) (fn [a b] (= a b)))  ; => true
;;;
;;; Since: Phase TC1
(defn tpair-eq? [p1 :int p2 :int fst-cmp snd-cmp] #{} :bool
  ```c
  struct { int64_t fst; int64_t snd; } *a = (void*)(intptr_t)p1;
  struct { int64_t fst; int64_t snd; } *b = (void*)(intptr_t)p2;
  if (!a && !b) return true;
  if (!a || !b) return false;
  bool fst_eq = ((bool(*)(int64_t, int64_t))(intptr_t)fst_cmp)(a->fst, b->fst);
  bool snd_eq = ((bool(*)(int64_t, int64_t))(intptr_t)snd_cmp)(a->snd, b->snd);
  return fst_eq && snd_eq;
  ```)

;;; Eq [Pair] -- element-wise equality using each component's Eq instance.
;; TC1-25: Phase PTC4 -- constrained Eq instance for Pair[A B].
;; Note: element comparison uses integer equality; correct for all primitive A/B.
(definstance Eq [Pair] [(Eq A) (Eq B)]
  (eq? [x y] (tpair-eq? x y (fn [a b] (= a b)) (fn [a b] (= a b)))))
