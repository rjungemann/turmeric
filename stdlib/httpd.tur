;;; tur/httpd -- Lightweight HTTP/1.0 server.
;;;
;;; Single-process HTTP/1.0 server. The listener thread runs a tur/reactor
;;; loop that watches the listen socket for READ events; each accepted
;;; connection is dispatched (round-robin over a shared queue) to a worker
;;; thread that reads the request, invokes the handler, writes the response,
;;; and closes the socket. The connection is closed after each response
;;; (HTTP/1.0 semantics until keep-alive lands in H4).
;;;
;;; Handler calling convention: the handler closure MUST capture at least
;;; one variable so it is heap-allocated as a fat closure. Inside the
;;; handler, use httpd-req-* to read the parsed request and httpd-resp-*!
;;; to set the response.
;;;
;;; Since: Phase H1
;; stdlib/httpd.tur -- Lightweight HTTP server (Phase H1-H7)
;;
;; H1: TCP listener + blocking thread-per-connection.
;; H2: Reactor-backed listener (replaces the blocking accept loop).
;; H3: Fixed worker pool serving a shared Mutex<Queue<fd>> instead of
;;     spawning one OS thread per connection.
;; H4-H7: see docs/tur-httpd-plan.md.
;;
;; HttpdBlock layout:
;;   { int listen_fd; int64_t handler;
;;     void *reactor;          // listener reactor
;;     int   listen_src_id;
;;     void *accept_clos;      // synthetic fat closure { __fn, hb }
;;     // worker pool
;;     pthread_t *workers;
;;     int n_workers;
;;     // shared fd queue
;;     int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
;;     int fdq_closed;
;;     pthread_mutex_t fdq_mtx;
;;     pthread_cond_t  fdq_cv;
;;     volatile int stop_flag; }
;;
;; HttpdConn layout (per-connection, heap-allocated by httpd-worker):
;;   { int fd; int64_t handler;
;;     char method[16]; char path[1024]; char version[16];
;;     int resp_status; char *resp_body; int resp_body_len; }
;;
;; API:
;;   httpd-new          [port :int handler :int]         -- ptr<void>
;;   httpd-new-pool     [port :int workers :int h :int]  -- ptr<void>
;;   httpd-port         [h :ptr<void>]                   -- int
;;   httpd-run          [h :ptr<void>]                   -- nil
;;   httpd-stop         [h :ptr<void>]                   -- nil
;;   httpd-free         [h :ptr<void>]                   -- nil
;;   httpd-req-method   [conn :ptr<void>]                -- cstr
;;   httpd-req-path     [conn :ptr<void>]                -- cstr
;;   httpd-resp-status! [conn :ptr<void> status :int]    -- nil
;;   httpd-resp-body!   [conn :ptr<void> body :cstr]     -- nil

;;; httpd/autolink-hint -- ensure programs using httpd link against libturi + pthreads.
(defn httpd/autolink-hint [] :int
  ```c /* __tur_autolink__: -lturi -pthread */
  return 0;
  ```)

;; ---- libturi reactor C surface ----

(extern-c tur_reactor_new      []                                     :ptr)
(extern-c tur_reactor_free     [r :ptr]                               :void)
(extern-c tur_reactor_add_fd   [r :ptr fd :int events :int cb :int user-data :ptr] :int)
(extern-c tur_reactor_remove   [r :ptr id :int]                       :int)
(extern-c tur_reactor_run      [r :ptr]                               :void)
(extern-c tur_reactor_stop     [r :ptr]                               :void)
(extern-c tur_reactor_wake     [r :ptr]                               :void)

;;; httpd-handle -- internal: parse one HTTP request from fd, call handler,
;;; write response, close fd. Used by the worker pool.
;;;
;;; Since: Phase H1
(defn httpd-handle [fd :int handler :int] :nil
  ```c
  typedef struct {
      int fd;
      int64_t handler;
      char method[16];
      char path[1024];
      char version[16];
      int resp_status;
      char *resp_body;
      int resp_body_len;
  } HttpdConn;
  HttpdConn _conn;
  HttpdConn *conn = &_conn;
  memset(conn, 0, sizeof(HttpdConn));
  conn->fd = (int)fd;
  conn->handler = (int64_t)handler;
  /* Read request into buffer until end-of-headers or buffer full. */
  char buf[8192];
  int total = 0;
  ssize_t n;
  while ((n = recv(conn->fd, buf + total,
                   (size_t)(sizeof(buf) - 1 - (size_t)total), 0)) > 0) {
      total += (int)n;
      buf[total] = '\0';
      if (strstr(buf, "\r\n\r\n") || strstr(buf, "\n\n")) break;
      if (total >= (int)sizeof(buf) - 1) break;
  }
  buf[total] = '\0';
  /* Parse request line: METHOD SP PATH SP VERSION CRLF */
  char *line_end = strpbrk(buf, "\r\n");
  if (!line_end || line_end > buf + total) line_end = buf + total;
  char *p = buf;
  if (p < line_end) {
      char *sp = (char *)memchr(p, ' ', (size_t)(line_end - p));
      if (sp) {
          int l = (int)(sp - p);
          if (l > 0 && l < 15) {
              memcpy(conn->method, p, (size_t)l);
              conn->method[l] = '\0';
          }
          p = sp + 1;
      }
  }
  if (p < line_end) {
      char *sp = (char *)memchr(p, ' ', (size_t)(line_end - p));
      int l = sp ? (int)(sp - p) : (int)(line_end - p);
      if (l > 0 && l < 1023) {
          memcpy(conn->path, p, (size_t)l);
          conn->path[l] = '\0';
      }
  }
  /* Dispatch to handler using fat-closure calling convention. */
  int64_t *fat = (int64_t *)(intptr_t)conn->handler;
  typedef void (*fn1_t)(void *, int64_t);
  ((fn1_t)(intptr_t)fat[0])((void *)fat, (int64_t)(intptr_t)conn);
  /* Write HTTP/1.0 response. */
  int status = conn->resp_status ? conn->resp_status : 200;
  const char *stxt = (status == 200) ? "OK" :
                     (status == 201) ? "Created" :
                     (status == 204) ? "No Content" :
                     (status == 400) ? "Bad Request" :
                     (status == 404) ? "Not Found" :
                     (status == 500) ? "Internal Server Error" : "OK";
  const char *body = conn->resp_body ? conn->resp_body : "";
  int         blen = conn->resp_body ? conn->resp_body_len : 0;
  char hbuf[256];
  int hlen = snprintf(hbuf, sizeof(hbuf),
      "HTTP/1.0 %d %s\r\nContent-Length: %d\r\nConnection: close\r\n\r\n",
      status, stxt, blen);
  send(conn->fd, hbuf, (size_t)hlen, 0);
  if (blen > 0) send(conn->fd, body, (size_t)blen, 0);
  /* Cleanup. */
  close(conn->fd);
  if (conn->resp_body) free(conn->resp_body);
  ```)

;;; httpd-worker -- internal: worker thread function.
;;;
;;; Pops fds from the shared queue and processes them sequentially via
;;; httpd-handle. Exits when the queue is closed and drained.
;;;
;;; Since: Phase H3
(defn httpd-worker [arg :ptr<void>] :ptr<void>
  ```c
  typedef struct {
      int listen_fd; int64_t handler;
      void *reactor; int listen_src_id; void *accept_clos;
      pthread_t *workers; int n_workers;
      int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
      int fdq_closed;
      pthread_mutex_t fdq_mtx;
      pthread_cond_t  fdq_cv;
      volatile int stop_flag;
  } HttpdBlock;
  HttpdBlock *hb = (HttpdBlock *)arg;
  for (;;) {
      int fd = -1;
      pthread_mutex_lock(&hb->fdq_mtx);
      while (hb->fdq_count == 0 && !hb->fdq_closed)
          pthread_cond_wait(&hb->fdq_cv, &hb->fdq_mtx);
      if (hb->fdq_count == 0 && hb->fdq_closed) {
          pthread_mutex_unlock(&hb->fdq_mtx);
          break;
      }
      fd = hb->fdq[hb->fdq_head];
      hb->fdq_head = (hb->fdq_head + 1) % hb->fdq_cap;
      hb->fdq_count--;
      pthread_mutex_unlock(&hb->fdq_mtx);
      httpd_handle((int64_t)fd, hb->handler);
  }
  return NULL;
  ```)

;;; httpd-accept-cb -- internal reactor READ callback for the listen fd.
;;;
;;; Drains the listen queue, pushing each accepted fd onto the shared
;;; worker queue and signalling one waiting worker. env[1] is the
;;; HttpdBlock pointer (synthetic fat closure built in httpd-new).
;;;
;;; Since: Phase H2
(defn httpd-accept-cb [env :ptr<void> id :int events :int user :ptr<void>] :nil
  ```c
  (void)id; (void)events; (void)user;
  typedef struct {
      int listen_fd; int64_t handler;
      void *reactor; int listen_src_id; void *accept_clos;
      pthread_t *workers; int n_workers;
      int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
      int fdq_closed;
      pthread_mutex_t fdq_mtx;
      pthread_cond_t  fdq_cv;
      volatile int stop_flag;
  } HttpdBlock;
  int64_t *fat = (int64_t *)env;
  HttpdBlock *hb = (HttpdBlock *)(intptr_t)fat[1];
  /* Drain pending accepts; the listen fd is non-blocking. */
  for (;;) {
      int cfd = accept(hb->listen_fd, NULL, NULL);
      if (cfd < 0) break;
      pthread_mutex_lock(&hb->fdq_mtx);
      if (hb->fdq_closed) { pthread_mutex_unlock(&hb->fdq_mtx); close(cfd); break; }
      /* Grow the queue if full (doubling). */
      if (hb->fdq_count == hb->fdq_cap) {
          int new_cap = hb->fdq_cap * 2;
          int *new_q = (int *)malloc((size_t)new_cap * sizeof(int));
          if (!new_q) {
              pthread_mutex_unlock(&hb->fdq_mtx);
              close(cfd);
              break;
          }
          for (int i = 0; i < hb->fdq_count; i++)
              new_q[i] = hb->fdq[(hb->fdq_head + i) % hb->fdq_cap];
          free(hb->fdq);
          hb->fdq = new_q;
          hb->fdq_head = 0;
          hb->fdq_tail = hb->fdq_count;
          hb->fdq_cap  = new_cap;
      }
      hb->fdq[hb->fdq_tail] = cfd;
      hb->fdq_tail = (hb->fdq_tail + 1) % hb->fdq_cap;
      hb->fdq_count++;
      pthread_cond_signal(&hb->fdq_cv);
      pthread_mutex_unlock(&hb->fdq_mtx);
  }
  ```)

;;; httpd-new-pool -- create an httpd instance with a configurable worker count.
;;;
;;; Parameters:
;;;   port    -- TCP port to listen on (0 = kernel-assigned)
;;;   workers -- number of worker threads in the pool (must be > 0)
;;;   handler -- fat closure: (fn [conn :ptr<void>] :nil)
;;;
;;; Returns:
;;;   ptr<void> -- opaque Httpd handle, or nil on error
;;;
;;; Since: Phase H3
(defn httpd-new-pool [port :int workers :int handler :int] :ptr<void>
  ```c
  #include <fcntl.h>
  typedef struct {
      int listen_fd; int64_t handler;
      void *reactor; int listen_src_id; void *accept_clos;
      pthread_t *workers; int n_workers;
      int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
      int fdq_closed;
      pthread_mutex_t fdq_mtx;
      pthread_cond_t  fdq_cv;
      volatile int stop_flag;
  } HttpdBlock;
  if (workers <= 0) workers = 4;
  int fd = socket(AF_INET, SOCK_STREAM, 0);
  if (fd < 0) return NULL;
  int opt = 1;
  setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
  int flags = fcntl(fd, F_GETFL, 0);
  fcntl(fd, F_SETFL, flags | O_NONBLOCK);
  struct sockaddr_in addr;
  memset(&addr, 0, sizeof(addr));
  addr.sin_family      = AF_INET;
  addr.sin_addr.s_addr = htonl(INADDR_ANY);
  addr.sin_port        = htons((uint16_t)port);
  if (bind(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) { close(fd); return NULL; }
  if (listen(fd, 128) < 0) { close(fd); return NULL; }
  HttpdBlock *hb = (HttpdBlock *)calloc(1, sizeof(HttpdBlock));
  if (!hb) { close(fd); return NULL; }
  hb->listen_fd = fd;
  hb->handler   = (int64_t)handler;
  hb->n_workers = (int)workers;
  /* Initialise the shared queue with a small capacity (will grow). */
  hb->fdq_cap = 16;
  hb->fdq     = (int *)malloc((size_t)hb->fdq_cap * sizeof(int));
  if (!hb->fdq) { close(fd); free(hb); return NULL; }
  pthread_mutex_init(&hb->fdq_mtx, NULL);
  pthread_cond_init(&hb->fdq_cv,  NULL);
  /* Reactor + accept callback (synthetic fat closure { __fn, hb }). */
  hb->reactor = tur_reactor_new();
  if (!hb->reactor) { free(hb->fdq); close(fd); free(hb); return NULL; }
  int64_t *clos = (int64_t *)malloc(2 * sizeof(int64_t));
  if (!clos) {
      tur_reactor_free(hb->reactor);
      free(hb->fdq); close(fd); free(hb); return NULL;
  }
  clos[0] = (int64_t)(intptr_t)httpd_accept_cb;
  clos[1] = (int64_t)(intptr_t)hb;
  hb->accept_clos = (void *)clos;
  hb->listen_src_id = (int)tur_reactor_add_fd(hb->reactor, fd, 1,
      (int64_t)(intptr_t)clos, NULL);
  if (hb->listen_src_id < 0) {
      free(clos);
      tur_reactor_free(hb->reactor);
      free(hb->fdq); close(fd); free(hb); return NULL;
  }
  /* Spawn worker threads. */
  hb->workers = (pthread_t *)malloc((size_t)workers * sizeof(pthread_t));
  if (!hb->workers) {
      tur_reactor_remove(hb->reactor, hb->listen_src_id);
      free(clos);
      tur_reactor_free(hb->reactor);
      free(hb->fdq); close(fd); free(hb); return NULL;
  }
  for (int i = 0; i < workers; i++) {
      pthread_create(&hb->workers[i], NULL,
                     (void *(*)(void *))httpd_worker, (void *)hb);
  }
  return (void *)hb;
  ```)

;;; httpd-new -- create a new httpd instance with the default worker pool size (4).
;;;
;;; Parameters:
;;;   port    -- TCP port to listen on (0 = kernel-assigned)
;;;   handler -- fat closure: (fn [conn :ptr<void>] :nil)
;;;
;;; Returns:
;;;   ptr<void> -- opaque Httpd handle, or nil on error
;;;
;;; Example:
;;;   (let [h (httpd-new 0 (fn [conn :ptr<void>] :nil
;;;                          (httpd-resp-status! conn 200)
;;;                          (httpd-resp-body! conn "OK")))]
;;;     (httpd-run h)
;;;     (httpd-free h))
;;;
;;; Since: Phase H1
(defn httpd-new [port :int handler :int] :ptr<void>
  (httpd-new-pool port 4 handler))

;;; httpd-port -- return the port the server is listening on.
;;;
;;; Useful when httpd-new was called with port 0 (kernel-assigned).
;;;
;;; Parameters:
;;;   h -- httpd handle returned by httpd-new
;;;
;;; Returns:
;;;   int -- the actual listening port, or -1 on error
;;;
;;; Since: Phase H1
(defn httpd-port [h :ptr<void>] :int
  ```c
  typedef struct {
      int listen_fd; int64_t handler;
      void *reactor; int listen_src_id; void *accept_clos;
      pthread_t *workers; int n_workers;
      int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
      int fdq_closed;
      pthread_mutex_t fdq_mtx;
      pthread_cond_t  fdq_cv;
      volatile int stop_flag;
  } HttpdBlock;
  HttpdBlock *hb = (HttpdBlock *)h;
  struct sockaddr_in addr;
  socklen_t len = sizeof(addr);
  if (getsockname(hb->listen_fd, (struct sockaddr *)&addr, &len) < 0) return -1;
  return (int64_t)ntohs(addr.sin_port);
  ```)

;;; httpd-run -- run the listener reactor until httpd-stop is called.
;;;
;;; Since: Phase H1
(defn httpd-run [h :ptr<void>] :nil
  ```c
  typedef struct {
      int listen_fd; int64_t handler;
      void *reactor; int listen_src_id; void *accept_clos;
      pthread_t *workers; int n_workers;
      int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
      int fdq_closed;
      pthread_mutex_t fdq_mtx;
      pthread_cond_t  fdq_cv;
      volatile int stop_flag;
  } HttpdBlock;
  HttpdBlock *hb = (HttpdBlock *)h;
  tur_reactor_run(hb->reactor);
  ```)

;;; httpd-stop -- signal the listener to stop accepting new connections.
;;;
;;; Thread-safe. Stops the listener reactor and closes the shared queue
;;; so workers exit when drained.
;;;
;;; Since: Phase H1
(defn httpd-stop [h :ptr<void>] :nil
  ```c
  typedef struct {
      int listen_fd; int64_t handler;
      void *reactor; int listen_src_id; void *accept_clos;
      pthread_t *workers; int n_workers;
      int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
      int fdq_closed;
      pthread_mutex_t fdq_mtx;
      pthread_cond_t  fdq_cv;
      volatile int stop_flag;
  } HttpdBlock;
  HttpdBlock *hb = (HttpdBlock *)h;
  hb->stop_flag = 1;
  if (hb->reactor) {
      tur_reactor_stop(hb->reactor);
      tur_reactor_wake(hb->reactor);
  }
  pthread_mutex_lock(&hb->fdq_mtx);
  hb->fdq_closed = 1;
  pthread_cond_broadcast(&hb->fdq_cv);
  pthread_mutex_unlock(&hb->fdq_mtx);
  ```)

;;; httpd-free -- free all resources after httpd-run returns.
;;;
;;; Joins the worker threads, removes the reactor source, frees the
;;; reactor and synthetic accept closure, closes the listen socket,
;;; drains and frees the shared queue, and frees the HttpdBlock.
;;;
;;; Since: Phase H1
(defn httpd-free [h :ptr<void>] :nil
  ```c
  typedef struct {
      int listen_fd; int64_t handler;
      void *reactor; int listen_src_id; void *accept_clos;
      pthread_t *workers; int n_workers;
      int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
      int fdq_closed;
      pthread_mutex_t fdq_mtx;
      pthread_cond_t  fdq_cv;
      volatile int stop_flag;
  } HttpdBlock;
  HttpdBlock *hb = (HttpdBlock *)h;
  if (hb->workers) {
      for (int i = 0; i < hb->n_workers; i++)
          pthread_join(hb->workers[i], NULL);
      free(hb->workers);
  }
  if (hb->reactor) {
      if (hb->listen_src_id >= 0) tur_reactor_remove(hb->reactor, hb->listen_src_id);
      tur_reactor_free(hb->reactor);
  }
  if (hb->accept_clos) free(hb->accept_clos);
  if (hb->listen_fd >= 0) close(hb->listen_fd);
  if (hb->fdq) {
      /* Close any pending fds we never got to. */
      while (hb->fdq_count > 0) {
          close(hb->fdq[hb->fdq_head]);
          hb->fdq_head = (hb->fdq_head + 1) % hb->fdq_cap;
          hb->fdq_count--;
      }
      free(hb->fdq);
  }
  pthread_mutex_destroy(&hb->fdq_mtx);
  pthread_cond_destroy(&hb->fdq_cv);
  free(hb);
  ```)

;;; httpd-req-method -- return the HTTP method from the parsed request.
;;;
;;; Since: Phase H1
(defn httpd-req-method [conn :ptr<void>] :cstr
  ```c
  typedef struct {
      int fd; int64_t handler;
      char method[16]; char path[1024]; char version[16];
      int resp_status; char *resp_body; int resp_body_len;
  } HttpdConn;
  return ((HttpdConn *)conn)->method;
  ```)

;;; httpd-req-path -- return the request-target path from the parsed request.
;;;
;;; Since: Phase H1
(defn httpd-req-path [conn :ptr<void>] :cstr
  ```c
  typedef struct {
      int fd; int64_t handler;
      char method[16]; char path[1024]; char version[16];
      int resp_status; char *resp_body; int resp_body_len;
  } HttpdConn;
  return ((HttpdConn *)conn)->path;
  ```)

;;; httpd-resp-status! -- set the HTTP response status code.
;;;
;;; Since: Phase H1
(defn httpd-resp-status! [conn :ptr<void> status :int] :nil
  ```c
  typedef struct {
      int fd; int64_t handler;
      char method[16]; char path[1024]; char version[16];
      int resp_status; char *resp_body; int resp_body_len;
  } HttpdConn;
  ((HttpdConn *)conn)->resp_status = (int)status;
  ```)

;;; httpd-resp-body! -- set the HTTP response body (copies the string).
;;;
;;; Since: Phase H1
(defn httpd-resp-body! [conn :ptr<void> body :cstr] :nil
  ```c
  typedef struct {
      int fd; int64_t handler;
      char method[16]; char path[1024]; char version[16];
      int resp_status; char *resp_body; int resp_body_len;
  } HttpdConn;
  HttpdConn *c = (HttpdConn *)conn;
  if (c->resp_body) { free(c->resp_body); c->resp_body = NULL; c->resp_body_len = 0; }
  if (!body) return;
  size_t len = strlen(body);
  c->resp_body = (char *)malloc(len + 1);
  if (!c->resp_body) return;
  memcpy(c->resp_body, body, len + 1);
  c->resp_body_len = (int)len;
  ```)
