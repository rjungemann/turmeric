;;; httpd-resp-body! -- set the HTTP response body (copies the string).
;;;
;;; Since: Phase H1

(defn httpd-resp-body! [conn :ptr<void> body :cstr] :nil
  ```c typedef struct {
      int fd; int64_t handler;
      char method[16]; char path[1024]; char version[16];
      char *body; int body_len;
      int resp_status; char *resp_body; int resp_body_len;
      int client_keep_alive;
  } HttpdConn;
  HttpdConn *c = (HttpdConn *)conn;
  if (c->resp_body) { free(c->resp_body); c->resp_body = NULL; c->resp_body_len = 0; }
  if (!body) return;
  size_t len = strlen(body);
  c->resp_body = (char *)malloc(len + 1);
  if (!c->resp_body) return;
  memcpy(c->resp_body, body, len + 1);
  c->resp_body_len = (int)len;
  ```)
;; =============================================================================
;; M0: Arbitrary request / response header access
;; =============================================================================
;;
;; The H1-H7 surface only exposed Method, Path, Version, Body, Status.
;; M0 widens this so middleware can read any request header by name and
;; set/append any response header.  All header storage is per-iteration
;; (freed in httpd-handle's cleanup); handlers never need to free.
;;
;; Request reads are case-insensitive; missing headers return "".
;; Response writes:
;;   - `httpd-resp-header!`     replaces any existing entry with `name`.
;;   - `httpd-resp-header-add!` always appends (for `Set-Cookie`, `Vary`).
;;   - A user-set `Content-Length` is silently dropped by the writer
;;     (the actual response body length is authoritative).
;;   - If no `Content-Type` is set, the writer defaults to
;;     `text/plain; charset=utf-8`.
;;; httpd-req-header -- look up a request header by name (case-insensitive).
;;;
;;; Returns the empty string if the header is absent.
;;;
;;; Parameters:
;;;   conn -- connection handle from the worker
;;;   name -- header name to look up (case-insensitive)
;;;
;;; Returns:
;;;   The header value as a cstr (pointer into per-request storage; valid
;;;   only for the duration of the handler call). Empty string if absent.
;;;
;;; Example:
;;;   (let [ua (httpd-req-header c "User-Agent")] ...)
;;;
;;; Since: Phase H8 (M0)

(defn httpd-req-header [conn :ptr<void> name :cstr] :cstr
  ```c typedef struct __HttpdHeader {
      char *name; char *value; struct __HttpdHeader *next;
  } HttpdHeader;
  typedef struct {
      int fd; int64_t handler;
      char method[16]; char path[1024]; char version[16];
      char *body; int body_len;
      int resp_status; char *resp_body; int resp_body_len;
      int client_keep_alive;
      void *route_params;
      int64_t tls;
      void *req_headers;
      void *resp_headers;
  } HttpdConn;
  if (!conn || !name) return "";
  HttpdHeader *h = (HttpdHeader *)((HttpdConn *)conn)->req_headers;
  while (h) {
      if (h->name && strcasecmp(h->name, name) == 0) {
          return h->value ? h->value : "";
      }
      h = h->next;
  }
  return "";
  ```)
;;; httpd-req-header? -- presence test for a request header.
;;;
;;; Parameters:
;;;   conn -- connection handle from the worker
;;;   name -- header name (case-insensitive)
;;;
;;; Returns:
;;;   1 if present, 0 otherwise.
;;;
;;; Example:
;;;   (when (= 1 (httpd-req-header? c "Authorization")) ...)
;;;
;;; Since: Phase H8 (M0)

(defn httpd-req-header? [conn :ptr<void> name :cstr] :int
  ```c typedef struct __HttpdHeader {
      char *name; char *value; struct __HttpdHeader *next;
  } HttpdHeader;
  typedef struct {
      int fd; int64_t handler;
      char method[16]; char path[1024]; char version[16];
      char *body; int body_len;
      int resp_status; char *resp_body; int resp_body_len;
      int client_keep_alive;
      void *route_params;
      int64_t tls;
      void *req_headers;
      void *resp_headers;
  } HttpdConn;
  if (!conn || !name) return 0;
  HttpdHeader *h = (HttpdHeader *)((HttpdConn *)conn)->req_headers;
  while (h) {
      if (h->name && strcasecmp(h->name, name) == 0) return 1;
      h = h->next;
  }
  return 0;
  ```)
;;; httpd-resp-header! -- set (or replace) a response header.
;;;
;;; If `name` is already present on the response, its value is replaced.
;;; Otherwise a new entry is appended.  Use `httpd-resp-header-add!` for
;;; truly repeatable headers like `Set-Cookie` or `Vary`.
;;;
;;; Parameters:
;;;   conn  -- connection handle from the worker
;;;   name  -- header name (case-insensitive on the dedup check)
;;;   value -- header value
;;;
;;; Example:
;;;   (httpd-resp-header! c "Content-Type" "application/json")
;;;
;;; Since: Phase H8 (M0)

(defn httpd-resp-header! [conn :ptr<void> name :cstr value :cstr] :nil
  ```c typedef struct __HttpdHeader {
      char *name; char *value; struct __HttpdHeader *next;
  } HttpdHeader;
  typedef struct {
      int fd; int64_t handler;
      char method[16]; char path[1024]; char version[16];
      char *body; int body_len;
      int resp_status; char *resp_body; int resp_body_len;
      int client_keep_alive;
      void *route_params;
      int64_t tls;
      void *req_headers;
      void *resp_headers;
  } HttpdConn;
  if (!conn || !name) return;
  HttpdConn *c = (HttpdConn *)conn;
  /* Replace if name already present. */
  HttpdHeader *h = (HttpdHeader *)c->resp_headers;
  while (h) {
      if (h->name && strcasecmp(h->name, name) == 0) {
          if (h->value) free(h->value);
          size_t vl = value ? strlen(value) : 0;
          h->value = (char *)malloc(vl + 1);
          if (h->value) {
              if (vl > 0) memcpy(h->value, value, vl);
              h->value[vl] = '\0';
          }
          return;
      }
      h = h->next;
  }
  /* Append new entry. */
  HttpdHeader *nh = (HttpdHeader *)calloc(1, sizeof(HttpdHeader));
  if (!nh) return;
  size_t nl = strlen(name);
  size_t vl = value ? strlen(value) : 0;
  nh->name  = (char *)malloc(nl + 1);
  nh->value = (char *)malloc(vl + 1);
  if (!nh->name || !nh->value) {
      if (nh->name)  free(nh->name);
      if (nh->value) free(nh->value);
      free(nh);
      return;
  }
  memcpy(nh->name, name, nl); nh->name[nl] = '\0';
  if (vl > 0) memcpy(nh->value, value, vl);
  nh->value[vl] = '\0';
  /* Append at tail. */
  HttpdHeader *t = (HttpdHeader *)c->resp_headers;
  if (!t) { c->resp_headers = nh; return; }
  while (t->next) t = t->next;
  t->next = nh;
  ```)
;;; httpd-resp-header-add! -- append a response header without de-duplication.
;;;
;;; Use for headers that legitimately repeat -- `Set-Cookie`, `Vary`,
;;; `WWW-Authenticate` -- where each entry is independent.  For single-
;;; valued headers, prefer `httpd-resp-header!`.
;;;
;;; Parameters:
;;;   conn  -- connection handle from the worker
;;;   name  -- header name
;;;   value -- header value
;;;
;;; Example:
;;;   (httpd-resp-header-add! c "Set-Cookie" "session=abc; Path=/")
;;;   (httpd-resp-header-add! c "Set-Cookie" "csrf=xyz; Path=/")
;;;
;;; Since: Phase H8 (M0)

(defn httpd-resp-header-add! [conn :ptr<void> name :cstr value :cstr] :nil
  ```c typedef struct __HttpdHeader {
      char *name; char *value; struct __HttpdHeader *next;
  } HttpdHeader;
  typedef struct {
      int fd; int64_t handler;
      char method[16]; char path[1024]; char version[16];
      char *body; int body_len;
      int resp_status; char *resp_body; int resp_body_len;
      int client_keep_alive;
      void *route_params;
      int64_t tls;
      void *req_headers;
      void *resp_headers;
  } HttpdConn;
  if (!conn || !name) return;
  HttpdConn *c = (HttpdConn *)conn;
  HttpdHeader *nh = (HttpdHeader *)calloc(1, sizeof(HttpdHeader));
  if (!nh) return;
  size_t nl = strlen(name);
  size_t vl = value ? strlen(value) : 0;
  nh->name  = (char *)malloc(nl + 1);
  nh->value = (char *)malloc(vl + 1);
  if (!nh->name || !nh->value) {
      if (nh->name)  free(nh->name);
      if (nh->value) free(nh->value);
      free(nh);
      return;
  }
  memcpy(nh->name, name, nl); nh->name[nl] = '\0';
  if (vl > 0) memcpy(nh->value, value, vl);
  nh->value[vl] = '\0';
  HttpdHeader *t = (HttpdHeader *)c->resp_headers;
  if (!t) { c->resp_headers = nh; return; }
  while (t->next) t = t->next;
  t->next = nh;
  ```)
;; =============================================================================
;; H6: Routing DSL
;; =============================================================================
;;
;; Router holds a linked list of (method, pattern, handler) tuples. Patterns
;; are slash-separated segments; a segment starting with ':' captures the
;; corresponding path segment into a named parameter that the handler can
;; read with httpd-param.
;;
;; Example:
;;   (let [r (router-new)]
;;     (router-add r "GET"  "/"            home-h)
;;     (router-add r "GET"  "/users/:id"   show-h)
;;     (router-add r "POST" "/users"       create-h)
;;     (httpd-new 0 (fn [c :ptr<void>] :nil (router-dispatch r c))))
;;
;; Router layout:    { void *routes; }   (head of Route list)
;; Route layout:     { char method[16]; char pattern[1024];
;;                     int64_t handler; void *next; }
;; RouteParam:       { char name[64]; char value[256]; void *next; }
;;; router-new -- create an empty router.
;;;
;;; Returns:
;;;   ptr<void> -- opaque Router handle
;;;
;;; Since: Phase H6


(defn router-new [] :ptr<void>
  ```c typedef struct { void *routes; } Router;
  Router *r = (Router *)malloc(sizeof(Router));
  if (!r) return NULL;
  r->routes = NULL;
  return (void *)r;
  ```)
;;; router-add -- register a route with the given method, pattern, and handler.
;;;
;;; The handler closure is called when an incoming request's method matches
;;; and its path matches the pattern. Path segments starting with ':' capture
;;; the corresponding request segment; the value can be read inside the
;;; handler via httpd-param.
;;;
;;; Parameters:
;;;   r       -- router handle
;;;   method  -- HTTP method ("GET", "POST", etc.)
;;;   pattern -- path pattern (e.g. "/users/:id")
;;;   handler -- fat closure: (fn [conn :ptr<void>] :nil)
;;;
;;; Since: Phase H6

(defn router-add [r :ptr<void> method :cstr pattern :cstr handler :int] :nil
  ```c typedef struct Route Route;
  struct Route {
      char method[16];
      char pattern[1024];
      int64_t handler;
      Route *next;
  };
  typedef struct { Route *routes; } Router;
  Router *router = (Router *)r;
  Route *route = (Route *)malloc(sizeof(Route));
  if (!route) return;
  size_t mlen = strlen(method); if (mlen > 15) mlen = 15;
  memcpy(route->method, method, mlen); route->method[mlen] = '\0';
  size_t plen = strlen(pattern); if (plen > 1023) plen = 1023;
  memcpy(route->pattern, pattern, plen); route->pattern[plen] = '\0';
  route->handler = (int64_t)handler;
  /* Append at tail so registration order is preserved. */
  if (!router->routes) {
      route->next = NULL;
      router->routes = route;
  } else {
      Route *cur = router->routes;
      while (cur->next) cur = cur->next;
      route->next = NULL;
      cur->next = route;
  }
  ```)
;;; router-free -- free a router and all registered routes.
;;;
;;; Parameters:
;;;   r -- router handle
;;;
;;; Since: Phase H6

(defn router-free [r :ptr<void>] :nil
  ```c typedef struct Route Route;
  struct Route { char method[16]; char pattern[1024]; int64_t handler; Route *next; };
  typedef struct { Route *routes; } Router;
  Router *router = (Router *)r;
  Route *cur = router->routes;
  while (cur) {
      Route *nx = cur->next;
      free(cur);
      cur = nx;
  }
  free(router);
  ```)
;;; router-dispatch -- match the current request against the router's table.
;;;
;;; On match: attaches captured path params to conn, calls the route's
;;; handler with conn, then frees the params. On no match: sets a 404
;;; response with body "Not Found".
;;;
;;; Parameters:
;;;   r    -- router handle
;;;   conn -- connection handle (the one passed to the httpd handler)
;;;
;;; Since: Phase H6

(defn router-dispatch [r :ptr<void> conn :ptr<void>] :nil
  ```c typedef struct Route Route;
  struct Route { char method[16]; char pattern[1024]; int64_t handler; Route *next; };
  typedef struct { Route *routes; } Router;
  typedef struct RouteParam RouteParam;
  struct RouteParam { char name[64]; char value[256]; RouteParam *next; };
  typedef struct {
      int fd; int64_t handler;
      char method[16]; char path[1024]; char version[16];
      char *body; int body_len;
      int resp_status; char *resp_body; int resp_body_len;
      int client_keep_alive;
      void *route_params;
  } HttpdConn;
  Router *router = (Router *)r;
  HttpdConn *c   = (HttpdConn *)conn;
  for (Route *route = router->routes; route; route = route->next) {
      if (strcmp(route->method, c->method) != 0) continue;
      /* Match path segment by segment. */
      const char *pp = route->pattern;
      const char *pc = c->path;
      RouteParam *params = NULL;
      int matched = 1;
      while (1) {
          while (*pp == '/') pp++;
          while (*pc == '/') pc++;
          if (!*pp && !*pc) break;
          if ((!*pp) != (!*pc)) { matched = 0; break; }
          const char *seg_pp = pp;
          while (*seg_pp && *seg_pp != '/') seg_pp++;
          const char *seg_pc = pc;
          while (*seg_pc && *seg_pc != '/' && *seg_pc != '?') seg_pc++;
          if (*pp == ':') {
              int name_len = (int)(seg_pp - pp - 1);
              int val_len  = (int)(seg_pc - pc);
              if (val_len <= 0) { matched = 0; break; }
              RouteParam *p = (RouteParam *)malloc(sizeof(RouteParam));
              if (!p) { matched = 0; break; }
              if (name_len > 63) name_len = 63;
              if (val_len  > 255) val_len  = 255;
              memcpy(p->name,  pp + 1, (size_t)name_len);  p->name[name_len]  = '\0';
              memcpy(p->value, pc,     (size_t)val_len);   p->value[val_len]  = '\0';
              p->next = params;
              params = p;
          } else {
              int pp_len = (int)(seg_pp - pp);
              int pc_len = (int)(seg_pc - pc);
              if (pp_len != pc_len || memcmp(pp, pc, (size_t)pp_len) != 0) {
                  matched = 0;
                  break;
              }
          }
          pp = seg_pp;
          pc = seg_pc;
      }
      if (matched) {
          c->route_params = (void *)params;
          int64_t *fat = (int64_t *)(intptr_t)route->handler;
          typedef void (*fn1_t)(void *, int64_t);
          ((fn1_t)(intptr_t)fat[0])((void *)fat, (int64_t)(intptr_t)c);
          /* Free params after handler returns. */
          RouteParam *cur = params;
          while (cur) { RouteParam *nx = cur->next; free(cur); cur = nx; }
          c->route_params = NULL;
          return;
      }
      /* Free partial params from failed match. */
      RouteParam *cur = params;
      while (cur) { RouteParam *nx = cur->next; free(cur); cur = nx; }
  }
  /* No route matched: 404. */
  c->resp_status = 404;
  const char *nf = "Not Found";
  size_t nflen = strlen(nf);
  c->resp_body = (char *)malloc(nflen + 1);
  if (c->resp_body) {
      memcpy(c->resp_body, nf, nflen + 1);
      c->resp_body_len = (int)nflen;
  }
  ```)
;;; httpd-param -- read a captured route parameter set by router-dispatch.
;;;
;;; Parameters:
;;;   conn -- connection handle passed to the route handler
;;;   name -- parameter name (e.g. "id" for a ":id" pattern segment)
;;;
;;; Returns:
;;;   cstr -- the captured value, or "" if no parameter with that name
;;;
;;; Example:
;;;   ;; pattern "/users/:id" matched against "/users/42"
;;;   (httpd-param conn "id")  ; => "42"
;;;
;;; Since: Phase H6

(defn httpd-param [conn :ptr<void> name :cstr] :cstr
  ```c typedef struct RouteParam RouteParam;
  struct RouteParam { char name[64]; char value[256]; RouteParam *next; };
  typedef struct {
      int fd; int64_t handler;
      char method[16]; char path[1024]; char version[16];
      char *body; int body_len;
      int resp_status; char *resp_body; int resp_body_len;
      int client_keep_alive;
      void *route_params;
  } HttpdConn;
  HttpdConn *c = (HttpdConn *)conn;
  RouteParam *p = (RouteParam *)c->route_params;
  while (p) {
      if (strcmp(p->name, name) == 0) return p->value;
      p = p->next;
  }
  return "";
  ```)
;; =============================================================================
;; H7: Middleware -- composable request/response transformations
;; =============================================================================
;;
;; A "middleware" is a function `(fn [next :int] :int (fn [conn :ptr<void>] :nil
;; ... (httpd-call next conn) ...))`: given a downstream handler closure, it
;; returns a new handler closure that wraps it. Pre-processing runs before
;; (httpd-call next conn); post-processing runs after.
;;
;; Multiple middlewares compose by nesting: `(outer (inner base-handler))`
;; produces a chain where outer's pre-hook runs first and outer's post-hook
;; runs last. The optional `compose-middleware` helper applies a list of
;; middlewares in left-to-right order.
;;
;; Example:
;;   (defn mw-log [next :int] :int
;;     (fn [c :ptr<void>] :nil
;;       (println (str-concat "REQ " (httpd-req-path c)))
;;       (httpd-call next c)))
;;
;;   (let [base (fn [c :ptr<void>] :nil (httpd-resp-body! c "ok"))]
;;     (httpd-new 0 (mw-log base)))
;;; httpd-call -- invoke a Turmeric handler closure on a connection.
;;;
;;; The closure must follow the fat-closure calling convention (i.e. it
;;; must capture at least one variable -- the same constraint as for the
;;; top-level handler passed to httpd-new).
;;;
;;; Parameters:
;;;   handler -- handler closure value (int)
;;;   conn    -- connection handle from the worker
;;;
;;; Since: Phase H7


(defn httpd-call [handler :int conn :ptr<void>] :nil
  ```c if (!handler) return;
  int64_t *fat = (int64_t *)(intptr_t)handler;
  typedef void (*fn1_t)(void *, int64_t);
  ((fn1_t)(intptr_t)fat[0])((void *)fat, (int64_t)(intptr_t)conn);
  ```)
;;; defroute -- macro sugar for (router-add router method pattern handler).
;;;
;;; Example:
;;;   (defroute r "GET" "/" (fn [c :ptr<void>] :nil ...))
;;;
;;; Since: Phase H6

(defmacro defroute [router method pattern handler]
  `(router-add ~router ~method ~pattern ~handler))
;; =============================================================================
;; M1: mw-log -- request logging middleware (per docs/upcoming/httpd-middleware-async-plan.md)
;; =============================================================================
;;
;; The reference middleware on top of the H7 convention. Logs one line per
;; request with method, path, status, response byte count, and elapsed wall
;; time in milliseconds (CLOCK_MONOTONIC).
;;
;; Example:
;;   (let [base     (fn [c :ptr<void>] :nil (httpd-resp-body! c "ok"))
;;         composed (mw-log base)]
;;     (httpd-new 0 composed))
;;
;; Output line shape (one per request):
;;   GET /path -> 200 2 0ms
;;; httpd-mw-mono-ms -- monotonic clock helper (milliseconds). Internal.

(defn httpd-mw-mono-ms [] :int
  ```c
  #include <time.h>
  struct timespec __ts;
  clock_gettime(CLOCK_MONOTONIC, &__ts);
  return (int64_t)__ts.tv_sec * 1000LL + (int64_t)__ts.tv_nsec / 1000000LL;
  ```)
;;; httpd-mw-log-emit -- emit one log line for a completed request. Internal.

(defn httpd-mw-log-emit [c :ptr<void> elapsed-ms :int] :nil
  ```c typedef struct {
      int fd; int64_t handler;
      char method[16]; char path[1024]; char version[16];
      char *body; int body_len;
      int resp_status; char *resp_body; int resp_body_len;
      int client_keep_alive;
  } HttpdConn;
  HttpdConn *cn = (HttpdConn *)c;
  int status = cn->resp_status ? cn->resp_status : 200;
  fprintf(stdout, "%s %s -> %d %d %lldms\n",
          cn->method, cn->path, status, cn->resp_body_len,
          (long long)elapsed_ms);
  fflush(stdout);
  ```)
;;; mw-log -- request logging middleware (stdout).
;;;
;;; Wraps a base handler so every request prints one line to stdout after
;;; the handler returns. The line carries the request method, path, the
;;; response status (defaulting to 200 if unset), the response body length
;;; in bytes, and the elapsed wall time in milliseconds.
;;;
;;; Parameters:
;;;   next -- downstream handler closure (fat-closure :int)
;;;
;;; Returns:
;;;   A wrapped handler closure (:int) with the same calling convention as
;;;   handlers passed to httpd-new / httpd-new-pool.
;;;
;;; Example:
;;;   (let [base     (fn [c :ptr<void>] :nil
;;;                    (httpd-resp-status! c 200)
;;;                    (httpd-resp-body!   c "hi"))
;;;         composed (mw-log base)]
;;;     (httpd-new 0 composed))
;;;
;;; Since: Phase H8 (M1)

(defn mw-log [next :int] :ptr<void>
  (let [_n next]
    (fn [c :ptr<void>] :nil
      (let [t0 (httpd-mw-mono-ms)]
        (httpd-call _n c)
        (httpd-mw-log-emit c (- (httpd-mw-mono-ms) t0))))))
;; =============================================================================
;; M8 (core): compose-middleware -- nest multiple middlewares around a base
;; =============================================================================
;;
;; Each middleware is a one-argument fat closure of the H7 shape:
;;   (fn [next :int] :int  <wrapped-closure>)
;;
;; compose-middleware applies them right-to-left so the leftmost middleware
;; in the argument list ends up as the OUTERMOST wrapper -- its pre-hook
;; runs first and its post-hook runs last:
;;
;;   (compose-middleware base mw-log mw-cors mw-auth)
;;   ;; is equivalent to (mw-log (mw-cors (mw-auth base)))
;;
;; Note: each middleware argument must itself be a fat closure (i.e. must
;; capture at least one variable). A bare top-level defn cannot be passed by
;; name; wrap it in `(fn [n :int] :int (... n))` first, or define it the way
;; mw-log is defined here (the outer `let` over `next` forces a fat closure).
;;; compose-middleware -- wrap a base handler with multiple middlewares.
;;;
;;; Parameters:
;;;   base -- base handler closure (:int)
;;;   mws  -- variadic middleware closures (each `(fn [next :int] :int)`),
;;;           applied right-to-left so the leftmost ends up outermost.
;;;
;;; Returns:
;;;   The fully-wrapped handler closure (:int).
;;;
;;; Example:
;;;   (let [composed (compose-middleware base mw-log)]
;;;     (httpd-new 0 composed))
;;;
;;; Since: Phase H8 (M8 core)

;;; compose-middleware -- nest multiple middlewares around a base handler.
;;;
;;; Macro: `(compose-middleware base mw1 mw2 mw3)` expands to
;;; `(mw1 (mw2 (mw3 base)))`, i.e. each `mw_i` is called as a one-argument
;;; function with the wrapped downstream handler. The leftmost middleware
;;; ends up as the OUTERMOST wrapper -- its pre-hook runs first and its
;;; post-hook runs last.
;;;
;;; Each `mw_i` must be name-callable with one argument: typically a defn
;;; like `mw-log` (shape `(defn mw-log [next :int] ... (fn [c] ...))`), or
;;; a partially applied form like `(mw-cors opts)` that itself returns a
;;; one-arg function. Bare closure VALUES are not directly callable in
;;; Turmeric -- use a defn (or wrap such a value in a defn) before passing
;;; it through compose-middleware.
;;;
;;; Example:
;;;   (let [composed (compose-middleware base mw-log)]
;;;     (httpd-new 0 composed))
;;;
;;;   ;; Multiple middlewares (mw-log is outermost):
;;;   (let [composed (compose-middleware base mw-log mw-cors mw-auth)]
;;;     (httpd-new 0 composed))
;;;
;;; Since: Phase H8 (M8 core)

(defmacro compose-middleware [base & mws]
  (if (empty? mws)
    base
    (list (first mws)
      (list compose-middleware base ~@(rest mws)))))
