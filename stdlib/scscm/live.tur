;; stdlib/scscm/live.tur — Live-Coding Integration
;;
;; This module provides a REPL-friendly evaluation system for live-coding
;; with hcsynth. It enables hot-reloading of synth patches and patterns.

(import scscm/synth :synth)
(import scscm/params :params)
(import scscm/types :types)

;; ============================================================================
;; Time Utilities
;; ============================================================================

;; Get current time in samples (relative to world creation)
;; For now, this is a simple counter - in future could use hcsynth timing
(defstruct TimeState
  [samples :int64])

;;; time-state-new -- Create a new TimeState starting at sample zero.
;;;
;;; Returns:
;;;   A TimeState map with samples initialized to 0.
(defn time-state-new []
  {:samples 0})

;;; time-advance! -- Advance a TimeState forward by a given number of samples.
;;;
;;; Parameters:
;;;   state -- A TimeState map.
;;;   samples -- Number of samples to advance.
(defn time-advance! [state samples]
  (set! state (update state :samples + samples)))

;;; now-samples -- Get the current sample time from a TimeState.
;;;
;;; Parameters:
;;;   state -- A TimeState map.
;;;
;;; Returns:
;;;   Current sample count as int64.
;;;
;;; Example:
;;;   (now-samples ts)  ; => 48000
(defn now-samples [state]
  (:samples state))

;; ============================================================================
;; Live-Coding Session
;; ============================================================================

;; Extended session for live-coding with additional state
(defstruct LiveSession
  [base :synth/ScscmSession
   time-state :TimeState
   scheduled-fns :(vec<fn>)
   pattern-players :(map<int fn>)
   next-player-id :int])

;;; live-session-new -- Create a new live-coding session.
;;;
;;; Parameters:
;;;   sample_rate -- Audio sample rate in Hz (default: DEFAULT_SAMPLE_RATE).
;;;   block_size -- Audio block size in samples (default: DEFAULT_BLOCK_SIZE).
;;;
;;; Returns:
;;;   A LiveSession map ready for live-coding.
;;;
;;; Example:
;;;   (live-session-new 48000 512)
(defn live-session-new [& [sample_rate types/DEFAULT_SAMPLE_RATE
                           block_size types/DEFAULT_BLOCK_SIZE]]
  {:base (synth/session-new sample_rate block_size)
   :time-state (time-state-new)
   :scheduled-fns []
   :pattern-players {}
   :next-player-id 0})

;;; live-session-destroy -- Destroy a live session and its underlying audio world.
;;;
;;; Parameters:
;;;   session -- A LiveSession map.
(defn live-session-destroy [session]
  (synth/session-destroy (:base session)))

;; ============================================================================
;; Synth Replacement (Hot-Reloading)
;; ============================================================================

;;; synth-replace -- Replace a running synth with a new definition while live.
;;;
;;; Creates a new synth node for new-synthdef-name and frees the old one.
;;; This is the core live-coding operation for swapping out a running patch.
;;;
;;; Note: Parameter preservation (preserve-params?) is not yet implemented;
;;; the new synth always starts with default parameters.
;;;
;;; Parameters:
;;;   session -- A LiveSession map.
;;;   old-node-id -- Node ID of the synth to replace.
;;;   new-synthdef-name -- Name of the replacement SynthDef.
;;;   preserve-params? -- Whether to copy parameters from old synth (default: true).
;;;
;;; Returns:
;;;   Node ID of the new synth, or nil if old-node-id is not found.
;;;
;;; Example:
;;;   (synth-replace sess 1001 "mySynthV2")
(defn synth-replace [session old-node-id new-synthdef-name & [preserve-params? true]]
  (let [old-synth (get (get-in session [:base :active-synths]) old-node-id)]
    (when old-synth
      ;; Get current parameter values (simplified - in real implementation
      ;; we'd query the actual values from scsynth)
      ;; For now, we just create a new synth with default params

      (let [new-node-id (synth/node-id-alloc (get-in session [:base :node-allocator]))]
        (let [result (synth/synth-new (:world-id (:base session)) new-synthdef-name new-node-id)]
          (if (== result 0)
            (do
              ;; Update session tracking
              (set! session (update-in session [:base :active-synths] dissoc old-node-id))
              (set! session (update-in session [:base :active-synths] assoc new-node-id new-synthdef-name))

              ;; Free old synth
              (synth/synth-free (:world-id (:base session)) old-node-id)

              new-node-id)
            nil))))))

;;; play-note -- Play a MIDI note through a SynthDef with automatic cleanup.
;;;
;;; Instantiates a synth, sets its frequency and amplitude from the note and
;;; velocity, then schedules it to be freed after the given duration.
;;;
;;; Parameters:
;;;   session -- A LiveSession map.
;;;   synthdef-name -- Name of the SynthDef to use.
;;;   note -- MIDI note number.
;;;   vel -- MIDI velocity (0-127).
;;;   duration -- Note duration in seconds.
;;;
;;; Returns:
;;;   Node ID of the created synth.
;;;
;;; Example:
;;;   (play-note sess "mySynth" 60 100 0.5)
(defn play-note [session synthdef-name note vel duration]
  (let [synth-node (synth/session-synth-new (:base session) synthdef-name)]
    ;; Set note parameters
    (let [freq (params/midi->hz note)
          amp (params/vel->amp vel)]
      ;; Assuming synth has freq and amp controls at indices 0 and 1
      ;; In a real implementation, this would use the SynthDef spec
      (synth/session-synth-set (:base session) synth-node {0 freq 1 amp}))

    ;; Schedule cleanup
    (let [samples-ahead (types/sec->samples duration (synth/world-sample-rate (:world-id (:base session))))]
      (set! session (update session :scheduled-fns conj
                       (fn []
                         (synth/session-synth-free (:base session) synth-node)))))

    synth-node))

;; ============================================================================
;; Scheduling
;; ============================================================================

;;; schedule-after -- Enqueue a thunk to run after a sample delay.
;;;
;;; Note: The current implementation appends to the scheduled queue without
;;; real delay tracking. Call process-scheduled each block to execute queued
;;; functions in order.
;;;
;;; Parameters:
;;;   session -- A LiveSession map.
;;;   samples -- Delay in samples (used to advance the TimeState when run).
;;;   thunk -- Zero-argument function to execute.
(defn schedule-after [session samples thunk]
  (set! session (update session :scheduled-fns conj
                   (fn []
                     (time-advance! (:time-state session) samples)
                     (thunk)))))

;;; process-scheduled -- Execute the next scheduled function in the queue.
;;;
;;; Call this once per block to drain scheduled callbacks in order.
;;;
;;; Parameters:
;;;   session -- A LiveSession map.
;;;   block-size -- Current block size in samples (unused; reserved for future timing).
(defn process-scheduled [session block-size]
  (let [scheduled (:scheduled-fns session)]
    (when (not (empty? scheduled))
      (let [new-scheduled (vec (rest scheduled))]
        (let [fn-to-run (first scheduled)]
          (fn-to-run))
        (set! session (assoc session :scheduled-fns new-scheduled))))))

;; ============================================================================
;; Pattern Players
;; ============================================================================

;;; pattern-player-new -- Create a pattern player that triggers events at a fixed interval.
;;;
;;; Parameters:
;;;   session -- A LiveSession map.
;;;   synthdef-name -- SynthDef name to use for each triggered event.
;;;   pattern-fn -- Function (current-samples -> param-map) called each interval.
;;;   interval-samples -- Interval between triggers in samples.
;;;
;;; Returns:
;;;   Integer player ID that can be passed to pattern-player-stop.
;;;
;;; Example:
;;;   (pattern-player-new sess "kick" (fn [_] {0 40.0}) 24000)
(defn pattern-player-new [session synthdef-name pattern-fn interval-samples]
  (let [player-id (:next-player-id session)]
    (set! session (update session :next-player-id inc))

    (let [player-fn (fn []
                      (let [params (pattern-fn (now-samples (:time-state session)))]
                        (synth/session-synth-new (:base session) synthdef-name params)))]

      ;; Store player for later removal
      (set! session (update session :pattern-players assoc player-id player-fn))

      ;; Schedule the first run
      (schedule-after session interval-samples
                       (fn []
                         (player-fn)
                         (schedule-after session interval-samples
                                        (get (:pattern-players session) player-id))))

      player-id)))

;;; pattern-player-stop -- Remove a pattern player so it no longer triggers.
;;;
;;; Parameters:
;;;   session -- A LiveSession map.
;;;   player-id -- ID returned by pattern-player-new.
(defn pattern-player-stop [session player-id]
  (set! session (update session :pattern-players dissoc player-id)))

;; ============================================================================
;; Live-Coding Evaluation
;; ============================================================================

;;; live-eval -- Evaluate a code string within the live-coding session context.
;;;
;;; Binds session state and utility functions for use by the evaluated code.
;;; The current implementation is a placeholder; in a full Turmeric runtime
;;; this would call eval with the constructed context.
;;;
;;; Parameters:
;;;   session -- A LiveSession map.
;;;   code -- Code string to evaluate.
;;;
;;; Returns:
;;;   Result of evaluation (currently returns code unchanged as a stub).
;;;
;;; Example:
;;;   (live-eval sess "(synth-new \"mySynth\")")
(defn live-eval [session code]
  ;; In Turmeric, we'd use eval or similar
  ;; For now, this is a placeholder that shows the concept

  ;; Bind session and utilities into evaluation context
  (let [context {
          'session session
          'base (:base session)
          'synth-new (fn [def-name & params]
                       (synth/session-synth-new (:base session) def-name params))
          'synth-free (fn [node-id]
                         (synth/session-synth-free (:base session) node-id))
          'synth-set (fn [node-id params]
                         (synth/session-synth-set (:base session) node-id params))
          'play-note play-note
          'midi->hz params/midi->hz
          'vel->amp params/vel->amp
          'db->amp params/db->amp
          'amp->db params/amp->db
          'now (fn [] (now-samples (:time-state session)))
        }]
    ;; In a real implementation, we'd evaluate code with this context
    ;; For now, just return the code as-is (conceptual)
    code))

;; ============================================================================
;; Utility Functions
;; ============================================================================

;;; bpm->beats-per-sec -- Convert beats per minute to beats per second.
;;;
;;; Parameters:
;;;   bpm -- Tempo in beats per minute.
;;;
;;; Returns:
;;;   Beats per second as a float.
;;;
;;; Example:
;;;   (bpm->beats-per-sec 120.0)  ; => 2.0
(defn bpm->beats-per-sec [bpm]
  (/ bpm 60.0))

;;; beats->sec -- Convert a beat count to seconds at a given BPM.
;;;
;;; Parameters:
;;;   beats -- Number of beats.
;;;   bpm -- Tempo in beats per minute.
;;;
;;; Returns:
;;;   Duration in seconds.
;;;
;;; Example:
;;;   (beats->sec 4.0 120.0)  ; => 2.0
(defn beats->sec [beats bpm]
  (/ beats (bpm->beats-per-sec bpm)))

;;; sec->beats -- Convert seconds to a beat count at a given BPM.
;;;
;;; Parameters:
;;;   sec -- Duration in seconds.
;;;   bpm -- Tempo in beats per minute.
;;;
;;; Returns:
;;;   Number of beats.
;;;
;;; Example:
;;;   (sec->beats 2.0 120.0)  ; => 4.0
(defn sec->beats [sec bpm]
  (* sec (bpm->beats-per-sec bpm)))

;;; play-pattern -- Schedule a pattern to play at a given BPM.
;;;
;;; Parameters:
;;;   session -- A LiveSession map.
;;;   synthdef-name -- SynthDef name for each triggered event.
;;;   pattern-fn -- Function (beats -> param-map) generating event parameters.
;;;   bpm -- Tempo in beats per minute.
;;;   interval-beats -- Interval between triggers in beats (default: 1 = every beat).
;;;
;;; Returns:
;;;   Player ID that can be passed to pattern-player-stop.
;;;
;;; Example:
;;;   (play-pattern sess "kick" (fn [_] {0 40.0}) 120.0)
(defn play-pattern [session synthdef-name pattern-fn bpm & [interval-beats 1]]
  (let [sample-rate (synth/world-sample-rate (:world-id (:base session)))
        interval-samples (types/sec->samples (beats->sec interval-beats bpm) sample-rate)]
    (pattern-player-new session synthdef-name pattern-fn interval-samples)))

;;; const-pattern -- Create a pattern function that always returns the same value.
;;;
;;; Parameters:
;;;   value -- The constant param-map to return at every time step.
;;;
;;; Returns:
;;;   Function (_ -> value).
;;;
;;; Example:
;;;   ((const-pattern {0 440.0}) 0)  ; => {0 440.0}
(defn const-pattern [value]
  (fn [_] value))

;;; cycle-pattern -- Create a pattern that cycles through values by beat position.
;;;
;;; Parameters:
;;;   values -- One or more values to cycle through.
;;;
;;; Returns:
;;;   Function (beats -> value) that advances one step per whole beat.
;;;
;;; Example:
;;;   ((cycle-pattern :a :b :c) 1)  ; => :b
(defn cycle-pattern [& values]
  (let [index 0]
    (fn [beats]
      (let [idx (mod (floor beats) (len values))]
        (get values idx)))))

;;; every-n -- Gate a pattern so it only fires on beat boundaries divisible by n.
;;;
;;; Parameters:
;;;   n -- Interval in beats.
;;;   pattern-fn -- Pattern function (beats -> value) to delegate to.
;;;
;;; Returns:
;;;   Gated pattern function.
;;;
;;; Example:
;;;   ((every-n 4 (const-pattern :kick)) 4)  ; => :kick
(defn every-n [n pattern-fn]
  (fn [beats]
    (when (== 0 (mod (floor beats) n))
      (pattern-fn beats))))

;; ============================================================================
;; Session Rendering with Scheduling
;; ============================================================================

;;; live-session-render -- Render a block, process scheduled callbacks, and advance time.
;;;
;;; Should be called once per audio block. Processes scheduled functions,
;;; advances the TimeState, then renders audio.
;;;
;;; Parameters:
;;;   session -- A LiveSession map.
;;;   output_buffer -- Output buffer pointer.
;;;   num_samples -- Number of samples to render.
;;;   num_channels -- Number of output channels.
;;;
;;; Returns:
;;;   0 on success, -1 on error.
;;;
;;; Example:
;;;   (live-session-render sess buf 512 2)
(defn live-session-render [session output_buffer num_samples num_channels]
  ;; Process scheduled functions first
  (process-scheduled session num_samples)

  ;; Advance time
  (time-advance! (:time-state session) num_samples)

  ;; Render audio
  (synth/world-render (:world-id (:base session)) output_buffer num_samples num_channels))
