;; stdlib/scscm/scscm.tur — Main SCSCM Library Module
;;
;; This is the main module for the SCSCM (SuperCollider Synth Control)
;; library. It provides a complete Turmeric interface to the hcsynth
;; C API for live-coding audio synthesis.
;;
;; Import this module to get access to all SCSCM functionality:
;;   (import scscm/scscm :scscm)

;; Re-export all submodules
(import scscm/ffi :ffi)
(import scscm/types :types)
(import scscm/msg :msg)
(import scscm/synth :synth)
(import scscm/params :params)
(import scscm/live :live)
(import scscm/pattern :pattern)
(import scscm/errors :errors)
(import scscm/perf :perf)

;;; SCSCM_VERSION -- Semantic version string for the SCSCM library.
(def SCSCM_VERSION "0.1.0")

;;; SCSCM_INFO -- Metadata map describing the SCSCM library.
;;;
;;; Fields: :version, :name, :description, :author, :dependencies.
(def SCSCM_INFO
  {:version SCSCM_VERSION
   :name "scscm"
   :description "SuperCollider Synth Control for Turmeric"
   :author "Turmeric Team"
   :dependencies ["hcsynth"]})
