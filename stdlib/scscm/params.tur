;; stdlib/scscm/params.tur — Type-safe Parameter System
;;
;; This module provides a type-safe parameter control system with automatic
;; warping and clamping for SuperCollider synth parameters.

(import scscm/types :types)
(import scscm/synth :synth)

;; ============================================================================
;; Parameter Warping Functions
;; ============================================================================

;;; warp-value -- Map a user-space value to OSC range using the spec's warp type.
;;;
;;; Parameters:
;;;   spec -- A ParamSpec map containing at least :warp.
;;;   value -- Input value in user space.
;;;
;;; Returns:
;;;   Warped value suitable for sending to scsynth.
;;;
;;; Example:
;;;   (warp-value PARAM_FREQ 440.0)  ; => 440.0 (exp warp applies octave formula)
(defn warp-value [spec value]
  (case (:warp spec)
    :linear value
    :exp (math/pow 2.0 (/ value 12.0))  ;; octave to ratio
    :log (* 12.0 (math/log2 value))     ;; ratio to octave
    :db (math/pow 10.0 (/ value 20.0))   ;; dB to amplitude
    :db2 (* 20.0 (math/log10 value))    ;; amplitude to dB
    value))  ;; Default: no warping

;;; unwarp-value -- Map an OSC value back to user space using the spec's warp type.
;;;
;;; Parameters:
;;;   spec -- A ParamSpec map containing at least :warp.
;;;   value -- Value received from scsynth in OSC space.
;;;
;;; Returns:
;;;   Value in user space (inverse warp of warp-value).
;;;
;;; Example:
;;;   (unwarp-value PARAM_FREQ (warp-value PARAM_FREQ 440.0))  ; => 440.0
(defn unwarp-value [spec value]
  (case (:warp spec)
    :linear value
    :exp (* 12.0 (math/log2 value))     ;; ratio to octave
    :log (math/pow 2.0 (/ value 12.0))   ;; octave to ratio
    :db (* 20.0 (math/log10 value))     ;; amplitude to dB
    :db2 (math/pow 10.0 (/ value 20.0))   ;; dB to amplitude
    value))  ;; Default: no warping

;;; clamp-value -- Clamp a value to the min/max range specified in a ParamSpec.
;;;
;;; Parameters:
;;;   spec -- A ParamSpec map with :min and :max fields.
;;;   value -- Value to clamp.
;;;
;;; Returns:
;;;   The value clamped to [spec.min, spec.max].
;;;
;;; Example:
;;;   (clamp-value PARAM_AMP 1.5)  ; => 1.0
(defn clamp-value [spec value]
  (math/clamp value (:min spec) (:max spec)))

;;; param->osc -- Clamp and warp a user-space value ready for scsynth.
;;;
;;; Parameters:
;;;   spec -- A ParamSpec map.
;;;   value -- User-space value.
;;;
;;; Returns:
;;;   OSC-ready float (clamped first, then warped).
;;;
;;; Example:
;;;   (param->osc PARAM_AMP 0.8)  ; => 0.8
(defn param->osc [spec value]
  (let [clamped (clamp-value spec value)
        warped (warp-value spec clamped)]
    warped))

;;; osc->param -- Unwarp and clamp an OSC value back to user space.
;;;
;;; Parameters:
;;;   spec -- A ParamSpec map.
;;;   value -- OSC value from scsynth.
;;;
;;; Returns:
;;;   User-space float clamped to the spec's original range.
;;;
;;; Example:
;;;   (osc->param PARAM_AMP 0.8)  ; => 0.8
(defn osc->param [spec value]
  (let [unwarped (unwarp-value spec value)]
    (clamp-value spec unwarped)))

;; ============================================================================
;; Common Parameter Specifications
;; ============================================================================

;;; param-spec -- Create a parameter specification with common defaults.
;;;
;;; Parameters:
;;;   name -- Parameter name string (must match the SynthDef control name).
;;;   default -- Default value.
;;;   min -- Minimum value (default: 0.0).
;;;   max -- Maximum value (default: 1.0).
;;;   unit -- Unit label string, e.g. "Hz", "dB", "sec" (default: "").
;;;   warp -- Warp type keyword: :linear, :exp, :log, :db, :db2 (default: :linear).
;;;
;;; Returns:
;;;   A ParamSpec map.
;;;
;;; Example:
;;;   (param-spec "freq" 440.0 20.0 20000.0 "Hz" :exp)
(defn param-spec [name default & [min 0.0 max 1.0 unit "" warp :linear]]
  {:name name
   :default default
   :min min
   :max max
   :unit unit
   :warp warp})

;; Common parameter specs for typical synth controls

;; Amplitude parameter (0-1, linear)
(def PARAM_AMP (param-spec "amp" 0.5 0.0 1.0 "" :linear))

;; Frequency parameter (exponential, Hz)
(def PARAM_FREQ (param-spec "freq" 440.0 20.0 20000.0 "Hz" :exp))

;; Pan parameter (-1 to 1, linear)
(def PARAM_PAN (param-spec "pan" 0.0 -1.0 1.0 "" :linear))

;; Sustain level (0-1, linear)
(def PARAM_SUS (param-spec "sus" 0.5 0.0 1.0 "" :linear))

;; Attack time (0-10 seconds, linear)
(def PARAM_ATK (param-spec "atk" 0.1 0.0 10.0 "sec" :linear))

;; Decay time (0-10 seconds, linear)
(def PARAM_DEC (param-spec "dec" 0.5 0.0 10.0 "sec" :linear))

;; Release time (0-10 seconds, linear)
(def PARAM_REL (param-spec "rel" 1.0 0.0 10.0 "sec" :linear))

;; Filter cutoff (20-20000 Hz, exponential)
(def PARAM_CUTOFF (param-spec "cutoff" 1000.0 20.0 20000.0 "Hz" :exp))

;; Filter Q/Resonance (0.1-10, linear)
(def PARAM_Q (param-spec "q" 1.0 0.1 10.0 "" :linear))

;; LFO rate (0.1-20 Hz, exponential)
(def PARAM_LFO_RATE (param-spec "lfo-rate" 1.0 0.1 20.0 "Hz" :exp))

;; LFO depth (0-1, linear)
(def PARAM_LFO_DEPTH (param-spec "lfo-depth" 0.5 0.0 1.0 "" :linear))

;; ============================================================================
;; SynthDef Specifications
;; ============================================================================

;;; synthdef-spec -- Assemble a SynthDef specification from a list of ParamSpecs.
;;;
;;; Parameters:
;;;   synthdef_name -- SynthDef name (currently unused; reserved for future metadata).
;;;   param-specs -- Vector of ParamSpec maps describing each control.
;;;
;;; Returns:
;;;   SynthDefSpec (currently just the param-specs vector).
;;;
;;; Example:
;;;   (synthdef-spec "mySynth" [PARAM_FREQ PARAM_AMP])
(defn synthdef-spec [synthdef_name param-specs]
  param-specs)  ;; For now, just return the param-specs
                   ;; In future, this could be a struct with more metadata

;;; find-param -- Find a ParamSpec by name within a SynthDefSpec.
;;;
;;; Parameters:
;;;   spec -- SynthDefSpec (vector of ParamSpec maps).
;;;   param_name -- Parameter name to search for.
;;;
;;; Returns:
;;;   The matching ParamSpec map, or nil if not found.
;;;
;;; Example:
;;;   (find-param SIN_SYNTH_SPEC "freq")
(defn find-param [spec param_name]
  (first (filter #(== (:name %) param_name) spec)))

;;; find-param-index -- Get the zero-based index of a parameter by name.
;;;
;;; Parameters:
;;;   spec -- SynthDefSpec (vector of ParamSpec maps).
;;;   param_name -- Parameter name to search for.
;;;
;;; Returns:
;;;   Integer index of the parameter, or nil if not found.
;;;
;;; Example:
;;;   (find-param-index SIN_SYNTH_SPEC "amp")  ; => 1
(defn find-param-index [spec param_name]
  (let [i 0]
    (for [param spec]
      (when (== (:name param) param_name)
        i)
      (set! i (inc i)))))

;; ============================================================================
;; Synth Controller
;; ============================================================================

;; A SynthController manages a synth instance with typed parameter control
(defstruct SynthController
  [node-id :types/NodeID
   session :ScscmSession  ;; Reference to parent session
   synthdef-name :types/SynthDefName
   spec :types/SynthDefSpec])

;;; synth-controller-new -- Create a synth and wrap it in a typed controller.
;;;
;;; Parameters:
;;;   session -- Parent ScscmSession.
;;;   synthdef-name -- Name of the SynthDef to instantiate.
;;;   synthdef-spec -- SynthDefSpec listing this SynthDef's parameters.
;;;   params -- Optional initial values as a name -> value map.
;;;
;;; Returns:
;;;   A SynthController map. Panics if the synth cannot be created.
;;;
;;; Example:
;;;   (synth-controller-new sess "mySynth" SIN_SYNTH_SPEC {"freq" 880.0})
(defn synth-controller-new [session synthdef-name synthdef-spec & [params {}]]
  (let [node_id (synth/node-id-alloc (:node-allocator session))]
    (let [result (synth-new (:world-id session) synthdef-name node_id)]
      (if (== result 0)
        (let [ctrl {:node-id node_id
                    :session session
                    :synthdef-name synthdef-name
                    :spec synthdef-spec}]
          ;; Apply initial parameters
          (doseq [[param_name value] params]
            (let [param (find-param synthdef-spec param_name)]
              (when param
                (let [index (find-param-index synthdef-spec param_name)]
                  (when index
                    (let [osc-value (param->osc param value)]
                      (synth-set (:world-id session) node_id index osc-value)))))))
          ctrl)
        (panic (str "Failed to create synth: " synthdef-name))))))

;;; synth-controller-free -- Free the synth node owned by a controller.
;;;
;;; Parameters:
;;;   ctrl -- A SynthController map.
(defn synth-controller-free [ctrl]
  (synth-free (:world-id (:session ctrl)) (:node-id ctrl)))

;;; ctrl-set -- Set a named parameter on a synth controller (with warping).
;;;
;;; Parameters:
;;;   ctrl -- A SynthController map.
;;;   param_name -- Name of the parameter to set.
;;;   value -- User-space value (will be clamped and warped before sending).
;;;
;;; Returns:
;;;   true if the parameter was found and set, false otherwise.
;;;
;;; Example:
;;;   (ctrl-set ctrl "freq" 880.0)
(defn ctrl-set [ctrl param_name value]
  (let [param (find-param (:spec ctrl) param_name)]
    (if param
      (let [index (find-param-index (:spec ctrl) param_name)]
        (if index
          (let [osc-value (param->osc param value)]
            (synth-set (:world-id (:session ctrl)) (:node-id ctrl) index osc-value)
            true)
          false))
      false)))

;;; ctrl-set-multi -- Set multiple named parameters on a controller.
;;;
;;; Parameters:
;;;   ctrl -- A SynthController map.
;;;   param-map -- Map of parameter name -> user-space value.
;;;
;;; Returns:
;;;   Number of parameters successfully set.
;;;
;;; Example:
;;;   (ctrl-set-multi ctrl {"freq" 880.0 "amp" 0.6})  ; => 2
(defn ctrl-set-multi [ctrl param-map]
  (let [count 0]
    (for [[param_name value] param-map]
      (when (ctrl-set ctrl param_name value)
        (set! count (inc count))))
    count))

;;; ctrl-get -- Get the current value for a named parameter (returns spec default).
;;;
;;; Note: Live readback from scsynth is not yet supported; this returns the
;;; default value from the ParamSpec. Future versions may query scsynth directly.
;;;
;;; Parameters:
;;;   ctrl -- A SynthController map.
;;;   param_name -- Parameter name to look up.
;;;
;;; Returns:
;;;   Default value from the ParamSpec, or nil if the parameter is not found.
;;;
;;; Example:
;;;   (ctrl-get ctrl "freq")  ; => 440.0 (spec default)
(defn ctrl-get [ctrl param_name]
  ;; For now, return the default value from the spec
  ;; In future, this could query the actual value from scsynth
  (let [param (find-param (:spec ctrl) param_name)]
    (when param
      (:default param))))

;; ============================================================================
;; Parameter Conversion Utilities
;; ============================================================================

;;; midi->hz -- Convert a MIDI note number to frequency in Hz.
;;;
;;; Parameters:
;;;   note -- MIDI note number (69 = A4 = 440 Hz).
;;;
;;; Returns:
;;;   Frequency in Hz as a float.
;;;
;;; Example:
;;;   (midi->hz 69)  ; => 440.0
(defn midi->hz [note]
  (* 440.0 (math/pow 2.0 (/ (- note 69.0) 12.0))))

;;; vel->amp -- Convert a MIDI velocity to linear amplitude.
;;;
;;; Parameters:
;;;   vel -- MIDI velocity (0-127).
;;;
;;; Returns:
;;;   Amplitude in [0.0, 1.0].
;;;
;;; Example:
;;;   (vel->amp 64)  ; => ~0.504
(defn vel->amp [vel]
  (/ vel 127.0))

;;; db->amp -- Convert a decibel level to linear amplitude.
;;;
;;; Parameters:
;;;   db -- Level in decibels.
;;;
;;; Returns:
;;;   Linear amplitude as a float.
;;;
;;; Example:
;;;   (db->amp -6.0)  ; => ~0.501
(defn db->amp [db]
  (math/pow 10.0 (/ db 20.0)))

;;; amp->db -- Convert linear amplitude to decibels.
;;;
;;; Parameters:
;;;   amp -- Linear amplitude (0.0 or below returns -90.0).
;;;
;;; Returns:
;;;   Level in decibels.
;;;
;;; Example:
;;;   (amp->db 0.5)  ; => ~-6.02
(defn amp->db [amp]
  (if (> amp 0)
    (* 20.0 (math/log10 amp))
    -90.0))

;; ============================================================================
;; Example SynthDef Specifications
;; ============================================================================

;; Simple sine wave synth parameter spec
(def SIN_SYNTH_SPEC
  [(param-spec "freq" 440.0 20.0 20000.0 "Hz" :exp)
   (param-spec "amp" 0.5 0.0 1.0 "" :linear)
   (param-spec "pan" 0.0 -1.0 1.0 "" :linear)])

;; Simple ADSR envelope synth parameter spec
(def ADSR_SYNTH_SPEC
  [(param-spec "freq" 440.0 20.0 20000.0 "Hz" :exp)
   (param-spec "amp" 0.5 0.0 1.0 "" :linear)
   (param-spec "atk" 0.1 0.0 10.0 "sec" :linear)
   (param-spec "dec" 0.5 0.0 10.0 "sec" :linear)
   (param-spec "sus" 0.5 0.0 1.0 "" :linear)
   (param-spec "rel" 1.0 0.0 10.0 "sec" :linear)])

;; Filtered noise synth parameter spec
(def NOISE_SYNTH_SPEC
  [(param-spec "amp" 0.5 0.0 1.0 "" :linear)
   (param-spec "cutoff" 1000.0 20.0 20000.0 "Hz" :exp)
   (param-spec "q" 1.0 0.1 10.0 "" :linear)
   (param-spec "pan" 0.0 -1.0 1.0 "" :linear)])
