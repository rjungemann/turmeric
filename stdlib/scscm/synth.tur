;; stdlib/scscm/synth.tur — High-level Synth and Node API
;;
;; This module provides a high-level API for SuperCollider synth graph control
;; using the hcsynth C API. For most use cases, this is the recommended interface.
;;
;; Note: This uses the direct hcsynth C API functions rather than OSC messages
;; for better performance and reliability.

(import scscm/ffi :ffi)
(import scscm/types :types)

;; ============================================================================
;; World Management
;; ============================================================================

;;; world-create -- Create a new audio engine (world) instance.
;;;
;;; Parameters:
;;;   sample_rate -- Sample rate in Hz (default: DEFAULT_SAMPLE_RATE = 48000).
;;;   block_size -- Block size in samples (default: DEFAULT_BLOCK_SIZE = 512).
;;;
;;; Returns:
;;;   WorldHandle (int), or 0 on error.
;;;
;;; Example:
;;;   (world-create 48000 512)  ; => <handle>
(defn world-create [& [sample_rate types/DEFAULT_SAMPLE_RATE
                         block_size types/DEFAULT_BLOCK_SIZE]]
  (ffi/hc_wasm_world_create sample_rate block_size))

;;; world-destroy -- Destroy an audio engine instance and free its resources.
;;;
;;; Parameters:
;;;   world_id -- World handle returned by world-create.
;;;
;;; Returns:
;;;   0 on success, -1 on error.
;;;
;;; Example:
;;;   (world-destroy w)
(defn world-destroy [world_id]
  (ffi/hc_wasm_world_destroy world_id))

;;; world-sample-rate -- Get the sample rate of an audio engine instance.
;;;
;;; Parameters:
;;;   world_id -- World handle.
;;;
;;; Returns:
;;;   Sample rate in Hz, or 0 if the world is not found.
(defn world-sample-rate [world_id]
  (ffi/hc_wasm_world_sample_rate world_id))

;;; world-block-size -- Get the block size of an audio engine instance.
;;;
;;; Parameters:
;;;   world_id -- World handle.
;;;
;;; Returns:
;;;   Block size in samples, or 0 if the world is not found.
(defn world-block-size [world_id]
  (ffi/hc_wasm_world_block_size world_id))

;; ============================================================================
;; SynthDef Management
;; ============================================================================

;;; synthdef-load -- Load a compiled SynthDef from binary data.
;;;
;;; Parameters:
;;;   world_id -- Target world handle.
;;;   synthdef_data -- SynthDef bytecode as slice<uint8>.
;;;   synthdef_name -- Optional name override; nil uses the name embedded in the data.
;;;
;;; Returns:
;;;   0 on success, -1 on error.
;;;
;;; Example:
;;;   (synthdef-load w my-bytes "mySynth")
(defn synthdef-load [world_id synthdef_data & [synthdef_name nil]]
  (let [data_ptr (slice/ptr synthdef_data)
        data_size (slice/len synthdef_data)]
    (ffi/hc_wasm_load_synthdef world_id data_ptr data_size synthdef_name)))

;;; synthdef-unload -- Remove a SynthDef from the world by name.
;;;
;;; Running instances created from this definition are not affected.
;;;
;;; Parameters:
;;;   world_id -- Target world handle.
;;;   synthdef_name -- Name of the SynthDef to remove.
;;;
;;; Returns:
;;;   0 on success, -1 on error.
;;;
;;; Example:
;;;   (synthdef-unload w "mySynth")
(defn synthdef-unload [world_id synthdef_name]
  (ffi/hc_wasm_unload_synthdef world_id synthdef_name))

;;; synthdef-unload-all -- Remove all SynthDefs from the world.
;;;
;;; Running instances are not affected.
;;;
;;; Parameters:
;;;   world_id -- Target world handle.
;;;
;;; Returns:
;;;   0 on success, -1 on error.
(defn synthdef-unload-all [world_id]
  (ffi/hc_wasm_unload_all_synthdefs world_id))

;;; synthdef-list -- Get a comma-separated list of loaded SynthDef names.
;;;
;;; Parameters:
;;;   world_id -- Target world handle.
;;;   buffer_size -- Size of internal buffer in bytes (determines max output length).
;;;
;;; Returns:
;;;   String of comma-separated SynthDef names. Panics on error.
;;;
;;; Example:
;;;   (synthdef-list w 1024)  ; => "mySynth,anotherSynth"
(defn synthdef-list [world_id buffer_size]
  (let [buffer (malloc buffer_size)]
    (defer (free buffer))
    (let [result (ffi/hc_wasm_list_synthdefs world_id buffer buffer_size)]
      (if (>= result 0)
        (slice/cstr->str buffer)
        (panic "Failed to list SynthDefs")))))

;; ============================================================================
;; Node (Synth Instance) Management
;; ============================================================================

;; Node placement actions
(def ADD_TO_HEAD ffi/ADD_TO_HEAD)
(def ADD_TO_TAIL ffi/ADD_TO_TAIL)
(def ADD_BEFORE ffi/ADD_BEFORE)
(def ADD_AFTER ffi/ADD_AFTER)
(def REPLACE ffi/REPLACE)

;;; synth-new -- Create a new synth instance from a SynthDef.
;;;
;;; Parameters:
;;;   world_id -- Target world handle.
;;;   synthdef_name -- Name of the SynthDef to instantiate.
;;;   node_id -- Unique node ID to assign (must not be 0).
;;;   target_id -- Target node/group ID (default: ROOT_GROUP_ID = 1).
;;;   action -- Placement action (default: ADD_TO_TAIL).
;;;
;;; Returns:
;;;   0 on success, -1 on error.
;;;
;;; Example:
;;;   (synth-new w "mySynth" 1001)
(defn synth-new [world_id synthdef_name node_id & [target_id types/ROOT_GROUP_ID
                                                     action ADD_TO_TAIL]]
  (ffi/hc_wasm_synth_new world_id synthdef_name node_id action target_id))

;;; synth-free -- Remove and stop a synth node.
;;;
;;; Parameters:
;;;   world_id -- Target world handle.
;;;   node_id -- Node ID to free.
;;;
;;; Returns:
;;;   0 on success, -1 on error.
;;;
;;; Example:
;;;   (synth-free w 1001)
(defn synth-free [world_id node_id]
  (ffi/hc_wasm_synth_free world_id node_id))

;;; synth-set -- Set a single control parameter on a synth node.
;;;
;;; Parameters:
;;;   world_id -- Target world handle.
;;;   node_id -- Target synth node ID.
;;;   control_index -- Zero-based control index.
;;;   value -- New control value.
;;;
;;; Returns:
;;;   0 on success, -1 on error.
;;;
;;; Example:
;;;   (synth-set w 1001 0 440.0)
(defn synth-set [world_id node_id control_index value]
  (ffi/hc_wasm_synth_set world_id node_id control_index value))

;;; synth-set-multi -- Set multiple control parameters on a synth in one call.
;;;
;;; Parameters:
;;;   world_id -- Target world handle.
;;;   node_id -- Target synth node ID.
;;;   param-map -- Map of control_index (int) -> value (float).
;;;
;;; Returns:
;;;   0 on success, -1 on error.
;;;
;;; Example:
;;;   (synth-set-multi w 1001 {0 440.0 1 0.8})
(defn synth-set-multi [world_id node_id param-map]
  (let [count (len param-map)
        indices (malloc (* count (size-of int)))
        values (malloc (* count (size-of float)))]
    (defer (free indices))
    (defer (free values))

    ;; Fill arrays from map
    (let [i 0]
      (for [[idx val] param-map]
        (do
          (ptr/write indices i idx)
          (ptr/write values i val)
          (set! i (inc i)))))

    (ffi/hc_wasm_synth_set_multi world_id node_id count indices values)))

;;; synth-set-by-name -- Set control parameters by name (not yet implemented).
;;;
;;; Requires SynthDef introspection support from the hcsynth C API.
;;; Calling this function will panic.
;;;
;;; Parameters:
;;;   world_id -- Target world handle.
;;;   node_id -- Target synth node ID.
;;;   synthdef_name -- SynthDef name used for parameter lookup.
;;;   param-name-value-pairs -- Alternating parameter name and value arguments.
(defn synth-set-by-name [world_id node_id synthdef_name & param-name-value-pairs]
  ;; For now, this is a placeholder - requires SynthDef introspection
  ;; which needs additional hcsynth API support
  (panic "synth-set-by-name requires SynthDef introspection (not yet implemented)"))

;; ============================================================================
;; Group Management
;; ============================================================================

;;; group-new -- Create a new node group.
;;;
;;; Parameters:
;;;   world_id -- Target world handle.
;;;   node_id -- Unique node ID to assign.
;;;   target_id -- Parent node/group ID (default: ROOT_GROUP_ID).
;;;   action -- Placement action (default: ADD_TO_TAIL).
;;;
;;; Returns:
;;;   0 on success, -1 on error.
;;;
;;; Example:
;;;   (group-new w 100)
(defn group-new [world_id node_id & [target_id types/ROOT_GROUP_ID
                                     action ADD_TO_TAIL]]
  (ffi/hc_wasm_synth_new world_id "Group" node_id action target_id))

;;; group-free -- Free a group node and all its children.
;;;
;;; Parameters:
;;;   world_id -- Target world handle.
;;;   node_id -- Group node ID to free.
;;;
;;; Returns:
;;;   0 on success, -1 on error.
;;;
;;; Example:
;;;   (group-free w 100)
(defn group-free [world_id node_id]
  (synth-free world_id node_id))

;; ============================================================================
;; Audio Rendering
;; ============================================================================

;;; world-render -- Render one block of audio to an output buffer.
;;;
;;; Parameters:
;;;   world_id -- Target world handle.
;;;   output_buffer -- Output buffer pointer (must hold num_samples * num_channels floats).
;;;   num_samples -- Number of samples to render (default: world block size).
;;;   num_channels -- Number of output channels (default: 2).
;;;
;;; Returns:
;;;   0 on success, -1 on error.
;;;
;;; Example:
;;;   (world-render w buf)
(defn world-render [world_id output_buffer & [num_samples nil
                                               num_channels 2]]
  (let [block_size (world-block-size world_id)]
    (ffi/hc_wasm_render world_id output_buffer (or num_samples block_size) num_channels)))

;;; world-process-controls -- Drain the command queue and apply pending control changes.
;;;
;;; Call this before rendering each block to ensure control updates are applied.
;;;
;;; Parameters:
;;;   world_id -- Target world handle.
;;;   max_messages -- Maximum messages to process per call (default: -1 = all).
;;;
;;; Returns:
;;;   Number of messages processed, or -1 on error.
(defn world-process-controls [world_id & [max_messages -1]]
  (ffi/hc_wasm_process_controls world_id max_messages))

;;; world-reset -- Clear all nodes and reset engine state.
;;;
;;; Parameters:
;;;   world_id -- Target world handle.
;;;
;;; Returns:
;;;   0 on success, -1 on error.
(defn world-reset [world_id]
  (ffi/hc_wasm_reset world_id))

;; ============================================================================
;; Diagnostic & Status
;; ============================================================================

;;; world-get-status -- Get engine statistics as a JSON string.
;;;
;;; Parameters:
;;;   world_id -- Target world handle.
;;;
;;; Returns:
;;;   JSON string with engine stats. Returns "{}" on error.
;;;
;;; Example:
;;;   (world-get-status w)  ; => "{\"cpu\":0.02,...}"
(defn world-get-status [world_id]
  (let [buffer (malloc 1024)]
    (defer (free buffer))
    (let [result (ffi/hc_wasm_get_status world_id buffer 1024)]
      (if (>= result 0)
        (slice/cstr->str buffer)
        "{}"))))

;;; world-get-metrics -- Get performance metrics for a world.
;;;
;;; Parameters:
;;;   world_id -- Target world handle.
;;;
;;; Returns:
;;;   Map with :cpu_percent, :xruns, and :buffer_used. Returns zeros on error.
;;;
;;; Example:
;;;   (:cpu_percent (world-get-metrics w))
(defn world-get-metrics [world_id]
  (let [cpu (malloc (size-of float))
        xruns (malloc (size-of int))
        buffer_used (malloc (size-of int))]
    (defer (free cpu))
    (defer (free xruns))
    (defer (free buffer_used))

    (let [result (ffi/hc_wasm_get_metrics world_id cpu xruns buffer_used)]
      (if (== result 0)
        {:cpu_percent (ptr/read cpu)
         :xruns (ptr/read xruns)
         :buffer_used (ptr/read buffer_used)}
        {:cpu_percent 0 :xruns 0 :buffer_used 0}))))

;;; world-reset-metrics -- Reset accumulated performance counters.
;;;
;;; Parameters:
;;;   world_id -- Target world handle.
;;;
;;; Returns:
;;;   0 on success, -1 on error.
(defn world-reset-metrics [world_id]
  (ffi/hc_wasm_reset_metrics world_id))

;; ============================================================================
;; UGen Discovery
;; ============================================================================

;;; list-ugens -- Get a newline-separated list of all registered UGen names.
;;;
;;; Returns:
;;;   String of newline-separated UGen names, or "" on error.
;;;
;;; Example:
;;;   (println (list-ugens))
(defn list-ugens []
  (let [buffer (malloc 8192)]
    (defer (free buffer))
    (let [result (ffi/hc_wasm_list_ugens buffer 8192)]
      (if (>= result 0)
        (slice/cstr->str buffer)
        ""))))

;; ============================================================================
;; Node ID Management
;; ============================================================================

;; Simple node ID allocator
(defstruct NodeIDAllocator
  [next-id :int32])

;;; node-id-allocator-new -- Create a simple monotonically-incrementing node ID allocator.
;;;
;;; Parameters:
;;;   start -- First ID to issue (default: DEFAULT_NODE_ID_START).
;;;
;;; Returns:
;;;   A NodeIDAllocator map.
(defn node-id-allocator-new [& [start types/DEFAULT_NODE_ID_START]]
  {:next-id start})

;;; node-id-alloc -- Allocate the next node ID from an allocator.
;;;
;;; Parameters:
;;;   allocator -- A NodeIDAllocator map.
;;;
;;; Returns:
;;;   A unique integer node ID.
(defn node-id-alloc [allocator]
  (let [id (:next-id allocator)]
    (set! allocator (update allocator :next-id inc))
    id))

;;; node-id-free -- Mark a node ID as released (no-op in the simple allocator).
;;;
;;; IDs are not reused by NodeIDAllocator. Use errors/NodeIDPool for reuse.
;;;
;;; Parameters:
;;;   allocator -- A NodeIDAllocator map.
;;;   id -- Node ID to release.
(defn node-id-free [allocator id]
  ;; For now, we don't reuse IDs (simplifies implementation)
  ;; In a more sophisticated implementation, we could track freed IDs
  )

;; ============================================================================
;; Session Management
;; ============================================================================

;; A session represents a connection to a hcsynth world with state
(defstruct ScscmSession
  [world-id :types/WorldHandle
   node-allocator :NodeIDAllocator
   active-synths :(map<NodeID SynthDefName>)
   synthdef-specs :(map<SynthDefName types/SynthDefSpec>)])

;;; session-new -- Create a new SCSCM session backed by a fresh audio world.
;;;
;;; Parameters:
;;;   sample_rate -- Audio sample rate in Hz (default: DEFAULT_SAMPLE_RATE).
;;;   block_size -- Audio block size in samples (default: DEFAULT_BLOCK_SIZE).
;;;
;;; Returns:
;;;   A ScscmSession map. Panics if the world cannot be created.
;;;
;;; Example:
;;;   (session-new 48000 512)
(defn session-new [& [sample_rate types/DEFAULT_SAMPLE_RATE
                      block_size types/DEFAULT_BLOCK_SIZE]]
  (let [world_id (world-create sample_rate block_size)]
    (if (== world_id 0)
      (panic "Failed to create world")
      {:world-id world_id
       :node-allocator (node-id-allocator-new)
       :active-synths {}
       :synthdef-specs {}})))

;;; session-destroy -- Destroy a session and its underlying audio world.
;;;
;;; Parameters:
;;;   session -- A ScscmSession map.
;;;
;;; Returns:
;;;   The (now-invalid) session map.
(defn session-destroy [session]
  (when (:world-id session)
    (world-destroy (:world-id session)))
  session)

;;; session-synth-new -- Instantiate a SynthDef and register it in the session.
;;;
;;; Parameters:
;;;   session -- A ScscmSession map.
;;;   synthdef_name -- Name of the SynthDef to instantiate.
;;;   params -- Optional initial parameter map (control_index -> value).
;;;
;;; Returns:
;;;   NodeID of the created synth. Panics if creation fails.
;;;
;;; Example:
;;;   (session-synth-new sess "mySynth" {0 440.0 1 0.8})
(defn session-synth-new [session synthdef_name & [params {}]]
  (let [node_id (node-id-alloc (:node-allocator session))]
    (let [result (synth-new (:world-id session) synthdef_name node_id)]
      (if (== result 0)
        (do
          (set! session (update session :active-synths assoc node_id synthdef_name))
          ;; Apply initial parameters
          (when (not (empty? params))
            (synth-set-multi (:world-id session) node_id params))
          node_id)
        (panic (str "Failed to create synth: " synthdef_name))))))

;;; session-synth-free -- Free a synth node and remove it from the session.
;;;
;;; Parameters:
;;;   session -- A ScscmSession map.
;;;   node_id -- Node ID to free.
(defn session-synth-free [session node_id]
  (when-let [synthdef_name (get (:active-synths session) node_id)]
    (synth-free (:world-id session) node_id)
    (set! session (update session :active-synths dissoc node_id))))

;;; session-synth-set -- Set multiple control parameters on a session synth.
;;;
;;; Parameters:
;;;   session -- A ScscmSession map.
;;;   node_id -- Target synth node ID.
;;;   params -- Parameter map (control_index -> value).
(defn session-synth-set [session node_id params]
  (synth-set-multi (:world-id session) node_id params))

;;; session-free-all -- Free every active synth in the session.
;;;
;;; Parameters:
;;;   session -- A ScscmSession map.
(defn session-free-all [session]
  (for [node_id (keys (:active-synths session))]
    (session-synth-free session node_id)))

;;; session-render -- Render audio for a session.
;;;
;;; Parameters:
;;;   session -- A ScscmSession map.
;;;   output_buffer -- Output buffer pointer.
;;;   num_samples -- Number of samples to render (optional, defaults to block size).
;;;   num_channels -- Number of output channels (default: 2).
;;;
;;; Returns:
;;;   0 on success, -1 on error.
(defn session-render [session output_buffer & [num_samples nil
                                                  num_channels 2]]
  (world-render (:world-id session) output_buffer num_samples num_channels))

;;; session-process-controls -- Drain the control queue for a session.
;;;
;;; Parameters:
;;;   session -- A ScscmSession map.
;;;   max_messages -- Maximum messages to process (default: -1 = all).
;;;
;;; Returns:
;;;   Number of messages processed, or -1 on error.
(defn session-process-controls [session & [max_messages -1]]
  (world-process-controls (:world-id session) max_messages))
