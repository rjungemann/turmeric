;;; tur/typeclass-hash -- minimal Hash typeclass stub for typed-collection keys.
;;;
;;; Auto-loaded so map and other content-keyed collections can resolve
;;; (Hash K) constraints for primitive key types without importing
;;; typeclass.tur.  Mirrors typeclass-eq.tur: it declares the Hash class
;;; plus the four primitive instances most likely to appear as map keys.
;;; The full typeclass.tur no longer re-declares Hash, so loading it on
;;; demand stays idempotent against this stub.
;;;
;;; Since: Phase GHE0
;; Phase GHE0: Minimal Hash class stub for typed map keys.
;; Auto-loaded so that map.tur (and #map{...} / hamt-of lowering) can route
;; content-keyed maps through (Hash K) for primitive K without requiring the
;; user to import stdlib/typeclass.tur.
;;; Hash -- typeclass for hashing a value to an integer.
;;;
;;; Parameters:
;;;   a -- the type to hash
;;;
;;; Returns:
;;;   An :int hash value suitable for use as a HAMT key.
;;;
;;; Example:
;;;   (hash 42)   ; => 42
;;;   (hash true) ; => 1
;;;
;;; Since: Phase TM0
(defclass Hash [a] (hash [x] : int))
;;; Hash [int] -- Hash instance for int (identity hash).

(definstance Hash [int] (hash [x] x))
;;; Hash [bool] -- Hash instance for bool (0 for false, 1 for true).

(definstance Hash [bool] (hash [x] (if x 1 0)))
;;; Hash [cstr] -- Hash instance for cstr (content hash via tur_hamt_hash_str).

(definstance Hash [cstr]
  (hash [x]
    : int
    ```c
    return (int64_t)tur_hamt_hash_str(x);
    ```))
;;; Hash [float32] -- Hash instance for float32 (bit-cast and hash).

(definstance Hash [float32]
  (hash [x]
    : int
    ```c
    union { float f; int32_t i; } u;
    u.f = (float)x;
    return (int64_t)u.i;
    ```))
;;; Hash [float] -- Hash instance for float (float64): hash the IEEE-754 bits.
;;;
;;; Without this instance a :float (64-bit) map key falls back to the int
;;; hash, which numerically truncates 1.5 -> 1 and collapses distinct keys.
;;; Bit-casting the double to its int64 pattern hashes by value instead.

(definstance Hash [float]
  (hash [x]
    : int
    ```c
    union { double f; int64_t i; } u;
    u.f = (double)x;
    return u.i;
    ```))
;;; Hash [any] -- hash a dynamically-typed value by its runtime type.
;;;
;;; set-of-element-type-is-not-checked / saffron-lang-plan S6: the honest type
;;; of a heterogeneous set is `(Set any)`, and a `(Set any)` needs `Hash[any]`.
;;; Each `is?` arm narrows `x` to the payload type, so the hash is exactly the
;;; one that payload would have had unboxed -- an `any` holding 1 hashes as
;;; `(hash 1)`, which is what lets a plain `1` probe a `(Set any)` and find it.
;;; Any other payload hashes by its TYPE NAME: correct (equal values agree)
;;; but coarse (every value of that type collides), which is the v0 trade for
;;; not reading an arbitrary payload word.  Pure Turmeric, so both back ends
;;; agree without a native.  The arms use the `.hash` method spelling on
;;; purpose: a bare `hash` resolves in the VALUE namespace, where a user
;;; `(defn hash ...)` legitimately shadows the method (TUR-W0039), and this
;;; body is elaborated in the user's program.
;;;
;;; Since: saffron-lang-plan S6 (Hash[any])

(definstance Hash [any]
  (hash [x]
    : int
    (if (is? x int)
      (.hash x)
      (if (is? x cstr)
        (.hash x)
        (if (is? x float)
          (.hash x)
          (if (is? x bool) (.hash x) (.hash (type-of x))))))))
