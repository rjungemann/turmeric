;;; tur/arrow -- Haskell-style Arrow typeclass hierarchy for signal processing.
;;;
;;; Provides Category, Arrow, ArrowChoice, and ArrowLoop typeclasses.
;;;
;;; Since: Phase CA0
;; Signal Processing Arrows Library
;; Haskell-style Arrow typeclass hierarchy for Turmeric
;;
;; This module implements the Arrow typeclass hierarchy for building
;; composable signal processing pipelines.
;;
;; Note: Full Arrow typeclass dispatch requires Turmeric features still in
;; development (Either/Left/Right sum types, vector literals in expression
;; position). The defclass declarations are provided for documentation and
;; future compatibility. Plain function implementations are provided for
;; immediate use.

;; =============================================================================
;; Arrow Typeclass Declarations
;; =============================================================================

;;; Arrow -- base typeclass for arrow-like structures.
;;;
;;; An Arrow arr is a type constructor that takes two type parameters (input and
;;; output) and supports lifting, sequential composition, and product-component
;;; application.
;;;
;;; Parameters:
;;;   ^arr -- the arrow type constructor (kind * -> * -> *)
;;;
;;; Example:
;;;   (arr (fn [x] (* x 2)))  ; => a function arrow that doubles its input
(defclass Arrow [^arr]
  ;; Lift a pure function to an arrow
  (arr [f] :int)
  ;; Sequential composition: f >>> g means "first f, then g"
  (>>> [f g] :int)
  ;; Apply arrow to first component of a product
  (first [f] :int)
  ;; Apply arrow to second component of a product
  (second [f] :int))

;;; ArrowZero -- arrows with an empty/zero element.
;;;
;;; Parameters:
;;;   ^arr -- the arrow type constructor
;;;
;;; Returns:
;;;   zeroArrow produces an arrow that yields no output.
(defclass ArrowZero [^arr]
  ;; The zero arrow: produces no output
  (zeroArrow [] :int))

;;; ArrowPlus -- arrows that can be combined with choice.
;;;
;;; Parameters:
;;;   ^arr -- the arrow type constructor
;;;
;;; Returns:
;;;   <+> combines two arrows in parallel.
(defclass ArrowPlus [^arr]
  ;; Combine two arrows in parallel
  (<+> [f g] :int))

;;; ArrowChoice -- arrows with choice over sum types (Either).
;;;
;;; Note: requires Either/Left/Right sum types (future Turmeric feature).
;;;
;;; Parameters:
;;;   ^arr -- the arrow type constructor
(defclass ArrowChoice [^arr]
  ;; Apply arrow to left component of a sum
  (left [f] :int)
  ;; Apply arrow to right component of a sum
  (right [f] :int)
  ;; Parallel composition for sums
  (+++ [f g] :int)
  ;; Fanin: combine two arrows on a sum
  (||| [f g] :int))

;;; ArrowLoop -- arrows with feedback loops for recursive signal processing.
;;;
;;; Parameters:
;;;   ^arr -- the arrow type constructor
(defclass ArrowLoop [^arr]
  ;; Feedback loop
  (loop [f] :int))

;;; ArrowApply -- arrows that support first-class application.
;;;
;;; Parameters:
;;;   ^arr -- the arrow type constructor
(defclass ArrowApply [^arr]
  ;; Apply: takes an arrow that produces arrows and applies it
  (app [f] :int))

;; =============================================================================
;; C Helpers for calling function-valued parameters
;; =============================================================================

;;; __arrow_call1 -- call a function stored as int64 with one argument.
(defn __arrow_call1 [f x] :int
  ```c
  return ((int64_t(*)(int64_t))(intptr_t)f)(x);
  ```)

;;; __arrow_call2 -- call a function stored as int64 with two arguments.
(defn __arrow_call2 [f x y] :int
  ```c
  return ((int64_t(*)(int64_t, int64_t))(intptr_t)f)(x, y);
  ```)

;; =============================================================================
;; Arrow Instance for Function Arrow (->)
;; =============================================================================

;;; Arrow instance for plain functions (->).
(definstance Arrow [->]
  (arr [f] f)
  (>>> [f g]
    (let [fv f gv g]
      (fn [x] (__arrow_call1 gv (__arrow_call1 fv x)))))
  (first [f]
    (let [fv f]
      (fn [p]
        ```c
        struct { int64_t first; int64_t second; } *pair = (void*)(intptr_t)p;
        struct { int64_t first; int64_t second; } *result = malloc(sizeof(*result));
        result->first  = ((int64_t(*)(int64_t))(intptr_t)fv)(pair->first);
        result->second = pair->second;
        return (int64_t)(intptr_t)result;
        ```)))
  (second [f]
    (let [fv f]
      (fn [p]
        ```c
        struct { int64_t first; int64_t second; } *pair = (void*)(intptr_t)p;
        struct { int64_t first; int64_t second; } *result = malloc(sizeof(*result));
        result->first  = pair->first;
        result->second = ((int64_t(*)(int64_t))(intptr_t)fv)(pair->second);
        return (int64_t)(intptr_t)result;
        ```))))

;; =============================================================================
;; ArrowChoice Instance for Function Arrow
;; =============================================================================

;;; ArrowChoice instance for plain functions (->).
;;; Note: requires Left/Right/Either (future feature); bodies are stubs.
(definstance ArrowChoice [->]
  (left [f]
    (let [fv f]
      (fn [eac]
        ```c return 0; ```)))
  (right [f]
    (let [fv f]
      (fn [eca]
        ```c return 0; ```)))
  (+++ [f g]
    (let [fv f gv g]
      (fn [eac]
        ```c return 0; ```)))
  (||| [f g]
    (let [fv f gv g]
      (fn [eab]
        ```c return 0; ```))))

;; =============================================================================
;; ArrowZero / ArrowPlus / ArrowLoop / ArrowApply instances
;; =============================================================================

;;; ArrowZero instance for plain functions (->).
(definstance ArrowZero [->]
  (zeroArrow []
    (fn [_] (error "zeroArrow for functions: no value"))))

;;; ArrowPlus instance for plain functions (->).
(definstance ArrowPlus [->]
  (<+> [f g]
    (let [fv f gv g]
      (fn [x] (error "ArrowPlus for functions: choice not defined")))))

;;; ArrowLoop instance for plain functions (->).
;;; Note: uses mutation for the feedback value.
(definstance ArrowLoop [->]
  (loop [f]
    (let [fv f
          c-ref (ref 0)]
      (fn [a]
        (let [pair (__arrow_call1 fv (Pair a @c-ref))]
          ```c
          /* Stub: feedback not fully implemented without Tuple support */
          return 0;
          ```)))))

;;; ArrowApply instance for plain functions (->).
(definstance ArrowApply [->]
  (app [f]
    (let [fv f]
      (fn [a]
        (__arrow_call1 (__arrow_call1 fv a) a)))))

;; =============================================================================
;; Plain Function Implementations
;; =============================================================================
;; These provide direct, non-dispatched versions of the Arrow combinators
;; for use when Arrow typeclass dispatch is not needed.

;;; arr -- lift a function to an arrow (identity for function arrows).
;;;
;;; Parameters:
;;;   f -- the function to lift
;;;
;;; Returns:
;;;   The function itself.
;;;
;;; Example:
;;;   (arr (fn [x] (+ x 1)))  ; => identity for functions
(defn arr [f] f)

;;; >>> -- compose two function arrows sequentially.
;;;
;;; Parameters:
;;;   f -- first arrow (a -> b)
;;;   g -- second arrow (b -> c)
;;;
;;; Returns:
;;;   A function (a -> c) that applies f then g.
;;;
;;; Example:
;;;   ((>>> (fn [x] (+ x 1)) (fn [x] (* x 2))) 3)  ; => 8
(defn >>> [f g]
  (let [fv f gv g]
    (fn [x] (__arrow_call1 gv (__arrow_call1 fv x)))))

;;; arrow-first -- apply a function to the first component of a Pair.
;;;
;;; Parameters:
;;;   f -- function to apply
;;;
;;; Returns:
;;;   A function on Pair that applies f to the first field.
;;;
;;; Example:
;;;   ((arrow-first (fn [x] (+ x 1))) (Pair 5 10))  ; => Pair(6, 10)
(defn arrow-first [f]
  (let [fv f]
    (fn [p]
      (Pair (__arrow_call1 fv (first p)) (second p)))))

;;; arrow-second -- apply a function to the second component of a Pair.
;;;
;;; Parameters:
;;;   f -- function to apply
;;;
;;; Returns:
;;;   A function on Pair that applies f to the second field.
;;;
;;; Example:
;;;   ((arrow-second (fn [x] (+ x 1))) (Pair 5 10))  ; => Pair(5, 11)
(defn arrow-second [f]
  (let [fv f]
    (fn [p]
      (Pair (first p) (__arrow_call1 fv (second p))))))

;;; arrow-id -- identity arrow for any Arrow instance.
;;;
;;; Parameters:
;;;   ^arr -- the arrow type constructor
;;;   a    -- the type parameter
;;;
;;; Returns:
;;;   An arrow that passes its input unchanged.
;;;
;;; Example:
;;;   (arrow-id)  ; => arr (fn [x] x)
(defn arrow-id [^arr a]
  (arr (fn [x] x)))

;;; arrow-comp -- compose two arrows sequentially.
;;;
;;; Parameters:
;;;   ^arr -- the arrow type constructor
;;;   f    -- first arrow (a -> b)
;;;   g    -- second arrow (b -> c)
;;;
;;; Returns:
;;;   An arrow (a -> c) that applies f then g.
;;;
;;; Example:
;;;   (arrow-comp f g)  ; => f >>> g
(defn arrow-comp [^arr a b c f g]
  (>>> f g))

;;; par-comp -- parallel composition of two functions on Pair types.
;;;
;;; Parameters:
;;;   f -- function a -> b
;;;   g -- function c -> d
;;;
;;; Returns:
;;;   A function on Pair a c -> Pair b d: (par-comp f g)(Pair x y) = Pair(f x, g y).
;;;
;;; Example:
;;;   ((par-comp inc double) (Pair 1 2))  ; => Pair(2, 4)
(defn par-comp [a b c d f g]
  (let [fv f gv g]
    (fn [p]
      (Pair (__arrow_call1 fv (first p)) (__arrow_call1 gv (second p))))))

;;; arrow-split -- duplicate input and apply two functions, returning a Pair.
;;;
;;; Parameters:
;;;   f -- function a -> b
;;;   g -- function a -> c
;;;
;;; Returns:
;;;   A function a -> Pair b c: (arrow-split f g)(x) = Pair(f x, g x).
;;;
;;; Example:
;;;   ((arrow-split inc double) 3)  ; => Pair(4, 6)
(defn arrow-split [a b c f g]
  (let [fv f gv g]
    (fn [x]
      (Pair (__arrow_call1 fv x) (__arrow_call1 gv x)))))

;;; <<< -- compose two function arrows in reverse order.
;;;
;;; Parameters:
;;;   g -- second arrow (b -> c), applied second
;;;   f -- first arrow (a -> b), applied first
;;;
;;; Returns:
;;;   A function (a -> c) equivalent to (>>> f g). Useful when reading
;;;   composition right-to-left: (<<< mul2 add1) = "mul2 after add1".
;;;
;;; Example:
;;;   ((<<< (fn [x] (* x 2)) (fn [x] (+ x 1))) 3)  ; => 8
;;;
;;; Since: Phase B2
(defn <<< [g f]
  (let [fv f gv g]
    (fn [x] (__arrow_call1 gv (__arrow_call1 fv x)))))

;;; arrow-const -- arrow that ignores its input and always returns v.
;;;
;;; Parameters:
;;;   v -- the constant value to return
;;;
;;; Returns:
;;;   An arrow (any -> v).
;;;
;;; Example:
;;;   ((arrow-const 42) 999)  ; => 42
;;;
;;; Since: Phase B2
(defn arrow-const [v]
  (let [cv v]
    (fn [_] cv)))

;;; arrow-dup -- arrow that duplicates its input into a Pair.
;;;
;;; Parameters:
;;;   x -- the value to duplicate
;;;
;;; Returns:
;;;   A Pair of x with itself: Pair(x, x).
;;;
;;; Example:
;;;   (first (arrow-dup 7))  ; => 7
;;;
;;; Since: Phase B2
(defn arrow-dup [x] :int
  (Pair x x))
