;;; tur/logic -- miniKanren-style logic programming (unification, goals, streams).
;;;
;;; Terms are tagged heap structs. Goals are functions from substitution to stream.
;;;
;;; Since: Phase B1
;; stdlib/logic.tur -- miniKanren-style logic programming
;;
;; Term = tagged heap struct { int64_t tag; int64_t data1; int64_t data2 }
;;   tag=0: INT,  data1=value
;;   tag=1: VAR,  data1=var_id
;;   tag=2: PAIR, data1=first_term_ptr, data2=second_term_ptr
;;   tag=3: NIL
;;
;; Substitution (UState) = alist: 0 (empty) or
;;   { int64_t var_id; int64_t term_ptr; int64_t next }
;;
;; Goal = fat closure: UState -> list UState
;;   (UState stored as int64_t substitution pointer)
;;
;; Result list = Cell list { int64_t value; int64_t next }
;;   (backtrack monad, inlined from backtrack.tur)
;;
;; Calling conventions:
;;   • Goal constructors return :ptr<void>  (fat closure pointer)
;;   • Functions accepting goals take :int  (int64_t of pointer)
;;   • Parameters used in inner lambdas MUST be bound to locals first
;;; -- Backtracking monad (inlined) ─────────────────────────────────────────────
;;; mzero -- the empty result list (no solutions).
;;;
;;; Returns:
;;;   0 (null pointer, empty solution list).
(defn mzero [] :int ```c return 0; ```)
;;; mreturn -- wrap a single substitution as a successful result.
;;;
;;; Parameters:
;;;   x -- substitution pointer (:int)
;;;
;;; Returns:
;;;   A singleton solution list (:int).

(defn mreturn [x] :int
  ```c struct { int64_t value; int64_t next; } *cell = malloc(sizeof(*cell));
  cell->value = x; cell->next = 0;
  return (int64_t)(intptr_t)cell;
  ```)
;;; mplus -- concatenate two solution lists.
;;;
;;; Parameters:
;;;   xs -- first solution list (:int)
;;;   ys -- second solution list (:int)
;;;
;;; Returns:
;;;   A new list with all solutions from xs followed by those from ys (:int).

(defn mplus [xs ys] :int
  ```c typedef struct { int64_t value; int64_t next; } Cell;
  Cell *xc = (Cell*)(intptr_t)xs;
  if (!xc) return ys;
  Cell *head = NULL, *tail = NULL;
  while (xc) {
      Cell *n = malloc(sizeof(Cell));
      n->value = xc->value; n->next = 0;
      if (tail) tail->next = (int64_t)(intptr_t)n; else head = n;
      tail = n; xc = (Cell*)(intptr_t)xc->next;
  }
  if (tail) tail->next = ys;
  return (int64_t)(intptr_t)head;
  ```)
;;; mbind -- apply a fat-closure continuation to each solution and concatenate.
;;;
;;; Parameters:
;;;   ma -- solution list (:int)
;;;   fn -- fat closure of type (UState -> list UState)
;;;
;;; Returns:
;;;   Concatenated solutions (:int).

(defn mbind [ma fn] :int
  ```c typedef struct { int64_t value; int64_t next; } Cell;
  Cell *cell = (Cell*)(intptr_t)ma;
  if (!cell) return 0;
  int64_t *fat = (int64_t*)(intptr_t)fn;
  int64_t thunk = fat[0];
  Cell *rev = NULL;
  while (cell) {
      int64_t sub = ((int64_t(*)(void*, int64_t))(intptr_t)thunk)((void*)fat, cell->value);
      Cell *sc = (Cell*)(intptr_t)sub;
      while (sc) {
          Cell *n = malloc(sizeof(Cell));
          n->value = sc->value; n->next = (int64_t)(intptr_t)rev; rev = n;
          sc = (Cell*)(intptr_t)sc->next;
      }
      cell = (Cell*)(intptr_t)cell->next;
  }
  Cell *result = NULL;
  while (rev) {
      Cell *tmp = (Cell*)(intptr_t)rev->next;
      rev->next = (int64_t)(intptr_t)result; result = rev; rev = tmp;
  }
  return (int64_t)(intptr_t)result;
  ```)
;;; bt-length -- count the number of solutions in a result list.
;;;
;;; Parameters:
;;;   xs -- solution list (:int)
;;;
;;; Returns:
;;;   Number of solutions (:int).

(defn bt-length [xs] :int
  ```c typedef struct { int64_t value; int64_t next; } Cell;
  int64_t n = 0; Cell *c = (Cell*)(intptr_t)xs;
  while (c) { n++; c = (Cell*)(intptr_t)c->next; }
  return n;
  ```)
;;; -- Term constructors ────────────────────────────────────────────────────────
;;; term-int -- construct a logic term representing an integer value.
;;;
;;; Parameters:
;;;   n -- integer value
;;;
;;; Returns:
;;;   Pointer to a term with tag=0, data1=n (:int).
;;;
;;; Example:
;;;   (term-int 42)  ; => tagged term pointer for integer 42


(defn term-int [n] :int
  ```c struct { int64_t tag; int64_t data1; int64_t data2; } *t = malloc(sizeof(*t));
  t->tag = 0; t->data1 = n; t->data2 = 0;
  return (int64_t)(intptr_t)t;
  ```)
;;; term-var -- construct a logic variable term with the given id.
;;;
;;; Parameters:
;;;   id -- unique variable identifier (:int)
;;;
;;; Returns:
;;;   Pointer to a term with tag=1, data1=id (:int).
;;;
;;; Example:
;;;   (term-var (lvar-next))  ; => fresh logic variable

(defn term-var [id] :int
  ```c struct { int64_t tag; int64_t data1; int64_t data2; } *t = malloc(sizeof(*t));
  t->tag = 1; t->data1 = id; t->data2 = 0;
  return (int64_t)(intptr_t)t;
  ```)
;;; term-pair -- construct a logic pair term from two sub-terms.
;;;
;;; Parameters:
;;;   a -- first sub-term pointer (:int)
;;;   b -- second sub-term pointer (:int)
;;;
;;; Returns:
;;;   Pointer to a term with tag=2, data1=a, data2=b (:int).
;;;
;;; Example:
;;;   (term-pair (term-int 1) (term-int 2))  ; => pair term (1 . 2)

(defn term-pair [a b] :int
  ```c struct { int64_t tag; int64_t data1; int64_t data2; } *t = malloc(sizeof(*t));
  t->tag = 2; t->data1 = a; t->data2 = b;
  return (int64_t)(intptr_t)t;
  ```)
;;; term-nil -- construct the nil/empty logic term.
;;;
;;; Returns:
;;;   Pointer to a term with tag=3 (:int).
;;;
;;; Example:
;;;   (term-nil)  ; => nil term

(defn term-nil [] :int
  ```c struct { int64_t tag; int64_t data1; int64_t data2; } *t = malloc(sizeof(*t));
  t->tag = 3; t->data1 = 0; t->data2 = 0;
  return (int64_t)(intptr_t)t;
  ```)
;;; -- Term accessors ───────────────────────────────────────────────────────────
;;; term-tag -- read the tag field of a logic term.
;;;
;;; Parameters:
;;;   t -- term pointer (:int)
;;;
;;; Returns:
;;;   0=INT, 1=VAR, 2=PAIR, 3=NIL (:int).


(defn term-tag [t] :int
  ```c return ((struct { int64_t tag; int64_t data1; int64_t data2; } *)(intptr_t)t)->tag; ```)
;;; term-int-val -- read the integer value from an INT term.
;;;
;;; Parameters:
;;;   t -- term pointer with tag=0 (:int)
;;;
;;; Returns:
;;;   The integer value stored in data1 (:int).

(defn term-int-val [t] :int
  ```c return ((struct { int64_t tag; int64_t data1; int64_t data2; } *)(intptr_t)t)->data1; ```)
;;; term-var-id -- read the variable id from a VAR term.
;;;
;;; Parameters:
;;;   t -- term pointer with tag=1 (:int)
;;;
;;; Returns:
;;;   The variable id stored in data1 (:int).

(defn term-var-id [t] :int
  ```c return ((struct { int64_t tag; int64_t data1; int64_t data2; } *)(intptr_t)t)->data1; ```)
;;; term-pair-fst -- read the first sub-term pointer from a PAIR term.
;;;
;;; Parameters:
;;;   t -- term pointer with tag=2 (:int)
;;;
;;; Returns:
;;;   data1 (first sub-term pointer) (:int).

(defn term-pair-fst [t] :int
  ```c return ((struct { int64_t tag; int64_t data1; int64_t data2; } *)(intptr_t)t)->data1; ```)
;;; term-pair-snd -- read the second sub-term pointer from a PAIR term.
;;;
;;; Parameters:
;;;   t -- term pointer with tag=2 (:int)
;;;
;;; Returns:
;;;   data2 (second sub-term pointer) (:int).

(defn term-pair-snd [t] :int
  ```c return ((struct { int64_t tag; int64_t data1; int64_t data2; } *)(intptr_t)t)->data2; ```)
;;; -- Fresh variable counter ───────────────────────────────────────────────────
;;; lvar-next -- allocate the next unique logic variable identifier.
;;;
;;; Returns:
;;;   A fresh monotonically increasing integer id (:int).
;;;
;;; Example:
;;;   (term-var (lvar-next))  ; => a unique logic variable


(defn lvar-next [] :int ```c static int64_t n = 0; return n++; ```)
;;; -- Substitution operations ──────────────────────────────────────────────────
;;; subs-empty -- return the empty substitution (no variable bindings).
;;;
;;; Returns:
;;;   0 (null pointer representing an empty alist) (:int).


(defn subs-empty [] :int ```c return 0; ```)
;;; logic-walk -- follow variable bindings in a substitution until ground.
;;;
;;; Parameters:
;;;   t    -- term pointer to walk (:int)
;;;   subs -- substitution alist pointer (:int)
;;;
;;; Returns:
;;;   The fully walked term pointer (ground or unbound variable) (:int).
;;;
;;; Example:
;;;   (logic-walk (term-var 0) subs)  ; => bound term or the variable itself
;; Walk: follow variable bindings in substitution (iterative)

(defn logic-walk [t subs] :int
  ```c typedef struct { int64_t tag; int64_t data1; int64_t data2; } Term;
  typedef struct { int64_t var_id; int64_t term_ptr; int64_t next; } SubsE;
  int64_t cur = t;
  for (;;) {
      Term *ct = (Term*)(intptr_t)cur;
      if (ct->tag != 1) return cur;
      int64_t vid = ct->data1;
      SubsE *s = (SubsE*)(intptr_t)subs;
      int64_t found = 0;
      while (s) { if (s->var_id == vid) { found = s->term_ptr; break; } s = (SubsE*)(intptr_t)s->next; }
      if (!found) return cur;
      cur = found;
  }
  ```)
;;; logic-unify -- structurally unify two terms, extending the substitution.
;;;
;;; No occurs check is performed.  Returns -1 on failure.
;;;
;;; Parameters:
;;;   t1   -- first term pointer (:int)
;;;   t2   -- second term pointer (:int)
;;;   subs -- current substitution alist (:int)
;;;
;;; Returns:
;;;   Extended substitution on success, or -1 on unification failure (:int).
;;;
;;; Example:
;;;   (logic-unify (term-var 0) (term-int 5) (subs-empty))  ; => subs with x0=5
;; Unify: structural unification (no occurs check); returns new subs or -1
;; Calls logic_walk (forward-declared by Turmeric codegen) and itself recursively.

(defn logic-unify [t1 t2 subs] :int
  ```c typedef struct { int64_t tag; int64_t data1; int64_t data2; } Term;
  typedef struct { int64_t var_id; int64_t term_ptr; int64_t next; } SubsE;
  int64_t wt1 = logic_walk(t1, subs);
  int64_t wt2 = logic_walk(t2, subs);
  Term *ct1 = (Term*)(intptr_t)wt1;
  Term *ct2 = (Term*)(intptr_t)wt2;
  if (ct1->tag == 1 && ct2->tag == 1 && ct1->data1 == ct2->data1) return subs;
  if (ct1->tag == 0 && ct2->tag == 0 && ct1->data1 == ct2->data1) return subs;
  if (ct1->tag == 3 && ct2->tag == 3) return subs;
  if (ct1->tag == 1) {
      SubsE *e = malloc(sizeof(SubsE)); e->var_id = ct1->data1; e->term_ptr = wt2; e->next = subs;
      return (int64_t)(intptr_t)e;
  }
  if (ct2->tag == 1) {
      SubsE *e = malloc(sizeof(SubsE)); e->var_id = ct2->data1; e->term_ptr = wt1; e->next = subs;
      return (int64_t)(intptr_t)e;
  }
  if (ct1->tag == 2 && ct2->tag == 2) {
      int64_t s2 = logic_unify(ct1->data1, ct2->data1, subs);
      if (s2 == -1) return -1;
      return logic_unify(ct1->data2, ct2->data2, s2);
  }
  return -1;
  ```)
;;; -- Fat-closure application ──────────────────────────────────────────────────
;;; apply-fat -- call any fat closure with a single int64_t argument.
;;;
;;; Parameters:
;;;   f   -- fat closure pointer (:int)
;;;   arg -- argument to pass (:int)
;;;
;;; Returns:
;;;   Return value of the closure (:int).
;; apply-fat: call any fat closure with one int64_t arg; returns int64_t


(defn apply-fat [f arg] :int
  ```c int64_t *fat = (int64_t*)(intptr_t)f;
  return ((int64_t(*)(void*, int64_t))(intptr_t)fat[0])((void*)fat, arg);
  ```)
;;; apply-goal -- call a goal fat closure with a substitution (UState).
;;;
;;; Parameters:
;;;   g     -- goal fat closure pointer (:int)
;;;   state -- current substitution (:int)
;;;
;;; Returns:
;;;   Solution list (list of substitutions) (:int).
;; apply-goal: call a goal fat closure with a UState

(defn apply-goal [g state] :int
  ```c int64_t *fat = (int64_t*)(intptr_t)g;
  return ((int64_t(*)(void*, int64_t))(intptr_t)fat[0])((void*)fat, state);
  ```)
;;; -- Goal constructors ────────────────────────────────────────────────────────
;;; unify-goal-impl -- implementation helper: unify two terms against a state.


(defn unify-goal-impl [lt1 lt2 state] :int
  (let [ns (logic-unify lt1 lt2 state)] (if (= ns -1) (mzero) (mreturn ns))))
;;; lequal -- goal that unifies two terms (miniKanren ==).
;;;
;;; Parameters:
;;;   t1 -- first term pointer (:int)
;;;   t2 -- second term pointer (:int)
;;;
;;; Returns:
;;;   A goal (:ptr<void>) that succeeds iff t1 and t2 unify.
;;;
;;; Example:
;;;   (run-logic 1 (lequal (term-int 5) (term-int 5)))  ; => one solution
;; lequal (miniKanren ==): goal that unifies two terms

(defn lequal [t1 t2] :ptr<void>
  (let [lt1 t1 lt2 t2]
    (fn [state] (let [_ lt1] (unify-goal-impl lt1 lt2 state)))))
;;; succeed-impl -- implementation helper for the succeed goal.

(defn succeed-impl [dummy state] :int (mreturn state))
;;; succeed -- goal that always succeeds without changing the substitution.
;;;
;;; Returns:
;;;   A goal (:ptr<void>) that adds the current state unchanged to the solutions.
;;;
;;; Example:
;;;   (run-logic 1 (succeed))  ; => one solution (empty substitution)
;; succeed: always succeeds without changing state

(defn succeed [] :ptr<void>
  (let [dummy 0] (fn [state] (let [_ dummy] (succeed-impl dummy state)))))
;;; fail-impl -- implementation helper for the fail goal.

(defn fail-impl [dummy state] :int (mzero))
;;; fail -- goal that always fails, producing no solutions.
;;;
;;; Returns:
;;;   A goal (:ptr<void>) that produces an empty solution list.
;;;
;;; Example:
;;;   (run-logic 1 (fail))  ; => empty list
;; fail: always fails

(defn fail [] :ptr<void>
  (let [dummy 0] (fn [state] (let [_ dummy] (fail-impl dummy state)))))
;;; conjoined-inner -- helper to apply the second goal in a conjunction.

(defn conjoined-inner [lg22 s] :int (let [lg2 lg22] (apply-goal lg2 s)))
;;; conjoined-impl -- implementation helper for conjunction.

(defn conjoined-impl [lg1 lg2 state] :int
  (let [lg22 lg2]
    (mbind (apply-goal lg1 state)
      (fn [s] (let [_ lg22] (conjoined-inner lg22 s))))))
;;; conjoined -- goal that applies g1 then g2 to each result (conjunction).
;;;
;;; Parameters:
;;;   g1 -- first goal (:ptr<void>)
;;;   g2 -- second goal (:ptr<void>)
;;;
;;; Returns:
;;;   A goal that succeeds only when both g1 and g2 succeed (:ptr<void>).
;;;
;;; Example:
;;;   (run-logic 1 (conjoined (lequal x (term-int 1)) (succeed)))  ; => [x=1]
;; conjoined (conjunction): apply g1, then apply g2 to each result

(defn conjoined [g1 g2] :ptr<void>
  (let [lg1 g1 lg2 g2]
    (fn [state] (let [_ lg1] (conjoined-impl lg1 lg2 state)))))
;;; disjoined-impl -- implementation helper for disjunction.

(defn disjoined-impl [lg1 lg2 state] :int
  (mplus (apply-goal lg1 state) (apply-goal lg2 state)))
;;; disjoined -- goal that combines results from g1 and g2 (disjunction).
;;;
;;; Parameters:
;;;   g1 -- first goal (:ptr<void>)
;;;   g2 -- second goal (:ptr<void>)
;;;
;;; Returns:
;;;   A goal whose solutions are the interleaved results of g1 and g2 (:ptr<void>).
;;;
;;; Example:
;;;   (run-logic 2 (disjoined (lequal x (term-int 1)) (lequal x (term-int 2))))
;;;   ; => [x=1, x=2]
;; disjoined (disjunction): results from g1 interleaved with results from g2

(defn disjoined [g1 g2] :ptr<void>
  (let [lg1 g1 lg2 g2]
    (fn [state] (let [_ lg1] (disjoined-impl lg1 lg2 state)))))
;;; fresh-impl -- implementation helper for fresh variable introduction.

(defn fresh-impl [lf state] :int
  (let [nv (term-var (lvar-next)) lf2 lf] (apply-goal (apply-fat lf2 nv) state)))
;;; fresh -- create a new logic variable and pass it to a goal-building function.
;;;
;;; Parameters:
;;;   f -- fat closure of type (term -> goal)
;;;
;;; Returns:
;;;   A goal (:ptr<void>) that introduces a fresh variable and runs (f var).
;;;
;;; Example:
;;;   (run-logic 1 (fresh (fn [x] (lequal x (term-int 7)))))  ; => [x=7]
;; fresh: create a new logic variable, pass it to f (term -> goal)

(defn fresh [f] :ptr<void>
  (let [lf f] (fn [state] (let [_ lf] (fresh-impl lf state)))))
;;; -- Runner ───────────────────────────────────────────────────────────────────
;;; take-n -- return the first n elements of a solution list.
;;;
;;; Parameters:
;;;   n   -- maximum number of solutions (:int)
;;;   lst -- solution list (:int)
;;;
;;; Returns:
;;;   A truncated solution list of length at most n (:int).
;; take-n: return the first n elements of a Cell list


(defn take-n [n lst] :int
  ```c typedef struct { int64_t value; int64_t next; } Cell;
  Cell *result = NULL, *tail = NULL;
  Cell *c = (Cell*)(intptr_t)lst;
  int64_t count = 0;
  while (c && count < n) {
      Cell *nc = malloc(sizeof(Cell));
      nc->value = c->value; nc->next = 0;
      if (tail) tail->next = (int64_t)(intptr_t)nc; else result = nc;
      tail = nc;
      c = (Cell*)(intptr_t)c->next;
      count++;
  }
  return (int64_t)(intptr_t)result;
  ```)
;;; run-logic -- run a goal with an empty substitution and return up to n results.
;;;
;;; Parameters:
;;;   n -- maximum number of solutions (:int)
;;;   g -- goal to run (:ptr<void>)
;;;
;;; Returns:
;;;   A list of at most n substitutions (solution list) (:int).
;;;
;;; Example:
;;;   (run-logic 1 (fresh (fn [x] (lequal x (term-int 3)))))  ; => one solution
;; run-logic: run goal with empty substitution, return up to n results

(defn run-logic [n g] :int
  (let [init (subs-empty)] (take-n n (apply-goal g init))))
;;; -- Result helpers ───────────────────────────────────────────────────────────
;;; first-state -- extract the first substitution from a run-logic result list.
;;;
;;; Parameters:
;;;   results -- solution list from run-logic (:int)
;;;
;;; Returns:
;;;   The first substitution pointer, or 0 if the list is empty (:int).
;; first-state: extract the first substitution from a run-logic result list


(defn first-state [results] :int
  ```c typedef struct { int64_t value; int64_t next; } Cell;
  Cell *c = (Cell*)(intptr_t)results;
  return c ? c->value : 0;
  ```)
;;; reify-walk -- walk a term through the first result's substitution.
;;;
;;; Parameters:
;;;   t       -- term pointer to reify (:int)
;;;   results -- solution list from run-logic (:int)
;;;
;;; Returns:
;;;   The walked term pointer (ground or unbound variable) (:int).
;;;
;;; Example:
;;;   (reify-walk my-var (run-logic 1 my-goal))  ; => ground term or variable
;; reify-walk: walk a term through the first result's substitution
;; Returns the walked term (still as int64_t term pointer)

(defn reify-walk [t results] :int
  (let [subs (first-state results)] (logic-walk t subs)))
