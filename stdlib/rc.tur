;;; tur/rc -- reference-counted pointer (rc<T>) for shared ownership.
;;;
;;; rc<T> is an owning handle; rc-clone increments the count, rc-drop decrements.
;;;
;;; Since: Phase 9
;; stdlib/rc.tur -- Reference-counted pointer (Phase 9)
;; rc<T> is a reference-counted owning pointer.
;;
;; In v1, rc operations are built-in primitives:
;;   (rc/of x)    - create new rc with value x
;;   (rc/clone r) - increment refcount, return new rc
;;   (rc/drop r)  - decrement refcount, free if zero
;;   (rc->ptr r)  - get raw pointer (non-owning)
;;
;; HKT instances use ptr<void> as the container type since v1 doesn't have
;; generic type constructors yet.
;;; SINCE: Phase HKT H3
;; Functor instance for rc<T>
;; Functor for rc - map a function over the contained value, returning a new rc
;; fmap :: (a -> b) -> rc a -> rc b
;; Implementation: clone the rc, unwrap to get the value, apply fn, wrap in new rc
;;; __functor_rc_fmap -- internal Functor fmap implementation for rc<T>.
;;;
;;; Since: Phase HKT H3
(defn __functor_rc_fmap [container fn] : int
  ```c /* In v1, rc<T> is represented as RcControlBlock* (see src/rc.c)
   * We can't easily implement fmap without modifying the RcControlBlock
   * to store the actual value. For v1, we return a cloned rc with the
   * function applied to the value. This requires rc->ptr access.
   *
   * Note: This is a simplified v1 implementation. A proper implementation
   * would need to handle the case where the value is not a plain int64_t.
   */
  void *rc_ptr = (void*)(intptr_t)container;
  if (!rc_ptr) return 0;
  /* Clone the rc to get an owned pointer */
  void *cloned = tur_rc_clone(rc_ptr);
  if (!cloned) return 0;
  /* Get the raw pointer value */
  int64_t value = *(int64_t*)tur_rc_ptr(cloned);
  /* Apply the function */
  int64_t new_value = ((int64_t(*)(int64_t))(intptr_t)fn)(value);
  /* Create a new rc with the new value */
  void *new_rc = tur_rc_of((void*)(intptr_t)new_value);
  /* Drop the clone */
  tur_rc_drop(cloned);
  return (int64_t)(intptr_t)new_rc;
  ```)
;; Functor instance for rc
;; KB-027: dispatch on the built-in rc<T> type constructor (kind * -> *), not
;; on ptr<void> (kind *).  rc is rc.tur's home type, so the instance is not an
;; orphan even though Functor is declared elsewhere.
;;; Functor [rc] -- Functor instance for rc<T>.
;;;
;;; Since: Phase HKT H3
;;; Phase CCL: fn is tur_poly_fn_t; call via fn.fn(fn.env, arg).

(definstance Functor [rc]
  (fmap [container fn] ```c void *rc_ptr = (void *)(intptr_t)container;
    void *cloned = tur_rc_clone(rc_ptr);
    if (!cloned) return 0;
    int64_t value = *(int64_t*)tur_rc_ptr(cloned);
    int64_t new_value = fn.fn(fn.env, value);
    void *new_rc = tur_rc_of((void*)(intptr_t)new_value);
    tur_rc_drop(cloned);
    return (int64_t)(intptr_t)new_rc;
    ```))
;;; SINCE: Phase HKT §6
;; Foldable class stub.  Unlike Functor/Clone (auto-loaded via
;; typeclass-functor.tur / typeclass-clone.tur), Foldable is not auto-loaded,
;; so rc.tur declares it locally to keep the module self-contained and
;; standalone-checkable.  The signature matches stdlib/typeclass.tur exactly,
;; so the idempotent-redefinition rule accepts both when typeclass.tur is also
;; loaded.  Declaring Foldable here also makes rc its owning module for the
;; instance below.
;;; Foldable -- reduce a container to a summary value.
;;;
;;; Since: Phase HKT S6

(defclass Foldable [^t] (foldl [ta init fn] : int) (foldr [ta init fn] : int))
;; Foldable instance for rc<T>.
;; An rc contains exactly one value, so:
;;   foldl init fn (rc v) = fn(init, v)
;;   foldr fn init (rc v) = fn(v, init)
;; KB-027: the bodies dispatch on rc<T> directly (inline C, mirroring the
;; Functor instance) instead of round-tripping through a ptr<void> helper.
;;; Foldable [rc] -- Foldable instance for rc<T>.
;;;
;;; Since: Phase HKT S6

(definstance Foldable [rc]
  (foldl [ta init fn] ```c /* In v1, rc<T> is an RcControlBlock*.  tur_rc_ptr returns the
     * pointer to the stored value (an int64_t in v1). */
    void *rc_ptr = (void *)(intptr_t)ta;
    if (!rc_ptr) return init;
    int64_t value = *(int64_t *)tur_rc_ptr(rc_ptr);
    return ((int64_t(*)(int64_t, int64_t))(intptr_t)fn)(init, value);
    ```)
  (foldr [ta init fn] ```c void *rc_ptr = (void *)(intptr_t)ta;
    if (!rc_ptr) return init;
    int64_t value = *(int64_t *)tur_rc_ptr(rc_ptr);
    return ((int64_t(*)(int64_t, int64_t))(intptr_t)fn)(value, init);
    ```))
;;; SINCE: Phase B1
;; Clone instance for the built-in rc type (TY_RC) -- shallow clone.
;;
;; (definstance Clone [rc] ...) registers against TY_RC so that captured
;; rc bindings at cloneable-shift sites satisfy the Clone constraint.
;; The clone method calls rc_strong_increment and returns the same pointer
;; cast to int64_t; the result has int64_t type at the Turmeric level.
;;; Clone [rc] -- shallow-clone a TY_RC value by incrementing the strong refcount.
;;;
;;; Since: Phase B1
;; Cloning an rc<T> does NOT copy the contained value.  It increments the
;; reference count and returns a second owning handle to the SAME allocation,
;; mirroring Rust's Rc::clone semantics.  KB-027: the earlier ptr<void> mirror
;; of this instance has been removed -- rc dispatches on its own TY_RC home
;; type, which is kind-correct and non-orphan.

(definstance Clone [rc]
  (clone [x] : int ```c /* x is RcControlBlock *; increment refcount, return same pointer. */
    rc_strong_increment(x);
    return (int64_t)(intptr_t)x;
    ```))
