;;; tur/rc -- reference-counted pointer (rc<T>) for shared ownership.
;;;
;;; rc<T> is an owning handle; rc-clone increments the count, rc-drop decrements.
;;;
;;; Since: Phase 9
;; stdlib/rc.tur -- Reference-counted pointer (Phase 9)
;; rc<T> is a reference-counted owning pointer.
;;
;; In v1, rc operations are built-in primitives:
;;   (rc/of x)    - create new rc with value x
;;   (rc/clone r) - increment refcount, return new rc
;;   (rc/drop r)  - decrement refcount, free if zero
;;   (rc->ptr r)  - get raw pointer (non-owning)
;;
;; Functor instance for rc
;; KB-027: dispatch on the built-in rc<T> type constructor (kind * -> *), not
;; on ptr<void> (kind *).  rc is rc.tur's home type, so the instance is not an
;; orphan even though Functor is declared elsewhere.
;;
;; A standalone `__functor_rc_fmap [container fn] : int` helper used to sit here,
;; predating the instance.  It is gone: nothing referenced it, and its untyped
;; params meant `container` was `:int`, so it could not be passed an actual
;; rc<T> at all ("expected int, got rc<int>") -- the CLAUDE.md :int-stand-in
;; defect in its purest form.  The definstance below is the implementation.
;;; Functor [rc] -- Functor instance for rc<T>.
;;;
;;; Since: Phase HKT H3
;;; Phase CCL: fn is tur_poly_fn_t; call via fn.fn(fn.env, arg).
(definstance Functor [rc]
  (fmap [container fn]
    ```c
    /* rc<T> is an RcControlBlock * whose `value` points at the stored payload
     * (an int64_t carrier in v1).  Read it, apply fn, and box the result in a
     * fresh rc -- the same shape `rc/of` emits: rc_cb_alloc with a TY_INT (3)
     * value type plus a separately malloc'd slot, which the block's default
     * drop_fn frees.
     *
     * There is deliberately no clone/drop pair around the read.  The earlier
     * version cloned the block only to read one field and dropped it again --
     * a no-op with two refcount writes.  `container` is borrowed for the
     * duration of the call, so its block cannot go away underneath us.
     *
     * Note: v1 assumes the payload is a plain int64_t carrier. */
    RcControlBlock *cb = (RcControlBlock *)(intptr_t)container;
    if (!cb || !cb->value) return 0;
    int64_t value = *(int64_t *)rc_get_value(cb);
    int64_t new_value = fn.fn(fn.env, value);
    int64_t *slot = (int64_t *)malloc(sizeof(int64_t));
    if (!slot) return 0;
    *slot = new_value;
    RcControlBlock *out = rc_cb_alloc(0, 3 /* TY_INT */, NULL);
    out->value = slot;
    return (int64_t)(intptr_t)out;
    ```))
;;; SINCE: Phase HKT §6
;; Foldable class stub.  Unlike Functor/Clone (auto-loaded via
;; typeclass-functor.tur / typeclass-clone.tur), Foldable is not auto-loaded,
;; so rc.tur declares it locally to keep the module self-contained and
;; standalone-checkable.  The signature matches stdlib/typeclass.tur exactly,
;; so the idempotent-redefinition rule accepts both when typeclass.tur is also
;; loaded.  Declaring Foldable here also makes rc its owning module for the
;; instance below.
;;; Foldable -- reduce a container to a summary value.
;;;
;;; Since: Phase HKT S6

(defclass Foldable [^t]
  (foldl [ta : (t a) init : b fn : (fn [b a] b)] : b)
  (foldr [ta : (t a) init : b fn : (fn [a b] b)] : b))
;; Foldable instance for rc<T>.
;; An rc contains exactly one value, so:
;;   foldl init fn (rc v) = fn(init, v)
;;   foldr fn init (rc v) = fn(v, init)
;; KB-027: the bodies dispatch on rc<T> directly (inline C, mirroring the
;; Functor instance) instead of round-tripping through a ptr<void> helper.
;; rc<T> value extraction goes through rc_get_value, which has no
;; pure-Turmeric accessor -- so these bodies are carrier-essential.
;;
;; The earlier M7 note here claimed `fn` "lowers to a raw fn pointer for these
;; element types, so the casts remain valid ... verified: suite byte-identical."
;; That was wrong on both counts.  Under the TYPED Foldable signature above,
;; `fn : (fn [b a] b)` lowers to a tur_poly_fn_t STRUCT, so
;; `(int64_t(*)(int64_t,int64_t))(intptr_t)fn` is "aggregate value used where an
;; integer was expected" -- rc.tur did not compile at all.  And the suite could
;; not have verified anything, because no fixture loaded this module; the C
;; stage was never reached.  tests/fixtures/rc-tur-typeclass-instances is that
;; missing fixture.  See docs/archive/rc-tur-legacy-instances-do-not-compile.md.
;;
;; The 2-arg calling convention below is exactly what the compiler emits for a
;; typed 2-arg fn parameter (see emit_cps_ir.c): cast the `fn` slot to a
;; signature that takes `env` first, then the arguments.  It is NOT curried.
;;; Foldable [rc] -- Foldable instance for rc<T>.
;;;
;;; Since: Phase HKT S6

(definstance Foldable [rc]
  (foldl [ta init fn]
    ```c
    /* rc<T> is an RcControlBlock * whose `value` points at the stored payload
     * (an int64_t carrier in v1). */
    RcControlBlock *cb = (RcControlBlock *)(intptr_t)ta;
    if (!cb || !cb->value) return init;
    int64_t value = *(int64_t *)rc_get_value(cb);
    return ((int64_t (*)(void *, int64_t, int64_t))fn.fn)(fn.env, init, value);
    ```)
  (foldr [ta init fn]
    ```c
    RcControlBlock *cb = (RcControlBlock *)(intptr_t)ta;
    if (!cb || !cb->value) return init;
    int64_t value = *(int64_t *)rc_get_value(cb);
    return ((int64_t (*)(void *, int64_t, int64_t))fn.fn)(fn.env, value, init);
    ```))
;;; SINCE: Phase B1
;; Clone instance for the built-in rc type (TY_RC) -- shallow clone.
;;
;; (definstance Clone [rc] ...) registers against TY_RC so that captured
;; rc bindings at cloneable-shift sites satisfy the Clone constraint.
;; The clone method calls rc_strong_increment and returns the same pointer
;; cast to int64_t; the result has int64_t type at the Turmeric level.
;;; Clone [rc] -- shallow-clone a TY_RC value by incrementing the strong refcount.
;;;
;;; Since: Phase B1
;; Cloning an rc<T> does NOT copy the contained value.  It increments the
;; reference count and returns a second owning handle to the SAME allocation,
;; mirroring Rust's Rc::clone semantics.  KB-027: the earlier ptr<void> mirror
;; of this instance has been removed -- rc dispatches on its own TY_RC home
;; type, which is kind-correct and non-orphan.

(definstance Clone [rc]
  (clone [x]
    : int
    ```c
    /* x is RcControlBlock *; increment refcount, return same pointer. */
    rc_strong_increment(x);
    return (int64_t)(intptr_t)x;
    ```))
