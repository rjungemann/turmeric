;; Phase 16: Test capability implementations
;; 
;; Mock implementations for testing - these allow tests to verify behavior
;; without touching the filesystem, network, etc.
(extern-c malloc [^ptr size] :ptr)

(extern-c free [^ptr p] :void)

(extern-c strcmp [^cstr ^cstr] :int)

(extern-c strcpy [^cstr ^cstr] :cstr)

(extern-c strlen [^cstr] :int)
;; ============================================================================
;; Test-FileSystem implementation
;; In-memory filesystem for testing
;; ============================================================================
;; Opaque type for in-memory file


(defn InMemoryFile-type []
  ```c typedef struct InMemoryFile InMemoryFile;
  struct InMemoryFile {
      char* name;
      unsigned char* data;
      int data_len;
      InMemoryFile* next;
  };
  return NULL;
  ```)
;; Opaque type for in-memory filesystem

(defn InMemoryFS-type []
  ```c typedef struct InMemoryFS InMemoryFS;
  struct InMemoryFS {
      InMemoryFile* files;
      char** last_listing;
      int last_listing_count;
  };
  return NULL;
  ```)
;; Test-FileSystem implementation

(defn Test-FileSystem []
  ```c /* Define the FileSystem struct */
  typedef struct FileSystem FileSystem;
  struct FileSystem {
      int (*read_file)(const char* path, unsigned char* buf, int buf_len, int* out_len);
      int (*write_file)(const char* path, const unsigned char* data, int data_len);
      int (*delete)(const char* path);
      int (*list)(const char* path, char** entries, int max_entries, int* out_count);
  };
  
  typedef struct InMemoryFile InMemoryFile;
  struct InMemoryFile {
      char* name;
      unsigned char* data;
      int data_len;
      InMemoryFile* next;
  };
  
  typedef struct InMemoryFS InMemoryFS;
  struct InMemoryFS {
      InMemoryFile* files;
  };
  
  /* Global in-memory filesystem state */
  static InMemoryFS global_fs = {0};
  
  /* Helper to find a file by name */
  static InMemoryFile* find_file(const char* name) {
      InMemoryFile* f = global_fs.files;
      while (f) {
          if (strcmp(f->name, name) == 0) {
              return f;
          }
          f = f->next;
      }
      return NULL;
  }
  
  /* read_file implementation */
  static int testfs_read_file(const char* path, unsigned char* buf, int buf_len, int* out_len) {
      InMemoryFile* f = find_file(path);
      if (!f) return -1; /* File not found */
      
      int copy_len = (f->data_len < buf_len) ? f->data_len : buf_len;
      if (copy_len > 0) {
          memcpy(buf, f->data, copy_len);
      }
      *out_len = copy_len;
      return 0;
  }
  
  /* write_file implementation */
  static int testfs_write_file(const char* path, const unsigned char* data, int data_len) {
      /* Check if file exists and delete it first */
      InMemoryFile* prev = NULL;
      InMemoryFile* f = global_fs.files;
      while (f) {
          if (strcmp(f->name, path) == 0) {
              /* Remove existing file */
              if (prev) {
                  prev->next = f->next;
              } else {
                  global_fs.files = f->next;
              }
              free(f->name);
              free(f->data);
              free(f);
              break;
          }
          prev = f;
          f = f->next;
      }
      
      /* Create new file */
      InMemoryFile* new_file = (InMemoryFile*)malloc(sizeof(InMemoryFile));
      new_file->name = strdup(path);
      new_file->data = (unsigned char*)malloc(data_len);
      memcpy(new_file->data, data, data_len);
      new_file->data_len = data_len;
      new_file->next = global_fs.files;
      global_fs.files = new_file;
      return 0;
  }
  
  /* delete implementation */
  static int testfs_delete(const char* path) {
      InMemoryFile* prev = NULL;
      InMemoryFile* f = global_fs.files;
      while (f) {
          if (strcmp(f->name, path) == 0) {
              if (prev) {
                  prev->next = f->next;
              } else {
                  global_fs.files = f->next;
              }
              free(f->name);
              free(f->data);
              free(f);
              return 0;
          }
          prev = f;
          f = f->next;
      }
      return -1; /* File not found */
  }
  
  /* list implementation - simplified, just returns all file names */
  static int testfs_list(const char* path, char** entries, int max_entries, int* out_count) {
      /* For simplicity, ignore path and list all files */
      InMemoryFile* f = global_fs.files;
      int count = 0;
      
      /* Count files */
      while (f) {
          count++;
          f = f->next;
      }
      
      /* Return file names */
      f = global_fs.files;
      for (int i = 0; i < count && i < max_entries; i++) {
          if (entries) {
              entries[i] = strdup(f->name);
          }
          f = f->next;
      }
      
      *out_count = count;
      return 0;
  }
  
  /* Create and populate the capability struct */
  FileSystem* fs = (FileSystem*)malloc(sizeof(FileSystem));
  fs->read_file = testfs_read_file;
  fs->write_file = testfs_write_file;
  fs->delete = testfs_delete;
  fs->list = testfs_list;
  return (void*)fs;
  ```)
;; Free a Test-FileSystem

(defn Test-FileSystem-free [fs]
  ```c free(fs);
  ```)
;; Clear all files from the test filesystem

(defn testfs-clear []
  ```c typedef struct InMemoryFile InMemoryFile;
  InMemoryFile* f = global_fs.files;
  while (f) {
      InMemoryFile* next = f->next;
      free(f->name);
      free(f->data);
      free(f);
      f = next;
  }
  global_fs.files = NULL;
  ```)
;; Check if a file exists in the test filesystem

(defn testfs-exists? [path]
  ```c typedef struct InMemoryFile InMemoryFile;
  InMemoryFile* f = global_fs.files;
  while (f) {
      if (strcmp(f->name, path) == 0) {
          return 1;
      }
      f = f->next;
  }
  return 0;
  ```)
;; Get file contents from test filesystem

(defn testfs-get-contents [path]
  ```c typedef struct InMemoryFile InMemoryFile;
  InMemoryFile* f = global_fs.files;
  while (f) {
      if (strcmp(f->name, path) == 0) {
          /* Allocate buffer and copy data */
          unsigned char* buf = (unsigned char*)malloc(f->data_len + 1);
          memcpy(buf, f->data, f->data_len);
          buf[f->data_len] = '\0';
          return (void*)buf;
      }
      f = f->next;
  }
  return NULL;
  ```)
;; ============================================================================
;; Test-Logger implementation
;; Captures log messages for verification
;; ============================================================================
;; Opaque type for captured log messages


(defn CapturedLogs-type []
  ```c typedef struct CapturedLog CapturedLog;
  struct CapturedLog {
      char* level;
      char* message;
      CapturedLog* next;
  };
  return NULL;
  ```)
;; Opaque type for test logger state

(defn TestLoggerState-type []
  ```c typedef struct TestLoggerState TestLoggerState;
  struct TestLoggerState {
      CapturedLog* logs;
      CapturedLog* last;
  };
  return NULL;
  ```)
;; Test-Logger implementation

(defn Test-Logger []
  ```c /* Define the Logger struct */
  typedef struct Logger Logger;
  struct Logger {
      void (*debug)(const char* msg);
      void (*info)(const char* msg);
      void (*warn)(const char* msg);
      void (*error)(const char* msg);
  };
  
  typedef struct CapturedLog CapturedLog;
  struct CapturedLog {
      char* level;
      char* message;
      CapturedLog* next;
  };
  
  typedef struct TestLoggerState TestLoggerState;
  struct TestLoggerState {
      CapturedLog* logs;
      CapturedLog* last;
  };
  
  /* Global state for test logger */
  static TestLoggerState global_logger_state = {0};
  
  /* Helper to add a log entry */
  static void add_log(const char* level, const char* msg) {
      CapturedLog* log = (CapturedLog*)malloc(sizeof(CapturedLog));
      log->level = strdup(level);
      log->message = strdup(msg);
      log->next = NULL;
      
      if (!global_logger_state.last) {
          global_logger_state.logs = log;
          global_logger_state.last = log;
      } else {
          global_logger_state.last->next = log;
          global_logger_state.last = log;
      }
  }
  
  /* debug implementation */
  static void test_logger_debug(const char* msg) {
      add_log("DEBUG", msg);
  }
  
  /* info implementation */
  static void test_logger_info(const char* msg) {
      add_log("INFO", msg);
  }
  
  /* warn implementation */
  static void test_logger_warn(const char* msg) {
      add_log("WARN", msg);
  }
  
  /* error implementation */
  static void test_logger_error(const char* msg) {
      add_log("ERROR", msg);
  }
  
  /* Create and populate the capability struct */
  Logger* logger = (Logger*)malloc(sizeof(Logger));
  logger->debug = test_logger_debug;
  logger->info = test_logger_info;
  logger->warn = test_logger_warn;
  logger->error = test_logger_error;
  return (void*)logger;
  ```)
;; Free a Test-Logger

(defn Test-Logger-free [log]
  ```c free(log);
  ```)
;; Clear all captured logs

(defn testlog-clear []
  ```c typedef struct CapturedLog CapturedLog;
  CapturedLog* log = global_logger_state.logs;
  while (log) {
      CapturedLog* next = log->next;
      free(log->level);
      free(log->message);
      free(log);
      log = next;
  }
  global_logger_state.logs = NULL;
  global_logger_state.last = NULL;
  ```)
;; Get the number of captured logs

(defn testlog-count []
  ```c typedef struct CapturedLog CapturedLog;
  CapturedLog* log = global_logger_state.logs;
  int count = 0;
  while (log) {
      count++;
      log = log->next;
  }
  return count;
  ```)
;; Check if a log message was captured (by level and message)

(defn testlog-has? [level msg]
  ```c typedef struct CapturedLog CapturedLog;
  CapturedLog* log = global_logger_state.logs;
  while (log) {
      if (strcmp(log->level, level) == 0 && strcmp(log->message, msg) == 0) {
          return 1;
      }
      log = log->next;
  }
  return 0;
  ```)
;; ============================================================================
;; Test-Random implementation
;; Deterministic RNG with fixed seed
;; ============================================================================
;; Test-Random implementation - deterministic for testing


(defn Test-Random []
  ```c /* Define the Random struct */
  typedef struct Random Random;
  struct Random {
      int (*next_int)(int min, int max);
      int (*next_float)(void);
  };
  
  /* Fixed seed for determinism */
  static int test_seed = 42;
  static int test_state = 42;
  
  /* Simple LCG (Linear Congruential Generator) */
  static int lcg_next(void) {
      test_state = (test_state * 1103515245 + 12345) & 0x7fffffff;
      return test_state;
  }
  
  /* next_int implementation - deterministic */
  static int test_next_int(int min, int max) {
      int value = lcg_next() % (max - min + 1);
      return min + value;
  }
  
  /* next_float implementation - deterministic */
  static int test_next_float(void) {
      return lcg_next() % 10000;
  }
  
  /* Create and populate the capability struct */
  Random* rng = (Random*)malloc(sizeof(Random));
  rng->next_int = test_next_int;
  rng->next_float = test_next_float;
  return (void*)rng;
  ```)
;; Free a Test-Random

(defn Test-Random-free [rng]
  ```c free(rng);
  ```)
;; Reset the test RNG to initial state

(defn testrng-reset []
  ```c test_state = 42;
  ```)
;; ============================================================================
;; Test-Time implementation
;; Mock clock that can be controlled manually
;; ============================================================================
;; Test-Time implementation - manually controlled clock


(defn Test-Time []
  ```c /* Define the Time struct */
  typedef struct Time Time;
  struct Time {
      int (*now)(void);
      void (*sleep)(int ms);
  };
  
  /* Global mock time state */
  static int mock_time_value = 0;
  
  /* now implementation - returns mock time */
  static int test_now(void) {
      return mock_time_value;
  }
  
  /* sleep implementation - advances mock time */
  static void test_sleep(int ms) {
      mock_time_value += ms;
  }
  
  /* Create and populate the capability struct */
  Time* time = (Time*)malloc(sizeof(Time));
  time->now = test_now;
  time->sleep = test_sleep;
  return (void*)time;
  ```)
;; Free a Test-Time

(defn Test-Time-free [t]
  ```c free(t);
  ```)
;; Set the mock time value

(defn testtime-set [t new_time]
  ```c /* Update global mock time */
  mock_time_value = new_time;
  ```)
;; Get the current mock time value

(defn testtime-get [t]
  ```c return mock_time_value;
  ```)
;; Reset mock time to 0

(defn testtime-reset []
  ```c mock_time_value = 0;
  ```)
