;; Phase 16: Test capability implementations
;;
;; Mock implementations for testing - these allow tests to verify behavior
;; without touching the filesystem, network, etc.
(extern-c malloc [^ptr size] :ptr)

(extern-c free [^ptr p] :void)

(extern-c strcmp [^cstr ^cstr] :int)

(extern-c strcpy [^cstr ^cstr] :cstr)

(extern-c strlen [^cstr] :int)

;; file-scope-c-block: every capability here is a struct of function pointers
;; backed by shared mutable state. Both the vtable methods AND the standalone
;; accessor defns below (testfs-clear, testlog-count, ...) must see the same
;; file-scope structs/globals -- a returned vtable cannot point at functions
;; nested inside a constructor body, and the globals cannot be trapped there
;; either. So the structs, the singleton state, and every helper live here.
```c
/* ---- Test-FileSystem: an in-memory filesystem singleton ---- */
typedef struct __tur_test_fs_vtable {
    int (*read_file)(const char* path, unsigned char* buf, int buf_len, int* out_len);
    int (*write_file)(const char* path, const unsigned char* data, int data_len);
    int (*delete)(const char* path);
    int (*list)(const char* path, char** entries, int max_entries, int* out_count);
} __tur_test_fs_vtable;

typedef struct __tur_inmem_file {
    char* name;
    unsigned char* data;
    int data_len;
    struct __tur_inmem_file* next;
} __tur_inmem_file;

static struct { __tur_inmem_file* files; } __tur_global_fs = {0};

static __tur_inmem_file* __tur_testfs_find(const char* name) {
    __tur_inmem_file* f = __tur_global_fs.files;
    while (f) {
        if (strcmp(f->name, name) == 0) return f;
        f = f->next;
    }
    return NULL;
}

static int __tur_testfs_read_file(const char* path, unsigned char* buf, int buf_len, int* out_len) {
    __tur_inmem_file* f = __tur_testfs_find(path);
    if (!f) return -1; /* File not found */
    int copy_len = (f->data_len < buf_len) ? f->data_len : buf_len;
    if (copy_len > 0) memcpy(buf, f->data, copy_len);
    *out_len = copy_len;
    return 0;
}

static int __tur_testfs_write_file(const char* path, const unsigned char* data, int data_len) {
    /* Drop any existing file with this name first. */
    __tur_inmem_file* prev = NULL;
    __tur_inmem_file* f = __tur_global_fs.files;
    while (f) {
        if (strcmp(f->name, path) == 0) {
            if (prev) prev->next = f->next; else __tur_global_fs.files = f->next;
            free(f->name); free(f->data); free(f);
            break;
        }
        prev = f;
        f = f->next;
    }
    __tur_inmem_file* nf = (__tur_inmem_file*)malloc(sizeof(__tur_inmem_file));
    nf->name = strdup(path);
    nf->data = (unsigned char*)malloc(data_len);
    memcpy(nf->data, data, data_len);
    nf->data_len = data_len;
    nf->next = __tur_global_fs.files;
    __tur_global_fs.files = nf;
    return 0;
}

static int __tur_testfs_delete(const char* path) {
    __tur_inmem_file* prev = NULL;
    __tur_inmem_file* f = __tur_global_fs.files;
    while (f) {
        if (strcmp(f->name, path) == 0) {
            if (prev) prev->next = f->next; else __tur_global_fs.files = f->next;
            free(f->name); free(f->data); free(f);
            return 0;
        }
        prev = f;
        f = f->next;
    }
    return -1; /* File not found */
}

static int __tur_testfs_list(const char* path, char** entries, int max_entries, int* out_count) {
    (void)path; /* simplified: list all files regardless of path */
    __tur_inmem_file* f = __tur_global_fs.files;
    int count = 0;
    while (f) { count++; f = f->next; }
    f = __tur_global_fs.files;
    for (int i = 0; i < count && i < max_entries; i++) {
        if (entries) entries[i] = strdup(f->name);
        f = f->next;
    }
    *out_count = count;
    return 0;
}

/* ---- Test-Logger: captures messages for later inspection ---- */
typedef struct __tur_test_logger_vtable {
    void (*debug)(const char* msg);
    void (*info)(const char* msg);
    void (*warn)(const char* msg);
    void (*error)(const char* msg);
} __tur_test_logger_vtable;

typedef struct __tur_captured_log {
    char* level;
    char* message;
    struct __tur_captured_log* next;
} __tur_captured_log;

static struct { __tur_captured_log* logs; __tur_captured_log* last; } __tur_global_logger = {0};

static void __tur_testlog_add(const char* level, const char* msg) {
    __tur_captured_log* log = (__tur_captured_log*)malloc(sizeof(__tur_captured_log));
    log->level = strdup(level);
    log->message = strdup(msg);
    log->next = NULL;
    if (!__tur_global_logger.last) {
        __tur_global_logger.logs = log;
        __tur_global_logger.last = log;
    } else {
        __tur_global_logger.last->next = log;
        __tur_global_logger.last = log;
    }
}

static void __tur_test_logger_debug(const char* msg) { __tur_testlog_add("DEBUG", msg); }
static void __tur_test_logger_info(const char* msg)  { __tur_testlog_add("INFO",  msg); }
static void __tur_test_logger_warn(const char* msg)  { __tur_testlog_add("WARN",  msg); }
static void __tur_test_logger_error(const char* msg) { __tur_testlog_add("ERROR", msg); }

/* ---- Test-Random: deterministic LCG ---- */
typedef struct __tur_test_random_vtable {
    int (*next_int)(int min, int max);
    int (*next_float)(void);
} __tur_test_random_vtable;

/* unsigned: the LCG multiply overflows int (signed overflow is UB); unsigned
 * wraparound is well-defined, and the 0x7fffffff mask keeps the result a
 * non-negative value that fits back into int. */
static unsigned int __tur_test_rng_state = 42u;

static int __tur_test_rng_lcg(void) {
    __tur_test_rng_state = (__tur_test_rng_state * 1103515245u + 12345u) & 0x7fffffffu;
    return (int)__tur_test_rng_state;
}
static int __tur_test_rng_next_int(int min, int max) {
    return min + (__tur_test_rng_lcg() % (max - min + 1));
}
static int __tur_test_rng_next_float(void) {
    return __tur_test_rng_lcg() % 10000;
}

/* ---- Test-Time: manually controlled mock clock ---- */
typedef struct __tur_test_time_vtable {
    int (*now)(void);
    void (*sleep)(int ms);
} __tur_test_time_vtable;

static int __tur_test_time_value = 0;

static int __tur_test_now(void) { return __tur_test_time_value; }
static void __tur_test_sleep(int ms) { __tur_test_time_value += ms; }
```

;; ============================================================================
;; Test-FileSystem implementation -- in-memory filesystem for testing
;; ============================================================================
;; Test-FileSystem implementation

(defn Test-FileSystem [] : int
  ```c __tur_test_fs_vtable* fs = (__tur_test_fs_vtable*)malloc(sizeof(__tur_test_fs_vtable));
  fs->read_file  = __tur_testfs_read_file;
  fs->write_file = __tur_testfs_write_file;
  fs->delete     = __tur_testfs_delete;
  fs->list       = __tur_testfs_list;
  return (int64_t)(intptr_t)fs;
  ```)
;; Free a Test-FileSystem

(defn Test-FileSystem-free [fs] : nil
  ```c free((void*)(intptr_t)fs);
  ```)
;; Clear all files from the test filesystem

(defn testfs-clear [] : nil
  ```c __tur_inmem_file* f = __tur_global_fs.files;
  while (f) {
      __tur_inmem_file* next = f->next;
      free(f->name); free(f->data); free(f);
      f = next;
  }
  __tur_global_fs.files = NULL;
  ```)
;; Check if a file exists in the test filesystem

(defn testfs-exists? [path : cstr] : int
  ```c return __tur_testfs_find(path) != NULL ? 1 : 0;
  ```)
;; Get file contents from test filesystem (malloc'd, NUL-terminated; caller frees)

(defn testfs-get-contents [path : cstr] : ptr<void>
  ```c __tur_inmem_file* f = __tur_testfs_find(path);
  if (!f) return NULL;
  unsigned char* buf = (unsigned char*)malloc(f->data_len + 1);
  memcpy(buf, f->data, f->data_len);
  buf[f->data_len] = '\0';
  return (void*)buf;
  ```)
;; ============================================================================
;; Test-Logger implementation -- captures log messages for verification
;; ============================================================================
;; Test-Logger implementation

(defn Test-Logger [] : int
  ```c __tur_test_logger_vtable* logger = (__tur_test_logger_vtable*)malloc(sizeof(__tur_test_logger_vtable));
  logger->debug = __tur_test_logger_debug;
  logger->info  = __tur_test_logger_info;
  logger->warn  = __tur_test_logger_warn;
  logger->error = __tur_test_logger_error;
  return (int64_t)(intptr_t)logger;
  ```)
;; Free a Test-Logger

(defn Test-Logger-free [log] : nil
  ```c free((void*)(intptr_t)log);
  ```)
;; Clear all captured logs

(defn testlog-clear [] : nil
  ```c __tur_captured_log* log = __tur_global_logger.logs;
  while (log) {
      __tur_captured_log* next = log->next;
      free(log->level); free(log->message); free(log);
      log = next;
  }
  __tur_global_logger.logs = NULL;
  __tur_global_logger.last = NULL;
  ```)
;; Get the number of captured logs

(defn testlog-count [] : int
  ```c __tur_captured_log* log = __tur_global_logger.logs;
  int count = 0;
  while (log) { count++; log = log->next; }
  return count;
  ```)
;; Check if a log message was captured (by level and message)

(defn testlog-has? [level : cstr msg : cstr] : int
  ```c __tur_captured_log* log = __tur_global_logger.logs;
  while (log) {
      if (strcmp(log->level, level) == 0 && strcmp(log->message, msg) == 0) return 1;
      log = log->next;
  }
  return 0;
  ```)
;; ============================================================================
;; Test-Random implementation -- deterministic RNG with fixed seed
;; ============================================================================
;; Test-Random implementation - deterministic for testing

(defn Test-Random [] : int
  ```c __tur_test_random_vtable* rng = (__tur_test_random_vtable*)malloc(sizeof(__tur_test_random_vtable));
  rng->next_int   = __tur_test_rng_next_int;
  rng->next_float = __tur_test_rng_next_float;
  return (int64_t)(intptr_t)rng;
  ```)
;; Free a Test-Random

(defn Test-Random-free [rng] : nil
  ```c free((void*)(intptr_t)rng);
  ```)
;; Reset the test RNG to initial state

(defn testrng-reset [] : nil
  ```c __tur_test_rng_state = 42u;
  ```)
;; ============================================================================
;; Test-Time implementation -- mock clock that can be controlled manually
;; ============================================================================
;; Test-Time implementation - manually controlled clock

(defn Test-Time [] : int
  ```c __tur_test_time_vtable* t = (__tur_test_time_vtable*)malloc(sizeof(__tur_test_time_vtable));
  t->now   = __tur_test_now;
  t->sleep = __tur_test_sleep;
  return (int64_t)(intptr_t)t;
  ```)
;; Free a Test-Time

(defn Test-Time-free [t] : nil
  ```c free((void*)(intptr_t)t);
  ```)
;; Set the mock time value

(defn testtime-set [t new_time : int] : nil
  ```c __tur_test_time_value = (int)new_time;
  ```)
;; Get the current mock time value

(defn testtime-get [t] : int
  ```c return __tur_test_time_value;
  ```)
;; Reset mock time to 0

(defn testtime-reset [] : nil
  ```c __tur_test_time_value = 0;
  ```)
