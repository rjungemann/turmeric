;; Slice type for Turmeric
;; Borrowed view into a contiguous sequence

;; Create a slice from pointer and length
;;
;; DEPRECATED: Phase TC1-C
;; The functions in this module are deprecated in favor of the typed
;; API in stdlib/tslice.tur.  They will be removed in the
;; release cycle following Phase TC1-C.
;;

;;; slice-new -- create a slice view over an existing contiguous int64 array.
;;;
;;; Parameters:
;;;   data   -- pointer to the first element of the underlying array
;;;   length -- number of elements in the view
;;;
;;; Returns:
;;;   An opaque slice handle; free with slice-free when done.
;;;
;;; Example:
;;;   (def s (slice-new arr 4))  ; view of first 4 elements
;;;
;;; Deprecated: Use tslice-new from stdlib/tslice.tur instead.
(defn ^deprecated "see tslice-* in stdlib/tslice.tur" slice-new [data length]
  ```c
  struct { int64_t *p; size_t len; } *s = malloc(sizeof(*s));
  s->p = (int64_t*)data;
  s->len = (size_t)length;
  return s;
  ```)

;; Get slice length
;;; slice-len -- return the number of elements in the slice.
;;;
;;; Parameters:
;;;   s -- slice handle from slice-new
;;;
;;; Returns:
;;;   Element count as :int.
;;;
;;; Example:
;;;   (slice-len s)  ; => 4
;;;
;;; Deprecated: Use tslice-len from stdlib/tslice.tur instead.
(defn ^deprecated "see tslice-* in stdlib/tslice.tur" slice-len [s] :int
  ```c
  struct { int64_t *p; size_t len; } *slice = (void*)s;
  return (int)slice->len;
  ```)

;; Get element at index (bounds-checked)
;;; slice-get -- bounds-checked element access; aborts on out-of-range index.
;;;
;;; Parameters:
;;;   s -- slice handle from slice-new
;;;   i -- zero-based index (must be 0 <= i < slice-len s)
;;;
;;; Returns:
;;;   The int64 value at position i.
;;;
;;; Example:
;;;   (slice-get s 0)  ; => first element
;;;
;;; Deprecated: Use tslice-get from stdlib/tslice.tur instead.
(defn ^deprecated "see tslice-* in stdlib/tslice.tur" slice-get [s i] :int
  ```c
  struct { int64_t *p; size_t len; } *slice = (void*)s;
  if (i >= 0 && (size_t)i < slice->len) return (int)slice->p[i];
  fprintf(stderr, "slice index out of bounds\n");
  exit(1);
  return 0;
  ```)

;; Free the slice struct (does NOT free the underlying data)
;;; slice-free -- free the slice header struct; does NOT free the underlying data.
;;;
;;; Parameters:
;;;   s -- slice handle from slice-new
;;;
;;; Deprecated: Use tslice-free from stdlib/tslice.tur instead.
(defn ^deprecated "see tslice-* in stdlib/tslice.tur" slice-free [s]
  ```c
  free(s);
  return 0;
  ```)


;;; SINCE: Phase HKT H3
;; Functor, Foldable, and Traversable instances for slice<T>

;; Functor for slice - map a function over each element
;;; __functor_slice_fmap -- internal Functor fmap for slice: map fn over each element, returning a new slice.
;;;
;;; Since: Phase HKT H3
(defn __functor_slice_fmap [container fn] :int
  ```c
  struct { int64_t *p; size_t len; } *s =
      (struct { int64_t *p; size_t len; } *)(intptr_t)container;
  if (!s) return 0;
  struct { int64_t *p; size_t len; } *r =
      malloc(sizeof(struct { int64_t *p; size_t len; }));
  if (!r) return 0;
  r->len = s->len;
  r->p = malloc(sizeof(int64_t) * s->len);
  if (!r->p) { free(r); return 0; }
  for (size_t i = 0; i < s->len; i++) {
      r->p[i] = ((int64_t(*)(int64_t))(intptr_t)fn)(s->p[i]);
  }
  return (int64_t)(intptr_t)r;
  ```)

;;; Functor [ptr<void>] -- Functor instance for slice<T> via ptr<void> representation.
;;;
;;; Since: Phase HKT H3
;;; Phase CCL: fn is tur_poly_fn_t; call via fn.fn(fn.env, arg).
(definstance Functor [ptr<void>]
  (fmap [container fn]
    ```c
    struct { int64_t *p; size_t len; } *s =
        (struct { int64_t *p; size_t len; } *)(intptr_t)container;
    if (!s) return 0;
    struct { int64_t *p; size_t len; } *r =
        malloc(sizeof(struct { int64_t *p; size_t len; }));
    if (!r) return 0;
    r->len = s->len;
    r->p = malloc(sizeof(int64_t) * s->len);
    if (!r->p) { free(r); return 0; }
    for (size_t i = 0; i < s->len; i++) {
        r->p[i] = fn.fn(fn.env, s->p[i]);
    }
    return (int64_t)(intptr_t)r;
    ```))

;; Foldable for slice - left and right folds
;;; __foldable_slice_foldl -- internal left-fold over a slice: accumulate from left using fn(acc, elem).
;;;
;;; Since: Phase HKT H3
(defn __foldable_slice_foldl [ta init fn] :int
  ```c
  struct { int64_t *p; size_t len; } *s =
      (struct { int64_t *p; size_t len; } *)(intptr_t)ta;
  int64_t acc = init;
  if (!s) return acc;
  for (size_t i = 0; i < s->len; i++) {
      acc = ((int64_t(*)(int64_t, int64_t))(intptr_t)fn)(acc, s->p[i]);
  }
  return acc;
  ```)

;;; __foldable_slice_foldr -- internal right-fold over a slice: accumulate from right using fn(elem, acc).
;;;
;;; Since: Phase HKT H3
(defn __foldable_slice_foldr [ta init fn] :int
  ```c
  struct { int64_t *p; size_t len; } *s =
      (struct { int64_t *p; size_t len; } *)(intptr_t)ta;
  int64_t acc = init;
  if (!s) return acc;
  for (size_t i = s->len; i-- > 0; ) {
      acc = ((int64_t(*)(int64_t, int64_t))(intptr_t)fn)(s->p[i], acc);
  }
  return acc;
  ```)

;;; Foldable [ptr<void>] -- Foldable instance for slice<T> via ptr<void> representation.
;;;
;;; Since: Phase HKT H3
(definstance Foldable [ptr<void>]
  (foldl [ta init fn] (__foldable_slice_foldl ta init fn))
  (foldr [ta init fn] (__foldable_slice_foldr ta init fn)))

;; Traversable for slice - map with effects
;; In v1, simplifies to map since we use int64_t returns
;;; __traversable_slice_traverse -- internal Traversable traverse for slice: apply fn to each element (v1: same as fmap).
;;;
;;; Since: Phase HKT H3
(defn __traversable_slice_traverse [ta fn] :int
  ```c
  struct { int64_t *p; size_t len; } *s =
      (struct { int64_t *p; size_t len; } *)(intptr_t)ta;
  if (!s) return 0;
  struct { int64_t *p; size_t len; } *r =
      malloc(sizeof(struct { int64_t *p; size_t len; }));
  if (!r) return 0;
  r->len = s->len;
  r->p = malloc(sizeof(int64_t) * s->len);
  if (!r->p) { free(r); return 0; }
  for (size_t i = 0; i < s->len; i++) {
      r->p[i] = ((int64_t(*)(int64_t))(intptr_t)fn)(s->p[i]);
  }
  return (int64_t)(intptr_t)r;
  ```)

;;; Traversable [ptr<void>] -- Traversable instance for slice<T> via ptr<void> representation.
;;;
;;; Since: Phase HKT H3
(definstance Traversable [ptr<void>]
  (traverse [ta fn] (__traversable_slice_traverse ta fn)))
