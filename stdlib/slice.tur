;; Slice type for Turmeric
;; Borrowed view into a contiguous sequence

;; Create a slice from pointer and length
(defn slice-new [data length]
  ```c
  struct { int64_t *p; size_t len; } *s = malloc(sizeof(*s));
  s->p = (int64_t*)data;
  s->len = (size_t)length;
  return s;
  ```)

;; Get slice length
(defn slice-len [s] :int
  ```c
  struct { int64_t *p; size_t len; } *slice = (void*)s;
  return (int)slice->len;
  ```)

;; Get element at index (bounds-checked)
(defn slice-get [s i] :int
  ```c
  struct { int64_t *p; size_t len; } *slice = (void*)s;
  if (i >= 0 && (size_t)i < slice->len) return (int)slice->p[i];
  fprintf(stderr, "slice index out of bounds\n");
  exit(1);
  return 0;
  ```)

;; Free the slice struct (does NOT free the underlying data)
(defn slice-free [s]
  ```c
  free(s);
  return 0;
  ```)

;;; SINCE: Phase HKT-P8
;; Foldable instance for slice.
;;   foldl :: (b -> a -> b) -> b -> slice a -> b   (left fold, strict)
;;   foldr :: (a -> b -> b) -> b -> slice a -> b   (right fold)
(defn __foldable_slice_foldl [ta init fn] :int
  ```c
  struct { int64_t *p; size_t len; } *s =
      (struct { int64_t *p; size_t len; } *)(intptr_t)ta;
  int64_t acc = init;
  if (!s) return acc;
  for (size_t i = 0; i < s->len; i++) {
      acc = ((int64_t(*)(int64_t, int64_t))(intptr_t)fn)(acc, s->p[i]);
  }
  return acc;
  ```)

(defn __foldable_slice_foldr [ta init fn] :int
  ```c
  struct { int64_t *p; size_t len; } *s =
      (struct { int64_t *p; size_t len; } *)(intptr_t)ta;
  int64_t acc = init;
  if (!s) return acc;
  for (size_t i = s->len; i-- > 0; ) {
      acc = ((int64_t(*)(int64_t, int64_t))(intptr_t)fn)(s->p[i], acc);
  }
  return acc;
  ```)

(definstance Foldable [slice]
  (foldl [ta init fn] (__foldable_slice_foldl ta init fn))
  (foldr [ta init fn] (__foldable_slice_foldr ta init fn)))

;; Traversable instance for slice.
;; In v1, traverse applies fn to each element and collects results into a new
;; vec (the natural container for a sequence of results).  The Applicative
;; accumulator is implicit: results are gathered left-to-right as int64_t values.
(defn __traversable_slice_traverse [ta fn] :int
  ```c
  struct { int64_t *p; size_t len; } *s =
      (struct { int64_t *p; size_t len; } *)(intptr_t)ta;
  struct { int64_t *data; size_t len; size_t cap; } *r =
      malloc(sizeof(struct { int64_t *data; size_t len; size_t cap; }));
  r->len  = s ? s->len : 0;
  r->cap  = r->len;
  r->data = r->len > 0 ? malloc(sizeof(int64_t) * r->len) : NULL;
  if (s) {
      for (size_t i = 0; i < s->len; i++) {
          r->data[i] = ((int64_t(*)(int64_t))(intptr_t)fn)(s->p[i]);
      }
  }
  return (int64_t)(intptr_t)r;
  ```)

(definstance Traversable [slice]
  (traverse [ta fn] (__traversable_slice_traverse ta fn)))
