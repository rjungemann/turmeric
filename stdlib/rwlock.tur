;;; tur/rwlock -- POSIX read-write lock (pthread_rwlock_t) wrapped as ptr<void>.
;;;
;;; Multiple readers may hold the lock simultaneously; writers are exclusive.
;;;
;;; Since: Phase T19-C
;; stdlib/rwlock.tur -- POSIX read-write lock (Phase T19-C)
;;
;; Wraps pthread_rwlock_t as a :ptr<void>.  Multiple readers can hold the lock
;; concurrently; writers get exclusive access.
;;
;; API:
;;   rwlock-new         []                    -- ptr<void>
;;   rwlock-rdlock      [rw :ptr<void>]       -- nil
;;   rwlock-wrlock      [rw :ptr<void>]       -- nil
;;   rwlock-try-rdlock  [rw :ptr<void>]       -- bool
;;   rwlock-try-wrlock  [rw :ptr<void>]       -- bool
;;   rwlock-unlock      [rw :RwLock]          -- nil
;;   rwlock-free        [rw :RwLock]          -- nil
;; ---- Opaque handle newtype (stdlib-opaque-handle-types-plan, Tier 2) ----
;; RwLock wraps the underlying :ptr<void> with a nominally distinct type so the
;; checker rejects passing an unrelated handle (a Mutex, a CondVar) where an
;; RwLock is expected. It lowers to :ptr<void> in the C ABI, so the inline-C
;; bodies are unchanged.
(defopaque RwLock :ptr<void>)
;;; rwlock-new -- allocate and initialise a new POSIX read-write lock.
;;;
;;; Returns:
;;;   An RwLock handle to a heap-allocated pthread_rwlock_t.
;;;
;;; Example:
;;;   (let [rw (rwlock-new)] ...)  ; => RwLock
;;;
;;; Since: Phase T19-C

(defn rwlock-new [] : RwLock
  ```c
  pthread_rwlock_t *rw = (pthread_rwlock_t *)malloc(sizeof(pthread_rwlock_t));
  if (!rw) { fprintf(stderr, "rwlock-new: out of memory\n"); abort(); }
  pthread_rwlock_init(rw, NULL);
  return (int64_t)(intptr_t)rw;
  ```)
;;; rwlock-rdlock -- acquire a shared read lock, blocking until available.
;;;
;;; Parameters:
;;;   rw -- rwlock handle returned by rwlock-new
;;;
;;; Example:
;;;   (rwlock-rdlock rw)
;;;
;;; Since: Phase T19-C

(defn rwlock-rdlock [rw : RwLock] : nil
  ```c
  pthread_rwlock_rdlock((pthread_rwlock_t *)rw);
  ```)
;;; rwlock-wrlock -- acquire an exclusive write lock, blocking until available.
;;;
;;; Parameters:
;;;   rw -- rwlock handle returned by rwlock-new
;;;
;;; Example:
;;;   (rwlock-wrlock rw)
;;;
;;; Since: Phase T19-C

(defn rwlock-wrlock [rw : RwLock] : nil
  ```c
  pthread_rwlock_wrlock((pthread_rwlock_t *)rw);
  ```)
;;; rwlock-try-rdlock -- attempt to acquire a shared read lock without blocking.
;;;
;;; Parameters:
;;;   rw -- rwlock handle returned by rwlock-new
;;;
;;; Returns:
;;;   true if the read lock was acquired; false if a writer currently holds the lock.
;;;
;;; Example:
;;;   (if (rwlock-try-rdlock rw) ...)  ; => bool
;;;
;;; Since: Phase T19-C

(defn rwlock-try-rdlock [rw : RwLock] : bool
  ```c
  return pthread_rwlock_tryrdlock((pthread_rwlock_t *)rw) == 0;
  ```)
;;; rwlock-try-wrlock -- attempt to acquire an exclusive write lock without blocking.
;;;
;;; Parameters:
;;;   rw -- rwlock handle returned by rwlock-new
;;;
;;; Returns:
;;;   true if the write lock was acquired; false if the lock is currently held.
;;;
;;; Example:
;;;   (if (rwlock-try-wrlock rw) ...)  ; => bool
;;;
;;; Since: Phase T19-C

(defn rwlock-try-wrlock [rw : RwLock] : bool
  ```c
  return pthread_rwlock_trywrlock((pthread_rwlock_t *)rw) == 0;
  ```)
;;; rwlock-unlock -- release a previously acquired read or write lock.
;;;
;;; Parameters:
;;;   rw -- rwlock handle returned by rwlock-new
;;;
;;; Example:
;;;   (rwlock-unlock rw)
;;;
;;; Since: Phase T19-C

(defn rwlock-unlock [rw : RwLock] : nil
  ```c
  pthread_rwlock_unlock((pthread_rwlock_t *)rw);
  ```)
;;; rwlock-free -- destroy the read-write lock and release its memory.
;;;
;;; Parameters:
;;;   rw -- rwlock handle returned by rwlock-new
;;;
;;; Example:
;;;   (rwlock-free rw)
;;;
;;; Since: Phase T19-C

(defn rwlock-free [rw : RwLock] : nil
  ```c
  /* RwLock is a defopaque over :ptr<void>, which lowers to int64_t, so both
     the destroy and the free need the cast -- `free(rw)` alone is an
     int-to-pointer conversion warning under the cc-warning ratchet. */
  pthread_rwlock_destroy((pthread_rwlock_t *)(intptr_t)rw);
  free((void *)(intptr_t)rw);
  ```)
;;; with-read-lock -- run body holding the rwlock for reading.
;;;
;;; Parameters:
;;;   rw   -- an RwLock handle (borrowed; not consumed or freed)
;;;   body -- one or more forms; the last one's value is returned
;;;
;;; Returns:
;;;   The value of the last body form.
;;;
;;; Example:
;;;   (let [rw (rwlock-new)]
;;;     (println (with-read-lock rw 42))   ; => 42
;;;     (rwlock-free rw))
;;;
;;; Carries the same two caveats as `with-lock` in stdlib/mutex.tur: `rw` is
;;; evaluated twice (pass a variable, not a call), and a panic inside the body
;;; leaves the lock held.
;;;
;;; Since: 2026-08-20
(defmacro with-read-lock [rw & body]
  (do
    (rwlock-rdlock rw)
    (let [__wrl-result (do ~@body)] (rwlock-unlock rw) __wrl-result)))
;;; with-write-lock -- run body holding the rwlock for writing.
;;;
;;; Parameters:
;;;   rw   -- an RwLock handle (borrowed; not consumed or freed)
;;;   body -- one or more forms; the last one's value is returned
;;;
;;; Returns:
;;;   The value of the last body form.
;;;
;;; Example:
;;;   (let [rw (rwlock-new)]
;;;     (println (with-write-lock rw 7))   ; => 7
;;;     (rwlock-free rw))
;;;
;;; Same caveats as `with-read-lock`.
;;;
;;; Since: 2026-08-20
(defmacro with-write-lock [rw & body]
  (do
    (rwlock-wrlock rw)
    (let [__wwl-result (do ~@body)] (rwlock-unlock rw) __wwl-result)))
