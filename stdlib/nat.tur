;;; tur/nat -- type-level natural numbers via GADT for phantom length annotations.
;;;
;;; Nat encodes a number at the type level as a phantom type.
;;; True compile-time length safety is deferred to a future dependent-types phase.
;;;
;;; Since: Phase G4
;; Phase G4: Type-level natural numbers via GADT.
; Phase G4: Type-level natural numbers via GADT.
; Nat is a phantom type encoding a number at the type level.
; Zero and Succ are constructors that carry a runtime nat value.
;
; Since Turmeric does not yet support dependent types (types depending on
; runtime values), the length index n in Vec is a type-level phantom -- it
; helps document intent but does not enforce lengths at compile time.
; True compile-time length safety is deferred to a future dependent-types phase.
(defgadt Nat [] (Zero : (Nat)) (Succ (Nat) : (Nat)))
;;; nat-zero -- construct the Zero natural number.
;;;
;;; Returns:
;;;   A (Nat) value representing zero.
;;;
;;; Example:
;;;   (nat-zero)  ; => Zero
;;;
;;; Since: Phase G4

(defn nat-zero [] : Nat (Zero))
;;; nat-succ -- construct the successor of a natural number.
;;;
;;; Parameters:
;;;   n -- the predecessor (Nat) value
;;;
;;; Returns:
;;;   A (Nat) value representing n+1.
;;;
;;; Example:
;;;   (nat-succ (nat-zero))  ; => Succ(Zero)
;;;
;;; Since: Phase G4

(defn nat-succ [n : Nat] : Nat (Succ n))
;;; nat-to-int -- convert a type-level Nat to a runtime integer.
;;;
;;; Parameters:
;;;   n -- the (Nat) value to convert
;;;
;;; Returns:
;;;   The integer representation of n.
;;;
;;; Example:
;;;   (nat-to-int (Succ (Succ (Zero))))  ; => 2
;;;
;;; Since: Phase G4

(defn nat-to-int [n : Nat] : int
  (match n (Zero) 0 (Succ p) (+ 1 (nat-to-int p))))
;;; nat-add -- add two type-level Nat values.
;;;
;;; Parameters:
;;;   a -- first (Nat) value
;;;   b -- second (Nat) value
;;;
;;; Returns:
;;;   A (Nat) representing a + b.
;;;
;;; Example:
;;;   (nat-to-int (nat-add (Succ (Zero)) (Succ (Succ (Zero)))))  ; => 3
;;;
;;; Since: Phase G4

(defn nat-add [a : Nat b : Nat] : Nat
  (match a (Zero) b (Succ p) (Succ (nat-add p b))))
