;; stdlib/serial.tur -- Phase 21: Serializable continuations
;;
;; Defines the Serializable typeclass and primitive/container instances.
;; Implementation uses inline C since the methods operate on raw bytes.

(extern-c malloc  [^int size]          :ptr<void>)
(extern-c free    [^ptr<void> p]       :void)
(extern-c memcpy  [^ptr<void> dst ^ptr<void> src ^int n] :ptr<void>)
(extern-c memcmp  [^ptr<void> a ^ptr<void> b ^int n] :int)
(extern-c strlen  [^cstr s]            :int)
(extern-c exit    [^int code]          :void)

;; ---------------------------------------------------------------------------
;; bytes -- a length-prefixed heap buffer: { int64 len; uint8_t data[]; }
;; ---------------------------------------------------------------------------

;; Allocate a fresh bytes value of `n` bytes (zeroed).
(defn bytes-alloc [n :int] :ptr<void>
  ```c
  int64_t *buf = malloc(sizeof(int64_t) + (size_t)n);
  if (!buf) { fprintf(stderr, "bytes-alloc: out of memory\n"); exit(1); }
  buf[0] = (int64_t)n;
  memset(buf + 1, 0, (size_t)n);
  return buf;
  ```)

;; Return the length of a bytes value.
(defn bytes-len [b :ptr<void>] :int
  ```c
  if (!b) return 0;
  return (int64_t)(((int64_t*)b)[0]);
  ```)

;; Return a pointer to the raw data inside a bytes value.
(defn bytes-data [b :ptr<void>] :ptr<void>
  ```c
  if (!b) return NULL;
  return (void*)((int64_t*)b + 1);
  ```)

;; Free a bytes value.
(defn bytes-free [b :ptr<void>] :void
  ```c
  free(b);
  return 0;
  ```)

;; Concatenate two bytes values into a new one.
(defn bytes-concat [a :ptr<void> b :ptr<void>] :ptr<void>
  ```c
  int64_t la = a ? ((int64_t*)a)[0] : 0;
  int64_t lb = b ? ((int64_t*)b)[0] : 0;
  int64_t total = la + lb;
  int64_t *out = malloc(sizeof(int64_t) + (size_t)total);
  if (!out) { fprintf(stderr, "bytes-concat: out of memory\n"); exit(1); }
  out[0] = total;
  uint8_t *dst = (uint8_t*)(out + 1);
  if (la > 0) memcpy(dst, (int64_t*)a + 1, (size_t)la);
  if (lb > 0) memcpy(dst + la, (int64_t*)b + 1, (size_t)lb);
  return out;
  ```)

;; ---------------------------------------------------------------------------
;; Serializable typeclass
;;
;; Methods:
;;   (serialize   x)  : bytes  -- marshal x to bytes
;;   (deserialize b)  : x      -- unmarshal (panics on error for now; full
;;                                Result support is deferred until Result is
;;                                a first-class generic type in the compiler)
;; ---------------------------------------------------------------------------

(defclass Serializable [a]
  (serialize   [x] :ptr<void>)
  (deserialize [b :ptr<void>] :int))

;; ---------------------------------------------------------------------------
;; Primitive instances
;; Each instance packs its value as little-endian bytes, prefixed by length.
;; ---------------------------------------------------------------------------

;; int (int64) -- 8 bytes little-endian
(definstance Serializable [int]
  (serialize [x]
    ```c
    int64_t *buf = malloc(sizeof(int64_t) + 8);
    if (!buf) { fprintf(stderr, "serialize int: oom\n"); exit(1); }
    buf[0] = 8;
    uint8_t *p = (uint8_t*)(buf + 1);
    int64_t v = (int64_t)x;
    p[0] = (uint8_t)(v & 0xff);
    p[1] = (uint8_t)((v >>  8) & 0xff);
    p[2] = (uint8_t)((v >> 16) & 0xff);
    p[3] = (uint8_t)((v >> 24) & 0xff);
    p[4] = (uint8_t)((v >> 32) & 0xff);
    p[5] = (uint8_t)((v >> 40) & 0xff);
    p[6] = (uint8_t)((v >> 48) & 0xff);
    p[7] = (uint8_t)((v >> 56) & 0xff);
    return buf;
    ```)
  (deserialize [b]
    ```c
    if (!b || ((int64_t*)b)[0] < 8) {
      fprintf(stderr, "deserialize int: short buffer\n"); exit(1);
    }
    uint8_t *p = (uint8_t*)((int64_t*)b + 1);
    int64_t v =
        (int64_t)p[0]
      | ((int64_t)p[1] <<  8)
      | ((int64_t)p[2] << 16)
      | ((int64_t)p[3] << 24)
      | ((int64_t)p[4] << 32)
      | ((int64_t)p[5] << 40)
      | ((int64_t)p[6] << 48)
      | ((int64_t)p[7] << 56);
    return v;
    ```))

;; bool -- 1 byte (0 or 1)
(definstance Serializable [bool]
  (serialize [x]
    ```c
    int64_t *buf = malloc(sizeof(int64_t) + 1);
    if (!buf) { fprintf(stderr, "serialize bool: oom\n"); exit(1); }
    buf[0] = 1;
    ((uint8_t*)(buf + 1))[0] = x ? 1 : 0;
    return buf;
    ```)
  (deserialize [b]
    ```c
    if (!b || ((int64_t*)b)[0] < 1) {
      fprintf(stderr, "deserialize bool: short buffer\n"); exit(1);
    }
    return (int64_t)(((uint8_t*)((int64_t*)b + 1))[0] != 0);
    ```))

;; float64 (double) -- 8 bytes IEEE 754 little-endian
(definstance Serializable [float]
  (serialize [x]
    ```c
    int64_t *buf = malloc(sizeof(int64_t) + 8);
    if (!buf) { fprintf(stderr, "serialize float: oom\n"); exit(1); }
    buf[0] = 8;
    double dv = *(double*)&x;
    uint64_t bits;
    memcpy(&bits, &dv, 8);
    uint8_t *p = (uint8_t*)(buf + 1);
    p[0] = (uint8_t)(bits & 0xff);
    p[1] = (uint8_t)((bits >>  8) & 0xff);
    p[2] = (uint8_t)((bits >> 16) & 0xff);
    p[3] = (uint8_t)((bits >> 24) & 0xff);
    p[4] = (uint8_t)((bits >> 32) & 0xff);
    p[5] = (uint8_t)((bits >> 40) & 0xff);
    p[6] = (uint8_t)((bits >> 48) & 0xff);
    p[7] = (uint8_t)((bits >> 56) & 0xff);
    return buf;
    ```)
  (deserialize [b]
    ```c
    if (!b || ((int64_t*)b)[0] < 8) {
      fprintf(stderr, "deserialize float: short buffer\n"); exit(1);
    }
    uint8_t *p = (uint8_t*)((int64_t*)b + 1);
    uint64_t bits =
        (uint64_t)p[0]
      | ((uint64_t)p[1] <<  8)
      | ((uint64_t)p[2] << 16)
      | ((uint64_t)p[3] << 24)
      | ((uint64_t)p[4] << 32)
      | ((uint64_t)p[5] << 40)
      | ((uint64_t)p[6] << 48)
      | ((uint64_t)p[7] << 56);
    double dv;
    memcpy(&dv, &bits, 8);
    return *(int64_t*)&dv;
    ```))

;; cstr -- length-prefixed UTF-8 string (4-byte little-endian length + bytes)
(definstance Serializable [cstr]
  (serialize [x]
    ```c
    const char *s = (const char*)x;
    int64_t slen = s ? (int64_t)strlen(s) : 0;
    int64_t total = 4 + slen;          /* 4-byte length prefix */
    int64_t *buf = malloc(sizeof(int64_t) + (size_t)total);
    if (!buf) { fprintf(stderr, "serialize cstr: oom\n"); exit(1); }
    buf[0] = total;
    uint8_t *p = (uint8_t*)(buf + 1);
    p[0] = (uint8_t)(slen & 0xff);
    p[1] = (uint8_t)((slen >>  8) & 0xff);
    p[2] = (uint8_t)((slen >> 16) & 0xff);
    p[3] = (uint8_t)((slen >> 24) & 0xff);
    if (slen > 0) memcpy(p + 4, s, (size_t)slen);
    return buf;
    ```)
  (deserialize [b]
    ```c
    if (!b || ((int64_t*)b)[0] < 4) {
      fprintf(stderr, "deserialize cstr: short buffer\n"); exit(1);
    }
    uint8_t *p = (uint8_t*)((int64_t*)b + 1);
    int64_t slen =
        (int64_t)p[0]
      | ((int64_t)p[1] <<  8)
      | ((int64_t)p[2] << 16)
      | ((int64_t)p[3] << 24);
    if (((int64_t*)b)[0] < 4 + slen) {
      fprintf(stderr, "deserialize cstr: buffer too short for string\n"); exit(1);
    }
    char *out = malloc((size_t)(slen + 1));
    if (!out) { fprintf(stderr, "deserialize cstr: oom\n"); exit(1); }
    if (slen > 0) memcpy(out, p + 4, (size_t)slen);
    out[slen] = '\0';
    return (int64_t)(uintptr_t)out;
    ```))

;; bytes (ptr<void>) -- prefix with 8-byte length, then raw data
(definstance Serializable [ptr<void>]
  (serialize [x]
    ```c
    int64_t *inner = (int64_t*)x;
    int64_t dlen = inner ? inner[0] : 0;
    int64_t total = 8 + dlen;
    int64_t *buf = malloc(sizeof(int64_t) + (size_t)total);
    if (!buf) { fprintf(stderr, "serialize bytes: oom\n"); exit(1); }
    buf[0] = total;
    uint8_t *p = (uint8_t*)(buf + 1);
    p[0] = (uint8_t)(dlen & 0xff);
    p[1] = (uint8_t)((dlen >>  8) & 0xff);
    p[2] = (uint8_t)((dlen >> 16) & 0xff);
    p[3] = (uint8_t)((dlen >> 24) & 0xff);
    p[4] = (uint8_t)((dlen >> 32) & 0xff);
    p[5] = (uint8_t)((dlen >> 40) & 0xff);
    p[6] = (uint8_t)((dlen >> 48) & 0xff);
    p[7] = (uint8_t)((dlen >> 56) & 0xff);
    if (dlen > 0) memcpy(p + 8, (uint8_t*)(inner + 1), (size_t)dlen);
    return buf;
    ```)
  (deserialize [b]
    ```c
    if (!b || ((int64_t*)b)[0] < 8) {
      fprintf(stderr, "deserialize bytes: short buffer\n"); exit(1);
    }
    uint8_t *p = (uint8_t*)((int64_t*)b + 1);
    int64_t dlen =
        (int64_t)p[0]
      | ((int64_t)p[1] <<  8)
      | ((int64_t)p[2] << 16)
      | ((int64_t)p[3] << 24)
      | ((int64_t)p[4] << 32)
      | ((int64_t)p[5] << 40)
      | ((int64_t)p[6] << 48)
      | ((int64_t)p[7] << 56);
    if (((int64_t*)b)[0] < 8 + dlen) {
      fprintf(stderr, "deserialize bytes: buffer too short for payload\n"); exit(1);
    }
    int64_t *out = malloc(sizeof(int64_t) + (size_t)dlen);
    if (!out) { fprintf(stderr, "deserialize bytes: oom\n"); exit(1); }
    out[0] = dlen;
    if (dlen > 0) memcpy(out + 1, p + 8, (size_t)dlen);
    return (int64_t)(uintptr_t)out;
    ```))

;; ---------------------------------------------------------------------------
;; File I/O helpers (cont-to-file / cont-from-file)
;; These operate on opaque bytes values returned by serial-cont->bytes.
;; ---------------------------------------------------------------------------

(extern-c fopen  [^cstr path ^cstr mode] :ptr<void>)
(extern-c fclose [^ptr<void> f]          :int)
(extern-c fwrite [^ptr<void> buf ^int size ^int n ^ptr<void> f] :int)
(extern-c fread  [^ptr<void> buf ^int size ^int n ^ptr<void> f] :int)
(extern-c fseek  [^ptr<void> f ^int off ^int whence] :int)
(extern-c ftell  [^ptr<void> f] :int)

;; Write a serialized continuation to a file.
;; Returns 1 on success, 0 on failure.
(defn cont-to-file [b :ptr<void> path :cstr] :int
  ```c
  if (!b) return 0;
  FILE *f = fopen((const char*)path, "wb");
  if (!f) return 0;
  int64_t len = ((int64_t*)b)[0];
  uint8_t *data = (uint8_t*)((int64_t*)b + 1);
  int64_t written = (int64_t)fwrite(&len, 1, 8, f);
  if (written == 8) written += (int64_t)fwrite(data, 1, (size_t)len, f);
  fclose(f);
  return (written == 8 + len) ? 1 : 0;
  ```)

;; Read a serialized continuation from a file.
;; Returns a bytes ptr<void> on success, NULL on failure.
(defn cont-from-file [path :cstr] :ptr<void>
  ```c
  FILE *f = fopen((const char*)path, "rb");
  if (!f) return NULL;
  int64_t len = 0;
  if ((int64_t)fread(&len, 1, 8, f) != 8 || len < 0) { fclose(f); return NULL; }
  int64_t *buf = malloc(sizeof(int64_t) + (size_t)len);
  if (!buf) { fclose(f); return NULL; }
  buf[0] = len;
  if (len > 0 && (int64_t)fread(buf + 1, 1, (size_t)len, f) != len) {
    free(buf); fclose(f); return NULL;
  }
  fclose(f);
  return buf;
  ```)
