;;; tur/async_file -- non-blocking file I/O integrated with the cooperative scheduler.
;;;
;;; Read and write files without blocking the current fiber.
;;;
;;; Since: Phase T24
;; stdlib/async_file.tur -- Async file I/O for Turmeric (Phase T24)
;;
;; Non-blocking file operations that integrate with the cooperative scheduler.
;; When an operation would block (EAGAIN/EWOULDBLOCK), the current fiber is
;; parked and an IO waiter is registered; the scheduler polls and resumes
;; the fiber when the fd becomes ready.
;;
;; API:
;;   async-file-open  [path flags]    -> fd (int), -1 on error
;;   async-file-read  [fd buf-size]   -> bytes-read (int), 0 on EOF, -1 on error
;;   async-file-write [fd data len]   -> bytes-written (int), -1 on error
;;   async-file-close [fd]            -> 0 on success, -1 on error

;; Open a file with O_NONBLOCK set.
;; flags: 0 = O_RDONLY, 1 = O_WRONLY|O_CREAT|O_TRUNC, 2 = O_RDWR
;;; async-file-open -- open a file with O_NONBLOCK and return its file descriptor.
;;;
;;; Parameters:
;;;   path  -- filesystem path to the file
;;;   flags -- 0 = O_RDONLY, 1 = O_WRONLY|O_CREAT|O_TRUNC, 2 = O_RDWR
;;;
;;; Returns:
;;;   int -- the file descriptor, or -1 on error
;;;
;;; Example:
;;;   (async-file-open "/tmp/out.txt" 1)  ; => 5
;;;
;;; Since: Phase T24
(defn async-file-open [path :cstr flags :int] #{Unsafe} :int
  ```c
  int oflags;
  switch ((int)flags) {
    case 1:  oflags = O_WRONLY | O_CREAT | O_TRUNC; break;
    case 2:  oflags = O_RDWR; break;
    default: oflags = O_RDONLY; break;
  }
  int fd = open(path, oflags | O_NONBLOCK, 0644);
  return (int64_t)fd;
  ```)

;; Read up to buf-size bytes from fd.
;; Returns number of bytes read, 0 on EOF, -1 on error.
;; If running under a scheduler, parks the fiber on EAGAIN.
;;; async-file-read -- read up to buf-size bytes from a non-blocking file descriptor.
;;;
;;; Parameters:
;;;   fd       -- file descriptor returned by async-file-open
;;;   buf-size -- maximum number of bytes to read
;;;
;;; Returns:
;;;   int -- bytes read (>= 0), 0 on EOF, -1 on error
;;;
;;; Example:
;;;   (async-file-read fd 4096)  ; => 128
;;;
;;; Since: Phase T24
(defn async-file-read [fd :int buf-size :int] #{Unsafe} :int
  ```c
  char *buf = (char *)malloc((size_t)buf_size);
  if (!buf) return -1;
  while (1) {
    ssize_t n = read((int)fd, buf, (size_t)buf_size);
    if (n >= 0) {
      /* Store buf pointer in fiber-local for retrieval */
      if (tur_current_fiber) {
        tur_fiber_local_set(tur_current_fiber, 0xA51CF11E, (int64_t)(intptr_t)buf);
        tur_fiber_local_set(tur_current_fiber, 0xA51CF11F, n);
      }
      return (int64_t)n;
    }
    if (errno == EAGAIN || errno == EWOULDBLOCK) {
      FiberBlock *me = tur_current_fiber;
      if (me && tur_scheduler) {
        tur_io_register((int)fd, TUR_IO_READ, me);
        me->parked = 1;
        tur_fiber_block_yield(0);
        continue;
      }
    }
    free(buf);
    return -1;
  }
  ```)

;; Write len bytes from data to fd.
;; If running under a scheduler, parks the fiber on EAGAIN.
;;; async-file-write -- write len bytes from data to a non-blocking file descriptor.
;;;
;;; Parameters:
;;;   fd   -- file descriptor returned by async-file-open
;;;   data -- pointer to the bytes to write
;;;   len  -- number of bytes to write
;;;
;;; Returns:
;;;   int -- total bytes written, or -1 on error
;;;
;;; Example:
;;;   (async-file-write fd "hello" 5)  ; => 5
;;;
;;; Since: Phase T24
(defn async-file-write [fd :int data :cstr len :int] #{Unsafe} :int
  ```c
  int64_t total = 0;
  while (total < len) {
    ssize_t n = write((int)fd, data + total, (size_t)(len - total));
    if (n >= 0) {
      total += n;
      continue;
    }
    if (errno == EAGAIN || errno == EWOULDBLOCK) {
      FiberBlock *me = tur_current_fiber;
      if (me && tur_scheduler) {
        tur_io_register((int)fd, TUR_IO_WRITE, me);
        me->parked = 1;
        tur_fiber_block_yield(0);
        continue;
      }
    }
    return -1;
  }
  return total;
  ```)

;; Close a file descriptor.
;;; async-file-close -- close a file descriptor and unregister it from IO polling.
;;;
;;; Parameters:
;;;   fd -- file descriptor to close
;;;
;;; Returns:
;;;   int -- 0 on success, -1 on error
;;;
;;; Example:
;;;   (async-file-close fd)  ; => 0
;;;
;;; Since: Phase T24
(defn async-file-close [fd :int] #{Unsafe} :int
  ```c
  tur_io_unregister((int)fd);
  return (int64_t)close((int)fd);
  ```)

;; Retrieve the internal read buffer pointer after async-file-read.
;; Returns a pointer to the buffer (caller must free).
;;; async-file-read-buf -- retrieve the buffer pointer from the last async-file-read call.
;;;
;;; Returns:
;;;   ptr<void> -- pointer to the read buffer stored in fiber-local storage (caller must free)
;;;
;;; Example:
;;;   (async-file-read-buf)  ; => buf-ptr
;;;
;;; Since: Phase T24
(defn async-file-read-buf [] #{Unsafe} :ptr<void>
  ```c
  if (!tur_current_fiber) return NULL;
  return (void*)(intptr_t)tur_fiber_local_get(tur_current_fiber, 0xA51CF11E);
  ```)

;; Retrieve the number of bytes from the last async-file-read.
;;; async-file-read-len -- retrieve the byte count from the last async-file-read call.
;;;
;;; Returns:
;;;   int -- number of bytes read in the most recent async-file-read
;;;
;;; Example:
;;;   (async-file-read-len)  ; => 128
;;;
;;; Since: Phase T24
(defn async-file-read-len [] #{Unsafe} :int
  ```c
  if (!tur_current_fiber) return 0;
  return tur_fiber_local_get(tur_current_fiber, 0xA51CF11F);
  ```)
