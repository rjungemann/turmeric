;;; tur/random -- Random capability implementation using the platform RNG.
;;;
;;; Implements the Random capability typeclass for real random values.
;;;
;;; NOT CRYPTOGRAPHICALLY SECURE. This is libc `rand()` seeded with
;;; `time(NULL)`. Its output is fully predictable to anyone who can guess the
;;; second the process started -- a few thousand candidate streams, trivially
;;; enumerable. It is the right tool for simulation, sampling, shuffling,
;;; jitter, and procedural generation, and the wrong tool for anything an
;;; attacker benefits from predicting: session tokens, password-reset links,
;;; nonces, salts, IVs, or key material.
;;;
;;; For those, use `crypto-random-bytes!` from the `secret` spice
;;; (`spices/secret` in turmeric-spices), which draws from the OS CSPRNG --
;;; `getrandom(2)` / `arc4random_buf` / `BCryptGenRandom` / `/dev/urandom`.
;;;
;;; Since: Phase 16
;; Phase 16: Real Random implementation
;;
;; Implementation of Random capability using platform RNG
(extern-c rand [^] :int)

(extern-c srand [^int] :void)
;; NOTE: `time` is NOT declared via extern-c. It is only ever called from
;; inline-C as `time(NULL)`, which resolves to the libc prototype in <time.h>
;; (pulled in by the codegen preamble). An `(extern-c time [^ptr] :ptr)`
;; binding emits `extern void *time(void *)`, which conflicts with the real
;; `time_t time(time_t *)` and breaks the C compile on a standard toolchain.


(extern-c malloc [^ptr size] :ptr)

(extern-c free [^ptr p] :void)

(load "stdlib/effects.tur")
;; stdlib-effect-rows: the rand-* draws consume non-deterministic randomness,
;; so each carries the #{Rand} capability tag.
;;; Real-Random -- create a Random capability backed by libc rand().
;;;
;;; Returns:
;;;   A heap-allocated Random struct with:
;;;     next_int   -- returns a random integer in [min, max].
;;;     next_float -- returns a random integer in [0, 9999] (divide by 10000.0
;;;                   to obtain a float in [0, 1)).
;;;   The RNG is seeded with time(NULL) on first use.
;;;   Free with Real-Random-free when done.
;;;
;;; Example:
;;;   (let [rng (Real-Random)] ...)
;;;
;;; Since: Phase 16
;; Real-Random implementation
;; Uses libc rand() function
;;; random-next-int! -- Real-Random's next_int slot: a random integer in
;;; [min, max], auto-seeding libc rand() with time(NULL) on first use.
;;; Internal; hoisted to file scope so Real-Random's inline-C can take its
;;; address (nested + static functions are non-standard C).

(defn random-next-int! [min : int max : int] : int
  ```c
  static int seeded = 0;
  if (!seeded) {
      srand((unsigned int)time(NULL));
      seeded = 1;
  }
  int range = (int)max - (int)min + 1;
  int value = rand() % range;
  return (int64_t)((int)min + value);
  ```)
;;; random-next-float! -- Real-Random's next_float slot: a random integer in
;;; [0, 10000), auto-seeding libc rand() with time(NULL) on first use.
;;; Internal; hoisted to file scope (see random-next-int!).

(defn random-next-float! [] : int
  ```c
  static int seeded = 0;
  if (!seeded) {
      srand((unsigned int)time(NULL));
      seeded = 1;
  }
  return (int64_t)(rand() % 10000);
  ```)

(defn Real-Random [] : ptr
  ```c
  /* Define the Random struct. The function-pointer field types must match the
     emitted Turmeric signatures of the hoisted helpers: `: int` params/return
     lower to int64_t. */
  typedef struct Random Random;
  struct Random {
      int64_t (*next_int)(int64_t min, int64_t max);
      int64_t (*next_float)(void);
  };

  /* Create and populate the capability struct, referencing the file-scope
     helpers by address via the __TUR_CNAME_...__ placeholder. */
  Random* rng = (Random*)malloc(sizeof(Random));
  rng->next_int = __TUR_CNAME_random-next-int!__;
  rng->next_float = __TUR_CNAME_random-next-float!__;
  return (void*)rng;
  ```)
;;; Real-Random-free -- release a Random capability created by Real-Random.
;;;
;;; Parameters:
;;;   rng -- the Random pointer returned by Real-Random.
;;;
;;; Since: Phase 16
;; Free a Real-Random

(defn Real-Random-free [rng : ptr] : void
  ```c
  free(rng);
  ```)
;; ============================================================================
;; Seeded Random implementation
;; ============================================================================
;;; Seeded-Random -- create a deterministic Random capability from a fixed seed.
;;;
;;; Parameters:
;;;   seed -- unsigned integer seed for srand; same seed produces the same sequence.
;;;
;;; Returns:
;;;   A heap-allocated Random struct identical in interface to Real-Random but
;;;   seeded immediately with the supplied value.  Useful for reproducible tests.
;;;   Free with Seeded-Random-free when done.
;;;
;;; Example:
;;;   (let [rng (Seeded-Random 42)] ...)
;;;
;;; Since: Phase 16
;; Seeded-Random implementation - uses a fixed seed for reproducibility
;; Useful for testing
;;; seeded-next-int! -- Seeded-Random's next_int slot: a random integer in
;;; [min, max] drawn from the current libc rand() state. Does not auto-seed;
;;; Seeded-Random calls srand(seed) at construction. Internal; hoisted to file
;;; scope so Seeded-Random's inline-C can take its address.

(defn seeded-next-int! [min : int max : int] : int
  ```c
  int range = (int)max - (int)min + 1;
  int value = rand() % range;
  return (int64_t)((int)min + value);
  ```)
;;; seeded-next-float! -- Seeded-Random's next_float slot: a random integer in
;;; [0, 10000) drawn from the current libc rand() state. Does not auto-seed
;;; (see seeded-next-int!). Internal; hoisted to file scope.

(defn seeded-next-float! [] : int
  ```c
  return (int64_t)(rand() % 10000);
  ```)

(defn Seeded-Random [seed : int] : ptr
  ```c
  typedef struct Random Random;
  struct Random {
      int64_t (*next_int)(int64_t min, int64_t max);
      int64_t (*next_float)(void);
  };

  /* Seed the RNG once at construction; the hoisted helpers just draw rand(). */
  srand((unsigned int)seed);

  /* Create and populate the capability struct, referencing the file-scope
     helpers by address via the __TUR_CNAME_...__ placeholder. */
  Random* rng = (Random*)malloc(sizeof(Random));
  rng->next_int = __TUR_CNAME_seeded-next-int!__;
  rng->next_float = __TUR_CNAME_seeded-next-float!__;
  return (void*)rng;
  ```)
;;; Seeded-Random-free -- release a Random capability created by Seeded-Random.
;;;
;;; Parameters:
;;;   rng -- the Random pointer returned by Seeded-Random.
;;;
;;; Since: Phase 16
;; Free a Seeded-Random

(defn Seeded-Random-free [rng : ptr] : void
  ```c
  free(rng);
  ```)
;; ============================================================================
;; Helper functions for direct random number generation
;; ============================================================================
;;; rand-int -- return a random integer in the inclusive range [min, max].
;;;
;;; Parameters:
;;;   min -- the minimum value (inclusive).
;;;   max -- the maximum value (inclusive).
;;;
;;; Returns:
;;;   A random integer in [min, max].  The libc RNG is auto-seeded with
;;;   time(NULL) on first call.
;;;
;;; Example:
;;;   (rand-int 1 6)  ; => 4  (simulate a die roll)  ; doctest: non-deterministic (seeded from time(NULL))
;;;
;;; Since: Phase 16
;; Get a random integer in range [min, max]


(defn rand-int [min max]
  #fx{Rand}
  : int
  ```c
  static int seeded = 0;
  if (!seeded) {
      srand((unsigned int)time(NULL));
      seeded = 1;
  }
  int range = max - min + 1;
  int value = rand() % range;
  return min + value;
  ```)
;;; rand-float -- return a random integer scaled to represent [0, 1).
;;;
;;; Returns:
;;;   An integer in [0, 9999].  Divide by 10000.0 to obtain a float
;;;   in [0, 1).  The libc RNG is auto-seeded with time(NULL) on first call.
;;;
;;; Example:
;;;   (rand-float)  ; => 7312  (represents ~0.7312)  ; doctest: non-deterministic (seeded from time(NULL))
;;;
;;; Since: Phase 16
;; Get a random float in range [0, 1)
;; Returns value scaled by 10000 (divide by 10000.0 to get actual float)

(defn rand-float []
  #fx{Rand}
  : int
  ```c
  static int seeded = 0;
  if (!seeded) {
      srand((unsigned int)time(NULL));
      seeded = 1;
  }
  return rand() % 10000;
  ```)
;;; rand-die -- roll an n-sided die, returning a value in [1, sides].
;;;
;;; Parameters:
;;;   sides -- the number of faces on the die.
;;;
;;; Returns:
;;;   A random integer in [1, sides].
;;;
;;; Example:
;;;   (rand-die 20)  ; => 13  (D20 roll)  ; doctest: non-deterministic (seeded from time(NULL))
;;;
;;; Since: Phase 16
;; Roll a die with n sides (1 to n)

(defn rand-die [sides]
  #fx{Rand}
  : int
  ```c
  static int seeded = 0;
  if (!seeded) {
      srand((unsigned int)time(NULL));
      seeded = 1;
  }
  return 1 + (rand() % sides);
  ```)
;;; rand-bool -- return a random boolean value.
;;;
;;; Returns:
;;;   1 (true) or 0 (false) with equal probability.
;;;
;;; Example:
;;;   (rand-bool)  ; => 1  (or 0)  ; doctest: non-deterministic (fair coin, seeded from time(NULL))
;;;
;;; Since: Phase 16
;; Random boolean (true or false)

(defn rand-bool []
  #fx{Rand}
  : int
  ```c
  static int seeded = 0;
  if (!seeded) {
      srand((unsigned int)time(NULL));
      seeded = 1;
  }
  return (rand() % 2) != 0;
  ```)
