;; Phase 15: Typeclasses
;; Built-in typeclasses: Eq, Ord, Show, Num

;; Eq typeclass - equality comparison
(defclass Eq [a]
  (eq? [x y] :bool))

;; Instances for primitive types
(definstance Eq [int]
  (eq? [x y] (= x y)))

(definstance Eq [bool]
  (eq? [x y] (= x y)))

;; Ord typeclass - ordering
(defclass Ord [a]
  (lt? [x y] :bool)
  (lte? [x y] :bool)
  (gt? [x y] :bool)
  (gte? [x y] :bool))

;; Instances for primitive types
(definstance Ord [int]
  (lt? [x y] (< x y))
  (lte? [x y] (<= x y))
  (gt? [x y] (> x y))
  (gte? [x y] (>= x y)))

;; Show typeclass - string representation
(defclass Show [a]
  (show [x] :cstr))

;; Instances for primitive types
(definstance Show [int]
  (show [x] :cstr "<int>"))

(definstance Show [cstr]
  (show [x] x))

;; Num typeclass - numeric operations
(defclass Num [a]
  (add [x y] :int)
  (sub [x y] :int)
  (mul [x y] :int)
  (div [x y] :int)
  (neg [x] :int))

;; Instance for int
(definstance Num [int]
  (add [x y] (+ x y))
  (sub [x y] (- x y))
  (mul [x y] (* x y))
  (div [x y] (/ x y))
  (neg [x] (- 0 x)))

;; Phase B1: Clone typeclass - deep copy of a value
(defclass Clone [a]
  (clone [x] :int))

;; Clone instances for primitive types
(definstance Clone [int]
  (clone [x] x))

;;; SINCE: Phase HKT H3
;; Higher-kinded typeclasses — require kind '* -> *' type constructor parameters.
;;
;; These typeclasses follow the Haskell/PureScript convention.  In Turmeric v1
;; the method signatures use :int as the return type (int64_t in C) so that
;; container values, which are heap pointers, can be returned without a full
;; parameterised type system.  Callers may cast the result to the concrete
;; container pointer type using inline C or ptr<void> helpers.

;; Functor — map a function over a container without changing its shape.
;;   fmap :: (a -> b) -> f a -> f b
;;   In v1: fmap [container fn] :int  (int64_t holds the result pointer)
(defclass Functor [^f]
  (fmap [container fn] :int))

;; Applicative — container with a pure constructor and ap combinator.
;;   pure :: a -> f a
;;   ap   :: f (a -> b) -> f a -> f b
(defclass Applicative [^f]
  (pure [x] :int)
  (ap [ff fa] :int))

;; Monad — sequencing with flatMap/bind.
;;   bind :: m a -> (a -> m b) -> m b
(defclass Monad [^m]
  (bind [ma fn] :int))

;; Foldable — reduce a container to a summary value.
;;   foldl :: b -> (b -> a -> b) -> t a -> b
;;   foldr :: (a -> b -> b) -> b -> t a -> b
(defclass Foldable [^t]
  (foldl [ta init fn] :int)
  (foldr [ta init fn] :int))

;; Traversable — map with effects, collecting results.
;;   traverse :: Applicative f => (a -> f b) -> t a -> f (t b)
;;   In v1: simplified to traverse [ta fn] :int
(defclass Traversable [^t]
  (traverse [ta fn] :int))

;;; SINCE: Phase HKT H5
;; Bifunctor — map over both sides of a binary type constructor.
;;   The canonical signature is:
;;     bimap :: (a -> c) -> (b -> d) -> f a b -> f c d
;;   In v1: simplified to bimap [container fn-left fn-right] :int
(defclass Bifunctor [^^f]
  (bimap [container fn-left fn-right] :int))
