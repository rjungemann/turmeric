;;; tur/result -- typed Result[A B]: ok value A or err value B.
;;;
;;; Parameterized result type. Runtime layout:
;;; { bool is_ok; A ok_val; B err_val; } for concrete payload types.
;;;
;;; Since: Phase TC1-E
;; Phase TC1-E: Typed Result[A B]
;; ok value of type A, err value of type B.
;; Runtime layout specializes ok/err payload fields for concrete A/B.
;;; Result -- parameterized result type with ok type A and err type B.
;;;
;;; Since: Phase TC1
(defstruct Result [A B] (is-ok :bool) (ok-val A) (err-val B))
;;; ok -- wrap a success value of type A in a Result[A B].
;;;
;;; Parameters:
;;;   x -- the ok value (type A)
;;;
;;; Returns:
;;;   A Result[A B] with is-ok=true. B is a phantom tyvar inferred
;;;   from the call site (or pinned with an ascription such as
;;;   `(:: (ok x) (Result A B))`).
;;;
;;; Example:
;;;   (ok 42)                        ; => Result int B  (B inferred)
;;;   (:: (ok "hi") (Result cstr cstr))
;;;
;;; Since: Phase TC1 (made polymorphic over A/B as Prereq 3, 2026-06-12;
;;;   the previous monomorphic-on-`:int` shape rejected non-int payloads
;;;   at TUR-E0001 and blocked the typed Decode surface in the json
;;;   spice. The body still goes through the int64 carrier helper
;;;   `tur_box_ok`; the type-level polymorphism is achieved by ascribing the
;;;   carrier handle to `(Result A B)` and letting the carrier-ABI
;;;   codegen take care of the rest).

(defn ok [A B] [x : A]
  #fx{Construct}
  : (Result A B)
  (make-struct Result :is-ok true :ok-val x :err-val (default-of B)))
;;; err -- wrap an error value of type B in a Result[A B].
;;;
;;; Parameters:
;;;   e -- the error value (type B)
;;;
;;; Returns:
;;;   A Result[A B] with is-ok=false. A is a phantom tyvar inferred
;;;   from the call site (or pinned with an ascription such as
;;;   `(:: (err msg) (Result A B))`).
;;;
;;; Example:
;;;   (err 404)                       ; => Result A int   (A inferred)
;;;   (:: (err "missing") (Result int cstr))
;;;
;;; Since: Phase TC1 (made polymorphic as Prereq 3, 2026-06-12; same
;;;   notes as `ok`).

(defn err [A B] [e : B]
  #fx{Construct}
  : (Result A B)
  (make-struct Result :is-ok false :ok-val (default-of A) :err-val e))
;;; ok? -- check whether a Result[A B] is ok.
;;;
;;; Parameters:
;;;   r -- Result[A B]
;;;
;;; Returns:
;;;   true if r is ok, false if r is err.
;;;
;;; Example:
;;;   (ok? (ok 1))   ; => true
;;;   (ok? (err 0))  ; => false
;;;
;;; Since: Phase TC1

(defn ok? [r : int]
  #fx{}
  : bool
  ```c
  return tur_is_ok(r);
  ```)
;;; err? -- check whether a Result[A B] is err.
;;;
;;; Parameters:
;;;   r -- Result[A B]
;;;
;;; Returns:
;;;   true if r is err, false if r is ok.
;;;
;;; Example:
;;;   (err? (err 1))  ; => true
;;;
;;; Since: Phase TC1

(defn err? [r : int]
  #fx{}
  : bool
  ```c
  return !tur_is_ok(r);
  ```)
;;; ok-val -- extract the ok value from a typed Result[A B].
;;;
;;; Parameters:
;;;   r -- Result[A B]
;;;
;;; Returns:
;;;   The ok value of type A.
;;;
;;; Example:
;;;   (let [r (:: (make-struct Result true 7 "err") (Result int cstr))]
;;;     (ok-val r))  ; => 7
;;;
;;; Since: Phase TC1

(defn ok-val [A B] [r : (Result A B)] :A (.ok-val r))
;;; err-val -- extract the error value from a typed Result[A B].
;;;
;;; Parameters:
;;;   r -- Result[A B]
;;;
;;; Returns:
;;;   The error value of type B.
;;;
;;; Example:
;;;   (let [r (:: (make-struct Result false 0 "boom") (Result int cstr))]
;;;     (err-val r))  ; => "boom"
;;;
;;; Since: Phase TC1

(defn err-val [A B] [r : (Result A B)] :B (.err-val r))
;;; result-free -- free a heap-allocated Result[A B].
;;;
;;; Parameters:
;;;   r -- Result[A B] to free
;;;
;;; Example:
;;;   (result-free my-result)
;;;
;;; Since: Phase TC1

(defn result-free [r : int]
  #fx{}
  : void
  ```c
  if (r) free((void*)(intptr_t)r);
  ```)
;;; result-map -- apply a function to the ok value if ok.
;;;
;;; Parameters:
;;;   r -- Result[A B]
;;;   f -- function A -> C
;;;
;;; Returns:
;;;   Result[C B] with f applied to the ok value if ok, or the
;;;   unchanged err otherwise. The returned value is a freshly
;;;   allocated Result; the input r is not modified.
;;;
;;; Example:
;;;   (result-map (ok 3) (fn [x] (* x 2)))  ; => ok(6)
;;;   (result-map (err 5) (fn [x] (* x 2))) ; => err(5)
;;;
;;; Since: Phase TC1

(defn result-map [A B E] [r : (Result A E) ^fat f : (fn [A] B)] : (Result B E)
  ;; Option/Result none-as-NULL retirement (Track A): by-value `(Result A E)`
  ;; receiver.  Pure-Turmeric body reads `.is-ok`/`.ok-val`/`.err-val` directly
  ;; and rebuilds via the `#{Construct}` ok/err constructors -- no inline-C
  ;; carrier round-trip.  The interpreter keeps its native override.
  (if (.is-ok r) (ok (f (.ok-val r))) (err (.err-val r))))
;;; result-eq? -- compare two Result[A B] values.
;;;
;;; Parameters:
;;;   r1      -- first Result[A B]
;;;   r2      -- second Result[A B]
;;;   ok-cmp  -- comparator for ok values fn [a :int b :int] :bool
;;;   err-cmp -- comparator for err values fn [a :int b :int] :bool
;;;
;;; Returns:
;;;   true if both ok with equal ok values, or both err with equal err values.
;;;
;;; Example:
;;;   (result-eq? (ok 1) (ok 1) (fn [a b] (= a b)) (fn [a b] (= a b)))  ; => true
;;;
;;; Since: Phase TC1

(defn result-eq? [r1 : int r2 : int ^fat ok-cmp ^fat err-cmp]
  #fx{}
  : bool
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *a = (void*)(intptr_t)r1;
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *b = (void*)(intptr_t)r2;
  if (!a && !b) return true;
  if (!a || !b) return false;
  if (a->is_ok != b->is_ok) return false;
  /* CRU B-3: ok-cmp/err-cmp are fat closure boxes; fat-dispatch via slot 0. */
  if (a->is_ok)
      return ((bool(*)(void*, int64_t, int64_t))(intptr_t)((int64_t*)(intptr_t)ok_cmp)[0])((void*)(intptr_t)ok_cmp, a->ok_val, b->ok_val);
  else
      return ((bool(*)(void*, int64_t, int64_t))(intptr_t)((int64_t*)(intptr_t)err_cmp)[0])((void*)(intptr_t)err_cmp, a->err_val, b->err_val);
  ```)
;;; __tur-q-is-err? -- ? operator helper; checks if a Result value is an error.

(defn __tur-q-is-err? [r : ptr<void>]
  #fx{}
  : bool
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res = r;
  return !res || !res->is_ok;
  ```)
;;; __tur-q-ok-val -- ? operator helper; extracts the ok payload from a Result value.

(defn __tur-q-ok-val [r : ptr<void>]
  #fx{}
  : int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res = r;
  return res ? res->ok_val : 0;
  ```)
;;; Eq [Result] -- equality using the ok and err types' Eq instances.
;; TC1-22: Phase PTC4 -- constrained Eq instance for Result[A B].
;; Note: element comparison uses integer equality; correct for all primitive A/B.
;; M4c-pre: rewrite to consult by-value fields directly via Eq A / Eq B,
;; mirroring Eq Tuple2 / Eq Pair.  `result-eq?` itself is kept (the
;; structural-eq fixture still consults it from the carrier path); only the
;; instance body switches off it.  See
;; docs/reported/m4c-stdlib-carrier-helpers-block-dispatch-rewrite.md.

(definstance Eq [Result]
  [(Eq A) (Eq B)]
  (eq? [x y]
    (if (= (.is-ok x) (.is-ok y))
      (if (.is-ok x)
        (eq? (.ok-val x) (.ok-val y))
        (eq? (.err-val x) (.err-val y)))
      false)))
;;; result-bimap -- map fn-left over the err arm and fn-right over the ok arm.
;;;
;;; Follows the Either convention: the err arm is the "left" side and the ok
;;; arm is the "right" side. This is the worker behind the `Bifunctor [Result]`
;;; instance (kept here next to the Result layout it depends on).
;;;
;;; Parameters:
;;;   container -- Result[A B]
;;;   fn-left   -- function applied to the err value (B -> D)
;;;   fn-right  -- function applied to the ok value (A -> C)
;;;
;;; Returns:
;;;   A freshly allocated Result[C D]; the input is not modified.
;;;
;;; Example:
;;;   (result-bimap (ok 5) neg inc)   ; => ok(6)
;;;   (result-bimap (err 5) neg inc)  ; => err(-5)
;;;
;;; Since: stdlib-hkt-consolidation T1

(defn result-bimap [container : int fn-left fn-right]
  #fx{}
  : int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res = (void*)(intptr_t)container;
  if (!res) return 0;
  if (res->is_ok)
      return tur_box_ok(((int64_t(*)(int64_t))(intptr_t)fn_right)(res->ok_val));
  return tur_box_err(((int64_t(*)(int64_t))(intptr_t)fn_left)(res->err_val));
  ```)
;; ---------------------------------------------------------------------------
;; HKT typeclass instances (stdlib-hkt-consolidation T1)
;;
;; Result is a binary type constructor of kind (* -> * -> *), so it supports
;; Bifunctor directly. Result owns this instance (home module of the type), so
;; it is not an orphan; the Bifunctor class stub is preloaded before this file.
;;
;; T4 (stdlib-hkt-consolidation): the conventional kind-(* -> *) instances
;; (Functor / Applicative / Monad / MonadError over the ok arm) ARE now
;; expressible via the trailing-parameter instance head `(Result _ B)`, which
;; fixes the err arm B and varies the ok arm. (Result's parameters are
;; [A=ok B=err] with ok FIRST, so leftmost-only application `(Result A)` would
;; fix ok and vary err -- the opposite of the right-biased convention. The `_`
;; hole marks the free parameter, sidestepping that.) The element arm is erased
;; to the int64 carrier, so these instances delegate to inline-C carrier-level
;; bodies that operate on the ok arm and pass err through unchanged. See
;; docs/reported/result-param-order-blocks-functor-monad.md.
;; ---------------------------------------------------------------------------
;;; Bifunctor [Result] -- map fn-left over err, fn-right over ok.
;;;
;;; Example:
;;;   (bimap (ok 5) neg inc)   ; => ok(6)
;;;   (bimap (err 5) neg inc)  ; => err(-5)
;;;
;;; Since: stdlib-hkt-consolidation T1

(definstance Bifunctor [Result]
  (bimap [container fn-left fn-right]
    (if (.is-ok container)
      (ok (fn-right (.ok-val container)))
      (err (fn-left (.err-val container))))))
;; ---------------------------------------------------------------------------
;; Ok-biased kind-(* -> *) instances (stdlib-hkt-consolidation T4)
;;
;; The `(Result _ B)` head fixes the err arm B and varies the ok arm, so these
;; are right-biased: every method maps/sequences the ok payload and threads an
;; err through unchanged. Result owns these instances (home module), so they
;; are not orphans; the class stubs are preloaded before this file.
;; ---------------------------------------------------------------------------
;;; Functor [(Result _ B)] -- map a function over the ok payload; err unchanged.
;;;
;;; Example:
;;;   (fmap (:: (ok 21) (Result int int)) (fn [x] (* x 2)))  ; => ok(42)
;;;   (fmap (:: (err 5) (Result int int)) (fn [x] (* x 2)))  ; => err(5)
;;;
;;; Since: stdlib-hkt-consolidation T4

(definstance Functor [(Result _ B)]
  (fmap [container g]
    (if (.is-ok container)
      (ok (g (.ok-val container)))
      (err (.err-val container)))))
;;; Monad [(Result _ B)] -- bind sequences through ok; short-circuits on err.
;;;
;;; Example:
;;;   (bind (ok 20) (fn [x] (ok (+ x 1))))  ; => ok(21)
;;;
;;; Since: stdlib-hkt-consolidation T4

(definstance Monad [(Result _ B)]
  (bind [ma k] (if (.is-ok ma) (k (.ok-val ma)) (err (.err-val ma)))))
;;; MonadError [(Result _ B)] -- throw-error builds an err; catch-error runs a
;;; handler on the err payload (ok values pass through unchanged).
;;;
;;; Example:
;;;   (throw-error 404)                              ; => err(404)
;;;   (catch-error (err 5) (fn [e] (ok (* e -1))))   ; => ok(-5)
;;;   (catch-error (ok 7) (fn [e] (ok 0)))           ; => ok(7)
;;;
;;; Since: stdlib-hkt-consolidation T4

(definstance MonadError [(Result _ B)]
  (throw-error [err] ```c return tur_box_err(err); ```)
  (catch-error [ma handler]
    ```c
    struct { bool is_ok; int64_t ok_val; int64_t err_val; } *r = (void*)(intptr_t)ma;
    if (!r || r->is_ok) return ma;
    return handler.fn(handler.env, r->err_val);
    ```))
