;;; tur/result -- typed Result[A B]: ok value A or err value B.
;;;
;;; Parameterized result type. Runtime layout:
;;; { bool is_ok; A ok_val; B err_val; } for concrete payload types.
;;;
;;; Since: Phase TC1-E
;; Phase TC1-E: Typed Result[A B]
;; ok value of type A, err value of type B.
;; Runtime layout specializes ok/err payload fields for concrete A/B.
;;; Result -- parameterized result type with ok type A and err type B.
;;;
;;; Since: Phase TC1
(defstruct Result [A B] (is-ok :bool) (ok-val A) (err-val B))
;;; ok -- wrap a success value of type A in a Result[A B].
;;;
;;; Parameters:
;;;   x -- the ok value (type A)
;;;
;;; Returns:
;;;   A heap-allocated Result[A B] with is-ok=true.
;;;
;;; Example:
;;;   (ok 42)  ; => ok(42)
;;;
;;; Since: Phase TC1

(defn ok [x :int]
  #{}
  :int
  ```c struct { bool is_ok; int64_t ok_val; int64_t err_val; } *r = malloc(sizeof(*r));
  r->is_ok = true;
  r->ok_val = x;
  r->err_val = 0;
  return (int64_t)(intptr_t)r;
  ```)
;;; err -- wrap an error value of type B in a Result[A B].
;;;
;;; Parameters:
;;;   e -- the error value (type B)
;;;
;;; Returns:
;;;   A heap-allocated Result[A B] with is-ok=false.
;;;
;;; Example:
;;;   (err 404)  ; => err(404)
;;;
;;; Since: Phase TC1

(defn err [e :int]
  #{}
  :int
  ```c struct { bool is_ok; int64_t ok_val; int64_t err_val; } *r = malloc(sizeof(*r));
  r->is_ok = false;
  r->ok_val = 0;
  r->err_val = e;
  return (int64_t)(intptr_t)r;
  ```)
;;; ok? -- check whether a Result[A B] is ok.
;;;
;;; Parameters:
;;;   r -- Result[A B]
;;;
;;; Returns:
;;;   true if r is ok, false if r is err.
;;;
;;; Example:
;;;   (ok? (ok 1))   ; => true
;;;   (ok? (err 0))  ; => false
;;;
;;; Since: Phase TC1

(defn ok? [r :int]
  #{}
  :bool
  ```c struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res = (void*)(intptr_t)r;
  return res && res->is_ok;
  ```)
;;; err? -- check whether a Result[A B] is err.
;;;
;;; Parameters:
;;;   r -- Result[A B]
;;;
;;; Returns:
;;;   true if r is err, false if r is ok.
;;;
;;; Example:
;;;   (err? (err 1))  ; => true
;;;
;;; Since: Phase TC1

(defn err? [r :int]
  #{}
  :bool
  ```c struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res = (void*)(intptr_t)r;
  return !res || !res->is_ok;
  ```)
;;; ok-val -- extract the ok value from a typed Result[A B].
;;;
;;; Parameters:
;;;   r -- Result[A B]
;;;
;;; Returns:
;;;   The ok value of type A.
;;;
;;; Example:
;;;   (let [r (:: (make-struct Result true 7 "err") (Result int cstr))]
;;;     (ok-val r))  ; => 7
;;;
;;; Since: Phase TC1

(defn ok-val [A B] [r : (Result A B)] :A (.ok-val r))
;;; err-val -- extract the error value from a typed Result[A B].
;;;
;;; Parameters:
;;;   r -- Result[A B]
;;;
;;; Returns:
;;;   The error value of type B.
;;;
;;; Example:
;;;   (let [r (:: (make-struct Result false 0 "boom") (Result int cstr))]
;;;     (err-val r))  ; => "boom"
;;;
;;; Since: Phase TC1

(defn err-val [A B] [r : (Result A B)] :B (.err-val r))
;;; result-free -- free a heap-allocated Result[A B].
;;;
;;; Parameters:
;;;   r -- Result[A B] to free
;;;
;;; Example:
;;;   (result-free my-result)
;;;
;;; Since: Phase TC1

(defn result-free [r :int]
  #{}
  :void
  ```c if (r) free((void*)(intptr_t)r);
  ```)
;;; result-map -- apply a function to the ok value if ok.
;;;
;;; Parameters:
;;;   r -- Result[A B]
;;;   f -- function A -> C
;;;
;;; Returns:
;;;   Result[C B] with f applied to the ok value if ok, or the
;;;   unchanged err otherwise. The returned value is a freshly
;;;   allocated Result; the input r is not modified.
;;;
;;; Example:
;;;   (result-map (ok 3) (fn [x] (* x 2)))  ; => ok(6)
;;;   (result-map (err 5) (fn [x] (* x 2))) ; => err(5)
;;;
;;; Since: Phase TC1

(defn result-map [r :int f]
  #{}
  :int
  ```c struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res = (void*)(intptr_t)r;
  if (!res) return 0;
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *out = malloc(sizeof(*out));
  out->is_ok = res->is_ok;
  if (res->is_ok) {
      out->ok_val = ((int64_t(*)(int64_t))(intptr_t)f)(res->ok_val);
      out->err_val = 0;
  } else {
      out->ok_val = 0;
      out->err_val = res->err_val;
  }
  return (int64_t)(intptr_t)out;
  ```)
;;; result-eq? -- compare two Result[A B] values.
;;;
;;; Parameters:
;;;   r1      -- first Result[A B]
;;;   r2      -- second Result[A B]
;;;   ok-cmp  -- comparator for ok values fn [a :int b :int] :bool
;;;   err-cmp -- comparator for err values fn [a :int b :int] :bool
;;;
;;; Returns:
;;;   true if both ok with equal ok values, or both err with equal err values.
;;;
;;; Example:
;;;   (result-eq? (ok 1) (ok 1) (fn [a b] (= a b)) (fn [a b] (= a b)))  ; => true
;;;
;;; Since: Phase TC1

(defn result-eq? [r1 :int r2 :int ok-cmp err-cmp]
  #{}
  :bool
  ```c struct { bool is_ok; int64_t ok_val; int64_t err_val; } *a = (void*)(intptr_t)r1;
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *b = (void*)(intptr_t)r2;
  if (!a && !b) return true;
  if (!a || !b) return false;
  if (a->is_ok != b->is_ok) return false;
  if (a->is_ok)
      return ((bool(*)(int64_t, int64_t))(intptr_t)ok_cmp)(a->ok_val, b->ok_val);
  else
      return ((bool(*)(int64_t, int64_t))(intptr_t)err_cmp)(a->err_val, b->err_val);
  ```)
;;; __tur-q-is-err? -- ? operator helper; checks if a Result value is an error.

(defn __tur-q-is-err? [r :ptr<void>]
  #{}
  :bool
  ```c struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res = r;
  return !res || !res->is_ok;
  ```)
;;; __tur-q-ok-val -- ? operator helper; extracts the ok payload from a Result value.

(defn __tur-q-ok-val [r :ptr<void>]
  #{}
  :int
  ```c struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res = r;
  return res ? res->ok_val : 0;
  ```)
;;; Eq [Result] -- equality using the ok and err types' Eq instances.
;; TC1-22: Phase PTC4 -- constrained Eq instance for Result[A B].
;; Note: element comparison uses integer equality; correct for all primitive A/B.

(definstance Eq [Result] [(Eq A) (Eq B)]
  (eq? [x y] (result-eq? x y (fn [a b] (= a b)) (fn [a b] (= a b)))))
