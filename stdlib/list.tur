;;; tur/list -- typed singly-linked List[A] with Cons cells.
;;;
;;; Typed singly-linked list. List[A] = Option[Cons[A]].
;;; At runtime, nil is 0 and a cons cell specializes its head slot for
;;; concrete A while the tail link remains the legacy int64_t carrier.
;;;
;;; Since: Phase TC1-B
;; Phase TC1-B: Typed List[A]
;; Typed singly-linked list. List[A] = Option[Cons[A]].
;; At runtime, nil is 0 and a cons cell specializes head for concrete A while
;; the tail link remains the legacy int64_t carrier.

;;; Cons -- parameterized cons cell with typed head and tail.
;;;
;;; Since: Phase TC1
(defstruct Cons [A]
  (head A)
  (tail :int))

;;; tcons -- prepend a value to a typed list.
;;;
;;; Parameters:
;;;   h -- head element of type A
;;;   t -- tail list (another typed list or tnil)
;;;
;;; Returns:
;;;   A new List[A] (cons cell) with h at the front.
;;;
;;; Example:
;;;   (tcons 1 (tcons 2 (tnil)))  ; => [1, 2]
;;;
;;; Since: Phase TC1
(defn tcons [h :int t :int] #{} :int
  ```c
  struct { int64_t head; int64_t tail; } *cell = malloc(sizeof(*cell));
  cell->head = h;
  cell->tail = t;
  return (int64_t)(intptr_t)cell;
  ```)

;;; tcons-of -- typed Cons[A] constructor with a typed head slot.
;;;
;;; Parameters:
;;;   h -- head element of type A
;;;   t -- tail link (carrier :int; pass another cell's pointer or 0 for tnil)
;;;
;;; Returns:
;;;   A (Cons A) value whose head field is laid out as the concrete C type
;;;   for A (e.g. `double` for `:float`), with no user-side bit-cast.
;;;
;;; Example:
;;;   (let [c (tcons-of 1.5 0)]
;;;     (.head c))  ; => 1.5, read as a `double` field
;;;
;;; Since: Phase TS3
(defn tcons-of [A] [h :A t :int] :(Cons A)
  (make-struct Cons h t))

;;; tnil -- return an empty typed list.
;;;
;;; Returns:
;;;   0, representing the empty List[A].
;;;
;;; Example:
;;;   (tnil)  ; => empty list
;;;
;;; Since: Phase TC1
(defn tnil [] :int
  0)

;;; tnil? -- check whether a typed list is empty.
;;;
;;; Parameters:
;;;   l -- List[A]
;;;
;;; Returns:
;;;   true if l is the empty list, false otherwise.
;;;
;;; Example:
;;;   (tnil? (tnil))         ; => true
;;;   (tnil? (tcons 1 (tnil)))  ; => false
;;;
;;; Since: Phase TC1
(defn tnil? [l :int] :bool
  (= l 0))

;;; thead -- return the head element of a non-empty typed list.
;;;
;;; Parameters:
;;;   l -- Cons[A]
;;;
;;; Returns:
;;;   The head element of type A.
;;;
;;; Example:
;;;   (let [l (:: (make-struct Cons 42 (tnil)) (Cons int))]
;;;     (thead l))  ; => 42
;;;
;;; Since: Phase TC1
(defn thead [A] [l :(Cons A)] :A
  (.head l))

;;; ttail -- return the tail carrier of a non-empty typed list.
;;;
;;; Parameters:
;;;   l -- Cons[A]
;;;
;;; Returns:
;;;   The tail list carrier.
;;;
;;; Example:
;;;   (let [l (:: (make-struct Cons 1 (tnil)) (Cons int))]
;;;     (ttail l))  ; => 0
;;;
;;; Since: Phase TC1
(defn ttail [A] [l :(Cons A)] :int
  (.tail l))

;;; list-length -- count the number of elements in a typed list.
;;;
;;; Parameters:
;;;   l -- List[A]
;;;
;;; Returns:
;;;   Integer length.
;;;
;;; Example:
;;;   (list-length (tcons 1 (tcons 2 (tnil))))  ; => 2
;;;
;;; Since: Phase TC1
(defn list-length [l :int] #{} :int
  ```c
  struct __tur_cell_t { int64_t head; int64_t tail; };
  struct __tur_cell_t *cell = (void*)(intptr_t)l;
  int64_t count = 0;
  while (cell) {
      count++;
      cell = (void*)(intptr_t)cell->tail;
  }
  return count;
  ```)

;;; list-eq? -- compare two typed lists element-wise.
;;;
;;; Parameters:
;;;   l1     -- first List[A]
;;;   l2     -- second List[A]
;;;   cmp-fn -- comparator fn [a :int b :int] :bool
;;;
;;; Returns:
;;;   true if both lists have the same elements in the same order.
;;;
;;; Example:
;;;   (list-eq? (tcons 1 (tnil)) (tcons 1 (tnil)) (fn [a b] (= a b)))  ; => true
;;;
;;; Since: Phase TC1
(defn list-eq? [l1 :int l2 :int cmp-fn] #{} :bool
  ```c
  struct __tur_cons_t { int64_t head; int64_t tail; };
  struct __tur_cons_t *a = (void*)(intptr_t)l1;
  struct __tur_cons_t *b = (void*)(intptr_t)l2;
  while (a && b) {
      if (!((bool(*)(int64_t, int64_t))(intptr_t)cmp_fn)(a->head, b->head)) return false;
      a = (void*)(intptr_t)a->tail;
      b = (void*)(intptr_t)b->tail;
  }
  return (void*)a == (void*)b;
  ```)

;;; Eq [Cons] -- element-wise equality using the element type's Eq instance.
;; TC1-9: Phase PTC4 -- constrained Eq instance for List[A] (Cons cells).
;; Note: element comparison uses integer equality; correct for all primitive A.
(definstance Eq [Cons] [(Eq A)]
  (eq? [x y] (list-eq? x y (fn [a b] (= a b)))))

;;; list -- construct a list from N values via nested tcons.
;;;
;;; Parameters:
;;;   & xs -- zero or more values
;;;
;;; Returns:
;;;   The right-folded (tcons ... (tnil)) chain, typed as :int (the raw
;;;   carrier that tcons/tnil produce). Suitable as input to list-length,
;;;   list-eq?, and the rest of the :int-taking list API. For typed
;;;   (Cons A) cells (consumable by thead/ttail), build via make-struct
;;;   Cons with an explicit (:: ... (Cons A)) annotation.
;;;
;;; Example:
;;;   (list)        ; => (tnil)
;;;   (list 1 2 3)  ; => (tcons 1 (tcons 2 (tcons 3 (tnil))))
;;;
;;; Since: List literal macro
(defmacro list [& xs]
  (if (empty? xs)
    (list tnil)
    (list tcons (first xs) (list list ~@(rest xs)))))
