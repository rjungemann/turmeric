;;; Show [Cons] -- show a non-empty list as "[v1, v2, ...]".
;; x is the first Cons cell (struct value). Follows next pointers to build
;; the full list string. Values are formatted as integers (%lld).
;; TODO: use scratch arena once arena infrastructure lands.
(definstance Show [Cons]
  (show [x] :cstr
    ```c
    typedef struct { int64_t value; int64_t next; } Cons_;
    // Count elements
    size_t count = 1;
    Cons_ *cur = (Cons_ *)(intptr_t)x.next;
    while (cur) { count++; cur = (Cons_ *)(intptr_t)cur->next; }
    // Allocate: "[" + count*(21+2) + "]" + NUL
    size_t bufsize = 2 + count * 24 + 2;
    char *buf = (char *)malloc(bufsize);
    size_t pos = 0;
    buf[pos++] = '[';
    int bytes = snprintf(buf + pos, bufsize - pos, "%lld", (long long)x.value);
    pos += (size_t)bytes;
    cur = (Cons_ *)(intptr_t)x.next;
    while (cur && pos + 26 < bufsize) {
        buf[pos++] = ','; buf[pos++] = ' ';
        bytes = snprintf(buf + pos, bufsize - pos, "%lld", (long long)cur->value);
        pos += (size_t)bytes;
        cur = (Cons_ *)(intptr_t)cur->next;
    }
    buf[pos++] = ']';
    buf[pos] = '\0';
    return (const char *)(intptr_t)buf;
    ```))

;; Phase B1: Clone instance for Cons
;; Requires the Clone typeclass to already be in scope (from stdlib/typeclass.tur).
;; Shallow-copies a single Cons cell into a new heap allocation (does NOT recursively
;; clone the tail -- use clone-list for a deep list clone).
;; x has type Cons (struct value) inside the generated C method.
;;; Typeclass instance for Cons -- shallow Clone for a single Cons cell.
(definstance Clone [Cons]
  (clone [x] :int
    ```c
    struct { int64_t value; int64_t next; } *dst = malloc(sizeof(Cons));
    dst->value = x.value;
    dst->next  = x.next;
    return (int64_t)(intptr_t)dst;
    ```))

