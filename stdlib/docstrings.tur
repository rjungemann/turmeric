;; AUTO-GENERATED -- do not edit. Run: just docs
(defmodule tur/docstrings
  (export doc-lookup)

(defn doc-lookup [name :cstr] :cstr
  ```c
  static const struct { const char *key; const char *val; } entries[] = {
    {"__arrow_call1", "__arrow_call1 -- call a function stored as int64 with one argument."},
    {"__arrow_call2", "__arrow_call2 -- call a function stored as int64 with two arguments."},
    {"Arrow", "Arrow instance for plain functions (->)."},
    {"ArrowChoice", "ArrowChoice instance for plain functions (->)."},
    {"ArrowZero", "ArrowZero instance for plain functions (->)."},
    {"ArrowPlus", "ArrowPlus instance for plain functions (->)."},
    {"ArrowLoop", "ArrowLoop instance for plain functions (->)."},
    {"ArrowApply", "ArrowApply instance for plain functions (->)."},
    {"arr", "arr -- lift a function to an arrow (identity for function arrows).\n\nParameters:\n  f -- the function to lift\n\nExample:\n  The function itself.\n  \n    (arr (fn [x] (+ x 1)))  ; => identity for functions"},
    {">>>", ">>> -- compose two function arrows sequentially.\n\nParameters:\n  f -- first arrow (a -> b)\n  g -- second arrow (b -> c)\n\nExample:\n  A function (a -> c) that applies f then g.\n  \n    ((>>> (fn [x] (+ x 1)) (fn [x] (* x 2))) 3)  ; => 8"},
    {"arrow-first", "arrow-first -- apply a function to the first component of a Pair.\n\nParameters:\n  f -- function to apply\n\nExample:\n  A function on Pair that applies f to the first field.\n  \n    ((arrow-first (fn [x] (+ x 1))) (Pair 5 10))  ; => Pair(6, 10)"},
    {"arrow-second", "arrow-second -- apply a function to the second component of a Pair.\n\nParameters:\n  f -- function to apply\n\nExample:\n  A function on Pair that applies f to the second field.\n  \n    ((arrow-second (fn [x] (+ x 1))) (Pair 5 10))  ; => Pair(5, 11)"},
    {"arrow-id", "arrow-id -- identity arrow for any Arrow instance.\n\nParameters:\n  ^arr -- the arrow type constructor\n  a -- the type parameter\n\nExample:\n  An arrow that passes its input unchanged.\n  \n    (arrow-id)  ; => arr (fn [x] x)"},
    {"arrow-comp", "arrow-comp -- compose two arrows sequentially.\n\nParameters:\n  ^arr -- the arrow type constructor\n  f -- first arrow (a -> b)\n  g -- second arrow (b -> c)\n\nExample:\n  An arrow (a -> c) that applies f then g.\n  \n    (arrow-comp f g)  ; => f >>> g"},
    {"par-comp", "par-comp -- parallel composition of two functions on Pair types.\n\nParameters:\n  f -- function a -> b\n  g -- function c -> d\n\nExample:\n  A function on Pair a c -> Pair b d: (par-comp f g)(Pair x y) = Pair(f x, g y).\n  \n    ((par-comp inc double) (Pair 1 2))  ; => Pair(2, 4)"},
    {"arrow-split", "arrow-split -- duplicate input and apply two functions, returning a Pair.\n\nParameters:\n  f -- function a -> b\n  g -- function a -> c\n\nExample:\n  A function a -> Pair b c: (arrow-split f g)(x) = Pair(f x, g x).\n  \n    ((arrow-split inc double) 3)  ; => Pair(4, 6)"},
    {"<<<", "<<< -- compose two function arrows in reverse order.\n\nParameters:\n  g -- second arrow (b -> c), applied second\n  f -- first arrow (a -> b), applied first\n\nSince: Phase B2"},
    {"arrow-const", "arrow-const -- arrow that ignores its input and always returns v.\n\nParameters:\n  v -- the constant value to return\n\nSince: Phase B2"},
    {"arrow-dup", "arrow-dup -- arrow that duplicates its input into a Pair.\n\nParameters:\n  x -- the value to duplicate\n\nSince: Phase B2"},
    {"async-file-open", "async-file-open -- open a file with O_NONBLOCK and return its file descriptor.\n\nParameters:\n  path -- filesystem path to the file\n  flags -- 0 = O_RDONLY, 1 = O_WRONLY|O_CREAT|O_TRUNC, 2 = O_RDWR\n\nSince: Phase T24"},
    {"async-file-read", "async-file-read -- read up to buf-size bytes from a non-blocking file descriptor.\n\nParameters:\n  fd -- file descriptor returned by async-file-open\n  buf-size -- maximum number of bytes to read\n\nSince: Phase T24"},
    {"async-file-write", "async-file-write -- write len bytes from data to a non-blocking file descriptor.\n\nParameters:\n  fd -- file descriptor returned by async-file-open\n  data -- pointer to the bytes to write\n  len -- number of bytes to write\n\nSince: Phase T24"},
    {"async-file-close", "async-file-close -- close a file descriptor and unregister it from IO polling.\n\nParameters:\n  fd -- file descriptor to close\n\nSince: Phase T24"},
    {"async-file-read-buf", "async-file-read-buf -- retrieve the buffer pointer from the last async-file-read call.\n\nSince: Phase T24"},
    {"async-file-read-len", "async-file-read-len -- retrieve the byte count from the last async-file-read call.\n\nSince: Phase T24"},
    {"async-read-stdin", "async-read-stdin -- read up to buf-size bytes from stdin in non-blocking mode.\n\nParameters:\n  buf-size -- maximum number of bytes to read\n\nSince: Phase T24"},
    {"async-stdin-buf", "async-stdin-buf -- retrieve the buffer pointer from the last async-read-stdin call.\n\nSince: Phase T24"},
    {"async-stdin-len", "async-stdin-len -- retrieve the byte count from the last async-read-stdin call.\n\nSince: Phase T24"},
    {"async-write-stdout", "async-write-stdout -- write len bytes from data to stdout in non-blocking mode.\n\nParameters:\n  data -- pointer to the bytes to write\n  len -- number of bytes to write\n\nSince: Phase T24"},
    {"async-socket-listen", "async-socket-listen -- create a non-blocking TCP listening socket on the given port.\n\nParameters:\n  port -- TCP port number to bind and listen on\n  backlog -- maximum length of the pending connection queue\n\nSince: Phase T24"},
    {"async-socket-accept", "async-socket-accept -- accept an incoming connection, parking the fiber until one arrives.\n\nParameters:\n  listen-fd -- listening file descriptor returned by async-socket-listen\n\nSince: Phase T24"},
    {"async-socket-connect", "async-socket-connect -- connect to a TCP server at host:port, parking the fiber until complete.\n\nParameters:\n  host -- IPv4 address string (e.g. \"127.0.0.1\")\n  port -- TCP port number to connect to\n\nSince: Phase T24"},
    {"async-socket-send", "async-socket-send -- send data on a connected socket, parking the fiber on EAGAIN.\n\nParameters:\n  fd -- connected socket file descriptor\n  data -- pointer to the bytes to send\n  len -- number of bytes to send\n\nSince: Phase T24"},
    {"async-socket-recv", "async-socket-recv -- receive up to buf-size bytes from a connected socket.\n\nParameters:\n  fd -- connected socket file descriptor\n  buf-size -- maximum number of bytes to receive\n\nSince: Phase T24"},
    {"async-socket-recv-buf", "async-socket-recv-buf -- retrieve the buffer pointer from the last async-socket-recv call.\n\nSince: Phase T24"},
    {"async-socket-recv-len", "async-socket-recv-len -- retrieve the byte count from the last async-socket-recv call.\n\nSince: Phase T24"},
    {"async-socket-close", "async-socket-close -- close a socket and unregister it from IO polling.\n\nParameters:\n  fd -- socket file descriptor to close\n\nSince: Phase T24"},
    {"atomic-new", "atomic-new -- allocate a heap-based atomic int64 cell initialised to init.\n\nParameters:\n  init -- initial integer value stored in the cell\n\nSince: Phase T19"},
    {"atomic-load", "atomic-load -- atomically read the current value of the cell.\n\nParameters:\n  p -- atomic cell pointer from atomic-new\n\nSince: Phase T19"},
    {"atomic-store!", "atomic-store! -- atomically write v into the cell.\n\nParameters:\n  p -- atomic cell pointer from atomic-new\n  v -- new value to store\n\nSince: Phase T19"},
    {"atomic-add!", "atomic-add! -- atomically add delta and return the old value.\n\nParameters:\n  p -- atomic cell pointer from atomic-new\n  delta -- amount to add (may be negative)\n\nSince: Phase T19"},
    {"atomic-sub!", "atomic-sub! -- atomically subtract delta and return the old value.\n\nParameters:\n  p -- atomic cell pointer from atomic-new\n  delta -- amount to subtract\n\nSince: Phase T19"},
    {"atomic-swap!", "atomic-swap! -- atomically replace the cell value with new-val and return the old value.\n\nParameters:\n  p -- atomic cell pointer from atomic-new\n  new-val -- value to store\n\nSince: Phase T19"},
    {"atomic-cas!", "atomic-cas! -- compare-and-swap: if cell == expected, set to desired and return true.\n\nParameters:\n  p -- atomic cell pointer from atomic-new\n  expected -- value to compare against\n  desired -- value to store if comparison succeeds\n\nSince: Phase T19"},
    {"atomic-free", "atomic-free -- free an atomic cell allocated by atomic-new.\n\nParameters:\n  p -- atomic cell pointer from atomic-new\n\nSince: Phase T19"},
    {"bt-nil", "-- Helpers ────────────────────────────────────────────────────────────────\n\nReturns:\n  0 (null pointer representing the empty list)."},
    {"bt-cons", "bt-cons -- prepend a value to a backtrack result list.\n\nParameters:\n  v -- the value to prepend\n  next -- pointer to the existing result list (:int)\n\nReturns:\n  Pointer to the new cell (:int)."},
    {"mzero", "-- Core monad operations ──────────────────────────────────────────────────\n\nExample:\n  An empty result list (:int null pointer).\n  \n    (mzero)  ; => 0"},
    {"mreturn", "mreturn -- lift a single value into the backtrack monad.\n\nParameters:\n  x -- the value to return\n\nExample:\n  A singleton result list containing x (:int).\n  \n    (mreturn 42)  ; => list containing 42"},
    {"mplus", "mplus -- concatenate (union) two backtrack result lists.\n\nParameters:\n  xs -- first result list (:int)\n  ys -- second result list (:int)\n\nExample:\n  A new result list with all elements from xs followed by all from ys (:int).\n  \n    (mplus (mreturn 1) (mreturn 2))  ; => list [1, 2]"},
    {"mbind", "mbind -- concatMap: apply fn to each result and concatenate all outputs.\n\nParameters:\n  ma -- a backtrack result list (:int)\n  fn -- fat closure of type (a -> Backtrack b)\n\nExample:\n  The concatenated results of applying fn to each element of ma (:int).\n  \n    (mbind (mreturn 3) (fn [x] (mreturn (* x 2))))  ; => list [6]"},
    {"run-backtrack", "-- Run operations ─────────────────────────────────────────────────────────\n\nParameters:\n  xs -- a backtrack result list (:int)\n\nExample:\n  The same result list (the list monad is already eager) (:int).\n  \n    (run-backtrack (mreturn 1))  ; => list [1]"},
    {"run-backtrack-depth", "run-backtrack-depth -- return at most n results from a backtrack computation.\n\nParameters:\n  xs -- a backtrack result list (:int)\n  n -- maximum number of results to return (:int)\n\nExample:\n  A truncated result list of length at most n (:int).\n  \n    (run-backtrack-depth my-results 5)  ; => first 5 results"},
    {"choice", "-- Combinators ────────────────────────────────────────────────────────────\n\nParameters:\n  xs -- a backtrack result list (:int)\n\nReturns:\n  xs unchanged (:int)."},
    {"guard", "guard -- succeed with a dummy value when pred is true, fail otherwise.\n\nParameters:\n  pred -- boolean condition\n\nExample:\n  (mreturn 0) if pred is true, (mzero) otherwise (:int).\n  \n    (guard (> x 0))  ; => mreturn 0 or mzero"},
    {"fresh", "fresh -- apply a fat closure to a fresh variable placeholder (0).\n\nParameters:\n  f -- fat closure of type (a -> Backtrack b)\n\nReturns:\n  The result of applying f to the placeholder 0 (:int)."},
    {"once", "once -- keep only the first result from a backtrack computation.\n\nParameters:\n  xs -- a backtrack result list (:int)\n\nExample:\n  A singleton list containing the first element, or empty if xs is empty (:int).\n  \n    (once (mplus (mreturn 1) (mreturn 2)))  ; => list [1]"},
    {"interleave", "interleave -- fair interleaving of two backtrack result lists.\n\nParameters:\n  xs -- first result list (:int)\n  ys -- second result list (:int)\n\nExample:\n  A new list that alternates elements from xs and ys (:int).\n  \n    (interleave (mreturn 1) (mreturn 2))  ; => list [1, 2] (interleaved)"},
    {"bt-length", "-- List utilities ─────────────────────────────────────────────────────────\n\nParameters:\n  xs -- a backtrack result list (:int)\n\nExample:\n  The number of elements (:int).\n  \n    (bt-length (mplus (mreturn 1) (mreturn 2)))  ; => 2"},
    {"bt-print", "bt-print -- print each value in a backtrack result list to stdout.\n\nParameters:\n  xs -- a backtrack result list (:int)"},
    {"__bt-do", "-- backtrack-do macro ─────────────────────────────────────────────────────"},
    {"backtrack-do", "backtrack-do -- monadic do-notation for the backtracking monad.\n\nParameters:\n  forms -- alternating variable names and monadic expressions, then a body\n\nExample:\n  A backtrack computation (result list) (:int).\n  \n    (backtrack-do x (mplus (mreturn 1) (mreturn 2))\n                  y (mplus (mreturn 10) (mreturn 20))\n                  (mreturn (+ x y)))  ; => list [11, 21, 12, 22]"},
    {"FileSystem-type", "FileSystem-type -- return NULL; declares the FileSystem struct typedef for inline C blocks.\n\nSince: Phase 16"},
    {"make-FileSystem", "make-FileSystem -- construct a FileSystem capability from four function pointers.\n\nParameters:\n  read_fn -- (path buf buf_len out_len) -> int\n  write_fn -- (path data data_len) -> int\n  delete_fn -- (path) -> int\n  list_fn -- (path entries max_entries out_count) -> int\n\nSince: Phase 16"},
    {"FileSystem-free", "FileSystem-free -- free a FileSystem capability allocated by make-FileSystem.\n\nParameters:\n  fs -- FileSystem pointer from make-FileSystem\n\nSince: Phase 16"},
    {"Logger-type", "Logger-type -- return NULL; declares the Logger struct typedef for inline C blocks.\n\nSince: Phase 16"},
    {"make-Logger", "make-Logger -- construct a Logger capability from four function pointers (debug/info/warn/error).\n\nParameters:\n  debug_fn -- (msg: cstr) -> void\n  info_fn -- (msg: cstr) -> void\n  warn_fn -- (msg: cstr) -> void\n  error_fn -- (msg: cstr) -> void\n\nSince: Phase 16"},
    {"Logger-free", "Logger-free -- free a Logger capability allocated by make-Logger.\n\nParameters:\n  log -- Logger pointer from make-Logger\n\nSince: Phase 16"},
    {"Random-type", "Random-type -- return NULL; declares the Random struct typedef for inline C blocks.\n\nSince: Phase 16"},
    {"make-Random", "make-Random -- construct a Random capability from two function pointers.\n\nParameters:\n  next_int_fn -- (min max) -> int; returns integer in [min, max]\n  next_float_fn -- () -> int; returns value in [0, 10000) representing a float\n\nSince: Phase 16"},
    {"Random-free", "Random-free -- free a Random capability allocated by make-Random.\n\nParameters:\n  rng -- Random pointer from make-Random\n\nSince: Phase 16"},
    {"Time-type", "Time-type -- return NULL; declares the Time struct typedef for inline C blocks.\n\nSince: Phase 16"},
    {"make-Time", "make-Time -- construct a Time capability from two function pointers.\n\nParameters:\n  now_fn -- () -> int; returns current time in milliseconds since epoch\n  sleep_fn -- (ms: int) -> void; sleeps for ms milliseconds\n\nSince: Phase 16"},
    {"Time-free", "Time-free -- free a Time capability allocated by make-Time.\n\nParameters:\n  t -- Time pointer from make-Time\n\nSince: Phase 16"},
    {"with-capability", "with-capability -- bind cap_expr to binding and evaluate body with that capability in scope.\n\nParameters:\n  binding -- name to bind the capability to\n  cap_expr -- expression producing the capability\n  body -- expression to evaluate with binding in scope\n\nSince: Phase 16"},
    {"default-capability", "default-capability -- return the default implementation for a capability type (currently always nil).\n\nParameters:\n  type_name -- symbolic name of the capability type (unused in v1)\n\nSince: Phase 16"},
    {"fs-read", "fs-read -- call read_file on a FileSystem capability.\n\nParameters:\n  fs -- FileSystem capability pointer\n  path -- file path to read\n  buf -- output buffer pointer\n  buf_len -- size of buf in bytes\n\nSince: Phase 16"},
    {"fs-write", "fs-write -- call write_file on a FileSystem capability.\n\nParameters:\n  fs -- FileSystem capability pointer\n  path -- file path to write\n  data -- data buffer pointer\n  data_len -- number of bytes to write\n\nSince: Phase 16"},
    {"fs-delete", "fs-delete -- call delete on a FileSystem capability.\n\nParameters:\n  fs -- FileSystem capability pointer\n  path -- path of the file to delete\n\nSince: Phase 16"},
    {"fs-list", "fs-list -- call list on a FileSystem capability.\n\nParameters:\n  fs -- FileSystem capability pointer\n  path -- directory path to list\n  entries -- output buffer for entry name pointers\n  max_entries -- capacity of entries buffer\n\nSince: Phase 16"},
    {"log-debug", "log-debug -- emit a debug-level log message via a Logger capability.\n\nParameters:\n  log -- Logger capability pointer\n  msg -- message string to log\n\nSince: Phase 16"},
    {"log-info", "log-info -- emit an info-level log message via a Logger capability.\n\nParameters:\n  log -- Logger capability pointer\n  msg -- message string to log\n\nSince: Phase 16"},
    {"log-warn", "log-warn -- emit a warning-level log message via a Logger capability.\n\nParameters:\n  log -- Logger capability pointer\n  msg -- message string to log\n\nSince: Phase 16"},
    {"log-error", "log-error -- emit an error-level log message via a Logger capability.\n\nParameters:\n  log -- Logger capability pointer\n  msg -- message string to log\n\nSince: Phase 16"},
    {"rng-next-int", "rng-next-int -- return a random integer in [min, max] from a Random capability.\n\nParameters:\n  rng -- Random capability pointer\n  min -- inclusive lower bound\n  max -- inclusive upper bound\n\nSince: Phase 16"},
    {"rng-next-float", "rng-next-float -- return a random pseudo-float in [0, 10000) from a Random capability.\n\nParameters:\n  rng -- Random capability pointer\n\nSince: Phase 16"},
    {"time-now", "time-now -- return the current time in milliseconds since epoch from a Time capability.\n\nParameters:\n  t -- Time capability pointer\n\nSince: Phase 16"},
    {"time-sleep", "time-sleep -- sleep for ms milliseconds via a Time capability.\n\nParameters:\n  t -- Time capability pointer\n  ms -- duration in milliseconds\n\nSince: Phase 16"},
    {"chan-new", "chan-new -- allocate a new synchronous blocking channel with the given capacity.\n\nParameters:\n  cap -- ring-buffer capacity (number of int64_t slots)\n\nSince: Phase T19-C"},
    {"chan-send", "chan-send -- send a value into a synchronous channel, blocking when full.\n\nParameters:\n  ch -- channel handle returned by chan-new\n  val -- int64_t value to enqueue\n\nSince: Phase T19-C"},
    {"chan-recv", "chan-recv -- receive a value from a synchronous channel, blocking when empty.\n\nParameters:\n  ch -- channel handle returned by chan-new\n\nSince: Phase T19-C"},
    {"chan-free", "chan-free -- destroy a synchronous channel and release all associated memory.\n\nParameters:\n  ch -- channel handle returned by chan-new\n\nSince: Phase T19-C"},
    {"async-chan-new", "async-chan-new -- allocate a new async buffered channel with the given capacity.\n\nParameters:\n  cap -- ring-buffer capacity (number of int64_t slots)\n\nSince: Phase T19-D"},
    {"async-chan-send", "async-chan-send -- send a value into an async channel, blocking when full.\n\nParameters:\n  ch -- channel handle returned by async-chan-new\n  val -- int64_t value to enqueue\n\nSince: Phase T19-D"},
    {"async-chan-recv", "async-chan-recv -- receive a value from an async channel, blocking when empty.\n\nParameters:\n  ch -- channel handle returned by async-chan-new\n\nSince: Phase T19-D"},
    {"async-chan-try-send", "async-chan-try-send -- attempt to send a value without blocking.\n\nParameters:\n  ch -- channel handle returned by async-chan-new\n  val -- int64_t value to enqueue\n\nSince: Phase T19-D"},
    {"async-chan-try-recv", "async-chan-try-recv -- attempt to receive a value without blocking.\n\nParameters:\n  ch -- channel handle returned by async-chan-new\n\nSince: Phase T19-D"},
    {"async-chan-count", "async-chan-count -- return the number of items currently in an async channel.\n\nParameters:\n  ch -- channel handle returned by async-chan-new\n\nSince: Phase T19-D"},
    {"async-chan-free", "async-chan-free -- destroy an async channel and release all associated memory.\n\nParameters:\n  ch -- channel handle returned by async-chan-new\n\nSince: Phase T19-D"},
    {"__identity_new", "__identity_new -- allocate a new Identity comonad cell wrapping x."},
    {"__identity_get", "__identity_get -- read the value stored in an Identity comonad cell."},
    {"__identity_extract", "__identity_extract -- extract the value from an Identity comonad cell."},
    {"__identity_extend", "__identity_extend -- apply fn to the Identity cell and wrap the result."},
    {"__identity_duplicate", "__identity_duplicate -- wrap an Identity cell inside another Identity cell."},
    {"Comonad", "Comonad [identity] -- Comonad instance for the Identity comonad."},
    {"__pair_new", "__pair_new -- allocate a new Pair comonad cell with environment and value."},
    {"__pair_env", "__pair_env -- read the environment component of a Pair comonad cell."},
    {"__pair_val", "__pair_val -- read the value component of a Pair comonad cell."},
    {"__pair_extract", "__pair_extract -- extract the value from a Pair comonad cell."},
    {"__pair_extend", "__pair_extend -- extend over a Pair cell: (e, a) -> (e, f (e, a))."},
    {"__pair_duplicate", "__pair_duplicate -- duplicate a Pair cell: (e, a) -> (e, (e, a))."},
    {"condvar-new", "condvar-new -- allocate and initialise a new POSIX condition variable.\n\nSince: Phase T19-C"},
    {"condvar-wait", "condvar-wait -- atomically release the mutex and wait for a signal on the condition variable.\n\nParameters:\n  c -- condvar handle returned by condvar-new\n  m -- mutex handle (from mutex-new) that the caller already holds\n\nSince: Phase T19-C"},
    {"condvar-signal", "condvar-signal -- wake one thread waiting on the condition variable.\n\nParameters:\n  c -- condvar handle returned by condvar-new\n\nSince: Phase T19-C"},
    {"condvar-broadcast", "condvar-broadcast -- wake all threads waiting on the condition variable.\n\nParameters:\n  c -- condvar handle returned by condvar-new\n\nSince: Phase T19-C"},
    {"condvar-free", "condvar-free -- destroy the condition variable and release its memory.\n\nParameters:\n  c -- condvar handle returned by condvar-new\n\nSince: Phase T19-C"},
    {"contract-enabled?", "contract-enabled? -- returns true when contracts are enabled at runtime.\n\nSince: Phase C1"},
    {"tur-contract-check", "tur-contract-check -- internal helper called by contract macros.\n\nParameters:\n   -- condition :bool -- the boolean result to check\n   -- msg :cstr       -- the panic message to emit if condition is false"},
    {"tur-contract-check-inv", "tur-contract-check-inv -- internal helper for invariant macros.\n\nParameters:\n   -- obj :int  -- the value to pass to the predicate (encoded as :int)\n   -- pred :int -- the predicate function pointer (encoded as :int)\n   -- msg :cstr -- the panic message to emit if the predicate returns false"},
    {"assert!", "assert! -- unconditional sanity check, panics with \"Assertion failed\" if false.\n\nParameters:\n  condition -- the boolean expression to check\n\nSince: Phase C1"},
    {"assert-msg!", "assert-msg! -- unconditional sanity check with custom panic message.\n\nParameters:\n  condition -- the boolean expression to check\n  msg -- the message string to use when panicking\n\nSince: Phase C1"},
    {"require!", "require! -- precondition check at function entry, panics with \"Precondition failed\" if false.\n\nParameters:\n  condition -- the boolean precondition to enforce\n\nSince: Phase C1"},
    {"require-msg!", "require-msg! -- precondition check with custom panic message.\n\nParameters:\n  condition -- the boolean precondition to enforce\n  msg -- the message string to use when panicking\n\nSince: Phase C1"},
    {"ensure!", "ensure! -- postcondition check, panics with \"Postcondition failed\" if false.\n\nParameters:\n  condition -- the boolean postcondition to enforce\n\nSince: Phase C1"},
    {"ensure-msg!", "ensure-msg! -- postcondition check with custom panic message.\n\nParameters:\n  condition -- the boolean postcondition to enforce\n  msg -- the message string to use when panicking\n\nSince: Phase C1"},
    {"invariant!", "invariant! -- check a structural invariant on a value, panics with \"Invariant failed\" if false.\n\nParameters:\n  obj -- the value to check\n  predicate -- a single-argument function that returns true if the invariant holds\n\nSince: Phase C1"},
    {"invariant-msg!", "invariant-msg! -- check a structural invariant with custom panic message.\n\nParameters:\n  obj -- the value to check\n  predicate -- a single-argument function that returns true if the invariant holds\n  msg -- the message string to use when panicking\n\nSince: Phase C1"},
    {"with-write", "with-write -- handle the Write effect by printing to stdout via println.\n\nParameters:\n  body -- the expression whose Write effects are handled\n\nSince: Phase 19"},
    {"with-fail-panic", "with-fail-panic -- handle the Fail effect by panicking with the message.\n\nParameters:\n  body -- the expression whose Fail effects are handled\n\nSince: Phase 19"},
    {"with-getenv", "with-getenv -- handle the GetEnv effect by delegating to C getenv(3).\n\nParameters:\n  body -- the expression whose GetEnv effects are handled\n\nSince: Phase 19"},
    {"read-int-console", "read-int-console -- read a single integer from stdin via scanf.\n\nSince: Phase 19"},
    {"with-read-console", "with-read-console -- handle the Read effect by reading an integer from stdin.\n\nParameters:\n  body -- the expression whose Read effects are handled\n\nSince: Phase 19"},
    {"with-stderr-log", "with-stderr-log -- handle the Log effect by printing all messages to stdout.\n\nParameters:\n  body -- the expression whose Log effects are handled\n\nSince: Phase 19"},
    {"with-silent-log", "with-silent-log -- handle the Log effect by suppressing all log output.\n\nParameters:\n  body -- the expression whose Log effects are handled\n\nSince: Phase 19"},
    {"with-abort-panic", "with-abort-panic -- handle the Abort effect by panicking with the message.\n\nParameters:\n  body -- the expression whose Abort effects are handled\n\nSince: Phase 19"},
    {"with-async", "with-async -- handle the Async effect by running the thunk and resuming with its result.\n\nParameters:\n  body -- the expression whose Async effects are handled\n\nSince: Phase T25"},
    {"with-await", "with-await -- handle the Await effect by blocking until the future resolves.\n\nParameters:\n  body -- the expression whose Await effects are handled\n\nSince: Phase T25"},
    {"equal-sym", "equal-sym"},
    {"equal-trans", "equal-trans"},
    {"fiber-new", "fiber-new -- create a new fiber from a function pointer and an optional stack size.\n\nParameters:\n  fn -- zero-argument function pointer to run as the fiber body\n  stack-size -- requested stack size in bytes; 0 uses the default size\n\nSince: Phase T21-C"},
    {"fiber-resume", "fiber-resume -- resume a suspended fiber, passing it a value, and return the yielded or final value.\n\nParameters:\n  f -- fiber handle returned by fiber-new\n  arg -- value passed to the fiber as the resume argument\n\nSince: Phase T21-C"},
    {"fiber-yield", "fiber-yield -- suspend the current fiber and return a value to its caller.\n\nParameters:\n  value -- int64_t value to hand back to the fiber-resume caller\n\nSince: Phase T21-C"},
    {"fiber-done?", "fiber-done? -- check whether a fiber has run to completion.\n\nParameters:\n  f -- fiber handle returned by fiber-new\n\nSince: Phase T21-C"},
    {"fiber-arg", "fiber-arg -- retrieve the most recent argument value passed to a fiber via fiber-resume.\n\nParameters:\n  f -- fiber handle returned by fiber-new\n\nSince: Phase T21-C"},
    {"fiber-free", "fiber-free -- release all memory associated with a fiber.\n\nParameters:\n  f -- fiber handle returned by fiber-new\n\nSince: Phase T21-C"},
    {"fiber-local-get", "fiber-local-get -- retrieve a fiber-local value by key from a specific fiber.\n\nParameters:\n  f -- fiber handle returned by fiber-new\n  key -- int64_t key identifying the slot\n\nSince: Phase T21"},
    {"fiber-local-set!", "fiber-local-set! -- store a fiber-local value by key in a specific fiber.\n\nParameters:\n  f -- fiber handle returned by fiber-new\n  key -- int64_t key identifying the slot\n  value -- int64_t value to store\n\nSince: Phase T21"},
    {"fiber-local-current-get", "fiber-local-current-get -- retrieve a fiber-local value by key from the currently running fiber.\n\nParameters:\n  key -- int64_t key identifying the slot\n\nSince: Phase T21"},
    {"fiber-local-current-set!", "fiber-local-current-set! -- store a fiber-local value by key in the currently running fiber.\n\nParameters:\n  key -- int64_t key identifying the slot\n  value -- int64_t value to store\n\nSince: Phase T21"},
    {"scheduler-yield!", "scheduler-yield! -- yield the current fiber back to the scheduler, re-enqueueing it for the next turn.\n\nSince: Phase T21"},
    {"scheduler-park!", "scheduler-park! -- park the current fiber, suspending it without re-enqueueing.\n\nSince: Phase T21"},
    {"scheduler-unpark!", "scheduler-unpark! -- unpark a specific fiber and add it back to the scheduler run queue.\n\nParameters:\n  f -- fiber handle to unpark\n\nSince: Phase T21"},
    {"async-sleep", "async-sleep -- sleep for approximately ms milliseconds without blocking the OS thread.\n\nParameters:\n  ms -- duration in milliseconds; values <= 0 return immediately\n\nSince: Phase T24"},
    {"fiber-thread-id", "fiber-thread-id -- return an integer identifier for the OS thread running the current fiber.\n\nSince: Phase T23"},
    {"roll", "roll -- wrap one layer of f into a Fix value.\n\nParameters:\n  layer -- a value of type (f (Fix f))\n\nSince: Phase RF2"},
    {"unroll", "unroll -- unwrap one layer of Fix to expose the inner functor value.\n\nParameters:\n  fix -- a Fix value\n\nSince: Phase RF2"},
    {"cata", "cata -- catamorphism: fold a Fix value using an F-algebra.\n\nParameters:\n  alg -- a fat-closure (function from (f a) to a) stored as :int\n  fix -- a Fix value to fold\n\nSince: Phase RF2"},
    {"ana", "ana -- anamorphism: unfold a seed value into a Fix value using a co-algebra.\n\nParameters:\n  coalg -- a fat-closure (function from a to (f a)) stored as :int\n  seed -- the initial seed value\n\nSince: Phase RF2"},
    {"free-pure", "free-pure -- lift a pure value into the Free monad.\n\nParameters:\n  x -- the value to lift\n\nSince: Phase RF3"},
    {"free-lift", "free-lift -- lift one layer of f into Free.\n\nParameters:\n  fx -- a value of type (f a), where a is the \"next step\" value\n\nSince: Phase RF3"},
    {"free-bind", "free-bind -- monadic bind for Free.\n\nParameters:\n  ma -- a Free value\n  kont -- a fat-closure from a to (Free f b), stored as :int\n\nSince: Phase RF3"},
    {"free-fmap", "free-fmap -- functor map for Free: apply a function to all pure leaves.\n\nParameters:\n  free -- a Free value\n  f -- a fat-closure from a to b, stored as :int\n\nSince: Phase RF3"},
    {"free-run", "free-run -- interpret a Free computation with a natural transformation.\n\nParameters:\n  interp -- a fat-closure from (f a) to a, stored as :int\n  free -- a Free computation to run\n\nSince: Phase RF3"},
    {"future-cell-new", "future-cell-new -- allocate and initialise a shared FutureCell (mutex, condvar, unset).\n\nSince: Phase T20-C"},
    {"future-cell-free", "future-cell-free -- destroy the mutex/condvar and free a FutureCell.\n\nParameters:\n  cell -- FutureCell pointer from future-cell-new\n\nSince: Phase T20-C"},
    {"promise-new", "promise-new -- allocate a new unsettled Promise/Future shared cell.\n\nSince: Phase T20-C"},
    {"promise-of-cell", "promise-of-cell -- return the Promise handle for a FutureCell (identity; for API symmetry).\n\nParameters:\n  cell -- FutureCell pointer from promise-new\n\nSince: Phase T20-C"},
    {"future-of-cell", "future-of-cell -- return the Future handle for a FutureCell (identity; for API symmetry).\n\nParameters:\n  cell -- FutureCell pointer from promise-new\n\nSince: Phase T20-C"},
    {"promise-pair", "promise-pair -- expand to a (Promise Future) pair list from a single shared cell.\n\nParameters:\n  cell -- FutureCell pointer from promise-new\n\nSince: Phase T20-C"},
    {"promise-fulfill", "promise-fulfill -- settle a promise with a successful value; wakes all future waiters.\n\nParameters:\n  p -- Promise (FutureCell) pointer\n  v -- fulfillment value\n\nSince: Phase T20-C"},
    {"promise-fail", "promise-fail -- settle a promise with an error code; wakes all future waiters.\n\nParameters:\n  p -- Promise (FutureCell) pointer\n  e -- error/exception code\n\nSince: Phase T20-C"},
    {"promise-free", "promise-free -- free a promise and its shared FutureCell.\n\nParameters:\n  p -- Promise pointer from promise-new\n\nSince: Phase T20-C"},
    {"future-done?", "future-done? -- non-blocking check: return true if the future has been settled.\n\nParameters:\n  f -- Future (FutureCell) pointer\n\nSince: Phase T20-C"},
    {"future-get", "future-get -- block until the future is settled; return a heap-allocated Result struct.\n\nParameters:\n  f -- Future (FutureCell) pointer\n\nSince: Phase T20-C"},
    {"future-free", "future-free -- free a future and its shared FutureCell.\n\nParameters:\n  f -- Future pointer from promise-new / future-of-cell\n\nSince: Phase T20-C"},
    {"future-of", "future-of -- create a pre-fulfilled future holding value v.\n\nParameters:\n  v -- value the future should carry\n\nSince: Phase T20-C"},
    {"future-error-of", "future-error-of -- create a pre-rejected future with error code e.\n\nParameters:\n  e -- error/exception code\n\nSince: Phase T20-C"},
    {"future-cancel", "future-cancel -- cancel a future if not yet settled; sets error code -2 (TUR_FUTURE_CANCELLED).\n\nParameters:\n  f -- Future (FutureCell) pointer\n\nSince: Phase T20-C"},
    {"future-cancelled?", "future-cancelled? -- return true if the future was cancelled (exn == -2).\n\nParameters:\n  f -- Future (FutureCell) pointer\n\nSince: Phase T20-C"},
    {"future-map", "future-map -- map fn over a fulfilled future value; propagate rejection unchanged.\n\nParameters:\n  f -- source Future pointer\n  fn -- function pointer (int64_t -> int64_t) applied to the fulfilled value\n\nSince: Phase T20-C"},
    {"future-then", "future-then -- flat-map fn over a future; fn must return a new Future ptr<void>.\n\nParameters:\n  f -- source Future pointer\n  fn -- function pointer (int64_t -> ptr<void>) producing the next Future\n\nSince: Phase T20-C"},
    {"future-race", "future-race -- race two futures; return a new future settled by whichever finishes first.\n\nParameters:\n  fa -- first Future pointer\n  fb -- second Future pointer\n\nSince: Phase T20-C"},
    {"future-all2", "future-all2 -- await both futures; settle ok with fa's value only if both succeed.\n\nParameters:\n  fa -- first Future pointer\n  fb -- second Future pointer\n\nSince: Phase T20-C"},
    {"future-any2", "future-any2 -- return a future settled by the first fulfilled future; both rejecting yields fb's error.\n\nParameters:\n  fa -- first Future pointer\n  fb -- second Future pointer\n\nSince: Phase T20-C"},
    {"future-join", "future-join -- await both futures and produce a new future holding a TurTuple2 of their values.\n\nParameters:\n  fa -- first Future pointer\n  fb -- second Future pointer\n\nSince: Phase T20-C"},
    {"tuple-first", "tuple-first -- read the first element of a TurTuple2 returned by future-join.\n\nParameters:\n  tup -- TurTuple2 pointer from the ok value of a future-join result\n\nSince: Phase T20-C"},
    {"tuple-second", "tuple-second -- read the second element of a TurTuple2 returned by future-join.\n\nParameters:\n  tup -- TurTuple2 pointer from the ok value of a future-join result\n\nSince: Phase T20-C"},
    {"tuple-free", "tuple-free -- free a TurTuple2 allocated by future-join.\n\nParameters:\n  tup -- TurTuple2 pointer to free\n\nSince: Phase T20-C"},
    {"promise-new-pair", "promise-new-pair -- allocate a new unsettled Promise/Future shared cell (alias for promise-new).\n\nSince: Phase T20-C"},
    {"future-race-n", "future-race-n -- race an array of n futures; return a new future settled by the first to finish.\n\nParameters:\n  futures -- pointer to an array of FutureCell* (ptr<void>[n])\n  n -- number of futures in the array\n\nSince: Phase T20-C"},
    {"future-all-n", "future-all-n -- await all n futures; settle ok (value 0) only if every future succeeds.\n\nParameters:\n  futures -- pointer to an array of FutureCell* (ptr<void>[n])\n  n -- number of futures in the array\n\nSince: Phase T20-C"},
    {"future-any-n", "future-any-n -- return a future settled by the first successfully fulfilled future in the array.\n\nParameters:\n  futures -- pointer to an array of FutureCell* (ptr<void>[n])\n  n -- number of futures in the array\n\nSince: Phase T20-C"},
    {"future-timeout", "future-timeout -- create a future that settles with error -1 after ms milliseconds.\n\nParameters:\n  ms -- timeout duration in milliseconds\n\nSince: Phase T20-C"},
    {"future-with-timeout", "future-with-timeout -- race a future against a timeout of ms milliseconds.\n\nParameters:\n  f -- source Future pointer\n  ms -- timeout in milliseconds; on expiry the result is rejected with exn = -1\n\nSince: Phase T20-C"},
    {"grid-new", "grid-new -- allocate a zero-filled width x height GridCtx; focus starts at (0, 0).\n\nParameters:\n  width -- number of columns\n  height -- number of rows\n\nSince: Phase CA2"},
    {"grid-get", "grid-get -- read the cell value at (x, y); returns 0 for out-of-bounds coordinates.\n\nParameters:\n  g -- GridCtx handle from grid-new\n  x -- column index (0-based)\n  y -- row index (0-based)\n\nSince: Phase CA2"},
    {"grid-set", "grid-set -- write val into cell (x, y) in-place; no-op if out of bounds.\n\nParameters:\n  g -- GridCtx handle from grid-new\n  x -- column index (0-based)\n  y -- row index (0-based)\n  val -- value to store\n\nSince: Phase CA2"},
    {"grid-focus", "grid-focus -- return the cell value at the current focus position (cx, cy).\n\nParameters:\n  g -- GridCtx handle from grid-new\n\nSince: Phase CA2"},
    {"grid-width", "grid-width -- return the number of columns in the grid.\n\nParameters:\n  g -- GridCtx handle from grid-new\n\nSince: Phase CA2"},
    {"grid-height", "grid-height -- return the number of rows in the grid.\n\nParameters:\n  g -- GridCtx handle from grid-new\n\nSince: Phase CA2"},
    {"grid-cx", "grid-cx -- return the current focus column index.\n\nParameters:\n  g -- GridCtx handle from grid-new\n\nSince: Phase CA2"},
    {"grid-cy", "grid-cy -- return the current focus row index.\n\nParameters:\n  g -- GridCtx handle from grid-new\n\nSince: Phase CA2"},
    {"grid-clone", "grid-clone -- deep-copy a grid, allocating a new GCtx and data array; cx/cy are preserved.\n\nParameters:\n  g -- GridCtx handle to clone\n\nSince: Phase CA2"},
    {"grid-count-neighbors", "grid-count-neighbors -- count live (non-zero) Moore 8-neighbours at the current focus.\n\nParameters:\n  g -- GridCtx handle; uses cx/cy as the center cell\n\nSince: Phase CA2"},
    {"grid-print", "grid-print -- print the grid to stdout as ASCII art ('#' = live, '.' = dead).\n\nParameters:\n  g -- GridCtx handle from grid-new\n\nSince: Phase CA2"},
    {"__gridctx_extend", "__gridctx_extend -- comonad extend: produce a new grid by applying fn to each focused sub-grid.\n\nParameters:\n  g -- source GridCtx handle\n  fn -- rule function: receives a focused GCtx pointer, returns the new cell value\n\nSince: Phase CA2"},
    {"hamt/new", "hamt/new -- create a new empty persistent HAMT.\n\nSince: Phase P1"},
    {"hamt/free", "hamt/free -- decrement the reference count of a HAMT; free if it reaches zero.\n\nParameters:\n  m -- HAMT pointer\n\nSince: Phase P1"},
    {"hamt/retain", "hamt/retain -- increment the reference count of a HAMT and return it.\n\nParameters:\n  m -- HAMT pointer\n\nSince: Phase P1"},
    {"hamt/set", "hamt/set -- insert or update a key/value pair; returns a new HAMT.\n\nParameters:\n  m -- source HAMT pointer\n  hash -- 64-bit hash of the key (passed as int64_t)\n  key -- key pointer\n  val -- value pointer\n\nSince: Phase P1"},
    {"hamt/del", "hamt/del -- delete a key from the HAMT; returns a new HAMT.\n\nParameters:\n  m -- source HAMT pointer\n  hash -- 64-bit hash of the key\n  key -- key pointer\n\nSince: Phase P1"},
    {"hamt/get", "hamt/get -- look up a key and return its value, or NULL if absent.\n\nParameters:\n  m -- HAMT pointer\n  hash -- 64-bit hash of the key\n  key -- key pointer\n\nSince: Phase P1"},
    {"hamt/has?", "hamt/has? -- check whether a key exists in the HAMT.\n\nParameters:\n  m -- HAMT pointer\n  hash -- 64-bit hash of the key\n  key -- key pointer\n\nSince: Phase P1"},
    {"hamt/count", "hamt/count -- return the number of key/value pairs in the HAMT.\n\nParameters:\n  m -- HAMT pointer\n\nSince: Phase P1"},
    {"hamt/merge", "hamt/merge -- merge two HAMTs; values from b win on key collision.\n\nParameters:\n  a -- first HAMT pointer\n  b -- second HAMT pointer (wins on collision)\n\nSince: Phase P1"},
    {"hamt/hash-str", "hamt/hash-str -- compute an xxHash64 of a NUL-terminated C string.\n\nParameters:\n  str -- NUL-terminated C string to hash\n\nSince: Phase P1"},
    {"hamt/hash-ptr", "hamt/hash-ptr -- hash a pointer value directly (identity hash).\n\nParameters:\n  ptr -- pointer whose address is used as the hash input\n\nSince: Phase P1"},
    {"hamt/iter-init", "hamt/iter-init -- initialize a stack-allocated iterator over a HAMT.\n\nParameters:\n  iter -- pre-allocated buffer of at least 64 bytes\n  m -- HAMT pointer to iterate over\n\nSince: Phase P1"},
    {"hamt/iter-free", "hamt/iter-free -- release any resources held by an iterator.\n\nParameters:\n  iter -- iterator buffer previously passed to hamt/iter-init\n\nSince: Phase P1"},
    {"hamt/iter-next", "hamt/iter-next -- advance an iterator and write the next entry into out-pointers.\n\nParameters:\n  iter -- iterator buffer\n  hash-out -- pointer that receives the key hash\n  key-out -- pointer that receives the key pointer\n  val-out -- pointer that receives the value pointer\n\nSince: Phase P1"},
    {"hamt/map", "hamt/map -- return a new HAMT with each value replaced by fn(val, ctx).\n\nParameters:\n  m -- source HAMT pointer\n  fn -- C function pointer (val :ptr, ctx :ptr) -> :ptr\n  ctx -- caller-supplied context passed to fn\n\nSince: Phase P1"},
    {"hamt/filter", "hamt/filter -- return a new HAMT keeping only entries where fn(key, val, ctx) is true.\n\nParameters:\n  m -- source HAMT pointer\n  fn -- C predicate pointer (key :ptr, val :ptr, ctx :ptr) -> bool\n  ctx -- caller-supplied context passed to fn\n\nSince: Phase P1"},
    {"hamt/reduce", "hamt/reduce -- fold all entries into an accumulator using fn(acc, key, val, ctx).\n\nParameters:\n  m -- source HAMT pointer\n  fn -- C function pointer (acc :ptr, key :ptr, val :ptr, ctx :ptr) -> :ptr\n  init -- initial accumulator pointer\n  ctx -- caller-supplied context passed to fn\n\nSince: Phase P1"},
    {"hamt/merge-with", "hamt/merge-with -- merge two HAMTs, resolving key conflicts with fn(val_a, val_b, ctx).\n\nParameters:\n  a -- first HAMT pointer\n  b -- second HAMT pointer\n  fn -- C function pointer (val_a :ptr, val_b :ptr, ctx :ptr) -> :ptr\n  ctx -- caller-supplied context passed to fn\n\nSince: Phase P1"},
    {"hamt/show", "hamt/show -- return a debug string \"{k->v, ...}\" for the HAMT; caller must free.\n\nParameters:\n  m -- HAMT pointer\n\nSince: Phase P1"},
    {"hamt/dump", "hamt/dump -- write the HAMT structure in DOT format to stderr for debugging.\n\nParameters:\n  m -- HAMT pointer to dump\n\nSince: Phase P1"},
    {"hamt/transient", "hamt/transient -- fork a mutable transient from an immutable HAMT.\n\nParameters:\n  m -- immutable HAMT pointer to fork from\n\nSince: Phase P1"},
    {"hamt/transient-set!", "hamt/transient-set! -- mutate a transient by inserting or updating a key in place.\n\nParameters:\n  t -- transient HAMT pointer\n  hash -- 64-bit hash of the key\n  key -- key pointer\n  val -- value pointer\n\nSince: Phase P1"},
    {"hamt/transient-del!", "hamt/transient-del! -- mutate a transient by deleting a key in place.\n\nParameters:\n  t -- transient HAMT pointer\n  hash -- 64-bit hash of the key\n  key -- key pointer\n\nSince: Phase P1"},
    {"hamt/persistent!", "hamt/persistent! -- seal a transient into an immutable HAMT.\n\nParameters:\n  t -- transient HAMT pointer (must not be used after this call)\n\nSince: Phase P1"},
    {"hamt/autolink-hint", "hamt/autolink-hint -- internal marker that triggers hamt.c compilation in tur build/run."},
    {"file-size", "file-size -- return the byte size of an already-open file.\n\nParameters:\n  f -- a FILE* cast to int64_t (as returned by fopen).\n\nExample:\n  The file size in bytes as an int.\n  \n    (file-size my-file-ptr)  ; => 1024"},
    {"Real-FileSystem", "Real-FileSystem -- create a FileSystem capability backed by libc.\n\nSince: Phase 16"},
    {"Real-FileSystem-free", "Real-FileSystem-free -- release a FileSystem capability created by Real-FileSystem.\n\nParameters:\n  fs -- the FileSystem pointer returned by Real-FileSystem.\n\nSince: Phase 16"},
    {"read-file", "read-file -- read an entire file into a newly allocated buffer.\n\nParameters:\n  path -- the filesystem path to open (:cstr).\n\nSince: Phase 16"},
    {"write-file", "write-file -- write a byte buffer to a file, overwriting any existing content.\n\nParameters:\n  path -- the destination filesystem path (:cstr).\n  data -- pointer to the data to write.\n  len -- number of bytes to write.\n\nSince: Phase 16"},
    {"file-exists?", "file-exists? -- test whether a file is accessible for reading.\n\nParameters:\n  path -- the filesystem path to check (:cstr).\n\nSince: Phase 16"},
    {"list-dir", "list-dir -- list all non-hidden entries in a directory.\n\nParameters:\n  path -- the directory path to list (:cstr).\n\nSince: Phase 16"},
    {"free-dir-listing", "free-dir-listing -- free a directory listing returned by list-dir.\n\nParameters:\n  entries -- the NULL-terminated string array returned by list-dir.\n\nSince: Phase 16"},
    {"Cons", "Cons"},
    {"nil-value", "nil-value -- return the empty list sentinel (NULL / 0).\n\nSince: Phase B1"},
    {"list-nil?", "list-nil? -- check whether a list is empty.\n\nParameters:\n  lst -- the list to test\n\nSince: Phase B1"},
    {"cons", "cons -- prepend a value to a list, returning a new Cons cell.\n\nParameters:\n  value -- the element to prepend\n  next -- the existing list (or nil-value for a one-element list)\n\nSince: Phase B1"},
    {"head", "head -- return the value of the first element of a list.\n\nParameters:\n  lst -- a non-nil list\n\nSince: Phase B1"},
    {"tail", "tail -- return the rest of the list after the first element.\n\nParameters:\n  lst -- a non-nil list\n\nSince: Phase B1"},
    {"list-free", "list-free -- free all Cons cells in a list (shallow -- does not free contained values).\n\nParameters:\n  lst -- the list to free (may be nil-value)\n\nSince: Phase B1"},
    {"list-length", "list-length -- return the number of elements in a list.\n\nParameters:\n  lst -- the list to measure\n\nSince: Phase B1"},
    {"Clone", "Typeclass instance for Cons -- shallow Clone for a single Cons cell."},
    {"__functor_list_fmap", "SINCE: Phase HKT §6 — Stdlib HKT migration"},
    {"Functor", "Typeclass instance for list -- Functor: fmap over every element."},
    {"__foldable_list_foldl", "__foldable_list_foldl -- foldl implementation for the list Foldable instance."},
    {"__foldable_list_foldr", "__foldable_list_foldr -- foldr implementation for the list Foldable instance."},
    {"Foldable", "Typeclass instance for list -- Foldable: foldl and foldr over all elements."},
    {"__applicative_list_pure", "__applicative_list_pure -- pure implementation for the list Applicative instance."},
    {"__applicative_list_ap", "__applicative_list_ap -- ap implementation for the list Applicative instance."},
    {"Applicative", "Typeclass instance for list -- Applicative: pure and ap."},
    {"__monad_list_bind", "__monad_list_bind -- bind implementation for the list Monad instance."},
    {"Monad", "Typeclass instance for list -- Monad: bind (concat-map)."},
    {"list-eq?", "list-eq? -- compare two lists element-wise using a caller-supplied comparator.\n\nParameters:\n  l1 -- first list\n  l2 -- second list\n  cmp-fn -- comparator of type fn [a :int b :int] :bool\n\nSince: Phase E1"},
    {"Eq", "Typeclass instance for list -- Eq: structural equality via list-eq?."},
    {"Show", "Show [Cons] -- show a non-empty list as \"[v1, v2, ...]\".\n\nParameters:\n  x -- a Cons struct value (first cell of the list)\n\nSince: SI3"},
    {"Real-Logger", "Real-Logger -- create a timestamped Logger capability writing to stdout/stderr.\n\nSince: Phase 16"},
    {"Real-Logger-free", "Real-Logger-free -- release a Logger capability created by Real-Logger.\n\nParameters:\n  log -- the Logger pointer returned by Real-Logger.\n\nSince: Phase 16"},
    {"Simple-Logger", "Simple-Logger -- create a lightweight Logger capability without timestamps.\n\nSince: Phase 16"},
    {"Simple-Logger-free", "Simple-Logger-free -- release a Logger capability created by Simple-Logger.\n\nParameters:\n  log -- the Logger pointer returned by Simple-Logger.\n\nSince: Phase 16"},
    {"Null-Logger", "Null-Logger -- create a silent Logger capability that discards all messages.\n\nSince: Phase 16"},
    {"Null-Logger-free", "Null-Logger-free -- release a Logger capability created by Null-Logger.\n\nParameters:\n  log -- the Logger pointer returned by Null-Logger.\n\nSince: Phase 16"},
    {"log-debug-direct", "log-debug-direct -- write a DEBUG message directly to stdout.\n\nParameters:\n  msg -- the message string to log (:cstr).\n\nSince: Phase 16"},
    {"log-info-direct", "log-info-direct -- write an INFO message directly to stdout.\n\nParameters:\n  msg -- the message string to log (:cstr).\n\nSince: Phase 16"},
    {"log-warn-direct", "log-warn-direct -- write a WARN message directly to stderr.\n\nParameters:\n  msg -- the message string to log (:cstr).\n\nSince: Phase 16"},
    {"log-error-direct", "log-error-direct -- write an ERROR message directly to stderr.\n\nParameters:\n  msg -- the message string to log (:cstr).\n\nSince: Phase 16"},
    {"term-int", "-- Term constructors ────────────────────────────────────────────────────────\n\nParameters:\n  n -- integer value\n\nExample:\n  Pointer to a term with tag=0, data1=n (:int).\n  \n    (term-int 42)  ; => tagged term pointer for integer 42"},
    {"term-var", "term-var -- construct a logic variable term with the given id.\n\nParameters:\n  id -- unique variable identifier (:int)\n\nExample:\n  Pointer to a term with tag=1, data1=id (:int).\n  \n    (term-var (lvar-next))  ; => fresh logic variable"},
    {"term-pair", "term-pair -- construct a logic pair term from two sub-terms.\n\nParameters:\n  a -- first sub-term pointer (:int)\n  b -- second sub-term pointer (:int)\n\nExample:\n  Pointer to a term with tag=2, data1=a, data2=b (:int).\n  \n    (term-pair (term-int 1) (term-int 2))  ; => pair term (1 . 2)"},
    {"term-nil", "term-nil -- construct the nil/empty logic term.\n\nExample:\n  Pointer to a term with tag=3 (:int).\n  \n    (term-nil)  ; => nil term"},
    {"term-tag", "-- Term accessors ───────────────────────────────────────────────────────────\n\nParameters:\n  t -- term pointer (:int)\n\nReturns:\n  0=INT, 1=VAR, 2=PAIR, 3=NIL (:int)."},
    {"term-int-val", "term-int-val -- read the integer value from an INT term.\n\nParameters:\n  t -- term pointer with tag=0 (:int)\n\nReturns:\n  The integer value stored in data1 (:int)."},
    {"term-var-id", "term-var-id -- read the variable id from a VAR term.\n\nParameters:\n  t -- term pointer with tag=1 (:int)\n\nReturns:\n  The variable id stored in data1 (:int)."},
    {"term-pair-fst", "term-pair-fst -- read the first sub-term pointer from a PAIR term.\n\nParameters:\n  t -- term pointer with tag=2 (:int)\n\nReturns:\n  data1 (first sub-term pointer) (:int)."},
    {"term-pair-snd", "term-pair-snd -- read the second sub-term pointer from a PAIR term.\n\nParameters:\n  t -- term pointer with tag=2 (:int)\n\nReturns:\n  data2 (second sub-term pointer) (:int)."},
    {"lvar-next", "-- Fresh variable counter ───────────────────────────────────────────────────\n\nExample:\n  A fresh monotonically increasing integer id (:int).\n  \n    (term-var (lvar-next))  ; => a unique logic variable"},
    {"subs-empty", "-- Substitution operations ──────────────────────────────────────────────────\n\nReturns:\n  0 (null pointer representing an empty alist) (:int)."},
    {"logic-walk", "logic-walk -- follow variable bindings in a substitution until ground.\n\nParameters:\n  t -- term pointer to walk (:int)\n  subs -- substitution alist pointer (:int)\n\nExample:\n  The fully walked term pointer (ground or unbound variable) (:int).\n  \n    (logic-walk (term-var 0) subs)  ; => bound term or the variable itself"},
    {"logic-unify", "logic-unify -- structurally unify two terms, extending the substitution.\n\nParameters:\n  t1 -- first term pointer (:int)\n  t2 -- second term pointer (:int)\n  subs -- current substitution alist (:int)\n\nExample:\n  Extended substitution on success, or -1 on unification failure (:int).\n  \n    (logic-unify (term-var 0) (term-int 5) (subs-empty))  ; => subs with x0=5"},
    {"apply-fat", "-- Fat-closure application ──────────────────────────────────────────────────\n\nParameters:\n  f -- fat closure pointer (:int)\n  arg -- argument to pass (:int)\n\nReturns:\n  Return value of the closure (:int)."},
    {"apply-goal", "apply-goal -- call a goal fat closure with a substitution (UState).\n\nParameters:\n  g -- goal fat closure pointer (:int)\n  state -- current substitution (:int)\n\nReturns:\n  Solution list (list of substitutions) (:int)."},
    {"unify-goal-impl", "-- Goal constructors ────────────────────────────────────────────────────────"},
    {"lequal", "lequal -- goal that unifies two terms (miniKanren ==).\n\nParameters:\n  t1 -- first term pointer (:int)\n  t2 -- second term pointer (:int)\n\nExample:\n  A goal (:ptr<void>) that succeeds iff t1 and t2 unify.\n  \n    (run-logic 1 (lequal (term-int 5) (term-int 5)))  ; => one solution"},
    {"succeed-impl", "succeed-impl -- implementation helper for the succeed goal."},
    {"succeed", "succeed -- goal that always succeeds without changing the substitution.\n\nExample:\n  A goal (:ptr<void>) that adds the current state unchanged to the solutions.\n  \n    (run-logic 1 (succeed))  ; => one solution (empty substitution)"},
    {"fail-impl", "fail-impl -- implementation helper for the fail goal."},
    {"fail", "fail -- goal that always fails, producing no solutions.\n\nExample:\n  A goal (:ptr<void>) that produces an empty solution list.\n  \n    (run-logic 1 (fail))  ; => empty list"},
    {"conjoined-inner", "conjoined-inner -- helper to apply the second goal in a conjunction."},
    {"conjoined-impl", "conjoined-impl -- implementation helper for conjunction."},
    {"conjoined", "conjoined -- goal that applies g1 then g2 to each result (conjunction).\n\nParameters:\n  g1 -- first goal (:ptr<void>)\n  g2 -- second goal (:ptr<void>)\n\nExample:\n  A goal that succeeds only when both g1 and g2 succeed (:ptr<void>).\n  \n    (run-logic 1 (conjoined (lequal x (term-int 1)) (succeed)))  ; => [x=1]"},
    {"disjoined-impl", "disjoined-impl -- implementation helper for disjunction."},
    {"disjoined", "disjoined -- goal that combines results from g1 and g2 (disjunction).\n\nParameters:\n  g1 -- first goal (:ptr<void>)\n  g2 -- second goal (:ptr<void>)\n\nExample:\n  A goal whose solutions are the interleaved results of g1 and g2 (:ptr<void>).\n  \n    (run-logic 2 (disjoined (lequal x (term-int 1)) (lequal x (term-int 2))))\n    ; => [x=1, x=2]"},
    {"fresh-impl", "fresh-impl -- implementation helper for fresh variable introduction."},
    {"take-n", "-- Runner ───────────────────────────────────────────────────────────────────\n\nParameters:\n  n -- maximum number of solutions (:int)\n  lst -- solution list (:int)\n\nReturns:\n  A truncated solution list of length at most n (:int)."},
    {"run-logic", "run-logic -- run a goal with an empty substitution and return up to n results.\n\nParameters:\n  n -- maximum number of solutions (:int)\n  g -- goal to run (:ptr<void>)\n\nExample:\n  A list of at most n substitutions (solution list) (:int).\n  \n    (run-logic 1 (fresh (fn [x] (lequal x (term-int 3)))))  ; => one solution"},
    {"first-state", "-- Result helpers ───────────────────────────────────────────────────────────\n\nParameters:\n  results -- solution list from run-logic (:int)\n\nReturns:\n  The first substitution pointer, or 0 if the list is empty (:int)."},
    {"reify-walk", "reify-walk -- walk a term through the first result's substitution.\n\nParameters:\n  t -- term pointer to reify (:int)\n  results -- solution list from run-logic (:int)\n\nExample:\n  The walked term pointer (ground or unbound variable) (:int).\n  \n    (reify-walk my-var (run-logic 1 my-goal))  ; => ground term or variable"},
    {"cond", "cond -- variadic conditional branching via nested if chains.\n\nParameters:\n   -- & clauses -- alternating test/expression pairs, with optional :else at end\n\nSince: Phase 7"},
    {"when", "when -- evaluate body only if test is truthy.\n\nParameters:\n  test -- the condition to evaluate\n  body -- expression to evaluate when test is truthy\n\nSince: Phase 7"},
    {"unless", "unless -- evaluate body only if test is falsy.\n\nParameters:\n  test -- the condition to evaluate\n  body -- expression to evaluate when test is falsy\n\nSince: Phase 7"},
    {"must!", "must! -- unwrap an option or result value, panicking if absent.\n\nParameters:\n  expr -- an option or result expression to unwrap\n\nSince: Phase R4"},
    {"must-msg!", "must-msg! -- unwrap an option or result value with a custom panic message.\n\nParameters:\n  expr -- an option or result expression to unwrap\n  msg -- the message to panic with if the value is absent\n\nSince: Phase R4"},
    {"ignore!", "ignore! -- explicitly discard a result value.\n\nParameters:\n  expr -- the expression whose value should be discarded\n\nSince: Phase R6"},
    {"do-m", "do-m -- monadic do-notation using .bind dispatch.\n\nParameters:\n   -- & forms -- alternating variable/monadic-action pairs followed by a body;\n   -- the last form is the body expression\n\nSince: Phase HKT H6"},
    {"for", "for -- monadic comprehension with optional guards.\n\nParameters:\n  binding-vec -- flat vector of alternating var/collection pairs,\n   -- with optional :when guard clauses interspersed\n   -- & body      -- the body expression(s) to lift into the monad\n\nSince: Phase HKT H7"},
    {"curry", "curry -- convert a 2-argument function to its curried form.\n\nParameters:\n  f -- a 2-argument function\n\nSince: CY3"},
    {"doc", "doc -- print documentation for a function, macro, or struct at the REPL.\n\nParameters:\n  name -- symbol whose documentation to display\n\nSince: Phase D1 (auto-docs)"},
    {"map-new", "map-new -- create a new empty map.\n\nSince: Phase P3"},
    {"assoc", "assoc -- insert or update a key/value pair; returns a new map.\n\nParameters:\n  m -- source map pointer\n  key -- key pointer (hashed by pointer identity)\n  val -- value pointer\n\nSince: Phase P3"},
    {"dissoc", "dissoc -- remove a key from the map; returns a new map.\n\nParameters:\n  m -- source map pointer\n  key -- key pointer to remove\n\nSince: Phase P3"},
    {"get", "get -- look up a key and return its value, or NULL if absent.\n\nParameters:\n  m -- map pointer\n  key -- key pointer to look up\n\nSince: Phase P3"},
    {"has?", "has? -- check whether a key exists in the map.\n\nParameters:\n  m -- map pointer\n  key -- key pointer to test\n\nSince: Phase P3"},
    {"count", "count -- return the number of key/value pairs in the map.\n\nParameters:\n  m -- map pointer\n\nSince: Phase P3"},
    {"merge", "merge -- merge two maps; values from b win on key collision.\n\nParameters:\n  a -- first map pointer\n  b -- second map pointer (wins on collision)\n\nSince: Phase P3"},
    {"map-eq?", "map-eq? -- compare two maps for structural equality using a value comparator.\n\nParameters:\n  m1 -- first map pointer\n  m2 -- second map pointer\n  val-cmp -- comparator fn [a :int b :int] :bool applied to each value pair\n\nSince: Phase P3"},
    {"mutex-new", "mutex-new -- allocate and initialise a new POSIX mutex.\n\nSince: Phase T19-C"},
    {"mutex-lock", "mutex-lock -- acquire the mutex, blocking until it is available.\n\nParameters:\n  m -- mutex handle returned by mutex-new\n\nSince: Phase T19-C"},
    {"mutex-unlock", "mutex-unlock -- release the mutex.\n\nParameters:\n  m -- mutex handle returned by mutex-new\n\nSince: Phase T19-C"},
    {"mutex-try-lock", "mutex-try-lock -- attempt to acquire the mutex without blocking.\n\nParameters:\n  m -- mutex handle returned by mutex-new\n\nSince: Phase T19-C"},
    {"mutex-free", "mutex-free -- destroy the mutex and release its memory.\n\nParameters:\n  m -- mutex handle returned by mutex-new\n\nSince: Phase T19-C"},
    {"some", "some -- wrap a value in a some option.\n\nParameters:\n  x -- the value to wrap\n\nSince: Phase B1"},
    {"none", "none -- return the none option (NULL).\n\nSince: Phase B1"},
    {"some?", "some? -- check whether an option contains a value.\n\nParameters:\n  o -- the option to test\n\nSince: Phase B1"},
    {"option-unwrap", "option-unwrap -- extract the value from a some option, panicking if none.\n\nParameters:\n  o -- the option to unwrap\n\nSince: Phase B1"},
    {"option-free", "option-free -- free the heap memory for an option value.\n\nParameters:\n  o -- the option to free (may be none / NULL)\n\nSince: Phase B1"},
    {"option-must", "option-must -- unwrap a some option or panic with a default message.\n\nParameters:\n  o -- the option to unwrap (:ptr<void>)\n\nSince: Phase R4"},
    {"option-expect", "option-expect -- unwrap a some option or panic with a caller-supplied message.\n\nParameters:\n  o -- the option to unwrap (:ptr<void>)\n  msg -- the panic message (:cstr)\n\nSince: Phase R4"},
    {"__foldable_option_foldl", "SINCE: Phase HKT §6"},
    {"__foldable_option_foldr", "__foldable_option_foldr -- foldr implementation for the option Foldable instance."},
    {"__functor_option_fmap", "SINCE: Phase HKT H3"},
    {"__applicative_option_pure", "__applicative_option_pure -- pure implementation for the option Applicative instance."},
    {"__applicative_option_ap", "__applicative_option_ap -- ap implementation for the option Applicative instance."},
    {"__monad_option_bind", "__monad_option_bind -- bind implementation for the option Monad instance."},
    {"__traversable_option_traverse", "__traversable_option_traverse -- traverse implementation for the option Traversable instance."},
    {"Traversable", "Typeclass instance for option -- Traversable: traverse with an Applicative."},
    {"__alternative_option_empty", "__alternative_option_empty -- empty implementation for the option Alternative instance."},
    {"__alternative_option_alt_or", "__alternative_option_alt_or -- alt-or implementation for the option Alternative instance."},
    {"Alternative", "Typeclass instance for option -- Alternative: empty and alt-or."},
    {"option-eq?", "option-eq? -- compare two options using a caller-supplied comparator.\n\nParameters:\n  o1 -- first option\n  o2 -- second option\n  cmp-fn -- comparator of type fn [a :int b :int] :bool\n\nSince: Phase E1"},
    {"__clone_option_clone", "__clone_option_clone -- clone implementation for the option Clone instance."},
    {"Pair", "Pair"},
    {"pair-new", "pair-new -- allocate a new Pair on the heap.\n\nParameters:\n  a -- first element (int64_t)\n  b -- second element (int64_t)\n\nSince: Phase B1"},
    {"pair-first", "pair-first -- return the first element of a Pair.\n\nParameters:\n  p -- pointer to a Pair (as int64_t)\n\nSince: Phase B1"},
    {"pair-second", "pair-second -- return the second element of a Pair.\n\nParameters:\n  p -- pointer to a Pair (as int64_t)\n\nSince: Phase B1"},
    {"pair-free", "pair-free -- free a heap-allocated Pair (shallow free only).\n\nParameters:\n  p -- pointer to a Pair (as int64_t)\n\nSince: Phase B1"},
    {"__bifunctor_pair_bimap", "__bifunctor_pair_bimap -- apply fn-left to first and fn-right to second, returning a new Pair."},
    {"Bifunctor", "Bifunctor [Pair] -- bimap applies fn-left to first and fn-right to second."},
    {"pair-eq?", "pair-eq? -- compare two Pairs element-wise using a comparator function.\n\nParameters:\n  p1 -- first Pair pointer (as int64_t)\n  p2 -- second Pair pointer (as int64_t)\n  cmp-fn -- comparator fn [a :int b :int] :bool applied to each field\n\nSince: Phase E1"},
    {"input-new", "── Input ────────────────────────────────────────────────────────────────────\n\nParameters:\n  s -- the source string (:cstr).\n  pos -- the initial character position (0-based).\n\nExample:\n  Pointer (as int64_t) to a heap-allocated Input{str, pos}.\n  \n    (input-new \"hello\" 0)  ; => Input at position 0"},
    {"input-at-end", "input-at-end -- test whether an Input is at the end of its string.\n\nParameters:\n  inp -- pointer (as int64_t) to an Input.\n\nExample:\n  true if the current character is '\\0', false otherwise.\n  \n    (input-at-end (input-new \"\" 0))  ; => true"},
    {"input-current-char", "input-current-char -- return the character at the current position.\n\nParameters:\n  inp -- pointer (as int64_t) to an Input.\n\nExample:\n  The ASCII code of the current character as an int64_t (unsigned byte).\n  \n    (input-current-char (input-new \"abc\" 0))  ; => 97  ; 'a'"},
    {"input-advance", "input-advance -- return a new Input advanced by one character.\n\nParameters:\n  inp -- pointer (as int64_t) to the current Input.\n\nExample:\n  A new heap-allocated Input with pos incremented by 1.\n  \n    (input-pos (input-advance (input-new \"ab\" 0)))  ; => 1"},
    {"input-pos", "input-pos -- return the current position index of an Input.\n\nParameters:\n  inp -- pointer (as int64_t) to an Input.\n\nExample:\n  The int64_t character offset into the source string.\n  \n    (input-pos (input-new \"abc\" 2))  ; => 2"},
    {"input-remaining", "input-remaining -- count bytes remaining in an Input.\n\nParameters:\n  inp -- pointer (as int64_t) to an Input.\n\nExample:\n  The number of bytes from the current position to the terminating '\\0'.\n  \n    (input-remaining (input-new \"abc\" 1))  ; => 2"},
    {"apply-parser", "apply-parser -- run a parser fat closure against an Input.\n\nParameters:\n  p -- pointer (as int64_t) to a parser fat closure.\n  inp -- pointer (as int64_t) to the Input to parse.\n\nExample:\n  A Cell list of Pair(value, remaining-Input) results.\n  \n    (apply-parser (item) (input-new \"a\" 0))  ; => Cell{Pair(97, Input@1)}"},
    {"pfail", "── Core parsers ─────────────────────────────────────────────────────────────\n\nExample:\n  A parser that returns mzero for any input.\n  \n    (run-parser (pfail) \"abc\")  ; => 0  (no results)"},
    {"pure-impl", "pure-impl -- internal implementation for pure.\n\nParameters:\n  _v -- the value to return.\n  inp -- the current Input (passed through unchanged)."},
    {"pure", "pure -- parser that always succeeds with a fixed value, consuming no input.\n\nParameters:\n  v -- the value to embed in the parse result.\n\nExample:\n  A parser that returns Pair(v, inp) without advancing the input.\n  \n    (run-parser (pure 99) \"\")  ; => Cell{Pair(99, Input@0)}"},
    {"item-impl", "item-impl -- internal implementation for item.\n\nParameters:\n  inp -- the current Input."},
    {"item", "item -- parser that consumes exactly one character.\n\nExample:\n  A parser yielding the ASCII code of the next character, or\n    failure if at end of input.\n  \n    (parse-value (run-parser (item) \"A\"))  ; => 65  ; 'A'"},
    {"pchar-impl", "pchar-impl -- internal implementation for pchar.\n\nParameters:\n  _c -- the expected ASCII character code.\n  inp -- the current Input."},
    {"pchar", "pchar -- parser that matches a single specific character.\n\nParameters:\n  c -- the ASCII integer code of the character to match.\n\nExample:\n  A parser that succeeds with c if the next character equals c,\n    or fails otherwise.\n  \n    (parse-value (run-parser (pchar 65) \"ABC\"))  ; => 65  ; 'A'"},
    {"pstring-c-impl", "pstring-c-impl -- internal C implementation for pstring.\n\nParameters:\n  s_raw -- the pattern string as a raw int64_t pointer.\n  inp -- the current Input."},
    {"cstr->int", "cstr->int -- reinterpret a :cstr pointer as an int64_t without copying.\n\nParameters:\n  s -- the C string to reinterpret.\n\nReturns:\n  The raw pointer value of s as an int64_t."},
    {"pstring", "pstring -- parser that matches a literal string prefix.\n\nParameters:\n  s -- the expected string literal (:cstr).\n\nExample:\n  A parser that succeeds with s (as int64_t pointer) and advances\n    past it, or fails if the input does not start with s.\n  \n    (run-parser (pstring \"hi\") \"hi there\")  ; => Cell{Pair(\"hi\", Input@2)}"},
    {"or-parser-impl", "── Combinators ──────────────────────────────────────────────────────────────\n\nParameters:\n  lp -- the first parser (int64_t fat-closure pointer).\n  lq -- the second parser (int64_t fat-closure pointer).\n  inp -- the current Input."},
    {"or-parser", "or-parser -- try two parsers and return all successes from either.\n\nParameters:\n  p -- the first parser to try.\n  q -- the second parser to try.\n\nExample:\n  A parser that returns the concatenation of results from p and q\n    applied to the same input (full backtracking).\n  \n    (run-parser (or-parser (pchar 65) (pchar 66)) \"B\")  ; => Cell{Pair(66, ...)}"},
    {"bind-parser-inner", "bind-parser-inner -- apply continuation f to a single parse Pair.\n\nParameters:\n  lf -- the continuation fat closure (value -> Parser).\n  pair -- a Pair(value, remaining-Input) from the first parser."},
    {"bind-parser-impl", "bind-parser-impl -- internal implementation for bind-parser.\n\nParameters:\n  lp -- the first parser.\n  lf -- the continuation fat closure.\n  inp -- the current Input."},
    {"bind-parser", "bind-parser -- sequence two parsers, threading the first result into the second.\n\nParameters:\n  p -- the first parser.\n  f -- a fat closure of type int64_t -> Parser; receives the parsed value\n   -- and returns the next parser to run.\n\nExample:\n  A parser that runs p, then for each result calls (f value) and runs\n    the resulting parser on the remaining input.\n  \n    (bind-parser (item) (fn [c] (pure c)))  ; identity parser"},
    {"then-parser-impl", "then-parser-impl -- internal implementation for then-parser.\n\nParameters:\n  lp -- the first parser (result discarded).\n  lq -- the second parser (result kept).\n  inp -- the current Input."},
    {"then-parser", "then-parser -- sequence two parsers, discarding the first result.\n\nParameters:\n  p -- parser whose result is discarded.\n  q -- parser whose result is kept.\n\nExample:\n  A parser that runs p, then runs q on the remaining input,\n    returning only q's results.\n  \n    (run-parser (then-parser (pchar 40) (item)) \"(x\")\n    ; => Cell{Pair(120, Input@2)}  ; 'x' only"},
    {"many-c-impl", "many-c-impl -- internal C implementation of greedy zero-or-more repetition.\n\nParameters:\n  p_raw -- parser fat closure as int64_t.\n  inp -- the current Input."},
    {"many", "many -- greedily match a parser zero or more times.\n\nParameters:\n  p -- the parser to repeat.\n\nExample:\n  A parser that always succeeds, yielding a Cell list of all\n    matched values and the remaining Input after the last match.\n    Returns an empty list when p does not match at all.\n  \n    (run-parser (many (pchar 97)) \"aab\")\n    ; => Cell{Pair(Cell{97,97}, Input@2)}"},
    {"many1-impl", "many1-impl -- internal implementation for many1.\n\nParameters:\n  _p -- the parser to repeat.\n  inp -- the current Input."},
    {"many1", "many1 -- greedily match a parser one or more times.\n\nParameters:\n  p -- the parser to repeat.\n\nExample:\n  A parser that succeeds only when p matches at least once, then\n    greedily repeats, returning results identical in structure to many.\n  \n    (run-parser (many1 (pchar 97)) \"aab\")\n    ; => Cell{Pair(Cell{97,97}, Input@2)}\n    (run-parser (many1 (pchar 97)) \"bbb\")  ; => 0  (fails)"},
    {"optional-impl", "optional-impl -- internal implementation for optional.\n\nParameters:\n  _p -- the parser to attempt.\n  inp -- the current Input."},
    {"optional", "optional -- match a parser zero or one times.\n\nParameters:\n  p -- the parser to attempt.\n\nExample:\n  A parser that returns two results when p succeeds (the match and\n    a fallback with value 0), or one result with value 0 when p fails.\n    Check pair-first: 0 means absent, non-zero means the parsed value.\n  \n    (run-parser (optional (pchar 65)) \"ABC\")  ; => two results\n    (run-parser (optional (pchar 65)) \"XYZ\")  ; => Cell{Pair(0, Input@0)}"},
    {"run-parser", "── Runners ──────────────────────────────────────────────────────────────────\n\nParameters:\n  p -- the parser to run.\n  s -- the input string (:cstr).\n\nExample:\n  A Cell list of Pair(value, remaining-Input) for all successful\n    parses, including partial ones.\n  \n    (run-parser (pchar 65) \"ABC\")  ; => Cell{Pair(65, Input@1)}"},
    {"run-parser-full-c", "run-parser-full-c -- internal C helper to extract the first full-input parse.\n\nParameters:\n  results -- Cell list returned by run-parser."},
    {"run-parser-full", "run-parser-full -- run a parser and return only the first complete parse.\n\nParameters:\n  p -- the parser to run.\n  s -- the input string (:cstr).\n\nExample:\n  A Cell wrapping the parsed value if the entire input was consumed,\n    or 0 (mzero) if no full parse exists.\n  \n    (run-parser-full (many (pchar 97)) \"aaa\")\n    ; => Cell{value=Cell{97,97,97}}\n    (run-parser-full (pchar 97) \"ab\")  ; => 0  (leftover input)"},
    {"parse-value", "── Result helpers ───────────────────────────────────────────────────────────\n\nParameters:\n  results -- a Cell list returned by run-parser or run-parser-full.\n\nExample:\n  The int64_t value from pair-first of the first Cell, or 0 if empty.\n  \n    (parse-value (run-parser (pchar 65) \"A\"))  ; => 65"},
    {"parse-result-count", "parse-result-count -- count the number of parse results in a result list.\n\nParameters:\n  results -- a Cell list returned by run-parser.\n\nExample:\n  The number of successful parse results as an int64_t.\n  \n    (parse-result-count (run-parser (or-parser (pchar 65) (pchar 65)) \"A\"))\n    ; => 2  (both branches succeed)"},
    {"print-char-list", "print-char-list -- print each integer value in a Cell list, space-separated.\n\nParameters:\n  lst -- a bt-cons Cell list of int64_t character codes.\n\nExample:\n  (print-char-list (bt-cons 65 (bt-cons 66 (bt-nil))))\n    ; prints: 65 66"},
    {"char-list-length", "char-list-length -- count elements in a bt-cons character list.\n\nParameters:\n  lst -- a bt-cons Cell list.\n\nExample:\n  The number of elements as an int64_t.\n  \n    (char-list-length (bt-cons 1 (bt-cons 2 (bt-nil))))  ; => 2"},
    {"Real-Random", "Real-Random -- create a Random capability backed by libc rand().\n\nSince: Phase 16"},
    {"Real-Random-free", "Real-Random-free -- release a Random capability created by Real-Random.\n\nParameters:\n  rng -- the Random pointer returned by Real-Random.\n\nSince: Phase 16"},
    {"Seeded-Random", "Seeded-Random -- create a deterministic Random capability from a fixed seed.\n\nParameters:\n  seed -- unsigned integer seed for srand; same seed produces the same sequence.\n\nSince: Phase 16"},
    {"Seeded-Random-free", "Seeded-Random-free -- release a Random capability created by Seeded-Random.\n\nParameters:\n  rng -- the Random pointer returned by Seeded-Random.\n\nSince: Phase 16"},
    {"rand-int", "rand-int -- return a random integer in the inclusive range [min, max].\n\nParameters:\n  min -- the minimum value (inclusive).\n  max -- the maximum value (inclusive).\n\nSince: Phase 16"},
    {"rand-float", "rand-float -- return a random integer scaled to represent [0, 1).\n\nSince: Phase 16"},
    {"rand-die", "rand-die -- roll an n-sided die, returning a value in [1, sides].\n\nParameters:\n  sides -- the number of faces on the die.\n\nSince: Phase 16"},
    {"rand-bool", "rand-bool -- return a random boolean value.\n\nSince: Phase 16"},
    {"__functor_rc_fmap", "SINCE: Phase HKT H3\n\nSince: Phase HKT H3"},
    {"__foldable_rc_foldl", "SINCE: Phase HKT §6\n\nSince: Phase HKT S6"},
    {"__foldable_rc_foldr", "__foldable_rc_foldr -- internal right-fold over a single-element rc<T>.\n\nSince: Phase HKT S6"},
    {"__clone_rc_shallow", "SINCE: Phase B1 (HKT workaround)\n\nSince: Phase B1"},
    {"Ref", "Ref -- heap-allocated single-value container with independent ownership.\n\nSince: Phase B1"},
    {"ref-new", "ref-new -- allocate a new Ref cell on the heap containing value.\n\nParameters:\n  value -- the int64 value to store inside the Ref\n\nSince: Phase B1"},
    {"ref-get", "ref-get -- read the value stored in a Ref cell.\n\nParameters:\n  r -- opaque Ref handle returned by ref-new\n\nSince: Phase B1"},
    {"ref-free", "ref-free -- free the Ref cell (shallow; does not free the contained value).\n\nParameters:\n  r -- opaque Ref handle returned by ref-new\n\nSince: Phase B1"},
    {"ok", "ok -- wrap a value in an ok result.\n\nParameters:\n  x -- the success value (:int)\n\nExample:\n  A heap-allocated ok result as :ptr<void>.\n  \n    (ok 42)  ; => ok(42)"},
    {"err", "err -- wrap a value in an err result.\n\nParameters:\n  e -- the error value (:int)\n\nExample:\n  A heap-allocated err result as :ptr<void>.\n  \n    (err 1)  ; => err(1)"},
    {"ok?", "ok? -- check whether a result is ok.\n\nParameters:\n  r -- the result to test (:ptr<void>)\n\nExample:\n  true if r is an ok result, false otherwise.\n  \n    (ok? (ok 1))   ; => true\n    (ok? (err 0))  ; => false"},
    {"err?", "err? -- check whether a result is err.\n\nParameters:\n  r -- the result to test (:ptr<void>)\n\nExample:\n  true if r is an err result (or NULL), false otherwise.\n  \n    (err? (err 0))  ; => true\n    (err? (ok 1))   ; => false"},
    {"ok-val", "ok-val -- extract the ok value from a result.\n\nParameters:\n  r -- an ok result (:ptr<void>); behaviour is undefined if r is err\n\nExample:\n  The contained ok value as :int.\n  \n    (ok-val (ok 5))  ; => 5"},
    {"err-val", "err-val -- extract the err value from a result.\n\nParameters:\n  r -- an err result (:ptr<void>); behaviour is undefined if r is ok\n\nExample:\n  The contained err value as :int.\n  \n    (err-val (err 99))  ; => 99"},
    {"result-unwrap", "result-unwrap -- extract the ok value, aborting the process if r is err.\n\nParameters:\n  r -- the result to unwrap (:ptr<void>)\n\nExample:\n  The contained ok value as :int.\n  \n    (result-unwrap (ok 7))  ; => 7"},
    {"result-unwrap-or", "result-unwrap-or -- extract the ok value, or return a default if r is err.\n\nParameters:\n  r -- the result (:ptr<void>)\n  default_val -- the fallback value (:int)\n\nExample:\n  The ok value if r is ok, otherwise default_val.\n  \n    (result-unwrap-or (err 0) 99)  ; => 99"},
    {"result-expect", "result-expect -- extract the ok value, aborting with a custom message if r is err.\n\nParameters:\n  r -- the result to unwrap (:ptr<void>)\n  msg -- message printed to stderr before aborting (:cstr)\n\nExample:\n  The contained ok value as :int.\n  \n    (result-expect r \"parse failed\")  ; => ok value or abort"},
    {"result-map", "result-map -- apply a function to the ok value, propagating err unchanged.\n\nParameters:\n  r -- the result (:ptr<void>)\n  f -- function to apply to the ok value (:ptr<void>); signature fn [x :int] :int\n\nExample:\n  A new ok result with the mapped value, or r unchanged if r is err.\n  \n    (result-map (ok 3) (fn [x] (* x 2)))  ; => ok(6)"},
    {"result-map-err", "result-map-err -- apply a function to the err value, propagating ok unchanged.\n\nParameters:\n  r -- the result (:ptr<void>)\n  f -- function to apply to the err value (:ptr<void>); signature fn [e :int] :int\n\nExample:\n  A new err result with the mapped error, or r unchanged if r is ok.\n  \n    (result-map-err (err 1) (fn [e] (+ e 100)))  ; => err(101)"},
    {"result-flat-map", "result-flat-map -- chain a fallible computation over an ok result.\n\nParameters:\n  r -- the result (:ptr<void>)\n  f -- function receiving the ok value and returning a new result (:ptr<void>)\n\nExample:\n  The result of applying f to the ok value, or r unchanged if r is err.\n  \n    (result-flat-map (ok 5) (fn [x] (if (> x 0) (ok x) (err -1))))  ; => ok(5)"},
    {"result-or", "result-or -- return r if ok, otherwise return the fallback result.\n\nParameters:\n  r -- the primary result (:ptr<void>)\n  alt -- the fallback result (:ptr<void>)\n\nExample:\n  r if r is ok, otherwise alt.\n  \n    (result-or (err 0) (ok 99))  ; => ok(99)"},
    {"result-or-else", "result-or-else -- return r if ok, otherwise compute a fallback by calling f with the err value.\n\nParameters:\n  r -- the primary result (:ptr<void>)\n  f -- recovery function of type fn [e :int] :ptr<void>\n\nExample:\n  r if r is ok, otherwise the result of f(err-value).\n  \n    (result-or-else (err 1) (fn [e] (ok 0)))  ; => ok(0)"},
    {"ok-or", "ok-or -- convert an option to a result, using e as the error value if the option is none.\n\nParameters:\n  opt -- the option to convert (:ptr<void>)\n  e -- the error value to use if opt is none (:int)\n\nExample:\n  ok(value) if opt is some(value), err(e) if opt is none.\n  \n    (ok-or (some 7) -1)  ; => ok(7)\n    (ok-or (none) -1)    ; => err(-1)"},
    {"err-context", "err-context -- prepend context text to an err value's message string.\n\nParameters:\n  r -- the result (:ptr<void>)\n  ctx -- context prefix string (:cstr)\n\nExample:\n  A new err result whose message is \"ctx: original\", or r unchanged if r is ok.\n  \n    (err-context (err my-msg) \"loading config\")"},
    {"result-eq?", "result-eq? -- compare two results using separate comparators for ok and err values.\n\nParameters:\n  r1 -- first result\n  r2 -- second result\n  ok-cmp -- comparator for ok values; fn [a :int b :int] :bool\n  err-cmp -- comparator for err values; fn [a :int b :int] :bool\n\nSince: Phase E1"},
    {"result-free", "result-free -- free the heap memory for a result value.\n\nParameters:\n  r -- the result to free (:ptr<void>)\n\nExample:\n  (result-free my-result)"},
    {"result-collect", "result-collect -- collect a vec of results into a single result.\n\nParameters:\n  v -- a vec (:ptr<void>) whose elements are result ptr<void> values\n\nExample:\n  ok(vec-of-ok-values) if every element is ok,\n    or err(first-err-value) on the first err encountered.\n  \n    (result-collect my-results-vec)  ; => ok(vec) or err(e)"},
    {"result-partition", "result-partition -- split a vec of results into separate ok and err vecs.\n\nParameters:\n  v -- a vec (:ptr<void>) whose elements are result ptr<void> values\n\nExample:\n  A pair (:ptr<void>) with fields ok_vec and err_vec.\n    Use result-partition-ok and result-partition-err to access each vec.\n  \n    (let [pair (result-partition my-vec)]\n      (result-partition-ok pair))"},
    {"result-partition-ok", "result-partition-ok -- extract the ok-vec from a result-partition pair.\n\nParameters:\n  pair -- the pair returned by result-partition (:ptr<void>)\n\nExample:\n  The vec (:ptr<void>) of ok values.\n  \n    (result-partition-ok (result-partition my-vec))"},
    {"result-partition-err", "result-partition-err -- extract the err-vec from a result-partition pair.\n\nParameters:\n  pair -- the pair returned by result-partition (:ptr<void>)\n\nExample:\n  The vec (:ptr<void>) of err values.\n  \n    (result-partition-err (result-partition my-vec))"},
    {"result-must", "result-must -- unwrap the ok value or panic with a default message.\n\nParameters:\n  r -- the result to unwrap (:ptr<void>)\n\nSince: Phase R4"},
    {"result-must-msg", "result-must-msg -- unwrap the ok value or panic with a caller-supplied message.\n\nParameters:\n  r -- the result to unwrap (:ptr<void>)\n  msg -- the panic message (:cstr)\n\nSince: Phase R4"},
    {"__foldable_result_foldl", "SINCE: Phase HKT H3"},
    {"__foldable_result_foldr", "__foldable_result_foldr -- foldr implementation for the result Foldable instance."},
    {"__bifunctor_result_bimap", "__bifunctor_result_bimap -- bimap implementation for the result Bifunctor instance."},
    {"__functor_result_fmap", "__functor_result_fmap -- fmap implementation for the result Functor instance."},
    {"__applicative_result_pure", "__applicative_result_pure -- pure implementation for the result Applicative instance."},
    {"__applicative_result_ap", "__applicative_result_ap -- ap implementation for the result Applicative instance."},
    {"__monad_result_bind", "__monad_result_bind -- bind implementation for the result Monad instance."},
    {"rwlock-new", "rwlock-new -- allocate and initialise a new POSIX read-write lock.\n\nSince: Phase T19-C"},
    {"rwlock-rdlock", "rwlock-rdlock -- acquire a shared read lock, blocking until available.\n\nParameters:\n  rw -- rwlock handle returned by rwlock-new\n\nSince: Phase T19-C"},
    {"rwlock-wrlock", "rwlock-wrlock -- acquire an exclusive write lock, blocking until available.\n\nParameters:\n  rw -- rwlock handle returned by rwlock-new\n\nSince: Phase T19-C"},
    {"rwlock-try-rdlock", "rwlock-try-rdlock -- attempt to acquire a shared read lock without blocking.\n\nParameters:\n  rw -- rwlock handle returned by rwlock-new\n\nSince: Phase T19-C"},
    {"rwlock-try-wrlock", "rwlock-try-wrlock -- attempt to acquire an exclusive write lock without blocking.\n\nParameters:\n  rw -- rwlock handle returned by rwlock-new\n\nSince: Phase T19-C"},
    {"rwlock-unlock", "rwlock-unlock -- release a previously acquired read or write lock.\n\nParameters:\n  rw -- rwlock handle returned by rwlock-new\n\nSince: Phase T19-C"},
    {"rwlock-free", "rwlock-free -- destroy the read-write lock and release its memory.\n\nParameters:\n  rw -- rwlock handle returned by rwlock-new\n\nSince: Phase T19-C"},
    {"array-get", "array-get -- bounds-checked array read; returns a heap-allocated Option struct.\n\nParameters:\n  arr -- pointer to an int64_t array\n  idx -- zero-based index to read\n\nSince: Phase U4"},
    {"array-set", "array-set -- bounds-checked array write; returns 1 on success, 0 on out-of-range index.\n\nParameters:\n  arr -- pointer to an int64_t array\n  idx -- zero-based index to write\n  value -- value to store\n\nSince: Phase U4"},
    {"array-slice", "array-slice -- create a { ptr, len } slice view starting at start for len elements.\n\nParameters:\n  arr -- source int64_t array pointer\n  start -- first element index (offset in int64_t units)\n  len -- number of elements in the view\n\nSince: Phase U4"},
    {"with-c-string", "with-c-string -- pass a Turmeric cstr to a callback function and return its result.\n\nParameters:\n  s -- cstr value to pass (already a C string in v1)\n  f -- function pointer accepting a cstr; called with s\n\nSince: Phase U4"},
    {"from-c-string", "from-c-string -- return a Turmeric cstr from a C string (no-copy in v1).\n\nParameters:\n  s -- C string to wrap\n\nSince: Phase U4"},
    {"box", "box -- heap-allocate an int64 value and return a pointer to it.\n\nParameters:\n  v -- integer value to box\n\nSince: Phase U4"},
    {"unbox", "unbox -- read the int64 value from a heap pointer created by box.\n\nParameters:\n  p -- pointer from box\n\nSince: Phase U4"},
    {"scheduler-new", "scheduler-new -- create a new cooperative fiber scheduler.\n\nSince: Phase T21"},
    {"scheduler-current", "scheduler-current -- return the current global scheduler pointer.\n\nSince: Phase T21"},
    {"scheduler-spawn", "scheduler-spawn -- add a fiber to the scheduler's ready queue.\n\nParameters:\n  sched -- scheduler pointer returned by scheduler-new\n  f -- fiber pointer to enqueue\n\nSince: Phase T21"},
    {"scheduler-run", "scheduler-run -- run the scheduler event loop until the ready queue is empty.\n\nParameters:\n  sched -- scheduler pointer returned by scheduler-new\n\nSince: Phase T21"},
    {"scheduler-run-to-completion", "scheduler-run-to-completion -- run the scheduler until all spawned fibers have finished.\n\nParameters:\n  sched -- scheduler pointer returned by scheduler-new\n\nSince: Phase T21"},
    {"scheduler-timeout", "scheduler-timeout -- schedule a callback to be called after a delay in milliseconds.\n\nParameters:\n  ms -- delay in milliseconds before invoking the callback\n  cb -- function pointer to invoke; receives arg as its sole argument\n  arg -- opaque pointer passed through to the callback\n\nSince: Phase T21"},
    {"scheduler-mt-new", "scheduler-mt-new -- create a new multi-threaded work-stealing scheduler.\n\nParameters:\n  n_threads -- number of OS worker threads to spawn\n\nSince: Phase T23"},
    {"scheduler-mt-free", "scheduler-mt-free -- free a multi-threaded scheduler after all threads have finished.\n\nParameters:\n  sched -- scheduler pointer returned by scheduler-mt-new\n\nSince: Phase T23"},
    {"scheduler-mt-spawn", "scheduler-mt-spawn -- add a fiber to the multi-threaded scheduler's work queue.\n\nParameters:\n  sched -- scheduler pointer returned by scheduler-mt-new\n  fiber -- fiber pointer to enqueue for execution\n\nSince: Phase T23"},
    {"scheduler-mt-run", "scheduler-mt-run -- run the multi-threaded scheduler on the calling thread.\n\nParameters:\n  sched -- scheduler pointer returned by scheduler-mt-new\n\nSince: Phase T23"},
    {"scheduler-mt-thread-id", "scheduler-mt-thread-id -- return the unique integer ID of the current OS thread.\n\nSince: Phase T23"},
    {"scheduler-mt-set-current", "scheduler-mt-set-current -- set the active scheduler for the current thread.\n\nParameters:\n  sched -- scheduler pointer to install as the current thread's scheduler\n\nSince: Phase T23"},
    {"scheduler-mt-current", "scheduler-mt-current -- return the scheduler currently associated with this thread.\n\nSince: Phase T23"},
    {"scheduler-mt-yield", "scheduler-mt-yield -- yield the current fiber so other fibers may be scheduled.\n\nSince: Phase T23"},
    {"scheduler-mt-park", "scheduler-mt-park -- park the current fiber until another fiber calls scheduler-mt-unpark.\n\nSince: Phase T23"},
    {"scheduler-mt-unpark", "scheduler-mt-unpark -- unpark a previously parked fiber, making it eligible to run.\n\nParameters:\n  fiber -- fiber pointer that was previously parked via scheduler-mt-park\n\nSince: Phase T23"},
    {"ScscmResult<T>", "ScscmResult<T>"},
    {"result-ok?", "result-ok? -- Check whether a result represents success.\n\nParameters:\n  result -- A ScscmResult map.\n\nExample:\n  true if the result is successful, false otherwise.\n  \n    (result-ok? (ok 1))  ; => true"},
    {"result-err?", "result-err? -- Check whether a result represents an error.\n\nParameters:\n  result -- A ScscmResult map.\n\nExample:\n  true if the result is an error, false otherwise.\n  \n    (result-err? (err :timeout))  ; => true"},
    {"safe-world-create", "safe-world-create -- Create a hcsynth world with error handling.\n\nParameters:\n  sample_rate -- Sample rate in Hz.\n  block_size -- Block size in samples.\n\nExample:\n  ScscmResult wrapping the WorldHandle on success, or :connection-failed.\n  \n    (safe-world-create 48000 512)  ; => {:ok true :value <handle> ...}"},
    {"safe-synth-new", "safe-synth-new -- Create a synth node with error handling.\n\nParameters:\n  world_id -- Target world handle.\n  synthdef_name -- SynthDef name to instantiate.\n  node_id -- Node ID to assign.\n  action -- Add action (e.g. ADD_TO_TAIL).\n  target_id -- Target node ID.\n\nExample:\n  ScscmResult wrapping the NodeID on success, or an error keyword.\n  \n    (safe-synth-new w \"mySynth\" 1001 2 1)"},
    {"safe-synth-set", "safe-synth-set -- Set a synth control parameter with error handling.\n\nParameters:\n  world_id -- Target world handle.\n  node_id -- Target node ID.\n  control_index -- Zero-based control index.\n  value -- Value to set.\n\nExample:\n  ScscmResult wrapping nil on success, or :control-index-out-of-range.\n  \n    (safe-synth-set w 1001 0 440.0)"},
    {"safe-synth-free", "safe-synth-free -- Free a synth node with error handling.\n\nParameters:\n  world_id -- Target world handle.\n  node_id -- Node ID to free.\n\nExample:\n  ScscmResult wrapping nil on success, or :synth-not-found.\n  \n    (safe-synth-free w 1001)"},
    {"safe-synthdef-load", "safe-synthdef-load -- Load a SynthDef from binary data with error handling.\n\nParameters:\n  world_id -- Target world handle.\n  synthdef_data -- SynthDef bytecode as slice<uint8>.\n  synthdef_name -- Optional name override; nil uses the embedded name.\n\nExample:\n  ScscmResult wrapping nil on success, or :invalid-synthdef.\n  \n    (safe-synthdef-load w my-bytes \"mySynth\")"},
    {"safe-world-destroy", "safe-world-destroy -- Destroy a hcsynth world with error handling.\n\nParameters:\n  world_id -- World handle to destroy.\n\nExample:\n  ScscmResult wrapping nil on success, or :world-not-found.\n  \n    (safe-world-destroy w)"},
    {"ConnectionMonitor", "ConnectionMonitor"},
    {"connection-monitor-new", "connection-monitor-new -- Create a connection health monitor for a world.\n\nParameters:\n  world_id -- World handle to monitor.\n  ping-interval-seconds -- How often to ping, in seconds (default: 5).\n  max-failures -- Max consecutive failures before triggering reconnect (default: 3).\n  on-reconnect -- Callback invoked when a reconnect is attempted.\n\nExample:\n  A ConnectionMonitor map.\n  \n    (connection-monitor-new w 5 3 (fn [] (println \"reconnecting\")))"},
    {"check-connection", "check-connection -- Poll connection health and trigger reconnect when needed.\n\nParameters:\n  monitor -- A ConnectionMonitor map.\n  current-samples -- Current time in samples.\n\nExample:\n  true if the connection appears healthy.\n  \n    (check-connection mon (now-samples state))"},
    {"reconnect", "reconnect -- Attempt to reconnect by invoking the monitor's callback.\n\nParameters:\n  monitor -- A ConnectionMonitor map."},
    {"connection-monitor-reset", "connection-monitor-reset -- Reset ping time and failure count on a monitor.\n\nParameters:\n  monitor -- A ConnectionMonitor map."},
    {"NodeIDPool", "NodeIDPool"},
    {"node-id-pool-new", "node-id-pool-new -- Create a node ID pool starting at a given ID.\n\nParameters:\n  start -- First node ID to allocate (default: DEFAULT_NODE_ID_START).\n\nExample:\n  A NodeIDPool map.\n  \n    (node-id-pool-new 1000)"},
    {"node-id-pool-alloc", "node-id-pool-alloc -- Allocate a node ID, reusing freed IDs when available.\n\nParameters:\n  pool -- A NodeIDPool map.\n\nExample:\n  An integer node ID unique within this pool.\n  \n    (node-id-pool-alloc pool)  ; => 1000"},
    {"node-id-pool-free", "node-id-pool-free -- Return a node ID to the pool for later reuse.\n\nParameters:\n  pool -- A NodeIDPool map.\n  id -- Node ID to release.\n\nExample:\n  (node-id-pool-free pool 1003)"},
    {"retry-with-backoff", "retry-with-backoff -- Retry a thunk with exponential backoff on failure.\n\nParameters:\n  fn -- Zero-argument function that returns a ScscmResult.\n  max-attempts -- Maximum number of attempts (default: 3).\n  initial-delay -- Initial delay in samples (default: 512).\n  max-delay -- Maximum delay cap in samples (default: 5120).\n\nExample:\n  The first successful ScscmResult, or an error result after all attempts.\n  \n    (retry-with-backoff (fn [] (safe-synth-new ...)) 3)"},
    {"valid-world-id?", "valid-world-id? -- Return true if world_id is a valid non-zero handle.\n\nParameters:\n  world_id -- Candidate world handle.\n\nReturns:\n  true if valid, false otherwise."},
    {"valid-node-id?", "valid-node-id? -- Return true if node_id is a valid non-zero node ID.\n\nParameters:\n  node_id -- Candidate node ID.\n\nReturns:\n  true if valid, false otherwise."},
    {"valid-control-index?", "valid-control-index? -- Return true if a control index is within range.\n\nParameters:\n  index -- Zero-based control index to check.\n  num-controls -- Total number of controls on the synth.\n\nReturns:\n  true if 0 <= index < num-controls."},
    {"valid-synthdef-name?", "valid-synthdef-name? -- Return true if a SynthDef name is non-nil and non-empty.\n\nParameters:\n  name -- Candidate SynthDef name string.\n\nReturns:\n  true if the name can be used for lookup, false otherwise."},
    {"safe-session-new", "safe-session-new -- Create a session with error handling.\n\nParameters:\n  sample_rate -- Audio sample rate in Hz.\n  block_size -- Audio block size in samples.\n\nExample:\n  ScscmResult wrapping a new ScscmSession map on success.\n  \n    (safe-session-new 48000 512)"},
    {"safe-session-synth-new", "safe-session-synth-new -- Create a synth inside a session with error handling.\n\nParameters:\n  session -- An active ScscmSession map.\n  synthdef_name -- Name of the SynthDef to instantiate.\n  params -- Optional initial parameter map (control_index -> value).\n\nExample:\n  ScscmResult wrapping the new NodeID on success.\n  \n    (safe-session-synth-new sess \"mySynth\" {0 440.0})"},
    {"safe-session-synth-free", "safe-session-synth-free -- Free a synth inside a session with error handling.\n\nParameters:\n  session -- An active ScscmSession map.\n  node_id -- Node ID to free.\n\nExample:\n  ScscmResult wrapping nil on success, or an error keyword.\n  \n    (safe-session-synth-free sess 1001)"},
    {"TimeState", "TimeState"},
    {"time-state-new", "time-state-new -- Create a new TimeState starting at sample zero.\n\nReturns:\n  A TimeState map with samples initialized to 0."},
    {"time-advance!", "time-advance! -- Advance a TimeState forward by a given number of samples.\n\nParameters:\n  state -- A TimeState map.\n  samples -- Number of samples to advance."},
    {"now-samples", "now-samples -- Get the current sample time from a TimeState.\n\nParameters:\n  state -- A TimeState map.\n\nExample:\n  Current sample count as int64.\n  \n    (now-samples ts)  ; => 48000"},
    {"LiveSession", "LiveSession"},
    {"live-session-new", "live-session-new -- Create a new live-coding session.\n\nParameters:\n  sample_rate -- Audio sample rate in Hz (default: DEFAULT_SAMPLE_RATE).\n  block_size -- Audio block size in samples (default: DEFAULT_BLOCK_SIZE).\n\nExample:\n  A LiveSession map ready for live-coding.\n  \n    (live-session-new 48000 512)"},
    {"live-session-destroy", "live-session-destroy -- Destroy a live session and its underlying audio world.\n\nParameters:\n  session -- A LiveSession map."},
    {"synth-replace", "synth-replace -- Replace a running synth with a new definition while live.\n\nParameters:\n  session -- A LiveSession map.\n  old-node-id -- Node ID of the synth to replace.\n  new-synthdef-name -- Name of the replacement SynthDef.\n  preserve-params? -- Whether to copy parameters from old synth (default: true).\n\nExample:\n  Node ID of the new synth, or nil if old-node-id is not found.\n  \n    (synth-replace sess 1001 \"mySynthV2\")"},
    {"play-note", "play-note -- Play a MIDI note through a SynthDef with automatic cleanup.\n\nParameters:\n  session -- A LiveSession map.\n  synthdef-name -- Name of the SynthDef to use.\n  note -- MIDI note number.\n  vel -- MIDI velocity (0-127).\n  duration -- Note duration in seconds.\n\nExample:\n  Node ID of the created synth.\n  \n    (play-note sess \"mySynth\" 60 100 0.5)"},
    {"schedule-after", "schedule-after -- Enqueue a thunk to run after a sample delay.\n\nParameters:\n  session -- A LiveSession map.\n  samples -- Delay in samples (used to advance the TimeState when run).\n  thunk -- Zero-argument function to execute."},
    {"process-scheduled", "process-scheduled -- Execute the next scheduled function in the queue.\n\nParameters:\n  session -- A LiveSession map.\n  block-size -- Current block size in samples (unused; reserved for future timing)."},
    {"pattern-player-new", "pattern-player-new -- Create a pattern player that triggers events at a fixed interval.\n\nParameters:\n  session -- A LiveSession map.\n  synthdef-name -- SynthDef name to use for each triggered event.\n  pattern-fn -- Function (current-samples -> param-map) called each interval.\n  interval-samples -- Interval between triggers in samples.\n\nExample:\n  Integer player ID that can be passed to pattern-player-stop.\n  \n    (pattern-player-new sess \"kick\" (fn [_] {0 40.0}) 24000)"},
    {"pattern-player-stop", "pattern-player-stop -- Remove a pattern player so it no longer triggers.\n\nParameters:\n  session -- A LiveSession map.\n  player-id -- ID returned by pattern-player-new."},
    {"live-eval", "live-eval -- Evaluate a code string within the live-coding session context.\n\nParameters:\n  session -- A LiveSession map.\n  code -- Code string to evaluate.\n\nExample:\n  Result of evaluation (currently returns code unchanged as a stub).\n  \n    (live-eval sess \"(synth-new \\\"mySynth\\\")\")"},
    {"bpm->beats-per-sec", "bpm->beats-per-sec -- Convert beats per minute to beats per second.\n\nParameters:\n  bpm -- Tempo in beats per minute.\n\nExample:\n  Beats per second as a float.\n  \n    (bpm->beats-per-sec 120.0)  ; => 2.0"},
    {"beats->sec", "beats->sec -- Convert a beat count to seconds at a given BPM.\n\nParameters:\n  beats -- Number of beats.\n  bpm -- Tempo in beats per minute.\n\nExample:\n  Duration in seconds.\n  \n    (beats->sec 4.0 120.0)  ; => 2.0"},
    {"sec->beats", "sec->beats -- Convert seconds to a beat count at a given BPM.\n\nParameters:\n  sec -- Duration in seconds.\n  bpm -- Tempo in beats per minute.\n\nExample:\n  Number of beats.\n  \n    (sec->beats 2.0 120.0)  ; => 4.0"},
    {"play-pattern", "play-pattern -- Schedule a pattern to play at a given BPM.\n\nParameters:\n  session -- A LiveSession map.\n  synthdef-name -- SynthDef name for each triggered event.\n  pattern-fn -- Function (beats -> param-map) generating event parameters.\n  bpm -- Tempo in beats per minute.\n  interval-beats -- Interval between triggers in beats (default: 1 = every beat).\n\nExample:\n  Player ID that can be passed to pattern-player-stop.\n  \n    (play-pattern sess \"kick\" (fn [_] {0 40.0}) 120.0)"},
    {"const-pattern", "const-pattern -- Create a pattern function that always returns the same value.\n\nParameters:\n  value -- The constant param-map to return at every time step.\n\nExample:\n  Function (_ -> value).\n  \n    ((const-pattern {0 440.0}) 0)  ; => {0 440.0}"},
    {"cycle-pattern", "cycle-pattern -- Create a pattern that cycles through values by beat position.\n\nParameters:\n  values -- One or more values to cycle through.\n\nExample:\n  Function (beats -> value) that advances one step per whole beat.\n  \n    ((cycle-pattern :a :b :c) 1)  ; => :b"},
    {"every-n", "every-n -- Gate a pattern so it only fires on beat boundaries divisible by n.\n\nParameters:\n  n -- Interval in beats.\n  pattern-fn -- Pattern function (beats -> value) to delegate to.\n\nExample:\n  Gated pattern function.\n  \n    ((every-n 4 (const-pattern :kick)) 4)  ; => :kick"},
    {"live-session-render", "live-session-render -- Render a block, process scheduled callbacks, and advance time.\n\nParameters:\n  session -- A LiveSession map.\n  output_buffer -- Output buffer pointer.\n  num_samples -- Number of samples to render.\n  num_channels -- Number of output channels.\n\nExample:\n  0 on success, -1 on error.\n  \n    (live-session-render sess buf 512 2)"},
    {"osc-message", "osc-message -- Allocate a new OSC message for the given address.\n\nParameters:\n  address -- OSC address pattern string (e.g., \"/s_new\").\n\nExample:\n  Opaque pointer to the allocated message. Must be freed with osc-free!\n    if not consumed by osc-send!.\n  \n    (let [m (osc-message \"/s_new\")] (osc-free! m))"},
    {"osc-free!", "osc-free! -- Free an OSC message, ignoring nil/null pointers.\n\nParameters:\n  msg -- Opaque message pointer returned by osc-message.\n\nExample:\n  (osc-free! msg)"},
    {"osc-add!", "osc-add! -- Append a typed argument to an OSC message.\n\nParameters:\n  msg -- OSC message pointer.\n  arg -- Value to append (int32, float, cstr, or slice<uint8>).\n\nExample:\n  (osc-add! msg 440.0)"},
    {"osc-send!", "osc-send! -- Send an OSC message to a world and free it afterward.\n\nParameters:\n  world_id -- Target world handle.\n  msg -- OSC message pointer (will be freed after sending).\n\nExample:\n  0 on success, -1 on error.\n  \n    (osc-send! w msg)"},
    {"osc-send", "osc-send -- Build and send an OSC message in a single call.\n\nParameters:\n  world_id -- Target world handle.\n  address -- OSC address pattern string.\n  args -- Zero or more arguments to append to the message.\n\nExample:\n  0 on success, -1 on error.\n  \n    (osc-send w \"/s_new\" \"mySynth\" 1001 2 1)"},
    {"with-osc-message", "with-osc-message -- Build and send an OSC message with automatic cleanup.\n\nParameters:\n  msg-var -- Symbol to bind the new message pointer to.\n  address -- OSC address pattern string.\n  world_id -- Target world handle.\n  body -- Forms that add arguments or otherwise manipulate the message.\n\nExample:\n  (with-osc-message [m \"/n_set\"] w\n      (osc-add! m 1001)\n      (osc-add! m 0)\n      (osc-add! m 440.0))"},
    {"osc-ping", "osc-ping -- Send a /ping message to check server responsiveness.\n\nParameters:\n  world_id -- Target world handle.\n\nReturns:\n  0 on success, -1 on error."},
    {"osc-status", "osc-status -- Send a /status message to query server state.\n\nParameters:\n  world_id -- Target world handle.\n\nReturns:\n  0 on success, -1 on error."},
    {"osc-sync", "osc-sync -- Send a /sync message to synchronize with the server.\n\nParameters:\n  world_id -- Target world handle.\n\nReturns:\n  0 on success, -1 on error."},
    {"osc-s_new", "osc-s_new -- Send a /s_new message to instantiate a SynthDef.\n\nParameters:\n  world_id -- Target world handle.\n  synthdef_name -- Name of the SynthDef to instantiate.\n  node_id -- Node ID to assign (0 for auto-allocate).\n  add_action -- Placement action keyword or integer.\n  target -- Target node ID (typically ROOT_GROUP_ID = 1).\n  args -- Additional control parameter values.\n\nExample:\n  0 on success, -1 on error.\n  \n    (osc-s_new w \"mySynth\" 1001 2 1)"},
    {"osc-n_set", "osc-n_set -- Send a /n_set message to update control parameters on a node.\n\nParameters:\n  world_id -- Target world handle.\n  node_id -- Target synth node ID.\n  param-value-pairs -- Alternating parameter name and value pairs.\n\nExample:\n  0 on success, -1 on error.\n  \n    (osc-n_set w 1001 \"freq\" 880.0 \"amp\" 0.5)"},
    {"osc-n_free", "osc-n_free -- Send a /n_free message to stop and remove a node.\n\nParameters:\n  world_id -- Target world handle.\n  node_id -- Node ID to free.\n\nReturns:\n  0 on success, -1 on error."},
    {"osc-n_run", "osc-n_run -- Send a /n_run message to start or pause a node.\n\nParameters:\n  world_id -- Target world handle.\n  node_id -- Target node ID.\n  run? -- true to run, false to pause.\n\nReturns:\n  0 on success, -1 on error."},
    {"osc-n_free_all", "osc-n_free_all -- Send a /n_free_all message to clear every node.\n\nParameters:\n  world_id -- Target world handle.\n\nReturns:\n  0 on success, -1 on error."},
    {"osc-g_new", "osc-g_new -- Send a /g_new message to create a new group node.\n\nParameters:\n  world_id -- Target world handle.\n  node_id -- Node ID to assign (0 for auto-allocate).\n  add_action -- Placement action.\n  target -- Target node ID.\n\nExample:\n  0 on success, -1 on error.\n  \n    (osc-g_new w 100 2 1)"},
    {"osc-g_free", "osc-g_free -- Send a /g_free message to free a group node.\n\nParameters:\n  world_id -- Target world handle.\n  node_id -- Group node ID to free.\n\nReturns:\n  0 on success, -1 on error."},
    {"osc-d_load", "osc-d_load -- Send a /d_load message to load a SynthDef by name.\n\nParameters:\n  world_id -- Target world handle.\n  synthdef_name -- SynthDef name or file path.\n\nReturns:\n  0 on success, -1 on error."},
    {"osc-d_free", "osc-d_free -- Send a /d_free message to unload a SynthDef.\n\nParameters:\n  world_id -- Target world handle.\n  synthdef_name -- Name of the SynthDef to remove.\n\nReturns:\n  0 on success, -1 on error."},
    {"osc-d_recv", "osc-d_recv -- Send a /d_recv message to toggle SynthDef-receive notifications.\n\nParameters:\n  world_id -- Target world handle.\n  on? -- true to enable, false to disable.\n\nReturns:\n  0 on success, -1 on error."},
    {"osc-notify", "osc-notify -- Send a /notify message to toggle server notifications.\n\nParameters:\n  world_id -- Target world handle.\n  on? -- true to enable, false to disable.\n\nReturns:\n  0 on success, -1 on error."},
    {"osc-clear-sched", "osc-clear-sched -- Send a /clearSched message to flush the scheduler queue.\n\nParameters:\n  world_id -- Target world handle.\n\nReturns:\n  0 on success, -1 on error."},
    {"midi->hz", "midi->hz -- Convert a MIDI note number to frequency in Hz.\n\nParameters:\n  note -- MIDI note number (0-127; 69 = A4 = 440 Hz).\n\nExample:\n  Frequency in Hz as a float.\n  \n    (midi->hz 69)  ; => 440.0"},
    {"vel->amp", "vel->amp -- Convert a MIDI velocity to a linear amplitude value.\n\nParameters:\n  vel -- MIDI velocity (0-127).\n\nExample:\n  Amplitude in the range [0.0, 1.0].\n  \n    (vel->amp 127)  ; => 1.0"},
    {"db->amp", "db->amp -- Convert a decibel level to linear amplitude.\n\nParameters:\n  db -- Level in decibels (0 dB = amplitude 1.0).\n\nExample:\n  Linear amplitude as a float.\n  \n    (db->amp 0.0)  ; => 1.0"},
    {"amp->db", "amp->db -- Convert a linear amplitude to decibels.\n\nParameters:\n  amp -- Linear amplitude (must be > 0; returns -90.0 for zero).\n\nExample:\n  Level in decibels.\n  \n    (amp->db 1.0)  ; => 0.0"},
    {"warp-value", "warp-value -- Map a user-space value to OSC range using the spec's warp type.\n\nParameters:\n  spec -- A ParamSpec map containing at least :warp.\n  value -- Input value in user space.\n\nExample:\n  Warped value suitable for sending to scsynth.\n  \n    (warp-value PARAM_FREQ 440.0)  ; => 440.0 (exp warp applies octave formula)"},
    {"unwarp-value", "unwarp-value -- Map an OSC value back to user space using the spec's warp type.\n\nParameters:\n  spec -- A ParamSpec map containing at least :warp.\n  value -- Value received from scsynth in OSC space.\n\nExample:\n  Value in user space (inverse warp of warp-value).\n  \n    (unwarp-value PARAM_FREQ (warp-value PARAM_FREQ 440.0))  ; => 440.0"},
    {"clamp-value", "clamp-value -- Clamp a value to the min/max range specified in a ParamSpec.\n\nParameters:\n  spec -- A ParamSpec map with :min and :max fields.\n  value -- Value to clamp.\n\nExample:\n  The value clamped to [spec.min, spec.max].\n  \n    (clamp-value PARAM_AMP 1.5)  ; => 1.0"},
    {"param->osc", "param->osc -- Clamp and warp a user-space value ready for scsynth.\n\nParameters:\n  spec -- A ParamSpec map.\n  value -- User-space value.\n\nExample:\n  OSC-ready float (clamped first, then warped).\n  \n    (param->osc PARAM_AMP 0.8)  ; => 0.8"},
    {"osc->param", "osc->param -- Unwarp and clamp an OSC value back to user space.\n\nParameters:\n  spec -- A ParamSpec map.\n  value -- OSC value from scsynth.\n\nExample:\n  User-space float clamped to the spec's original range.\n  \n    (osc->param PARAM_AMP 0.8)  ; => 0.8"},
    {"param-spec", "param-spec -- Create a parameter specification with common defaults.\n\nParameters:\n  name -- Parameter name string (must match the SynthDef control name).\n  default -- Default value.\n  min -- Minimum value (default: 0.0).\n  max -- Maximum value (default: 1.0).\n  unit -- Unit label string, e.g. \"Hz\", \"dB\", \"sec\" (default: \"\").\n  warp -- Warp type keyword: :linear, :exp, :log, :db, :db2 (default: :linear).\n\nExample:\n  A ParamSpec map.\n  \n    (param-spec \"freq\" 440.0 20.0 20000.0 \"Hz\" :exp)"},
    {"synthdef-spec", "synthdef-spec -- Assemble a SynthDef specification from a list of ParamSpecs.\n\nParameters:\n  synthdef_name -- SynthDef name (currently unused; reserved for future metadata).\n  param-specs -- Vector of ParamSpec maps describing each control.\n\nExample:\n  SynthDefSpec (currently just the param-specs vector).\n  \n    (synthdef-spec \"mySynth\" [PARAM_FREQ PARAM_AMP])"},
    {"find-param", "find-param -- Find a ParamSpec by name within a SynthDefSpec.\n\nParameters:\n  spec -- SynthDefSpec (vector of ParamSpec maps).\n  param_name -- Parameter name to search for.\n\nExample:\n  The matching ParamSpec map, or nil if not found.\n  \n    (find-param SIN_SYNTH_SPEC \"freq\")"},
    {"find-param-index", "find-param-index -- Get the zero-based index of a parameter by name.\n\nParameters:\n  spec -- SynthDefSpec (vector of ParamSpec maps).\n  param_name -- Parameter name to search for.\n\nExample:\n  Integer index of the parameter, or nil if not found.\n  \n    (find-param-index SIN_SYNTH_SPEC \"amp\")  ; => 1"},
    {"SynthController", "SynthController"},
    {"synth-controller-new", "synth-controller-new -- Create a synth and wrap it in a typed controller.\n\nParameters:\n  session -- Parent ScscmSession.\n  synthdef-name -- Name of the SynthDef to instantiate.\n  synthdef-spec -- SynthDefSpec listing this SynthDef's parameters.\n  params -- Optional initial values as a name -> value map.\n\nExample:\n  A SynthController map. Panics if the synth cannot be created.\n  \n    (synth-controller-new sess \"mySynth\" SIN_SYNTH_SPEC {\"freq\" 880.0})"},
    {"synth-controller-free", "synth-controller-free -- Free the synth node owned by a controller.\n\nParameters:\n  ctrl -- A SynthController map."},
    {"ctrl-set", "ctrl-set -- Set a named parameter on a synth controller (with warping).\n\nParameters:\n  ctrl -- A SynthController map.\n  param_name -- Name of the parameter to set.\n  value -- User-space value (will be clamped and warped before sending).\n\nExample:\n  true if the parameter was found and set, false otherwise.\n  \n    (ctrl-set ctrl \"freq\" 880.0)"},
    {"ctrl-set-multi", "ctrl-set-multi -- Set multiple named parameters on a controller.\n\nParameters:\n  ctrl -- A SynthController map.\n  param-map -- Map of parameter name -> user-space value.\n\nExample:\n  Number of parameters successfully set.\n  \n    (ctrl-set-multi ctrl {\"freq\" 880.0 \"amp\" 0.6})  ; => 2"},
    {"ctrl-get", "ctrl-get -- Get the current value for a named parameter (returns spec default).\n\nParameters:\n  ctrl -- A SynthController map.\n  param_name -- Parameter name to look up.\n\nExample:\n  Default value from the ParamSpec, or nil if the parameter is not found.\n  \n    (ctrl-get ctrl \"freq\")  ; => 440.0 (spec default)"},
    {"bpm->bps", "bpm->bps -- Convert beats per minute to beats per second.\n\nParameters:\n  bpm -- Tempo in beats per minute.\n\nExample:\n  Tempo in beats per second.\n  \n    (bpm->bps 120.0)  ; => 2.0"},
    {"bpm->samples-per-beat", "bpm->samples-per-beat -- Convert BPM and sample rate to samples per beat.\n\nParameters:\n  bpm -- Tempo in beats per minute.\n  sample_rate -- Sample rate in Hz.\n\nExample:\n  Number of samples per beat.\n  \n    (bpm->samples-per-beat 120.0 48000)  ; => 24000.0"},
    {"const", "const -- Create a pattern that always returns the same value.\n\nParameters:\n  value -- The constant value to emit at every time step.\n\nExample:\n  Pattern<T> that wraps value in some at every beat.\n  \n    ((const 42) 0.0)  ; => (some 42)"},
    {"silence", "silence -- Create a pattern that never produces a value.\n\nExample:\n  Pattern that returns none at every time step.\n  \n    ((silence) 5.0)  ; => none"},
    {"alt", "alt -- Alternate between two patterns every whole beat.\n\nParameters:\n  a -- First pattern (used on even-numbered beats).\n  b -- Second pattern (used on odd-numbered beats).\n\nExample:\n  Pattern that alternates between a and b.\n  \n    ((alt (const 1) (const 2)) 0.0)  ; => (some 1)"},
    {"cycle", "cycle -- Cycle through a list of values, advancing one per beat.\n\nParameters:\n  values -- One or more values to cycle through.\n\nExample:\n  Pattern that returns successive values, looping indefinitely.\n  \n    ((cycle 1 2 3) 2.0)  ; => (some 3)"},
    {"fast-cycle", "fast-cycle -- Cycle through values at a scaled rate.\n\nParameters:\n  rate -- How many full cycles to complete per whole beat (>1 = faster).\n  values -- One or more values to cycle through.\n\nExample:\n  Pattern that cycles through values at the given rate.\n  \n    ((fast-cycle 2 :a :b) 0.5)  ; => (some :b)"},
    {"slow", "slow -- Slow down a pattern by a given factor.\n\nParameters:\n  factor -- How much to stretch time (>1 = slower).\n  pattern -- Source pattern to slow down.\n\nExample:\n  A new pattern that runs at 1/factor the original speed.\n  \n    ((slow 2 (cycle 1 2)) 1.0)  ; same as querying original at 0.5"},
    {"fast", "fast -- Speed up a pattern by a given factor.\n\nParameters:\n  factor -- How much to compress time (>1 = faster).\n  pattern -- Source pattern to speed up.\n\nExample:\n  A new pattern that runs at factor times the original speed.\n  \n    ((fast 2 (cycle 1 2)) 0.5)  ; same as querying original at 1.0"},
    {"every", "every -- Trigger a pattern only on beat boundaries divisible by n.\n\nParameters:\n  n -- Interval in beats.\n  pattern -- Pattern to trigger every n beats.\n\nExample:\n  Pattern that delegates to pattern when floor(t) mod n == 0.\n  \n    ((every 4 (const :kick)) 4.0)  ; => (some :kick)"},
    {"when-mod", "when-mod -- Trigger a pattern when beat position matches a modulo offset.\n\nParameters:\n  n -- Modulo base.\n  offset -- Required remainder (default: 0).\n  pattern -- Pattern to trigger on match.\n\nExample:\n  Pattern that fires when floor(t) mod n == offset.\n  \n    ((when-mod 4 2 (const :snare)) 2.0)  ; => (some :snare)"},
    {"stack", "stack -- Combine multiple patterns, collecting all values at each time step.\n\nParameters:\n  patterns -- One or more patterns to evaluate in parallel.\n\nExample:\n  Pattern that returns some<vec> containing each pattern's result.\n  \n    ((stack (const 1) (const 2)) 0.0)  ; => (some [(some 1) (some 2)])"},
    {"seq", "seq -- Cycle through patterns sequentially, one per beat.\n\nParameters:\n  patterns -- One or more patterns to sequence.\n\nExample:\n  Pattern that delegates to each sub-pattern in turn.\n  \n    ((seq (const :a) (const :b)) 1.0)  ; => (some :b)"},
    {"overlay", "overlay -- Combine patterns by summing numeric values or collecting others.\n\nParameters:\n  patterns -- One or more patterns to overlay.\n\nReturns:\n  Pattern that combines all sub-pattern values at each time step."},
    {"map-p", "map-p -- Apply a function to each value produced by a pattern.\n\nParameters:\n  fn -- Transformation function to apply to unwrapped values.\n  pattern -- Source pattern.\n\nExample:\n  New pattern with fn applied to each some-wrapped value.\n  \n    ((map-p #(* % 2) (const 5)) 0.0)  ; => (some 10)"},
    {"add-p", "add-p -- Add a constant to all numeric values in a pattern.\n\nParameters:\n  n -- Constant to add.\n  pattern -- Numeric source pattern.\n\nExample:\n  Pattern with n added to every value.\n  \n    ((add-p 12 (const 60)) 0.0)  ; => (some 72)"},
    {"mul-p", "mul-p -- Multiply all numeric values in a pattern by a constant.\n\nParameters:\n  n -- Constant multiplier.\n  pattern -- Numeric source pattern.\n\nExample:\n  Pattern with each value multiplied by n.\n  \n    ((mul-p 2.0 (const 0.5)) 0.0)  ; => (some 1.0)"},
    {"rand-choice", "rand-choice -- Create a pattern that picks a random value from a list each step.\n\nParameters:\n  values -- One or more values to choose from.\n\nExample:\n  Pattern that returns a uniformly random element at each time step.\n  \n    ((rand-choice :a :b :c) 0.0)  ; => (some :a) or :b or :c"},
    {"euclidean", "euclidean -- Generate a Euclidean rhythm pattern using Bjorklund's algorithm.\n\nParameters:\n  pulses -- Number of active steps (hits).\n  steps -- Total number of steps per cycle.\n  rotation -- Step offset to rotate the pattern (default: 0).\n\nExample:\n  Pattern<int> that returns 1 for active steps and 0 for rests.\n  \n    ((euclidean 3 8) 0.0)  ; => (some 1)  -- classic tresillo"},
    {"note-pattern", "note-pattern -- Cycle through a list of MIDI note numbers.\n\nParameters:\n  notes -- One or more MIDI note numbers.\n\nExample:\n  Pattern<int> cycling through the given notes.\n  \n    ((note-pattern 60 62 64) 1.0)  ; => (some 62)"},
    {"chord-pattern", "chord-pattern -- Cycle through chord specifications (lists of MIDI notes).\n\nParameters:\n  chords -- One or more chord specifications (each a list of MIDI note numbers).\n\nExample:\n  Pattern<list<int>> cycling through the given chords.\n  \n    ((chord-pattern [60 64 67] [62 65 69]) 1.0)  ; => (some [62 65 69])"},
    {"arpeggio", "arpeggio -- Arpeggiate a chord in a given direction.\n\nParameters:\n  chord -- List of MIDI note numbers forming the chord.\n  direction -- :up, :down, :up-down, or :random (default: :up).\n\nExample:\n  Pattern<int> that steps through the chord notes in the chosen order.\n  \n    ((arpeggio [60 64 67] :up) 2.0)  ; => (some 67)"},
    {"scale-pattern", "scale-pattern -- Cycle through scale degrees starting from a tonic note.\n\nParameters:\n  scale -- Scale as a list of semitone offsets from root.\n  tonic -- Base MIDI note number (default: 60 = middle C).\n\nExample:\n  Pattern<int> returning absolute MIDI notes.\n  \n    ((scale-pattern MAJOR_SCALE 60) 0.0)  ; => (some 60)"},
    {"vel-pattern", "vel-pattern -- Cycle through a list of MIDI velocity values.\n\nParameters:\n  velocities -- One or more velocity values (0-127).\n\nExample:\n  Pattern<int> cycling through the given velocities.\n  \n    ((vel-pattern 64 96 80) 1.0)  ; => (some 96)"},
    {"accent", "accent -- Apply a velocity accent multiplier pattern to a note pattern.\n\nParameters:\n  pattern -- Base velocity pattern (values 0-127).\n  accent-pattern -- Pattern returning multipliers in [0, 1]; nil defaults to 1.0.\n\nExample:\n  Pattern<int> with velocities scaled and clamped to [0, 127].\n  \n    ((accent (vel-pattern 100) (cycle 1.0 0.5)) 1.0)  ; => (some 50)"},
    {"PatternPlayer", "PatternPlayer"},
    {"pattern-player-step", "pattern-player-step -- Evaluate one step of a pattern player and reschedule.\n\nParameters:\n  player -- A PatternPlayer map."},
    {"play", "play -- Start a pattern playing through a SynthDef at a given BPM.\n\nParameters:\n  session -- LiveSession to play into.\n  synthdef-name -- Name of the SynthDef to use for each event.\n  pattern -- Pattern function: beats -> option<param-map>.\n  bpm -- Tempo in beats per minute.\n  interval-beats -- Pattern resolution in beats (default: 0.25 = 16th note).\n\nExample:\n  A PatternPlayer map.\n  \n    (play sess \"kick\" (every 1 (const {0 40.0})) 120.0)"},
    {"kick-pattern", "kick-pattern -- Simple bass drum pattern: kick on every beat.\n\nParameters:\n  bpm -- Tempo (currently unused; present for API symmetry).\n\nReturns:\n  Pattern that triggers kick parameters every beat."},
    {"snare-pattern", "snare-pattern -- Snare pattern: hit on beats 2 and 4.\n\nParameters:\n  bpm -- Tempo (currently unused; present for API symmetry).\n\nReturns:\n  Pattern that triggers snare parameters every 2 beats."},
    {"hat-pattern", "hat-pattern -- Hi-hat pattern at 16th-note resolution.\n\nParameters:\n  bpm -- Tempo (currently unused; present for API symmetry).\n\nReturns:\n  Pattern that triggers hi-hat parameters every quarter beat."},
    {"melody-pattern", "melody-pattern -- Melodic pattern stepping through a scale from a tonic.\n\nParameters:\n  bpm -- Tempo (currently unused; present for API symmetry).\n  scale -- Scale as a list of semitone offsets.\n  tonic -- Root MIDI note.\n\nReturns:\n  Pattern that returns {freq amp} maps using MIDI-to-Hz conversion."},
    {"synth-set-inline", "synth-set-inline -- Set a synth control parameter via inline C for minimum overhead.\n\nParameters:\n  world_id -- World handle.\n  node_id -- Target node ID.\n  control_index -- Zero-based control index.\n  value -- Value to set.\n\nReturns:\n  0 on success, -1 on error."},
    {"synth-new-inline", "synth-new-inline -- Create a synth node via inline C for minimum overhead.\n\nParameters:\n  world_id -- World handle.\n  synthdef_name -- SynthDef name to instantiate.\n  node_id -- Node ID to assign.\n  action -- Add action constant (e.g. ADD_TO_TAIL).\n  target_id -- Target node ID.\n\nReturns:\n  0 on success, -1 on error."},
    {"synth-free-inline", "synth-free-inline -- Free a synth node via inline C for minimum overhead.\n\nParameters:\n  world_id -- World handle.\n  node_id -- Node ID to free.\n\nReturns:\n  0 on success, -1 on error."},
    {"batch-operations", "batch-operations -- Execute a vector of synth operations in a single pass.\n\nParameters:\n  world_id -- World handle.\n  operations -- Vector of operation maps. Supported types:\n   -- {:type :set  :node_id id :index idx :value val}\n   -- {:type :free :node_id id}\n   -- {:type :new  :synthdef_name name :node_id id\n   -- :action act :target_id tid}\n\nExample:\n  0 on success, -1 on first error.\n  \n    (batch-operations w [{:type :set :node_id 1001 :index 0 :value 440.0}\n                         {:type :free :node_id 1000}])"},
    {"BufferPool", "BufferPool"},
    {"buffer-pool-new", "buffer-pool-new -- Pre-allocate a pool of fixed-size byte buffers.\n\nParameters:\n  num-buffers -- Number of buffers to allocate up front.\n  buffer-size -- Size of each buffer in bytes.\n\nExample:\n  A BufferPool map.\n  \n    (buffer-pool-new 32 4096)"},
    {"buffer-pool-get", "buffer-pool-get -- Obtain a buffer from the pool without allocating.\n\nParameters:\n  pool -- A BufferPool map.\n\nExample:\n  Pointer to an available buffer, or nil if the pool is exhausted.\n  \n    (let [buf (buffer-pool-get pool)] ...)"},
    {"buffer-pool-return", "buffer-pool-return -- Return a buffer to the pool for reuse.\n\nParameters:\n  pool -- A BufferPool map.\n  buffer -- Pointer previously obtained from buffer-pool-get."},
    {"buffer-pool-destroy", "buffer-pool-destroy -- Free all memory held by a buffer pool.\n\nParameters:\n  pool -- A BufferPool map. Do not use pool after calling this."},
    {"osc-send-inline", "osc-send-inline -- Build and dispatch an OSC message in a single inline-C call.\n\nParameters:\n  world_id -- World handle.\n  address -- OSC address string.\n  num-args -- Number of arguments in args.\n  args -- Array of interleaved type-tag and value pairs.\n\nReturns:\n  0 on success, -1 on error."},
    {"synth-set-multi-inline", "synth-set-multi-inline -- Set multiple control parameters via inline C.\n\nParameters:\n  world_id -- World handle.\n  node_id -- Target node ID.\n  count -- Number of index/value pairs.\n  indices -- Pointer to array of int control indices.\n  values -- Pointer to array of float control values.\n\nReturns:\n  0 on success, -1 on error."},
    {"RenderBuffer", "RenderBuffer"},
    {"render-buffer-new", "render-buffer-new -- Allocate a reusable audio render buffer.\n\nParameters:\n  size -- Buffer size in samples per channel.\n  channels -- Number of audio channels.\n\nExample:\n  A RenderBuffer map backed by a malloc'd float array.\n  \n    (render-buffer-new 512 2)"},
    {"render-buffer-destroy", "render-buffer-destroy -- Free the memory held by a render buffer.\n\nParameters:\n  buffer -- A RenderBuffer map. Do not use after calling this."},
    {"world-render-fast", "world-render-fast -- Render audio into a pre-allocated RenderBuffer.\n\nParameters:\n  world_id -- World handle.\n  buffer -- Pre-allocated RenderBuffer to write into.\n  num_samples -- Number of samples to render.\n\nExample:\n  0 on success, -1 on error.\n  \n    (world-render-fast w rb 512)"},
    {"benchmark", "benchmark -- Measure the execution time of a zero-argument function.\n\nParameters:\n  fn -- Zero-argument function to benchmark.\n  iterations -- Number of timed iterations.\n  warmup -- Number of warmup iterations (default: 10).\n\nExample:\n  Map with :total-ns, :avg-ns, and :iterations.\n  \n    (benchmark (fn [] (ffi/hc_wasm_synth_set w n 0 0.5)) 1000)"},
    {"bench-synth-set", "bench-synth-set -- Benchmark single-parameter synth-set throughput.\n\nParameters:\n  world_id -- World handle.\n  node_id -- Node to use for the benchmark.\n  iterations -- Number of timed iterations.\n\nReturns:\n  Benchmark result map from benchmark."},
    {"bench-synth-new", "bench-synth-new -- Benchmark synth creation/destruction throughput.\n\nParameters:\n  world_id -- World handle.\n  synthdef_name -- SynthDef name to instantiate.\n  iterations -- Number of timed iterations.\n\nReturns:\n  Benchmark result map from benchmark."},
    {"SynthDefCache", "SynthDefCache"},
    {"synthdef-cache-new", "synthdef-cache-new -- Create an empty SynthDef metadata cache.\n\nReturns:\n  An empty SynthDefCache map."},
    {"synthdef-cache-get", "synthdef-cache-get -- Retrieve SynthDef info from cache, loading it if absent.\n\nParameters:\n  cache -- A SynthDefCache map.\n  world_id -- World handle.\n  synthdef_name -- Name of the SynthDef to look up.\n\nExample:\n  Cached info map, or nil if the SynthDef is not available.\n  \n    (synthdef-cache-get cache w \"mySynth\")"},
    {"PerfSession", "PerfSession"},
    {"perf-session-new", "perf-session-new -- Create a performance-optimized session.\n\nParameters:\n  sample_rate -- Audio sample rate in Hz.\n  block_size -- Audio block size in samples.\n  num-channels -- Number of output audio channels.\n\nExample:\n  A PerfSession map.\n  \n    (perf-session-new 48000 512 2)"},
    {"perf-session-destroy", "perf-session-destroy -- Destroy a performance session and free its resources.\n\nParameters:\n  session -- A PerfSession map."},
    {"perf-session-synth-new", "perf-session-synth-new -- Create a synth in a perf session using inline C.\n\nParameters:\n  session -- A PerfSession map.\n  synthdef_name -- SynthDef name to instantiate.\n\nExample:\n  NodeID of the created synth.\n  \n    (perf-session-synth-new sess \"mySynth\")"},
    {"perf-session-synth-set", "perf-session-synth-set -- Set a control parameter in a perf session using inline C.\n\nParameters:\n  session -- A PerfSession map.\n  node_id -- Target node ID.\n  index -- Zero-based control index.\n  value -- New control value."},
    {"perf-session-synth-free", "perf-session-synth-free -- Free a synth in a perf session using inline C.\n\nParameters:\n  session -- A PerfSession map.\n  node_id -- Node ID to free."},
    {"perf-session-render", "perf-session-render -- Render audio for a perf session.\n\nParameters:\n  session -- A PerfSession map.\n  num_samples -- Number of samples to render.\n\nReturns:\n  0 on success, -1 on error."},
    {"world-create", "world-create -- Create a new audio engine (world) instance.\n\nParameters:\n  sample_rate -- Sample rate in Hz (default: DEFAULT_SAMPLE_RATE = 48000).\n  block_size -- Block size in samples (default: DEFAULT_BLOCK_SIZE = 512).\n\nExample:\n  WorldHandle (int), or 0 on error.\n  \n    (world-create 48000 512)  ; => <handle>"},
    {"world-destroy", "world-destroy -- Destroy an audio engine instance and free its resources.\n\nParameters:\n  world_id -- World handle returned by world-create.\n\nExample:\n  0 on success, -1 on error.\n  \n    (world-destroy w)"},
    {"world-sample-rate", "world-sample-rate -- Get the sample rate of an audio engine instance.\n\nParameters:\n  world_id -- World handle.\n\nReturns:\n  Sample rate in Hz, or 0 if the world is not found."},
    {"world-block-size", "world-block-size -- Get the block size of an audio engine instance.\n\nParameters:\n  world_id -- World handle.\n\nReturns:\n  Block size in samples, or 0 if the world is not found."},
    {"synthdef-load", "synthdef-load -- Load a compiled SynthDef from binary data.\n\nParameters:\n  world_id -- Target world handle.\n  synthdef_data -- SynthDef bytecode as slice<uint8>.\n  synthdef_name -- Optional name override; nil uses the name embedded in the data.\n\nExample:\n  0 on success, -1 on error.\n  \n    (synthdef-load w my-bytes \"mySynth\")"},
    {"synthdef-unload", "synthdef-unload -- Remove a SynthDef from the world by name.\n\nParameters:\n  world_id -- Target world handle.\n  synthdef_name -- Name of the SynthDef to remove.\n\nExample:\n  0 on success, -1 on error.\n  \n    (synthdef-unload w \"mySynth\")"},
    {"synthdef-unload-all", "synthdef-unload-all -- Remove all SynthDefs from the world.\n\nParameters:\n  world_id -- Target world handle.\n\nReturns:\n  0 on success, -1 on error."},
    {"synthdef-list", "synthdef-list -- Get a comma-separated list of loaded SynthDef names.\n\nParameters:\n  world_id -- Target world handle.\n  buffer_size -- Size of internal buffer in bytes (determines max output length).\n\nExample:\n  String of comma-separated SynthDef names. Panics on error.\n  \n    (synthdef-list w 1024)  ; => \"mySynth,anotherSynth\""},
    {"synth-new", "synth-new -- Create a new synth instance from a SynthDef.\n\nParameters:\n  world_id -- Target world handle.\n  synthdef_name -- Name of the SynthDef to instantiate.\n  node_id -- Unique node ID to assign (must not be 0).\n  target_id -- Target node/group ID (default: ROOT_GROUP_ID = 1).\n  action -- Placement action (default: ADD_TO_TAIL).\n\nExample:\n  0 on success, -1 on error.\n  \n    (synth-new w \"mySynth\" 1001)"},
    {"synth-free", "synth-free -- Remove and stop a synth node.\n\nParameters:\n  world_id -- Target world handle.\n  node_id -- Node ID to free.\n\nExample:\n  0 on success, -1 on error.\n  \n    (synth-free w 1001)"},
    {"synth-set", "synth-set -- Set a single control parameter on a synth node.\n\nParameters:\n  world_id -- Target world handle.\n  node_id -- Target synth node ID.\n  control_index -- Zero-based control index.\n  value -- New control value.\n\nExample:\n  0 on success, -1 on error.\n  \n    (synth-set w 1001 0 440.0)"},
    {"synth-set-multi", "synth-set-multi -- Set multiple control parameters on a synth in one call.\n\nParameters:\n  world_id -- Target world handle.\n  node_id -- Target synth node ID.\n  param-map -- Map of control_index (int) -> value (float).\n\nExample:\n  0 on success, -1 on error.\n  \n    (synth-set-multi w 1001 {0 440.0 1 0.8})"},
    {"synth-set-by-name", "synth-set-by-name -- Set control parameters by name (not yet implemented).\n\nParameters:\n  world_id -- Target world handle.\n  node_id -- Target synth node ID.\n  synthdef_name -- SynthDef name used for parameter lookup.\n  param-name-value-pairs -- Alternating parameter name and value arguments."},
    {"group-new", "group-new -- Create a new node group.\n\nParameters:\n  world_id -- Target world handle.\n  node_id -- Unique node ID to assign.\n  target_id -- Parent node/group ID (default: ROOT_GROUP_ID).\n  action -- Placement action (default: ADD_TO_TAIL).\n\nExample:\n  0 on success, -1 on error.\n  \n    (group-new w 100)"},
    {"group-free", "group-free -- Free a group node and all its children.\n\nParameters:\n  world_id -- Target world handle.\n  node_id -- Group node ID to free.\n\nExample:\n  0 on success, -1 on error.\n  \n    (group-free w 100)"},
    {"world-render", "world-render -- Render one block of audio to an output buffer.\n\nParameters:\n  world_id -- Target world handle.\n  output_buffer -- Output buffer pointer (must hold num_samples * num_channels floats).\n  num_samples -- Number of samples to render (default: world block size).\n  num_channels -- Number of output channels (default: 2).\n\nExample:\n  0 on success, -1 on error.\n  \n    (world-render w buf)"},
    {"world-process-controls", "world-process-controls -- Drain the command queue and apply pending control changes.\n\nParameters:\n  world_id -- Target world handle.\n  max_messages -- Maximum messages to process per call (default: -1 = all).\n\nReturns:\n  Number of messages processed, or -1 on error."},
    {"world-reset", "world-reset -- Clear all nodes and reset engine state.\n\nParameters:\n  world_id -- Target world handle.\n\nReturns:\n  0 on success, -1 on error."},
    {"world-get-status", "world-get-status -- Get engine statistics as a JSON string.\n\nParameters:\n  world_id -- Target world handle.\n\nExample:\n  JSON string with engine stats. Returns \"{}\" on error.\n  \n    (world-get-status w)  ; => \"{\\\"cpu\\\":0.02,...}\""},
    {"world-get-metrics", "world-get-metrics -- Get performance metrics for a world.\n\nParameters:\n  world_id -- Target world handle.\n\nExample:\n  Map with :cpu_percent, :xruns, and :buffer_used. Returns zeros on error.\n  \n    (:cpu_percent (world-get-metrics w))"},
    {"world-reset-metrics", "world-reset-metrics -- Reset accumulated performance counters.\n\nParameters:\n  world_id -- Target world handle.\n\nReturns:\n  0 on success, -1 on error."},
    {"list-ugens", "list-ugens -- Get a newline-separated list of all registered UGen names.\n\nExample:\n  String of newline-separated UGen names, or \"\" on error.\n  \n    (println (list-ugens))"},
    {"NodeIDAllocator", "NodeIDAllocator"},
    {"node-id-allocator-new", "node-id-allocator-new -- Create a simple monotonically-incrementing node ID allocator.\n\nParameters:\n  start -- First ID to issue (default: DEFAULT_NODE_ID_START).\n\nReturns:\n  A NodeIDAllocator map."},
    {"node-id-alloc", "node-id-alloc -- Allocate the next node ID from an allocator.\n\nParameters:\n  allocator -- A NodeIDAllocator map.\n\nReturns:\n  A unique integer node ID."},
    {"node-id-free", "node-id-free -- Mark a node ID as released (no-op in the simple allocator).\n\nParameters:\n  allocator -- A NodeIDAllocator map.\n  id -- Node ID to release."},
    {"ScscmSession", "ScscmSession"},
    {"session-new", "session-new -- Create a new SCSCM session backed by a fresh audio world.\n\nParameters:\n  sample_rate -- Audio sample rate in Hz (default: DEFAULT_SAMPLE_RATE).\n  block_size -- Audio block size in samples (default: DEFAULT_BLOCK_SIZE).\n\nExample:\n  A ScscmSession map. Panics if the world cannot be created.\n  \n    (session-new 48000 512)"},
    {"session-destroy", "session-destroy -- Destroy a session and its underlying audio world.\n\nParameters:\n  session -- A ScscmSession map.\n\nReturns:\n  The (now-invalid) session map."},
    {"session-synth-new", "session-synth-new -- Instantiate a SynthDef and register it in the session.\n\nParameters:\n  session -- A ScscmSession map.\n  synthdef_name -- Name of the SynthDef to instantiate.\n  params -- Optional initial parameter map (control_index -> value).\n\nExample:\n  NodeID of the created synth. Panics if creation fails.\n  \n    (session-synth-new sess \"mySynth\" {0 440.0 1 0.8})"},
    {"session-synth-free", "session-synth-free -- Free a synth node and remove it from the session.\n\nParameters:\n  session -- A ScscmSession map.\n  node_id -- Node ID to free."},
    {"session-synth-set", "session-synth-set -- Set multiple control parameters on a session synth.\n\nParameters:\n  session -- A ScscmSession map.\n  node_id -- Target synth node ID.\n  params -- Parameter map (control_index -> value)."},
    {"session-free-all", "session-free-all -- Free every active synth in the session.\n\nParameters:\n  session -- A ScscmSession map."},
    {"session-render", "session-render -- Render audio for a session.\n\nParameters:\n  session -- A ScscmSession map.\n  output_buffer -- Output buffer pointer.\n  num_samples -- Number of samples to render (optional, defaults to block size).\n  num_channels -- Number of output channels (default: 2).\n\nReturns:\n  0 on success, -1 on error."},
    {"session-process-controls", "session-process-controls -- Drain the control queue for a session.\n\nParameters:\n  session -- A ScscmSession map.\n  max_messages -- Maximum messages to process (default: -1 = all).\n\nReturns:\n  Number of messages processed, or -1 on error."},
    {"ParamSpec", "ParamSpec"},
    {"sec->samples", "sec->samples -- Convert seconds to sample count.\n\nParameters:\n  sec -- Duration in seconds.\n  sample_rate -- Sample rate in Hz.\n\nExample:\n  Number of samples corresponding to the given duration.\n  \n    (sec->samples 1.0 48000)  ; => 48000.0"},
    {"samples->sec", "samples->sec -- Convert sample count to seconds.\n\nParameters:\n  samples -- Number of samples.\n  sample_rate -- Sample rate in Hz.\n\nExample:\n  Duration in seconds.\n  \n    (samples->sec 48000 48000)  ; => 1.0"},
    {"ms->samples", "ms->samples -- Convert milliseconds to sample count.\n\nParameters:\n  ms -- Duration in milliseconds.\n  sample_rate -- Sample rate in Hz.\n\nExample:\n  Number of samples corresponding to the given duration.\n  \n    (ms->samples 500.0 48000)  ; => 24000.0"},
    {"samples->ms", "samples->ms -- Convert sample count to milliseconds.\n\nParameters:\n  samples -- Number of samples.\n  sample_rate -- Sample rate in Hz.\n\nExample:\n  Duration in milliseconds.\n  \n    (samples->ms 24000 48000)  ; => 500.0"},
    {"__select_op_recv", "__select_op_recv -- internal constant: recv operation code (0).\n\nSince: Phase T19-D"},
    {"__select_op_send", "__select_op_send -- internal constant: send operation code (1).\n\nSince: Phase T19-D"},
    {"__select_clauses_alloc", "__select_clauses_alloc -- allocate a zeroed SelectClause array of length n.\n\nSince: Phase T19-D"},
    {"__select_clauses_free", "__select_clauses_free -- free a SelectClause array allocated by __select_clauses_alloc.\n\nSince: Phase T19-D"},
    {"__select_exec", "__select_exec -- execute a select over n channel clauses; return the index of the clause that fired.\n\nParameters:\n  clauses -- SelectClause array from __select_clauses_alloc\n  n -- number of clauses in the array\n  has_default -- 1 if a :default arm is present, 0 otherwise\n\nSince: Phase T19-D"},
    {"bytes-alloc", "bytes-alloc -- allocate a zeroed length-prefixed byte buffer of n bytes.\n\nParameters:\n  n -- number of data bytes to allocate (not counting the 8-byte length prefix)\n\nSince: Phase 21"},
    {"bytes-len", "bytes-len -- return the number of data bytes stored in a bytes value.\n\nParameters:\n  b -- bytes pointer from bytes-alloc or a serialize call\n\nSince: Phase 21"},
    {"bytes-data", "bytes-data -- return a raw pointer to the data region of a bytes value (past the length prefix).\n\nParameters:\n  b -- bytes pointer from bytes-alloc or a serialize call\n\nSince: Phase 21"},
    {"bytes-free", "bytes-free -- free a bytes value allocated by bytes-alloc or serialize.\n\nParameters:\n  b -- bytes pointer to free\n\nSince: Phase 21"},
    {"bytes-concat", "bytes-concat -- concatenate two bytes values into a new heap-allocated bytes value.\n\nParameters:\n  a -- first bytes value (may be null, treated as empty)\n  b -- second bytes value (may be null, treated as empty)\n\nSince: Phase 21"},
    {"Serializable", "Serializable [int] -- serialize/deserialize int64 as 8 little-endian bytes.\n\nSince: Phase 21"},
    {"cont-to-file", "cont-to-file -- write a serialised continuation bytes value to a file.\n\nParameters:\n  b -- bytes value from serial-cont->bytes / save-cont!\n  path -- filesystem path to write (overwritten if it exists)\n\nSince: Phase 21"},
    {"cont-from-file", "cont-from-file -- read a serialised continuation bytes value from a file.\n\nParameters:\n  path -- filesystem path previously written by cont-to-file\n\nSince: Phase 21"},
    {"constant", "constant -- create a signal that always returns the same value.\n\nParameters:\n  val -- the constant value to emit at every time point\n\nExample:\n  A function Time -> a that ignores time and returns val.\n  \n    ((constant 0.5) 2.0)  ; => 0.5"},
    {"time-signal", "time-signal -- a signal that returns the current time at each sample.\n\nExample:\n  Signal<Time> whose value equals the query time t.\n  \n    (time-signal 2.0)  ; => 2.0"},
    {"sample", "sample -- evaluate a signal at a specific time point.\n\nParameters:\n  sig -- the Signal to query\n  t -- the time point at which to sample\n\nExample:\n  The signal value of type a at time t.\n  \n    (sample (constant 3.0) 0.0)  ; => 3.0"},
    {"map-signal", "map-signal -- lift a pure function to operate on signals pointwise.\n\nParameters:\n  f -- function from a to b\n  sig -- input signal of type Signal<a>\n\nExample:\n  Signal<b> where each sample is f applied to the corresponding input sample.\n  \n    (map-signal (fn [x] (* x 2.0)) my-sig)"},
    {"pair-signals", "pair-signals -- zip two signals into a product signal.\n\nParameters:\n  sig-a -- first signal\n  sig-b -- second signal\n\nExample:\n  A signal whose value at time t is a Pair of both signals' values.\n  \n    (pair-signals freq-sig amp-sig)"},
    {"left-signal", "left-signal -- inject a signal into the Left branch.\n\nParameters:\n  sig-a -- signal to inject\n\nReturns:\n  A signal whose samples are (sig-a t).\n  \n  Note: Returns the raw signal value since Left/Either are not yet implemented."},
    {"right-signal", "right-signal -- inject a signal into the Right branch.\n\nParameters:\n  sig-b -- signal to inject\n\nReturns:\n  A signal whose samples are (sig-b t).\n  \n  Note: Returns the raw signal value since Right/Either are not yet implemented."},
    {"__signal_call1", "__signal_call1 -- call a signal (function of time) at time t."},
    {"__dsp_sin", "__dsp_sin -- compute sine of angle in radians."},
    {"__dsp_fmod", "__dsp_fmod -- compute floating-point modulo."},
    {"sine", "sine -- sine-wave oscillator Signal Function.\n\nParameters:\n  freq -- frequency in Hz (float64)\n  phase -- initial phase offset in radians (float64)\n\nExample:\n  A Signal Function: sig -> (fn [t] sin(2*pi*freq*t + phase)).\n  \n    (sine 440.0 0.0)  ; => 440 Hz sine wave SF"},
    {"square", "square -- square-wave oscillator Signal Function.\n\nParameters:\n  freq -- frequency in Hz (float64)\n  dutycycle -- duty cycle in [0,1] (float64)\n\nExample:\n  A Signal Function: sig -> (fn [t] 1.0 if phase < duty else -1.0).\n  \n    (square 440.0 0.5)  ; => 440 Hz square wave SF"},
    {"sawtooth", "sawtooth -- sawtooth-wave oscillator Signal Function.\n\nParameters:\n  freq -- frequency in Hz (float64)\n\nExample:\n  A Signal Function: sig -> (fn [t] frac(freq*t) in [0,1)).\n  \n    (sawtooth 440.0)  ; => 440 Hz sawtooth wave SF"},
    {"low-pass", "low-pass -- first-order IIR low-pass filter Signal Function.\n\nParameters:\n  alpha -- smoothing coefficient in (0,1); lower = more smoothing.\n\nExample:\n  A Signal Function that smooths the input signal.\n  \n    (low-pass 0.5)  ; => SF applying EMA with alpha=0.5"},
    {"high-pass", "high-pass -- first-order IIR high-pass filter Signal Function.\n\nParameters:\n  alpha -- filter coefficient in (0,1).\n\nExample:\n  A Signal Function applying high-pass filtering.\n  \n    (high-pass 0.5)  ; => high-pass SF with alpha=0.5"},
    {"gain", "gain -- scale a signal by a constant factor.\n\nParameters:\n  g -- gain factor (float64)\n\nExample:\n  A Signal Function that multiplies each sample by g.\n  \n    ((gain 2.0) my-sig)  ; => signal scaled by 2.0"},
    {"mix", "mix -- weighted mix of a pair signal.\n\nParameters:\n  alpha -- mix coefficient in [0,1]: 0 = all first, 1 = all second.\n\nExample:\n  A Signal Function on Pair signals: out = alpha*a + (1-alpha)*b.\n  \n    ((mix 0.5) (pair-signals sig-a sig-b))  ; => equal mix"},
    {"add", "add -- sum a pair signal sample-wise.\n\nExample:\n  A Signal Function on Pair signals: out = a + b.\n  \n    ((add) (pair-signals sig-a sig-b))  ; => sum signal"},
    {"ADSRParams", "ADSRParams -- parameters for an ADSR envelope."},
    {"__adsr_attack", "__adsr_attack -- extract attack field from ADSRParams struct pointer."},
    {"__adsr_decay", "__adsr_decay -- extract decay field from ADSRParams struct pointer."},
    {"__adsr_sustain", "__adsr_sustain -- extract sustain field from ADSRParams struct pointer."},
    {"__adsr_release", "__adsr_release -- extract release field from ADSRParams struct pointer."},
    {"__adsr_fixed_sample", "__adsr_fixed_sample -- compute ADSR envelope value at time t."},
    {"adsr-fixed", "adsr-fixed -- piecewise-linear ADSR computed analytically for a single note.\n\nParameters:\n  params -- ADSRParams controlling shape\n  gate-duration -- how long the gate stays on in seconds (float64)\n\nExample:\n  A Signal Function: sig -> (fn [t] envelope-value).\n  \n    ((adsr-fixed (ADSRParams 0.01 0.1 0.7 0.3) 0.5) (constant ()))"},
    {"voice", "voice -- subtractive synthesizer voice: oscillator -> filter -> envelope.\n\nParameters:\n  freq -- frequency in Hz\n  params -- ADSRParams for the amplitude envelope\n  gate-sig -- Signal<bool> controlling note on/off\n  filter-cutoff -- SVF cutoff frequency (normalised 0.0 to 1.0)\n  filter-q -- SVF resonance\n\nExample:\n  Signal<Sample> ready to be summed into a mix bus.\n  \n    (voice 440.0 (ADSRParams 0.01 0.1 0.7 0.2) gate-sig 0.6 0.5)"},
    {"voice-sf", "voice-sf -- SF wrapper around voice for arrow-based composition.\n\nParameters:\n  freq -- frequency in Hz\n  params -- ADSRParams\n  filter-cutoff -- normalised cutoff\n  filter-q -- resonance\n\nReturns:\n  SF<Tuple () bool, Sample> where the bool lane carries the gate."},
    {"poly-synth", "poly-synth -- polyphonic synthesizer mixing multiple voices.\n\nParameters:\n  voices -- vector of (freq, gate-signal) tuples, one per voice\n  params -- ADSRParams shared by all voices\n  filter-cutoff -- shared filter cutoff\n  filter-q -- shared filter resonance\n\nExample:\n  Signal<Sample> summing all active voices.\n  \n    (poly-synth (vec-of (Tuple 261.0 gate1) (Tuple 329.0 gate2)) params 0.6 0.4)"},
    {"fm-voice", "fm-voice -- two-operator FM voice.\n\nParameters:\n  carrier-freq -- carrier oscillator frequency in Hz\n  modulator-freq -- modulator oscillator frequency in Hz\n  mod-index -- modulation index (depth of FM)\n  params -- ADSRParams for amplitude and modulator envelopes\n  gate-sig -- Signal<bool> controlling note on/off\n\nExample:\n  Signal<Sample> with FM-processed output.\n  \n    (fm-voice 440.0 880.0 2.0 (ADSRParams 0.01 0.1 0.7 0.3) gate-sig)"},
    {"wavetable-osc", "wavetable-osc -- wavetable oscillator with linear interpolation.\n\nParameters:\n  wavetable -- pre-computed waveform table (one cycle)\n  freq -- playback frequency in Hz\n\nExample:\n  SF<(),Sample> reading from the wavetable at the requested frequency.\n  \n    ((wavetable-osc (sine-wavetable 2048) 440.0) (constant ()))"},
    {"sine-wavetable", "sine-wavetable -- generate a sine-wave lookup table.\n\nParameters:\n  size -- number of samples in the table\n\nExample:\n  vec<Sample> containing one cycle of a sine wave.\n  \n    (sine-wavetable 2048)"},
    {"square-wavetable", "square-wavetable -- generate a square-wave lookup table.\n\nParameters:\n  size -- number of samples in the table\n  duty -- duty cycle (0.0 to 1.0)\n\nReturns:\n  vec<Sample> containing one cycle of a square wave."},
    {"sawtooth-wavetable", "sawtooth-wavetable -- generate a sawtooth-wave lookup table.\n\nParameters:\n  size -- number of samples in the table\n\nReturns:\n  vec<Sample> containing one cycle of a sawtooth wave in [-1, 1)."},
    {"wavetable-voice", "wavetable-voice -- wavetable oscillator with ADSR amplitude envelope.\n\nParameters:\n  wavetable -- pre-computed waveform table\n  freq -- frequency in Hz\n  params -- ADSRParams\n  gate-sig -- Signal<bool>\n\nReturns:\n  Signal<Sample>."},
    {"granular", "granular -- simple granular synthesizer creating overlapping grain clouds.\n\nParameters:\n  source -- source audio signal to granulate\n  grain-duration -- duration of each grain in seconds\n  grain-rate -- grains spawned per second\n  randomness -- position randomisation amount (0.0 to 1.0)\n\nExample:\n  Signal<Sample> mixing all active grains.\n  \n    (granular my-sig 0.05 20.0 0.3)"},
    {"additive-voice", "additive-voice -- additive synthesizer summing weighted harmonic sine waves.\n\nParameters:\n  base-freq -- fundamental frequency in Hz\n  harmonics -- vector of (amplitude, frequency-multiple) tuples\n  params -- ADSRParams for the overall amplitude envelope\n  gate-sig -- Signal<bool>\n\nExample:\n  Signal<Sample> summing all harmonics, shaped by the envelope.\n  \n    (additive-voice 220.0 (vec-of (Tuple 1.0 1.0) (Tuple 0.5 2.0)) params gate-sig)"},
    {"karplus-strong", "karplus-strong -- plucked string synthesis using a feedback delay line.\n\nParameters:\n  freq -- fundamental frequency in Hz\n  decay -- decay factor per averaging step (close to 1.0 for long sustain)\n  noise-duration -- duration of the initial noise burst in seconds\n\nExample:\n  Signal<Sample> simulating a plucked string.\n  \n    (karplus-strong 261.63 0.995 0.01)"},
    {"ks-voice", "ks-voice -- Karplus-Strong string with ADSR amplitude envelope.\n\nParameters:\n  freq -- frequency in Hz\n  decay -- per-sample decay factor\n  noise-duration -- noise burst duration in seconds\n  params -- ADSRParams\n  gate-sig -- Signal<bool>\n\nReturns:\n  Signal<Sample>."},
    {"lead-synth", "lead-synth -- bright cutting lead synth preset.\n\nParameters:\n  freq -- frequency in Hz\n  gate-sig -- Signal<bool>\n\nReturns:\n  Signal<Sample>."},
    {"bass-synth", "bass-synth -- deep warm bass synth preset.\n\nParameters:\n  freq -- frequency in Hz\n  gate-sig -- Signal<bool>\n\nReturns:\n  Signal<Sample>."},
    {"pad-synth", "pad-synth -- soft evolving pad synth preset.\n\nParameters:\n  freq -- frequency in Hz\n  gate-sig -- Signal<bool>\n\nReturns:\n  Signal<Sample>."},
    {"pluck-synth", "pluck-synth -- Karplus-Strong plucked string preset.\n\nParameters:\n  freq -- frequency in Hz\n  gate-sig -- Signal<bool>\n\nReturns:\n  Signal<Sample>."},
    {"effects-chain", "effects-chain -- apply a sequence of signal processors in order.\n\nParameters:\n  effects -- vector of SF<Sample,Sample> processors to apply\n  input -- source signal SF<(),Sample>\n\nExample:\n  SF<(),Sample> with all effects applied in order.\n  \n    (effects-chain (vec-of (gain 0.5) (low-pass 0.3)) my-osc)"},
    {"example-effects-chain", "example-effects-chain -- demonstration chain: gain -> low-pass -> hard clip.\n\nParameters:\n  input -- source signal SF<(),Sample>\n\nReturns:\n  SF<(),Sample>."},
    {"step-sequencer", "step-sequencer -- simple monophonic step sequencer.\n\nParameters:\n  notes -- vector of (freq, duration) tuples defining the sequence\n  tempo -- playback tempo in beats per minute\n  gate-duration -- gate-on fraction of each note duration (0.0 to 1.0)\n\nExample:\n  Signal<Sample> playing the sequence repeatedly.\n  \n    (step-sequencer (vec-of (Tuple 440.0 0.25) (Tuple 550.0 0.25)) 120.0 0.8)"},
    {"slice-new", "slice-new -- create a slice view over an existing contiguous int64 array.\n\nParameters:\n  data -- pointer to the first element of the underlying array\n  length -- number of elements in the view\n\nExample:\n  An opaque slice handle; free with slice-free when done.\n  \n    (def s (slice-new arr 4))  ; view of first 4 elements"},
    {"slice-len", "slice-len -- return the number of elements in the slice.\n\nParameters:\n  s -- slice handle from slice-new\n\nExample:\n  Element count as :int.\n  \n    (slice-len s)  ; => 4"},
    {"slice-get", "slice-get -- bounds-checked element access; aborts on out-of-range index.\n\nParameters:\n  s -- slice handle from slice-new\n  i -- zero-based index (must be 0 <= i < slice-len s)\n\nExample:\n  The int64 value at position i.\n  \n    (slice-get s 0)  ; => first element"},
    {"slice-free", "slice-free -- free the slice header struct; does NOT free the underlying data.\n\nParameters:\n  s -- slice handle from slice-new"},
    {"__functor_slice_fmap", "SINCE: Phase HKT H3\n\nSince: Phase HKT H3"},
    {"__foldable_slice_foldl", "__foldable_slice_foldl -- internal left-fold over a slice: accumulate from left using fn(acc, elem).\n\nSince: Phase HKT H3"},
    {"__foldable_slice_foldr", "__foldable_slice_foldr -- internal right-fold over a slice: accumulate from right using fn(elem, acc).\n\nSince: Phase HKT H3"},
    {"__traversable_slice_traverse", "__traversable_slice_traverse -- internal Traversable traverse for slice: apply fn to each element (v1: same as fmap).\n\nSince: Phase HKT H3"},
    {"ptr/null", "ptr/null -- return a null pointer constant.\n\nSince: Phase 20"},
    {"tvar/new", "tvar/new -- create a new transactional variable with an initial value.\n\nParameters:\n  init -- initial integer value stored in the TVar\n\nSince: Phase 20"},
    {"tvar/read", "tvar/read -- read the current value of a TVar within the active transaction.\n\nParameters:\n  tv -- TVar handle returned by tvar/new\n\nSince: Phase 20"},
    {"tvar/write", "tvar/write -- write a new value to a TVar within the active transaction.\n\nParameters:\n  tv -- TVar handle returned by tvar/new\n  val -- new value to record in the transaction log\n\nSince: Phase 20"},
    {"tvar/swap", "tvar/swap -- atomically replace a TVar's value and return the old value.\n\nParameters:\n  tv -- TVar handle returned by tvar/new\n  new -- replacement value\n\nSince: Phase 20"},
    {"tvar/cas", "tvar/cas -- compare-and-swap a TVar within the active transaction.\n\nParameters:\n  tv -- TVar handle returned by tvar/new\n  old -- expected current value\n  new -- desired replacement value\n\nSince: Phase 21"},
    {"str-from-cstr", "str-from-cstr -- create a str view from a NUL-terminated C string.\n\nParameters:\n  cstr -- NUL-terminated C string pointer\n\nExample:\n  Pointer to a newly allocated str struct (p + len). Does not copy the\n    underlying string data; the caller retains ownership of the original buffer.\n  \n    (str-from-cstr \"hello\")  ; => <str ptr>"},
    {"str-len", "str-len -- return the length of a str in bytes.\n\nParameters:\n  s -- str pointer returned by str-from-cstr\n\nExample:\n  Length of the string in bytes (not characters).\n  \n    (str-len (str-from-cstr \"hello\"))  ; => 5"},
    {"str-eq?", "str-eq? -- check whether two str values have identical byte contents.\n\nParameters:\n  s1 -- first str pointer\n  s2 -- second str pointer\n\nSince: Phase E1"},
    {"str-free", "str-free -- free the str struct (does not free the underlying string data).\n\nParameters:\n  s -- str pointer to free\n\nExample:\n  (str-free my-str)"},
    {"once-flag-new", "once-flag-new -- allocate and initialise a pthread_once_t flag on the heap.\n\nSince: Phase T19-C"},
    {"once-call", "once-call -- call init-fn exactly once for the lifetime of flag, regardless of concurrency.\n\nParameters:\n  flag -- once-flag pointer from once-flag-new\n  init-fn -- zero-argument C function pointer to invoke at most once\n\nSince: Phase T19-C"},
    {"once-flag-free", "once-flag-free -- free a once-flag allocated by once-flag-new.\n\nParameters:\n  flag -- once-flag pointer from once-flag-new\n\nSince: Phase T19-C"},
    {"sem-new", "sem-new -- allocate a counting semaphore initialised to initial.\n\nParameters:\n  initial -- starting count (0 = locked, >0 = permits available)\n\nSince: Phase T19-C"},
    {"sem-acquire", "sem-acquire -- decrement the semaphore; blocks until count > 0.\n\nParameters:\n  s -- semaphore pointer from sem-new\n\nSince: Phase T19-C"},
    {"sem-release", "sem-release -- increment the semaphore and wake one blocked acquirer.\n\nParameters:\n  s -- semaphore pointer from sem-new\n\nSince: Phase T19-C"},
    {"sem-free", "sem-free -- destroy and free a semaphore allocated by sem-new.\n\nParameters:\n  s -- semaphore pointer from sem-new\n\nSince: Phase T19-C"},
    {"task-group-new", "task-group-new -- create a new empty TaskGroup.\n\nSince: Phase T22"},
    {"fiber-cancelled?", "fiber-cancelled? -- check whether the current fiber has been cancelled.\n\nSince: Phase T22"},
    {"__fiber_set_cancelled", "__fiber_set_cancelled -- set the current fiber's cancelled flag (internal use only).\n\nSince: Phase T22"},
    {"task-group-cancelled?", "task-group-cancelled? -- check whether a specific task group has been cancelled.\n\nParameters:\n  group -- task group handle returned by task-group-new\n\nSince: Phase T22"},
    {"task-group-should-exit?", "task-group-should-exit? -- return true if the current task should stop, checking both fiber and group cancellation.\n\nParameters:\n  group -- task group handle returned by task-group-new\n\nSince: Phase T22"},
    {"fiber-should-exit?", "fiber-should-exit? -- check whether the current fiber should exit (without group context).\n\nSince: Phase T22"},
    {"task-group-done?", "task-group-done? -- check whether all tasks in the group have completed.\n\nParameters:\n  group -- task group handle returned by task-group-new\n\nSince: Phase T22"},
    {"task-group-task-done", "task-group-task-done -- signal that the calling task has completed; must be called by each spawned task.\n\nParameters:\n  group -- task group handle returned by task-group-new\n\nSince: Phase T22"},
    {"task-group-wait", "task-group-wait -- block until all tasks in the group have completed.\n\nParameters:\n  group -- task group handle returned by task-group-new\n\nSince: Phase T22"},
    {"task-group-cancel", "task-group-cancel -- cooperatively cancel all tasks in the group (reason: manual).\n\nParameters:\n  group -- task group handle returned by task-group-new\n\nSince: Phase T22"},
    {"task-group-cancel-with-reason", "task-group-cancel-with-reason -- cancel all tasks in the group with a specific reason code.\n\nParameters:\n  group -- task group handle returned by task-group-new\n  reason -- cancel reason: 0=manual, 1=panic, 2=timeout, 3=error\n\nSince: Phase T22"},
    {"task-group-cancel-panic", "task-group-cancel-panic -- cancel the group with reason 1 (panic).\n\nParameters:\n  group -- task group handle returned by task-group-new\n\nSince: Phase T22"},
    {"task-group-cancel-timeout", "task-group-cancel-timeout -- cancel the group with reason 2 (timeout).\n\nParameters:\n  group -- task group handle returned by task-group-new\n\nSince: Phase T22"},
    {"task-group-cancel-error", "task-group-cancel-error -- cancel the group with reason 3 (error).\n\nParameters:\n  group -- task group handle returned by task-group-new\n\nSince: Phase T22"},
    {"task-group-cancel-reason", "task-group-cancel-reason -- return the reason code why the group was cancelled.\n\nParameters:\n  group -- task group handle returned by task-group-new\n\nSince: Phase T22"},
    {"task-group-spawn", "task-group-spawn -- spawn a fiber into the task group and return its handle.\n\nParameters:\n  group -- task group handle returned by task-group-new\n  f -- zero-argument fiber entry-point function pointer\n\nSince: Phase T22"},
    {"task-group-join", "task-group-join -- wait for a specific spawned fiber to complete.\n\nParameters:\n  group -- task group handle returned by task-group-new\n  handle -- fiber handle returned by task-group-spawn\n\nSince: Phase T22"},
    {"task-handle-done?", "task-handle-done? -- non-blocking check whether a specific spawned fiber has completed.\n\nParameters:\n  handle -- fiber handle returned by task-group-spawn\n\nSince: Phase T22"},
    {"task-group-free", "task-group-free -- destroy a task group and release its memory.\n\nParameters:\n  group -- task group handle returned by task-group-new\n\nSince: Phase T22"},
    {"task-group-with", "task-group-with"},
    {"task-group-with-timeout", "task-group-with-timeout"},
    {"spawn-timeout-thread", "spawn-timeout-thread -- spawn a background thread that cancels the group after ms milliseconds.\n\nParameters:\n  group -- task group handle returned by task-group-new\n  ms -- delay in milliseconds before the group is cancelled\n\nSince: Phase T22"},
    {"join-timeout-thread", "join-timeout-thread -- free the handle of a detached timeout thread.\n\nParameters:\n  t -- thread handle returned by spawn-timeout-thread\n\nSince: Phase T22"},
    {"task-group-with-cancellation", "task-group-with-cancellation"},
    {"__tg-async-entry", "__tg-async-entry -- internal fiber entry point for task-group-spawn-async (internal use only).\n\nSince: Phase T22"},
    {"task-group-spawn-async", "task-group-spawn-async -- spawn an async computation into a task group and return a Future.\n\nParameters:\n  group -- task group handle returned by task-group-new\n  f -- no-argument function returning int64_t to run as a fiber\n\nSince: Phase T22"},
    {"task-group-async", "task-group-async"},
    {"InMemoryFile-type", "InMemoryFile-type"},
    {"InMemoryFS-type", "InMemoryFS-type"},
    {"Test-FileSystem", "Test-FileSystem"},
    {"Test-FileSystem-free", "Test-FileSystem-free"},
    {"testfs-clear", "testfs-clear"},
    {"testfs-exists?", "testfs-exists?"},
    {"testfs-get-contents", "testfs-get-contents"},
    {"CapturedLogs-type", "CapturedLogs-type"},
    {"TestLoggerState-type", "TestLoggerState-type"},
    {"Test-Logger", "Test-Logger"},
    {"Test-Logger-free", "Test-Logger-free"},
    {"testlog-clear", "testlog-clear"},
    {"testlog-count", "testlog-count"},
    {"testlog-has?", "testlog-has?"},
    {"Test-Random", "Test-Random"},
    {"Test-Random-free", "Test-Random-free"},
    {"testrng-reset", "testrng-reset"},
    {"Test-Time", "Test-Time"},
    {"Test-Time-free", "Test-Time-free"},
    {"testtime-set", "testtime-set"},
    {"testtime-get", "testtime-get"},
    {"testtime-reset", "testtime-reset"},
    {"assert", "assert -- assert that expected equals actual; print a failure message and return false if not.\n\nParameters:\n  expected -- the expected integer value\n  actual -- the actual integer value to compare against expected\n\nExample:\n  true if equal, false otherwise (with a failure message printed to stdout).\n  \n    (assert 42 (my-fn))  ; => true when my-fn returns 42"},
    {"assert-true", "assert-true -- assert that x is truthy (1); print a failure message and return false if not.\n\nParameters:\n  x -- value to test; 1 = true, 0 = false (current int convention)\n\nExample:\n  true if x == 1, false otherwise.\n  \n    (assert-true (= 1 1))  ; => true"},
    {"assert-false", "assert-false -- assert that x is falsy (0); print a failure message and return false if not.\n\nParameters:\n  x -- value to test; 0 = false, non-zero = true\n\nExample:\n  true if x == 0, false otherwise.\n  \n    (assert-false (= 1 2))  ; => true"},
    {"assert-nil", "assert-nil -- assert that x represents nil (0); print a failure message and return false if not.\n\nParameters:\n  x -- value to test; 0 represents nil\n\nExample:\n  true if x == 0, false otherwise.\n  \n    (assert-nil (no-op))  ; => true when no-op returns 0"},
    {"assert-error", "assert-error -- assert that calling thunk raises an error; return false if it does not.\n\nParameters:\n  thunk -- no-argument callback pointer; expected to throw when called\n\nExample:\n  true if thunk raised an error, false if it returned normally.\n  \n    (assert-error (fn [] (error \"boom\")))  ; => true"},
    {"run-test", "run-test -- invoke test-fn, print \".\" on pass or \"F <name>\" on fail, and return 1 or 0.\n\nParameters:\n  name -- human-readable test name printed on failure\n  test-fn -- no-argument callback that returns 1 on pass, 0 on fail\n\nExample:\n  1 if the test passed, 0 if it failed.\n  \n    (run-test \"my test\" (fn [] (assert 1 1)))  ; => 1"},
    {"register-test", "register-test -- register a named test callback with the runtime for later batch execution.\n\nParameters:\n  name -- test name string\n  test-fn -- no-argument callback returning 1 on pass, 0 on fail\n\nReturns:\n  Non-zero on successful registration."},
    {"run-tests!", "run-tests! -- run all tests registered with register-test and return a process exit code.\n\nReturns:\n  0 if all tests passed, non-zero if any failed."},
    {"deftest", "deftest -- register a named test whose body is one or more assertion expressions.\n\nParameters:\n  test-name -- string name for the test\n  body -- one or more expressions; the test passes if none abort\n\nExample:\n  (deftest \"addition\" (assert 4 (+ 2 2)))"},
    {"thread-spawn-fn", "thread-spawn-fn -- spawn a new OS thread calling fn-ptr with arg.\n\nParameters:\n  fn-ptr -- C function pointer of type void *(*)(void *)\n  arg -- opaque argument forwarded to fn-ptr\n\nSince: Phase T19-C"},
    {"thread-join", "thread-join -- wait for a thread to finish and free its handle.\n\nParameters:\n  t -- thread handle returned by thread-spawn-fn\n\nSince: Phase T19-C"},
    {"thread-detach", "thread-detach -- detach a thread (it cleans up itself on exit) and free the handle.\n\nParameters:\n  t -- thread handle returned by thread-spawn-fn\n\nSince: Phase T19-C"},
    {"thread-id", "thread-id -- return an integer identifier for the calling OS thread.\n\nSince: Phase T19-C"},
    {"work-queue-new", "work-queue-new -- create a new unbounded work queue that grows dynamically.\n\nSince: Phase T20-B"},
    {"work-queue-new-bounded", "work-queue-new-bounded -- create a new bounded work queue with a fixed capacity.\n\nParameters:\n  cap -- maximum number of items the queue can hold; push blocks when full\n\nSince: Phase T20-B"},
    {"work-queue-push", "work-queue-push -- push a value onto the work queue, blocking if the queue is bounded and full.\n\nParameters:\n  q -- queue handle returned by work-queue-new or work-queue-new-bounded\n  v -- int64_t value to enqueue\n\nSince: Phase T20-B"},
    {"work-queue-pop", "work-queue-pop -- pop a value from the work queue, blocking until one is available.\n\nParameters:\n  q -- queue handle returned by work-queue-new or work-queue-new-bounded\n\nSince: Phase T20-B"},
    {"work-queue-close", "work-queue-close -- close the work queue, waking all blocked producers and consumers.\n\nParameters:\n  q -- queue handle returned by work-queue-new or work-queue-new-bounded\n\nSince: Phase T20-B"},
    {"work-queue-free", "work-queue-free -- destroy a work queue and release all associated memory.\n\nParameters:\n  q -- queue handle returned by work-queue-new or work-queue-new-bounded\n\nSince: Phase T20-B"},
    {"tp-worker", "tp-worker -- internal worker thread function for a fixed ThreadPool.\n\nParameters:\n  arg -- ptr<void> pointing to the ThreadPoolBlock\n\nSince: Phase T20-D"},
    {"player-update", "player-update -- replace the pattern in a running player.\n\nParameters:\n  player -- PatternPlayer to update\n  new-pattern -- new pattern to use\n\nReturns:\n  Updated PatternPlayer."},
    {"player-swap", "player-swap -- atomically swap the parameter map pattern in a player.\n\nParameters:\n  player -- PatternPlayer to update\n  new-param-map -- new parameter map pattern\n\nReturns:\n  Updated PatternPlayer."},
    {"player-reload", "player-reload -- stop a player, replace its pattern, and restart it.\n\nParameters:\n  player -- PatternPlayer to reload\n  new-pattern -- replacement pattern"},
    {"watch-pattern", "watch-pattern -- start a player that watches a file for pattern changes.\n\nParameters:\n  path -- file path to watch for changes\n  session -- scscm session\n  def-name -- SynthDef name\n  initial-pattern -- pattern to use before any file change\n  bpm -- tempo\n\nReturns:\n  PatternPlayer (already started)."},
    {"StatefulPattern<T>", "StatefulPattern -- a pattern that carries and evolves internal state."},
    {"make-stateful-pattern", "make-stateful-pattern -- create a stateful pattern from an initial state and step function.\n\nParameters:\n  initial -- initial state value\n  f -- function (state, Beats) -> (new-state, Pattern<T>)\n\nReturns:\n  StatefulPattern<T>."},
    {"step-stateful", "step-stateful -- advance a stateful pattern by one step.\n\nParameters:\n  sp -- StatefulPattern<T>\n  time -- current time in beats\n\nReturns:\n  Tuple of (new-state, updated StatefulPattern)."},
    {"eval-stateful", "eval-stateful -- evaluate a stateful pattern at a specific time.\n\nParameters:\n  sp -- StatefulPattern<T>\n  time -- time in beats\n\nReturns:\n  Pattern value at the given time."},
    {"counter-pattern", "counter-pattern -- counting pattern that increments on each beat.\n\nParameters:\n  max -- maximum count value before wrapping back to 0\n\nExample:\n  StatefulPattern<int>.\n  \n    (counter-pattern 8)"},
    {"state-pattern", "state-pattern -- pattern that reads a value from session state.\n\nParameters:\n  key -- state key to read\n  f -- function (state-value, time) -> T\n\nReturns:\n  Pattern<T>."},
    {"updating-pattern", "updating-pattern -- pattern that reads and writes session state on each evaluation.\n\nParameters:\n  key -- state key\n  initial -- initial state value (used if key is not set)\n  f -- function (state, time) -> (new-state, output-value)\n\nReturns:\n  Pattern<T>."},
    {"live-session-add-pattern", "live-session-add-pattern -- register a named pattern in the session.\n\nParameters:\n  session -- LiveSession\n  name -- pattern name\n  pattern -- Pattern<map> to register\n\nReturns:\n  Updated LiveSession."},
    {"live-session-get-pattern", "live-session-get-pattern -- retrieve a named pattern from the session.\n\nParameters:\n  session -- LiveSession\n  name -- pattern name\n\nReturns:\n  Pattern<map> or nil."},
    {"live-session-update-pattern", "live-session-update-pattern -- replace a named pattern in the session.\n\nParameters:\n  session -- LiveSession\n  name -- pattern name\n  new-pattern -- replacement pattern\n\nReturns:\n  Updated LiveSession."},
    {"live-session-add-player", "live-session-add-player -- create a player for a named pattern and add it to the session.\n\nParameters:\n  session -- LiveSession\n  def-name -- SynthDef name\n  pattern-name -- name of the pattern to play\n  bpm -- tempo\n\nReturns:\n  Player ID or nil if the named pattern does not exist."},
    {"live-session-remove-player", "live-session-remove-player -- stop and remove a player from the session.\n\nParameters:\n  session -- LiveSession\n  player-id -- ID of the player to remove\n\nReturns:\n  Updated LiveSession."},
    {"live-context", "live-context -- build a symbol table of live-coding bindings for a session.\n\nParameters:\n  session -- LiveSession\n\nReturns:\n  Map of symbols to values, suitable for use as an evaluation environment."},
    {"def-pattern", "def-pattern -- define a named pattern in the session by evaluating code.\n\nParameters:\n  session -- LiveSession\n  name -- pattern name\n  code -- code string that evaluates to a pattern"},
    {"set-player-pattern", "set-player-pattern -- update a running player with a new pattern from code.\n\nParameters:\n  session -- LiveSession\n  player-id -- player ID to update\n  code -- code string that evaluates to a pattern"},
    {"d1", "d1 -- define a pattern and immediately start a player for it.\n\nParameters:\n  session -- LiveSession\n  name -- pattern name\n  code -- code string that evaluates to a pattern\n  def-name -- SynthDef name\n  bpm -- tempo\n\nReturns:\n  Player ID."},
    {"hush", "hush -- stop all players in a session.\n\nParameters:\n  session -- LiveSession\n\nReturns:\n  Updated LiveSession with no running players."},
    {"PatternRecorder", "PatternRecorder -- records events from a running player."},
    {"record-start", "record-start -- begin recording events from a player.\n\nParameters:\n  session -- LiveSession\n  player-id -- player ID to record\n\nReturns:\n  PatternRecorder."},
    {"record-stop", "record-stop -- stop recording and mark the recorder as done.\n\nParameters:\n  recorder -- PatternRecorder\n\nReturns:\n  Updated PatternRecorder with recording=false."},
    {"record-get", "record-get -- retrieve all recorded events.\n\nParameters:\n  recorder -- PatternRecorder\n\nReturns:\n  vec<map> of recorded events."},
    {"record-play", "record-play -- play back recorded events as a new player.\n\nParameters:\n  session -- LiveSession\n  recorder -- PatternRecorder with recorded events\n  def-name -- SynthDef name for playback\n  bpm -- tempo\n\nReturns:\n  Player ID."},
    {"MiniToken", "MiniToken -- a single lexed token from a mini-notation string."},
    {"mini-tokenize", "mini-tokenize -- lex a mini-notation string into a vector of tokens.\n\nParameters:\n  s -- mini-notation string to lex\n\nExample:\n  vec<MiniToken> in source order.\n  \n    (mini-tokenize \"1 2 3\")"},
    {"parse-expr", "parse-expr -- recursive descent parser for mini-notation tokens.\n\nParameters:\n  tokens -- vec<MiniToken> produced by mini-tokenize\n  index -- current position in the token vector\n\nReturns:\n  Tuple of (NumPattern, remaining-index)."},
    {"apply-op", "apply-op -- apply an infix operator to two patterns.\n\nParameters:\n  op -- operator character string\n  left -- left operand pattern\n  right -- right operand pattern\n\nReturns:\n  NumPattern with the operator applied."},
    {"parse-mini", "parse-mini -- parse a mini-notation expression string into a pattern.\n\nParameters:\n  s -- mini-notation string (numbers, operators, brackets)\n\nExample:\n  NumPattern.\n  \n    (parse-mini \"1 2 3\")\n    (parse-mini \"[1 2 3]\")  ; => fast 2x"},
    {"s", "s -- inline mini-notation macro.\n\nExample:\n  (s \"1 2 3\")  ; same as (parse-mini \"1 2 3\")"},
    {"parse-drums", "parse-drums -- parse drum mini-notation into a sequenced drum pattern.\n\nParameters:\n  s -- space-separated drum name string (e.g., \"bd sd bd sd\")\n\nExample:\n  Pattern<map> producing drum parameters for each step.\n  \n    (parse-drums \"bd sd bd sd\")"},
    {"d", "d -- drum pattern macro.\n\nExample:\n  (d \"bd sd\")  ; same as (parse-drums \"bd sd\")"},
    {"parse-note", "parse-note -- parse a note name string into a MIDI note number.\n\nParameters:\n  note-str -- note string (e.g., \"c4\", \"g#5\", \"eb3\")\n  default-octave -- octave to use when omitted (default: 4)\n\nExample:\n  MIDI note number as int.\n  \n    (parse-note \"c4\")   ; => 60\n    (parse-note \"a4\")   ; => 69"},
    {"parse-notes", "parse-notes -- parse a space-separated note string into a cycling MIDI pattern.\n\nParameters:\n  s -- space-separated note string (e.g., \"c4 e4 g4\")\n\nExample:\n  NumPattern cycling through MIDI note numbers.\n  \n    (parse-notes \"c4 e4 g4\")"},
    {"n", "n -- note pattern macro.\n\nExample:\n  (n \"c4 e4 g4\")  ; same as (parse-notes \"c4 e4 g4\")"},
    {"parse-chord", "parse-chord -- parse bracket-delimited chord notation into a constant chord pattern.\n\nParameters:\n  s -- chord string (e.g., \"[c4 e4 g4]\")\n\nExample:\n  Pattern<vec<int>> that always returns the same MIDI note vector.\n  \n    (parse-chord \"[c4 e4 g4]\")"},
    {"chord", "chord -- chord pattern macro.\n\nExample:\n  (chord \"[c4 e4 g4]\")  ; same as (parse-chord \"[c4 e4 g4]\")"},
    {"parse-rhythm", "parse-rhythm -- parse an x/o shorthand rhythm string into a numeric pattern.\n\nParameters:\n  s -- string of 'x' (hit) and 'o' (rest) characters\n  hit-value -- value for hits (default: 1)\n  rest-value -- value for rests (default: 0)\n\nExample:\n  NumPattern cycling through hit/rest values.\n  \n    (parse-rhythm \"x o x o\")  ; => alternating 1 and 0"},
    {"r", "r -- rhythm pattern macro.\n\nExample:\n  (r \"x o x o\")  ; same as (parse-rhythm \"x o x o\")"},
    {"parse-with-repeat", "parse-with-repeat -- expand *n repetition notation before cycling.\n\nParameters:\n  s -- pattern string where tokens may include *n suffix (e.g., \"bd*2 sd\")\n\nExample:\n  NumPattern with expanded sequence.\n  \n    (parse-with-repeat \"bd*2 sd\")  ; => cycle of bd bd sd"},
    {"mini", "mini -- parse a complete mini-notation expression (alias for parse-mini).\n\nParameters:\n  s -- mini-notation string\n\nReturns:\n  NumPattern."},
    {"pat-at", "pat-at -- evaluate a pattern at a specific time.\n\nParameters:\n  p -- pattern to evaluate\n  time -- time in beats\n\nExample:\n  Pattern value at the given time.\n  \n    (pat-at (const 5) 2.3)  ; => 5"},
    {"pat-start", "pat-start -- evaluate a pattern at time 0.\n\nParameters:\n  p -- pattern to evaluate\n\nExample:\n  Pattern value at time 0.\n  \n    (pat-start (cycle 10 20 30))  ; => 10"},
    {"phase", "phase -- return the fractional phase within a cycle.\n\nParameters:\n  cycle_length -- length of the cycle in beats (default: 1.0)\n\nExample:\n  NumPattern returning phase in [0, cycle_length).\n  \n    ((phase 2.0) 1.5)  ; => 1.5"},
    {"P", "P -- macro shorthand: (P x) => (const x), (P x y ...) => (cycle x y ...).\n\nExample:\n  (P 1 2 3)  ; same as (cycle 1 2 3)\n    (P 5)      ; same as (const 5)"},
    {"rand-range", "rand-range -- pattern returning a random float in [min, max) each evaluation.\n\nParameters:\n  min -- minimum value (inclusive)\n  max -- maximum value (exclusive)\n\nReturns:\n  NumPattern."},
    {"identity", "identity -- pattern that returns its time argument unchanged.\n\nReturns:\n  NumPattern returning the raw time value."},
    {"time-pat", "time-pat -- pattern returning the current time value.\n\nReturns:\n  NumPattern that is the identity function over time."},
    {"beat-number", "beat-number -- pattern returning the integer beat number.\n\nExample:\n  NumPattern returning floor(time).\n  \n    ((beat-number) 2.7)  ; => 2.0"},
    {"beat-fraction", "beat-fraction -- pattern returning the fractional part of the current beat.\n\nExample:\n  NumPattern returning time - floor(time).\n  \n    ((beat-fraction) 2.7)  ; => 0.7"},
    {"if-pat", "if-pat -- choose between two values based on a boolean pattern.\n\nParameters:\n  condition -- Boolean pattern or time -> bool function\n  a -- value when condition is true\n  b -- value when condition is false\n\nReturns:\n  Pattern<T>."},
    {"pattern-length", "pattern-length -- attempt to determine the cycle length of a pattern.\n\nReturns:\n  nil (cannot be determined statically in general)."},
    {"pattern-constant?", "pattern-constant? -- check whether a pattern is constant.\n\nReturns:\n  false (cannot be determined statically in general)."},
    {"PatternWithMeta<T>", "PatternWithMeta -- pattern bundled with introspection metadata."},
    {"with-meta", "with-meta -- attach metadata to a pattern.\n\nParameters:\n  pattern -- the underlying pattern\n  name -- human-readable name (default: \"\")\n  description -- description of the pattern (default: \"\")\n  tags -- categorisation tags (default: [])\n\nReturns:\n  PatternWithMeta<T>."},
    {"pattern-of", "pattern-of -- extract the underlying pattern from a PatternWithMeta value.\n\nParameters:\n  p -- PatternWithMeta<T>\n\nReturns:\n  Pattern<T>."},
    {"cached", "cached -- cache pattern results within a cycle to avoid redundant evaluation.\n\nParameters:\n  p -- pattern to cache\n  cache-size -- number of cache buckets (default: 1024)\n\nExample:\n  Pattern<T> with memoised results for repeated time queries.\n  \n    (cached expensive-pat 512)"},
    {"cached-ttl", "cached-ttl -- cache pattern results with a time-to-live expiry.\n\nParameters:\n  p -- pattern to cache\n  cache-size -- number of cache buckets\n  ttl -- time-to-live in beats before an entry is re-evaluated\n\nReturns:\n  Pattern<T> with TTL-based cache invalidation."},
    {"inline-pattern", "inline-pattern -- specialise simple patterns for reduced call overhead.\n\nParameters:\n  p -- pattern to inline\n\nReturns:\n  An equivalent Pattern<T> with simpler internal structure where possible."},
    {"fuse-pattern", "fuse-pattern -- fuse consecutive pattern operations to reduce overhead.\n\nParameters:\n  p -- pattern to fuse\n\nReturns:\n  Pattern<T> with fused operations where recognised."},
    {"CompiledPattern", "CompiledPattern -- a pattern compiled to native code (conceptual)."},
    {"compile-pattern", "compile-pattern -- attempt to compile a pattern to native code.\n\nParameters:\n  p -- pattern to compile\n\nReturns:\n  CompiledPattern or nil if compilation is not supported."},
    {"eval-compiled", "eval-compiled -- evaluate a compiled pattern at a specific time.\n\nParameters:\n  cp -- CompiledPattern\n  time -- time in beats\n\nReturns:\n  Pattern value (always 0.0 in this placeholder implementation)."},
    {"LazyPattern<T>", "LazyPattern -- pattern whose construction is deferred until first use."},
    {"make-lazy-pattern", "make-lazy-pattern -- create a lazy pattern from a thunk.\n\nParameters:\n  thunk -- function that produces the pattern when first evaluated\n\nReturns:\n  LazyPattern<T>."},
    {"eval-lazy", "eval-lazy -- evaluate a lazy pattern, constructing it on first use.\n\nParameters:\n  lp -- LazyPattern<T>\n  time -- time in beats\n\nReturns:\n  Pattern value."},
    {"batch-eval", "batch-eval -- evaluate a pattern at multiple times.\n\nParameters:\n  p -- pattern to evaluate\n  times -- vector of beat times\n\nExample:\n  Vector of pattern values corresponding to each time.\n  \n    (batch-eval my-pat [0.0 0.25 0.5 0.75])"},
    {"batch-eval-process", "batch-eval-process -- evaluate a pattern at multiple times and transform results.\n\nParameters:\n  p -- pattern to evaluate\n  times -- vector of beat times\n  f -- function to apply to each result\n\nReturns:\n  Vector of processed values."},
    {"optimize-pattern", "optimize-pattern -- apply a list of optimization passes to a pattern.\n\nParameters:\n  p -- pattern to optimize\n  passes -- list of optimization functions (default: fuse, inline, cache)\n\nReturns:\n  Optimized Pattern<T>."},
    {"optimize", "optimize -- apply the standard optimization pipeline.\n\nParameters:\n  p -- pattern to optimize\n\nReturns:\n  Optimized Pattern<T>."},
    {"optimize-aggressive", "optimize-aggressive -- apply an aggressive optimization pipeline including large cache.\n\nParameters:\n  p -- pattern to optimize\n\nReturns:\n  Aggressively optimized Pattern<T>."},
    {"bench-pattern", "bench-pattern -- measure evaluation throughput for a pattern.\n\nParameters:\n  p -- pattern to benchmark\n  iterations -- number of timed iterations\n  warmup -- warmup iterations before timing (default: 10)\n\nExample:\n  Map with :total-ns, :avg-ns, and :iterations.\n  \n    (bench-pattern my-pat 10000)"},
    {"patterns-equal?", "patterns-equal? -- compare two patterns for equality over a set of test times.\n\nParameters:\n  p1 -- first pattern\n  p2 -- second pattern\n  times -- vector of times to test\n  tolerance -- float tolerance for comparison (default: 0.001)\n\nReturns:\n  true if all sample points agree within tolerance."},
    {"profile-pattern", "profile-pattern -- wrap a pattern to collect timing data on each call.\n\nParameters:\n  p -- pattern to profile\n\nReturns:\n  Pattern<T> that accumulates call counts and total nanoseconds."},
    {"profile-stats", "profile-stats -- retrieve profiling statistics from a profiled pattern.\n\nParameters:\n  profiled-fn -- profiled pattern function from profile-pattern\n\nReturns:\n  Map with :calls, :total-time, and :avg-time."},
    {"zero-alloc-pattern", "zero-alloc-pattern -- create a pattern guaranteed not to allocate in the hot path.\n\nParameters:\n  computation -- Beats -> T function with no allocations\n\nReturns:\n  Pattern<T>."},
    {"zero-alloc-cycle", "zero-alloc-cycle -- zero-allocation cycling pattern over a pre-allocated vector.\n\nParameters:\n  values -- pre-allocated vector of values\n\nReturns:\n  NumPattern with zero allocation."},
    {"zero-alloc-sine", "zero-alloc-sine -- zero-allocation sine wave pattern.\n\nParameters:\n  freq -- frequency in cycles per beat\n  amp -- amplitude\n\nReturns:\n  NumPattern with zero allocation."},
    {"PatternPool", "PatternPool -- reusable pool of pattern instances."},
    {"pool-new", "pool-new -- create a pattern pool with pre-allocated instances.\n\nParameters:\n  size -- number of instances to pre-allocate\n  factory -- function producing a fresh pattern instance\n\nReturns:\n  PatternPool."},
    {"pool-get", "pool-get -- borrow a pattern from the pool (creates one if pool is empty).\n\nParameters:\n  pool -- PatternPool\n\nReturns:\n  Pattern<T>."},
    {"pool-return", "pool-return -- return a pattern to the pool by index.\n\nParameters:\n  pool -- PatternPool\n  idx -- index of the pattern to return"},
    {"simd-pattern-4", "simd-pattern-4 -- evaluate a pattern at 4 times simultaneously (conceptual).\n\nParameters:\n  p -- pattern to evaluate\n\nReturns:\n  Function: vec<Beats> -> vec<T> evaluating all 4 times."},
    {"specialize-pattern", "specialize-pattern -- constant-fold a pattern over a specific time range.\n\nParameters:\n  p -- pattern to specialise\n  time-range -- [start end] pair; if start == end, folds to a constant\n\nReturns:\n  Specialised Pattern<T>."},
    {"specialize-constant", "specialize-constant -- evaluate a pattern once at time 0 and return a constant.\n\nParameters:\n  p -- pattern to specialise\n\nReturns:\n  Pattern<T> always returning the value of p at time 0."},
    {"track-allocations", "track-allocations -- wrap a pattern to track GC allocations per evaluation.\n\nParameters:\n  p -- pattern to track\n\nReturns:\n  Pattern<T> that measures allocation delta on each call."},
    {"polymeter", "polymeter -- play a pattern with a different effective meter.\n\nParameters:\n  ratio -- time scaling ratio (2.0 = twice as slow, 0.5 = twice as fast)\n  p -- pattern to play with the scaled meter\n\nExample:\n  Pattern<T> evaluated with time * ratio.\n  \n    ((polymeter 1.5 my-pat) 1.0)  ; reads my-pat at time 1.5"},
    {"polyrhythm", "polyrhythm -- play two patterns with independent cycle lengths.\n\nParameters:\n  p1 -- first pattern\n  len1 -- cycle length for the first pattern in beats\n  p2 -- second pattern\n  len2 -- cycle length for the second pattern in beats\n\nExample:\n  Pattern<Tuple T1 T2> combining both patterns at their own tempos.\n  \n    ((polyrhythm kick-pat 3 snare-pat 2) 0.0)"},
    {"polyrhythm-n", "polyrhythm-n -- play any number of patterns with independent cycle lengths.\n\nParameters:\n  pattern-lengths -- list of [pattern length] tuples\n\nReturns:\n  Pattern<vec<T>> with one element per sub-pattern."},
    {"nest", "nest -- evaluate a pattern of patterns: outer selects the inner, inner is evaluated.\n\nParameters:\n  outer -- Pattern producing inner patterns\n  inner-time-scale -- time scaling applied before evaluating outer (default: 1.0)\n\nReturns:\n  Pattern<T> that delegates to the pattern returned by outer."},
    {"nest2", "nest2 -- nested pattern with independent time scales for outer and inner.\n\nParameters:\n  outer -- Pattern producing inner patterns\n  outer-time-scale -- scaling applied to time when querying outer\n  inner-time-scale -- scaling applied to time when querying the selected inner pattern\n\nReturns:\n  Pattern<T>."},
    {"canon", "canon -- play delayed copies of a pattern stacked together.\n\nParameters:\n  p -- pattern to copy\n  copies -- number of copies to create\n  delay -- time offset between successive copies in beats (default: 0.25)\n\nExample:\n  Pattern<vec<T>> with copies offset by delay * i for i in [0, copies).\n  \n    ((canon my-pat 3 0.25) 0.0)"},
    {"canon-n", "canon-n -- play copies of a pattern with individually specified delays.\n\nParameters:\n  p -- pattern to copy\n  delays -- list of per-copy delay offsets\n\nReturns:\n  Pattern<vec<T>>."},
    {"spread", "spread -- phase-spread copies of a pattern across a time window.\n\nParameters:\n  p -- pattern to spread\n  copies -- number of copies\n  spread-amount -- total time window to spread across in beats (default: 1.0)\n\nExample:\n  Pattern<vec<T>> with copies evenly spaced in [0, spread-amount).\n  \n    ((spread my-pat 4 1.0) 0.0)"},
    {"spread-n", "spread-n -- phase-spread copies with individually specified offsets.\n\nParameters:\n  p -- pattern to spread\n  spreads -- list of per-copy phase offsets\n\nReturns:\n  Pattern<vec<T>>."},
    {"stack-polymeter", "stack-polymeter -- stack patterns each running at their own meter.\n\nParameters:\n  pattern-meters -- list of [pattern meter] tuples\n\nReturns:\n  Pattern<vec<T>> with one element per voice."},
    {"stack-polyrhythm", "stack-polyrhythm -- stack patterns each with their own cycle lengths.\n\nParameters:\n  pattern-lengths -- list of [pattern length] tuples\n\nReturns:\n  Pattern<vec<T>>."},
    {"timesig", "timesig -- apply a sequence of time signatures to a pattern.\n\nParameters:\n  p -- pattern to apply time signatures to\n  sigs -- list of [beats-per-bar sub-beats-per-bar] tuples\n\nReturns:\n  Pattern<T> with normalised time within each bar."},
    {"make-timesig", "make-timesig -- construct a time signature specification.\n\nParameters:\n  beats-per-bar -- beats per bar (e.g., 4 for 4/4, 3 for 3/4)\n  sub-beats-per-bar -- sub-divisions per beat (e.g., 4 for 16th notes)\n\nReturns:\n  A [beats-per-bar sub-beats-per-bar] pair."},
    {"three-against-two", "three-against-two -- classic 3:2 polyrhythm.\n\nParameters:\n  p1 -- pattern for the 3-beat group\n  p2 -- pattern for the 2-beat group\n\nReturns:\n  Pattern<Tuple T1 T2>."},
    {"four-against-three", "four-against-three -- 4:3 polyrhythm.\n\nParameters:\n  p1 -- pattern for the 4-beat group\n  p2 -- pattern for the 3-beat group\n\nReturns:\n  Pattern<Tuple T1 T2>."},
    {"five-against-four", "five-against-four -- 5:4 polyrhythm.\n\nParameters:\n  p1 -- pattern for the 5-beat group\n  p2 -- pattern for the 4-beat group\n\nReturns:\n  Pattern<Tuple T1 T2>."},
    {"five-against-three", "five-against-three -- 5:3 polyrhythm.\n\nParameters:\n  p1 -- pattern for the 5-beat group\n  p2 -- pattern for the 3-beat group\n\nReturns:\n  Pattern<Tuple T1 T2>."},
    {"seven-against-four", "seven-against-four -- 7:4 polyrhythm.\n\nParameters:\n  p1 -- pattern for the 7-beat group\n  p2 -- pattern for the 4-beat group\n\nReturns:\n  Pattern<Tuple T1 T2>."},
    {"polyrhythm-offset", "polyrhythm-offset -- polyrhythm with independent phase offsets per pattern.\n\nParameters:\n  p1 -- first pattern\n  len1 -- cycle length for first pattern\n  offset1 -- phase offset for first pattern\n  p2 -- second pattern\n  len2 -- cycle length for second pattern\n  offset2 -- phase offset for second pattern\n\nReturns:\n  Pattern<Tuple T1 T2>."},
    {"polyrhythm-phased", "polyrhythm-phased -- polyrhythm with per-pattern length and phase.\n\nParameters:\n  patterns-and-phases -- list of [pattern length phase] triples\n\nReturns:\n  Pattern<vec<T>>."},
    {"metric-mod", "metric-mod -- apply an arbitrary time mapping to a pattern.\n\nParameters:\n  p -- pattern to modulate\n  modulation-fn -- Beats -> Beats time remapping function\n\nReturns:\n  Pattern<T> evaluated at modulation-fn(time)."},
    {"metric-mod-linear", "metric-mod-linear -- apply a piecewise linear time mapping.\n\nParameters:\n  p -- pattern to modulate\n  breakpoints -- list of [input-time output-time] pairs\n\nReturns:\n  Pattern<T> with piecewise linear time mapping."},
    {"lcm", "lcm -- least common multiple of two integers.\n\nParameters:\n  a -- first number\n  b -- second number\n\nReturns:\n  LCM of a and b."},
    {"gcd", "gcd -- greatest common divisor using the Euclidean algorithm.\n\nParameters:\n  a -- first number\n  b -- second number\n\nReturns:\n  GCD of a and b."},
    {"polyrhythm-alignment", "polyrhythm-alignment -- find the beat at which all polyrhythm patterns realign.\n\nParameters:\n  lengths -- list of cycle lengths\n\nExample:\n  The LCM of all lengths (time at which all patterns complete together).\n  \n    (polyrhythm-alignment 3 4)  ; => 12"},
    {"cross-rhythm", "cross-rhythm -- polyrhythm with per-pattern phase offsets.\n\nParameters:\n  p1 -- first pattern\n  len1 -- cycle length for first pattern\n  p2 -- second pattern\n  len2 -- cycle length for second pattern\n  phase1 -- phase offset for first pattern (default: 0)\n  phase2 -- phase offset for second pattern (default: 0)\n\nReturns:\n  Pattern<Tuple T1 T2>."},
    {"hocket", "hocket -- distribute a pattern's output across multiple voices.\n\nParameters:\n  p -- source pattern\n  voices -- number of voices to distribute across\n  selector -- IntPattern selecting the active voice (default: cycle 0..voices-1)\n\nExample:\n  Pattern<vec<T>> where only the selected voice receives the pattern value.\n  \n    ((hocket my-pat 3) 0.0)"},
    {"seq-n", "seq-n -- sequence patterns with custom durations per segment.\n\nParameters:\n  pattern-lengths -- list of [pattern length] tuples\n\nReturns:\n  Pattern<T> proportionally allocating time to each segment."},
    {"stack-with", "stack-with -- stack patterns and fold results with a combiner function.\n\nParameters:\n  f -- function vec<T> -> U combining all pattern values\n  patterns -- patterns to stack\n\nReturns:\n  Pattern<U>."},
    {"sum", "sum -- pointwise sum of numeric patterns.\n\nParameters:\n  patterns -- one or more NumPattern to sum\n\nExample:\n  NumPattern returning the sum of all pattern values.\n  \n    ((sum bass-pat melody-pat) 0.5)"},
    {"multiply", "multiply -- pointwise product of numeric patterns.\n\nParameters:\n  patterns -- one or more NumPattern to multiply\n\nReturns:\n  NumPattern returning the product of all pattern values."},
    {"average", "average -- pointwise average of numeric patterns.\n\nParameters:\n  patterns -- one or more NumPattern to average\n\nReturns:\n  NumPattern returning the arithmetic mean of all pattern values."},
    {"nth", "nth -- trigger a pattern when beat number mod n equals offset.\n\nParameters:\n  n -- modulo base\n  p -- pattern to trigger\n  offset -- target remainder (default: 0)\n  zero -- value when not triggered (default: 0)\n\nReturns:\n  Pattern<T>."},
    {"euclid", "euclid -- Euclidean rhythm distributing hits as evenly as possible.\n\nParameters:\n  steps -- total number of steps in the pattern\n  hits -- number of active (hit) steps\n  rotation -- rotation offset (default: 0)\n\nExample:\n  NumPattern returning 1 for hits and 0 for rests.\n  \n    ((euclid 8 5) 0.0)  ; classic 5-in-8 Euclidean rhythm"},
    {"euclid-vals", "euclid-vals -- Euclidean rhythm with custom on/off values.\n\nParameters:\n  steps -- total steps\n  hits -- number of hit steps\n  on-value -- value for hits (default: 1)\n  off-value -- value for rests (default: 0)\n  rotation -- rotation offset (default: 0)\n\nReturns:\n  Pattern<T> with custom on/off values."},
    {"select", "select -- choose among patterns using an index pattern.\n\nParameters:\n  index -- NumPattern producing indices into the pattern list\n  patterns -- patterns to select from\n\nExample:\n  Pattern<T> delegating to the selected sub-pattern.\n  \n    ((select (cycle 0 1 2) pat-a pat-b pat-c) 0.5)"},
    {"first-nonzero", "first-nonzero -- return the first non-zero value from a set of patterns.\n\nParameters:\n  zero -- zero sentinel value (default: 0)\n  patterns -- patterns to check in order\n\nReturns:\n  Pattern<T> returning the first non-zero pattern value."},
    {"index", "index -- return the step index within a cycle.\n\nParameters:\n  cycle-length -- number of steps per cycle (default: 1)\n\nReturns:\n  IntPattern returning the current step index."},
    {"first-beat", "first-beat -- true on the first step of each cycle.\n\nParameters:\n  cycle-length -- steps per cycle (default: 1)\n\nReturns:\n  BoolPattern."},
    {"last-beat", "last-beat -- true on the last step of each cycle.\n\nParameters:\n  cycle-length -- steps per cycle (default: 1)\n\nReturns:\n  BoolPattern."},
    {"chain", "chain -- concatenate patterns, advancing when a sentinel value is returned.\n\nParameters:\n  sentinel -- value indicating end of a pattern segment (default: nil)\n  patterns -- patterns to chain\n\nReturns:\n  Pattern<T> advancing through patterns in order."},
    {"interleave-n", "interleave-n -- interleave patterns with custom durations (alias for seq-n).\n\nParameters:\n  pattern-lengths -- list of [pattern length] tuples\n\nReturns:\n  Pattern<T>."},
    {"mask", "mask -- let signal pass only where a boolean mask is true.\n\nParameters:\n  source -- Pattern to read values from\n  mask -- BoolPattern: true = pass, false = block\n  zero -- value when masked (default: 0)\n\nExample:\n  Pattern<T>.\n  \n    (mask melody-pat (euclid 8 5))"},
    {"invert", "invert -- invert a boolean pattern.\n\nParameters:\n  p -- BoolPattern to invert\n\nReturns:\n  BoolPattern with negated values."},
    {"and-pat", "and-pat -- logical AND of two boolean patterns.\n\nParameters:\n  a -- first BoolPattern\n  b -- second BoolPattern\n\nReturns:\n  BoolPattern."},
    {"or-pat", "or-pat -- logical OR of two boolean patterns.\n\nParameters:\n  a -- first BoolPattern\n  b -- second BoolPattern\n\nReturns:\n  BoolPattern."},
    {"xor-pat", "xor-pat -- logical XOR of two boolean patterns.\n\nParameters:\n  a -- first BoolPattern\n  b -- second BoolPattern\n\nReturns:\n  BoolPattern."},
    {"group", "group -- partition patterns into groups and apply a group combiner.\n\nParameters:\n  group-size -- number of patterns per group\n  group-pattern -- function (time, patterns) -> T applied to each group\n  patterns -- patterns to group\n\nReturns:\n  Pattern<T> applying group-pattern to the current group."},
    {"pat->param", "pat->param -- send a pattern value to a synth control at the current beat time.\n\nParameters:\n  p -- NumPattern to evaluate\n  session -- scscm session\n  node-id -- synth node ID\n  param-index -- control parameter index"},
    {"pats->params", "pats->params -- send multiple pattern values to synth controls.\n\nParameters:\n  session -- scscm session\n  node-id -- synth node ID\n  param-patterns -- list of [param-index pattern] tuples"},
    {"pats->named-params", "pats->named-params -- send pattern values to named synth controls.\n\nParameters:\n  session -- scscm session\n  node-id -- synth node ID\n  param-map -- map of param-name -> [control-index pattern]\n  param-name->index -- function mapping param names to control indices"},
    {"player-new", "player-new -- create a new (stopped) pattern player.\n\nParameters:\n  session -- scscm session\n  def-name -- SynthDef name\n  pattern -- Pattern<map<cstr,float>> producing parameter maps\n  bpm -- tempo in beats per minute\n\nReturns:\n  PatternPlayer (not yet started)."},
    {"player-start", "player-start -- start a pattern player.\n\nParameters:\n  player -- PatternPlayer to start\n\nReturns:\n  Updated PatternPlayer with running=true."},
    {"player-stop", "player-stop -- stop a pattern player and free all its synth nodes.\n\nParameters:\n  player -- PatternPlayer to stop\n\nReturns:\n  Updated PatternPlayer with running=false."},
    {"pattern-synth", "pattern-synth -- create a synth driven by pattern parameters at time 0.\n\nParameters:\n  session -- scscm session\n  def-name -- SynthDef name\n  param-patterns -- list of [control-index pattern] tuples\n  bpm -- tempo (default: time/DEFAULT_BPM)\n\nReturns:\n  Node ID of created synth, or nil on failure."},
    {"pattern-synth-player", "pattern-synth-player -- create a player that continuously updates synth parameters.\n\nParameters:\n  session -- scscm session\n  def-name -- SynthDef name\n  param-patterns -- list of [control-index pattern] tuples\n  bpm -- tempo\n  duration -- duration in beats\n\nReturns:\n  PatternPlayer (already started)."},
    {"note->freq", "note->freq -- convert a MIDI note number to frequency in Hz.\n\nParameters:\n  note -- MIDI note number (0-127; 69 = A4 = 440 Hz)\n\nExample:\n  Frequency in Hz.\n  \n    (note->freq 69)  ; => 440.0"},
    {"note-pattern-dur", "note-pattern-dur -- note pattern including note duration.\n\nParameters:\n  pitch -- IntPattern\n  vel -- NumPattern\n  dur -- NumPattern for duration in beats\n  gate -- BoolPattern (default: const true)\n\nReturns:\n  Pattern<map> with :freq, :amp, :gate, and :dur keys."},
    {"arp-pattern", "arp-pattern -- arpeggiate a chord pattern.\n\nParameters:\n  chord -- Pattern<vec<int>> producing MIDI note lists\n  speed -- notes per beat (default: 4 = 16th notes)\n  direction -- :up, :down, :up-down, or :random (default: :up)\n\nExample:\n  IntPattern cycling through chord tones.\n  \n    ((arp-pattern my-chord 4 :up) 0.0)"},
    {"drum-pattern", "drum-pattern -- build a drum pattern from a list of (time, name, velocity) hits.\n\nParameters:\n  hits -- list of [time-in-cycle drum-name velocity] tuples\n\nReturns:\n  Pattern<map> with :note and :vel keys for the active hit, or {} for silence."},
    {"drum-name->note", "drum-name->note -- map a drum abbreviation to a GM MIDI note number.\n\nParameters:\n  name -- drum name string (e.g., \"bd\", \"sd\", \"hh\")\n\nReturns:\n  MIDI note number."},
    {"kick", "kick -- kick drum pattern triggered at specific beat positions.\n\nParameters:\n  times -- beat positions within the cycle to trigger the kick\n\nExample:\n  Pattern<map> with {:note 36 :vel 127} on hits, {} otherwise.\n  \n    ((kick 0 1 2 3) 0.0)"},
    {"snare", "snare -- snare drum pattern triggered at specific beat positions.\n\nParameters:\n  times -- beat positions to trigger the snare\n\nExample:\n  Pattern<map> with {:note 38 :vel 100} on hits, {} otherwise.\n  \n    ((snare 1 3) 1.0)"},
    {"hat", "hat -- hi-hat pattern triggered at specific beat positions.\n\nParameters:\n  times -- beat positions to trigger the hi-hat\n\nExample:\n  Pattern<map> with {:note 42 :vel 80} on hits, {} otherwise.\n  \n    ((hat 0 0.5 1 1.5 2 2.5 3 3.5) 0.0)"},
    {"pattern->osc", "pattern->osc -- send a parameter map pattern to a synth node via OSC.\n\nParameters:\n  pattern -- Pattern<map<cstr,float>>\n  session -- scscm session\n  node-id -- synth node ID\n  time -- current time in beats"},
    {"trigger-pattern", "trigger-pattern -- create a player that spawns a new synth on each pattern event.\n\nParameters:\n  session -- scscm session\n  def-name -- SynthDef name\n  pattern -- Pattern<map> producing parameters for each new note\n  bpm -- tempo\n\nReturns:\n  PatternPlayer (already started)."},
    {"freq-pattern", "freq-pattern -- frequency pattern with optional additive modulation.\n\nParameters:\n  base-freq -- base frequency in Hz\n  modulation -- additive NumPattern (default: const 0)\n\nReturns:\n  NumPattern for synth frequency."},
    {"amp-pattern", "amp-pattern -- amplitude pattern with optional envelope modulation.\n\nParameters:\n  base-amp -- base amplitude (0-1)\n  envelope -- multiplicative NumPattern (default: const 1)\n\nReturns:\n  NumPattern for synth amplitude."},
    {"pan-pattern", "pan-pattern -- stereo pan pattern with optional modulation, clamped to [-1, 1].\n\nParameters:\n  base-pan -- base pan position (-1 = left, 0 = center, 1 = right)\n  modulation -- additive NumPattern (default: const 0)\n\nReturns:\n  NumPattern clamped to [-1, 1]."},
    {"synth-params", "synth-params -- combine freq, amp, and pan patterns into a parameter map pattern.\n\nParameters:\n  freq-pattern -- NumPattern for frequency\n  amp-pattern -- NumPattern for amplitude\n  pan-pattern -- NumPattern for pan\n\nReturns:\n  Pattern<map> with :freq, :amp, and :pan keys."},
    {"synth-pattern-player", "synth-pattern-player -- create a player driven by a named parameter map.\n\nParameters:\n  session -- scscm session\n  def-name -- SynthDef name\n  param-patterns -- map of param-name -> pattern\n  bpm -- tempo\n\nReturns:\n  PatternPlayer (already started)."},
    {"stretch", "stretch -- stretch time within a cycle (alias for slow).\n\nParameters:\n  factor -- stretch factor\n  p -- pattern to stretch\n\nReturns:\n  Pattern<T> with stretched time."},
    {"compress", "compress -- compress time within a cycle (alias for fast).\n\nParameters:\n  factor -- compression factor\n  p -- pattern to compress\n\nReturns:\n  Pattern<T> with compressed time."},
    {"shift", "shift -- shift a pattern forward or backward in time.\n\nParameters:\n  offset -- time offset in beats (positive = later, negative = earlier)\n  p -- pattern to shift\n\nExample:\n  Pattern<T> shifted in time.\n  \n    ((shift 0.5 my-pat) 1.0)  ; same as (my-pat 1.5)"},
    {"rot", "rot -- rotate a pattern's phase (alias for shift).\n\nParameters:\n  amount -- rotation amount in beats\n  p -- pattern to rotate\n\nReturns:\n  Pattern<T> with shifted phase."},
    {"mirror", "mirror -- mirror a pattern within each 2-beat window.\n\nParameters:\n  p -- pattern to mirror\n\nExample:\n  Pattern<T> that plays forward in [0,1) then backward in [1,2).\n  \n    ((mirror my-pat) 1.5)  ; reads from time 0.5"},
    {"rev", "rev -- reverse a pattern within each 1-beat cycle.\n\nParameters:\n  p -- pattern to reverse\n\nExample:\n  Pattern<T> with reversed time within each cycle.\n  \n    ((rev my-pat) 0.25)  ; same as (my-pat 0.75)"},
    {"repeat", "repeat -- repeat a pattern n times within its cycle.\n\nParameters:\n  n -- repetition count\n  p -- pattern to repeat\n\nExample:\n  Pattern<T> playing n times faster.\n  \n    ((repeat 4 my-pat) 0.0)"},
    {"for-beats", "for-beats -- play a pattern for a fixed number of beats, then return zero.\n\nParameters:\n  duration -- duration in beats\n  p -- pattern to play\n  zero -- value after duration (default: 0)\n\nReturns:\n  Pattern<T> active for duration beats."},
    {"loop-cycles", "loop-cycles -- loop a pattern for a fixed number of cycles then stop.\n\nParameters:\n  cycles -- number of cycles to loop\n  p -- pattern to loop\n  zero -- value after looping ends (default: 0)\n\nReturns:\n  Pattern<T>."},
    {"loop-range", "loop-range -- loop a pattern between two time points.\n\nParameters:\n  start -- start time in beats\n  end -- end time in beats\n  p -- pattern to loop\n  zero -- value outside [start, end) (default: 0)\n\nReturns:\n  Pattern<T> looping within the window."},
    {"warp", "warp -- remap time using an arbitrary function.\n\nParameters:\n  warp-fn -- Beats -> Beats transformation applied to time before evaluation\n  p -- pattern to warp\n\nReturns:\n  Pattern<T> evaluated at warped time."},
    {"warp-by", "warp-by -- remap time by multiplying with values from another pattern.\n\nParameters:\n  warp-pat -- NumPattern producing a time-scaling factor\n  p -- pattern to warp\n\nReturns:\n  Pattern<T> evaluated at time * warp-pat(time)."},
    {"quantize-beat", "quantize-beat -- snap pattern evaluation to the nearest beat boundary.\n\nParameters:\n  p -- pattern to quantize\n\nReturns:\n  Pattern<T> that only changes on whole-beat boundaries."},
    {"quantize", "quantize -- snap pattern evaluation to multiples of n beats.\n\nParameters:\n  n -- quantization grid size in beats\n  p -- pattern to quantize\n\nExample:\n  Pattern<T> quantized to n-beat intervals.\n  \n    (quantize 0.25 my-pat)  ; 16th-note grid"},
    {"quantize-subdiv", "quantize-subdiv -- snap pattern evaluation to a subdivision grid.\n\nParameters:\n  subdivisions -- number of subdivisions per beat (e.g., 4 = 16th notes)\n  p -- pattern to quantize\n\nReturns:\n  Pattern<T> quantized to 1/subdivisions-beat steps."},
    {"time-mod", "time-mod -- wrap time into a [0, period) window before evaluation.\n\nParameters:\n  period -- period in beats\n  p -- pattern to wrap\n\nReturns:\n  Pattern<T> evaluated with time mod period."},
    {"time-switch", "time-switch -- cycle through a list of patterns, each lasting period beats.\n\nParameters:\n  period -- duration per pattern in beats\n  patterns -- patterns to cycle through\n\nExample:\n  Pattern<T> switching to the next pattern every period beats.\n  \n    ((time-switch 4 pat-a pat-b pat-c) 5.0)  ; uses pat-b"},
    {"transform-time", "transform-time -- apply a sequence of temporal transformations to a pattern.\n\nParameters:\n  p -- base pattern\n  transformations -- list of [transform-fn args...] pairs to apply in order\n\nExample:\n  Pattern<T> with all transformations applied.\n  \n    (transform-time (cycle 1 2 3) [slow 2] [shift 0.5] [repeat 2])"},
    {"backwards", "backwards -- play a pattern in reverse within each cycle.\n\nParameters:\n  p -- pattern to reverse\n  duration -- cycle duration in beats (default: 1.0)\n\nReturns:\n  Pattern<T> playing backwards."},
    {"palindrome", "palindrome -- play a pattern forwards then backwards (ping-pong).\n\nParameters:\n  p -- pattern to palindrome\n  duration -- half-period in beats (default: 1.0)\n\nExample:\n  Pattern<T> playing forward then backward in a 2*duration window.\n  \n    ((palindrome my-pat) 1.5)  ; reads from time 0.5 (backwards half)"},
    {"stutter", "stutter -- repeat each value of a pattern subdivisions times.\n\nParameters:\n  subdivisions -- how many times to repeat each value\n  p -- pattern to stutter\n\nExample:\n  Pattern<T> with stuttered output.\n  \n    ((stutter 4 my-pat) 0.5)  ; reads from floor(0.5/4) = 0"},
    {"time-window", "time-window -- gate a pattern to a specific time window.\n\nParameters:\n  start -- window start in beats\n  end -- window end in beats\n  p -- pattern to window\n  zero -- value outside the window (default: 0)\n\nReturns:\n  Pattern<T> active only in [start, end)."},
    {"fade-in", "fade-in -- produce a linear ramp from 0 to 1 over fade-duration beats.\n\nParameters:\n  fade-duration -- duration of the fade in beats\n  p -- pattern (currently unused, ramp only)\n\nReturns:\n  NumPattern rising linearly to 1.0 then holding at 1.0."},
    {"fade-out", "fade-out -- produce a linear ramp from 1 to 0 starting at start-time.\n\nParameters:\n  fade-duration -- duration of the fade in beats\n  start-time -- beat at which the fade begins\n  p -- pattern (currently unused, ramp only)\n\nReturns:\n  NumPattern holding 1.0 before start-time, then falling to 0.0."},
    {"scale-pat", "scale-pat -- build a cycling MIDI note pattern from a scale and tonic.\n\nParameters:\n  scale -- list of semitone offsets from the tonic\n  tonic -- base MIDI note number (default: 60 = middle C)\n\nExample:\n  NumPattern cycling through the MIDI notes of the scale.\n  \n    (scale-pat MAJOR_SCALE 60)"},
    {"drum-machine", "drum-machine -- combine kick, snare, and hi-hat patterns into a stacked drum part.\n\nParameters:\n  kick-pattern -- Pattern for kick drum\n  snare-pattern -- Pattern for snare drum\n  hat-pattern -- Pattern for hi-hat\n\nExample:\n  Pattern<vec<map>> stacking all three drum voices.\n  \n    (drum-machine DRUM_KICK DRUM_SNARE DRUM_HAT)"},
    {"bass-line", "bass-line -- create a bass line note pattern.\n\nParameters:\n  notes -- Pattern for MIDI note pitches\n  duration -- Pattern for note durations in beats (default: 0.25)\n  velocity -- Pattern for velocities (default: 100)\n\nReturns:\n  Pattern<map> suitable for a bass synth."},
    {"lead", "lead -- create a lead melody note pattern.\n\nParameters:\n  notes -- Pattern for MIDI note pitches\n  duration -- Pattern for note durations in beats (default: 0.5)\n  velocity -- Pattern for velocities (default: 90)\n\nReturns:\n  Pattern<map> suitable for a lead synth."},
    {"pad", "pad -- create a pad chord pattern.\n\nParameters:\n  chords -- Pattern<vec<int>> for chord voicings (MIDI notes)\n  duration -- Pattern for chord durations (default: 1.0)\n  velocity -- Pattern for velocities (default: 70)\n\nReturns:\n  Pattern<vec<map>> suitable for a pad synth."},
    {"bpm->spb", "bpm->spb -- convert BPM to seconds per beat.\n\nParameters:\n  bpm -- beats per minute\n\nExample:\n  Seconds per beat.\n  \n    (bpm->spb 120.0)  ; => 0.5"},
    {"beats->samples", "beats->samples -- convert a beat count to sample count.\n\nParameters:\n  beats -- time in beats\n  bpm -- tempo in beats per minute\n  sample_rate -- samples per second\n\nExample:\n  Time in samples (floored to integer).\n  \n    (beats->samples 1.0 120.0 48000)  ; => 24000"},
    {"samples->beats", "samples->beats -- convert a sample count to beat count.\n\nParameters:\n  samples -- time in samples\n  bpm -- tempo in beats per minute\n  sample_rate -- samples per second\n\nReturns:\n  Time in beats."},
    {"bar-phase", "bar-phase -- beat position within the current bar.\n\nParameters:\n  time -- current time in beats\n  beats_per_bar -- beats per bar (default: 4.0)\n\nReturns:\n  Position in [0, beats_per_bar)."},
    {"bar-number", "bar-number -- integer bar number at the current beat time.\n\nParameters:\n  time -- current time in beats\n  beats_per_bar -- beats per bar (default: 4.0)\n\nExample:\n  Bar index (0-based).\n  \n    (bar-number 8.5 4.0)  ; => 2.0"},
    {"const-tempo", "const-tempo -- constant tempo map always returning the same BPM.\n\nParameters:\n  bpm -- constant BPM\n\nReturns:\n  TempoMap."},
    {"tempo-change", "tempo-change -- tempo map with a single step change.\n\nParameters:\n  start-bpm -- initial BPM\n  change-time -- beat at which tempo changes\n  end-bpm -- BPM after the change\n\nExample:\n  TempoMap.\n  \n    ((tempo-change 120.0 8.0 140.0) 10.0)  ; => 140.0"},
    {"tempo-map", "tempo-map -- tempo map with multiple step changes specified as time/bpm pairs.\n\nParameters:\n  changes -- list of [beat-time bpm] pairs in any order\n\nReturns:\n  TempoMap applying the most recent change at any query time."},
    {"lerp", "lerp -- linearly interpolate between two values.\n\nParameters:\n  start -- start value (at time 0)\n  end -- end value (at time 1)\n  time -- interpolation parameter (clamped to [0, 1])\n\nExample:\n  Interpolated value.\n  \n    (lerp 0.0 1.0 0.5)  ; => 0.5"},
    {"exp-lerp", "exp-lerp -- exponential interpolation between two values.\n\nParameters:\n  start -- start value (must be > 0 if end > start)\n  end -- end value\n  time -- interpolation parameter (clamped to [0, 1])\n\nExample:\n  Exponentially interpolated value.\n  \n    (exp-lerp 100.0 200.0 0.5)  ; => ~141.4"},
    {"BeatClock", "BeatClock -- tracks beat time from a running sample counter."},
    {"make-beat-clock", "make-beat-clock -- create a new beat clock at the given BPM and sample rate.\n\nParameters:\n  bpm -- beats per minute\n  sample-rate -- audio sample rate in Hz\n\nExample:\n  BeatClock starting at sample 0.\n  \n    (make-beat-clock 120.0 48000.0)"},
    {"clock->beats", "clock->beats -- convert a sample offset to beats.\n\nParameters:\n  clock -- BeatClock\n  sample-offset -- sample count from clock start\n\nReturns:\n  Beats value."},
    {"clock->samples", "clock->samples -- convert a beat offset to samples.\n\nParameters:\n  clock -- BeatClock\n  beats -- beat count from clock start\n\nReturns:\n  Sample count."},
    {"clock-advance", "clock-advance -- advance the clock by a number of samples.\n\nParameters:\n  clock -- BeatClock to advance\n  samples -- number of samples to advance\n\nReturns:\n  Updated BeatClock."},
    {"clock-now", "clock-now -- get the current beat time from a clock.\n\nParameters:\n  clock -- BeatClock\n\nReturns:\n  Current beat time as a float."},
    {"ScheduledEvent", "ScheduledEvent -- an event queued for future execution at a specific beat."},
    {"EventQueue", "EventQueue -- ordered queue of scheduled events."},
    {"queue-new", "queue-new -- create an empty event queue.\n\nReturns:\n  Empty EventQueue."},
    {"queue-push", "queue-push -- add an event to an event queue.\n\nParameters:\n  queue -- EventQueue to add to\n  event -- ScheduledEvent to enqueue\n\nReturns:\n  Updated EventQueue."},
    {"queue-pop", "queue-pop -- remove and return the earliest event from the queue.\n\nParameters:\n  queue -- EventQueue\n\nReturns:\n  ScheduledEvent or nil if the queue is empty."},
    {"queue-peek", "queue-peek -- look at the earliest event without removing it.\n\nParameters:\n  queue -- EventQueue\n\nReturns:\n  ScheduledEvent or nil if the queue is empty."},
    {"PatternScheduler", "PatternScheduler -- scheduler combining a beat clock with an event queue."},
    {"schedule-pattern", "schedule-pattern -- schedule a pattern to be evaluated at a specific beat.\n\nParameters:\n  sched -- PatternScheduler\n  pattern -- pattern to evaluate when triggered\n  at-beat -- beat time to trigger\n  callback -- function called with the pattern result\n\nReturns:\n  Event ID."},
    {"schedule-param", "schedule-param -- schedule a synth parameter update at a specific beat.\n\nParameters:\n  sched -- PatternScheduler\n  node-id -- synth node ID to update\n  pattern -- pattern to evaluate\n  at-beat -- beat time to update\n\nReturns:\n  Event ID."},
    {"process-events", "process-events -- fire all events due at or before current-beat.\n\nParameters:\n  sched -- PatternScheduler\n  current-beat -- current beat time\n\nReturns:\n  Number of events processed."},
    {"process-samples", "process-samples -- advance the clock by samples and fire due events.\n\nParameters:\n  sched -- PatternScheduler\n  samples -- number of samples to advance\n\nReturns:\n  Number of events processed."},
    {"audio-pattern", "audio-pattern -- wrap a pattern for audio-rate evaluation using sample offsets.\n\nParameters:\n  p -- NumPattern to evaluate\n  clock -- BeatClock for timing\n\nReturns:\n  Function: Samples -> float that evaluates p at the corresponding beat."},
    {"mix-audio-patterns", "mix-audio-patterns -- mix multiple audio-rate patterns by summation.\n\nParameters:\n  patterns -- list of audio-rate functions (Samples -> float)\n\nReturns:\n  Function: Samples -> float returning the sum of all patterns."},
    {"audio-pattern-block", "audio-pattern-block -- render a block of audio from a pattern.\n\nParameters:\n  p -- NumPattern\n  clock -- BeatClock\n  block-size -- number of samples per block\n\nReturns:\n  Function: (output-buffer, sample-offset) -> void writing block-size samples."},
    {"SampleAccuratePattern", "SampleAccuratePattern -- pattern with sample-accurate timing state."},
    {"make-sample-accurate", "make-sample-accurate -- wrap a pattern for sample-accurate evaluation.\n\nParameters:\n  p -- pattern to wrap\n  clock -- BeatClock\n\nReturns:\n  SampleAccuratePattern."},
    {"sap-eval", "sap-eval -- evaluate a sample-accurate pattern at a sample offset.\n\nParameters:\n  sap -- SampleAccuratePattern\n  sample-offset -- sample position to evaluate at\n\nReturns:\n  Pattern value at the corresponding beat."},
    {"sap-update", "sap-update -- advance a sample-accurate pattern to a new sample position.\n\nParameters:\n  sap -- SampleAccuratePattern\n  new-sample -- new sample position\n\nReturns:\n  Updated SampleAccuratePattern with cached last value."},
    {"TempoTracker", "TempoTracker -- tracks beat time across multiple tempo changes."},
    {"tempo-tracker-new", "tempo-tracker-new -- create a new tempo tracker at a constant initial BPM.\n\nParameters:\n  bpm -- initial BPM\n  sample-rate -- audio sample rate\n\nReturns:\n  TempoTracker with no tempo changes."},
    {"tempo-at", "tempo-at -- query the BPM at a specific sample position.\n\nParameters:\n  tracker -- TempoTracker\n  sample -- sample position to query\n\nReturns:\n  BPM at that sample."},
    {"beats-at", "beats-at -- compute beat time at a sample accounting for tempo changes.\n\nParameters:\n  tracker -- TempoTracker\n  sample -- sample position to query\n\nReturns:\n  Beat time at that sample."},
    {"schedule-at-sample", "schedule-at-sample -- schedule a callback to fire at a specific sample position.\n\nParameters:\n  sched -- PatternScheduler\n  at-sample -- sample position to trigger\n  callback -- function to call\n\nReturns:\n  Event ID."},
    {"schedule-pattern-at-sample", "schedule-pattern-at-sample -- schedule a pattern evaluation at a sample position.\n\nParameters:\n  sched -- PatternScheduler\n  at-sample -- sample position to trigger\n  pattern -- pattern to evaluate\n  callback -- function called with the result\n\nReturns:\n  Event ID."},
    {"sub", "sub -- subtract a constant or pattern from a numeric pattern.\n\nParameters:\n  p -- base NumPattern\n  amount -- constant float or NumPattern to subtract\n\nReturns:\n  NumPattern returning p(t) - amount."},
    {"mul", "mul -- multiply a numeric pattern by a constant or pattern.\n\nParameters:\n  p -- base NumPattern\n  factor -- constant float or NumPattern\n\nExample:\n  NumPattern returning p(t) * factor.\n  \n    ((mul my-pat 0.5) 0.5)  ; halve the values"},
    {"div", "div -- divide a numeric pattern by a constant or pattern.\n\nParameters:\n  p -- base NumPattern\n  divisor -- constant float or NumPattern (returns 0 if divisor is zero)\n\nReturns:\n  NumPattern returning p(t) / divisor."},
    {"range", "range -- map pattern values from one range to another.\n\nParameters:\n  p -- NumPattern with input values\n  from-low -- lower bound of input range\n  from-high -- upper bound of input range\n  to-low -- lower bound of output range\n  to-high -- upper bound of output range\n\nExample:\n  NumPattern with values linearly mapped and clamped to [to-low, to-high].\n  \n    ((range my-pat 0.0 1.0 440.0 880.0) 0.5)  ; => 660.0"},
    {"clamp", "clamp -- clamp pattern values to [low, high].\n\nParameters:\n  p -- NumPattern\n  low -- minimum output value\n  high -- maximum output value\n\nReturns:\n  NumPattern with values clamped."},
    {"normalize", "normalize -- map pattern values to [0, 1].\n\nParameters:\n  p -- NumPattern\n  min -- expected minimum of p\n  max -- expected maximum of p\n\nReturns:\n  NumPattern with values normalised to [0, 1]."},
    {"mod-pat", "mod-pat -- apply modulo to pattern values.\n\nParameters:\n  p -- NumPattern\n  mod -- modulo divisor\n\nReturns:\n  NumPattern with values wrapped to [0, mod)."},
    {"wrap", "wrap -- wrap pattern values to stay within [low, high].\n\nParameters:\n  p -- NumPattern\n  low -- lower bound\n  high -- upper bound\n\nReturns:\n  NumPattern with values wrapped into [low, high]."},
    {"exp-pat", "exp-pat -- apply exp() to pattern values.\n\nParameters:\n  p -- NumPattern (values in radians or raw)\n\nReturns:\n  NumPattern with e^p(t)."},
    {"log-pat", "log-pat -- apply logarithm to pattern values.\n\nParameters:\n  p -- NumPattern (must be > 0)\n  base -- logarithm base (default: math/E)\n\nReturns:\n  NumPattern with log_base(p(t))."},
    {"pow-pat", "pow-pat -- raise pattern values to a constant exponent.\n\nParameters:\n  p -- NumPattern (base)\n  exponent -- power to raise to\n\nReturns:\n  NumPattern with p(t)^exponent."},
    {"sqrt-pat", "sqrt-pat -- square root of pattern values.\n\nParameters:\n  p -- NumPattern (values must be >= 0)\n\nReturns:\n  NumPattern with sqrt(p(t))."},
    {"sin-pat", "sin-pat -- apply sin() to pattern values.\n\nParameters:\n  p -- NumPattern in radians\n\nReturns:\n  NumPattern with sin(p(t))."},
    {"cos-pat", "cos-pat -- apply cos() to pattern values.\n\nParameters:\n  p -- NumPattern in radians\n\nReturns:\n  NumPattern with cos(p(t))."},
    {"tan-pat", "tan-pat -- apply tan() to pattern values.\n\nParameters:\n  p -- NumPattern in radians\n\nReturns:\n  NumPattern with tan(p(t))."},
    {"saw", "saw -- sawtooth wave pattern.\n\nParameters:\n  freq -- frequency in cycles per beat (default: 1.0)\n  amp -- amplitude (default: 1.0)\n\nReturns:\n  NumPattern descending from amp to 0 each cycle."},
    {"tri", "tri -- triangle wave pattern.\n\nParameters:\n  freq -- frequency in cycles per beat (default: 1.0)\n  amp -- amplitude (default: 1.0)\n\nReturns:\n  NumPattern rising and falling symmetrically within [-amp, amp]."},
    {"pulse", "pulse -- pulse wave pattern.\n\nParameters:\n  freq -- frequency in cycles per beat (default: 1.0)\n  amp -- pulse height (default: 1.0)\n  width -- pulse width 0-1 (default: 0.5)\n\nReturns:\n  NumPattern returning amp during pulse, 0.0 otherwise."},
    {"jitter", "jitter -- add random noise to pattern values.\n\nParameters:\n  p -- base pattern\n  amount -- maximum jitter magnitude added to each float value\n\nReturns:\n  Pattern<T> with random perturbation added to numeric values."},
    {"rand-select", "rand-select -- randomly pick one of several patterns on each evaluation.\n\nParameters:\n  patterns -- patterns to choose from\n\nReturns:\n  Pattern<T> delegating to a randomly selected sub-pattern each beat."},
    {"rand-value", "rand-value -- randomly select a constant value on each evaluation.\n\nParameters:\n  values -- values to choose from\n\nReturns:\n  Pattern<T>."},
    {"white-noise", "white-noise -- white noise pattern returning random floats in [0, 1).\n\nReturns:\n  NumPattern with uniform random values."},
    {"pink-noise", "pink-noise -- approximate pink noise pattern.\n\nReturns:\n  NumPattern producing spectrally shaped noise."},
    {"perlin-noise", "perlin-noise -- simplified Perlin-style noise pattern.\n\nParameters:\n  scale -- time scale (higher = more detail, default: 1.0)\n  offset -- time offset (default: 0.0)\n\nReturns:\n  NumPattern with smooth random values."},
    {"adsr", "adsr -- ADSR envelope pattern.\n\nParameters:\n  attack -- attack time in beats\n  decay -- decay time in beats\n  sustain -- sustain level (0-1)\n  release -- release time in beats\n  gate -- BoolPattern for gate (default: const true)\n\nExample:\n  NumPattern producing ADSR envelope values.\n  \n    ((adsr 0.1 0.2 0.7 0.3) 0.5)"},
    {"ar", "ar -- simple attack-release envelope pattern.\n\nParameters:\n  attack -- attack time in beats\n  release -- release time in beats\n  gate -- BoolPattern (default: const true)\n\nReturns:\n  NumPattern."},
    {"decay-exp", "decay-exp -- exponential decay envelope pattern.\n\nParameters:\n  decay -- time constant in beats\n  gate -- BoolPattern (default: const true)\n\nReturns:\n  NumPattern returning e^(-t/decay)."},
    {"decay-lin", "decay-lin -- linear decay envelope pattern.\n\nParameters:\n  decay -- decay duration in beats\n  gate -- BoolPattern (default: const true)\n\nReturns:\n  NumPattern returning max(0, 1 - t/decay)."},
    {"and-bit", "and-bit -- bitwise AND of two integer patterns.\n\nParameters:\n  p1 -- first IntPattern\n  p2 -- IntPattern or integer constant\n\nReturns:\n  IntPattern with bitwise AND applied."},
    {"or-bit", "or-bit -- bitwise OR of two integer patterns.\n\nParameters:\n  p1 -- first IntPattern\n  p2 -- IntPattern or integer constant\n\nReturns:\n  IntPattern with bitwise OR applied."},
    {"xor-bit", "xor-bit -- bitwise XOR of two integer patterns.\n\nParameters:\n  p1 -- first IntPattern\n  p2 -- IntPattern or integer constant\n\nReturns:\n  IntPattern with bitwise XOR applied."},
    {"not-bit", "not-bit -- bitwise NOT of an integer pattern.\n\nParameters:\n  p -- IntPattern\n\nReturns:\n  IntPattern with bitwise NOT applied."},
    {"floor-pat", "floor-pat -- floor each pattern value.\n\nParameters:\n  p -- NumPattern\n\nReturns:\n  NumPattern with floor(p(t))."},
    {"ceil-pat", "ceil-pat -- ceiling each pattern value.\n\nParameters:\n  p -- NumPattern\n\nReturns:\n  NumPattern with ceil(p(t))."},
    {"round-pat", "round-pat -- round each pattern value to the nearest integer.\n\nParameters:\n  p -- NumPattern\n\nReturns:\n  NumPattern with round(p(t))."},
    {"quantize-int", "quantize-int -- quantize pattern values to nearest integer (alias for round-pat).\n\nParameters:\n  p -- NumPattern\n\nReturns:\n  NumPattern."},
    {"quantize-step", "quantize-step -- quantize pattern values to multiples of a step size.\n\nParameters:\n  p -- NumPattern\n  step -- quantization step size\n\nExample:\n  NumPattern with values snapped to step multiples.\n  \n    ((quantize-step my-pat 0.25) 0.0)"},
    {"concat-str", "concat-str -- concatenate two string patterns.\n\nParameters:\n  p1 -- first StrPattern\n  p2 -- StrPattern or string constant\n\nReturns:\n  StrPattern with concatenated strings."},
    {"upper-pat", "upper-pat -- convert string pattern values to uppercase.\n\nParameters:\n  p -- StrPattern\n\nReturns:\n  StrPattern with uppercased values."},
    {"lower-pat", "lower-pat -- convert string pattern values to lowercase.\n\nParameters:\n  p -- StrPattern\n\nReturns:\n  StrPattern with lowercased values."},
    {"Real-Time", "Real-Time -- create a wall-clock Time capability backed by libc time().\n\nSince: Phase 16"},
