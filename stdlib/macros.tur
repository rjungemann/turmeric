;; Standard library macros for Turmeric
;; Phase 7: Core macros
;; Phase M7: Wrapped in (defmodule tur/macros ...). The auto-loader treats
;; modules under the `tur/` namespace as implicitly imported, so the macros
;; below remain visible globally just like in pre-module code.

(defmodule tur/macros
  (export cond when unless must! must-msg! ignore! do-m for doc
          assert! assert-msg! require! require-msg!
          ensure! ensure-msg! invariant! invariant-msg!
          curry with-resource must-use)

;;; cond -- variadic conditional branching via nested if chains.
;;;
;;; Parameters:
;;;   & clauses -- alternating test/expression pairs, with optional :else at end
;;;
;;; Returns:
;;;   The expression corresponding to the first truthy test, or the :else
;;;   expression if present, or nil if no clause matches.
;;;
;;; Example:
;;;   (cond (> x 0) :pos (< x 0) :neg :else :zero)  ; => :pos/:neg/:zero
;;;
;;; Since: Phase 7
(defmacro cond [& clauses]
  (if (empty? clauses)
    nil
    (if (= (first clauses) :else)
      (second clauses)
      (list if (first clauses) (second clauses)
            (list cond ~@(rest (rest clauses)))))))

;;; when -- evaluate body only if test is truthy.
;;;
;;; Parameters:
;;;   test -- the condition to evaluate
;;;   body -- expression to evaluate when test is truthy
;;;
;;; Returns:
;;;   The value of body if test is truthy, otherwise nil.
;;;
;;; Example:
;;;   (when (> x 0) (print "positive"))  ; => prints if x > 0
;;;
;;; Since: Phase 7
(defmacro when [test body]
  (if test (do body)))

;;; unless -- evaluate body only if test is falsy.
;;;
;;; Parameters:
;;;   test -- the condition to evaluate
;;;   body -- expression to evaluate when test is falsy
;;;
;;; Returns:
;;;   The value of body if test is falsy, otherwise nil.
;;;
;;; Example:
;;;   (unless (= x 0) (/ 1 x))  ; => evaluates only when x is non-zero
;;;
;;; Since: Phase 7
(defmacro unless [test body]
  (if test nil (do body)))

;;; must! -- unwrap an option or result value, panicking if absent.
;;;
;;; Parameters:
;;;   expr -- an option or result expression to unwrap
;;;
;;; Returns:
;;;   The unwrapped inner value.
;;;
;;; Example:
;;;   (must! (option-some 42))  ; => 42
;;;
;;; Since: Phase R4
(defmacro must! [expr]
  (option-must expr))

;;; must-msg! -- unwrap an option or result value with a custom panic message.
;;;
;;; Parameters:
;;;   expr -- an option or result expression to unwrap
;;;   msg  -- the message to panic with if the value is absent
;;;
;;; Returns:
;;;   The unwrapped inner value.
;;;
;;; Example:
;;;   (must-msg! (option-some 42) "expected a value")  ; => 42
;;;
;;; Since: Phase R4
(defmacro must-msg! [expr msg]
  (option-expect expr msg))

;;; ignore! -- explicitly discard a result value.
;;;
;;; Parameters:
;;;   expr -- the expression whose value should be discarded
;;;
;;; Returns:
;;;   nil
;;;
;;; Example:
;;;   (ignore! (some-fn-with-result))  ; => nil
;;;
;;; Since: Phase R6
(defmacro ignore! [expr]
  (do expr nil))

;;; do-m -- monadic do-notation using .bind dispatch.
;;;
;;; Parameters:
;;;   & forms -- alternating variable/monadic-action pairs followed by a body;
;;;              the last form is the body expression
;;;
;;; Returns:
;;;   A nested .bind chain that threads variable bindings through monadic actions,
;;;   ending with the body expression.
;;;
;;; Example:
;;;   (do-m x (option-some 5) y (option-some 3) (option-some (+ x y)))
;;;   ; => (.bind (option-some 5) (fn [x] (.bind (option-some 3) (fn [y] (option-some (+ x y))))))
;;;
;;; Since: Phase HKT H6
(defmacro do-m [& forms]
  (if (empty? forms)
    nil
    (if (empty? (rest forms))
      (first forms)
      (list .bind (second forms) (list fn `[~(first forms)] (list do-m ~@(rest (rest forms))))))))

;;; for -- monadic comprehension with optional guards.
;;;
;;; Parameters:
;;;   binding-vec -- flat vector of alternating var/collection pairs,
;;;                  with optional :when guard clauses interspersed
;;;   & body      -- the body expression(s) to lift into the monad
;;;
;;; Returns:
;;;   A nested .bind/.pure chain that iterates over the collections,
;;;   filters via :when guards, and lifts the body into the monad.
;;;
;;; Example:
;;;   (for [x coll] (* x 2))
;;;   ; => (.bind coll (fn [x] (.pure (* x 2))))
;;;
;;;   (for [x coll :when (> x 0) y other] (+ x y))
;;;   ; => (.bind coll (fn [x] (if (> x 0) (.bind other (fn [y] (.pure (+ x y)))) (.empty x))))
;;;
;;; Since: Phase HKT H7
(defmacro for [binding-vec & body]
  (if (empty? binding-vec)
    ;; No bindings: wrap body in pure
    (list .pure (list do ~@body))
    (let [first-b (first binding-vec)
          rest-bv  (rest binding-vec)]
      (if (= first-b :when)
        ;; :when guard at the head of the binding vector
        (let [pred (first rest-bv)
              more (rest rest-bv)]
          (if (empty? more)
            (list if pred (list .pure (list do ~@body)) (list .empty 0))
            (list if pred (list for (list ~@more) ~@body) (list .empty 0))))
        ;; var/coll pair -- var is first-b, coll is next element
        (let [var  first-b
              coll (first rest-bv)
              more (rest rest-bv)]
          (if (empty? more)
            ;; Last binding: .bind coll (fn [var] (.pure body))
            (list .bind coll (list fn `[~var] (list .pure (list do ~@body))))
            ;; More bindings remain -- check if next is :when
            (let [next-first (first more)
                  next-rest  (rest more)]
              (if (= next-first :when)
                ;; Inline :when -- use var as type witness for .empty dispatch
                (let [pred  (first next-rest)
                      after (rest next-rest)]
                  (if (empty? after)
                    (list .bind coll (list fn `[~var]
                      (list if pred (list .pure (list do ~@body)) (list .empty var))))
                    (list .bind coll (list fn `[~var]
                      (list if pred (list for (list ~@after) ~@body) (list .empty var))))))
                ;; More var/coll bindings remain
                (list .bind coll (list fn `[~var] (list for (list ~@more) ~@body)))))))))))

;;; Phase C1: Runtime contract macros
;; contract-enabled?, tur-contract-check, and tur-contract-check-inv are
;; defined in stdlib/contract.tur (tur/contract module), which is auto-loaded
;; before this file. The macros below expand to calls to those helpers.

;;; assert! -- unconditional sanity check, panics with "Assertion failed" if false.
;;;
;;; Parameters:
;;;   condition -- the boolean expression to check
;;;
;;; Returns:
;;;   nil on success; panics on failure.
;;;
;;; Example:
;;;   (assert! (= x 1))  ; => panics if x != 1
;;;
;;; Since: Phase C1
(defmacro assert! [condition]
  (tur-contract-check condition "Assertion failed"))

;;; assert-msg! -- unconditional sanity check with custom panic message.
;;;
;;; Parameters:
;;;   condition -- the boolean expression to check
;;;   msg       -- the message string to use when panicking
;;;
;;; Returns:
;;;   nil on success; panics with msg on failure.
;;;
;;; Example:
;;;   (assert-msg! (= x 1) "x must be 1")  ; => panics with message if x != 1
;;;
;;; Since: Phase C1
(defmacro assert-msg! [condition msg]
  (tur-contract-check condition msg))

;;; require! -- precondition check at function entry, panics with "Precondition failed" if false.
;;;
;;; Parameters:
;;;   condition -- the boolean precondition to enforce
;;;
;;; Returns:
;;;   nil on success; panics on failure.
;;;
;;; Example:
;;;   (require! (> n 0))  ; => panics if n <= 0
;;;
;;; Since: Phase C1
(defmacro require! [condition]
  (tur-contract-check condition "Precondition failed"))

;;; require-msg! -- precondition check with custom panic message.
;;;
;;; Parameters:
;;;   condition -- the boolean precondition to enforce
;;;   msg       -- the message string to use when panicking
;;;
;;; Returns:
;;;   nil on success; panics with msg on failure.
;;;
;;; Example:
;;;   (require-msg! (> n 0) "n must be positive")  ; => panics with message if n <= 0
;;;
;;; Since: Phase C1
(defmacro require-msg! [condition msg]
  (tur-contract-check condition msg))

;;; ensure! -- postcondition check, panics with "Postcondition failed" if false.
;;;
;;; Parameters:
;;;   condition -- the boolean postcondition to enforce
;;;
;;; Returns:
;;;   nil on success; panics on failure.
;;;
;;; Example:
;;;   (ensure! (>= result 0))  ; => panics if result is negative
;;;
;;; Since: Phase C1
(defmacro ensure! [condition]
  (tur-contract-check condition "Postcondition failed"))

;;; ensure-msg! -- postcondition check with custom panic message.
;;;
;;; Parameters:
;;;   condition -- the boolean postcondition to enforce
;;;   msg       -- the message string to use when panicking
;;;
;;; Returns:
;;;   nil on success; panics with msg on failure.
;;;
;;; Example:
;;;   (ensure-msg! (>= result 0) "result must be non-negative")
;;;
;;; Since: Phase C1
(defmacro ensure-msg! [condition msg]
  (tur-contract-check condition msg))

;;; invariant! -- check a structural invariant on a value, panics with "Invariant failed" if false.
;;;
;;; Parameters:
;;;   obj       -- the value to check
;;;   predicate -- a single-argument function that returns true if the invariant holds
;;;
;;; Returns:
;;;   nil on success; panics on failure.
;;;
;;; Example:
;;;   (invariant! my-list non-empty?)  ; => panics if my-list fails non-empty?
;;;
;;; Since: Phase C1
(defmacro invariant! [obj predicate]
  (tur-contract-check-inv obj predicate "Invariant failed"))

;;; invariant-msg! -- check a structural invariant with custom panic message.
;;;
;;; Parameters:
;;;   obj       -- the value to check
;;;   predicate -- a single-argument function that returns true if the invariant holds
;;;   msg       -- the message string to use when panicking
;;;
;;; Returns:
;;;   nil on success; panics with msg on failure.
;;;
;;; Example:
;;;   (invariant-msg! my-list non-empty? "list must not be empty")
;;;
;;; Since: Phase C1
(defmacro invariant-msg! [obj predicate msg]
  (tur-contract-check-inv obj predicate msg))

;;; curry -- convert a 2-argument function to its curried form.
;;;
;;; Parameters:
;;;   f -- a 2-argument function
;;;
;;; Returns:
;;;   A 1-argument function that, given its first argument, returns a
;;;   1-argument function that applies f to both.
;;;
;;; Example:
;;;   (defn add [a b] :int (+ a b))
;;;   (let [add1 ((curry add) 1)]
;;;     (add1 41))  ; => 42
;;;
;;; Since: CY3
(defmacro curry [f]
  `(fn [a] (fn [b] (~f a b))))

;;; doc -- print documentation for a function, macro, or struct at the REPL.
;;;
;;; Parameters:
;;;   name -- symbol whose documentation to display
;;;
;;; Returns:
;;;   Prints the doc string to stdout; returns nil.
;;;
;;; Example:
;;;   (doc cons)    ; prints: cons -- prepend a value to a list. ...
;;;   (doc when)    ; prints: when -- evaluate body only if test is truthy. ...
;;;
;;; Since: Phase D1 (auto-docs)
(defmacro doc [name]
  (let [entry (doc-lookup name)]
    (if (not (= entry 0))
      (println entry)
      (println "No documentation found."))))

;;; with-resource -- bind and safely consume a resource within a scope.
;;;
;;; Parameters:
;;;   binding -- a two-element vector [name init] where init produces the resource
;;;   & body  -- expressions forming the scope in which the resource is available
;;;
;;; Returns:
;;;   The value of the last body expression.
;;;
;;; Example:
;;;   ;; Under -Xsubstructural, r is inferred as linear (must be consumed):
;;;   (with-resource [r (ref 42)]
;;;     (println @r)
;;;     (drop! r))
;;;
;;;   ;; With explicit ^linear annotation:
;;;   (with-resource [^linear fh (open-file "data.txt")]
;;;     (close-file fh))
;;;
;;; Since: ST3
(defmacro with-resource [binding & body]
  (let [bname (first binding)
        binit (second binding)]
    (list let `[~bname ~binit] (list do ~@body))))

;;; must-use -- wrap a value to enforce that it is used at least once.
;;;
;;; Parameters:
;;;   expr -- the expression whose value must be used
;;;
;;; Returns:
;;;   The value of expr, annotated as ^relevant (must-use under -Xsubstructural).
;;;
;;; Example:
;;;   ;; Under -Xsubstructural, the result must be observed before scope exit:
;;;   (let [r (must-use (acquire-resource))]
;;;     (process r)
;;;     (process r))  ; OK -- ^relevant allows duplication
;;;
;;;   ;; Dropping without use is an error:
;;;   (let [r (must-use (acquire-resource))]
;;;     0)            ; ERROR TUR-E0151: relevant value dropped without use
;;;
;;; Since: ST3
(defmacro must-use [expr]
  (list let (vec (quote ^relevant) (quote __must_use_val) expr) __must_use_val))
)
