;;; tur/ref -- heap-allocated mutable reference cell with independent ownership.
;;;
;;; ref-new allocates; ref-get reads; ref-set writes; ref-free releases.
;;;
;;; Since: Phase B1
;; Ref (Reference) type for Turmeric
;; Heap-allocated container with independent ownership
;; Phase B1: Clone trait infrastructure
;;; Ref -- heap-allocated single-value container with independent ownership.
;;;
;;; Since: Phase B1
(defstruct Ref [value :int])
;; Create a new Ref from a value (takes ownership of the pointer)
;; The caller is responsible for ensuring the value is heap-allocated
;; if it needs to outlive the Ref.
;;; ref-new -- allocate a new Ref cell on the heap containing value.
;;;
;;; Parameters:
;;;   value -- the int64 value to store inside the Ref
;;;
;;; Returns:
;;;   An opaque :int handle (pointer cast) to the new Ref cell.
;;;
;;; Example:
;;;   (def r (ref-new 42))  ; => handle to Ref{42}
;;;
;;; Since: Phase B1

(defn ref-new [value] :int
  ```c struct { int64_t value; } *ref = malloc(sizeof(struct { int64_t value; }));
  ref->value = value;
  return (int64_t)(intptr_t)ref;
  ```)
;; Get the contained value from a Ref
;;; ref-get -- read the value stored in a Ref cell.
;;;
;;; Parameters:
;;;   r -- opaque Ref handle returned by ref-new
;;;
;;; Returns:
;;;   The int64 value stored inside the Ref.
;;;
;;; Example:
;;;   (ref-get (ref-new 99))  ; => 99
;;;
;;; Since: Phase B1

(defn ref-get [r] :int
  ```c struct { int64_t value; } *ref = (struct { int64_t value; } *)(intptr_t)r;
  if (!ref) {
    fprintf(stderr, "ref-get: null ref\n");
    exit(1);
  }
  return ref->value;
  ```)
;; Free a Ref (does NOT free the contained value - shallow free)
;;; ref-free -- free the Ref cell (shallow; does not free the contained value).
;;;
;;; Parameters:
;;;   r -- opaque Ref handle returned by ref-new
;;;
;;; Since: Phase B1

(defn ref-free [r]
  ```c free((void*)(intptr_t)r);
  ```)
;; Phase B1: Clone instance for Ref
;; Requires the Clone typeclass to already be in scope (from stdlib/typeclass.tur).
;; Deep clone: allocates a new Ref struct on the heap with a copy of the contained
;; int64_t value (independent ownership).
;; x has type Ref (struct value) inside the generated C method.
;;; Clone [Ref] -- deep-clone a Ref struct: allocates a new Ref with an independent copy of the value.
;;;
;;; Since: Phase B1

(definstance Clone [Ref] (clone [x] :int ```c struct { int64_t value; } *dst = malloc(sizeof(Ref));
    dst->value = x.value;
    return (int64_t)(intptr_t)dst;
    ```))
