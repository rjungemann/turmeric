;;; tur/json -- JSON encode and decode with no external dependencies.
;;;
;;; Pure C implementation. Supports null, boolean, number, string, array, object.
;;;
;;; Runtime parsing/serialization lives here (json/decode, json/encode).
;;;
;;; Compile-time JSON: the #json(...) reader macro (opt-in via -Xjson-reader)
;;; parses a verbatim JSON blob at compile time and emits the equivalent
;;; tagged-node constructor calls from this module (json/object-put,
;;; json/array-push, json/string, json/int, json/bool, json/null, ...). The
;;; result is the same node tree json/decode produces -- so #json(...) is a
;;; compile-time-validated json/decode that needs no runtime parse step, and
;;; null is a genuine null node (json/type == 0), not a 0 sentinel. See
;;; docs/guides/json-guide.md.
;;;
;;; Since: Phase B1
;; stdlib/json.tur -- JSON encode and decode.
;;
;; Pure C implementation with no external dependencies.
;; Uses vec.tur-compatible layouts for arrays and linked lists for objects.
;;
;; JSON value layout: int64_t[2]
;;   [0] = type tag: 0=null 1=bool 2=int 3=float 4=string 5=array 6=object
;;   [1] = payload
;;     null/bool/int: direct int64_t value
;;     float:         double bits stored via memcpy into int64_t
;;     string:        (int64_t)(char*)  -- heap-allocated, owned
;;     array:         (int64_t)(vec*)   -- vec = { int64_t* data; size_t len; size_t cap; }
;;                      each data[i] is a (int64_t)(json_node*)
;;     object:        (int64_t)(entry*) -- linked list of int64_t[3]
;;                      entry = { (int64_t)key_cstr, (int64_t)val_node, (int64_t)next_entry }
;;; json/null -- create a JSON null node.
;;;
;;; Returns:
;;;   A heap-allocated JSON null node.
;;;
;;; Example:
;;;   (json/null)  ; => <null node>
;;;
;;; Since: Phase B2
(defn json/null [] : int
  ```c
  int64_t *n = malloc(2 * sizeof(int64_t));
  n[0] = 0; n[1] = 0;
  return (int64_t)(intptr_t)n;
  ```)
;;; json/bool -- create a JSON boolean node.
;;;
;;; Parameters:
;;;   v -- 0 for false, non-zero for true
;;;
;;; Returns:
;;;   A heap-allocated JSON bool node.
;;;
;;; Example:
;;;   (json/bool 1)  ; => <true node>
;;;
;;; Since: Phase B2

(defn json/bool [v : int] : int
  ```c
  int64_t *n = malloc(2 * sizeof(int64_t));
  n[0] = 1; n[1] = v ? 1 : 0;
  return (int64_t)(intptr_t)n;
  ```)
;;; json/int -- create a JSON integer node.
;;;
;;; Parameters:
;;;   v -- the integer value
;;;
;;; Returns:
;;;   A heap-allocated JSON int node.
;;;
;;; Example:
;;;   (json/int 42)  ; => <42 node>
;;;
;;; Since: Phase B2

(defn json/int [v : int] : int
  ```c
  int64_t *n = malloc(2 * sizeof(int64_t));
  n[0] = 2; n[1] = v;
  return (int64_t)(intptr_t)n;
  ```)
;;; json/float -- create a JSON float node.
;;;
;;; Parameters:
;;;   v -- the float value
;;;
;;; Returns:
;;;   A heap-allocated JSON float node.
;;;
;;; Example:
;;;   (json/float 3.14)  ; => <3.14 node>
;;;
;;; Since: Phase B2

(defn json/float [v : float] : int
  ```c
  int64_t *n = malloc(2 * sizeof(int64_t));
  n[0] = 3;
  memcpy(&n[1], &v, sizeof(double));
  return (int64_t)(intptr_t)n;
  ```)
;;; json/string -- create a JSON string node from a cstr.
;;;
;;; Parameters:
;;;   s -- NUL-terminated cstr (copied internally)
;;;
;;; Returns:
;;;   A heap-allocated JSON string node owning a copy of s.
;;;
;;; Example:
;;;   (json/string "hello")  ; => <"hello" node>
;;;
;;; Since: Phase B2

(defn json/string [s : cstr] : int
  ```c
  int64_t *n = malloc(2 * sizeof(int64_t));
  n[0] = 4; n[1] = (int64_t)(intptr_t)strdup(s);
  return (int64_t)(intptr_t)n;
  ```)
;;; json/array-new -- create an empty JSON array node.
;;;
;;; Returns:
;;;   A heap-allocated JSON array node backed by a growable vec.
;;;
;;; Example:
;;;   (json/array-new)  ; => <[] node>
;;;
;;; Since: Phase B2

(defn json/array-new [] : int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *v = malloc(sizeof(*v));
  v->data = NULL; v->len = 0; v->cap = 0;
  int64_t *n = malloc(2 * sizeof(int64_t));
  n[0] = 5; n[1] = (int64_t)(intptr_t)v;
  return (int64_t)(intptr_t)n;
  ```)
;;; json/array-push -- append an element to a JSON array node.
;;;
;;; Parameters:
;;;   arr  -- JSON array node from json/array-new
;;;   elem -- JSON node to append
;;;
;;; Returns:
;;;   The same arr pointer (mutated in place).
;;;
;;; Example:
;;;   (json/array-push arr (json/int 1))
;;;
;;; Since: Phase B2

(defn json/array-push [arr : int elem : int] : int
  ```c
  int64_t *n = (int64_t*)(intptr_t)arr;
  struct { int64_t *data; size_t len; size_t cap; } *v =
      (void*)(intptr_t)n[1];
  if (v->len >= v->cap) {
    v->cap = v->cap > 0 ? v->cap * 2 : 4;
    v->data = realloc(v->data, v->cap * sizeof(int64_t));
  }
  v->data[v->len++] = elem;
  return arr;
  ```)
;;; json/object-new -- create an empty JSON object node.
;;;
;;; Returns:
;;;   A heap-allocated JSON object node with no entries.
;;;
;;; Example:
;;;   (json/object-new)  ; => <{} node>
;;;
;;; Since: Phase B2

(defn json/object-new [] : int
  ```c
  int64_t *n = malloc(2 * sizeof(int64_t));
  n[0] = 6; n[1] = 0;
  return (int64_t)(intptr_t)n;
  ```)
;;; json/object-put -- add or update a key-value pair in a JSON object.
;;;
;;; Parameters:
;;;   obj -- JSON object node
;;;   key -- NUL-terminated key cstr (copied internally)
;;;   val -- JSON value node for the key
;;;
;;; Returns:
;;;   The same obj pointer (mutated in place).
;;;
;;; Example:
;;;   (json/object-put obj "x" (json/int 1))
;;;
;;; Since: Phase B2

(defn json/object-put [obj : int key : cstr val : int] : int
  ```c
  int64_t *n = (int64_t*)(intptr_t)obj;
  int64_t *entry = malloc(3 * sizeof(int64_t));
  entry[0] = (int64_t)(intptr_t)strdup(key);
  entry[1] = val;
  entry[2] = n[1];
  n[1] = (int64_t)(intptr_t)entry;
  return obj;
  ```)
;;; json/type -- return the type tag of a JSON node.
;;;
;;; Parameters:
;;;   node -- JSON node
;;;
;;; Returns:
;;;   0=null 1=bool 2=int 3=float 4=string 5=array 6=object
;;;
;;; Example:
;;;   (json/type (json/int 5))  ; => 2
;;;
;;; Since: Phase B2

(defn json/type [node : int] : int
  ```c
  if (!node) return 0;
  return ((int64_t*)(intptr_t)node)[0];
  ```)
;;; json/get-bool -- extract the boolean value from a bool node.
;;;
;;; Parameters:
;;;   node -- JSON bool node
;;;
;;; Returns:
;;;   true or false.
;;;
;;; Example:
;;;   (json/get-bool (json/bool 1))  ; => true
;;;
;;; Since: Phase B2

(defn json/get-bool [node : int] : bool
  ```c
  return ((int64_t*)(intptr_t)node)[1] != 0;
  ```)
;;; json/get-int -- extract the integer value from an int node.
;;;
;;; Parameters:
;;;   node -- JSON int node
;;;
;;; Returns:
;;;   The integer value as :int.
;;;
;;; Example:
;;;   (json/get-int (json/int 42))  ; => 42
;;;
;;; Since: Phase B2

(defn json/get-int [node : int] : int
  ```c
  return ((int64_t*)(intptr_t)node)[1];
  ```)
;;; json/get-float -- extract the float value from a float node.
;;;
;;; Parameters:
;;;   node -- JSON float node
;;;
;;; Returns:
;;;   The float value as :float.
;;;
;;; Example:
;;;   (json/get-float (json/float 1.5))  ; => 1.5
;;;
;;; Since: Phase B2

(defn json/get-float [node : int] : float
  ```c
  double v;
  memcpy(&v, &((int64_t*)(intptr_t)node)[1], sizeof(double));
  return v;
  ```)
;;; json/get-string -- extract the string value from a string node.
;;;
;;; Parameters:
;;;   node -- JSON string node
;;;
;;; Returns:
;;;   The string cstr (owned by the node; do not free).
;;;
;;; Example:
;;;   (json/get-string (json/string "hi"))  ; => "hi"
;;;
;;; Since: Phase B2

(defn json/get-string [node : int] : cstr
  ```c
  return (const char*)(intptr_t)((int64_t*)(intptr_t)node)[1];
  ```)
;;; json/array-len -- return the number of elements in a JSON array node.
;;;
;;; Parameters:
;;;   node -- JSON array node
;;;
;;; Returns:
;;;   Number of elements as :int.
;;;
;;; Example:
;;;   (json/array-len my-array)  ; => 3
;;;
;;; Since: Phase B2

(defn json/array-len [node : int] : int
  ```c
  int64_t *n = (int64_t*)(intptr_t)node;
  struct { int64_t *data; size_t len; size_t cap; } *v = (void*)(intptr_t)n[1];
  return (int64_t)v->len;
  ```)
;;; json/array-get -- get element i from a JSON array node.
;;;
;;; Parameters:
;;;   node -- JSON array node
;;;   i    -- zero-based index
;;;
;;; Returns:
;;;   The JSON node at index i, or 0 if out of bounds.
;;;
;;; Example:
;;;   (json/array-get my-array 0)  ; => first element node
;;;
;;; Since: Phase B2

(defn json/array-get [node : int i : int] : int
  ```c
  int64_t *n = (int64_t*)(intptr_t)node;
  struct { int64_t *data; size_t len; size_t cap; } *v = (void*)(intptr_t)n[1];
  if (i < 0 || (size_t)i >= v->len) return 0;
  return v->data[i];
  ```)
;;; json/get -- look up a key in a JSON object node.
;;;
;;; Parameters:
;;;   node -- JSON object node
;;;   key  -- NUL-terminated key cstr
;;;
;;; Returns:
;;;   A some option (:int) containing the value node, or none (0) if the
;;;   key is absent.
;;;
;;; Example:
;;;   (json/get my-obj "name")  ; => some(<node>)
;;;
;;; Since: Phase B2

(defn json/get [node : int key : cstr] : int
  ```c
  if (!node) return 0;
  int64_t *n = (int64_t*)(intptr_t)node;
  int64_t cur = n[1];
  while (cur) {
    int64_t *e = (int64_t*)(intptr_t)cur;
    if (strcmp((const char*)(intptr_t)e[0], key) == 0) {
      return tur_box_some(e[1]);
    }
    cur = e[2];
  }
  return 0;
  ```)
;;; json/get! -- look up a key in a JSON object, panicking if absent.
;;;
;;; Parameters:
;;;   node -- JSON object node
;;;   key  -- NUL-terminated key cstr
;;;
;;; Returns:
;;;   The value node.  Panics if the key is not found.
;;;
;;; Example:
;;;   (json/get! my-obj "name")  ; => <node>
;;;
;;; Since: Phase B2

(defn json/get! [node : int key : cstr] : int
  ```c
  if (!node) { fprintf(stderr, "json/get!: null node\n"); abort(); }
  int64_t *n = (int64_t*)(intptr_t)node;
  int64_t cur = n[1];
  while (cur) {
    int64_t *e = (int64_t*)(intptr_t)cur;
    if (strcmp((const char*)(intptr_t)e[0], key) == 0) return e[1];
    cur = e[2];
  }
  fprintf(stderr, "json/get!: key not found: %s\n", key);
  abort();
  return 0;
  ```)
;;; json/encode -- serialize a JSON node tree to a NUL-terminated cstr.
;;;
;;; Parameters:
;;;   node -- root JSON node
;;;
;;; Returns:
;;;   A heap-allocated NUL-terminated JSON string.  The caller must free.
;;;
;;; Example:
;;;   (json/encode (json/int 42))  ; => "42"
;;;
;;; Since: Phase B2
;; Private helpers for json/encode.
;; State is a tur_json_buf { char *data; size_t len; size_t cap; } passed as :ptr.


(defn json-enc-ensure- [b : ptr extra : int] : void
  ```c
  struct tur_json_buf { char *data; size_t len; size_t cap; };
  struct tur_json_buf *bp = (struct tur_json_buf *)b;
  if (bp->len + (size_t)extra + 1 > bp->cap) {
    bp->cap = (bp->len + (size_t)extra + 1) * 2 + 64;
    bp->data = realloc(bp->data, bp->cap);
  }
  ```)

(defn json-enc-append-s- [b : ptr s : cstr] : void
  ```c
  struct tur_json_buf { char *data; size_t len; size_t cap; };
  struct tur_json_buf *bp = (struct tur_json_buf *)b;
  size_t slen = strlen(s);
  json_hyenc_hyensure_hy(b, (int64_t)slen);
  memcpy(bp->data + bp->len, s, slen);
  bp->len += slen;
  bp->data[bp->len] = '\0';
  ```)

(defn json-enc-append-c- [b : ptr c : int] : void
  ```c
  struct tur_json_buf { char *data; size_t len; size_t cap; };
  struct tur_json_buf *bp = (struct tur_json_buf *)b;
  json_hyenc_hyensure_hy(b, 1);
  bp->data[bp->len++] = (char)c;
  bp->data[bp->len] = '\0';
  ```)

(defn json-enc-str- [b : ptr s : cstr] : void
  ```c
  json_hyenc_hyappend_hyc_hy(b, (int64_t)'"');
  for (const char *sp = s; *sp; sp++) {
    if (*sp == '"')       { json_hyenc_hyappend_hys_hy(b, "\\\""); }
    else if (*sp == '\\') { json_hyenc_hyappend_hys_hy(b, "\\\\"); }
    else if (*sp == '\n') { json_hyenc_hyappend_hys_hy(b, "\\n"); }
    else if (*sp == '\r') { json_hyenc_hyappend_hys_hy(b, "\\r"); }
    else if (*sp == '\t') { json_hyenc_hyappend_hys_hy(b, "\\t"); }
    else                  { json_hyenc_hyappend_hyc_hy(b, (int64_t)*sp); }
  }
  json_hyenc_hyappend_hyc_hy(b, (int64_t)'"');
  ```)

(defn json-enc-node- [node : int b : ptr] : void
  ```c
  if (!node) { json_hyenc_hyappend_hys_hy(b, "null"); return; }
  int64_t *np = (int64_t*)(intptr_t)node;
  int type = (int)np[0];
  char tmp[64];
  switch (type) {
    case 0: json_hyenc_hyappend_hys_hy(b, "null"); break;
    case 1: json_hyenc_hyappend_hys_hy(b, np[1] ? "true" : "false"); break;
    case 2: snprintf(tmp, sizeof(tmp), "%lld", (long long)np[1]); json_hyenc_hyappend_hys_hy(b, tmp); break;
    case 3: {
      double v; memcpy(&v, &np[1], sizeof(double));
      snprintf(tmp, sizeof(tmp), "%.17g", v); json_hyenc_hyappend_hys_hy(b, tmp); break;
    }
    case 4: json_hyenc_hystr_hy(b, (const char*)(intptr_t)np[1]); break;
    case 5: {
      struct { int64_t *data; size_t len; size_t cap; } *v = (void*)(intptr_t)np[1];
      json_hyenc_hyappend_hyc_hy(b, (int64_t)'[');
      for (size_t i = 0; i < v->len; i++) {
        if (i > 0) json_hyenc_hyappend_hyc_hy(b, (int64_t)',');
        json_hyenc_hynode_hy(v->data[i], b);
      }
      json_hyenc_hyappend_hyc_hy(b, (int64_t)']');
      break;
    }
    case 6: {
      json_hyenc_hyappend_hyc_hy(b, (int64_t)'{');
      int64_t cur = np[1];
      int first = 1;
      while (cur) {
        int64_t *e = (int64_t*)(intptr_t)cur;
        if (!first) json_hyenc_hyappend_hyc_hy(b, (int64_t)',');
        first = 0;
        json_hyenc_hystr_hy(b, (const char*)(intptr_t)e[0]);
        json_hyenc_hyappend_hyc_hy(b, (int64_t)':');
        json_hyenc_hynode_hy(e[1], b);
        cur = e[2];
      }
      json_hyenc_hyappend_hyc_hy(b, (int64_t)'}');
      break;
    }
    default: json_hyenc_hyappend_hys_hy(b, "null"); break;
  }
  ```)

(defn json/encode [node : int] : cstr
  ```c
  struct tur_json_buf { char *data; size_t len; size_t cap; };
  struct tur_json_buf b;
  b.data = malloc(256);
  b.data[0] = '\0';
  b.len = 0;
  b.cap = 256;
  json_hyenc_hynode_hy(node, (void *)&b);
  return b.data;
  ```)
;;; json/decode -- parse a JSON string into a node tree.
;;;
;;; Parameters:
;;;   s -- NUL-terminated JSON cstr to parse
;;;
;;; Returns:
;;;   A heap-allocated JSON node tree on success, or 0 on parse error.
;;;   Free with json/free when done.
;;;
;;; Example:
;;;   (json/decode "{\"x\":1}")  ; => <object node>
;;;
;;; Since: Phase B2
;; Private helpers for json/decode.
;; State is a tur_json_ctx { const char *s; size_t pos; int err; } passed as :ptr.


(defn json-dec-skip-ws- [c : ptr] : void
  ```c
  struct tur_json_ctx { const char *s; size_t pos; int err; };
  struct tur_json_ctx *cp = (struct tur_json_ctx *)c;
  while (cp->s[cp->pos] == ' ' || cp->s[cp->pos] == '\n' ||
         cp->s[cp->pos] == '\r' || cp->s[cp->pos] == '\t') cp->pos++;
  ```)
;; Returns a heap-allocated mutable char* (caller owns) or NULL on error.

(defn json-dec-parse-string- [c : ptr] : ptr
  ```c
  struct tur_json_ctx { const char *s; size_t pos; int err; };
  struct tur_json_ctx *cp = (struct tur_json_ctx *)c;
  if (cp->s[cp->pos] != '"') { cp->err = 1; return NULL; }
  cp->pos++;
  size_t cap = 64, len = 0;
  char *buf = malloc(cap);
  while (cp->s[cp->pos] && cp->s[cp->pos] != '"') {
    if (len + 4 >= cap) { cap *= 2; buf = realloc(buf, cap); }
    if (cp->s[cp->pos] == '\\') {
      cp->pos++;
      switch (cp->s[cp->pos]) {
        case '"':  buf[len++] = '"';  break;
        case '\\': buf[len++] = '\\'; break;
        case '/':  buf[len++] = '/';  break;
        case 'n':  buf[len++] = '\n'; break;
        case 'r':  buf[len++] = '\r'; break;
        case 't':  buf[len++] = '\t'; break;
        case 'b':  buf[len++] = '\b'; break;
        case 'f':  buf[len++] = '\f'; break;
        default:   buf[len++] = cp->s[cp->pos]; break;
      }
    } else {
      buf[len++] = cp->s[cp->pos];
    }
    cp->pos++;
  }
  if (cp->s[cp->pos] != '"') { cp->err = 1; free(buf); return NULL; }
  cp->pos++;
  buf[len] = '\0';
  return buf;
  ```)

(defn json-dec-parse-value- [c : ptr] : int
  ```c
  struct tur_json_ctx { const char *s; size_t pos; int err; };
  struct tur_json_ctx *cp = (struct tur_json_ctx *)c;
  json_hydec_hyskip_hyws_hy(c);
  char ch = cp->s[cp->pos];
  /* null */
  if (ch == 'n' && strncmp(cp->s + cp->pos, "null", 4) == 0) {
    cp->pos += 4;
    int64_t *n = malloc(2 * sizeof(int64_t)); n[0] = 0; n[1] = 0;
    return (int64_t)(intptr_t)n;
  }
  /* true */
  if (ch == 't' && strncmp(cp->s + cp->pos, "true", 4) == 0) {
    cp->pos += 4;
    int64_t *n = malloc(2 * sizeof(int64_t)); n[0] = 1; n[1] = 1;
    return (int64_t)(intptr_t)n;
  }
  /* false */
  if (ch == 'f' && strncmp(cp->s + cp->pos, "false", 5) == 0) {
    cp->pos += 5;
    int64_t *n = malloc(2 * sizeof(int64_t)); n[0] = 1; n[1] = 0;
    return (int64_t)(intptr_t)n;
  }
  /* string */
  if (ch == '"') {
    char *sv = (char *)json_hydec_hyparse_hystring_hy(c);
    if (!sv) return 0;
    int64_t *n = malloc(2 * sizeof(int64_t));
    n[0] = 4; n[1] = (int64_t)(intptr_t)sv;
    return (int64_t)(intptr_t)n;
  }
  /* number */
  if (ch == '-' || (ch >= '0' && ch <= '9')) {
    char *end;
    int64_t ival = strtoll(cp->s + cp->pos, &end, 10);
    if (*end == '.' || *end == 'e' || *end == 'E') {
      double fval = strtod(cp->s + cp->pos, &end);
      cp->pos = (size_t)(end - cp->s);
      int64_t *n = malloc(2 * sizeof(int64_t)); n[0] = 3;
      memcpy(&n[1], &fval, sizeof(double));
      return (int64_t)(intptr_t)n;
    }
    cp->pos = (size_t)(end - cp->s);
    int64_t *n = malloc(2 * sizeof(int64_t)); n[0] = 2; n[1] = ival;
    return (int64_t)(intptr_t)n;
  }
  /* array */
  if (ch == '[') {
    cp->pos++;
    struct { int64_t *data; size_t len; size_t cap; } *v = malloc(sizeof(*v));
    v->data = NULL; v->len = 0; v->cap = 0;
    json_hydec_hyskip_hyws_hy(c);
    if (cp->s[cp->pos] != ']') {
      for (;;) {
        int64_t elem = json_hydec_hyparse_hyvalue_hy(c);
        if (cp->err) { free(v->data); free(v); return 0; }
        if (v->len >= v->cap) {
          v->cap = v->cap > 0 ? v->cap * 2 : 4;
          v->data = realloc(v->data, v->cap * sizeof(int64_t));
        }
        v->data[v->len++] = elem;
        json_hydec_hyskip_hyws_hy(c);
        if (cp->s[cp->pos] == ']') break;
        if (cp->s[cp->pos] != ',') { cp->err = 1; free(v->data); free(v); return 0; }
        cp->pos++;
      }
    }
    cp->pos++;
    int64_t *n = malloc(2 * sizeof(int64_t)); n[0] = 5; n[1] = (int64_t)(intptr_t)v;
    return (int64_t)(intptr_t)n;
  }
  /* object */
  if (ch == '{') {
    cp->pos++;
    int64_t *n = malloc(2 * sizeof(int64_t)); n[0] = 6; n[1] = 0;
    json_hydec_hyskip_hyws_hy(c);
    if (cp->s[cp->pos] != '}') {
      for (;;) {
        json_hydec_hyskip_hyws_hy(c);
        char *key = (char *)json_hydec_hyparse_hystring_hy(c);
        if (!key || cp->err) { free(n); return 0; }
        json_hydec_hyskip_hyws_hy(c);
        if (cp->s[cp->pos] != ':') { cp->err = 1; free(key); free(n); return 0; }
        cp->pos++;
        int64_t val = json_hydec_hyparse_hyvalue_hy(c);
        if (cp->err) { free(key); free(n); return 0; }
        int64_t *entry = malloc(3 * sizeof(int64_t));
        entry[0] = (int64_t)(intptr_t)key;
        entry[1] = val;
        entry[2] = n[1];
        n[1] = (int64_t)(intptr_t)entry;
        json_hydec_hyskip_hyws_hy(c);
        if (cp->s[cp->pos] == '}') break;
        if (cp->s[cp->pos] != ',') { cp->err = 1; free(n); return 0; }
        cp->pos++;
      }
    }
    cp->pos++;
    return (int64_t)(intptr_t)n;
  }
  cp->err = 1;
  return 0;
  ```)

(defn json/decode [s : cstr] : int
  ```c
  struct tur_json_ctx { const char *s; size_t pos; int err; };
  struct tur_json_ctx ctx; ctx.s = s; ctx.pos = 0; ctx.err = 0;
  int64_t result = json_hydec_hyparse_hyvalue_hy((void *)&ctx);
  if (ctx.err) return 0;
  return result;
  ```)
;;; json/free -- recursively free a JSON node tree.
;;;
;;; Parameters:
;;;   node -- root JSON node to free (may be 0)
;;;
;;; Example:
;;;   (json/free my-node)
;;;
;;; Since: Phase B2
;; Private recursive helper for json/free.

(defn json-free-node- [node : int] : void
  ```c
  if (!node) return;
  int64_t *np = (int64_t*)(intptr_t)node;
  int type = (int)np[0];
  if (type == 4) {
    free((void*)(intptr_t)np[1]);
  } else if (type == 5) {
    struct { int64_t *data; size_t len; size_t cap; } *v = (void*)(intptr_t)np[1];
    for (size_t i = 0; i < v->len; i++) json_hyfree_hynode_hy(v->data[i]);
    free(v->data);
    free(v);
  } else if (type == 6) {
    int64_t cur = np[1];
    while (cur) {
      int64_t *e = (int64_t*)(intptr_t)cur;
      free((void*)(intptr_t)e[0]);
      json_hyfree_hynode_hy(e[1]);
      int64_t next = e[2];
      free(e);
      cur = next;
    }
  }
  free(np);
  ```)

(defn json/free [node : int] : void
  ```c
  json_hyfree_hynode_hy(node);
  ```)
