;;; tur/re -- POSIX extended regular expressions via regcomp/regexec.
;;;
;;; Always available on POSIX systems; no external regex library needed.
;;;
;;; Since: Phase B1
;; stdlib/re.tur -- POSIX extended regular expressions via regex.h.
;;
;; Uses regcomp(3)/regexec(3) which are always available on POSIX systems.
;; Capture groups are returned as vecs of freshly allocated cstr copies.
;;; re/compile -- compile a regular expression pattern.
;;;
;;; Parameters:
;;;   pattern -- NUL-terminated regex pattern cstr (POSIX extended syntax)
;;;
;;; Returns:
;;;   An opaque handle (:int) on success, or 0 on compilation error.
;;;   Free with re/free when done.
;;;
;;; Example:
;;;   (re/compile "([0-9]+)")  ; => <handle>
;;;
;;; Since: Phase B2
(defn re/compile [pattern : cstr] : int
  ```c #include <regex.h>
  regex_t *re = malloc(sizeof(regex_t));
  if (regcomp(re, pattern, REG_EXTENDED) != 0) { free(re); return 0; }
  return (int64_t)(intptr_t)re;
  ```)
;;; re/free -- release a compiled regex handle.
;;;
;;; Parameters:
;;;   re -- handle returned by re/compile
;;;
;;; Example:
;;;   (re/free my-re)
;;;
;;; Since: Phase B2

(defn re/free [re : int] : void
  ```c #include <regex.h>
  if (!re) return;
  regex_t *r = (regex_t*)(intptr_t)re;
  regfree(r);
  free(r);
  ```)
;;; re/match? -- test whether a compiled pattern matches anywhere in input.
;;;
;;; Parameters:
;;;   re    -- compiled regex handle from re/compile
;;;   input -- input string cstr
;;;
;;; Returns:
;;;   true if the pattern matches, false otherwise.
;;;
;;; Example:
;;;   (re/match? my-re "abc123")  ; => true
;;;
;;; Since: Phase B2

(defn re/match? [re : int input : cstr] : bool
  ```c #include <regex.h>
  if (!re) return false;
  regex_t *r = (regex_t*)(intptr_t)re;
  return regexec(r, input, 0, NULL, 0) == 0;
  ```)
;;; re/match -- match a regex against input and return capture groups as a vec.
;;;
;;; Index 0 of the returned vec is the full match; indices 1..n are capture
;;; groups.  Unmatched optional groups are stored as empty strings.
;;;
;;; Parameters:
;;;   re    -- compiled regex handle from re/compile
;;;   input -- input string cstr
;;;
;;; Returns:
;;;   A vec pointer (:int) whose elements are cstr pointers on success,
;;;   or 0 if there is no match.  Free with re/match-free.
;;;
;;; Example:
;;;   (re/match my-re "abc123")  ; => vec of capture group cstrs
;;;
;;; Since: Phase B2

(defn re/match [re : int input : cstr] : int
  ```c #include <regex.h>
  if (!re) return 0;
  regex_t *r = (regex_t*)(intptr_t)re;
  size_t nmatch = r->re_nsub + 1;
  regmatch_t *matches = malloc(nmatch * sizeof(regmatch_t));
  if (regexec(r, input, nmatch, matches, 0) != 0) { free(matches); return 0; }
  struct { int64_t *data; size_t len; size_t cap; } *v = malloc(sizeof(*v));
  v->data = malloc(nmatch * sizeof(int64_t));
  v->len  = 0;
  v->cap  = nmatch;
  for (size_t i = 0; i < nmatch; i++) {
    if (matches[i].rm_so < 0) {
      v->data[v->len++] = (int64_t)(intptr_t)strdup("");
    } else {
      size_t len = (size_t)(matches[i].rm_eo - matches[i].rm_so);
      char *s = malloc(len + 1);
      memcpy(s, input + matches[i].rm_so, len);
      s[len] = '\0';
      v->data[v->len++] = (int64_t)(intptr_t)s;
    }
  }
  free(matches);
  return (int64_t)(intptr_t)v;
  ```)
;;; re/match-free -- free a vec returned by re/match.
;;;
;;; Parameters:
;;;   v -- vec pointer returned by re/match (may be 0)
;;;
;;; Example:
;;;   (re/match-free my-match)
;;;
;;; Since: Phase B2

(defn re/match-free [v : int] : void
  ```c if (!v) return;
  struct { int64_t *data; size_t len; size_t cap; } *vec = (void*)(intptr_t)v;
  for (size_t i = 0; i < vec->len; i++) free((void*)(intptr_t)vec->data[i]);
  free(vec->data);
  free(vec);
  ```)
;;; re/find-all -- find all non-overlapping matches of a regex in input.
;;;
;;; Parameters:
;;;   re    -- compiled regex handle from re/compile
;;;   input -- input string cstr
;;;
;;; Returns:
;;;   A cons list of vec pointers (each vec as returned by re/match).
;;;   Returns 0 (empty list) if there are no matches.
;;;   Free with re/find-all-free.
;;;
;;; Example:
;;;   (re/find-all my-re "a1b2c3")  ; => cons list of match vecs
;;;
;;; Since: Phase B2

(defn re/find-all [re : int input : cstr] : int
  ```c #include <regex.h>
  if (!re) return 0;
  regex_t *r = (regex_t*)(intptr_t)re;
  size_t nmatch = r->re_nsub + 1;
  regmatch_t *matches = malloc(nmatch * sizeof(regmatch_t));
  const char *cur = input;
  int64_t head = 0;
  while (*cur && regexec(r, cur, nmatch, matches, 0) == 0) {
    struct { int64_t *data; size_t len; size_t cap; } *v = malloc(sizeof(*v));
    v->data = malloc(nmatch * sizeof(int64_t));
    v->len  = 0;
    v->cap  = nmatch;
    for (size_t i = 0; i < nmatch; i++) {
      if (matches[i].rm_so < 0) {
        v->data[v->len++] = (int64_t)(intptr_t)strdup("");
      } else {
        size_t len = (size_t)(matches[i].rm_eo - matches[i].rm_so);
        char *s = malloc(len + 1);
        memcpy(s, cur + matches[i].rm_so, len);
        s[len] = '\0';
        v->data[v->len++] = (int64_t)(intptr_t)s;
      }
    }
    int64_t *cell = malloc(2 * sizeof(int64_t));
    cell[0] = (int64_t)(intptr_t)v;
    cell[1] = head;
    head = (int64_t)(intptr_t)cell;
    cur += (matches[0].rm_eo > matches[0].rm_so) ? (size_t)matches[0].rm_eo : 1;
  }
  free(matches);
  return head;
  ```)
;;; re/find-all-free -- free a cons list returned by re/find-all.
;;;
;;; Parameters:
;;;   lst -- cons list of match vecs returned by re/find-all
;;;
;;; Example:
;;;   (re/find-all-free my-matches)
;;;
;;; Since: Phase B2

(defn re/find-all-free [lst : int] : void
  ```c int64_t cur = lst;
  while (cur) {
    int64_t *cell = (int64_t*)(intptr_t)cur;
    int64_t vptr  = cell[0];
    int64_t next  = cell[1];
    if (vptr) {
      struct { int64_t *data; size_t len; size_t cap; } *v = (void*)(intptr_t)vptr;
      for (size_t i = 0; i < v->len; i++) free((void*)(intptr_t)v->data[i]);
      free(v->data);
      free(v);
    }
    free(cell);
    cur = next;
  }
  ```)
;;; re/replace -- replace the first match of a regex in input.
;;;
;;; Parameters:
;;;   re          -- compiled regex handle from re/compile
;;;   input       -- input string cstr
;;;   replacement -- replacement string cstr (literal; no backreferences)
;;;
;;; Returns:
;;;   A heap-allocated cstr with the first match replaced, or a strdup of
;;;   input if there is no match.  The caller must free the result.
;;;
;;; Example:
;;;   (re/replace my-re "hello world" "WORLD")  ; => "hello WORLD"
;;;
;;; Since: Phase B2

(defn re/replace [re : int input : cstr replacement : cstr] : cstr
  ```c #include <regex.h>
  if (!re) return strdup(input);
  regex_t *r = (regex_t*)(intptr_t)re;
  regmatch_t m[1];
  if (regexec(r, input, 1, m, 0) != 0) return strdup(input);
  size_t pre  = (size_t)m[0].rm_so;
  size_t rlen = strlen(replacement);
  size_t suf  = strlen(input + m[0].rm_eo);
  char *out   = malloc(pre + rlen + suf + 1);
  memcpy(out, input, pre);
  memcpy(out + pre, replacement, rlen);
  memcpy(out + pre + rlen, input + m[0].rm_eo, suf + 1);
  return out;
  ```)
;;; re/union-patterns -- build an alternation regex from a cons list of patterns.
;;;
;;; Each pattern is wrapped in a non-grouping-aware parenthesised branch and
;;; joined with `|`. The result is a freshly heap-allocated cstr that the
;;; caller must free.
;;;
;;; Parameters:
;;;   patterns -- cons list of cstr patterns (head = cstr pointer, tail = next)
;;;
;;; Returns:
;;;   A heap-allocated cstr containing the unioned pattern, or 0 if the list
;;;   is empty or contains a null element. POSIX ERE has no portable
;;;   "match nothing" pattern, so empty input is reported as 0 rather than
;;;   silently producing a degenerate regex.
;;;
;;; Example:
;;;   (re/union-patterns (cons "[A-Za-z]+" (cons "[0-9]+" 0)))
;;;     ; => "([A-Za-z]+)|([0-9]+)"
;;;
;;; Since: Phase RU1

(defn re/union-patterns [patterns : int] : cstr
  ```c struct __tur_cons_t { int64_t head; int64_t tail; };
  if (!patterns) return 0;
  /* First pass: validate elements and compute output size. Each branch
   * contributes strlen(p) + 2 (parens) bytes; n-1 bars sit between them. */
  struct __tur_cons_t *cur = (struct __tur_cons_t *)(intptr_t)patterns;
  size_t total = 0;
  size_t count = 0;
  while (cur) {
    const char *s = (const char *)(intptr_t)cur->head;
    if (!s) return 0;
    total += strlen(s) + 2;
    count++;
    cur = (struct __tur_cons_t *)(intptr_t)cur->tail;
  }
  if (count == 0) return 0;
  total += (count - 1); /* separators */
  char *out = (char *)malloc(total + 1);
  if (!out) return 0;
  size_t pos = 0;
  cur = (struct __tur_cons_t *)(intptr_t)patterns;
  int first = 1;
  while (cur) {
    if (!first) out[pos++] = '|';
    first = 0;
    const char *s = (const char *)(intptr_t)cur->head;
    size_t n = strlen(s);
    out[pos++] = '(';
    memcpy(out + pos, s, n);
    pos += n;
    out[pos++] = ')';
    cur = (struct __tur_cons_t *)(intptr_t)cur->tail;
  }
  out[pos] = '\0';
  return out;
  ```)
;;; re/compile-union -- compile an alternation of multiple regex patterns.
;;;
;;; Convenience wrapper around re/union-patterns followed by re/compile.
;;; The intermediate pattern buffer is freed before returning; the caller is
;;; responsible for re/free on the returned handle.
;;;
;;; Parameters:
;;;   patterns -- cons list of cstr patterns (head = cstr pointer, tail = next)
;;;
;;; Returns:
;;;   A compiled regex handle (:int) on success, or 0 if the input list is
;;;   empty, contains a null element, or compilation fails.
;;;
;;; Example:
;;;   (re/compile-union (cons "[A-Za-z]+" (cons "[0-9]+" 0)))  ; => <handle>
;;;
;;; Since: Phase RU2

(defn re/compile-union [patterns : int] : int
  ```c #include <regex.h>
  struct __tur_cons_t { int64_t head; int64_t tail; };
  if (!patterns) return 0;
  struct __tur_cons_t *cur = (struct __tur_cons_t *)(intptr_t)patterns;
  size_t total = 0, count = 0;
  while (cur) {
    const char *s = (const char *)(intptr_t)cur->head;
    if (!s) return 0;
    total += strlen(s) + 2;
    count++;
    cur = (struct __tur_cons_t *)(intptr_t)cur->tail;
  }
  if (count == 0) return 0;
  total += (count - 1);
  char *pat = (char *)malloc(total + 1);
  if (!pat) return 0;
  size_t pos = 0;
  cur = (struct __tur_cons_t *)(intptr_t)patterns;
  int first = 1;
  while (cur) {
    if (!first) pat[pos++] = '|';
    first = 0;
    const char *s = (const char *)(intptr_t)cur->head;
    size_t n = strlen(s);
    pat[pos++] = '(';
    memcpy(pat + pos, s, n);
    pos += n;
    pat[pos++] = ')';
    cur = (struct __tur_cons_t *)(intptr_t)cur->tail;
  }
  pat[pos] = '\0';
  regex_t *re = (regex_t *)malloc(sizeof(regex_t));
  if (!re) { free(pat); return 0; }
  if (regcomp(re, pat, REG_EXTENDED) != 0) {
    free(re);
    free(pat);
    return 0;
  }
  free(pat);
  return (int64_t)(intptr_t)re;
  ```)
;;; re/replace-all -- replace all non-overlapping matches of a regex.
;;;
;;; Parameters:
;;;   re          -- compiled regex handle from re/compile
;;;   input       -- input string cstr
;;;   replacement -- replacement string cstr (literal; no backreferences)
;;;
;;; Returns:
;;;   A heap-allocated cstr with all matches replaced.  Caller must free.
;;;
;;; Example:
;;;   (re/replace-all my-re "a1b2c3" "X")  ; => "aXbXcX"
;;;
;;; Since: Phase B2

(defn re/replace-all [re : int input : cstr replacement : cstr] : cstr
  ```c #include <regex.h>
  if (!re) return strdup(input);
  regex_t *r = (regex_t*)(intptr_t)re;
  regmatch_t m[1];
  const char *cur = input;
  size_t rlen = strlen(replacement);
  size_t out_cap = strlen(input) * 2 + rlen + 16;
  char *out = malloc(out_cap);
  size_t pos = 0;
  while (*cur && regexec(r, cur, 1, m, 0) == 0) {
    size_t pre  = (size_t)m[0].rm_so;
    size_t need = pos + pre + rlen + strlen(cur + m[0].rm_eo) + 2;
    if (need > out_cap) { out_cap = need * 2; out = realloc(out, out_cap); }
    memcpy(out + pos, cur, pre);
    pos += pre;
    memcpy(out + pos, replacement, rlen);
    pos += rlen;
    size_t adv = (m[0].rm_eo > m[0].rm_so) ? (size_t)m[0].rm_eo : 1;
    cur += adv;
  }
  size_t tail = strlen(cur);
  if (pos + tail + 1 > out_cap) out = realloc(out, pos + tail + 1);
  memcpy(out + pos, cur, tail + 1);
  return out;
  ```)
