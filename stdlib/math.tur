;;; tur/math -- thin wrappers around libm functions (sin, cos, sqrt, ...).
;;;
;;; All functions forward to libc/libm with no capability requirements.
;;;
;;; Since: Phase B1
;; stdlib/math.tur -- thin wrappers around libm functions.
;;
;; All functions forward to libc/libm and require no capabilities beyond
;; the implicit Unsafe of their inline-C bodies.
;;; sqrt -- square root of a float (double precision).
;;;
;;; Parameters:
;;;   x -- non-negative float value
;;;
;;; Returns:
;;;   The square root of x.
;;;
;;; Example:
;;;   (sqrt 2.0)  ; => 1.41421
;;;
;;; Since: Phase B1
(defn sqrt [x : float] : float
  ```c
  return __builtin_sqrt(x);
  ```)
;;; fabs -- absolute value of a float.
;;;
;;; Parameters:
;;;   x -- float value
;;;
;;; Returns:
;;;   The absolute value of x.
;;;
;;; Example:
;;;   (fabs -3.5)  ; => 3.5
;;;
;;; Since: Phase B1

(defn fabs [x : float] : float
  ```c
  return __builtin_fabs(x);
  ```)
;;; floor -- largest integer not greater than x.
;;;
;;; Parameters:
;;;   x -- float value
;;;
;;; Returns:
;;;   Floor of x as a float.
;;;
;;; Example:
;;;   (floor 3.7)  ; => 3
;;;
;;; Since: Phase B1

(defn floor [x : float] : float
  ```c
  return __builtin_floor(x);
  ```)
;;; ceil -- smallest integer not less than x.
;;;
;;; Parameters:
;;;   x -- float value
;;;
;;; Returns:
;;;   Ceiling of x as a float.
;;;
;;; Example:
;;;   (ceil 3.2)  ; => 4
;;;
;;; Since: Phase B1

(defn ceil [x : float] : float
  ```c
  return __builtin_ceil(x);
  ```)
;;; pow -- x raised to the power y.
;;;
;;; Parameters:
;;;   x -- base value
;;;   y -- exponent
;;;
;;; Returns:
;;;   x^y as a float.
;;;
;;; Example:
;;;   (pow 2.0 10.0)  ; => 1024
;;;
;;; Since: Phase B1

(defn pow [x : float y : float] : float
  ```c
  return __builtin_pow(x, y);
  ```)
;;; exp -- e raised to the power x.
;;;
;;; Parameters:
;;;   x -- float exponent
;;;
;;; Returns:
;;;   e^x.
;;;
;;; Example:
;;;   (exp 1.0)  ; => 2.71828
;;;
;;; Since: Phase N2

(defn exp [x : float] : float
  ```c
  return __builtin_exp(x);
  ```)
;;; log -- natural logarithm of a float.
;;;
;;; Parameters:
;;;   x -- positive float value
;;;
;;; Returns:
;;;   ln(x).
;;;
;;; Example:
;;;   (log 2.718281828459045)  ; => 1
;;;
;;; Since: Phase N2

(defn log [x : float] : float
  ```c
  return __builtin_log(x);
  ```)
;;; sin -- sine of an angle in radians.
;;;
;;; Parameters:
;;;   x -- angle in radians
;;;
;;; Returns:
;;;   sin(x).
;;;
;;; Example:
;;;   (sin 0.5)  ; => 0.479426
;;;
;;; Since: Phase N2

(defn sin [x : float] : float
  ```c
  return __builtin_sin(x);
  ```)
;;; cos -- cosine of an angle in radians.
;;;
;;; Parameters:
;;;   x -- angle in radians
;;;
;;; Returns:
;;;   cos(x).
;;;
;;; Example:
;;;   (cos 0.5)  ; => 0.877583
;;;
;;; Since: Phase N2

(defn cos [x : float] : float
  ```c
  return __builtin_cos(x);
  ```)
;;; atan2 -- principal arc tangent of y/x, using the signs of both arguments
;;; to place the result in the correct quadrant.
;;;
;;; Parameters:
;;;   y -- ordinate
;;;   x -- abscissa
;;;
;;; Returns:
;;;   The angle in radians in (-pi, pi].
;;;
;;; Example:
;;;   (atan2 1.5 0.0)  ; => 1.5708
;;;
;;; Since: Phase N2

(defn atan2 [y : float x : float] : float
  ```c
  return __builtin_atan2(y, x);
  ```)
;;; int->float -- convert an integer to a float via numeric cast.
;;;
;;; Parameters:
;;;   n -- integer value
;;;
;;; Returns:
;;;   The integer converted to a double-precision float.
;;;
;;; Example:
;;;   (int->float 42)  ; => 42
;;;
;;; Since: Phase B1

(defn int->float [n : int] : float
  ```c
  return (double)n;
  ```)
;;; float->int -- truncate a float to an integer.
;;;
;;; Parameters:
;;;   x -- float value
;;;
;;; Returns:
;;;   The float truncated toward zero as an int.
;;;
;;; Example:
;;;   (float->int 3.9)  ; => 3
;;;
;;; Since: Phase B1

(defn float->int [x : float] : int
  ```c
  return (int64_t)x;
  ```)
;;; printf-float6 -- print a float to stdout with 6 decimal places followed by a
;;; newline; mirrors the output format of the C benchmarks.
;;;
;;; Parameters:
;;;   x -- float value to print
;;;
;;; Since: Phase B1

(defn printf-float6 [x : float] : nil
  ```c
  printf("%.6f\n", x);
  ```)
;;; PI -- mathematical constant pi.

(def PI 3.141592653589793)
