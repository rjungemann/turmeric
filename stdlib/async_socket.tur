;;; tur/async_socket -- non-blocking TCP socket I/O for the cooperative scheduler.
;;;
;;; Accept connections and send/recv data without blocking the current fiber.
;;;
;;; Since: Phase T24
;; stdlib/async_socket.tur -- Async TCP socket I/O for Turmeric (Phase T24)
;;
;; Non-blocking TCP socket operations that integrate with the cooperative
;; scheduler via IO waiters and select()-based polling.
;;
;; API (stdlib-opaque-handle-types-plan, I/O sweep):
;;   async-socket-listen  [port backlog]    -> Fd          (listen fd; -1 on error)
;;   async-socket-accept  [listen-fd :Fd]   -> Fd          (client fd; parks)
;;   async-socket-connect [host port]       -> Fd          (-1 on error)
;;   async-socket-send    [fd :Fd data len] -> bytes-sent (int)
;;   async-socket-recv    [fd :Fd buf-size] -> bytes-read (int)
;;   async-socket-close   [fd :Fd]          -> int
;; Fds returned by listen/accept/connect are Fd handles (a :int newtype); a
;; returned -1 still signals failure -- test with fd-valid? or fd->int.
(load "stdlib/fd.tur")

(load "stdlib/effects.tur")
;; stdlib-effect-rows: the async-socket network operations add the #{Net}
;; capability tag alongside their existing #{Unsafe}.  The recv-buf / recv-len
;; accessors read the last-receive scratch buffer only and stay #{Unsafe}.
;; Create a listening TCP socket on the given port.
;; Returns the listen fd, or -1 on error.
;;; async-socket-listen -- create a non-blocking TCP listening socket on the given port.
;;;
;;; Parameters:
;;;   port    -- TCP port number to bind and listen on
;;;   backlog -- maximum length of the pending connection queue
;;;
;;; Returns:
;;;   int -- the listen file descriptor, or -1 on error
;;;
;;; Example:
;;;   (async-socket-listen 8080 128)  ; => 4
;;;
;;; Since: Phase T24

(defn async-socket-listen [port : int backlog : int]
  #fx{Unsafe Net}
  : Fd
  ```c
  /* Winsock needs one-time init before any socket call, and differs from BSD
   * sockets in a few spots: non-blocking is ioctlsocket(FIONBIO) not
   * fcntl(O_NONBLOCK), teardown is closesocket() not close(), and setsockopt
   * takes char* not void*. Socket handles fit in int here (Windows hands out
   * small values), so the reactor's int-fd model is preserved. */
#ifdef _WIN32
  { static LONG __wsa = 0;
    if (InterlockedExchange(&__wsa, 1) == 0) { WSADATA __wd; WSAStartup(MAKEWORD(2,2), &__wd); } }
#endif
  int fd = (int)socket(AF_INET, SOCK_STREAM, 0);
  if (fd < 0) return -1;
  int opt = 1;
  setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, (const char *)&opt, sizeof(opt));
  /* Set non-blocking */
#ifdef _WIN32
  { u_long __nb = 1; ioctlsocket(fd, FIONBIO, &__nb); }
#else
  int flags = fcntl(fd, F_GETFL, 0);
  fcntl(fd, F_SETFL, flags | O_NONBLOCK);
#endif
  struct sockaddr_in addr;
  memset(&addr, 0, sizeof(addr));
  addr.sin_family = AF_INET;
  /* INADDR_ANY by default; TUR_BIND_LOOPBACK forces loopback for the test suite
   * so Windows Firewall does not prompt per fixture binary. */
  addr.sin_addr.s_addr = htonl(getenv("TUR_BIND_LOOPBACK") ? INADDR_LOOPBACK : INADDR_ANY);
  addr.sin_port = htons((uint16_t)port);
  if (bind(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
#ifdef _WIN32
    closesocket(fd);
#else
    close(fd);
#endif
    return -1;
  }
  if (listen(fd, (int)backlog) < 0) {
#ifdef _WIN32
    closesocket(fd);
#else
    close(fd);
#endif
    return -1;
  }
  return (int64_t)fd;
  ```)
;; Accept a connection on the listen fd.
;; Parks the current fiber until a connection arrives.
;; Returns the client fd, or -1 on error.
;;; async-socket-accept -- accept an incoming connection, parking the fiber until one arrives.
;;;
;;; Parameters:
;;;   listen-fd -- listening file descriptor returned by async-socket-listen
;;;
;;; Returns:
;;;   int -- the accepted client file descriptor, or -1 on error
;;;
;;; Example:
;;;   (async-socket-accept listen-fd)  ; => 7
;;;
;;; Since: Phase T24

(defn async-socket-accept [listen-fd : Fd]
  #fx{Unsafe Net}
  : Fd
  ```c
  while (1) {
    int cfd = (int)accept((int)listen_fd, NULL, NULL);
    if (cfd >= 0) {
      /* Set client socket non-blocking */
#ifdef _WIN32
      { u_long __nb = 1; ioctlsocket(cfd, FIONBIO, &__nb); }
#else
      int flags = fcntl(cfd, F_GETFL, 0);
      fcntl(cfd, F_SETFL, flags | O_NONBLOCK);
#endif
      return (int64_t)cfd;
    }
#ifdef _WIN32
    if (WSAGetLastError() == WSAEWOULDBLOCK) {
#else
    if (errno == EAGAIN || errno == EWOULDBLOCK) {
#endif
      FiberBlock *me = tur_current_fiber;
      if (me && tur_scheduler) {
        tur_io_register((int)listen_fd, TUR_IO_READ, me);
        me->parked = 1;
        tur_fiber_block_yield(0);
        continue;
      }
    }
    return -1;
  }
  ```)
;; Connect to a TCP server at host:port.
;; host should be an IPv4 address string (e.g. "127.0.0.1").
;; Parks the fiber until the connection completes.
;; Returns the fd, or -1 on error.
;;; async-socket-connect -- connect to a TCP server at host:port, parking the fiber until complete.
;;;
;;; Parameters:
;;;   host -- IPv4 address string (e.g. "127.0.0.1")
;;;   port -- TCP port number to connect to
;;;
;;; Returns:
;;;   int -- the connected file descriptor, or -1 on error
;;;
;;; Example:
;;;   (async-socket-connect "127.0.0.1" 8080)  ; => 5
;;;
;;; Since: Phase T24

(defn async-socket-connect [host : cstr port : int]
  #fx{Unsafe Net}
  : Fd
  ```c
  #ifdef _WIN32
  { static LONG __wsa = 0;
    if (InterlockedExchange(&__wsa, 1) == 0) { WSADATA __wd; WSAStartup(MAKEWORD(2,2), &__wd); } }
#endif
  int fd = (int)socket(AF_INET, SOCK_STREAM, 0);
  if (fd < 0) return -1;
#ifdef _WIN32
  { u_long __nb = 1; ioctlsocket(fd, FIONBIO, &__nb); }
#else
  int flags = fcntl(fd, F_GETFL, 0);
  fcntl(fd, F_SETFL, flags | O_NONBLOCK);
#endif
  struct sockaddr_in addr;
  memset(&addr, 0, sizeof(addr));
  addr.sin_family = AF_INET;
  addr.sin_port = htons((uint16_t)port);
  inet_pton(AF_INET, host, &addr.sin_addr);
  int ret = connect(fd, (struct sockaddr *)&addr, sizeof(addr));
  if (ret == 0) return (int64_t)fd;
  /* A non-blocking connect that is still in flight reports EINPROGRESS on POSIX
   * and WSAEWOULDBLOCK on Windows. */
#ifdef _WIN32
  if (WSAGetLastError() == WSAEWOULDBLOCK) {
#else
  if (errno == EINPROGRESS) {
#endif
    FiberBlock *me = tur_current_fiber;
    if (me && tur_scheduler) {
      tur_io_register(fd, TUR_IO_WRITE, me);
      me->parked = 1;
      tur_fiber_block_yield(0);
      /* Check if connection succeeded */
      int err = 0;
      socklen_t errlen = sizeof(err);
      getsockopt(fd, SOL_SOCKET, SO_ERROR, (char *)&err, &errlen);
      if (err == 0) return (int64_t)fd;
    }
  }
#ifdef _WIN32
  closesocket(fd);
#else
  close(fd);
#endif
  return -1;
  ```)
;; Send data on a connected socket.
;; Parks the fiber on EAGAIN.
;; Returns bytes sent, or -1 on error.
;;; async-socket-send -- send data on a connected socket, parking the fiber on EAGAIN.
;;;
;;; Parameters:
;;;   fd   -- connected socket file descriptor
;;;   data -- pointer to the bytes to send
;;;   len  -- number of bytes to send
;;;
;;; Returns:
;;;   int -- total bytes sent, or -1 on error
;;;
;;; Example:
;;;   (async-socket-send fd "GET / HTTP/1.0\r\n" 16)  ; => 16
;;;
;;; Since: Phase T24

(defn async-socket-send [fd : Fd data : cstr len : int]
  #fx{Unsafe Net}
  : int
  ```c
  int64_t total = 0;
  while (total < len) {
    ssize_t n = send((int)fd, data + total, (size_t)(len - total), 0);
    if (n >= 0) {
      total += n;
      continue;
    }
#ifdef _WIN32
    if (WSAGetLastError() == WSAEWOULDBLOCK) {
#else
    if (errno == EAGAIN || errno == EWOULDBLOCK) {
#endif
      FiberBlock *me = tur_current_fiber;
      if (me && tur_scheduler) {
        tur_io_register((int)fd, TUR_IO_WRITE, me);
        me->parked = 1;
        tur_fiber_block_yield(0);
        continue;
      }
    }
    return -1;
  }
  return total;
  ```)
;; Receive data from a connected socket.
;; Parks the fiber on EAGAIN.
;; Returns bytes received, 0 on close, -1 on error.
;; The received data is stored in fiber-local storage (key 0xA51C50C0)
;; and can be retrieved with async-socket-recv-buf.
;;; async-socket-recv -- receive up to buf-size bytes from a connected socket.
;;;
;;; Parameters:
;;;   fd       -- connected socket file descriptor
;;;   buf-size -- maximum number of bytes to receive
;;;
;;; Returns:
;;;   int -- bytes received (> 0), 0 on connection close, -1 on error
;;;
;;; Example:
;;;   (async-socket-recv fd 4096)  ; => 256
;;;
;;; Since: Phase T24

(defn async-socket-recv [fd : Fd buf-size : int]
  #fx{Unsafe Net}
  : int
  ```c
  char *buf = (char *)malloc((size_t)buf_size);
  if (!buf) return -1;
  while (1) {
    ssize_t n = recv((int)fd, buf, (size_t)buf_size, 0);
    if (n >= 0) {
      if (tur_current_fiber) {
        tur_fiber_local_set(tur_current_fiber, 0xA51C50C0, (int64_t)(intptr_t)buf);
        tur_fiber_local_set(tur_current_fiber, 0xA51C50C1, n);
      }
      return (int64_t)n;
    }
#ifdef _WIN32
    if (WSAGetLastError() == WSAEWOULDBLOCK) {
#else
    if (errno == EAGAIN || errno == EWOULDBLOCK) {
#endif
      FiberBlock *me = tur_current_fiber;
      if (me && tur_scheduler) {
        tur_io_register((int)fd, TUR_IO_READ, me);
        me->parked = 1;
        tur_fiber_block_yield(0);
        continue;
      }
    }
    free(buf);
    return -1;
  }
  ```)
;; Retrieve the receive buffer pointer after async-socket-recv.
;;; async-socket-recv-buf -- retrieve the buffer pointer from the last async-socket-recv call.
;;;
;;; Returns:
;;;   ptr<void> -- pointer to the receive buffer in fiber-local storage (caller must free)
;;;
;;; Example:
;;;   (async-socket-recv-buf)  ; => buf-ptr
;;;
;;; Since: Phase T24

(defn async-socket-recv-buf []
  #fx{Unsafe}
  : ptr<void>
  ```c
  if (!tur_current_fiber) return NULL;
  return (void*)(intptr_t)tur_fiber_local_get(tur_current_fiber, 0xA51C50C0);
  ```)
;; Retrieve the number of bytes from the last async-socket-recv.
;;; async-socket-recv-len -- retrieve the byte count from the last async-socket-recv call.
;;;
;;; Returns:
;;;   int -- number of bytes received in the most recent async-socket-recv
;;;
;;; Example:
;;;   (async-socket-recv-len)  ; => 256
;;;
;;; Since: Phase T24

(defn async-socket-recv-len []
  #fx{Unsafe}
  : int
  ```c
  if (!tur_current_fiber) return 0;
  return tur_fiber_local_get(tur_current_fiber, 0xA51C50C1);
  ```)
;; Close a socket and unregister it from IO polling.
;;; async-socket-close -- close a socket and unregister it from IO polling.
;;;
;;; Parameters:
;;;   fd -- socket file descriptor to close
;;;
;;; Example:
;;;   (async-socket-close fd)
;;;
;;; Since: Phase T24

(defn async-socket-close [fd : Fd]
  #fx{Unsafe Net}
  : nil
  ```c
  tur_io_unregister((int)fd);
#ifdef _WIN32
  closesocket((int)fd);
#else
  close((int)fd);
#endif
  ```)
