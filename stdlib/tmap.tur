;; Phase TM0: Typed Map[K V]
;; K must satisfy Hash[K] and Eq[K].
;; Backed by the persistent HAMT (stdlib/hamt.tur).
;; At runtime, a Map[K V] is a heap-allocated wrapper around a HAMT ptr<void>.

;; Internal C layout: struct { void *hamt; }

;;; Map -- parameterized persistent map with key type K and value type V.
;;;
;;; Since: Phase TM0
(defstruct Map [K V]
  (hamt :ptr<void>))

;;; tmap-new -- create a new empty typed map.
;;;
;;; Returns:
;;;   An empty Map[K V].
;;;
;;; Example:
;;;   (tmap-new)  ; => empty Map
;;;
;;; Since: Phase TM0
(defn tmap-new [] #{} :int
  ```c
  struct { void *hamt; } *m = malloc(sizeof(*m));
  m->hamt = tur_hamt_new();
  return (int64_t)(intptr_t)m;
  ```)

;;; tmap-hamt -- internal accessor for the HAMT backing store.
(defn tmap-hamt [m :int] #{} :ptr<void>
  ```c
  struct { void *hamt; } *map = (void*)(intptr_t)m;
  return map->hamt;
  ```)

;;; tmap-wrap -- internal constructor from a HAMT pointer.
(defn tmap-wrap [h :ptr<void>] #{} :int
  ```c
  struct { void *hamt; } *m = malloc(sizeof(*m));
  m->hamt = (void*)(intptr_t)h;
  return (int64_t)(intptr_t)m;
  ```)

;;; tmap-assoc -- insert or update a key/value pair; returns a new map.
;;;
;;; Parameters:
;;;   m   -- source Map[K V]
;;;   key -- key of type K (used as hash for scalar keys)
;;;   val -- value of type V
;;;
;;; Returns:
;;;   A new Map[K V] with the entry inserted or updated.
;;;
;;; Example:
;;;   (tmap-assoc my-map 1 100)  ; => updated map
;;;
;;; Since: Phase TM0
(defn tmap-assoc [m :int key :int val :int] #{} :int
  ```c
  struct { void *hamt; } *map = (void*)(intptr_t)m;
  void *new_hamt = tur_hamt_set(map->hamt, (int64_t)key, (void*)(intptr_t)key, (void*)(intptr_t)val);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)

;;; tmap-assoc-h -- insert or update with an explicit hash; returns a new map.
;;;
;;; Parameters:
;;;   m   -- source Map[K V]
;;;   h   -- precomputed hash of key (from Hash[K] typeclass)
;;;   key -- key of type K
;;;   val -- value of type V
;;;
;;; Returns:
;;;   A new Map[K V] with the entry inserted or updated.
;;;
;;; Example:
;;;   (tmap-assoc-h my-map (hash k) k v)  ; => updated map
;;;
;;; Since: Phase TM0
(defn tmap-assoc-h [m :int h :int key :int val :int] #{} :int
  ```c
  struct { void *hamt; } *map = (void*)(intptr_t)m;
  void *new_hamt = tur_hamt_set(map->hamt, h, (void*)(intptr_t)key, (void*)(intptr_t)val);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)

;;; tmap-dissoc -- remove a key from the map; returns a new map.
;;;
;;; Parameters:
;;;   m   -- source Map[K V]
;;;   h   -- precomputed hash of key
;;;   key -- key of type K
;;;
;;; Returns:
;;;   A new Map[K V] with the key removed.
;;;
;;; Example:
;;;   (tmap-dissoc my-map (hash k) k)  ; => map without k
;;;
;;; Since: Phase TM0
(defn tmap-dissoc [m :int h :int key :int] #{} :int
  ```c
  struct { void *hamt; } *map = (void*)(intptr_t)m;
  void *new_hamt = tur_hamt_del(map->hamt, h, (void*)(intptr_t)key);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)

;;; tmap-get -- look up a key; returns the value or 0 if absent.
;;;
;;; Parameters:
;;;   m   -- Map[K V]
;;;   h   -- precomputed hash of key
;;;   key -- key of type K
;;;
;;; Returns:
;;;   The value for the key, or 0 (none) if absent.
;;;
;;; Example:
;;;   (tmap-get my-map (hash k) k)  ; => value or 0
;;;
;;; Since: Phase TM0
(defn tmap-get [m :int h :int key :int] #{} :int
  ```c
  struct { void *hamt; } *map = (void*)(intptr_t)m;
  return (int64_t)(intptr_t)tur_hamt_get(map->hamt, h, (void*)(intptr_t)key);
  ```)

;;; tmap-has? -- check whether a key exists in the map.
;;;
;;; Parameters:
;;;   m   -- Map[K V]
;;;   h   -- precomputed hash of key
;;;   key -- key of type K
;;;
;;; Returns:
;;;   true if the key is present, false otherwise.
;;;
;;; Example:
;;;   (tmap-has? my-map (hash k) k)  ; => true or false
;;;
;;; Since: Phase TM0
(defn tmap-has? [m :int h :int key :int] #{} :bool
  ```c
  struct { void *hamt; } *map = (void*)(intptr_t)m;
  return tur_hamt_has(map->hamt, h, (void*)(intptr_t)key);
  ```)

;;; tmap-count -- return the number of entries in the map.
;;;
;;; Parameters:
;;;   m -- Map[K V]
;;;
;;; Returns:
;;;   Integer count of key/value pairs.
;;;
;;; Example:
;;;   (tmap-count my-map)  ; => 3
;;;
;;; Since: Phase TM0
(defn tmap-count [m :int] #{} :int
  ```c
  struct { void *hamt; } *map = (void*)(intptr_t)m;
  return tur_hamt_count(map->hamt);
  ```)

;;; tmap-merge -- merge two maps; values from b win on key collision.
;;;
;;; Parameters:
;;;   a -- first Map[K V]
;;;   b -- second Map[K V] (wins on collision)
;;;
;;; Returns:
;;;   A new Map[K V] containing all entries from both maps.
;;;
;;; Example:
;;;   (tmap-merge map-a map-b)  ; => merged map
;;;
;;; Since: Phase TM0
(defn tmap-merge [a :int b :int] #{} :int
  ```c
  struct { void *hamt; } *ma = (void*)(intptr_t)a;
  struct { void *hamt; } *mb = (void*)(intptr_t)b;
  void *new_hamt = tur_hamt_merge(ma->hamt, mb->hamt);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)

;;; tmap-free -- free the Map wrapper (does not free HAMT; use tmap-free-all for that).
;;;
;;; Parameters:
;;;   m -- Map[K V] to free
;;;
;;; Example:
;;;   (tmap-free my-map)
;;;
;;; Since: Phase TM0
(defn tmap-free [m :int] #{} :void
  ```c
  free((void*)(intptr_t)m);
  ```)

;;; tmap-eq? -- compare two maps for structural equality using a value comparator.
;;;
;;; Parameters:
;;;   m1      -- first Map[K V]
;;;   m2      -- second Map[K V]
;;;   val-cmp -- comparator fn [a :int b :int] :bool applied to each value pair
;;;
;;; Returns:
;;;   true if both maps have identical keys and all corresponding values satisfy val-cmp.
;;;
;;; Example:
;;;   (tmap-eq? ma mb (fn [a b] (= a b)))  ; => true
;;;
;;; Since: Phase TM0
(defn tmap-eq? [m1 :int m2 :int val-cmp] #{} :bool
  ```c
  struct { void *hamt; } *map1 = (void*)(intptr_t)m1;
  struct { void *hamt; } *map2 = (void*)(intptr_t)m2;
  if (tur_hamt_count(map1->hamt) != tur_hamt_count(map2->hamt)) return false;
  uint64_t iter_buf[32];
  for (int __i = 0; __i < 32; __i++) iter_buf[__i] = 0;
  tur_hamt_iter_init(iter_buf, map1->hamt);
  uint64_t hash_out;
  void *key_out = NULL, *val_out = NULL;
  while (tur_hamt_iter_next(iter_buf, &hash_out, &key_out, &val_out)) {
      void *val_in_b = tur_hamt_get(map2->hamt, (int64_t)hash_out, key_out);
      if (!val_in_b) { tur_hamt_iter_free(iter_buf); return false; }
      bool vals_eq = ((bool(*)(int64_t, int64_t))(intptr_t)val_cmp)(
          (int64_t)(intptr_t)val_out, (int64_t)(intptr_t)val_in_b);
      if (!vals_eq) { tur_hamt_iter_free(iter_buf); return false; }
  }
  tur_hamt_iter_free(iter_buf);
  return true;
  ```)

;;; Eq [Map] -- structural equality using the value type's Eq instance.
;; TM0-6: Phase PTC4 -- constrained Eq instance for Map[K V].
;; Constraints: (Eq K) ensures keys are comparable; (Eq V) uses integer equality.
;; Note: element comparison uses integer equality; correct for all primitive K/V.
(definstance Eq [Map] [(Eq K) (Eq V)]
  (eq? [x y] (tmap-eq? x y (fn [a b] (= a b)))))
