;; Phase TC2-C: Typed Set[A]
;; Persistent set backed by the HAMT. A must satisfy Hash[A] and Eq[A].
;; Elements are stored as HAMT keys; values are always 1 (sentinel).
;; Runtime layout: struct { void *hamt; }

;;; Set -- parameterized persistent set with element type A.
;;;
;;; Since: Phase TC2
(defstruct Set [A]
  (hamt :ptr<void>))

;;; tset-new -- create a new empty Set[A].
;;;
;;; Returns:
;;;   An empty Set[A].
;;;
;;; Example:
;;;   (tset-new)  ; => empty Set
;;;
;;; Since: Phase TC2
(defn tset-new [] #{} :int
  ```c
  struct { void *hamt; } *s = malloc(sizeof(*s));
  s->hamt = tur_hamt_new();
  return (int64_t)(intptr_t)s;
  ```)

;;; tset-add -- add element x to the set; returns a new set.
;;;
;;; Parameters:
;;;   s -- Set[A]
;;;   h -- precomputed hash of x (from Hash[A] typeclass)
;;;   x -- element to add (type A)
;;;
;;; Returns:
;;;   A new Set[A] containing x.
;;;
;;; Example:
;;;   (tset-add my-set (hash 42) 42)  ; => set with 42
;;;
;;; Since: Phase TC2
(defn tset-add [s :int h :int x :int] #{} :int
  ```c
  struct { void *hamt; } *set = (void*)(intptr_t)s;
  void *new_hamt = tur_hamt_set(set->hamt, h, (void*)(intptr_t)x, (void*)1);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)

;;; tset-remove -- remove element x from the set; returns a new set.
;;;
;;; Parameters:
;;;   s -- Set[A]
;;;   h -- precomputed hash of x
;;;   x -- element to remove (type A)
;;;
;;; Returns:
;;;   A new Set[A] without x.
;;;
;;; Example:
;;;   (tset-remove my-set (hash 42) 42)  ; => set without 42
;;;
;;; Since: Phase TC2
(defn tset-remove [s :int h :int x :int] #{} :int
  ```c
  struct { void *hamt; } *set = (void*)(intptr_t)s;
  void *new_hamt = tur_hamt_del(set->hamt, h, (void*)(intptr_t)x);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)

;;; tset-member? -- check whether element x is in the set.
;;;
;;; Parameters:
;;;   s -- Set[A]
;;;   h -- precomputed hash of x
;;;   x -- element to test (type A)
;;;
;;; Returns:
;;;   true if x is in the set, false otherwise.
;;;
;;; Example:
;;;   (tset-member? my-set (hash 42) 42)  ; => true
;;;
;;; Since: Phase TC2
(defn tset-member? [s :int h :int x :int] #{} :bool
  ```c
  struct { void *hamt; } *set = (void*)(intptr_t)s;
  return tur_hamt_has(set->hamt, h, (void*)(intptr_t)x);
  ```)

;;; tset-count -- return the number of elements in the set.
;;;
;;; Parameters:
;;;   s -- Set[A]
;;;
;;; Returns:
;;;   Integer count of elements.
;;;
;;; Example:
;;;   (tset-count my-set)  ; => 3
;;;
;;; Since: Phase TC2
(defn tset-count [s :int] #{} :int
  ```c
  struct { void *hamt; } *set = (void*)(intptr_t)s;
  return tur_hamt_count(set->hamt);
  ```)

;;; tset-union -- compute the union of two sets.
;;;
;;; Parameters:
;;;   a -- first Set[A]
;;;   b -- second Set[A]
;;;
;;; Returns:
;;;   A new Set[A] containing all elements from both sets.
;;;
;;; Example:
;;;   (tset-union set-a set-b)  ; => union set
;;;
;;; Since: Phase TC2
(defn tset-union [a :int b :int] #{} :int
  ```c
  struct { void *hamt; } *sa = (void*)(intptr_t)a;
  struct { void *hamt; } *sb = (void*)(intptr_t)b;
  void *new_hamt = tur_hamt_merge(sa->hamt, sb->hamt);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (int64_t)(intptr_t)r;
  ```)

;;; tset-intersect -- compute the intersection of two sets.
;;;
;;; Parameters:
;;;   a -- first Set[A]
;;;   b -- second Set[A]
;;;
;;; Returns:
;;;   A new Set[A] containing only elements present in both a and b.
;;;
;;; Example:
;;;   (tset-intersect set-a set-b)  ; => intersection set
;;;
;;; Since: Phase TC2
(defn tset-intersect [a :int b :int] #{} :int
  ```c
  struct { void *hamt; } *sa = (void*)(intptr_t)a;
  struct { void *hamt; } *sb = (void*)(intptr_t)b;
  void *result = tur_hamt_new();
  uint64_t iter_buf[32];
  for (int __i = 0; __i < 32; __i++) iter_buf[__i] = 0;
  tur_hamt_iter_init(iter_buf, sa->hamt);
  uint64_t hash_out;
  void *key_out = NULL, *val_out = NULL;
  while (tur_hamt_iter_next(iter_buf, &hash_out, &key_out, &val_out)) {
      if (tur_hamt_has(sb->hamt, (int64_t)hash_out, key_out)) {
          result = tur_hamt_set(result, (int64_t)hash_out, key_out, (void*)1);
      }
  }
  tur_hamt_iter_free(iter_buf);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = result;
  return (int64_t)(intptr_t)r;
  ```)

;;; tset-diff -- compute set difference a \ b (elements in a but not b).
;;;
;;; Parameters:
;;;   a -- Set[A] (base set)
;;;   b -- Set[A] (elements to remove)
;;;
;;; Returns:
;;;   A new Set[A] with elements of a that are not in b.
;;;
;;; Example:
;;;   (tset-diff set-a set-b)  ; => difference set
;;;
;;; Since: Phase TC2
(defn tset-diff [a :int b :int] #{} :int
  ```c
  struct { void *hamt; } *sa = (void*)(intptr_t)a;
  struct { void *hamt; } *sb = (void*)(intptr_t)b;
  void *result = tur_hamt_new();
  uint64_t iter_buf[32];
  for (int __i = 0; __i < 32; __i++) iter_buf[__i] = 0;
  tur_hamt_iter_init(iter_buf, sa->hamt);
  uint64_t hash_out;
  void *key_out = NULL, *val_out = NULL;
  while (tur_hamt_iter_next(iter_buf, &hash_out, &key_out, &val_out)) {
      if (!tur_hamt_has(sb->hamt, (int64_t)hash_out, key_out)) {
          result = tur_hamt_set(result, (int64_t)hash_out, key_out, (void*)1);
      }
  }
  tur_hamt_iter_free(iter_buf);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = result;
  return (int64_t)(intptr_t)r;
  ```)

;;; tset-eq? -- compare two sets for equality.
;;;
;;; Parameters:
;;;   a -- first Set[A]
;;;   b -- second Set[A]
;;;
;;; Returns:
;;;   true if both sets contain exactly the same elements.
;;;
;;; Example:
;;;   (tset-eq? set-a set-b)  ; => true
;;;
;;; Since: Phase TC2
(defn tset-eq? [a :int b :int] #{} :bool
  ```c
  struct { void *hamt; } *sa = (void*)(intptr_t)a;
  struct { void *hamt; } *sb = (void*)(intptr_t)b;
  if (tur_hamt_count(sa->hamt) != tur_hamt_count(sb->hamt)) return false;
  uint64_t iter_buf[32];
  for (int __i = 0; __i < 32; __i++) iter_buf[__i] = 0;
  tur_hamt_iter_init(iter_buf, sa->hamt);
  uint64_t hash_out;
  void *key_out = NULL, *val_out = NULL;
  while (tur_hamt_iter_next(iter_buf, &hash_out, &key_out, &val_out)) {
      if (!tur_hamt_has(sb->hamt, (int64_t)hash_out, key_out)) {
          tur_hamt_iter_free(iter_buf);
          return false;
      }
  }
  tur_hamt_iter_free(iter_buf);
  return true;
  ```)

;;; tset-free -- free the Set wrapper struct.
;;;
;;; Parameters:
;;;   s -- Set[A] to free
;;;
;;; Example:
;;;   (tset-free my-set)
;;;
;;; Since: Phase TC2
(defn tset-free [s :int] #{} :void
  ```c
  free((void*)(intptr_t)s);
  ```)
