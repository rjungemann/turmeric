;;; tur/free -- Free monad over a functor f for building effect DSLs.
;;;
;;; Free f a = PureFree a | Suspend (f (Free f a)). Run a Free program
;;; by providing an interpreter for the functor f.
;;;
;;; Since: Phase B1
;; Free -- the Free monad over a functor f.
;;
;; Free f a = PureFree a | Suspend (f (Free f a))
;;
;; Any Functor f yields a Monad over Free f for free, without requiring f
;; itself to be a monad.  This enables pure effect interpreters, trampolined
;; computation, and extensible effects.
;;
;; Phase RF3

;;; Free -- the Free monad over a functor f.
;;;
;;; Free f a = PureFree a | Suspend (f (Free f a))
;;;
;;; Any Functor ^f yields a Monad over Free ^f for free.
(defdata Free [^f a]
  (PureFree :int)
  (Suspend  :int))

;;; free-pure -- lift a pure value into the Free monad.
;;;
;;; Parameters:
;;;   x -- the value to lift
;;;
;;; Returns:
;;;   A Free value in the pure leaf case.
;;;
;;; Example:
;;;   (free-pure 42)  ; => (PureFree 42)
;;;
;;; Since: Phase RF3
(defn free-pure [x :int] #{} :int
  (PureFree x))

;;; free-lift -- lift one layer of f into Free.
;;;
;;; Parameters:
;;;   fx -- a value of type (f a), where a is the "next step" value
;;;
;;; Returns:
;;;   A Free value that suspends on fx.
;;;
;;; Example:
;;;   (free-lift (some 5))
;;;
;;; Since: Phase RF3
(defn free-lift [fx :int] #{} :int
  (Suspend fx))

;;; free-bind -- monadic bind for Free.
;;;
;;; Sequentially composes two Free computations.
;;;   (PureFree a)  >>= f  = f a
;;;   (Suspend m)   >>= f  = Suspend m  (single-layer pass-through)
;;;
;;; Parameters:
;;;   ma -- a Free value
;;;   kont -- a fat-closure from a to (Free f b), stored as :int
;;;
;;; Returns:
;;;   A new Free value representing the sequenced computation.
;;;
;;; Example:
;;;   (free-bind (free-pure 3) (fn [x] (free-pure (* x 2))))  ; => (PureFree 6)
;;;
;;; Since: Phase RF3
(defn free-bind [ma :int kont :int] #{Unsafe} :int
  ```c
  typedef struct { int tag; union { struct { int64_t _0; } PureFree; struct { int64_t _0; } Suspend; } as; } tur_adt_Free_fb;
  tur_adt_Free_fb *fr = (tur_adt_Free_fb*)(intptr_t)ma;
  if (fr->tag == 0) { /* PureFree */
    int64_t *fat = (int64_t*)(intptr_t)kont;
    int64_t thunk = fat[0];
    return ((int64_t(*)(void*, int64_t))(intptr_t)thunk)((void*)fat, fr->as.PureFree._0);
  } else { /* Suspend -- pass through */
    return ma;
  }
  ```)

;;; free-fmap -- functor map for Free: apply a function to all pure leaves.
;;;
;;; Parameters:
;;;   free -- a Free value
;;;   f    -- a fat-closure from a to b, stored as :int
;;;
;;; Returns:
;;;   A new Free value with f applied to all pure leaves.
;;;
;;; Since: Phase RF3
(defn free-fmap [free :int f :int] #{Unsafe} :int
  ```c
  /* Apply f to the pure value inside a PureFree, or pass Suspend through. */
  /* Assume free is a tur_adt_Free pointer */
  typedef struct { int tag; union { struct { int64_t _0; } PureFree; struct { int64_t _0; } Suspend; } as; } tur_adt_Free;
  tur_adt_Free *fr = (tur_adt_Free*)(intptr_t)free;
  if (fr->tag == 0) { /* PureFree */
    int64_t *fat = (int64_t*)(intptr_t)f;
    int64_t thunk = fat[0];
    int64_t mapped = ((int64_t(*)(void*, int64_t))(intptr_t)thunk)((void*)fat, fr->as.PureFree._0);
    return free_pure(mapped);
  } else { /* Suspend */
    return free;
  }
  ```)

;;; free-run -- interpret a Free computation with a natural transformation.
;;;
;;; Parameters:
;;;   interp -- a fat-closure from (f a) to a, stored as :int
;;;   free   -- a Free computation to run
;;;
;;; Returns:
;;;   The result of running free under interp.
;;;
;;; Example:
;;;   (free-run my-interp my-program)
;;;
;;; Since: Phase RF3
(defn free-run [interp :int free :int] #{Unsafe} :int
  ```c
  typedef struct { int tag; union { struct { int64_t _0; } PureFree; struct { int64_t _0; } Suspend; } as; } tur_adt_Free_fr;
  tur_adt_Free_fr *fr = (tur_adt_Free_fr*)(intptr_t)free;
  if (fr->tag == 0) { /* PureFree */
    return fr->as.PureFree._0;
  } else { /* Suspend */
    int64_t *fat = (int64_t*)(intptr_t)interp;
    int64_t thunk = fat[0];
    return ((int64_t(*)(void*, int64_t))(intptr_t)thunk)((void*)fat, fr->as.Suspend._0);
  }
  ```)
