; triangle/loop-sum -- tight iterative loop: branch + arithmetic codegen.
; Written as defn-level self-tail recursion, which the emitter TCOs into a
; loop on every engine.  (A CAPTURING named-let `(let go ...)` is TCO'd too
; as of 2026-07-30 -- docs/archive/named-let-self-tail-not-tco.md -- but the
; defn form is kept here so the published numbers stay comparable to the
; run that produced them.  The non-capturing named let is TCO'd as well as of
; the same day: docs/archive/cps-colored-noncapture-named-let-recurses-through-entry.md.)
; Pure Turmeric, no imports, no inline C.
(defn sum-to [i : int n : int acc : int] : int
  (if (>= i n)
    acc
    (sum-to (+ i 1) n (+ acc i))))

(defn main [] : int
  (println (sum-to 0 5000000 0))
  0)
