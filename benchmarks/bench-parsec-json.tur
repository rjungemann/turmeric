;; Phase B5: Parsec JSON-like parsing benchmark
;;
;; Simulates a parsec-style parser using the backtracking monad.
;; Parses a sequence of tokens and attempts multiple alternatives.
;; Baseline: same logic in plain C (bench-parsec-json-baseline.c).

;; A token stream is encoded as a list of int64 (char values).

(defn mzero [] :int
  ```c return 0; ```)

(defn mreturn [x] :int
  ```c
  struct { int64_t value; int64_t next; } *cell = malloc(sizeof(*cell));
  cell->value = x;
  cell->next = 0;
  return (int64_t)(intptr_t)cell;
  ```)

(defn mplus [xs ys] :int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *xc = (Cell*)(intptr_t)xs;
  if (!xc) return ys;
  Cell *head = NULL, *tail = NULL;
  while (xc) {
      Cell *n = malloc(sizeof(Cell));
      n->value = xc->value; n->next = 0;
      if (tail) tail->next = (int64_t)(intptr_t)n; else head = n;
      tail = n;
      xc = (Cell*)(intptr_t)xc->next;
  }
  if (tail) tail->next = ys;
  return (int64_t)(intptr_t)head;
  ```)

(defn bt-count [xs] :int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *c = (Cell*)(intptr_t)xs; int64_t n = 0;
  while (c) { n++; c = (Cell*)(intptr_t)c->next; }
  return n;
  ```)

(defn bt-free [xs]
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *c = (Cell*)(intptr_t)xs;
  while (c) { Cell *nx = (Cell*)(intptr_t)c->next; free(c); c = nx; }
  ```)

;; Simulate parsing: for a sequence of 100 "tokens", try matching
;; even or odd alternatives using mplus. Count total parses.
(defn parse-bench [n] :int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  int64_t result = 0;
  for (int64_t i = 0; i < n; i++) {
      /* Build two alternative parses: one for even, one for odd */
      Cell *even = NULL, *odd = NULL, *te = NULL, *to = NULL;
      for (int64_t j = 0; j < 50; j++) {
          if ((j % 2) == 0) {
              Cell *c = malloc(sizeof(Cell)); c->value = j; c->next = 0;
              if (te) te->next = (int64_t)(intptr_t)c; else even = c;
              te = c;
          } else {
              Cell *c = malloc(sizeof(Cell)); c->value = j; c->next = 0;
              if (to) to->next = (int64_t)(intptr_t)c; else odd = c;
              to = c;
          }
      }
      /* mplus even odd */
      if (te) te->next = (int64_t)(intptr_t)odd;
      Cell *merged = even ? even : odd;
      /* count */
      Cell *c = merged;
      while (c) { result++; c = (Cell*)(intptr_t)c->next; }
      /* free */
      c = merged;
      while (c) { Cell *nx = (Cell*)(intptr_t)c->next; free(c); c = nx; }
  }
  return result;
  ```)

(defn main [] :int
  (let [total (parse-bench 10000)]
    (println total)
    0))
