;; Phase B5: Clone overhead micro-benchmark
;;
;; Measures the overhead of cloneable-shift continuation capture
;; compared to a plain function call. In the current list-monad implementation
;; there are no actual continuations, so this tests the mbind/mreturn overhead
;; for nested list construction — equivalent to the "clone overhead" cost.

(defn mreturn [x] :int
  ```c
  struct { int64_t value; int64_t next; } *cell = malloc(sizeof(*cell));
  cell->value = x;
  cell->next = 0;
  return (int64_t)(intptr_t)cell;
  ```)

(defn mplus [xs ys] :int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *xc = (Cell*)(intptr_t)xs;
  if (!xc) return ys;
  Cell *head = NULL, *tail = NULL;
  while (xc) {
      Cell *n = malloc(sizeof(Cell));
      n->value = xc->value; n->next = 0;
      if (tail) tail->next = (int64_t)(intptr_t)n; else head = n;
      tail = n;
      xc = (Cell*)(intptr_t)xc->next;
  }
  if (tail) tail->next = ys;
  return (int64_t)(intptr_t)head;
  ```)

(defn bt-free [xs]
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *c = (Cell*)(intptr_t)xs;
  while (c) {
      Cell *nx = (Cell*)(intptr_t)c->next;
      free(c); c = nx;
  }
  ```)

(defn main [] :int
  ```c
  /* Build and free a list of 10000 elements 1000 times */
  for (int iter = 0; iter < 1000; iter++) {
      int64_t xs = 0;
      for (int64_t i = 10000; i >= 1; i--) {
          struct { int64_t value; int64_t next; } *cell = malloc(sizeof(*cell));
          cell->value = i; cell->next = xs;
          xs = (int64_t)(intptr_t)cell;
      }
      /* free */
      typedef struct { int64_t value; int64_t next; } Cell;
      Cell *c = (Cell*)(intptr_t)xs;
      while (c) {
          Cell *nx = (Cell*)(intptr_t)c->next;
          free(c); c = nx;
      }
  }
  printf("done\n");
  return 0;
  ```)
